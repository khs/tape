.claude/

# Crosswalk download cache — large BAF + t10t20 zips downloaded by
# pipelines/build_crosswalks.py, parsed into compact output CSVs at
# pipelines/_crosswalks/ that DO get checked in. Raw inputs (~1GB
# total) stay out of the repo.
pipelines/_crosswalks_cache/

# Per-pipeline intermediate caches ("don't re-hit upstream for data
# we already fetched recently"). Each pipeline that opts in writes
# here; regenerable so it stays out of the repo. See pipelines/_cache.py.
# This is the SINGLE on-disk pipeline cache: both _cache.py's artifact
# caching (ACS/Zillow/SSA) AND common.py's cached_get() HTTP responses
# (under the "http" bucket) live here. The old pipelines/_response_cache/
# store was retired in favor of this one — safe to delete if present.
pipelines/_cache/

# CBO XLSX uploads. cbo.gov is behind DataDome and often blocks CI
# fetches; the manual fallback is to drop browser-downloaded files
# here. Operator artifact, not part of the repo. See pipelines/cbo.py.
pipelines/cbo_data/

# SSA HTML uploads. ssa.gov returns 403 to non-browser User-Agents;
# the manual fallback is to save the Trustees Report HTML pages from
# a browser into this directory. See pipelines/ssa.py for the workflow.
pipelines/ssa_data/

# Census TIGER tract shapefiles cache for the state-tract-topo
# generator. ~50 MB total of source ZIPs + extracted shapefiles;
# regenerable from census.gov on demand. See
# pipelines/build_state_tract_topo.py.
pipelines/_tract_topo_cache/

.tmp_*

# Playwright output (e2e suite runs post-deploy in CI; local runs are
# ad-hoc against prod). Reports + traces are regenerable artifacts.
test-results/
playwright-report/


# Session-handoff notes (HANDOFF.md): generated for resuming on another
# machine, moved manually (not via git). Untracked on purpose.
/HANDOFF.md
