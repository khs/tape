---
/**
 * Minimal layout for `/embed/...` routes — strips nav, footer, OG meta,
 * JSON-LD, sign-in modals, and the analytics shell. The host page (a
 * Substack post, a blog, a Confluence wiki) is already styled and only
 * cares about the chart rendering inside the iframe.
 *
 * What we keep:
 *   - Font (Inter Variable, the rest of the site's identity)
 *   - The global stylesheet (so tile / dialog colors match)
 *   - A small "Tape" attribution in the corner, linking back to the
 *     full chart page. Required by the spirit of "every embed should
 *     advertise the source" — and gives the host page's reader a
 *     one-click path into the full site if they want to explore.
 *
 * What we drop:
 *   - <BaseLayout>'s nav, footer, JSON-LD, OG meta, social link
 *     unfurl machinery — none of it is useful inside an iframe.
 *   - The add-to-dashboard / sign-in modals.
 *   - The analytics dashboard-view ping. Embeds get their own
 *     `embed_chart_view` event from the embed page directly.
 *
 * Sized to fit the iframe — body fills 100% height/width with no
 * scrollbars; the chart sizes to whatever the iframe's outer
 * dimensions are.
 */
import "@fontsource-variable/inter";
import "../styles/global.css";
import { SITE_BRAND_NAME, SITE_BRAND_URL } from "../lib/brand";

interface Props {
  title: string;
  /** The full-site URL the attribution chip links back to. */
  attributionHref: string;
  /**
   * When true, signal "show the chart dialog directly" to the embed
   * page's CSS + script. The welcome page's coverage-chip popout
   * opens /embed/chart/<id>/?expanded=1 → the layout's expanded
   * body class lets the dialog show (default embed CSS hides it),
   * and the embed-page script auto-clicks the tile on load.
   */
  expanded?: boolean;
  /**
   * When true, render the FRED required disclaimer in the embed
   * chrome. Set by /embed/chart/<id> when any of the chart's
   * sources came through the fred pipeline. Needed because a
   * non-expanded embed shows only the chart tile — the in-dialog
   * FRED footer is invisible until the host-page reader clicks
   * through, and many embedded readers never do.
   *
   * Disclaimer text is FRED's required wording:
   *   "This product uses the FRED® API but is not endorsed or
   *    certified by the Federal Reserve Bank of St. Louis."
   */
  fredDisclaimer?: boolean;
  /**
   * Same as fredDisclaimer, for the Census Bureau Data API. The Census
   * API ToS requires the equivalent "uses the Census Bureau Data API
   * but is not endorsed" notice on services built on it.
   */
  censusDisclaimer?: boolean;
}

const { title, attributionHref, expanded, fredDisclaimer, censusDisclaimer } =
  Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — {SITE_BRAND_NAME} embed</title>
    {/* Hint to embedding pages that this is safe to iframe.
        Don't set X-Frame-Options here (header-level); Vercel handles
        framing policy globally. */}
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class={`embed-body${expanded ? " embed-body-expanded" : ""}`}>
    <slot />
    <a
      class="embed-attribution"
      href={attributionHref}
      target="_blank"
      rel="noopener noreferrer"
      title={`Open this chart on ${SITE_BRAND_NAME}`}
    >
      {SITE_BRAND_NAME} &rarr; {SITE_BRAND_URL}
    </a>
    {
      (fredDisclaimer || censusDisclaimer) && (
        <div class="embed-disclaimers">
          {fredDisclaimer && (
            <span>
              Uses FRED&reg; API. Not endorsed by the Federal Reserve Bank of St. Louis.
            </span>
          )}
          {censusDisclaimer && (
            <span>
              Uses Census Bureau Data API. Not endorsed by the Census Bureau.
            </span>
          )}
        </div>
      )
    }
  </body>
</html>

<style>
  html,
  body.embed-body {
    height: 100%;
    margin: 0;
    padding: 0;
    background: transparent;
    overflow: hidden;
  }
  body.embed-body {
    /* Editorial baseline so the embedded chart inherits the same
       feel as the main app — no surprise font swaps inside an
       iframe sitting on a host page's serif body text. */
    font-family:
      "Inter Variable", Inter, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    color: #1c1c1a;
  }
  /* Attribution chip sits in the lower-right of the iframe. Small,
     muted, links back to the canonical chart page. */
  .embed-attribution {
    position: fixed;
    bottom: 8px;
    right: 10px;
    font-size: 10px;
    line-height: 1;
    color: #888782;
    text-decoration: none;
    letter-spacing: 0.02em;
    padding: 4px 6px;
    background: rgba(255, 255, 255, 0.7);
    border-radius: 2px;
    z-index: 100;
  }
  .embed-attribution:hover {
    color: #1c1c1a;
    background: rgba(255, 255, 255, 0.95);
  }
  /* FRED required disclaimer. Mirrors the attribution chip on the
     opposite (lower-left) corner so the iframe's two fixed-position
     overlays don't fight for the same pixels. Slightly narrower
     text + same muted-on-translucent-white styling so it reads as
     an annotation rather than a CTA. Short wording (not the full
     "This product uses..." sentence) because horizontal iframe real
     estate is tight; the full sentence appears in the chart's
     dialog footer when the reader clicks through, and on the ToS
     page for anyone who wants the canonical text. */
  /* Required API-attribution chips (FRED, Census). Mirrors the brand
     attribution on the opposite corner. A column so a chart drawing on
     BOTH APIs shows both notices without the two fixed overlays
     colliding. Short wording (not the full sentence) because iframe
     real estate is tight; the canonical sentence lives in the dialog
     footer + the ToS page. */
  .embed-disclaimers {
    position: fixed;
    bottom: 8px;
    left: 10px;
    /* Stop short of the right-hand brand chip on narrow iframes —
       max-width keeps the two from overlapping below ~360px wide. */
    max-width: calc(100% - 140px);
    display: flex;
    flex-direction: column;
    gap: 3px;
    z-index: 100;
  }
  .embed-disclaimers span {
    font-size: 9.5px;
    line-height: 1.2;
    color: #888782;
    letter-spacing: 0.01em;
    padding: 4px 6px;
    background: rgba(255, 255, 255, 0.7);
    border-radius: 2px;
    /* Wrap on very narrow iframes — better than truncating since
       this is required disclaimer text. */
    white-space: normal;
  }
</style>
