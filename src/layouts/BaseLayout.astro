---
import "@fontsource-variable/inter";
import "../styles/global.css";
import EmailSignup from "../components/EmailSignup.astro";
import { SITE_BRAND_NAME } from "../lib/brand";

interface Props {
  title: string;
  description?: string;
  /**
   * URL path (relative to the site root) for the OG image. When unset, falls
   * back to the bare brand card so social-card previews always have *some*
   * thumbnail rather than the platform's generic link icon.
   * Pass e.g. "/og.png?dash=us-macro" or "/og.png?chart=oil/wti".
   */
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

// Build the absolute URL the social-card crawler will hit. Astro.site is
// configured in production; in dev we fall back to the request origin so
// previews work locally too.
const siteOrigin =
  Astro.site?.toString().replace(/\/$/, "") ?? Astro.url.origin;
const resolvedOgPath = ogImage ?? "/og.png?title=Legible+Markets";
const absoluteOgUrl = siteOrigin + resolvedOgPath;
const absolutePageUrl = siteOrigin + Astro.url.pathname + Astro.url.search;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    {/* Canonical URL: tells search engines which version of a page is
        the authoritative one when the same content is reachable from
        multiple URLs (with/without trailing slashes, query strings,
        etc.). Without this, link-juice and indexing get split. */}
    <link rel="canonical" href={absolutePageUrl} />

    {/* JSON-LD Organization + WebSite schema. Helps search engines build
        a knowledge-graph card for the brand and exposes a sitelink-search
        box on Google for the eventual custom domain. Lightweight and
        only rendered once per page (in <head>) — no runtime cost. */}
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Organization",
            name: "Legible Markets",
            url: siteOrigin,
            logo: absoluteOgUrl,
          },
          {
            "@type": "WebSite",
            name: "Legible Markets",
            url: siteOrigin,
            description:
              "Shareable, citation-ready financial dashboards for the analysts, journalists, and staffers who have to explain what's happening in markets to people who don't read Bloomberg.",
            potentialAction: {
              "@type": "SearchAction",
              target: `${siteOrigin}/explore/?q={search_term_string}`,
              "query-input": "required name=search_term_string",
            },
          },
        ],
      })}
    />

    {/* Open Graph + Twitter card. Without these, shared URLs unfurl as a
        generic site card with no chart preview — a major leak on a product
        whose primary distribution channel is shareable links. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Legible Markets" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={absolutePageUrl} />
    <meta property="og:image" content={absoluteOgUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={absoluteOgUrl} />
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="border-b hairline">
      <div
        class="max-w-[1280px] mx-auto px-6 h-14 flex items-center justify-between"
      >
        <a href={baseUrl || "/"} class="no-underline text-neutral-900 font-medium">
          Legible Markets
        </a>
        <nav class="flex items-center gap-5 text-sm">
          <a
            href={`${baseUrl}/explore/`}
            class="text-neutral-600 no-underline hover:text-neutral-900"
          >
            Explore
          </a>
          <a
            href={`${baseUrl}/compose/`}
            class="text-neutral-600 no-underline hover:text-neutral-900"
          >
            Compose
          </a>
          <a
            href={`${baseUrl}/about/`}
            class="text-neutral-600 no-underline hover:text-neutral-900"
          >
            About
          </a>
          <a
            href={`${baseUrl}/me/`}
            class="text-neutral-600 no-underline hover:text-neutral-900"
            data-role="auth-me-link"
            style="display: none"
          >
            My dashboards
          </a>
          <button
            type="button"
            class="text-neutral-600 hover:text-neutral-900 bg-transparent border-0 cursor-pointer p-0"
            data-role="auth-signin"
            style="display: none; font: inherit;"
          >
            Sign in
          </button>
          <button
            type="button"
            class="text-neutral-600 hover:text-neutral-900 bg-transparent border-0 cursor-pointer p-0"
            data-role="auth-signout"
            style="display: none; font: inherit;"
          >
            Sign out
          </button>
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer-inner">
        <div class="site-footer-col site-footer-col-brand">
          <p class="site-footer-brand">{SITE_BRAND_NAME}</p>
          <p class="site-footer-tagline">
            Shareable, citation-ready financial dashboards for the analysts,
            journalists, and staffers who have to explain what's happening
            in markets to people who don't read Bloomberg.
          </p>
        </div>
        <div class="site-footer-col site-footer-col-nav">
          <p class="site-footer-eyebrow">Navigate</p>
          <ul class="site-footer-links">
            <li><a href={`${baseUrl}/explore/`}>Explore charts</a></li>
            <li><a href={`${baseUrl}/compose/`}>Compose a dashboard</a></li>
            <li><a href={`${baseUrl}/enterprise/`}>For organizations</a></li>
            <li><a href={`${baseUrl}/about/`}>About</a></li>
            <li><a href={`${baseUrl}/privacy/`}>Privacy</a></li>
            <li><a href={`${baseUrl}/terms/`}>Terms</a></li>
          </ul>
        </div>
        <div class="site-footer-col site-footer-col-signup">
          <EmailSignup
            variant="footer"
            source="footer"
            title="Stay in the loop"
            blurb="Roughly monthly updates on new data sources and features. No spam."
          />
        </div>
      </div>
    </footer>

    <!-- "Add to my dashboard" modal. Any page can trigger it by dispatching
         CustomEvent("legible:add-to-dashboard", {detail: {chartId}}). The
         modal fetches the user's saved dashboards from Supabase, lets them
         pick one, and PATCHes the chosen dashboard's state_json. -->
    <div class="atd-backdrop" data-role="atd-modal" hidden>
      <div class="atd-modal" role="dialog" aria-modal="true" aria-labelledby="atd-title">
        <div class="atd-header">
          <h3 id="atd-title">Add to a saved dashboard</h3>
          <button type="button" class="atd-close" data-role="atd-close" aria-label="Close">&times;</button>
        </div>
        <div class="atd-body">
          <p class="atd-target muted small" data-role="atd-target">&nbsp;</p>
          <div class="atd-list" data-role="atd-list">
            <p class="muted small">Loading…</p>
          </div>
        </div>
        <div class="atd-footer">
          <button type="button" class="btn-secondary" data-role="atd-cancel">Close</button>
        </div>
      </div>
    </div>

    <script>
      import {
        createSupabase,
        isSupabaseConfigured,
        readStoredSession,
      } from "../lib/supabase";
      if (isSupabaseConfigured) {
        const sb = createSupabase();
        if (sb) {
          const signin = document.querySelector<HTMLButtonElement>(
            "[data-role='auth-signin']",
          );
          const signout = document.querySelector<HTMLButtonElement>(
            "[data-role='auth-signout']",
          );
          const meLink = document.querySelector<HTMLAnchorElement>(
            "[data-role='auth-me-link']",
          );

          function refresh() {
            // Storage-based, synchronous — avoids the getSession/getUser
            // NavigatorLock deadlock path.
            const stored = readStoredSession();
            if (stored) {
              if (signin) signin.style.display = "none";
              if (signout) signout.style.display = "";
              if (meLink) meLink.style.display = "";
            } else {
              if (signin) signin.style.display = "";
              if (signout) signout.style.display = "none";
              if (meLink) meLink.style.display = "none";
            }
          }

          signin?.addEventListener("click", async () => {
            await sb.auth.signInWithOAuth({
              provider: "google",
              options: {
                redirectTo: window.location.href,
                // Request minimum scopes: the user's unique ID + email only.
                // Omitting `profile` means Google won't send name / picture.
                scopes: "openid email",
              },
            });
          });
          signout?.addEventListener("click", async () => {
            await sb.auth.signOut();
            refresh();
          });
          sb.auth.onAuthStateChange(() => refresh());
          refresh();
        }
      }
    </script>

    <script>
      // ---- Add-to-my-dashboard modal ----
      // Listens for `legible:add-to-dashboard` events and walks the user
      // through picking a saved dashboard to append the chart to.
      import {
        readStoredSession,
        SUPABASE_REST_URL,
        SUPABASE_REST_ANON_KEY,
      } from "../lib/supabase";

      type SavedRow = {
        id: string;
        slug: string;
        title: string;
        state_json: any;
        updated_at: string;
      };

      const atdBackdrop = document.querySelector<HTMLElement>(
        "[data-role='atd-modal']",
      );
      const atdList = document.querySelector<HTMLElement>(
        "[data-role='atd-list']",
      );
      const atdTarget = document.querySelector<HTMLElement>(
        "[data-role='atd-target']",
      );
      const atdClose = document.querySelector<HTMLButtonElement>(
        "[data-role='atd-close']",
      );
      const atdCancel = document.querySelector<HTMLButtonElement>(
        "[data-role='atd-cancel']",
      );

      function escapeHtmlSafe(s: string): string {
        return s
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;");
      }

      function closeAtd(): void {
        if (atdBackdrop) atdBackdrop.hidden = true;
      }

      atdClose?.addEventListener("click", closeAtd);
      atdCancel?.addEventListener("click", closeAtd);
      atdBackdrop?.addEventListener("click", (e) => {
        if (e.target === atdBackdrop) closeAtd();
      });
      document.addEventListener("keydown", (e) => {
        if (e.key !== "Escape" || !atdBackdrop || atdBackdrop.hidden) return;
        closeAtd();
      });

      async function fetchSaved(token: string): Promise<SavedRow[]> {
        const url = `${SUPABASE_REST_URL}/rest/v1/saved_dashboards?select=id,slug,title,state_json,updated_at&order=updated_at.desc`;
        const r = await fetch(url, {
          headers: {
            apikey: SUPABASE_REST_ANON_KEY,
            Authorization: `Bearer ${token}`,
          },
        });
        if (!r.ok) throw new Error(`HTTP ${r.status}`);
        return (await r.json()) as SavedRow[];
      }

      // Returns either { ok: true } or { ok: false, message? } where message
      // is the human-readable reason the patch failed. Two failure shapes:
      //   * Rate-limit trigger raises P0001 with a message that already
      //     contains Enterprise-upsell language; surface it verbatim.
      //   * Anything else (RLS denial because user doesn't own the row,
      //     row deleted between read and write, network error, 500) gets
      //     a generic message.
      async function patchDashboard(
        slug: string,
        state: any,
        token: string,
      ): Promise<{ ok: boolean; message?: string }> {
        const url = `${SUPABASE_REST_URL}/rest/v1/saved_dashboards?slug=eq.${encodeURIComponent(slug)}`;
        const r = await fetch(url, {
          method: "PATCH",
          headers: {
            "Content-Type": "application/json",
            apikey: SUPABASE_REST_ANON_KEY,
            Authorization: `Bearer ${token}`,
            Prefer: "return=representation",
          },
          body: JSON.stringify({ state_json: state }),
        });
        if (!r.ok) {
          type ErrorBody = { code?: string; message?: string };
          let body: ErrorBody | null = null;
          try {
            body = (await r.clone().json()) as ErrorBody;
          } catch {
            body = null;
          }
          const message =
            body?.code === "P0001" && typeof body.message === "string"
              ? body.message
              : undefined;
          return { ok: false, message };
        }
        const rows = await r.json().catch(() => []);
        if (Array.isArray(rows) && rows.length > 0) return { ok: true };
        return { ok: false };
      }

      // Add a chart ID to a saved-dashboard state, appending to the last
      // section (creating one if necessary). Returns the mutated state.
      function addChartToState(state: any, chartId: string): any {
        const next = { ...(state ?? {}) };
        next.v = next.v ?? 1;
        if (!Array.isArray(next.sections) || next.sections.length === 0) {
          next.sections = [{ title: "Overview", charts: [chartId] }];
          return next;
        }
        const lastIdx = next.sections.length - 1;
        const last = next.sections[lastIdx];
        const charts: string[] = Array.isArray(last.charts) ? [...last.charts] : [];
        if (!charts.includes(chartId)) charts.push(chartId);
        next.sections = [
          ...next.sections.slice(0, lastIdx),
          { ...last, charts },
        ];
        return next;
      }

      let lastChartId: string | null = null;

      async function openAtd(chartId: string): Promise<void> {
        if (!atdBackdrop || !atdList || !atdTarget) return;
        lastChartId = chartId;
        atdTarget.textContent = `Adding ${chartId}`;
        atdBackdrop.hidden = false;
        atdList.innerHTML = '<p class="muted small">Loading your dashboards…</p>';
        const stored = readStoredSession();
        if (!stored) {
          atdList.innerHTML =
            '<p class="muted small">Sign in (top right) to save and add charts to your dashboards.</p>';
          return;
        }
        let rows: SavedRow[];
        try {
          rows = await fetchSaved(stored.access_token);
        } catch (e) {
          atdList.innerHTML = `<p class="muted small">Couldn't load your dashboards: ${escapeHtmlSafe(String(e))}</p>`;
          return;
        }
        if (rows.length === 0) {
          atdList.innerHTML =
            '<p class="muted small">You haven\'t saved any dashboards yet. Compose one first, then come back.</p>';
          return;
        }
        atdList.innerHTML = "";
        const ul = document.createElement("ul");
        ul.className = "atd-saved-list";
        for (const r of rows) {
          const li = document.createElement("li");
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "atd-saved-item";
          btn.innerHTML =
            `<span class="atd-saved-title">${escapeHtmlSafe(r.title || "Untitled dashboard")}</span>` +
            `<span class="atd-saved-slug muted small">/u/${escapeHtmlSafe(r.slug)}/</span>`;
          btn.addEventListener("click", async () => {
            btn.disabled = true;
            btn.classList.add("atd-saved-item-busy");
            const newState = addChartToState(r.state_json, lastChartId!);
            const result = await patchDashboard(r.slug, newState, stored.access_token);
            if (result.ok) {
              btn.innerHTML = `<span class="atd-saved-title">Added! Open <a href="${(window as any).location?.origin ?? ""}/u/${encodeURIComponent(r.slug)}/" class="underline">/u/${escapeHtmlSafe(r.slug)}/</a></span>`;
              btn.classList.add("atd-saved-item-done");
            } else {
              // Prefer the server-supplied message (rate-limit P0001
              // includes Enterprise-upsell language); fall back to the
              // generic ownership/race-condition explanation.
              const msg =
                result.message ??
                "Couldn't update — you may not own this dashboard, or it may have been deleted.";
              btn.innerHTML = `<span class="atd-saved-title">${escapeHtmlSafe(msg)}</span>`;
              btn.disabled = false;
              btn.classList.remove("atd-saved-item-busy");
            }
          });
          li.appendChild(btn);
          ul.appendChild(li);
        }
        atdList.appendChild(ul);
      }

      window.addEventListener("legible:add-to-dashboard", (e: Event) => {
        const detail = (e as CustomEvent).detail as { chartId?: string } | undefined;
        if (detail?.chartId) openAtd(detail.chartId);
      });
    </script>

    <style>
      .site-footer {
        border-top: 1px solid rgba(55, 53, 47, 0.08);
        margin-top: 64px;
        padding: 40px 24px 32px;
        background: var(--color-white);
      }
      .site-footer-inner {
        max-width: 1120px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.8fr) minmax(0, 1.2fr);
        gap: 48px;
        align-items: start;
      }
      @media (max-width: 720px) {
        .site-footer-inner {
          grid-template-columns: 1fr;
          gap: 28px;
        }
      }
      .site-footer-col {
        min-width: 0;
      }
      .site-footer-brand {
        margin: 0 0 8px;
        font-size: var(--text-sm);
        font-weight: 600;
        color: var(--color-neutral-900);
      }
      .site-footer-tagline {
        margin: 0;
        font-size: var(--text-xs);
        color: var(--color-neutral-600);
        line-height: 1.55;
        max-width: 420px;
      }
      .site-footer-eyebrow {
        margin: 0 0 8px;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--color-neutral-500);
      }
      .site-footer-links {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 6px;
      }
      .site-footer-links a {
        font-size: var(--text-sm);
        color: var(--color-neutral-700);
        text-decoration: none;
      }
      .site-footer-links a:hover {
        color: var(--color-neutral-900);
        text-decoration: underline;
      }
      .atd-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.3);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        z-index: 60;
      }
      .atd-backdrop[hidden] { display: none; }
      .atd-modal {
        background: var(--color-white);
        border-radius: var(--radius);
        max-width: 480px;
        width: 100%;
        max-height: calc(100vh - 40px);
        display: flex;
        flex-direction: column;
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.25);
      }
      .atd-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 16px;
        border-bottom: 1px solid rgba(55, 53, 47, 0.08);
      }
      .atd-header h3 {
        margin: 0;
        font-size: var(--text-base);
        font-weight: 600;
      }
      .atd-close {
        font: inherit;
        font-size: var(--text-xl);
        line-height: 1;
        background: transparent;
        border: none;
        color: var(--color-neutral-500);
        cursor: pointer;
        padding: 0 4px;
      }
      .atd-close:hover { color: var(--color-neutral-900); }
      .atd-body {
        padding: 12px 16px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 8px;
      }
      .atd-target { margin: 0; }
      .atd-saved-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 6px;
      }
      .atd-saved-item {
        font: inherit;
        text-align: left;
        width: 100%;
        background: var(--color-white);
        border: 1px solid rgba(55, 53, 47, 0.08);
        border-radius: var(--radius-sm);
        padding: 8px 10px;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        gap: 2px;
      }
      .atd-saved-item:hover {
        border-color: var(--color-accent);
      }
      .atd-saved-item-busy {
        opacity: 0.6;
        cursor: wait;
      }
      .atd-saved-item-done {
        background: rgba(16, 163, 74, 0.06);
        border-color: rgba(16, 163, 74, 0.4);
        cursor: default;
      }
      .atd-saved-title { font-size: var(--text-sm); color: var(--color-neutral-900); }
      .atd-saved-slug { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
      .atd-footer {
        display: flex;
        justify-content: flex-end;
        padding: 10px 16px;
        border-top: 1px solid rgba(55, 53, 47, 0.08);
      }
    </style>
    <script>
      /*
        Vercel Web Analytics — cookieless pageview + custom-event tracking.
        Loads on every page via BaseLayout. In dev or any non-Vercel host,
        `inject()` no-ops; in production it sends to /_vercel/insights/*,
        which is GDPR-clean (no cookies, no PII stored).

        Custom event firing happens in individual pages/components via:
            import { track } from "../lib/track";
            track("compose_save_succeeded", { slug: "..." });

        track() routes to PostHog (Vercel's Hobby tier silently drops
        custom events, so we don't bother sending them there). When
        PUBLIC_POSTHOG_KEY is unset (local dev or pre-config preview
        builds) every track() call no-ops cleanly.

        Client-side error monitoring also lives here: we listen for
        uncaught errors and unhandled promise rejections and surface them
        as track("js_error", ...) events so PostHog catches them.
        Throttled so a runaway error loop doesn't flood the budget.
      */
      // Vercel handles pageviews via inject() (works on Hobby, free).
      // Custom events go through ../lib/track which routes to PostHog —
      // Vercel's Hobby tier silently drops custom events.
      import { inject } from "@vercel/analytics";
      import { track } from "../lib/track";
      inject();

      // --- Error monitoring ---------------------------------------------
      // Rate-limit + dedupe so a single error firing in a render loop
      // doesn't burn through Vercel's free-tier event budget. We key on
      // (message, source-file) since stack traces are noisy and a single
      // bug usually presents with one message-and-file pair.
      const errSeen = new Map<string, number>();
      const ERR_LIMIT_PER_KEY = 3; // first 3 firings per page session
      const TRUNC = (s: string, n: number) =>
        s.length > n ? s.slice(0, n) + "…" : s;

      function reportError(payload: {
        message: string;
        source: string;
        line?: number;
        col?: number;
        stack?: string;
        kind: "error" | "rejection";
      }) {
        const key = `${payload.message}|${payload.source}|${payload.line ?? 0}`;
        const seen = errSeen.get(key) ?? 0;
        if (seen >= ERR_LIMIT_PER_KEY) return;
        errSeen.set(key, seen + 1);
        // Each Vercel-analytics property is capped at 256 chars; truncate
        // generously so an enormous stack doesn't get the whole event
        // dropped.
        track("js_error", {
          kind: payload.kind,
          message: TRUNC(payload.message, 200),
          source: TRUNC(payload.source, 100),
          line: payload.line ?? 0,
          col: payload.col ?? 0,
          stack: TRUNC(payload.stack ?? "", 200),
          path: location.pathname,
        });
      }

      window.addEventListener("error", (ev) => {
        reportError({
          message: String(ev.message ?? "unknown"),
          source: String(ev.filename ?? "unknown"),
          line: ev.lineno,
          col: ev.colno,
          stack: ev.error?.stack ?? "",
          kind: "error",
        });
      });
      window.addEventListener("unhandledrejection", (ev) => {
        const reason = ev.reason;
        const message =
          (reason && (reason.message || String(reason))) ?? "unknown rejection";
        reportError({
          message: String(message),
          source: location.pathname,
          stack: reason?.stack ?? "",
          kind: "rejection",
        });
      });

      // --- Outbound-link telemetry --------------------------------------
      // Delegated click listener catches <a> elements anywhere on the
      // page. Fires "outbound_link_click" for cross-origin destinations
      // so we can see which external references (source URLs, Notion
      // form, About-page links, etc.) people actually follow.
      //
      // Heuristic:
      //   - Same origin → skip (covered by pageview telemetry)
      //   - mailto:, tel:, javascript: → skip (not really "outbound")
      //   - data-no-outbound attribute → skip (lets us opt out individual
      //     links, e.g. analytics dashboards we don't want noise from)
      //
      // The listener is `capture: true` so we beat any "prevent default"
      // a click handler might set later in the bubble phase.
      document.addEventListener(
        "click",
        (ev) => {
          // Walk up from the target to find an <a> ancestor. <a>s often
          // wrap richer content (icons, spans) so the click target itself
          // may not be the <a>.
          let el: HTMLElement | null = ev.target as HTMLElement | null;
          let anchor: HTMLAnchorElement | null = null;
          while (el && el !== document.body) {
            if (el.tagName === "A") {
              anchor = el as HTMLAnchorElement;
              break;
            }
            el = el.parentElement;
          }
          if (!anchor) return;
          if (anchor.hasAttribute("data-no-outbound")) return;
          const href = anchor.getAttribute("href") ?? "";
          if (!href) return;
          // Bail on protocols we don't want to count: mailto, tel, etc.
          // are intentional escape hatches, not "outbound" in the funnel
          // sense. javascript: is suspicious anyway.
          if (/^(mailto:|tel:|javascript:|#)/i.test(href)) return;
          // Resolve relative URLs against current location to compare
          // origins. Fallback to literal href if parsing fails (which
          // shouldn't happen with the above guards but be safe).
          let url: URL;
          try {
            url = new URL(href, location.href);
          } catch {
            return;
          }
          if (url.origin === location.origin) return;
          // Outbound — track. Use first 200 chars of textContent as a
          // human-readable label (truncated to stay under PostHog limits).
          const text = (anchor.textContent ?? "").trim().slice(0, 200);
          track("outbound_link_click", {
            url: url.href.slice(0, 200),
            host: url.host,
            text,
            path: location.pathname,
          });
        },
        { capture: true },
      );
    </script>
  </body>
</html>
