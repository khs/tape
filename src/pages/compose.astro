  .tag-pill-active,
  .tag-pill-active:hover {
    background: var(--color-neutral-900);
    color: var(--color-white);
    border-color: var(--color-neutral-900);
  }
  /* Geo drill-down chip strip — US metro areas, States & districts,
     Regions & countries. Sits between the search input and the
     topical tag pills. Hidden when none of the three has any data. */
  .lib-geo-chips { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .lib-geo-chips[hidden] { display: none; }
  .lib-geo-chip-wrap { position: relative; }
  /* The CD chip host renders inline as a flex sibling so its chip +
     state dropdown + district dropdown all flow naturally in the
     same row as the popover chips. */
  .lib-geo-cd-host { display: inline-flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .lib-geo-chip {
    font: inherit;
    font-size: var(--text-xs);
    padding: 3px 10px;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(55, 53, 47, 0.12);
    background: var(--color-white);
    color: var(--color-neutral-700);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .lib-geo-chip:hover { background: var(--color-neutral-100); }
  .lib-geo-chip-active {
    background: var(--color-neutral-900);
    color: var(--color-white);
    border-color: var(--color-neutral-900);
  }
  .lib-geo-chip-active:hover { background: var(--color-neutral-800); }
  .lib-geo-chip-clear {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    line-height: 1;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
    cursor: pointer;
  }
  .lib-geo-chip-clear:hover { background: rgba(255, 255, 255, 0.32); }
  .lib-geo-popover {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    width: 280px;
    max-width: 90vw;
    max-height: 320px;
    z-index: 20;
    background: var(--color-white);
    border: 1px solid rgba(55, 53, 47, 0.12);
    border-radius: var(--radius-sm);
    box-shadow: 0 8px 24px rgba(15, 15, 15, 0.12);
    display: flex;
    flex-direction: column;
    padding: 8px;
    gap: 6px;
  }
  .lib-geo-popover[hidden] { display: none; }
  .lib-geo-search {
    width: 100%;
    padding: 6px 10px;
    border: 1px solid rgba(55, 53, 47, 0.12);
    border-radius: var(--radius-sm);
    background: var(--color-white);
    font: inherit;
    font-size: var(--text-sm);
  }
  .lib-geo-list {
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-height: 0;
  }
  .lib-geo-list-item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
    padding: 6px 8px;
    border: none;
    background: transparent;
    text-align: left;
    border-radius: var(--radius-sm);
    cursor: pointer;
    font: inherit;
    font-size: var(--text-sm);
    color: var(--color-neutral-800);
  }
  .lib-geo-list-item:hover { background: var(--color-neutral-100); }
  .lib-geo-list-item-active {
    background: var(--color-neutral-900);
    color: var(--color-white);
  }
  .lib-geo-list-item-active:hover { background: var(--color-neutral-800); }
  .lib-geo-list-item-name { font-weight: 500; }
  .lib-geo-list-item-code { opacity: 0.7; }
  .lib-geo-list-item-active .lib-geo-list-item-code { color: rgba(255, 255, 255, 0.7); }
  /* Section header inside the Countries & regions popover. Sits flush
     left of the items, treated like an eyebrow so it's distinguishable
     from a selectable row. Margin-top zero on the first header so it
     hugs the top of the list. */
  .lib-geo-list-header {
    margin: 8px 4px 2px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-neutral-500);
  }
  .lib-geo-list-header:first-child { margin-top: 0; }
  /* The congressional-district drill-down chip gets a slightly different
     accent so users notice it's not "just another tag" — it expands a
     state/district selector when activated rather than just narrowing
     the existing list. */
  .cd-tag-pill {
    border-style: dashed;
  }
  .cd-tag-pill.tag-pill-active {
    border-style: solid;
  }
  /* State + district dropdowns that follow the CD chip when active.
     Inline-flex so they wrap onto a new line with the chip strip if
     the row gets crowded, but otherwise sit on the same line. */
  .cd-drilldown-select {
    font: inherit;
    font-size: var(--text-xs);
    padding: 2px 6px;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(55, 53, 47, 0.15);
    background: var(--color-white);
    color: var(--color-neutral-800);
    max-width: 220px;
  }
  /* Source-card district badge ("TX-12" / "AK-AL" / "DC-98"). Slightly
     more prominent than the generic shortName badge because, when a
     user is filtered to a state's districts, the district code is the
     primary thing they're scanning for. */
  .source-card-cd-badge {
    color: var(--color-neutral-700);
    background: var(--color-neutral-100);
    padding: 1px 5px;
    border-radius: var(--radius-sm);
  }
  .lib-results {
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
  }
  .lib-group-heading {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-neutral-500);
    margin: 10px 0 2px;
    padding-top: 6px;
    border-top: 1px solid rgba(55, 53, 47, 0.06);
  }
  .lib-group-heading:first-child {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }
  .chart-card {
    text-align: left;
    border: 1px solid rgba(55, 53, 47, 0.08);
    border-radius: var(--radius-sm);
    background: var(--color-white);
    padding: 8px 10px;
    cursor: pointer;
    font: inherit;
  }
  .chart-card:hover {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
  }
  .chart-card-title {
    font-weight: 500;
    font-size: var(--text-sm);
    color: var(--color-neutral-900);
  }
  .chart-card-meta {
    margin-top: 2px;
    font-size: var(--text-xs);
    color: var(--color-neutral-500);
  }

  /* Source-card variant of chart-card with room for the description +
     a short-name (ticker) badge. Same hover-and-click affordance. */
  .source-card {
    text-align: left;
    border: 1px solid rgba(55, 53, 47, 0.08);
    border-radius: var(--radius-sm);
    background: var(--color-white);
    padding: 8px 10px;
    cursor: pointer;
    font: inherit;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .source-card:hover {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
  }
  .source-card-title {
    font-weight: 500;
    font-size: var(--text-sm);
    color: var(--color-neutral-900);
    display: flex;
    align-items: baseline;
    gap: 6px;
  }
  .source-card-short {
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--color-neutral-500);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .source-card-desc {
    font-size: var(--text-xs);
    color: var(--color-neutral-600);
    line-height: 1.35;
    /* Two-line clamp keeps tall descriptions from making the list
       feel uneven — pickable rows should be visually similar in
       height for fast scanning. */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .source-card-tags {
    font-size: var(--text-xs);
    color: var(--color-neutral-500);
  }
  /* Synthetic "See also" cards (kind: hint) — same shape as the
     real source cards but tinted so a quick scan distinguishes
     them from selectable sources. The leading eyebrow tag says
     "See also" so even without colour the user understands these
     are signposts, not data. Click engages the relevant chip
     (see engageHintChip in the script). */
  .source-card-hint {
    background: var(--color-neutral-50);
    border-color: rgba(55, 53, 47, 0.06);
  }
  .source-card-hint:hover {
    background: var(--color-accent-soft);
    border-color: var(--color-accent);
  }
  .source-card-hint-eyebrow {
    display: inline-block;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-neutral-500);
    background: var(--color-neutral-100);
    padding: 1px 6px;
    border-radius: 2px;
    margin-right: 6px;
  }

  .composer-composition {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .comp-empty p { color: var(--color-neutral-500); font-size: var(--text-sm); }
  /* Slightly tighter + dimmer follow-up hint that explains the two
     ways of getting a chart on screen. First-time visitors otherwise
     don't know that "+ Custom chart" is the multi-source path. */
  .comp-empty-hint { max-width: 56ch; margin-top: 4px; line-height: 1.5; }
  .comp-empty-hint strong { color: var(--color-neutral-700); font-weight: 500; }
  .comp-section {
    border: 1px solid rgba(55, 53, 47, 0.08);
    border-radius: var(--radius);
    padding: 12px 14px;
    background: var(--color-white);
    cursor: pointer;
    transition: border-color 0.12s ease, box-shadow 0.12s ease;
  }
  .comp-section-active {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 1px var(--color-accent);
    cursor: default;
  }
  .comp-section-active-hint {
    font-size: var(--text-xs);
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
    color: var(--color-accent);
    white-space: nowrap;
  }
  .comp-section-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
  }
  .comp-section-drag-handle {
    user-select: none;
    cursor: grab;
    color: var(--color-neutral-400);
    font-size: var(--text-sm);
    line-height: 1;
    padding: 0 2px;
    letter-spacing: -3px;
    flex-shrink: 0;
  }
  .comp-section-drag-handle:active {
    cursor: grabbing;
  }
  .comp-section-drag-handle:hover {
    color: var(--color-neutral-700);
  }
  /* Section drop indicators — a thin accent line above or below the target. */
  .comp-section.drop-before {
    box-shadow: 0 -3px 0 0 var(--color-accent);
  }
  .comp-section.drop-after {
    box-shadow: 0 3px 0 0 var(--color-accent);
  }
  .comp-section.dragging {
    opacity: 0.5;
  }
  .comp-section-title {
    flex: 1;
    font: inherit;
    font-weight: 600;
    font-size: var(--text-base);
    color: var(--color-neutral-900);
    background: transparent;
    border: none;
    padding: 4px 0;
  }
  .comp-section-del {
    font: inherit;
    font-size: var(--text-lg);
    line-height: 1;
    background: transparent;
    border: none;
    color: var(--color-neutral-400);
    cursor: pointer;
    padding: 0 6px;
  }
  .comp-section-del:hover { color: var(--color-error); }
  .comp-section-desc {
    width: 100%;
    font: inherit;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-neutral-600);
    background: transparent;
    border: none;
    padding: 0 0 8px;
    resize: vertical;
    min-height: 28px;
  }
  .comp-section-desc::placeholder { color: var(--color-neutral-400); }
  .comp-section-desc:focus { outline: none; }
  /* Markdown body textarea — distinct visual treatment from the
     description: monospace-ish font hint (so users see they can
     write code/markdown), slightly recessed background so the
     content authoring surface reads as a different artifact than
     the title + description. */
  .comp-section-md {
    width: 100%;
    font: inherit;
    font-family: ui-monospace, "SF Mono", Consolas, monospace;
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--color-neutral-800);
    background: rgba(55, 53, 47, 0.04);
    border: 1px solid rgba(55, 53, 47, 0.1);
    border-radius: var(--radius-sm);
    padding: 8px 10px;
    margin: 4px 0 6px;
    resize: vertical;
    min-height: 60px;
  }
  .comp-section-md::placeholder { color: var(--color-neutral-400); }
  .comp-section-md:focus {
    outline: none;
    border-color: rgba(55, 53, 47, 0.3);
    background: rgba(55, 53, 47, 0.02);
  }
  .comp-section-md[hidden] { display: none; }
  .comp-section-md-toggle {
    background: none;
    border: none;
    color: var(--color-neutral-500);
    font: inherit;
    font-size: 11px;
    padding: 0 0 6px;
    cursor: pointer;
    text-align: left;
  }
  .comp-section-md-toggle:hover { color: var(--color-neutral-900); }
  .comp-section-md-toggle[hidden] { display: none; }
  /* Section-level window override row — sits between the
     description textarea and the chart grid. Tight visual weight so
     it doesn't compete with the title + chart tiles. */
  .comp-section-window {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-xs);
    padding: 0 0 8px;
    flex-wrap: wrap;
  }
  .comp-section-window-label { white-space: nowrap; }
  .comp-section-window-select {
    font: inherit;
    font-size: var(--text-xs);
    background: var(--color-white);
    border: 1px solid rgba(55, 53, 47, 0.12);
    border-radius: var(--radius-sm);
    padding: 3px 6px;
    color: var(--color-neutral-800);
    cursor: pointer;
  }
  .comp-section-window-dates {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .comp-section-window-date {
    font: inherit;
    font-size: var(--text-xs);
    border: 1px solid rgba(55, 53, 47, 0.12);
    border-radius: var(--radius-sm);
    padding: 2px 6px;
  }
  .comp-section-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 8px;
    /* Make the grid a forgiving drop target even when nearly empty. */
    min-height: 32px;
    border-radius: var(--radius-sm);
    transition: background-color 0.12s ease, outline-color 0.12s ease;
    outline: 2px dashed transparent;
    outline-offset: -2px;
  }
  .comp-section-grid.drop-target {
    background: rgba(0, 0, 0, 0.02);
    outline-color: var(--color-accent);
  }
  .comp-tile.dragging {
    opacity: 0.35;
  }
  .comp-empty-slot {
    grid-column: 1 / -1;
    padding: 18px;
    text-align: center;
    border: 1px dashed rgba(55, 53, 47, 0.12);
    border-radius: var(--radius-sm);
  }
  .comp-tile {
    position: relative;
    border: 1px solid rgba(55, 53, 47, 0.08);
    border-radius: var(--radius-sm);
    padding: 10px 52px 10px 12px;
    background: var(--color-neutral-50);
  }
  .comp-tile-edit {
    position: absolute;
    top: 4px;
    right: 24px;
    background: transparent;
    border: none;
    font: inherit;
    font-size: var(--text-sm);
    line-height: 1;
    padding: 2px 4px;
    color: var(--color-neutral-400);
    cursor: pointer;
  }
  .comp-tile-edit:hover { color: var(--color-accent); }
  .comp-tile.has-override .comp-tile-edit {
    color: var(--color-accent);
  }
  .comp-tile-preview-btn {
    position: absolute;
    bottom: 4px;
    right: 4px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* font-size anchors the icon's em sizing: the SVG below is 1.3em, so
       it renders ~30% larger than the edit pencil (which sits at --text-sm). */
    font-size: var(--text-sm);
    line-height: 1;
    padding: 2px;
    border: none;
    border-radius: var(--radius-sm);
    /* Faint tile-colored backing so the icon stays legible over the
       sparkline that fills the tile body. */
    background: color-mix(in srgb, var(--color-neutral-50) 78%, transparent);
    color: var(--color-neutral-400);
    cursor: pointer;
  }
  .comp-tile-preview-btn svg {
    width: 1.3em;
    height: 1.3em;
    display: block;
  }
  .comp-tile-preview-btn:hover { color: var(--color-accent); }
  .comp-tile-title {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-neutral-900);
  }
  .comp-tile-meta {
    margin-top: 2px;
    font-size: var(--text-xs);
    color: var(--color-neutral-500);
  }
  .comp-tile-del {
    position: absolute;
    top: 4px;
    right: 6px;
    background: transparent;
    border: none;
    font: inherit;
    font-size: var(--text-base);
    line-height: 1;
    color: var(--color-neutral-400);
    cursor: pointer;
    padding: 2px 6px;
  }
  .comp-tile-del:hover { color: var(--color-error); }
  .comp-tile-inline {
    border-style: dashed;
  }
  /* Inline-map tile variant — same chrome as regular chart tiles but
     the map preview takes more vertical room, so let it set its own
     min-height rather than being squashed. */
  .comp-tile-map {
    border-style: dashed;
  }
  /* Visual preview slot under the title/meta. Lazy-filled by
     renderTilePreview(); empty (height: 0) until the SVG / Plot
     output replaces its contents. The fixed heights below take over
     as soon as the preview lands, so layout doesn't flicker on the
     async fill. */
  .comp-tile-preview {
    margin-top: 6px;
  }
  .comp-tile-preview:empty {
    display: none;
  }
  .comp-tile-preview > svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .comp-tile-map .comp-tile-preview {
    background: rgba(15, 118, 110, 0.04);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }
  .comp-tile-coverage-warn {
    border-color: var(--color-error);
    box-shadow: inset 0 0 0 1px rgba(220, 38, 38, 0.25);
  }
  .comp-tile-coverage-flag {
    color: var(--color-error);
  }
  .composer-fixed-inputs {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: 6px;
  }
  .composer-date {
    font: inherit;
    font-size: var(--text-xs);
    padding: 2px 6px;
    border: 1px solid rgba(55, 53, 47, 0.12);
    border-radius: var(--radius-sm);
    background: var(--color-white);
  }
  .comp-tile-editable {
    cursor: pointer;
  }
  .comp-tile-editable:hover {
    border-color: var(--color-accent);
  }
  .comp-controls {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  /* Hover-merge buildup. Two-layer visual to read unmistakably as
     "something is about to happen":
       1. The tile body picks up a colored outline + tinted background
          the instant the buildup class lands.
       2. A progress bar fills along the bottom of the tile over the
          remaining HOVER_MERGE_HOLD_MS - HOVER_MERGE_BUILDUP_DELAY_MS,
          so the user sees the merge approaching and can move the cursor
          away to cancel.
     The combination — instant tint + animated bar — is louder than the
     prior subtle box-shadow pulse, which several testers couldn't see. */
  @keyframes hover-merge-fill {
    from { width: 0%; }
    to   { width: 100%; }
  }
  .comp-tile.hover-merge-buildup {
    border-color: var(--color-accent) !important;
    background: var(--color-accent-soft);
    box-shadow: 0 0 0 2px var(--color-accent);
  }
  .comp-tile.hover-merge-buildup::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    height: 4px;
    width: 0;
    background: var(--color-accent);
    border-bottom-left-radius: inherit;
    animation: hover-merge-fill 800ms linear forwards;
    pointer-events: none;
  }

  /* Tip line shown under the composition when 2+ charts are present and
     the user hasn't dismissed it yet. Subtle so it doesn't compete with
     the dashboard, but visible enough to teach. */
  .comp-hover-merge-tip {
    margin-top: 12px;
    padding: 8px 12px;
    background: var(--color-accent-soft);
    border: 1px solid rgba(55, 53, 47, 0.08);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    color: var(--color-neutral-700);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }
  .comp-hover-merge-tip-dismiss {
    background: transparent;
    border: none;
    font: inherit;
    font-size: var(--text-sm);
    line-height: 1;
    color: var(--color-neutral-500);
    cursor: pointer;
    padding: 2px 6px;
  }
  .comp-hover-merge-tip-dismiss:hover { color: var(--color-neutral-900); }

  /* Combine-with menu shown on touch long-press. Absolute-positioned by
     JS near the long-pressed tile; scrolls if it overflows the viewport.
     The body listener click-outside handler hides it. */
  .combine-with-menu {
    position: fixed;
    z-index: 60;
    min-width: 220px;
    max-width: min(360px, calc(100vw - 16px));
    max-height: 60vh;
    overflow-y: auto;
    background: var(--color-white);
    border: 1px solid rgba(55, 53, 47, 0.15);
    border-radius: var(--radius);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
    padding: 6px;
    font-size: var(--text-sm);
  }
  .combine-with-menu-heading {
    padding: 6px 10px;
    font-size: var(--text-xs);
    color: var(--color-neutral-500);
    border-bottom: 1px solid rgba(55, 53, 47, 0.06);
    margin-bottom: 4px;
  }
  .combine-with-menu-empty {
    padding: 8px 10px;
    color: var(--color-neutral-500);
    font-size: var(--text-xs);
    font-style: italic;
  }
  .combine-with-menu-item,
  .combine-with-menu-cancel {
    display: block;
    width: 100%;
    text-align: left;
    background: transparent;
    border: none;
    font: inherit;
    font-size: var(--text-sm);
    padding: 8px 10px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    color: var(--color-neutral-900);
  }
  .combine-with-menu-item:hover,
  .combine-with-menu-item:focus {
    background: var(--color-accent-soft);
    outline: none;
  }
  .combine-with-menu-cancel {
    color: var(--color-neutral-500);
    margin-top: 4px;
    border-top: 1px solid rgba(55, 53, 47, 0.06);
