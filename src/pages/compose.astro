    border-color: var(--color-neutral-900);
  }
  /* Geo drill-down chip strip — currently just Metro area, sits between
     the search input and the tag pills. Hidden when no metros are
     loaded so the strip doesn't occupy vertical space pre-pipelines. */
  .lib-geo-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .lib-geo-chips[hidden] { display: none; }
  .lib-geo-chip-wrap { position: relative; }
  .lib-geo-chip {
    font: inherit;
    font-size: var(--text-xs);
    padding: 3px 10px;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(55, 53, 47, 0.12);
    background: var(--color-white);
    color: var(--color-neutral-700);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .lib-geo-chip:hover { background: var(--color-neutral-100); }
  .lib-geo-chip-active {
    background: var(--color-neutral-900);
    color: var(--color-white);
    border-color: var(--color-neutral-900);
  }
  .lib-geo-chip-active:hover { background: var(--color-neutral-800); }
  .lib-geo-chip-clear {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    line-height: 1;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
    cursor: pointer;
  }
  .lib-geo-chip-clear:hover { background: rgba(255, 255, 255, 0.32); }
  .lib-geo-popover {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    width: 280px;
    max-width: 90vw;
    max-height: 320px;
    z-index: 20;
    background: var(--color-white);
    border: 1px solid rgba(55, 53, 47, 0.12);
    border-radius: var(--radius-sm);
    box-shadow: 0 8px 24px rgba(15, 15, 15, 0.12);
    display: flex;
    flex-direction: column;
    padding: 8px;
    gap: 6px;
  }
  .lib-geo-popover[hidden] { display: none; }
  .lib-geo-search {
    width: 100%;
    padding: 6px 10px;
    border: 1px solid rgba(55, 53, 47, 0.12);
    border-radius: var(--radius-sm);
    background: var(--color-white);
    font: inherit;
    font-size: var(--text-sm);
  }
  .lib-geo-list {
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-height: 0;
  }
  .lib-geo-list-item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
    padding: 6px 8px;
    border: none;
    background: transparent;
    text-align: left;
    border-radius: var(--radius-sm);
    cursor: pointer;
    font: inherit;
    font-size: var(--text-sm);
    color: var(--color-neutral-800);
  }
  .lib-geo-list-item:hover { background: var(--color-neutral-100); }
  .lib-geo-list-item-active {
    background: var(--color-neutral-900);
    color: var(--color-white);
  }
  .lib-geo-list-item-active:hover { background: var(--color-neutral-800); }
  .lib-geo-list-item-name { font-weight: 500; }
  .lib-geo-list-item-code { opacity: 0.7; }
  .lib-geo-list-item-active .lib-geo-list-item-code { color: rgba(255, 255, 255, 0.7); }
  .lib-results {
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
  }
  .lib-group-heading {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-neutral-500);
    margin: 10px 0 2px;
    padding-top: 6px;
    border-top: 1px solid rgba(55, 53, 47, 0.06);
  }
  .lib-group-heading:first-child {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }
  .chart-card {
    text-align: left;
    border: 1px solid rgba(55, 53, 47, 0.08);
    border-radius: var(--radius-sm);
    background: var(--color-white);
    padding: 8px 10px;
    cursor: pointer;
    font: inherit;
  }
  .chart-card:hover {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
  }
  .chart-card-title {
    font-weight: 500;
    font-size: var(--text-sm);
    color: var(--color-neutral-900);
  }
  .chart-card-meta {
    margin-top: 2px;
    font-size: var(--text-xs);
    color: var(--color-neutral-500);
  }

  /* Source-card variant of chart-card with room for the description +
     a short-name (ticker) badge. Same hover-and-click affordance. */
  .source-card {
    text-align: left;
    border: 1px solid rgba(55, 53, 47, 0.08);
    border-radius: var(--radius-sm);
    background: var(--color-white);
    padding: 8px 10px;
    cursor: pointer;
    font: inherit;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .source-card:hover {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
  }
  .source-card-title {
    font-weight: 500;
    font-size: var(--text-sm);
    color: var(--color-neutral-900);
    display: flex;
    align-items: baseline;
    gap: 6px;
  }
  .source-card-short {
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--color-neutral-500);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .source-card-desc {
    font-size: var(--text-xs);
    color: var(--color-neutral-600);
    line-height: 1.35;
    /* Two-line clamp keeps tall descriptions from making the list
       feel uneven — pickable rows should be visually similar in
       height for fast scanning. */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .source-card-tags {
    font-size: var(--text-xs);
    color: var(--color-neutral-500);
  }

  .composer-composition {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .comp-empty p { color: var(--color-neutral-500); font-size: var(--text-sm); }
  .comp-section {
    border: 1px solid rgba(55, 53, 47, 0.08);
    border-radius: var(--radius);
    padding: 12px 14px;
    background: var(--color-white);
    cursor: pointer;
    transition: border-color 0.12s ease, box-shadow 0.12s ease;
  }
  .comp-section-active {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 1px var(--color-accent);
    cursor: default;
  }
  .comp-section-active-hint {
    font-size: var(--text-xs);
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
    color: var(--color-accent);
    white-space: nowrap;
  }
  .comp-section-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
  }
  .comp-section-drag-handle {
    user-select: none;
    cursor: grab;
    color: var(--color-neutral-400);
    font-size: var(--text-sm);
    line-height: 1;
    padding: 0 2px;
    letter-spacing: -3px;
    flex-shrink: 0;
  }
  .comp-section-drag-handle:active {
    cursor: grabbing;
  }
  .comp-section-drag-handle:hover {
    color: var(--color-neutral-700);
  }
  /* Section drop indicators — a thin accent line above or below the target. */
  .comp-section.drop-before {
    box-shadow: 0 -3px 0 0 var(--color-accent);
  }
  .comp-section.drop-after {
    box-shadow: 0 3px 0 0 var(--color-accent);
  }
  .comp-section.dragging {
    opacity: 0.5;
  }
  .comp-section-title {
    flex: 1;
    font: inherit;
    font-weight: 600;
    font-size: var(--text-base);
    color: var(--color-neutral-900);
    background: transparent;
    border: none;
    padding: 4px 0;
  }
  .comp-section-del {
    font: inherit;
    font-size: var(--text-lg);
    line-height: 1;
    background: transparent;
    border: none;
    color: var(--color-neutral-400);
    cursor: pointer;
    padding: 0 6px;
  }
  .comp-section-del:hover { color: var(--color-error); }
  .comp-section-desc {
    width: 100%;
    font: inherit;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-neutral-600);
    background: transparent;
    border: none;
    padding: 0 0 8px;
    resize: vertical;
    min-height: 28px;
  }
  .comp-section-desc::placeholder { color: var(--color-neutral-400); }
  .comp-section-desc:focus { outline: none; }
  .comp-section-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 8px;
    /* Make the grid a forgiving drop target even when nearly empty. */
    min-height: 32px;
    border-radius: var(--radius-sm);
    transition: background-color 0.12s ease, outline-color 0.12s ease;
    outline: 2px dashed transparent;
    outline-offset: -2px;
  }
  .comp-section-grid.drop-target {
    background: rgba(0, 0, 0, 0.02);
    outline-color: var(--color-accent);
  }
  .comp-tile.dragging {
    opacity: 0.35;
  }
  .comp-empty-slot {
    grid-column: 1 / -1;
    padding: 18px;
    text-align: center;
    border: 1px dashed rgba(55, 53, 47, 0.12);
    border-radius: var(--radius-sm);
  }
  .comp-tile {
    position: relative;
    border: 1px solid rgba(55, 53, 47, 0.08);
    border-radius: var(--radius-sm);
    padding: 10px 52px 10px 12px;
    background: var(--color-neutral-50);
  }
  .comp-tile-edit {
    position: absolute;
    top: 4px;
    right: 24px;
    background: transparent;
    border: none;
    font: inherit;
    font-size: var(--text-sm);
    line-height: 1;
    padding: 2px 4px;
    color: var(--color-neutral-400);
    cursor: pointer;
  }
  .comp-tile-edit:hover { color: var(--color-accent); }
  .comp-tile.has-override .comp-tile-edit {
    color: var(--color-accent);
  }
  .comp-tile-title {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-neutral-900);
  }
  .comp-tile-meta {
    margin-top: 2px;
    font-size: var(--text-xs);
    color: var(--color-neutral-500);
  }
  .comp-tile-del {
    position: absolute;
    top: 4px;
    right: 6px;
    background: transparent;
    border: none;
    font: inherit;
    font-size: var(--text-base);
    line-height: 1;
    color: var(--color-neutral-400);
    cursor: pointer;
    padding: 2px 6px;
  }
  .comp-tile-del:hover { color: var(--color-error); }
  .comp-tile-inline {
    border-style: dashed;
  }
  .comp-tile-coverage-warn {
    border-color: var(--color-error);
    box-shadow: inset 0 0 0 1px rgba(220, 38, 38, 0.25);
  }
  .comp-tile-coverage-flag {
    color: var(--color-error);
  }
  .composer-fixed-inputs {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: 6px;
  }
  .composer-date {
    font: inherit;
    font-size: var(--text-xs);
    padding: 2px 6px;
    border: 1px solid rgba(55, 53, 47, 0.12);
    border-radius: var(--radius-sm);
    background: var(--color-white);
  }
  .comp-tile-editable {
    cursor: pointer;
  }
  .comp-tile-editable:hover {
    border-color: var(--color-accent);
  }
  .comp-controls {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  /* ---- Custom-chart modal ---- */
  .cc-modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    z-index: 50;
  }
  .cc-modal-backdrop[hidden] { display: none; }
  .cc-modal {
    background: var(--color-white);
    border-radius: var(--radius);
    max-width: 560px;
    width: 100%;
    max-height: calc(100vh - 40px);
    display: flex;
    flex-direction: column;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.25);
  }
  /* Wider modal when the body uses the split form/preview layout. */
  .cc-modal:has(.cc-modal-split) {
    max-width: 960px;
  }
  .cc-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px;
    border-bottom: 1px solid rgba(55, 53, 47, 0.08);
  }
  .cc-modal-header h3 { margin: 0; font-size: var(--text-base); font-weight: 600; }
  .cc-modal-close {
    font: inherit;
    font-size: var(--text-xl);
    line-height: 1;
    background: transparent;
    border: none;
    color: var(--color-neutral-500);
    cursor: pointer;
    padding: 0 4px;
  }
  .cc-modal-close:hover { color: var(--color-neutral-900); }
  .cc-modal-body {
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    overflow-y: auto;
  }
  /* Split layout: form left, live preview right; stacks below 720px. */
  .cc-modal-split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 22px;
    align-items: start;
  }
  @media (max-width: 720px) {
    .cc-modal-split {
      grid-template-columns: 1fr;
    }
  }
  .cc-modal-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }
  .cc-modal-preview {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
    border-left: 1px solid rgba(55, 53, 47, 0.06);
    padding-left: 18px;
  }
  @media (max-width: 720px) {
    .cc-modal-preview {
      border-left: none;
      border-top: 1px solid rgba(55, 53, 47, 0.06);
      padding-left: 0;
      padding-top: 14px;
    }
  }
  .cc-preview-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
  }
  .cc-preview-status {
    font-size: var(--text-xs);
    color: var(--color-neutral-500);
  }
  .cc-preview-plot {
    min-height: 220px;
    background: var(--color-neutral-50);
    border-radius: var(--radius-sm);
    padding: 6px;
  }
  .cc-preview-legend {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 14px;
    font-size: var(--text-xs);
    color: var(--color-neutral-700);
  }
  .cc-preview-legend li {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .cc-legend-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
  }
  .cc-field { display: flex; flex-direction: column; gap: 6px; }
  .cc-field input[type="text"],
  .cc-field input[type="search"],
  .cc-source-search {
    font: inherit;
    padding: 6px 10px;
    border: 1px solid rgba(55, 53, 47, 0.12);
    border-radius: var(--radius-sm);
    background: var(--color-white);
  }
  .cc-sources-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }
  .cc-sources-count {
    font-size: var(--text-xs);
    color: var(--color-neutral-500);
  }
  .cc-source-list {
    border: 1px solid rgba(55, 53, 47, 0.08);
    border-radius: var(--radius-sm);
    max-height: 280px;
    overflow-y: auto;
    background: var(--color-white);
  }
  .cc-source-row {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 8px 12px;
    cursor: pointer;
    border-bottom: 1px solid rgba(55, 53, 47, 0.04);
  }
  .cc-source-row:last-child { border-bottom: none; }
  .cc-source-row:hover { background: var(--color-neutral-100); }
  .cc-source-row input[type="checkbox"] { margin-top: 3px; }
  .cc-source-row-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: var(--text-sm);
  }
  .cc-source-primary { color: var(--color-neutral-900); font-weight: 500; }
  .cc-source-secondary { color: var(--color-neutral-500); font-size: var(--text-xs); }
  .cc-source-axis {
    margin-left: auto;
    display: inline-flex;
    gap: 0;
    border: 1px solid rgba(55, 53, 47, 0.18);
    border-radius: var(--radius-sm);
    overflow: hidden;
    flex-shrink: 0;
  }
  .cc-axis-pill {
    font: inherit;
    font-size: var(--text-xs);
    line-height: 1;
    padding: 3px 8px;
    background: var(--color-white);
    border: none;
    color: var(--color-neutral-600);
    cursor: pointer;
  }
  .cc-axis-pill + .cc-axis-pill {
    border-left: 1px solid rgba(55, 53, 47, 0.12);
  }
  .cc-axis-pill:hover { background: var(--color-neutral-100); }
  .cc-axis-pill-active {
    background: var(--color-neutral-900);
    color: var(--color-white);
  }
  .cc-source-row { align-items: center; }
  /* Derived-source picker rows are buttons, not labels (single-select). */
  .ds-source-list {
    max-height: 180px;
    overflow-y: auto;
  }
  .ds-source-row {
    display: block;
    width: 100%;
    text-align: left;
    font: inherit;
    font-size: var(--text-sm);
    background: var(--color-white);
    border: none;
    padding: 6px 12px;
    cursor: pointer;
    color: var(--color-neutral-900);
    border-bottom: 1px solid rgba(55, 53, 47, 0.04);
  }
  .ds-source-row:last-child { border-bottom: none; }
  .ds-source-row:hover { background: var(--color-neutral-100); }
  .ds-source-row-selected {
    background: var(--color-accent-soft, rgba(37, 99, 235, 0.12));
    color: var(--color-accent);
    font-weight: 500;
  }
  .ds-source-row-disabled {
    color: var(--color-neutral-400);
    cursor: not-allowed;
  }
  .ds-source-row-disabled:hover { background: var(--color-white); }
  .ds-source-row-derived::before {
    content: "◇ ";
    color: var(--color-accent);
  }
  .ds-current { margin-top: 4px; font-style: italic; }
  /* Auto-insert toggle in the derived-source modal — pre-checked so the
     dominant "I want X / Y as a tile right now" path takes zero extra
     clicks. Indented and dim so it reads as an optional refinement,
     not as a primary CTA. */
  .ds-add-as-chart {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin-top: 12px;
    font-size: var(--text-sm);
    cursor: pointer;
  }
  .ds-add-as-chart input[type="checkbox"] {
    margin-top: 3px;
    flex-shrink: 0;
  }
  .ds-add-as-chart > span {
    line-height: 1.4;
  }
  /* Quick-divisor chips — one-click pre-fill of op + B in the
     derived-source modal for the common per-capita / per-worker /
     share-of-GDP recipes. Sits above Name + Operation so it reads
     as a shortcut row rather than a third operand. */
  .ds-quick-divisors {
    background: var(--color-neutral-100);
    border-radius: var(--radius-sm);
    padding: 8px 10px;
  }
  .ds-quick-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 4px;
  }
  .ds-quick-chip {
    font: inherit;
    font-size: var(--text-xs);
    padding: 4px 10px;
    border: 1px solid rgba(55, 53, 47, 0.12);
    background: var(--color-white);
    border-radius: 999px;
    color: var(--color-neutral-800);
    cursor: pointer;
    line-height: 1.4;
  }
  .ds-quick-chip:hover {
    border-color: rgba(55, 53, 47, 0.3);
    background: var(--color-neutral-100);
  }
  .ds-quick-chip-active {
    background: var(--color-accent, #2563eb);
    border-color: var(--color-accent, #2563eb);
    color: var(--color-white);
  }
  .ds-quick-chip-active:hover {
    background: var(--color-accent, #2563eb);
    border-color: var(--color-accent, #2563eb);
  }
  .ds-quick-help { margin: 6px 0 0; }
  .cc-mode {
    display: flex;
    flex-direction: column;
    gap: 6px;
    border: none;
    padding: 0;
    margin: 0;
  }
  .cc-mode legend {
    padding: 0;
    margin-bottom: 4px;
  }
  .cc-mode-opt {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: var(--text-sm);
    color: var(--color-neutral-700);
    line-height: 1.35;
  }
  .cc-mode-opt input { margin-top: 3px; flex-shrink: 0; }
  .cc-mode-opt-disabled {
    color: var(--color-neutral-400);
    cursor: not-allowed;
  }
  .cc-mode-opt-disabled input { cursor: not-allowed; }
  /* Log-scale toggle sits as a sibling to the scale-mode fieldset, not
     inside it (it's an independent axis decision, not a normalize mode).
     Matches the .cc-mode-opt visuals so they read as one cluster of
     scale-related controls. */
  .cc-log-opt {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin-top: 6px;
    padding-top: 8px;
    border-top: 1px solid rgba(55, 53, 47, 0.06);
    font-size: var(--text-sm);
    color: var(--color-neutral-700);
    line-height: 1.35;
  }
  .cc-log-opt input { margin-top: 3px; flex-shrink: 0; }
  .cc-log-opt.cc-log-opt-disabled {
    color: var(--color-neutral-400);
    cursor: not-allowed;
  }
  .cc-log-opt.cc-log-opt-disabled input { cursor: not-allowed; }
  .cc-op-wrap {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-top: 6px;
    border-top: 1px solid rgba(55, 53, 47, 0.06);
  }
  .cc-op-wrap[hidden] { display: none; }
  .cc-op-wrap select {
    font: inherit;
    padding: 4px 8px;
    border: 1px solid rgba(55, 53, 47, 0.12);
    border-radius: var(--radius-sm);
    background: var(--color-white);
  }
