---
import BaseLayout from "../layouts/BaseLayout.astro";
export const prerender = true;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout
  title="Compose a dashboard — Tape"
  description="Build your own Tape dashboard from the chart library."
>
  <div class="composer-shell" data-base-url={baseUrl}>
    <div class="composer-topbar">
      <div class="composer-title-wrap">
        <input
          type="text"
          class="composer-title-input"
          data-role="title-input"
          placeholder="Untitled dashboard"
        />
      </div>
      <div class="composer-window-wrap">
        <label class="eyebrow" for="composer-default-delta">Time</label>
        <select id="composer-default-delta" data-role="default-delta">
          <option value="">Auto window</option>
          <option value="1w">1W trailing</option>
          <option value="1m">1M trailing</option>
          <option value="1y">1Y trailing</option>
          <option value="5y">5Y trailing</option>
          <option value="10y">10Y trailing</option>
          <option value="30y">30Y trailing</option>
          <option value="50y">50Y trailing</option>
          <option value="fixed">Fixed dates…</option>
        </select>
        <span class="composer-fixed-inputs" data-role="fixed-inputs" hidden>
          <input
            type="date"
            data-role="fixed-start"
            class="composer-date"
            aria-label="Start date"
          />
          <span class="muted small">→</span>
          <input
            type="date"
            data-role="fixed-end"
            class="composer-date"
            aria-label="End date"
          />
        </span>
      </div>
      <div class="composer-actions">
        <button type="button" class="btn-secondary" data-role="copy-share">Copy share link</button>
        <button type="button" class="btn-secondary" data-role="save" data-save-default-label="Save to my account">Save to my account</button>
        <a class="btn-primary" data-role="preview-link" href={`${baseUrl}/custom/`}>Preview &rarr;</a>
      </div>
    </div>

    <div class="composer-url-warn" data-role="url-warn" hidden>
      <strong>Heads up:</strong> the share link is getting long
      (<span data-role="url-warn-len">0</span> chars).
      Some browsers and servers cap URLs around 8&nbsp;KB.
      Use <strong>Save to my account</strong> to get a short
      <code>/u/&lt;slug&gt;/</code> link instead.
    </div>

    <div class="composer-description-wrap">
      <textarea
        class="composer-description-input"
        data-role="description-input"
        rows="2"
        placeholder="Add a short description for this dashboard (optional)…"></textarea>
    </div>

    <div class="composer-layout">
      <aside class="composer-library">
        <!--
          Two-tab library: "Sources" (primary, every available data
          series) and "Pregenerated charts" (curated multi-source /
          editorial chart specs). Sources is the default because the
          common case is "I want to track X" where X is a single
          series; pregenerated charts are for the "I want this
          specific comparison" case the editor has set up.
        -->
        <div class="lib-tabs" role="tablist">
          <button
            type="button"
            class="lib-tab lib-tab-active"
            data-role="lib-tab"
            data-tab="sources"
            role="tab"
            aria-selected="true"
          >Sources</button>
          <button
            type="button"
            class="lib-tab"
            data-role="lib-tab"
            data-tab="charts"
            role="tab"
            aria-selected="false"
          >Pregenerated charts</button>
        </div>

        <div class="lib-panel" data-role="lib-panel-sources">
          <div class="lib-controls">
            <input
              type="search"
              class="lib-search"
              data-role="lib-search-sources"
              placeholder="Search sources by name, ticker, or tag..."
            />
            <!--
              Geo-chip strip — three chips, equal billing, above the
              topical tag pills:
                • US metro areas      (popover-with-searchable-list)
                • States & districts  (state + district inline dropdowns)
                • Regions & countries (popover-with-searchable-list)
              Order matches user-facing label order. Auto-hides only if
              none of the three has data (in practice always shown on
              the Sources tab).
            -->
            <div class="lib-geo-chips" data-role="lib-geo-chips" hidden>
              <div class="lib-geo-chip-wrap">
                <button
                  type="button"
                  class="lib-geo-chip"
                  data-role="lib-metro-chip"
                  aria-haspopup="listbox"
                  aria-expanded="false"
                >
                  <span class="lib-geo-chip-label" data-role="lib-metro-label"
                    >US metro areas &#9662;</span>
                  <span
                    class="lib-geo-chip-clear"
                    data-role="lib-metro-clear"
                    hidden
                    aria-label="Clear metro filter">&times;</span>
                </button>
                <div
                  class="lib-geo-popover"
                  data-role="lib-metro-popover"
                  role="listbox"
                  hidden
                >
                  <input
                    type="search"
                    class="lib-geo-search"
                    data-role="lib-metro-search"
                    placeholder="Search metros…"
                    aria-label="Search metros"
                  />
                  <div
                    class="lib-geo-list"
                    data-role="lib-metro-list"
                  ></div>
                </div>
              </div>
              <!--
                CD chip + drilldown rendered by renderCdChip(surface)
                into this host element. The chip + (when active) state
                + district dropdowns all live inline next to the metro
                + country chips. The host gets innerHTML-cleared and
                re-rendered each time CD state changes, which is OK
                because nothing else lives inside it.
              -->
              <div class="lib-geo-cd-host" data-role="lib-cd-chip-host"></div>
              <div class="lib-geo-chip-wrap">
                <button
                  type="button"
                  class="lib-geo-chip"
                  data-role="lib-country-chip"
                  aria-haspopup="listbox"
                  aria-expanded="false"
                >
                  <span class="lib-geo-chip-label" data-role="lib-country-label"
                    >Regions and countries &#9662;</span>
                  <span
                    class="lib-geo-chip-clear"
                    data-role="lib-country-clear"
                    hidden
                    aria-label="Clear country filter">&times;</span>
                </button>
                <div
                  class="lib-geo-popover"
                  data-role="lib-country-popover"
                  role="listbox"
                  hidden
                >
                  <input
                    type="search"
                    class="lib-geo-search"
                    data-role="lib-country-search"
                    placeholder="Search regions + countries…"
                    aria-label="Search regions + countries"
                  />
                  <div
                    class="lib-geo-list"
                    data-role="lib-country-list"
                  ></div>
                </div>
              </div>
            </div>
            <!--
              Tag-filter strip — "all" + topical tags only. Geo chips
              (CD + metro + country) live in the geo strip above.
            -->
            <div class="lib-tag-filters" data-role="tag-filters-sources"></div>
          </div>
          <div class="lib-results" data-role="lib-results-sources">
            <p class="muted small">Loading sources...</p>
          </div>
        </div>

        <div class="lib-panel" data-role="lib-panel-charts" hidden>
          <div class="lib-controls">
            <input
              type="search"
              class="lib-search"
              data-role="lib-search-charts"
              placeholder="Search pregenerated charts..."
            />
            <div class="lib-tag-filters" data-role="tag-filters-charts"></div>
          </div>
          <div class="lib-results" data-role="lib-results-charts">
            <p class="muted small">Loading pregenerated charts...</p>
          </div>
        </div>
      </aside>

      <main class="composer-composition">
        <div class="comp-empty" data-role="comp-empty">
          <p class="muted">Pick charts on the left to start composing. They'll appear here organized into sections.</p>
        </div>
        <div class="comp-sections" data-role="comp-sections"></div>
        <div class="comp-controls">
          <button type="button" class="btn-secondary" data-role="add-section">+ Add section</button>
          <button type="button" class="btn-secondary" data-role="open-custom-chart">+ Custom chart</button>
          <button type="button" class="btn-secondary" data-role="open-derived-source">+ Derived source</button>
        </div>
      </main>
    </div>

    <footer class="composer-footer">
      <p>
        Want something not available here yet? Contact Keller Scholl at
        <a href="mailto:keller.scholl@gmail.com">keller.scholl@gmail.com</a>.
      </p>
    </footer>

    <!-- Per-chart blurb / title override modal. -->
    <div class="cc-modal-backdrop" data-role="cb-modal" hidden>
      <div class="cc-modal" role="dialog" aria-modal="true" aria-labelledby="cb-modal-title">
        <div class="cc-modal-header">
          <h3 id="cb-modal-title">Edit chart note</h3>
          <button type="button" class="cc-modal-close" data-role="cb-close" aria-label="Close">&times;</button>
        </div>
        <div class="cc-modal-body">
          <p class="muted small" data-role="cb-chart-name">&nbsp;</p>
          <label class="cc-field">
            <span class="eyebrow">Title (override)</span>
            <input type="text" data-role="cb-title" placeholder="Leave blank to keep the chart's default title" />
          </label>
          <label class="cc-field">
            <span class="eyebrow">Note shown when expanded</span>
            <textarea data-role="cb-blurb" rows="6" placeholder="What should readers notice about this chart in the context of your dashboard? Plain text. Leave blank to omit."></textarea>
          </label>
        </div>
        <div class="cc-modal-footer">
          <button type="button" class="btn-secondary" data-role="cb-cancel">Cancel</button>
          <button type="button" class="btn-primary" data-role="cb-save">Save</button>
        </div>
      </div>
    </div>

    <!-- Derived-source modal. Combines two sources (real or already-derived)
         into a new first-class source that can be used anywhere a regular
         source can. -->
    <div class="cc-modal-backdrop" data-role="ds-modal" hidden>
      <div class="cc-modal" role="dialog" aria-modal="true" aria-labelledby="ds-modal-title">
        <div class="cc-modal-header">
          <h3 id="ds-modal-title">New derived source</h3>
          <button type="button" class="cc-modal-close" data-role="ds-close" aria-label="Close">&times;</button>
        </div>
        <div class="cc-modal-body">
          <p class="muted small">
            Combines two existing sources (real or derived) into a new
            source you can use in any chart.
          </p>
          <div class="cc-field ds-quick-divisors">
            <span class="eyebrow">Quick: divide by…</span>
            <div class="ds-quick-chips" data-role="ds-quick-chips">
              <button
                type="button"
                class="ds-quick-chip"
                data-role="ds-quick"
                data-divisor-id="fred/us_population"
                data-name-template="per capita"
              >÷ US population</button>
              <button
                type="button"
                class="ds-quick-chip"
                data-role="ds-quick"
                data-divisor-id="fred/us_real_gdp"
                data-name-template="share of GDP"
              >÷ US GDP</button>
              <button
                type="button"
                class="ds-quick-chip"
                data-role="ds-quick"
                data-divisor-id="fred/payrolls"
                data-name-template="per worker"
              >÷ US employment</button>
              <button
                type="button"
                class="ds-quick-chip"
                data-role="ds-quick"
                data-divisor-id="fred/us_cpi"
                data-name-template="real (CPI-adjusted)"
                title="Plots the ratio of A to CPI. Shape is correct for 'is this growing faster than inflation?'; units are 'per CPI point' rather than textbook real dollars."
              >÷ CPI</button>
            </div>
            <p class="muted small ds-quick-help">
              Pre-fills the divisor and operation; pick the numerator (A) below.
            </p>
          </div>
          <label class="cc-field">
            <span class="eyebrow">Name</span>
            <input type="text" data-role="ds-name" placeholder="e.g. Retail-gas / WTI" />
          </label>
          <label class="cc-field">
            <span class="eyebrow">Operation</span>
            <select data-role="ds-op">
              <option value="divide">Divide (A ÷ B)</option>
              <option value="diff">Difference (A − B)</option>
              <option value="sum">Sum (A + B)</option>
            </select>
          </label>
          <div class="cc-field">
            <span class="eyebrow">Filter operands by tag (optional)</span>
            <!--
              Geo-chip strip — same three-chip layout as the Sources
              tab + cc-modal. Above the topical tag pills.
            -->
            <div class="lib-geo-chips" data-role="ds-geo-chips" hidden>
              <div class="lib-geo-chip-wrap">
                <button type="button" class="lib-geo-chip" data-role="ds-metro-chip" aria-haspopup="listbox" aria-expanded="false">
                  <span class="lib-geo-chip-label" data-role="ds-metro-label">US metro areas &#9662;</span>
                  <span class="lib-geo-chip-clear" data-role="ds-metro-clear" hidden aria-label="Clear metro filter">&times;</span>
                </button>
                <div class="lib-geo-popover" data-role="ds-metro-popover" role="listbox" hidden>
                  <input type="search" class="lib-geo-search" data-role="ds-metro-search" placeholder="Search metros…" aria-label="Search metros" />
                  <div class="lib-geo-list" data-role="ds-metro-list"></div>
                </div>
              </div>
              <div class="lib-geo-cd-host" data-role="ds-cd-chip-host"></div>
              <div class="lib-geo-chip-wrap">
                <button type="button" class="lib-geo-chip" data-role="ds-country-chip" aria-haspopup="listbox" aria-expanded="false">
                  <span class="lib-geo-chip-label" data-role="ds-country-label">Regions and countries &#9662;</span>
                  <span class="lib-geo-chip-clear" data-role="ds-country-clear" hidden aria-label="Clear country filter">&times;</span>
                </button>
                <div class="lib-geo-popover" data-role="ds-country-popover" role="listbox" hidden>
                  <input type="search" class="lib-geo-search" data-role="ds-country-search" placeholder="Search regions + countries…" aria-label="Search regions + countries" />
                  <div class="lib-geo-list" data-role="ds-country-list"></div>
                </div>
              </div>
            </div>
            <div class="cc-source-tags lib-tag-filters" data-role="ds-source-tags"></div>
          </div>
          <div class="cc-field">
            <span class="eyebrow">A (first operand)</span>
            <input
              type="search"
              class="cc-source-search"
              data-role="ds-a-search"
              placeholder="Search sources…"
            />
            <div class="cc-source-list ds-source-list" data-role="ds-a-list"></div>
            <p class="muted small ds-current" data-role="ds-a-current">No source picked yet.</p>
          </div>
          <div class="cc-field">
            <span class="eyebrow">B (second operand)</span>
            <input
              type="search"
              class="cc-source-search"
              data-role="ds-b-search"
              placeholder="Search sources…"
            />
            <div class="cc-source-list ds-source-list" data-role="ds-b-list"></div>
            <p class="muted small ds-current" data-role="ds-b-current">No source picked yet.</p>
          </div>
          <p class="cc-op-hint muted small" data-role="ds-hint">&nbsp;</p>
          <label class="ds-add-as-chart">
            <input type="checkbox" data-role="ds-add-as-chart" checked />
            <span>
              Also add as a chart to the current section
              <span class="muted small">— uncheck if you just want the source available for other charts.</span>
            </span>
          </label>
        </div>
        <div class="cc-modal-footer">
          <button type="button" class="btn-secondary" data-role="ds-cancel">Cancel</button>
          <button type="button" class="btn-primary" data-role="ds-create" disabled>Create source</button>
        </div>
      </div>
    </div>

    <!-- Custom-chart modal. Mounted with display:none; the script toggles it. -->
    <div class="cc-modal-backdrop" data-role="cc-modal" hidden>
      <div class="cc-modal" role="dialog" aria-modal="true" aria-labelledby="cc-modal-title">
        <div class="cc-modal-header">
          <h3 id="cc-modal-title">New custom chart</h3>
          <button type="button" class="cc-modal-close" data-role="cc-close" aria-label="Close">&times;</button>
        </div>
        <div class="cc-modal-body cc-modal-split">
          <div class="cc-modal-form">
            <label class="cc-field">
              <span class="eyebrow">Title</span>
              <input type="text" data-role="cc-title" placeholder="Give this chart a name…" />
            </label>
            <div class="cc-field">
              <div class="cc-sources-header">
                <span class="eyebrow">Sources</span>
                <span class="cc-sources-count" data-role="cc-count">0 selected</span>
              </div>
              <input type="search" class="cc-source-search" data-role="cc-source-search" placeholder="Search sources by name, ticker, or tag…" />
              <!--
                Geo-chip strip — same three-chip layout as the Sources
                tab, in the same order. Lives ABOVE the topical tag
                pills so geo picks are the first thing users see.
              -->
              <div class="lib-geo-chips" data-role="cc-geo-chips" hidden>
                <div class="lib-geo-chip-wrap">
                  <button type="button" class="lib-geo-chip" data-role="cc-metro-chip" aria-haspopup="listbox" aria-expanded="false">
                    <span class="lib-geo-chip-label" data-role="cc-metro-label">US metro areas &#9662;</span>
                    <span class="lib-geo-chip-clear" data-role="cc-metro-clear" hidden aria-label="Clear metro filter">&times;</span>
                  </button>
                  <div class="lib-geo-popover" data-role="cc-metro-popover" role="listbox" hidden>
                    <input type="search" class="lib-geo-search" data-role="cc-metro-search" placeholder="Search metros…" aria-label="Search metros" />
                    <div class="lib-geo-list" data-role="cc-metro-list"></div>
                  </div>
                </div>
                <div class="lib-geo-cd-host" data-role="cc-cd-chip-host"></div>
                <div class="lib-geo-chip-wrap">
                  <button type="button" class="lib-geo-chip" data-role="cc-country-chip" aria-haspopup="listbox" aria-expanded="false">
                    <span class="lib-geo-chip-label" data-role="cc-country-label">Regions and countries &#9662;</span>
                    <span class="lib-geo-chip-clear" data-role="cc-country-clear" hidden aria-label="Clear country filter">&times;</span>
                  </button>
                  <div class="lib-geo-popover" data-role="cc-country-popover" role="listbox" hidden>
                    <input type="search" class="lib-geo-search" data-role="cc-country-search" placeholder="Search regions + countries…" aria-label="Search regions + countries" />
                    <div class="lib-geo-list" data-role="cc-country-list"></div>
                  </div>
                </div>
              </div>
              <div class="cc-source-tags lib-tag-filters" data-role="cc-source-tags"></div>
              <div class="cc-source-list" data-role="cc-source-list"></div>
            </div>
            <fieldset class="cc-mode" data-role="cc-mode">
              <legend class="eyebrow">Scale</legend>
              <label class="cc-mode-opt">
                <input type="radio" name="cc-mode" value="raw" data-role="cc-mode-raw" />
                <span><strong>Raw</strong> — plot each series at its own value. Best when all picked sources share the same scale (e.g. several inflation rates).</span>
              </label>
              <label class="cc-mode-opt" data-role="cc-mode-rebase-wrap">
                <input type="radio" name="cc-mode" value="rebase" data-role="cc-mode-rebase" />
                <span><strong>Rebase</strong> — index every series to 100 at the window start. Best when scales differ wildly (mortgage rates + S&amp;P).</span>
              </label>
              <label class="cc-mode-opt" data-role="cc-mode-dual-wrap">
                <input type="radio" name="cc-mode" value="dual-axis" data-role="cc-mode-dual" />
                <span><strong>Dual-axis</strong> — split sources between left and right y-axes (any combination, e.g. one on the left, three on the right). Needs at least two sources.</span>
              </label>
            </fieldset>
            <label class="cc-field">
              <span class="eyebrow">Note (shown when expanded)</span>
              <textarea
                data-role="cc-blurb"
                rows="3"
                placeholder="What should readers notice about this chart? Plain text. Optional."
              ></textarea>
            </label>
            <label
              class="cc-log-opt"
              data-role="cc-log-wrap"
              title="Log-scale the y-axis. Makes exponential growth (market caps, GDP, prices over decades) read as a straight line. Disabled when dual-axis is selected — running log on one axis and linear on the other would be misleading."
            >
              <input type="checkbox" data-role="cc-log" />
              <span><strong>Log scale</strong> — makes exponential growth read as a straight line. Combine with raw or rebase; off with dual-axis.</span>
            </label>
            <!--
              percentDisplay control: only relevant when the chart's
              combine output would auto-render as percent (same-class
              divide, e.g. currency/currency). Visibility is gated in
              JS on (op === "divide" && exactly 2 sources) — leaving
              it visible always would invite confusion when it's a
              silent no-op.
            -->
            <label class="cc-field" data-role="cc-percent-display-wrap" hidden>
              <span class="eyebrow">Show divide result as</span>
              <select data-role="cc-percent-display-select">
                <option value="percent">Percent (104%)</option>
                <option value="decimal">Decimal (1.04)</option>
                <option value="ratio">Ratio (1.04:1)</option>
              </select>
            </label>
            <p class="muted small">
              Need to plot a ratio, sum, or difference?
              Click <strong>+ Derived source</strong> outside this modal
              first; then pick the derived source here like any other.
            </p>
          </div>
          <div class="cc-modal-preview">
            <div class="cc-preview-header">
              <span class="eyebrow">Preview</span>
              <span class="cc-preview-status muted small" data-role="cc-preview-status">Pick a source to preview.</span>
            </div>
            <div class="cc-preview-plot" data-role="cc-preview-plot"></div>
            <ul class="cc-preview-legend" data-role="cc-preview-legend"></ul>
          </div>
        </div>
        <div class="cc-modal-footer">
          <button type="button" class="btn-secondary" data-role="cc-cancel">Cancel</button>
          <button type="button" class="btn-primary" data-role="cc-create" disabled>Create chart</button>
        </div>
      </div>
    </div>

    <!--
      Sign-in prompt: shown when an anonymous composer session has used
      its per-IP action budget (chart-adds + derived-source-creates,
      capped at 20 per 24h via the compose_action_check RPC). Real
      humans rarely hit this; bots do, fast.

      The Sign-in button reuses the existing Google OAuth flow (same as
      the Save-to-account button) with redirectTo=window.location.href
      so the in-progress composer state survives the round trip.
    -->
    <div class="cc-modal-backdrop" data-role="signin-prompt" hidden>
      <div class="cc-modal" role="dialog" aria-modal="true" aria-labelledby="signin-prompt-title">
        <div class="cc-modal-header">
          <h3 id="signin-prompt-title">Sign in to keep editing</h3>
          <button type="button" class="cc-modal-close" data-role="signin-prompt-close" aria-label="Close">&times;</button>
        </div>
        <div class="cc-modal-body">
          <p>
            You've added <strong>20 charts or sources</strong> from this network
            without an account. To keep editing — and to save dashboards so
            you can come back to them — sign in with Google.
          </p>
          <p class="muted small">
            No charges, no spam, no resale. Sign-in only lets us tell legitimate
            users apart from scripts so the free tier stays free. If you're on
            a shared network (library, office) and this seems wrong, email
            keller.scholl@gmail.com.
          </p>
        </div>
        <div class="cc-modal-footer">
          <button type="button" class="btn-secondary" data-role="signin-prompt-dismiss">Close</button>
          <button type="button" class="btn-primary" data-role="signin-prompt-signin">Sign in with Google</button>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import {
    encodeComposedState,
    decodeComposedState,
    type ComposedState,
    type InlineChart,
    type InlineSource,
  } from "../lib/composer-state";
  import type { DeltaWindow } from "../lib/deltas";
  import {
    createSupabase,
    isSupabaseConfigured,
    readStoredSession,
    SUPABASE_REST_URL,
    SUPABASE_REST_ANON_KEY,
  } from "../lib/supabase";
  import { nanoid } from "nanoid";
  import * as Plot from "@observablehq/plot";
  import { track } from "../lib/track";
  import { packSourceIds } from "../lib/analytics-helpers";
  import { METRO_TAG } from "../lib/geographic-regions";
  import { COUNTRY_TAG, isRegionCode } from "../lib/countries";
  import {
    CD_TAG,
    STATE_TAG,
    STATEWIDE_DISTRICT_CODE,
    parseCdSourceId,
    parseStateSourceId,
    formatDistrictLabel,
    formatCdShortLabel,
    stateNameFor,
  } from "../lib/congressional-districts";

  type LibraryChart = {
    id: string;
    title: string;
    tags: string[];
    sources: string[];
    defaultDelta?: DeltaWindow;
    // Fields needed by the promote-library-to-inline path so library
    // charts can be opened in the custom-chart modal for full editing.
    // Optional because the schema marks them all optional too — older
    // library.json snapshots may not carry them.
    normalize?: "raw" | "rebase" | "dual-axis";
    scale?: "linear" | "log";
    rightAxisSources?: string[];
    op?: "divide" | "sum" | "diff";
    blurb?: string;
    searchText?: string;
  };
  type LibrarySource = {
    id: string;
    name: string;
    shortName?: string;
    description?: string;
    kind?: string;
    supportedDeltas?: DeltaWindow[];
    unit?: string;
  };
  type MetroEntry = { shortName: string; name: string };
  type CountryEntry = { name: string };
  type LibraryPayload = {
    charts: LibraryChart[];
    sources: Record<string, LibrarySource>;
    // Metros that appear in at least one source on disk. Empty/absent
    // when the metro pipelines haven't run yet — the chip stays hidden.
    metros?: Record<string, MetroEntry>;
    // The synthetic tag prefix the server attaches to metro sources.
    // Kept in the payload so the composer doesn't have to hardcode it
    // separately from the library lib.
    metroTag?: string;
    // Country / region codes (ISO3 for countries, WB region codes for
    // aggregates) present in at least one source. Empty/absent when
    // the country pipelines haven't produced any non-US country data.
    countries?: Record<string, CountryEntry>;
    // Synthetic tag prefix for country / region sources. Used for the
    // umbrella tag (`country-specific`) and per-country tags
    // (`country-specific:JPN`, etc.) the server attaches.
    countryTag?: string;
  };

  const _shellMaybe = document.querySelector<HTMLElement>(".composer-shell");
  if (!_shellMaybe) throw new Error("composer shell missing");
  // Pin to a non-nullable local. The `let shell: HTMLElement = ...`
  // form would also work but a fresh const reads cleanest. Avoids
  // ~30 spurious "possibly null" errors in TS strict mode where the
  // narrowing from the if-guard doesn't propagate into closures.
  const shell: HTMLElement = _shellMaybe;
  const baseUrl = shell.dataset.baseUrl ?? "";

  // If `?edit=<slug>` is present, the composer is editing an existing saved
  // dashboard rather than creating a new one. Save becomes Update (PATCH).
  // We hold this outside the URL-encoded composed state so it never leaks
  // into shared links.
  let editingSlug: string | null = null;

  // ---- State ----
  type ChartOverride = {
    title?: string;
    defaultDelta?: DeltaWindow;
    blurb?: string;
  };
  interface UIState {
    title: string;
    description: string;
    defaultDelta: DeltaWindow | "";
    // When set, takes precedence over defaultDelta; pinned [start, end].
    fixedRange?: { start: string; end: string };
    sections: { title: string; description: string; charts: string[] }[];
    inlineCharts: Record<string, InlineChart>;
    inlineSources: Record<string, InlineSource>;
    chartOverrides: Record<string, ChartOverride>;
  }

  const defaultSections = () => [
    { title: "Overview", description: "", charts: [] as string[] },
  ];

  let state: UIState = {
    title: "",
    description: "",
    defaultDelta: "",
    sections: defaultSections(),
    inlineCharts: {},
    inlineSources: {},
    chartOverrides: {},
  };

  const INLINE_PREFIX = "inline:";
  const DERIVED_PREFIX = "derived:";
  function isDerivedId(id: string): boolean {
    return id.startsWith(DERIVED_PREFIX);
  }
  function isInlineId(id: string): boolean {
    return id.startsWith(INLINE_PREFIX);
  }

  // ---- Load library ----
  async function loadLibrary(): Promise<LibraryPayload> {
    const r = await fetch(`${baseUrl}/library.json`);
    if (!r.ok) throw new Error(`Library fetch failed: ${r.status}`);
    return r.json();
  }

  // ---- URL state hydration on load ----
  function hydrateFromUrl(): void {
    const url = new URL(window.location.href);
    const editParam = url.searchParams.get("edit");
    if (editParam) editingSlug = editParam;
    const d = url.searchParams.get("d");
    if (!d) return;
    const res = decodeComposedState(d);
    if (!res.ok) {
      console.warn("Composed state decode failed:", res.message);
      return;
    }
    const s = res.state;
    state.title = s.title ?? "";
    state.description = s.description ?? "";
    state.defaultDelta = (s.defaultDelta as DeltaWindow | undefined) ?? "";
    state.fixedRange = s.fixedRange;
    if (s.sections && s.sections.length > 0) {
      state.sections = s.sections.map((sec) => ({
        title: sec.title,
        description: sec.description ?? "",
        charts: [...sec.charts],
      }));
    } else if (s.charts && s.charts.length > 0) {
      state.sections = [
        { title: "Overview", description: "", charts: [...s.charts] },
      ];
    } else {
      state.sections = defaultSections();
    }
    state.inlineCharts = { ...(s.inlineCharts ?? {}) };
    state.inlineSources = { ...(s.inlineSources ?? {}) };
    state.chartOverrides = {
      ...((s.chartOverrides as Record<string, ChartOverride>) ?? {}),
    };
    // Preserve existing "adds go to the last section" default when a fork is loaded.
    activeSectionIdx = state.sections.length - 1;
  }

  // ---- URL state writing ----
  // Collect only the inline-chart IDs that are actually referenced by some
  // section, so removing a chart also prunes its orphaned inline spec.
  function referencedInlineCharts(): Record<string, InlineChart> | undefined {
    const refs: Record<string, InlineChart> = {};
    for (const sec of state.sections) {
      for (const cid of sec.charts) {
        if (isInlineId(cid) && state.inlineCharts[cid]) {
          refs[cid] = state.inlineCharts[cid];
        }
      }
    }
    return Object.keys(refs).length > 0 ? refs : undefined;
  }

  // Walk the dashboard for transitive references to inline (derived)
  // sources — any source ID with the derived: prefix used either by an
  // inline chart's sources list or by another derived source's a/b.
  // Drops entries that aren't reachable so renaming/removing a chart
  // doesn't leave orphans in the saved state.
  function referencedInlineSources(): Record<string, InlineSource> | undefined {
    if (Object.keys(state.inlineSources).length === 0) return undefined;
    const reachable = new Set<string>();
    function visit(id: string): void {
      if (!isDerivedId(id)) return;
      if (reachable.has(id)) return;
      const spec = state.inlineSources[id];
      if (!spec) return;
      reachable.add(id);
      visit(spec.a);
      visit(spec.b);
    }
    // Seed from all inline-chart sources currently in use.
    for (const sec of state.sections) {
      for (const cid of sec.charts) {
        if (!isInlineId(cid)) continue;
        const ic = state.inlineCharts[cid];
        if (!ic) continue;
        for (const sid of ic.sources) visit(sid);
      }
    }
    if (reachable.size === 0) return undefined;
    const out: Record<string, InlineSource> = {};
    for (const id of reachable) out[id] = state.inlineSources[id];
    return out;
  }

  // Strip empty values from chart overrides, drop overrides for charts no
  // longer referenced, and return undefined when nothing's left.
  function referencedChartOverrides(): Record<string, ChartOverride> | undefined {
    const referenced = new Set<string>();
    for (const sec of state.sections) for (const cid of sec.charts) referenced.add(cid);
    const refs: Record<string, ChartOverride> = {};
    for (const [cid, ov] of Object.entries(state.chartOverrides)) {
      if (!referenced.has(cid)) continue;
      const trimmed: ChartOverride = {};
      if (ov.title && ov.title.trim()) trimmed.title = ov.title.trim();
      if (ov.defaultDelta) trimmed.defaultDelta = ov.defaultDelta;
      if (ov.blurb && ov.blurb.trim()) trimmed.blurb = ov.blurb.trim();
      if (Object.keys(trimmed).length > 0) refs[cid] = trimmed;
    }
    return Object.keys(refs).length > 0 ? refs : undefined;
  }

  function writeUrl(): void {
    const clean: Omit<ComposedState, "v"> = {
      title: state.title || undefined,
      description: state.description || undefined,
      defaultDelta: (state.defaultDelta || undefined) as DeltaWindow | undefined,
      fixedRange: state.fixedRange,
      sections: state.sections
        .filter((s) => s.charts.length > 0)
        .map((s) => ({
          title: s.title,
          description: s.description || undefined,
          charts: [...s.charts],
        })),
      inlineCharts: referencedInlineCharts(),
      inlineSources: referencedInlineSources(),
      chartOverrides: referencedChartOverrides(),
    };
    if (!clean.sections || clean.sections.length === 0) delete clean.sections;
    if (!clean.inlineCharts) delete clean.inlineCharts;
    if (!clean.inlineSources) delete clean.inlineSources;
    if (!clean.chartOverrides) delete clean.chartOverrides;
    const encoded = encodeComposedState(clean);
    const url = new URL(window.location.href);
    if (Object.keys(clean).length === 0) {
      url.searchParams.delete("d");
    } else {
      url.searchParams.set("d", encoded);
    }
    window.history.replaceState(null, "", url.toString());

    const preview = shell.querySelector<HTMLAnchorElement>("[data-role='preview-link']");
    if (preview) {
      preview.href = `${baseUrl}/custom/?d=${encoded}`;
    }

    // Warn when the share URL is getting close to the practical browser/proxy
    // limit (~8KB). At 7000 chars we surface a banner suggesting the user save
    // to their account so they can share /u/<slug>/ instead, which is short
    // regardless of state size.
    const SHARE_URL_WARN_AT = 7000;
    const warnBanner = shell.querySelector<HTMLElement>("[data-role='url-warn']");
    const warnLen = shell.querySelector<HTMLElement>("[data-role='url-warn-len']");
    const shareUrlLen = url.toString().length;
    if (warnBanner) {
      if (shareUrlLen >= SHARE_URL_WARN_AT) {
        warnBanner.hidden = false;
        if (warnLen) warnLen.textContent = String(shareUrlLen);
      } else {
        warnBanner.hidden = true;
      }
    }
  }

  // ---- Render ----
  let library: LibraryPayload | null = null;
  // Library panel has two tabs — Sources (primary) and Pregenerated
  // charts. Each tab keeps its own search query + selected-tag set so
  // switching tabs doesn't lose the user's current filter.
  type LibTab = "sources" | "charts";
  let activeLibTab: LibTab = "sources";
  const chartsSelectedTags: Set<string> = new Set<string>();
  const sourcesSelectedTags: Set<string> = new Set<string>();
  let chartsSearchQuery: string = "";
  let sourcesSearchQuery: string = "";
  // Geo-chip state. Same shape on three picker surfaces — the Sources
  // tab (libGeo), the cc-modal (ccModal.geo), and the ds-modal
  // (dsModal.geo) — so the same render/select/clear/popover code can
  // serve all three. The DOM-element selectors differ per surface;
  // the shared functions resolve them via GEO_SURFACES below.
  interface GeoState {
    selectedMetroCbsa: string | null;
    selectedCountryCode: string | null;
    metroPopoverOpen: boolean;
    countryPopoverOpen: boolean;
    metroSearchQuery: string;
    countrySearchQuery: string;
  }
  const newGeoState = (): GeoState => ({
    selectedMetroCbsa: null,
    selectedCountryCode: null,
    metroPopoverOpen: false,
    countryPopoverOpen: false,
    metroSearchQuery: "",
    countrySearchQuery: "",
  });
  const libGeo: GeoState = newGeoState();

  // Per-surface state for the Congressional district drill-down. The
  // Sources tab keeps its picks across tab switches so a user browsing
  // TX-12 series doesn't lose their place when they hop to the chart
  // library tab. Parallel state lives on ccModal / dsModal for those
  // pickers; resets each modal-open.
  let sourcesCdState: string | null = null;
  let sourcesCdDistrict: string | null = null;

  // Memoize the state→districts map (built from library source IDs)
  // because we look it up every time a dropdown re-renders, and rebuilding
  // it from ~2,200 source IDs on every keystroke would be wasteful.
  // Districts include the synthetic STATEWIDE_DISTRICT_CODE for any state
  // that has at least one state-level source — that's how the "Statewide"
  // dropdown option gets surfaced without special-casing the renderer.
  let cdsByStateCache: Map<string, string[]> | null = null;
  function cdsByState(state: string): string[] {
    if (!cdsByStateCache && library) {
      const m = new Map<string, Set<string>>();
      for (const id of Object.keys(library.sources)) {
        const parsedCd = parseCdSourceId(id);
        if (parsedCd) {
          if (!m.has(parsedCd.state)) m.set(parsedCd.state, new Set<string>());
          m.get(parsedCd.state)!.add(parsedCd.district);
        }
        const parsedState = parseStateSourceId(id);
        if (parsedState) {
          if (!m.has(parsedState.state))
            m.set(parsedState.state, new Set<string>());
          m.get(parsedState.state)!.add(STATEWIDE_DISTRICT_CODE);
        }
      }
      cdsByStateCache = new Map(
        [...m.entries()].map(([k, v]) => {
          // Sort districts with Statewide first (so it leads the dropdown),
          // then numeric/at-large/etc. in their natural string order.
          const list = [...v];
          list.sort((a, b) => {
            if (a === STATEWIDE_DISTRICT_CODE) return -1;
            if (b === STATEWIDE_DISTRICT_CODE) return 1;
            return a.localeCompare(b);
          });
          return [k, list];
        }),
      );
    }
    return cdsByStateCache?.get(state) ?? [];
  }

  // Distinct states represented in the library's CD or state-level
  // sources, ordered by display name. Computed once the library loads.
  function cdStatesAvailable(): string[] {
    if (!library) return [];
    const codes = new Set<string>();
    for (const id of Object.keys(library.sources)) {
      const parsedCd = parseCdSourceId(id);
      if (parsedCd) codes.add(parsedCd.state);
      const parsedState = parseStateSourceId(id);
      if (parsedState) codes.add(parsedState.state);
    }
    return [...codes].sort((a, b) =>
      stateNameFor(a).localeCompare(stateNameFor(b)),
    );
  }

  // Apply geo-region-visibility rules to one source ID + its tag list.
  // Used by all three picker surfaces (Sources tab, cc-modal, ds-modal)
  // so they share identical semantics for the "States & districts" chip:
  //
  //   - Chip OFF: hide everything tagged CD_TAG or STATE_TAG. (Returns
  //     non-geo sources unchanged.)
  //   - Chip ON, no state: hide all geo sources (state pick is the gate).
  //   - Chip ON + state, no district: keep geo sources for that state —
  //     both the state-level series AND every CD's series.
  //   - Chip ON + state + district = STATEWIDE_DISTRICT_CODE: keep only
  //     that state's state-level series; CDs hidden.
  //   - Chip ON + state + specific district: keep only that exact CD's
  //     series; state-level sources hidden.
  //
  // Tied to CD_TAG as the chip's master "is active" flag for backwards
  // compatibility with the migration's existing tag presence.
  function passesCdFilter(
    id: string,
    tags: string[],
    selectedTags: Set<string>,
    cdState: string | null,
    cdDistrict: string | null,
  ): boolean {
    const isCd = tags.includes(CD_TAG);
    const isStateLevel = tags.includes(STATE_TAG);
    const isGeo = isCd || isStateLevel;
    if (!selectedTags.has(CD_TAG)) {
      // Chip not active → all geo sources hidden, everything else shown.
      return !isGeo;
    }
    // Chip active → only geo sources eligible, gated by state + district.
    if (!isGeo) return false;
    if (!cdState) return false; // gate: pick a state first
    // District = STATEWIDE: only state-level sources for that state.
    if (cdDistrict === STATEWIDE_DISTRICT_CODE) {
      if (!isStateLevel) return false;
      const parsed = parseStateSourceId(id);
      return parsed?.state === cdState;
    }
    // District = specific CD: only that CD's sources, state-level filtered out.
    if (cdDistrict) {
      if (!isCd) return false;
      const parsed = parseCdSourceId(id);
      return parsed?.state === cdState && parsed?.district === cdDistrict;
    }
    // District unset = "All": both state-level + CDs of that state.
    if (isStateLevel) return parseStateSourceId(id)?.state === cdState;
    if (isCd) return parseCdSourceId(id)?.state === cdState;
    return false;
  }
  // Index of the currently-focused section. Library clicks append here.
  let activeSectionIdx: number = 0;

  function setActiveSection(idx: number): void {
    if (idx < 0 || idx >= state.sections.length) return;
    if (activeSectionIdx === idx) return;
    activeSectionIdx = idx;
    renderComposition();
  }

  function clampActiveSection(): void {
    if (activeSectionIdx >= state.sections.length) {
      activeSectionIdx = Math.max(0, state.sections.length - 1);
    }
  }

  function allChartTags(): string[] {
    if (!library) return [];
    const s = new Set<string>();
    for (const c of library.charts) for (const t of c.tags) s.add(t);
    return [...s].sort();
  }

  function allSourceTags(): string[] {
    if (!library) return [];
    const s = new Set<string>();
    for (const id of Object.keys(library.sources)) {
      const src = library.sources[id] as LibrarySource & { tags?: string[] };
      for (const t of src.tags ?? []) {
        // Hide synthetic metro tags from the tag-pill strip — they're
        // surfaced through the dedicated Metro chip + dropdown instead.
        // Filters both the bare `metro` tag and per-CBSA `metro:35620`
        // entries; users still see them via the geo chip's UI.
        if (t === METRO_TAG || t.startsWith(`${METRO_TAG}:`)) continue;
        // Same idea for country/region synthetic tags — surfaced via
        // the "Countries & regions" chip, not the topical pill strip.
        if (t === COUNTRY_TAG || t.startsWith(`${COUNTRY_TAG}:`)) continue;
        s.add(t);
      }
    }
    return [...s].sort();
  }

  function filteredCharts(): LibraryChart[] {
    if (!library) return [];
    const q = chartsSearchQuery.trim().toLowerCase();
    const tagsRequired = [...chartsSelectedTags];
    return library.charts.filter((c) => {
      // Multi-tag: every selected tag must be present (AND).
      for (const t of tagsRequired) {
        if (!c.tags.includes(t)) return false;
      }
      if (q) {
        // Server pre-built searchText (lowercased) when available; otherwise
        // synthesize from id/title/tags.
        const hay =
          (c as LibraryChart & { searchText?: string }).searchText ??
          (c.title + " " + c.id + " " + c.tags.join(" ")).toLowerCase();
        if (!hay.includes(q)) return false;
      }
      return true;
    });
  }

  // Parallel to filteredCharts but over the source universe. Sources
  // have tags + searchText set on the server by library.json.ts; we
  // mirror the AND-across-tags / case-insensitive search semantics.
  function filteredSources(): (LibrarySource & {
    id: string;
    tags: string[];
    searchText: string;
  })[] {
    if (!library) return [];
    const q = sourcesSearchQuery.trim().toLowerCase();
    // CD_TAG in the selected set is the master "States & districts" chip
    // toggle, not a literal tag a source must carry — passesCdFilter
    // already enforces the geo gate. State-level sources have STATE_TAG
    // (not CD_TAG), so leaving CD_TAG in the AND list rejects them.
    const tagsRequired = [...sourcesSelectedTags].filter((t) => t !== CD_TAG);
    // Metro filter is AND'd with the other tag selections — picking
    // "NYC" + tag "labor" returns only labor sources in NYC.
    const metroTagRequired = libGeo.selectedMetroCbsa
      ? `${METRO_TAG}:${libGeo.selectedMetroCbsa}`
      : null;
    // Country filter — same pattern as metro. When a country is
    // selected we narrow to that country's tag; otherwise we hide
    // every country-tagged source so the default list stays US-
    // focused. (USA + the World aggregate were intentionally NOT
    // tagged country-specific upstream, so they remain visible.)
    const countryTagRequired = libGeo.selectedCountryCode
      ? `${COUNTRY_TAG}:${libGeo.selectedCountryCode}`
      : null;
    const out: (LibrarySource & {
      id: string;
      tags: string[];
      searchText: string;
    })[] = [];
    for (const id of Object.keys(library.sources)) {
      const src = library.sources[id] as LibrarySource & {
        id?: string;
        tags?: string[];
        searchText?: string;
      };
      const tags = src.tags ?? [];
      // CD-visibility gate runs before tag-AND so that a user with the CD
      // chip off never sees any CD source, regardless of what other tag
      // chips they've selected.
      if (
        !passesCdFilter(
          id,
          tags,
          sourcesSelectedTags,
          sourcesCdState,
          sourcesCdDistrict,
        )
      ) {
        continue;
      }
      let ok = true;
      for (const t of tagsRequired) {
        if (!tags.includes(t)) {
          ok = false;
          break;
        }
      }
      if (!ok) continue;
      if (metroTagRequired && !tags.includes(metroTagRequired)) continue;
      if (countryTagRequired) {
        // Active country selection: source must carry that country's tag.
        if (!tags.includes(countryTagRequired)) continue;
      } else if (tags.includes(COUNTRY_TAG)) {
        // No country selected: hide every country-tagged source so the
        // default list doesn't drown in foreign series. The chip is
        // how users opt back in.
        continue;
      }
      if (q) {
        const hay =
          src.searchText ??
          (src.name + " " + (src.shortName ?? "") + " " + id + " " + tags.join(" "))
            .toLowerCase();
        if (!hay.includes(q)) continue;
      }
      out.push({
        ...src,
        id,
        tags,
        searchText: src.searchText ?? "",
      });
    }
    // Source-picker ordering: by name. The categoryLabel-style folder
    // grouping used for charts doesn't help much for sources whose IDs
    // are mostly pipeline/<ticker> — a flat alphabetical list reads
    // cleaner.
    out.sort((a, b) => a.name.localeCompare(b.name));
    return out;
  }

  // Pretty label for the chart-folder prefix used as a category grouping.
  function categoryLabel(prefix: string): string {
    const map: Record<string, string> = {
      "us-macro": "US macro",
      "real-estate": "Real estate",
      tech: "Tech",
      stocks: "Stocks",
      countries: "Countries",
      commodities: "Commodities",
      markets: "Markets",
      oil: "Oil & energy",
      crypto: "Crypto",
      fx: "FX",
      government: "Government finances",
    };
    return map[prefix] ?? prefix;
  }

  function renderTagFiltersCharts(): void {
    const host = shell.querySelector<HTMLElement>(
      "[data-role='tag-filters-charts']",
    );
    if (!host || !library) return;
    const tags = allChartTags();
    host.innerHTML = "";
    const makeBtn = (tag: string, label: string, active: boolean) => {
      const b = document.createElement("button");
      b.type = "button";
      b.className = "tag-pill" + (active ? " tag-pill-active" : "");
      b.textContent = label;
      b.addEventListener("click", () => {
        if (tag === "") {
          chartsSelectedTags.clear();
        } else if (chartsSelectedTags.has(tag)) {
          chartsSelectedTags.delete(tag);
        } else {
          chartsSelectedTags.add(tag);
        }
        renderTagFiltersCharts();
        renderChartsList();
      });
      return b;
    };
    host.appendChild(
      makeBtn("", `all (${library.charts.length})`, chartsSelectedTags.size === 0),
    );
    for (const t of tags) {
      const count = library.charts.filter((c) => c.tags.includes(t)).length;
      host.appendChild(makeBtn(t, `${t} (${count})`, chartsSelectedTags.has(t)));
    }
  }

  // ---- Geo-chip system (Metro + Countries & regions) ----
  //
  // Three picker surfaces share the same chip behavior so the user has
  // identical UX for finding sources:
  //   • "lib"  — the Sources tab on the compose page (data-role
  //               prefix: lib-metro-* / lib-country-*).
  //   • "cc"   — the New custom chart (edit chart) modal (cc-metro-*,
  //               cc-country-*).
  //   • "ds"   — the New derived source modal (ds-metro-*,
  //               ds-country-*; two source lists rerender on change).
  //
  // Per-surface state lives in libGeo / ccModal.geo / dsModal.geo
  // (same GeoState shape). The render/open/close/select/clear
  // functions take a surface key, look up the state + the DOM
  // selectors + the right "redraw source list" callback, and act on
  // them. Adding a fourth surface later means adding an entry to
  // GEO_SURFACES, not duplicating ~200 lines.
  type GeoSurface = "lib" | "cc" | "ds";
  interface GeoSurfaceConfig {
    prefix: string; // role-attribute prefix, e.g. "lib", "cc", "ds"
    state: () => GeoState;
    onChange: () => void;
    track: (event: string, props: Record<string, unknown>) => void;
    // CD chip lives in the geo strip alongside metro + country. The
    // selectedTags set tracks whether CD_TAG is the "active" chip;
    // cdState + cdDistrict are the picked state + district codes.
    // refreshTags re-renders the topical tag pills row so the
    // "(N)" counts reflect the new CD-vs-not gate.
    cdSelectedTags: () => Set<string>;
    getCdState: () => string | null;
    setCdState: (v: string | null) => void;
    getCdDistrict: () => string | null;
    setCdDistrict: (v: string | null) => void;
    refreshTags: () => void;
  }
  function geoSurfaceConfig(surface: GeoSurface): GeoSurfaceConfig {
    if (surface === "lib") {
      return {
        prefix: "lib",
        state: () => libGeo,
        onChange: () => renderSourcesList(),
        track: (e, p) => track(e, { ...p, surface: "compose-sources" }),
        cdSelectedTags: () => sourcesSelectedTags,
        getCdState: () => sourcesCdState,
        setCdState: (v) => { sourcesCdState = v; },
        getCdDistrict: () => sourcesCdDistrict,
        setCdDistrict: (v) => { sourcesCdDistrict = v; },
        refreshTags: () => renderTagFiltersSources(),
      };
    }
    if (surface === "cc") {
      return {
        prefix: "cc",
        state: () => ccModal.geo,
        onChange: () => renderCustomChartSources(),
        track: (e, p) => track(e, { ...p, surface: "cc-modal" }),
        cdSelectedTags: () => ccModal.pickerTags,
        getCdState: () => ccModal.cdState,
        setCdState: (v) => { ccModal.cdState = v; },
        getCdDistrict: () => ccModal.cdDistrict,
        setCdDistrict: (v) => { ccModal.cdDistrict = v; },
        refreshTags: () => renderCcModalTagChips(),
      };
    }
    return {
      prefix: "ds",
      state: () => dsModal.geo,
      // ds-modal has TWO source lists (A operand + B operand) — both
      // need to re-render on filter change.
      onChange: () => {
        renderDsPicker("a");
        renderDsPicker("b");
      },
      track: (e, p) => track(e, { ...p, surface: "ds-modal" }),
      cdSelectedTags: () => dsModal.pickerTags,
      getCdState: () => dsModal.cdState,
      setCdState: (v) => { dsModal.cdState = v; },
      getCdDistrict: () => dsModal.cdDistrict,
      setCdDistrict: (v) => { dsModal.cdDistrict = v; },
      refreshTags: () => renderDsModalTagChips(),
    };
  }
  function geoQS<T extends HTMLElement>(prefix: string, suffix: string): T | null {
    return shell.querySelector<T>(`[data-role='${prefix}-${suffix}']`);
  }

  function renderMetroChip(surface: GeoSurface = "lib"): void {
    const cfg = geoSurfaceConfig(surface);
    const wrap = geoQS<HTMLElement>(cfg.prefix, "geo-chips");
    const chip = geoQS<HTMLButtonElement>(cfg.prefix, "metro-chip");
    const label = geoQS<HTMLElement>(cfg.prefix, "metro-label");
    const clear = geoQS<HTMLElement>(cfg.prefix, "metro-clear");
    if (!wrap || !chip || !label || !clear) return;
    const metros = library?.metros ?? {};
    const hasMetros = Object.keys(metros).length > 0;
    const hasCountries = Object.keys(library?.countries ?? {}).length > 0;
    wrap.hidden = !hasMetros && !hasCountries;
    chip.hidden = !hasMetros;
    if (!hasMetros) return;
    const state = cfg.state();
    if (state.selectedMetroCbsa) {
      const entry = metros[state.selectedMetroCbsa];
      const short = entry?.shortName ?? state.selectedMetroCbsa;
      label.textContent = short;
      chip.classList.add("lib-geo-chip-active");
      clear.hidden = false;
    } else {
      label.textContent = "US metro areas ▾";
      chip.classList.remove("lib-geo-chip-active");
      clear.hidden = true;
    }
    chip.setAttribute("aria-expanded", state.metroPopoverOpen ? "true" : "false");
  }

  function renderMetroList(surface: GeoSurface = "lib"): void {
    const cfg = geoSurfaceConfig(surface);
    const list = geoQS<HTMLElement>(cfg.prefix, "metro-list");
    if (!list) return;
    const metros = library?.metros ?? {};
    const codes = Object.keys(metros);
    const state = cfg.state();
    const q = state.metroSearchQuery.trim().toLowerCase();
    list.innerHTML = "";
    let shown = 0;
    for (const code of codes) {
      const entry = metros[code];
      const hay = (entry.shortName + " " + entry.name + " " + code).toLowerCase();
      if (q && !hay.includes(q)) continue;
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "lib-geo-list-item" +
        (state.selectedMetroCbsa === code ? " lib-geo-list-item-active" : "");
      btn.setAttribute("role", "option");
      btn.setAttribute("aria-selected", state.selectedMetroCbsa === code ? "true" : "false");
      btn.innerHTML =
        `<span class="lib-geo-list-item-name">${escapeHtml(entry.shortName)}</span>` +
        `<span class="lib-geo-list-item-code muted small">${escapeHtml(code)}</span>`;
      btn.addEventListener("click", () => selectMetro(code, surface));
      list.appendChild(btn);
      shown += 1;
    }
    if (shown === 0) {
      const empty = document.createElement("p");
      empty.className = "muted small";
      empty.textContent = q ? "No metros match." : "No metros loaded.";
      list.appendChild(empty);
    }
  }

  function openMetroPopover(surface: GeoSurface = "lib"): void {
    const cfg = geoSurfaceConfig(surface);
    const pop = geoQS<HTMLElement>(cfg.prefix, "metro-popover");
    if (!pop) return;
    cfg.state().metroPopoverOpen = true;
    pop.hidden = false;
    renderMetroList(surface);
    renderMetroChip(surface);
    queueMicrotask(() => {
      const search = geoQS<HTMLInputElement>(cfg.prefix, "metro-search");
      search?.focus();
    });
  }

  function closeMetroPopover(surface: GeoSurface = "lib"): void {
    const cfg = geoSurfaceConfig(surface);
    const pop = geoQS<HTMLElement>(cfg.prefix, "metro-popover");
    if (!pop) return;
    cfg.state().metroPopoverOpen = false;
    pop.hidden = true;
    renderMetroChip(surface);
  }

  function selectMetro(cbsa: string, surface: GeoSurface = "lib"): void {
    const cfg = geoSurfaceConfig(surface);
    cfg.state().selectedMetroCbsa = cbsa;
    closeMetroPopover(surface);
    renderMetroChip(surface);
    cfg.onChange();
    cfg.track("compose_metro_filter_set", { cbsa });
  }

  function clearMetroFilter(surface: GeoSurface = "lib"): void {
    const cfg = geoSurfaceConfig(surface);
    const state = cfg.state();
    if (!state.selectedMetroCbsa) return;
    state.selectedMetroCbsa = null;
    renderMetroChip(surface);
    cfg.onChange();
    cfg.track("compose_metro_filter_cleared", {});
  }

  function renderCountryChip(surface: GeoSurface = "lib"): void {
    const cfg = geoSurfaceConfig(surface);
    const wrap = geoQS<HTMLElement>(cfg.prefix, "geo-chips");
    const chip = geoQS<HTMLButtonElement>(cfg.prefix, "country-chip");
    const label = geoQS<HTMLElement>(cfg.prefix, "country-label");
    const clear = geoQS<HTMLElement>(cfg.prefix, "country-clear");
    if (!wrap || !chip || !label || !clear) return;
    const countries = library?.countries ?? {};
    const hasCountries = Object.keys(countries).length > 0;
    const hasMetros = Object.keys(library?.metros ?? {}).length > 0;
    wrap.hidden = !hasMetros && !hasCountries;
    chip.hidden = !hasCountries;
    if (!hasCountries) return;
    const state = cfg.state();
    if (state.selectedCountryCode) {
      const entry = countries[state.selectedCountryCode];
      const name = entry?.name ?? state.selectedCountryCode;
      label.textContent = name;
      chip.classList.add("lib-geo-chip-active");
      clear.hidden = false;
    } else {
      label.textContent = "Regions and countries ▾";
      chip.classList.remove("lib-geo-chip-active");
      clear.hidden = true;
    }
    chip.setAttribute("aria-expanded", state.countryPopoverOpen ? "true" : "false");
  }

  function renderCountryList(surface: GeoSurface = "lib"): void {
    const cfg = geoSurfaceConfig(surface);
    const list = geoQS<HTMLElement>(cfg.prefix, "country-list");
    if (!list) return;
    const countries = library?.countries ?? {};
    const codes = Object.keys(countries);
    const state = cfg.state();
    const q = state.countrySearchQuery.trim().toLowerCase();
    list.innerHTML = "";
    // Two-section layout: regional aggregates (Sub-Saharan Africa, EU,
    // …) first because users coming to this chip are usually looking at
    // the big picture; then individual countries A–Z. Section headers
    // labeled so the visual hierarchy is obvious. Empty sections are
    // hidden so we don't show a "Regions" heading with nothing under it.
    const regions = codes.filter((c) => isRegionCode(c));
    const singles = codes.filter((c) => !isRegionCode(c));
    const renderItem = (code: string) => {
      const entry = countries[code];
      const hay = (entry.name + " " + code).toLowerCase();
      if (q && !hay.includes(q)) return null;
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "lib-geo-list-item" +
        (state.selectedCountryCode === code ? " lib-geo-list-item-active" : "");
      btn.setAttribute("role", "option");
      btn.setAttribute("aria-selected", state.selectedCountryCode === code ? "true" : "false");
      btn.innerHTML =
        `<span class="lib-geo-list-item-name">${escapeHtml(entry.name)}</span>` +
        `<span class="lib-geo-list-item-code muted small">${escapeHtml(code)}</span>`;
      btn.addEventListener("click", () => selectCountry(code, surface));
      return btn;
    };
    const renderSection = (header: string, codeList: string[]) => {
      const items = codeList.map(renderItem).filter((b): b is HTMLButtonElement => !!b);
      if (items.length === 0) return 0;
      const h = document.createElement("p");
      h.className = "lib-geo-list-header";
      h.textContent = header;
      list.appendChild(h);
      for (const b of items) list.appendChild(b);
      return items.length;
    };
    const shown = renderSection("Regions", regions) + renderSection("Countries", singles);
    if (shown === 0) {
      const empty = document.createElement("p");
      empty.className = "muted small";
      empty.textContent = q ? "No countries or regions match." : "No countries loaded.";
      list.appendChild(empty);
    }
  }

  function openCountryPopover(surface: GeoSurface = "lib"): void {
    const cfg = geoSurfaceConfig(surface);
    const pop = geoQS<HTMLElement>(cfg.prefix, "country-popover");
    if (!pop) return;
    cfg.state().countryPopoverOpen = true;
    pop.hidden = false;
    renderCountryList(surface);
    renderCountryChip(surface);
    queueMicrotask(() => {
      const search = geoQS<HTMLInputElement>(cfg.prefix, "country-search");
      search?.focus();
    });
  }

  function closeCountryPopover(surface: GeoSurface = "lib"): void {
    const cfg = geoSurfaceConfig(surface);
    const pop = geoQS<HTMLElement>(cfg.prefix, "country-popover");
    if (!pop) return;
    cfg.state().countryPopoverOpen = false;
    pop.hidden = true;
    renderCountryChip(surface);
  }

  function selectCountry(code: string, surface: GeoSurface = "lib"): void {
    const cfg = geoSurfaceConfig(surface);
    cfg.state().selectedCountryCode = code;
    closeCountryPopover(surface);
    renderCountryChip(surface);
    cfg.onChange();
    cfg.track("compose_country_filter_set", { code });
  }

  function clearCountryFilter(surface: GeoSurface = "lib"): void {
    const cfg = geoSurfaceConfig(surface);
    const state = cfg.state();
    if (!state.selectedCountryCode) return;
    state.selectedCountryCode = null;
    renderCountryChip(surface);
    cfg.onChange();
    cfg.track("compose_country_filter_cleared", {});
  }

  // States & districts chip rendering. Sits in the geo strip alongside
  // the metro + country chips. Implemented as a clear-and-rebuild via
  // the existing appendCdDrillDown helper so the chip + state dropdown
  // + district dropdown all live as siblings inside the host element.
  // The onToggle callback re-renders the chip itself (to reflect the
  // new pickerTags state), the topical-tag row (counts reflect the new
  // CD-vs-not gate), and the source list (gate now affects which
  // sources show).
  function renderCdChip(surface: GeoSurface = "lib"): void {
    const cfg = geoSurfaceConfig(surface);
    const host = geoQS<HTMLElement>(cfg.prefix, "cd-chip-host");
    if (!host) return;
    host.innerHTML = "";
    appendCdDrillDown(
      host,
      cfg.cdSelectedTags(),
      cfg.getCdState,
      cfg.setCdState,
      cfg.getCdDistrict,
      cfg.setCdDistrict,
      () => {
        renderCdChip(surface);
        cfg.refreshTags();
        cfg.onChange();
      },
    );
  }

  // Shared wiring helper. Hooks click + clear + popover-search + outside-
  // click + ESC for one surface. Reused by hydrate() for the Sources tab
  // and by openCustomChartModal / openDerivedSourceModal for the modals.
  function wireGeoChips(surface: GeoSurface): void {
    const cfg = geoSurfaceConfig(surface);
    const wrap = geoQS<HTMLElement>(cfg.prefix, "geo-chips");
    const metroChip = geoQS<HTMLButtonElement>(cfg.prefix, "metro-chip");
    const metroClear = geoQS<HTMLElement>(cfg.prefix, "metro-clear");
    const metroSearch = geoQS<HTMLInputElement>(cfg.prefix, "metro-search");
    const countryChip = geoQS<HTMLButtonElement>(cfg.prefix, "country-chip");
    const countryClear = geoQS<HTMLElement>(cfg.prefix, "country-clear");
    const countrySearch = geoQS<HTMLInputElement>(cfg.prefix, "country-search");
    if (metroChip && !metroChip.dataset.wired) {
      metroChip.dataset.wired = "1";
      metroChip.addEventListener("click", (e) => {
        const target = e.target as HTMLElement | null;
        if (target && target.closest(`[data-role='${cfg.prefix}-metro-clear']`)) {
          e.stopPropagation();
          clearMetroFilter(surface);
          return;
        }
        const s = cfg.state();
        if (s.countryPopoverOpen) closeCountryPopover(surface);
        if (s.metroPopoverOpen) closeMetroPopover(surface);
        else openMetroPopover(surface);
      });
    }
    if (metroClear && !metroClear.dataset.wired) {
      metroClear.dataset.wired = "1";
      metroClear.addEventListener("click", (e) => {
        e.stopPropagation();
        clearMetroFilter(surface);
      });
    }
    if (metroSearch && !metroSearch.dataset.wired) {
      metroSearch.dataset.wired = "1";
      metroSearch.addEventListener("input", () => {
        cfg.state().metroSearchQuery = metroSearch.value;
        renderMetroList(surface);
      });
    }
    if (countryChip && !countryChip.dataset.wired) {
      countryChip.dataset.wired = "1";
      countryChip.addEventListener("click", (e) => {
        const target = e.target as HTMLElement | null;
        if (target && target.closest(`[data-role='${cfg.prefix}-country-clear']`)) {
          e.stopPropagation();
          clearCountryFilter(surface);
          return;
        }
        const s = cfg.state();
        if (s.metroPopoverOpen) closeMetroPopover(surface);
        if (s.countryPopoverOpen) closeCountryPopover(surface);
        else openCountryPopover(surface);
      });
    }
    if (countryClear && !countryClear.dataset.wired) {
      countryClear.dataset.wired = "1";
      countryClear.addEventListener("click", (e) => {
        e.stopPropagation();
        clearCountryFilter(surface);
      });
    }
    if (countrySearch && !countrySearch.dataset.wired) {
      countrySearch.dataset.wired = "1";
      countrySearch.addEventListener("input", () => {
        cfg.state().countrySearchQuery = countrySearch.value;
        renderCountryList(surface);
      });
    }
    if (wrap && !wrap.dataset.wired) {
      wrap.dataset.wired = "1";
      // Click-outside dismisses both popovers — but only for THIS
      // surface's wrap. Document-level listeners with surface-scoped
      // logic close on any outside click.
      document.addEventListener("click", (e) => {
        const s = cfg.state();
        if (!s.metroPopoverOpen && !s.countryPopoverOpen) return;
        const target = e.target as HTMLElement | null;
        if (!target) return;
        if (target.closest(`[data-role='${cfg.prefix}-geo-chips']`)) return;
        if (s.metroPopoverOpen) closeMetroPopover(surface);
        if (s.countryPopoverOpen) closeCountryPopover(surface);
      });
      document.addEventListener("keydown", (e) => {
        if (e.key !== "Escape") return;
        const s = cfg.state();
        if (s.metroPopoverOpen) closeMetroPopover(surface);
        if (s.countryPopoverOpen) closeCountryPopover(surface);
      });
    }
  }

  // Parallel tag-filter strip for the Sources tab. Same UX pattern;
  // counts run against the source universe instead of charts. The
  // `congressional-district` tag is rendered specially as a drill-down
  // chip (state → district) at the end of the strip; see
  // appendCdDrillDown below.
  function renderTagFiltersSources(): void {
    const host = shell.querySelector<HTMLElement>(
      "[data-role='tag-filters-sources']",
    );
    if (!host || !library) return;
    const tags = allSourceTags();
    host.innerHTML = "";
    // "all" count = non-geo sources, since CDs + state-level series are
    // hidden by default and surfacing a "all (~2300)" count that's mostly
    // invisible geo sources is confusing.
    let nonGeoCount = 0;
    for (const id of Object.keys(library.sources)) {
      const src = library.sources[id] as LibrarySource & { tags?: string[] };
      const tags = src.tags ?? [];
      if (
        !tags.includes(CD_TAG) &&
        !tags.includes(STATE_TAG) &&
        !tags.includes(COUNTRY_TAG)
      ) {
        nonGeoCount += 1;
      }
    }
    const makeBtn = (tag: string, label: string, active: boolean) => {
      const b = document.createElement("button");
      b.type = "button";
      b.className = "tag-pill" + (active ? " tag-pill-active" : "");
      b.textContent = label;
      b.addEventListener("click", () => {
        if (tag === "") {
          sourcesSelectedTags.clear();
          sourcesCdState = null;
          sourcesCdDistrict = null;
        } else if (sourcesSelectedTags.has(tag)) {
          sourcesSelectedTags.delete(tag);
        } else {
          sourcesSelectedTags.add(tag);
        }
        renderTagFiltersSources();
        renderSourcesList();
      });
      return b;
    };
    host.appendChild(
      makeBtn("", `all (${nonGeoCount})`, sourcesSelectedTags.size === 0),
    );
    // The CD / metro / country chips live in the geo strip ABOVE this
    // row (renderCdChip, renderMetroChip, renderCountryChip). Topical
    // tags only here.
    for (const t of tags) {
      if (t === CD_TAG || t === STATE_TAG) continue; // surfaced via CD chip
      if (t === COUNTRY_TAG || t.startsWith(`${COUNTRY_TAG}:`)) continue; // country chip
      // Count visible (non-geo) sources for each tag so the chip count
      // matches what the user will actually see when they click it.
      let count = 0;
      for (const id of Object.keys(library.sources)) {
        const src = library.sources[id] as LibrarySource & { tags?: string[] };
        const sTags = src.tags ?? [];
        if (
          sTags.includes(CD_TAG) ||
          sTags.includes(STATE_TAG) ||
          sTags.includes(COUNTRY_TAG)
        ) {
          continue;
        }
        if (sTags.includes(t)) count += 1;
      }
      // Skip count-0 pills — the build gate in library.json.ts should
      // have caught this server-side, but defending against drift at
      // runtime is cheap and avoids ever shipping a useless pill.
      if (count === 0) continue;
      host.appendChild(makeBtn(t, `${t} (${count})`, sourcesSelectedTags.has(t)));
    }
  }

  // Shared CD drill-down renderer used by all three picker surfaces. Adds
  // the "Congressional district" toggle chip; when active, appends a
  // State dropdown and (once state is picked) a District dropdown. The
  // getter / setter pairs keep this function neutral with respect to
  // which surface owns the state — each caller threads its own (state,
  // district, rerender) trio in.
  function appendCdDrillDown(
    host: HTMLElement,
    selectedTags: Set<string>,
    getState: () => string | null,
    setState: (v: string | null) => void,
    getDistrict: () => string | null,
    setDistrict: (v: string | null) => void,
    rerender: () => void,
  ): void {
    if (!library) return;
    // Total geo source count (CD + state-level series, across all states
    // + districts) shown on the chip so the user has a sense of what
    // they're toggling on.
    let geoCount = 0;
    for (const id of Object.keys(library.sources)) {
      const src = library.sources[id] as LibrarySource & { tags?: string[] };
      const tags = src.tags ?? [];
      if (tags.includes(CD_TAG) || tags.includes(STATE_TAG)) geoCount += 1;
    }
    const active = selectedTags.has(CD_TAG);
    const chip = document.createElement("button");
    chip.type = "button";
    chip.className = "tag-pill cd-tag-pill" + (active ? " tag-pill-active" : "");
    chip.textContent = `States & districts (${geoCount})`;
    chip.addEventListener("click", () => {
      if (selectedTags.has(CD_TAG)) {
        selectedTags.delete(CD_TAG);
        setState(null);
        setDistrict(null);
      } else {
        selectedTags.add(CD_TAG);
      }
      rerender();
    });
    host.appendChild(chip);
    if (!active) return;

    // State dropdown. Only states with at least one CD source appear,
    // ordered by display name so it reads alphabetically.
    const stateSel = document.createElement("select");
    stateSel.className = "cd-drilldown-select";
    stateSel.setAttribute("aria-label", "Congressional district — state");
    const promptOpt = document.createElement("option");
    promptOpt.value = "";
    promptOpt.textContent = "Pick a state…";
    stateSel.appendChild(promptOpt);
    const currentState = getState();
    for (const code of cdStatesAvailable()) {
      const o = document.createElement("option");
      o.value = code;
      o.textContent = stateNameFor(code);
      if (code === currentState) o.selected = true;
      stateSel.appendChild(o);
    }
    stateSel.addEventListener("change", () => {
      setState(stateSel.value || null);
      // Clearing the district whenever state changes avoids the awkward
      // "state=TX district=07 set; user picks CA → district stays as 07"
      // edge case where the old district might not exist in the new state.
      setDistrict(null);
      rerender();
    });
    host.appendChild(stateSel);

    // District dropdown only appears once a state is picked. "All districts"
    // is the no-narrowing option so a user can browse all of a state's CDs
    // before zeroing in on one.
    if (!currentState) return;
    const distSel = document.createElement("select");
    distSel.className = "cd-drilldown-select";
    distSel.setAttribute("aria-label", "Congressional district — district");
    const allOpt = document.createElement("option");
    allOpt.value = "";
    allOpt.textContent = "All districts";
    distSel.appendChild(allOpt);
    const currentDistrict = getDistrict();
    for (const dCode of cdsByState(currentState)) {
      const o = document.createElement("option");
      o.value = dCode;
      o.textContent = formatDistrictLabel(currentState, dCode);
      if (dCode === currentDistrict) o.selected = true;
      distSel.appendChild(o);
    }
    distSel.addEventListener("change", () => {
      setDistrict(distSel.value || null);
      rerender();
    });
    host.appendChild(distSel);
  }

  function renderChartsList(): void {
    const host = shell.querySelector<HTMLElement>(
      "[data-role='lib-results-charts']",
    );
    if (!host) return;
    const charts = filteredCharts();
    host.innerHTML = "";
    if (charts.length === 0) {
      host.innerHTML =
        '<p class="muted small">No charts match. Feel free to request one at <a href="mailto:keller.scholl@gmail.com">keller.scholl@gmail.com</a>.</p>';
      return;
    }
    // Group by chart-folder prefix (e.g. "us-macro/foo" → "us-macro"). Keeps
    // the result list scannable when many results are returned.
    const groups = new Map<string, LibraryChart[]>();
    for (const c of charts) {
      const prefix = c.id.includes("/") ? c.id.split("/")[0] : "other";
      if (!groups.has(prefix)) groups.set(prefix, []);
      groups.get(prefix)!.push(c);
    }
    const orderedPrefixes = [...groups.keys()].sort((a, b) =>
      categoryLabel(a).localeCompare(categoryLabel(b)),
    );
    for (const prefix of orderedPrefixes) {
      const group = groups.get(prefix)!;
      const heading = document.createElement("div");
      heading.className = "lib-group-heading";
      heading.textContent = `${categoryLabel(prefix)} (${group.length})`;
      host.appendChild(heading);
      for (const c of group) {
      const card = document.createElement("button");
      card.type = "button";
      card.className = "chart-card";
      card.dataset.chartId = c.id;
      card.innerHTML =
        `<div class="chart-card-title">${escapeHtml(c.title)}</div>` +
        `<div class="chart-card-meta">${c.tags.map(escapeHtml).join(" \u00b7 ")}</div>`;
      card.addEventListener("click", () => {
        void addChart(c.id);
      });
      host.appendChild(card);
      }
    }
  }

  // Parallel renderer for the Sources tab. Each card shows the source
  // name, short-name/ticker if distinct, the tag list, and a one-line
  // description. Clicking adds the source as a single-series inline
  // chart to the active section \u2014 the dominant case is "track this".
  function renderSourcesList(): void {
    const host = shell.querySelector<HTMLElement>(
      "[data-role='lib-results-sources']",
    );
    if (!host) return;
    const sources = filteredSources();
    host.innerHTML = "";
    if (sources.length === 0) {
      // Tailored empty-state copy for the CD drill-down: an unfiltered
      // empty list almost certainly means the user activated the CD
      // chip and hasn't picked a state yet, not that we have no data.
      if (sourcesSelectedTags.has(CD_TAG) && !sourcesCdState) {
        host.innerHTML =
          '<p class="muted small">Pick a state above to see its statewide and congressional-district series.</p>';
      } else {
        host.innerHTML =
          '<p class="muted small">No sources match. Feel free to request one at <a href="mailto:keller.scholl@gmail.com">keller.scholl@gmail.com</a>.</p>';
      }
      return;
    }
    for (const s of sources) {
      const card = document.createElement("button");
      card.type = "button";
      card.className = "source-card";
      card.dataset.sourceId = s.id;
      // Geo sources get a state/district badge regardless of the source's
      // own shortName \u2014 when the user is browsing a state's series, the
      // district code is what they're scanning for. CDs read as "TX-12";
      // state-level series read as "TX statewide" so the two scopes are
      // visually distinct in the same list.
      const cdParsed = parseCdSourceId(s.id);
      const statePar = parseStateSourceId(s.id);
      let geoBadge = "";
      if (cdParsed) {
        geoBadge =
          `<span class="source-card-short source-card-cd-badge">${escapeHtml(formatCdShortLabel(cdParsed.state, cdParsed.district))}</span>`;
      } else if (statePar) {
        geoBadge =
          `<span class="source-card-short source-card-cd-badge">${escapeHtml(`${statePar.state.toUpperCase()} statewide`)}</span>`;
      }
      const shortBadge =
        !cdParsed && !statePar && s.shortName && s.shortName !== s.name
          ? `<span class="source-card-short">${escapeHtml(s.shortName)}</span>`
          : "";
      const tagsLine =
        s.tags.length > 0
          ? `<div class="source-card-tags">${s.tags.map(escapeHtml).join(" \u00b7 ")}</div>`
          : "";
      const desc = s.description
        ? `<div class="source-card-desc">${escapeHtml(s.description)}</div>`
        : "";
      card.innerHTML =
        `<div class="source-card-title">${escapeHtml(s.name)}${geoBadge}${shortBadge}</div>` +
        desc +
        tagsLine;
      card.addEventListener("click", () => {
        void addSourceAsChart(s.id);
      });
      host.appendChild(card);
    }
  }

  // Switch which library tab is showing. Tab buttons toggle aria-selected
  // + an active class; the two panels are direct siblings with `hidden`
  // attributes that swap. Re-renders the active tab in case its data
  // has changed since last view (e.g., a derived source was just added,
  // which the Sources tab should now show in its list).
  function setActiveLibTab(tab: LibTab): void {
    activeLibTab = tab;
    shell.querySelectorAll<HTMLButtonElement>("[data-role='lib-tab']").forEach((btn) => {
      const active = btn.dataset.tab === tab;
      btn.classList.toggle("lib-tab-active", active);
      btn.setAttribute("aria-selected", active ? "true" : "false");
    });
    const panelSources = shell.querySelector<HTMLElement>(
      "[data-role='lib-panel-sources']",
    );
    const panelCharts = shell.querySelector<HTMLElement>(
      "[data-role='lib-panel-charts']",
    );
    if (panelSources) panelSources.hidden = tab !== "sources";
    if (panelCharts) panelCharts.hidden = tab !== "charts";
    if (tab === "sources") {
      renderTagFiltersSources();
      renderSourcesList();
    } else {
      renderTagFiltersCharts();
      renderChartsList();
    }
    track("compose_lib_tab_switched", { tab });
  }

  // Promote a library chart in-place to an inline chart so the user
  // can fully edit it (sources, scale, mode, log, blurb, etc.) via
  // the cc-modal. Copies every editable field from the library chart's
  // spec into a fresh state.inlineCharts entry, then swaps the section's
  // reference to point at the new inline ID. The library chart YAML is
  // untouched; the inline copy is the user's working version going
  // forward.
  //
  // Returns the new inline chart ID (or null if the library entry was
  // missing). Caller is responsible for re-rendering composition + URL
  // state.
  function promoteLibraryChartToInline(
    libraryChartId: string,
    secIdx: number,
    chartIdx: number,
  ): string | null {
    const lib = library?.charts.find((c) => c.id === libraryChartId);
    if (!lib) return null;
    const inlineId = INLINE_PREFIX + nanoid(8);
    const override = state.chartOverrides[libraryChartId];
    // Override fields (title, blurb) win over library defaults \u2014 the
    // user's prior tweaks shouldn't get reset by an edit.
    state.inlineCharts[inlineId] = {
      title: override?.title || lib.title,
      sources: [...(lib.sources ?? [])],
      normalize: lib.normalize as CustomChartMode | undefined,
      scale: (lib as { scale?: "linear" | "log" }).scale,
      rightAxisSources: (lib as { rightAxisSources?: string[] }).rightAxisSources,
      op: (lib as { op?: ChartCombineOp }).op,
      blurb: override?.blurb || lib.blurb,
      percentDisplay: (lib as { percentDisplay?: "percent" | "decimal" })
        .percentDisplay,
    };
    const sec = state.sections[secIdx];
    if (sec && sec.charts[chartIdx] === libraryChartId) {
      sec.charts[chartIdx] = inlineId;
    }
    // The promoted inline copy now carries the title / blurb itself,
    // so the per-chart override on the original library ID is dead
    // weight. Drop it.
    if (override) delete state.chartOverrides[libraryChartId];
    track("compose_chart_promoted_to_inline", {
      from: libraryChartId,
      to: inlineId,
    });
    return inlineId;
  }

  // Add a library source as a single-series inline chart to the active
  // section. This is the new dominant path for "I want to track X" \u2014
  // separate from addChart() (pregenerated multi-source compositions)
  // and from the derived-source modal (computed ratios / sums / diffs).
  async function addSourceAsChart(sourceId: string): Promise<void> {
    clampActiveSection();
    const target = state.sections[activeSectionIdx];
    if (!target) return;
    const allowed = await checkComposeAction("add_source_as_chart");
    if (!allowed) {
      showSigninPrompt("add_source_as_chart");
      return;
    }
    const sourceMeta = library?.sources[sourceId] as
      | (LibrarySource & { name?: string })
      | undefined;
    const chartId = INLINE_PREFIX + nanoid(8);
    state.inlineCharts[chartId] = {
      title: sourceMeta?.name ?? sourceId,
      sources: [sourceId],
      normalize: "raw",
    };
    target.charts.push(chartId);
    writeUrl();
    renderComposition();
    track("compose_source_added_as_chart", {
      sourceId,
      source: "library",
    });
  }

  // ---- Chart-spec helpers (shared by hover-merge + drag) ----
  // Resolve a chart's source-ID list, regardless of whether it's a library
  // or inline chart. Used to detect "single-source" charts for the hover-
  // merge interaction and to pre-fill the cc-modal on merge launch.
  function chartSourceIds(chartId: string): string[] {
    if (isInlineId(chartId)) {
      return state.inlineCharts[chartId]?.sources ?? [];
    }
    return library?.charts.find((c) => c.id === chartId)?.sources ?? [];
  }

  function isSingleSourceChart(chartId: string): boolean {
    return chartSourceIds(chartId).length === 1;
  }

  // Has the user customized this chart's title, or is it still the chart's
  // out-of-the-box default? Used by the hover-merge launcher to decide
  // whether to auto-rename the merged chart (default → recompose from
  // sources) or preserve a user-written title.
  //
  //   - Library chart: the YAML's title is the default. A non-empty
  //     chartOverrides[id].title is the user's customization.
  //   - Inline single-source chart: addSourceAsChart sets title to the
  //     source's `name`. If the inline title still matches that, treat
  //     it as the default. Also treat "" / "Unnamed chart" (the cc-modal's
  //     blank-input fallback) as default — the user clearly didn't pick
  //     a name on purpose.
  //   - Inline multi-source: too ambiguous to detect; treat as customized.
  function baseTitleIsDefault(chartId: string): boolean {
    if (isInlineId(chartId)) {
      const inline = state.inlineCharts[chartId];
      if (!inline) return true;
      const t = (inline.title ?? "").trim();
      if (!t || t === "Unnamed chart") return true;
      if (inline.sources.length === 1) {
        const src = library?.sources[inline.sources[0]] as
          | { name?: string }
          | undefined;
        if (src?.name && t === src.name) return true;
      }
      return false;
    }
    const override = state.chartOverrides[chartId];
    return !override?.title || !override.title.trim();
  }

  // Resolve a chart's effective display metadata (title / blurb / defaultDelta)
  // taking any per-chart override into account. Used by the hover-merge
  // launcher to preserve the BASE chart's metadata on the merged chart.
  function chartEffectiveSpec(chartId: string): {
    title: string;
    blurb?: string;
    defaultDelta?: DeltaWindow;
    sources: string[];
  } {
    if (isInlineId(chartId)) {
      const inline = state.inlineCharts[chartId];
      return {
        title: inline?.title ?? chartId,
        blurb: inline?.blurb,
        defaultDelta: inline?.defaultDelta as DeltaWindow | undefined,
        sources: inline?.sources ?? [],
      };
    }
    const chart = library?.charts.find((c) => c.id === chartId);
    const override = state.chartOverrides[chartId];
    return {
      title: override?.title || chart?.title || chartId,
      blurb: override?.blurb ?? chart?.blurb,
      defaultDelta: (override?.defaultDelta ?? chart?.defaultDelta) as DeltaWindow | undefined,
      sources: chart?.sources ?? [],
    };
  }

  // ---- Drag & drop helpers ----
  // Module-level handle on the currently-dragged tile during an in-flight
  // drag. Set on dragstart, cleared on dragend. Hover-merge consults this
  // to know which chart is being held — the HTML5 DataTransfer is only
  // readable on drop, not during dragover, so we can't ask the event for
  // the payload mid-flight. Reading it here is safe because all drags
  // route through our own dragstart handler, which sets this.
  let currentlyDraggedChart: {
    secIdx: number;
    chartIdx: number;
    chartId: string;
  } | null = null;

  // Hover-merge state. When a single-source dragged chart lingers over
  // another single-source chart's tile for HOVER_MERGE_HOLD_MS, we fire
  // the merge launcher. The buildup CSS class is added after a small
  // grace period so a fast-moving drag doesn't flicker the ring.
  const HOVER_MERGE_HOLD_MS = 1000;
  const HOVER_MERGE_BUILDUP_DELAY_MS = 200;
  let hoverMergeTimer: number | null = null;
  let hoverMergeBuildupTimer: number | null = null;
  let hoverMergeTile: HTMLElement | null = null;
  // When the merge timer fires it opens the cc-modal mid-drag — but the
  // browser is still in drag-in-progress mode. If the user then releases
  // the mouse over a grid, the grid's drop handler would fire and move
  // the dragged chart, corrupting the snapshot we just took for the
  // pending merge. Setting this flag at merge-launch and checking it in
  // the grid drop handler turns that drop into a no-op.
  let dragConsumedByMerge = false;
  function cancelHoverMerge(): void {
    if (hoverMergeTimer !== null) {
      window.clearTimeout(hoverMergeTimer);
      hoverMergeTimer = null;
    }
    if (hoverMergeBuildupTimer !== null) {
      window.clearTimeout(hoverMergeBuildupTimer);
      hoverMergeBuildupTimer = null;
    }
    if (hoverMergeTile) {
      hoverMergeTile.classList.remove("hover-merge-buildup");
      hoverMergeTile = null;
    }
  }

  // Touch long-press state. Mirrors the hover-merge timer but for touch
  // devices, where dragover doesn't fire. On a 600ms hold without significant
  // movement, we show a "Combine with…" menu listing other single-source
  // charts. Picking one calls openMergeModal with the picked-tile as base
  // and the long-pressed tile as dragged — matching desktop semantics
  // (drop target = base) so the inheritance rules read the same way
  // regardless of input modality.
  const LONG_PRESS_HOLD_MS = 600;
  const LONG_PRESS_MOVE_TOLERANCE_PX = 10;
  let longPressTimer: number | null = null;
  let longPressStart: { x: number; y: number } | null = null;
  let longPressFired = false;
  let longPressMenu: HTMLElement | null = null;

  function beginLongPress(
    tile: HTMLElement,
    chartId: string,
    secIdx: number,
    chartIdx: number,
    x: number,
    y: number,
  ): void {
    endLongPress(); // cancel any in-flight one
    longPressStart = { x, y };
    longPressFired = false;
    longPressTimer = window.setTimeout(() => {
      longPressTimer = null;
      longPressFired = true;
      openCombineWithMenu(tile, chartId, secIdx, chartIdx);
    }, LONG_PRESS_HOLD_MS);
  }

  function updateLongPress(x: number, y: number): void {
    if (!longPressStart || longPressTimer === null) return;
    const dx = x - longPressStart.x;
    const dy = y - longPressStart.y;
    if (Math.hypot(dx, dy) > LONG_PRESS_MOVE_TOLERANCE_PX) {
      // The user is scrolling or repositioning the finger — abort the
      // long-press so we don't fire mid-scroll.
      window.clearTimeout(longPressTimer);
      longPressTimer = null;
      longPressStart = null;
    }
  }

  function endLongPress(): void {
    if (longPressTimer !== null) {
      window.clearTimeout(longPressTimer);
      longPressTimer = null;
    }
    longPressStart = null;
  }

  function closeCombineWithMenu(): void {
    if (longPressMenu) {
      longPressMenu.remove();
      longPressMenu = null;
    }
  }

  // Render the "Combine with…" menu near the long-pressed tile. Each row
  // is a single-source chart in the dashboard with a source different from
  // the held tile's; tapping a row opens the merge modal. Tapping outside
  // the menu (or pressing Escape) dismisses it.
  function openCombineWithMenu(
    tile: HTMLElement,
    heldChartId: string,
    heldSecIdx: number,
    heldChartIdx: number,
  ): void {
    closeCombineWithMenu();
    const heldSource = chartSourceIds(heldChartId)[0];
    if (!heldSource) return;
    // Candidates: every other chart in the dashboard that doesn't already
    // include the held source. Multi-source candidates are allowed — the
    // held single-source gets appended to their existing source list,
    // matching the desktop hover-merge rule (dragged must be single-source;
    // target can be anything). Same-source skip prevents a no-op merge.
    const candidates: Array<{
      chartId: string;
      secIdx: number;
      chartIdx: number;
      title: string;
    }> = [];
    state.sections.forEach((sec, sIdx) => {
      sec.charts.forEach((cid, cIdx) => {
        if (sIdx === heldSecIdx && cIdx === heldChartIdx) return;
        const candSources = chartSourceIds(cid);
        if (candSources.length === 0) return;
        if (candSources.includes(heldSource)) return;
        candidates.push({
          chartId: cid,
          secIdx: sIdx,
          chartIdx: cIdx,
          title: chartEffectiveSpec(cid).title,
        });
      });
    });

    const menu = document.createElement("div");
    menu.className = "combine-with-menu";
    menu.setAttribute("role", "menu");
    const heading = document.createElement("div");
    heading.className = "combine-with-menu-heading";
    heading.textContent = `Combine "${chartEffectiveSpec(heldChartId).title}" with…`;
    menu.appendChild(heading);
    if (candidates.length === 0) {
      const empty = document.createElement("div");
      empty.className = "combine-with-menu-empty";
      empty.textContent =
        "No other charts to combine with. Add another chart first, or pick one that doesn't already include this series.";
      menu.appendChild(empty);
    } else {
      for (const cand of candidates) {
        const row = document.createElement("button");
        row.type = "button";
        row.className = "combine-with-menu-item";
        row.textContent = cand.title;
        row.addEventListener("click", (e) => {
          e.stopPropagation();
          closeCombineWithMenu();
          // Picked = base, held = dragged — matches desktop drag-onto-target
          // semantics so the merged chart keeps the picked target's
          // title/blurb/defaultDelta regardless of input modality.
          openMergeModal(
            {
              chartId: cand.chartId,
              secIdx: cand.secIdx,
              chartIdx: cand.chartIdx,
            },
            {
              chartId: heldChartId,
              secIdx: heldSecIdx,
              chartIdx: heldChartIdx,
            },
          );
        });
        menu.appendChild(row);
      }
    }
    const cancel = document.createElement("button");
    cancel.type = "button";
    cancel.className = "combine-with-menu-cancel";
    cancel.textContent = "Cancel";
    cancel.addEventListener("click", (e) => {
      e.stopPropagation();
      closeCombineWithMenu();
    });
    menu.appendChild(cancel);

    // Position the menu near the tile. Anchor to the tile's bottom-left
    // and clamp so it doesn't go off-screen on narrow viewports.
    document.body.appendChild(menu);
    const tileRect = tile.getBoundingClientRect();
    const menuRect = menu.getBoundingClientRect();
    let left = tileRect.left;
    let top = tileRect.bottom + 4;
    if (left + menuRect.width > window.innerWidth - 8) {
      left = Math.max(8, window.innerWidth - menuRect.width - 8);
    }
    if (top + menuRect.height > window.innerHeight - 8) {
      top = Math.max(8, tileRect.top - menuRect.height - 4);
    }
    menu.style.left = `${left}px`;
    menu.style.top = `${top}px`;
    longPressMenu = menu;

    // Dismiss on tap-outside or Escape.
    const onDocClick = (ev: Event) => {
      if (!longPressMenu) return;
      if (longPressMenu.contains(ev.target as Node)) return;
      closeCombineWithMenu();
      document.removeEventListener("click", onDocClick, true);
      document.removeEventListener("touchstart", onDocClick, true);
    };
    setTimeout(() => {
      document.addEventListener("click", onDocClick, true);
      document.addEventListener("touchstart", onDocClick, true);
    }, 0);
  }

  // localStorage-backed dismissal flag for the hover-merge tip line shown
  // under the composition. Persists per-browser. Cross-device sync for
  // logged-in users would require a server-side user_prefs row; deferred
  // until it's clear the feature is worth the schema migration.
  const HINT_KEY_HOVER_MERGE = "tape:hint-hover-merge-dismissed";
  function isHoverMergeTipDismissed(): boolean {
    try {
      return localStorage.getItem(HINT_KEY_HOVER_MERGE) === "1";
    } catch {
      // Private browsing or storage blocked — treat as not dismissed
      // (the tip just keeps showing; harmless).
      return false;
    }
  }
  function dismissHoverMergeTip(): void {
    try {
      localStorage.setItem(HINT_KEY_HOVER_MERGE, "1");
    } catch {
      /* storage blocked — accept that the tip will reappear on next load */
    }
  }

  // Compute the index at which a dragged tile should be inserted. The grid
  // is a multi-column CSS grid, so we walk tiles in DOM order and return the
  // first one the cursor is "before" in reading order: above its row, or in
  // its row but left of its horizontal midpoint. Empty grid → 0.
  function computeDropIndex(
    grid: HTMLElement,
    clientX: number,
    clientY: number,
  ): number {
    const tiles = [
      ...grid.querySelectorAll<HTMLElement>(".comp-tile:not(.dragging)"),
    ];
    for (let i = 0; i < tiles.length; i++) {
      const r = tiles[i].getBoundingClientRect();
      // Cursor is above this tile's row entirely → insert before it.
      if (clientY < r.top) return i;
      // Cursor is in this tile's row → look at X.
      if (clientY <= r.bottom) {
        if (clientX < r.left + r.width / 2) return i;
      }
      // Otherwise cursor is below this row — keep walking.
    }
    return tiles.length;
  }

  // Move chart from one (section, index) to another.
  // `toIdx` is computed against the POST-removal array (computeDropIndex
  // skips the .dragging tile), so for same-section moves we splice the
  // source out first and then insert at toIdx directly — no off-by-one.
  function moveChart(
    fromSec: number,
    fromIdx: number,
    toSec: number,
    toIdx: number,
  ): void {
    if (fromSec === toSec && fromIdx === toIdx) return; // dropped on own slot
    const fromArr = state.sections[fromSec]?.charts;
    const toArr = state.sections[toSec]?.charts;
    if (!fromArr || !toArr) return;
    const [chartId] = fromArr.splice(fromIdx, 1);
    toArr.splice(toIdx, 0, chartId);
    // Cross-section move: refocus on the destination so subsequent library
    // clicks land where the user was just operating.
    if (fromSec !== toSec) activeSectionIdx = toSec;
    writeUrl();
    renderComposition();
  }

  // Reorder sections. `toIdx` is the desired final index in the array
  // (i.e. drop "before section N" means toIdx = N; drop "after" means N + 1).
  function moveSection(fromSec: number, toIdx: number): void {
    if (
      fromSec < 0 ||
      fromSec >= state.sections.length ||
      toIdx < 0 ||
      toIdx > state.sections.length
    )
      return;
    if (fromSec === toIdx || fromSec === toIdx - 1) return; // same slot
    const [moved] = state.sections.splice(fromSec, 1);
    let actualIdx = toIdx;
    if (fromSec < toIdx) actualIdx--;
    state.sections.splice(actualIdx, 0, moved);
    // Keep the active section pointer pointing at the same logical section.
    if (activeSectionIdx === fromSec) {
      activeSectionIdx = actualIdx;
    } else if (
      fromSec < activeSectionIdx &&
      actualIdx >= activeSectionIdx
    ) {
      activeSectionIdx--;
    } else if (
      fromSec > activeSectionIdx &&
      actualIdx <= activeSectionIdx
    ) {
      activeSectionIdx++;
    }
    writeUrl();
    renderComposition();
  }

  // Returns a warning string if the chart's underlying sources don't cover
  // the dashboard's fixed range. Returns null when fully covered or when no
  // fixed range is set. Light-touch: pulls firstObservation/lastObservation
  // from the library.json manifest, no extra fetches.
  function coverageWarningFor(chartId: string): string | null {
    if (!state.fixedRange) return null;
    if (!library) return null;
    const sourceIds = isInlineId(chartId)
      ? state.inlineCharts[chartId]?.sources ?? []
      : library.charts.find((c) => c.id === chartId)?.sources ?? [];
    if (sourceIds.length === 0) return null;
    const start = state.fixedRange.start;
    const end = state.fixedRange.end;
    const issues: string[] = [];
    for (const sid of sourceIds) {
      const s = library.sources[sid] as
        | { firstObservation?: string; lastObservation?: string; shortName?: string; name?: string }
        | undefined;
      if (!s) continue;
      const first = s.firstObservation;
      const last = s.lastObservation;
      const label = s.shortName ?? s.name ?? sid;
      if (first && first > start) issues.push(`${label} starts ${first}`);
      if (last && last < end) issues.push(`${label} ends ${last}`);
    }
    return issues.length > 0 ? issues.join("; ") : null;
  }

  function wireGridDropTarget(grid: HTMLElement): void {
    grid.addEventListener("dragover", (e) => {
      // Only react to our own drag payload — leaves text-drag-from-elsewhere
      // alone so the browser can do its default thing.
      const types = e.dataTransfer?.types;
      if (!types || !Array.from(types).includes("application/x-legible-chart"))
        return;
      e.preventDefault();
      if (e.dataTransfer) e.dataTransfer.dropEffect = "move";
      grid.classList.add("drop-target");
    });
    grid.addEventListener("dragleave", (e) => {
      // Only clear when leaving the grid itself, not when crossing into a child.
      if (e.target === grid) grid.classList.remove("drop-target");
    });
    grid.addEventListener("drop", (e) => {
      const raw = e.dataTransfer?.getData("application/x-legible-chart");
      if (!raw) return;
      e.preventDefault();
      grid.classList.remove("drop-target");
      // If hover-merge fired its modal mid-drag, swallow this drop so the
      // dragged chart doesn't ALSO get moved into the target section.
      // The flag is reset on dragend so subsequent normal drags work.
      if (dragConsumedByMerge) return;
      let payload: { secIdx: number; chartIdx: number };
      try {
        payload = JSON.parse(raw);
      } catch {
        return;
      }
      const toSec = Number(grid.dataset.secIdx ?? "-1");
      if (toSec < 0) return;
      const toIdx = computeDropIndex(grid, e.clientX, e.clientY);
      moveChart(payload.secIdx, payload.chartIdx, toSec, toIdx);
    });
  }

  function renderComposition(): void {
    const host = shell.querySelector<HTMLElement>("[data-role='comp-sections']");
    const empty = shell.querySelector<HTMLElement>("[data-role='comp-empty']");
    if (!host || !empty) return;
    host.innerHTML = "";
    const hasAny = state.sections.some((s) => s.charts.length > 0);
    empty.style.display = hasAny ? "none" : "";
    clampActiveSection();
    state.sections.forEach((sec, secIdx) => {
      const secEl = document.createElement("section");
      secEl.className =
        "comp-section" + (secIdx === activeSectionIdx ? " comp-section-active" : "");
      // Clicking anywhere on the section focuses it (except when the user is
      // interacting with an input/textarea/button inside it — those stop
      // propagation or handle their own logic).
      secEl.addEventListener("click", (e) => {
        const tag = (e.target as HTMLElement).tagName;
        if (tag === "INPUT" || tag === "TEXTAREA" || tag === "BUTTON") return;
        setActiveSection(secIdx);
      });
      // Section-reorder drop target. Only reacts to section-type payload —
      // chart drags route through the inner grid handlers, not the section.
      secEl.addEventListener("dragover", (e) => {
        const types = e.dataTransfer?.types;
        if (
          !types ||
          !Array.from(types).includes("application/x-legible-section")
        )
          return;
        e.preventDefault();
        if (e.dataTransfer) e.dataTransfer.dropEffect = "move";
        const r = secEl.getBoundingClientRect();
        const before = e.clientY < r.top + r.height / 2;
        secEl.classList.toggle("drop-before", before);
        secEl.classList.toggle("drop-after", !before);
      });
      secEl.addEventListener("dragleave", (e) => {
        if (e.target === secEl) {
          secEl.classList.remove("drop-before", "drop-after");
        }
      });
      secEl.addEventListener("drop", (e) => {
        const raw = e.dataTransfer?.getData("application/x-legible-section");
        if (!raw) return;
        e.preventDefault();
        secEl.classList.remove("drop-before", "drop-after");
        let payload: { secIdx: number };
        try {
          payload = JSON.parse(raw);
        } catch {
          return;
        }
        const r = secEl.getBoundingClientRect();
        const before = e.clientY < r.top + r.height / 2;
        const targetIdx = before ? secIdx : secIdx + 1;
        moveSection(payload.secIdx, targetIdx);
      });
      const header = document.createElement("div");
      header.className = "comp-section-header";
      // Drag handle — only this is draggable, so the input fields below
      // remain interactive without accidentally starting drags.
      const handle = document.createElement("span");
      handle.className = "comp-section-drag-handle";
      handle.title = "Drag to reorder section";
      handle.textContent = "⋮⋮"; // vertical ellipsis ×2
      handle.draggable = true;
      handle.addEventListener("dragstart", (e) => {
        if (!e.dataTransfer) return;
        e.dataTransfer.effectAllowed = "move";
        e.dataTransfer.setData(
          "application/x-legible-section",
          JSON.stringify({ secIdx }),
        );
        e.dataTransfer.setData("text/plain", `section ${secIdx}`);
        secEl.classList.add("dragging");
      });
      handle.addEventListener("dragend", () => {
        secEl.classList.remove("dragging");
        shell
          .querySelectorAll<HTMLElement>(".comp-section.drop-before, .comp-section.drop-after")
          .forEach((s) => s.classList.remove("drop-before", "drop-after"));
      });
      header.appendChild(handle);
      const title = document.createElement("input");
      title.type = "text";
      title.className = "comp-section-title";
      title.value = sec.title;
      title.placeholder = "Section title";
      title.addEventListener("input", () => {
        sec.title = title.value;
        writeUrl();
      });
      title.addEventListener("focus", () => setActiveSection(secIdx));
      header.appendChild(title);
      if (secIdx === activeSectionIdx) {
        const hint = document.createElement("span");
        hint.className = "comp-section-active-hint";
        hint.textContent = "\u2190 adds go here";
        header.appendChild(hint);
      }
      const del = document.createElement("button");
      del.type = "button";
      del.className = "comp-section-del";
      del.title = "Remove section";
      del.textContent = "\u00d7";
      del.addEventListener("click", () => {
        if (sec.charts.length && !confirm("Remove section and its charts?")) return;
        state.sections.splice(secIdx, 1);
        if (state.sections.length === 0) state.sections = defaultSections();
        writeUrl();
        renderComposition();
      });
      header.appendChild(del);
      secEl.appendChild(header);

      const desc = document.createElement("textarea");
      desc.className = "comp-section-desc";
      desc.rows = 1;
      desc.placeholder = "Add commentary for this section (optional)…";
      desc.value = sec.description ?? "";
      desc.addEventListener("input", () => {
        sec.description = desc.value;
        writeUrl();
      });
      desc.addEventListener("focus", () => setActiveSection(secIdx));
      secEl.appendChild(desc);

      const grid = document.createElement("div");
      grid.className = "comp-section-grid";
      grid.dataset.secIdx = String(secIdx);
      // Drag-to-reorder: every grid is a drop target for chart moves.
      wireGridDropTarget(grid);
      if (sec.charts.length === 0) {
        grid.innerHTML = '<p class="muted small comp-empty-slot">Empty section. Click a chart on the left, or drag a chart here.</p>';
      } else {
        sec.charts.forEach((chartId, chartIdx) => {
          const tile = document.createElement("div");
          let titleText: string;
          let metaText: string;
          if (isInlineId(chartId)) {
            const inline = state.inlineCharts[chartId];
            titleText = inline?.title ?? chartId;
            const sourceLabels = (inline?.sources ?? []).map((sid) => {
              if (isDerivedId(sid)) {
                return state.inlineSources[sid]?.name ?? sid;
              }
              const s = library?.sources[sid];
              return s?.shortName ?? s?.name ?? sid;
            });
            // Legacy chart-level op (deprecated by derived sources): keep
            // rendering correctly for any saved dashboards that still
            // carry it.
            const joiner = inline?.op === "divide"
              ? " ÷ "
              : inline?.op === "diff"
                ? " − "
                : " + ";
            metaText = `custom · ${sourceLabels.join(joiner)}`;
            tile.className = "comp-tile comp-tile-inline";
          } else {
            const chart = library?.charts.find((c) => c.id === chartId);
            const override = state.chartOverrides[chartId];
            titleText = override?.title || chart?.title || chartId;
            const tagText = (chart?.tags ?? []).join(" \u00b7 ");
            metaText = override?.blurb
              ? `${tagText}${tagText ? " \u00b7 " : ""}note added`
              : tagText;
            tile.className =
              "comp-tile" + (override ? " has-override" : "");
          }
          tile.innerHTML =
            `<div class="comp-tile-title">${escapeHtml(titleText)}</div>` +
            `<div class="comp-tile-meta">${escapeHtml(metaText)}</div>`;
          // Fixed-range coverage check: highlight tiles whose underlying
          // sources don't fully cover the requested range. Doesn't reject —
          // the user can still ship a dashboard with partial coverage; we
          // just flag it.
          const coverageMsg = coverageWarningFor(chartId);
          if (coverageMsg) {
            tile.classList.add("comp-tile-coverage-warn");
            tile.title = `Outside fixed range: ${coverageMsg}`;
            const meta = tile.querySelector<HTMLElement>(".comp-tile-meta");
            if (meta) {
              const flag = document.createElement("span");
              flag.className = "comp-tile-coverage-flag";
              flag.textContent = " · partial coverage";
              meta.appendChild(flag);
            }
          }
          // Drag-to-reorder. Browsers only fire `click` if no drag happened,
          // so click-to-edit on inline tiles still works alongside this.
          tile.draggable = true;
          tile.dataset.secIdx = String(secIdx);
          tile.dataset.chartIdx = String(chartIdx);
          tile.addEventListener("dragstart", (e) => {
            if (!e.dataTransfer) return;
            e.dataTransfer.effectAllowed = "move";
            e.dataTransfer.setData(
              "application/x-legible-chart",
              JSON.stringify({ secIdx, chartIdx }),
            );
            e.dataTransfer.setData("text/plain", chartId);
            tile.classList.add("dragging");
            currentlyDraggedChart = { secIdx, chartIdx, chartId };
          });
          tile.addEventListener("dragend", () => {
            tile.classList.remove("dragging");
            shell
              .querySelectorAll<HTMLElement>(".comp-section-grid.drop-target")
              .forEach((g) => g.classList.remove("drop-target"));
            currentlyDraggedChart = null;
            cancelHoverMerge();
            // Reset the merge-consumed flag so the next drag's drop fires
            // normally. (drop fires before dragend, so by the time we
            // get here the flag has already done its job for this drag.)
            dragConsumedByMerge = false;
          });
          // Hover-merge: holding a single-source chart over ANY chart
          // (single- or multi-source) for HOVER_MERGE_HOLD_MS opens the
          // cc-modal pre-filled with the union of sources. Dragging a
          // multi-source chart onto another chart does NOT engage merge —
          // multi → anything would need a picker for which sources to
          // bring across, which lives in the modal's own source-picker
          // anyway. The buildup ring fills during the hold so the user
          // knows what's coming and can cancel by moving the cursor off.
          tile.addEventListener("dragover", (e) => {
            // Only react to our own drag payload; ignore text drags / etc.
            const types = e.dataTransfer?.types;
            if (
              !types ||
              !Array.from(types).includes("application/x-legible-chart")
            ) {
              return;
            }
            const dragged = currentlyDraggedChart;
            if (!dragged) return;
            // Don't engage hover-merge over the dragged tile itself.
            if (dragged.secIdx === secIdx && dragged.chartIdx === chartIdx) {
              cancelHoverMerge();
              return;
            }
            // Dragged end MUST be single-source — that's the "I want to
            // add THIS series to that chart" gesture. The target can have
            // any number of sources; we just append.
            if (!isSingleSourceChart(dragged.chartId)) return;
            // Same-source skip: if the dragged source is already in the
            // target's source list, the merge would no-op (or worse,
            // duplicate). Stays a normal reorder.
            const draggedSrc = chartSourceIds(dragged.chartId)[0];
            const baseSrcs = chartSourceIds(chartId);
            if (baseSrcs.includes(draggedSrc)) return;
            // Already hovering this tile — let the existing timers run.
            if (hoverMergeTile === tile) return;
            // Hovering a new tile — reset and re-arm.
            cancelHoverMerge();
            hoverMergeTile = tile;
            hoverMergeBuildupTimer = window.setTimeout(() => {
              tile.classList.add("hover-merge-buildup");
              hoverMergeBuildupTimer = null;
            }, HOVER_MERGE_BUILDUP_DELAY_MS);
            hoverMergeTimer = window.setTimeout(() => {
              hoverMergeTimer = null;
              // Snapshot before cancelHoverMerge nukes them.
              const baseSec = secIdx;
              const baseIdx = chartIdx;
              const baseId = chartId;
              const dr = currentlyDraggedChart;
              cancelHoverMerge();
              if (!dr) return;
              // Block the drag's eventual drop (the user is probably
              // still holding the mouse) from also moving the chart.
              dragConsumedByMerge = true;
              openMergeModal(
                { chartId: baseId, secIdx: baseSec, chartIdx: baseIdx },
                { chartId: dr.chartId, secIdx: dr.secIdx, chartIdx: dr.chartIdx },
              );
            }, HOVER_MERGE_HOLD_MS);
          });
          tile.addEventListener("dragleave", (e) => {
            // dragleave fires when the cursor enters a child element too,
            // so check the related target — if we're still inside this
            // tile (e.g. moved onto the × button), do nothing.
            const related = e.relatedTarget as Node | null;
            if (related && tile.contains(related)) return;
            if (hoverMergeTile === tile) cancelHoverMerge();
          });
          // Touch long-press → "Combine with…" menu. Drag-hover doesn't
          // translate to touch (no hover state during a finger drag), so
          // we expose the same merge action via a long-press menu on
          // single-source tiles. The picked chart becomes the BASE
          // (matches the desktop semantics where the drop target = base);
          // the long-pressed chart is the dragged.
          tile.addEventListener("touchstart", (e) => {
            if (!isSingleSourceChart(chartId)) return;
            const t = e.touches[0];
            if (!t) return;
            beginLongPress(tile, chartId, secIdx, chartIdx, t.clientX, t.clientY);
          }, { passive: true });
          tile.addEventListener("touchmove", (e) => {
            const t = e.touches[0];
            if (!t) return;
            updateLongPress(t.clientX, t.clientY);
          }, { passive: true });
          tile.addEventListener("touchend", () => {
            endLongPress();
          });
          tile.addEventListener("touchcancel", () => {
            endLongPress();
          });
          // Every tile is editable. Inline tiles open their existing
          // edit flow directly; library tiles get a copy-and-promote
          // step first (library YAML stays untouched, an inline copy
          // becomes the editable working version).
          tile.classList.add("comp-tile-editable");
          tile.title = "Drag to reorder, click to edit";
          const openEditor = (): void => {
            if (isInlineId(chartId)) {
              openCustomChartModal(chartId);
              return;
            }
            const newId = promoteLibraryChartToInline(chartId, secIdx, chartIdx);
            if (!newId) {
              // Library entry vanished (deleted catalog file, stale
              // saved dashboard). Fall back to the lightweight blurb
              // modal so the user still has SOME way to edit the tile.
              openChartBlurbModal(chartId);
              return;
            }
            writeUrl();
            renderComposition();
            openCustomChartModal(newId);
          };
          tile.addEventListener("click", (e) => {
            // If a long-press just fired on this tile, the synthetic
            // click from touchend would otherwise open the editor on
            // top of the menu. Eat this click and reset.
            if (longPressFired) {
              longPressFired = false;
              e.stopPropagation();
              return;
            }
            openEditor();
          });
          const rm = document.createElement("button");
          rm.type = "button";
          rm.className = "comp-tile-del";
          rm.textContent = "\u00d7";
          rm.title = "Remove";
          // Don't let mousedown on the \u00d7 kick off a drag of the parent tile.
          rm.draggable = false;
          rm.addEventListener("mousedown", (e) => e.stopPropagation());
          rm.addEventListener("click", (e) => {
            e.stopPropagation();
            sec.charts.splice(chartIdx, 1);
            writeUrl();
            renderComposition();
          });
          // \u270e Edit button: for inline charts, opens the custom-chart modal;
          // for library charts, opens the per-chart blurb / title override.
          const edit = document.createElement("button");
          edit.type = "button";
          edit.className = "comp-tile-edit";
          edit.textContent = "\u270e";
          edit.title = "Edit chart";
          edit.draggable = false;
          edit.addEventListener("mousedown", (e) => e.stopPropagation());
          edit.addEventListener("click", (e) => {
            e.stopPropagation();
            openEditor();
          });
          tile.appendChild(edit);
          tile.appendChild(rm);
          grid.appendChild(tile);
        });
      }
      secEl.appendChild(grid);
      host.appendChild(secEl);
    });

    // Hover-merge tip — shown until the user either dismisses it or
    // discovers the feature by hovering long enough to fire a merge.
    // Only worth showing when the dashboard has 2+ charts; with 0–1
    // there's nothing to combine yet.
    const totalCharts = state.sections.reduce(
      (n, s) => n + s.charts.length,
      0,
    );
    if (totalCharts >= 2 && !isHoverMergeTipDismissed()) {
      const tip = document.createElement("div");
      tip.className = "comp-hover-merge-tip";
      tip.innerHTML =
        '<span>Tip: drag a single-source chart onto another chart and hold for a moment to combine them.</span>' +
        '<button type="button" class="comp-hover-merge-tip-dismiss" aria-label="Dismiss tip">&times;</button>';
      const dismissBtn = tip.querySelector<HTMLButtonElement>(
        ".comp-hover-merge-tip-dismiss",
      );
      dismissBtn?.addEventListener("click", () => {
        dismissHoverMergeTip();
        tip.remove();
      });
      host.appendChild(tip);
    }
  }

  // ---- Anonymous composer rate-limit gate ----
  //
  // Anonymous users get 20 chart-adds + derived-source-creates per IP per
  // day before the composer prompts them to sign in (see migration 0004,
  // compose_action_check RPC). Signed-in users skip the roundtrip entirely.
  //
  // Once we've seen a denial in this tab, latch composeCapHit so subsequent
  // attempts skip the network call and go straight to the prompt — both
  // for UX (no roundtrip delay on each click) and to keep the per-IP
  // counter from creeping up on every refused attempt.
  let composeCapHit = false;

  async function checkComposeAction(action: string): Promise<boolean> {
    // Latch: once capped, stay capped until page reload (which happens
    // automatically after OAuth sign-in via the redirectTo flow).
    if (composeCapHit) return false;
    // Fast path: signed-in users always pass without a roundtrip.
    if (readStoredSession()) return true;
    try {
      const res = await fetch(
        `${SUPABASE_REST_URL}/rest/v1/rpc/compose_action_check`,
        {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            apikey: SUPABASE_REST_ANON_KEY,
            Authorization: `Bearer ${SUPABASE_REST_ANON_KEY}`,
          },
          body: JSON.stringify({ p_action: action }),
        },
      );
      if (!res.ok) return true; // fail-open on transport errors
      const allowed = await res.json();
      const ok = allowed === true;
      if (!ok) composeCapHit = true;
      return ok;
    } catch {
      return true; // fail-open on network errors
    }
  }

  function showSigninPrompt(reason: string): void {
    const backdrop = shell.querySelector<HTMLElement>(
      "[data-role='signin-prompt']",
    );
    if (backdrop) backdrop.hidden = false;
    // Funnel telemetry: which action triggered the prompt, so we can see
    // whether chart-adds or derived-source-creates drive the cap-hits.
    track("compose_signin_prompt_shown", { reason });
  }

  // ---- Mutations ----
  async function addChart(chartId: string): Promise<void> {
    clampActiveSection();
    const target = state.sections[activeSectionIdx];
    if (!target) return;
    if (target.charts.includes(chartId)) return; // don't duplicate (no budget cost)
    // Anon rate-limit gate. Authed users always pass; anon users above
    // their 20-per-day per-IP budget get the prompt instead of the add.
    const allowed = await checkComposeAction("add_chart");
    if (!allowed) {
      showSigninPrompt("add_chart");
      return;
    }
    target.charts.push(chartId);
    writeUrl();
    renderComposition();
    // Funnel telemetry: which charts are most popular adds, and how often
    // first-time users get past "open composer" → "actually pick a chart".
    // Include the chart's underlying source IDs so we can also see *source*
    // popularity at construction time, not just chart popularity.
    const libChart = library?.charts.find((c) => c.id === chartId);
    track("compose_chart_added", {
      chartId,
      source: "library",
      sources: libChart ? packSourceIds(libChart.sources) : "",
    });
  }

  // ---- Wire up controls ----
  function wire(): void {
    const titleInput = shell.querySelector<HTMLInputElement>("[data-role='title-input']");
    if (titleInput) {
      titleInput.value = state.title;
      titleInput.addEventListener("input", () => {
        state.title = titleInput.value;
        writeUrl();
      });
    }
    const descInput = shell.querySelector<HTMLTextAreaElement>("[data-role='description-input']");
    if (descInput) {
      descInput.value = state.description;
      descInput.addEventListener("input", () => {
        state.description = descInput.value;
        writeUrl();
      });
    }
    const ddSelect = shell.querySelector<HTMLSelectElement>("[data-role='default-delta']");
    const fixedInputs = shell.querySelector<HTMLElement>("[data-role='fixed-inputs']");
    const fixedStart = shell.querySelector<HTMLInputElement>("[data-role='fixed-start']");
    const fixedEnd = shell.querySelector<HTMLInputElement>("[data-role='fixed-end']");
    function syncTimeUI(): void {
      if (!ddSelect) return;
      const usingFixed = !!state.fixedRange;
      ddSelect.value = usingFixed ? "fixed" : state.defaultDelta;
      if (fixedInputs) fixedInputs.hidden = !usingFixed;
      if (usingFixed) {
        if (fixedStart) fixedStart.value = state.fixedRange!.start;
        if (fixedEnd) fixedEnd.value = state.fixedRange!.end;
      }
    }
    syncTimeUI();
    ddSelect?.addEventListener("change", () => {
      const v = ddSelect.value;
      if (v === "fixed") {
        // Initialize a sensible default range if there isn't one yet:
        // last 5 years to today.
        if (!state.fixedRange) {
          const today = new Date();
          const todayIso = today.toISOString().slice(0, 10);
          const fiveYearsAgo = new Date(today);
          fiveYearsAgo.setFullYear(today.getFullYear() - 5);
          state.fixedRange = {
            start: fiveYearsAgo.toISOString().slice(0, 10),
            end: todayIso,
          };
        }
        state.defaultDelta = "";
      } else {
        state.fixedRange = undefined;
        state.defaultDelta = v as UIState["defaultDelta"];
      }
      syncTimeUI();
      writeUrl();
      renderComposition(); // re-flag tiles for coverage
    });
    function onFixedInput(): void {
      if (!fixedStart || !fixedEnd) return;
      const start = fixedStart.value;
      const end = fixedEnd.value;
      // Only commit when both are valid and start <= end. Otherwise leave the
      // existing fixedRange untouched so the user can edit one box at a time.
      if (
        /^\d{4}-\d{2}-\d{2}$/.test(start) &&
        /^\d{4}-\d{2}-\d{2}$/.test(end) &&
        start <= end
      ) {
        state.fixedRange = { start, end };
        writeUrl();
        renderComposition();
      }
    }
    fixedStart?.addEventListener("change", onFixedInput);
    fixedEnd?.addEventListener("change", onFixedInput);
    const searchInputSources = shell.querySelector<HTMLInputElement>(
      "[data-role='lib-search-sources']",
    );
    if (searchInputSources) {
      searchInputSources.addEventListener("input", () => {
        sourcesSearchQuery = searchInputSources.value;
        renderSourcesList();
      });
    }
    // ---- Geo-chip wiring (Sources tab) ----
    // wireGeoChips is reused by the cc-modal + ds-modal; here we wire
    // the Sources tab's geo strip the same way.
    wireGeoChips("lib");
    const searchInputCharts = shell.querySelector<HTMLInputElement>(
      "[data-role='lib-search-charts']",
    );
    if (searchInputCharts) {
      searchInputCharts.addEventListener("input", () => {
        chartsSearchQuery = searchInputCharts.value;
        renderChartsList();
      });
    }
    // Tab switching. Default tab (sources) is already visible from
    // the markup; clicking a tab swaps panels + re-renders the new
    // active tab so its data is fresh.
    shell.querySelectorAll<HTMLButtonElement>("[data-role='lib-tab']").forEach((btn) => {
      btn.addEventListener("click", () => {
        const tab = btn.dataset.tab as LibTab | undefined;
        if (tab === "sources" || tab === "charts") setActiveLibTab(tab);
      });
    });
    const addSection = shell.querySelector<HTMLButtonElement>("[data-role='add-section']");
    if (addSection) {
      addSection.addEventListener("click", () => {
        state.sections.push({
          title: `Section ${state.sections.length + 1}`,
          description: "",
          charts: [],
        });
        activeSectionIdx = state.sections.length - 1;
        writeUrl();
        renderComposition();
      });
    }
    const openCustom = shell.querySelector<HTMLButtonElement>("[data-role='open-custom-chart']");
    if (openCustom) {
      openCustom.addEventListener("click", () => openCustomChartModal());
    }
    const openDerived = shell.querySelector<HTMLButtonElement>("[data-role='open-derived-source']");
    if (openDerived) {
      openDerived.addEventListener("click", () => openDerivedSourceModal());
    }
    wireCustomChartModal();
    wireChartBlurbModal();
    wireDerivedSourceModal();
    wireSigninPrompt();
    const copyShare = shell.querySelector<HTMLButtonElement>("[data-role='copy-share']");
    if (copyShare) {
      copyShare.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          copyShare.textContent = "Copied!";
          setTimeout(() => (copyShare.textContent = "Copy share link"), 1500);
          // Share-link copy is the closest proxy we have for "user found this
          // valuable enough to send to someone else." Track length so we can
          // also see how often URLs are uncomfortably long (the saved-vs-shared
          // breakpoint).
          track("compose_share_copied", {
            urlLength: window.location.href.length,
          });
        } catch {
          alert("Copy failed. URL is in the address bar.");
        }
      });
    }

    // ---- Save to account (Supabase) ----
    // Button is always visible; if not signed in, clicking triggers the OAuth
    // round-trip and returns the user to the composer with their state intact.
    const saveBtn = shell.querySelector<HTMLButtonElement>("[data-role='save']");
    const saveDefaultLabel =
      saveBtn?.dataset.saveDefaultLabel ?? "Save to my account";
    if (saveBtn) {
      saveBtn.textContent = editingSlug
        ? "Update dashboard"
        : saveDefaultLabel;
      saveBtn.title = editingSlug
        ? `Updates the saved dashboard at /u/${editingSlug}/`
        : "Saves this composition to your account";
    }
    console.log("[save] wire:", {
      saveBtn: !!saveBtn,
      supabaseConfigured: isSupabaseConfigured,
      editingSlug,
    });
    if (saveBtn && isSupabaseConfigured) {
      const sb = createSupabase();
      console.log("[save] client:", !!sb);
      if (sb) {
        saveBtn.addEventListener("click", async () => {
          console.log("[save] click fired");
          // Step 1 of the save funnel: user clicked save. Captures whether
          // they were signed in or got bounced through OAuth.
          track("compose_save_attempted", {
            mode: editingSlug ? "update" : "create",
            wasSignedIn: !!readStoredSession(),
          });
          try {
            const stored = readStoredSession();
            console.log("[save] stored session user:", stored?.user?.email ?? null);
            if (!stored) {
              await sb.auth.signInWithOAuth({
                provider: "google",
                options: {
                  redirectTo: window.location.href,
                  scopes: "openid email",
                },
              });
              return;
            }
            const cleanSections = state.sections
              .filter((s) => s.charts.length > 0)
              .map((s) => ({
                title: s.title,
                description: s.description || undefined,
                charts: [...s.charts],
              }));
            console.log("[save] cleanSections:", cleanSections.length);
            if (cleanSections.length === 0) {
              alert("Add at least one chart before saving.");
              return;
            }
            const stateJson = {
              v: 1,
              title: state.title || undefined,
              description: state.description || undefined,
              defaultDelta: state.defaultDelta || undefined,
              fixedRange: state.fixedRange,
              sections: cleanSections,
              inlineCharts: referencedInlineCharts(),
              inlineSources: referencedInlineSources(),
              chartOverrides: referencedChartOverrides(),
            };
            saveBtn.disabled = true;
            const restoreLabel = editingSlug ? "Update dashboard" : saveDefaultLabel;
            saveBtn.textContent = editingSlug ? "Updating…" : "Saving…";

            let targetSlug: string;
            let res: Response;
            if (editingSlug) {
              // PATCH the existing row — owner-only per RLS. If the caller
              // doesn't own this slug the request returns 204 with zero rows
              // matched, so we explicitly fetch representation to confirm.
              targetSlug = editingSlug;
              const url = `${SUPABASE_REST_URL}/rest/v1/saved_dashboards?slug=eq.${encodeURIComponent(targetSlug)}`;
              console.log("[save] patching slug:", targetSlug);
              res = await fetch(url, {
                method: "PATCH",
                headers: {
                  "Content-Type": "application/json",
                  apikey: SUPABASE_REST_ANON_KEY,
                  Authorization: `Bearer ${stored.access_token}`,
                  Prefer: "return=representation",
                },
                body: JSON.stringify({
                  title: state.title || "Untitled dashboard",
                  state_json: stateJson,
                }),
              });
            } else {
              targetSlug = nanoid(10);
              console.log("[save] inserting slug:", targetSlug);
              res = await fetch(`${SUPABASE_REST_URL}/rest/v1/saved_dashboards`, {
                method: "POST",
                headers: {
                  "Content-Type": "application/json",
                  apikey: SUPABASE_REST_ANON_KEY,
                  Authorization: `Bearer ${stored.access_token}`,
                  Prefer: "return=minimal",
                },
                body: JSON.stringify({
                  slug: targetSlug,
                  owner_id: stored.user.id,
                  title: state.title || "Untitled dashboard",
                  state_json: stateJson,
                }),
              });
            }
            saveBtn.disabled = false;
            saveBtn.textContent = restoreLabel;
            console.log("[save] HTTP status:", res.status);
            if (!res.ok) {
              const msg = await res.text().catch(() => `HTTP ${res.status}`);
              console.error("[save] error:", msg);
              alert(`Save failed: ${msg}`);
              return;
            }
            if (editingSlug) {
              // PATCH with return=representation returns [] if RLS filtered
              // the update out (i.e. you don't own this slug). Treat that as
              // a permission error rather than silently no-op'ing.
              const rows = await res.json().catch(() => []);
              if (!Array.isArray(rows) || rows.length === 0) {
                alert(
                  "Couldn't update this dashboard — you may not own it, or it no longer exists.",
                );
                return;
              }
            }
            console.log("[save] success, redirecting");
            // Step 2 of the save funnel: persisted. compose_save_attempted →
            // compose_save_succeeded ratio tells us how often the save flow
            // actually completes vs. dies in OAuth or hits a Supabase error.
            track("compose_save_succeeded", {
              mode: editingSlug ? "update" : "create",
              slug: targetSlug,
            });
            // On create (not update) include ?just-saved=1 so the /u/<slug>/
            // page knows to surface the post-save email-signup prompt. Edits
            // skip the prompt — the user has already been through this flow.
            const arriveQuery = editingSlug ? "" : "?just-saved=1";
            window.location.href = `${baseUrl}/u/${targetSlug}/${arriveQuery}`;
          } catch (e) {
            console.error("[save] click handler threw:", e);
            alert(`Save failed: ${String(e)}`);
            saveBtn.disabled = false;
            saveBtn.textContent = "Save to my account";
          }
        });
      }
    }
  }

  // ---- Per-chart blurb / title override modal ----
  let cbEditingChartId: string | null = null;

  function openChartBlurbModal(chartId: string): void {
    cbEditingChartId = chartId;
    const existing = state.chartOverrides[chartId] ?? {};
    const libChart = library?.charts.find((c) => c.id === chartId);
    const backdrop = shell.querySelector<HTMLElement>("[data-role='cb-modal']");
    if (!backdrop) return;
    backdrop.hidden = false;
    const nameEl = shell.querySelector<HTMLElement>("[data-role='cb-chart-name']");
    if (nameEl) {
      nameEl.textContent = libChart?.title ?? chartId;
    }
    const titleInput = shell.querySelector<HTMLInputElement>("[data-role='cb-title']");
    if (titleInput) {
      titleInput.value = existing.title ?? "";
      titleInput.placeholder = `Leave blank to keep "${libChart?.title ?? chartId}"`;
      titleInput.focus();
    }
    const blurbInput = shell.querySelector<HTMLTextAreaElement>("[data-role='cb-blurb']");
    if (blurbInput) blurbInput.value = existing.blurb ?? "";
  }

  function closeChartBlurbModal(): void {
    cbEditingChartId = null;
    const backdrop = shell.querySelector<HTMLElement>("[data-role='cb-modal']");
    if (backdrop) backdrop.hidden = true;
  }

  function wireChartBlurbModal(): void {
    const backdrop = shell.querySelector<HTMLElement>("[data-role='cb-modal']");
    const closeBtn = shell.querySelector<HTMLButtonElement>("[data-role='cb-close']");
    const cancelBtn = shell.querySelector<HTMLButtonElement>("[data-role='cb-cancel']");
    const saveBtn = shell.querySelector<HTMLButtonElement>("[data-role='cb-save']");
    closeBtn?.addEventListener("click", closeChartBlurbModal);
    cancelBtn?.addEventListener("click", closeChartBlurbModal);
    backdrop?.addEventListener("click", (e) => {
      if (e.target === backdrop) closeChartBlurbModal();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape" || !backdrop || backdrop.hidden) return;
      closeChartBlurbModal();
    });
    saveBtn?.addEventListener("click", () => {
      if (!cbEditingChartId) return;
      const titleInput = shell.querySelector<HTMLInputElement>("[data-role='cb-title']");
      const blurbInput = shell.querySelector<HTMLTextAreaElement>("[data-role='cb-blurb']");
      const title = (titleInput?.value ?? "").trim();
      const blurb = (blurbInput?.value ?? "").trim();
      const existing = state.chartOverrides[cbEditingChartId] ?? {};
      const next: ChartOverride = { ...existing };
      if (title) next.title = title;
      else delete next.title;
      if (blurb) next.blurb = blurb;
      else delete next.blurb;
      if (Object.keys(next).length === 0) {
        delete state.chartOverrides[cbEditingChartId];
      } else {
        state.chartOverrides[cbEditingChartId] = next;
      }
      writeUrl();
      renderComposition();
      closeChartBlurbModal();
    });
  }

  // ---- Custom-chart modal ----
  // Modal state (ephemeral — does not live in composed state until Save is clicked).
  type CustomChartMode = "raw" | "rebase" | "dual-axis";
  type ChartCombineOp = "divide" | "sum" | "diff";
  interface CustomChartModalState {
    editingId: string | null; // inline id being edited, or null for create
    title: string;
    selected: Set<string>;
    // Order in which sources were picked; this is the "A, B" order for op
    // computations and preserves the user's intent across re-renders. Items
    // get pushed when checked, removed when unchecked, swapped on Swap.
    selectedOrder: string[];
    search: string;
    mode: CustomChartMode;
    // Tracks whether the user has explicitly picked a mode. If false, the
    // mode is auto-determined from source-scale heuristics on each change.
    modeIsExplicit: boolean;
    // Source IDs assigned to the right axis when mode === "dual-axis".
    // Sources not in this set plot on the left. Edited only when mode is
    // dual-axis; preserved in spec on save.
    rightAxisSources: Set<string>;
    // Optional arithmetic combine op. When set with exactly 2 sources,
    // collapses the chart into a single derived series.
    op: ChartCombineOp | null;
    // Log-scale toggle. Independent of `mode`: log is an axis concern,
    // mode is a value-transformation concern. Forbidden in combination
    // with dual-axis (one-log-one-linear is misleading); the UI clears
    // this flag whenever dual-axis becomes active.
    logScale: boolean;
    // Optional curator-style commentary shown when the chart's expanded
    // dialog is open. Plain text, no markdown. Empty → no blurb saved.
    blurb: string;
    // Tag-chip filter set for the source picker. AND across selected
    // tags. Cleared each time the modal is opened.
    pickerTags: Set<string>;
    // Congressional-district drill-down state for the cc-modal picker.
    // Same semantics as the Sources tab: cdState is the picked 2-letter
    // state code (or null = not yet picked), cdDistrict is the picked
    // district code within that state (or null = "all districts of the
    // state"). Only meaningful when pickerTags includes CD_TAG; reset
    // alongside pickerTags each modal open.
    cdState: string | null;
    cdDistrict: string | null;
    // Metro + country drill-down state. Mirrors libGeo so the cc-modal
    // picker behaves identically to the Sources tab.
    geo: GeoState;
    // For divides that auto-render as percent (same-class divide):
    //   "percent" (or undefined) → "104%"
    //   "decimal"                → "1.04"
    //   "ratio"                  → "1.04:1"
    // Only meaningful when op === "divide" with 2 sources; ignored
    // otherwise. Saved to inlineChart.percentDisplay on submit.
    percentDisplay: "percent" | "decimal" | "ratio" | undefined;
    // Set when the modal was opened via hover-merge (or the touch
    // Combine-with menu). On Create, the new chart replaces the BASE
    // chart in its section slot and the DRAGGED chart is removed from
    // its own section. On Cancel, both originals stay where they are.
    // The base's defaultDelta is captured here at launch so the merged
    // chart inherits it; title + blurb get pre-filled on the modal
    // inputs directly so the user can still edit them before Create.
    pendingMerge: {
      baseChartId: string;
      baseSecIdx: number;
      baseChartIdx: number;
      baseDefaultDelta: DeltaWindow | undefined;
      draggedChartId: string;
      draggedSecIdx: number;
      draggedChartIdx: number;
    } | null;
  }
  const ccModal: CustomChartModalState = {
    editingId: null,
    title: "",
    selected: new Set<string>(),
    selectedOrder: [],
    search: "",
    mode: "raw",
    modeIsExplicit: false,
    rightAxisSources: new Set<string>(),
    op: null,
    blurb: "",
    logScale: false,
    pickerTags: new Set<string>(),
    cdState: null,
    cdDistrict: null,
    geo: newGeoState(),
    percentDisplay: undefined,
    pendingMerge: null,
  };

  // True when every selected source shares the same formatting style + unit
  // (e.g. all percent / all USD-per-barrel) — they can be plotted on one axis
  // legibly without rebasing.
  function ccSelectedSharesScale(): boolean {
    if (!library) return false;
    const ids = [...ccModal.selected];
    if (ids.length < 2) return true;
    const first = library.sources[ids[0]] as
      | { formatting?: { style?: string }; unit?: string }
      | undefined;
    if (!first) return false;
    return ids.every((id) => {
      const s = library!.sources[id] as
        | { formatting?: { style?: string }; unit?: string }
        | undefined;
      return (
        !!s &&
        s.formatting?.style === first.formatting?.style &&
        s.unit === first.unit
      );
    });
  }

  function ccDefaultMode(): CustomChartMode {
    const n = ccModal.selected.size;
    if (n <= 1) return "raw";
    return ccSelectedSharesScale() ? "raw" : "rebase";
  }

  function openCustomChartModal(editingId?: string): void {
    const existing =
      editingId && state.inlineCharts[editingId]
        ? state.inlineCharts[editingId]
        : null;
    ccModal.editingId = existing ? (editingId as string) : null;
    ccModal.title = existing?.title ?? "";
    ccModal.selected = new Set<string>(existing?.sources ?? []);
    ccModal.selectedOrder = [...(existing?.sources ?? [])];
    ccModal.op = (existing?.op as ChartCombineOp | undefined) ?? null;
    ccModal.search = "";
    if (existing?.normalize) {
      ccModal.mode = existing.normalize as CustomChartMode;
      ccModal.modeIsExplicit = true;
    } else {
      ccModal.modeIsExplicit = false;
      ccModal.mode = ccDefaultMode();
    }
    ccModal.rightAxisSources = new Set<string>(
      existing?.rightAxisSources ?? [],
    );
    // Restore the log-scale flag from the saved spec; falls back to false
    // (linear) which is the safe default for any value distribution.
    ccModal.logScale =
      (existing as { scale?: string } | null)?.scale === "log";
    ccModal.blurb = existing?.blurb ?? "";
    ccModal.percentDisplay = (existing as { percentDisplay?: "percent" | "decimal" | "ratio" } | null)
      ?.percentDisplay;
    // Fresh tag-chip filter each time the modal opens. The user's prior
    // selection on a previous chart's compose session isn't relevant.
    ccModal.pickerTags = new Set<string>();
    ccModal.cdState = null;
    ccModal.cdDistrict = null;
    // Fresh geo state per open; pre-select for an editing chart that
    // already references a metro / country source, same logic as CD below.
    ccModal.geo = newGeoState();
    for (const sid of ccModal.selected) {
      const tags = (library?.sources[sid] as { tags?: string[] } | undefined)?.tags ?? [];
      for (const t of tags) {
        if (t.startsWith(`${METRO_TAG}:`) && !ccModal.geo.selectedMetroCbsa) {
          ccModal.geo.selectedMetroCbsa = t.slice(METRO_TAG.length + 1);
        }
        if (t.startsWith(`${COUNTRY_TAG}:`) && !ccModal.geo.selectedCountryCode) {
          ccModal.geo.selectedCountryCode = t.slice(COUNTRY_TAG.length + 1);
        }
      }
    }
    // Always reset pendingMerge here — only openMergeModal sets it, and
    // we don't want a previous merge that was cancelled to leak into
    // the next normal open.
    ccModal.pendingMerge = null;
    // If the chart being edited already references geo sources (CDs or
    // state-level), auto-engage the States & districts chip + pin the
    // state filter. Otherwise the user would open the modal and not see
    // their own already-selected geo sources in the picker list — they'd
    // be filtered out by the default-hide rule and there'd be no obvious
    // way to uncheck them. If multiple states are represented, we pick
    // the first encountered; the user can flip states from the dropdown.
    let firstGeoState: string | null = null;
    let firstGeoIsStateLevel = false;
    for (const sid of ccModal.selected) {
      const cd = parseCdSourceId(sid);
      if (cd) {
        firstGeoState = cd.state;
        break;
      }
      const st = parseStateSourceId(sid);
      if (st) {
        firstGeoState = st.state;
        firstGeoIsStateLevel = true;
        break;
      }
    }
    if (firstGeoState) {
      ccModal.pickerTags.add(CD_TAG);
      ccModal.cdState = firstGeoState;
      // If all the user's geo picks are state-level, pre-narrow the
      // district dropdown to "Statewide" so the picked sources are
      // immediately visible in the list rather than buried under CDs.
      let allStateLevel = true;
      for (const sid of ccModal.selected) {
        if (parseCdSourceId(sid)) {
          allStateLevel = false;
          break;
        }
      }
      if (firstGeoIsStateLevel && allStateLevel) {
        ccModal.cdDistrict = STATEWIDE_DISTRICT_CODE;
      }
    }

    const backdrop = shell.querySelector<HTMLElement>("[data-role='cc-modal']");
    if (!backdrop) return;
    backdrop.hidden = false;
    const heading = shell.querySelector<HTMLElement>("#cc-modal-title");
    if (heading) heading.textContent = existing ? "Edit chart" : "New custom chart";
    const createBtn = shell.querySelector<HTMLButtonElement>("[data-role='cc-create']");
    if (createBtn) createBtn.textContent = existing ? "Save changes" : "Create chart";
    const titleInput = shell.querySelector<HTMLInputElement>("[data-role='cc-title']");
    if (titleInput) {
      titleInput.value = ccModal.title;
      titleInput.focus();
    }
    const searchInput = shell.querySelector<HTMLInputElement>("[data-role='cc-source-search']");
    if (searchInput) searchInput.value = "";
    const blurbInput = shell.querySelector<HTMLTextAreaElement>(
      "[data-role='cc-blurb']",
    );
    if (blurbInput) blurbInput.value = ccModal.blurb;
    syncModeRadioFromState();
    syncLogUI();
    syncOpUI();
    renderCcModalTagChips();
    // Geo-chip strip: render all three chips reflecting modal state,
    // wire event handlers idempotently (wireGeoChips guards via
    // dataset.wired).
    renderMetroChip("cc");
    renderCdChip("cc");
    renderCountryChip("cc");
    wireGeoChips("cc");
    renderCustomChartSources();
    updateCustomChartCreateState();
    renderCustomChartPreview();
  }

  function renderCcModalTagChips(): void {
    renderModalTagChips(
      "[data-role='cc-source-tags']",
      ccModal.pickerTags,
      () => {
        renderCcModalTagChips();
        renderCustomChartSources();
      },
      {
        getState: () => ccModal.cdState,
        setState: (v) => {
          ccModal.cdState = v;
        },
        getDistrict: () => ccModal.cdDistrict,
        setDistrict: (v) => {
          ccModal.cdDistrict = v;
        },
      },
    );
  }

  // Reflect ccModal.logScale + mode onto the log-scale checkbox: log is
  // exclusive with dual-axis, so the checkbox is forced unchecked + disabled
  // whenever dual-axis is the active mode.
  function syncLogUI(): void {
    const cb = shell.querySelector<HTMLInputElement>("[data-role='cc-log']");
    const wrap = shell.querySelector<HTMLElement>("[data-role='cc-log-wrap']");
    if (!cb || !wrap) return;
    const isDual = ccModal.mode === "dual-axis";
    if (isDual && ccModal.logScale) {
      // Mode-change made log invalid; clear the state flag so it doesn't
      // re-engage if the user flips back to raw/rebase.
      ccModal.logScale = false;
    }
    cb.disabled = isDual;
    cb.checked = ccModal.logScale && !isDual;
    wrap.classList.toggle("cc-log-opt-disabled", isDual);
  }

  // Reflect ccModal.op + selected count onto the operation UI: enable
  // when 2 sources picked, fill in the dropdown value, render the A/B
  // hint, toggle Swap visibility.
  function syncPercentDisplayUI(): void {
    const wrap = shell.querySelector<HTMLElement>(
      "[data-role='cc-percent-display-wrap']",
    );
    const select = shell.querySelector<HTMLSelectElement>(
      "[data-role='cc-percent-display-select']",
    );
    if (!wrap || !select) return;
    // Visible only when the chart's combine output COULD be percent
    // — op = divide on exactly 2 sources. Doesn't gate on unitClass
    // match (would require resolving derived sources); the dropdown
    // is a no-op when the output isn't percent anyway.
    wrap.hidden = !(ccModal.op === "divide" && ccModal.selected.size === 2);
    // "percent" is the default; undefined means default.
    select.value = ccModal.percentDisplay ?? "percent";
  }

  function syncOpUI(): void {
    const wrap = shell.querySelector<HTMLElement>("[data-role='cc-op-wrap']");
    const sel = shell.querySelector<HTMLSelectElement>("[data-role='cc-op-select']");
    const hint = shell.querySelector<HTMLElement>("[data-role='cc-op-hint']");
    const swap = shell.querySelector<HTMLButtonElement>("[data-role='cc-op-swap']");
    if (!wrap || !sel || !hint || !swap) return;
    syncPercentDisplayUI();
    // Show Combine UI any time we have at least 2 selected sources.
    wrap.hidden = ccModal.selected.size < 2;
    if (ccModal.selected.size !== 2) {
      // Op needs exactly 2 sources. Disable but show the wrap if 2+ so
      // the user knows the option exists.
      sel.disabled = ccModal.selected.size !== 2;
    } else {
      sel.disabled = false;
    }
    sel.value = ccModal.op ?? "";
    if (ccModal.op && ccModal.selectedOrder.length === 2) {
      const [aId, bId] = ccModal.selectedOrder;
      const aLabel = library?.sources[aId]?.shortName ?? library?.sources[aId]?.name ?? aId;
      const bLabel = library?.sources[bId]?.shortName ?? library?.sources[bId]?.name ?? bId;
      const symbol = ccModal.op === "divide" ? "÷" : ccModal.op === "sum" ? "+" : "−";
      hint.textContent = `A: ${aLabel}   B: ${bLabel}   →   ${aLabel} ${symbol} ${bLabel}`;
      swap.hidden = false;
    } else {
      hint.textContent = ccModal.selected.size > 2
        ? "Combine requires exactly 2 sources."
        : "";
      swap.hidden = true;
    }
  }

  // Reflect ccModal.mode + selected-source count onto the radio inputs:
  // toggle the dual-axis option's enabled state and check the right radio.
  function syncModeRadioFromState(): void {
    const raw = shell.querySelector<HTMLInputElement>("[data-role='cc-mode-raw']");
    const reb = shell.querySelector<HTMLInputElement>("[data-role='cc-mode-rebase']");
    const rebWrap = shell.querySelector<HTMLElement>("[data-role='cc-mode-rebase-wrap']");
    const dual = shell.querySelector<HTMLInputElement>("[data-role='cc-mode-dual']");
    const dualWrap = shell.querySelector<HTMLElement>("[data-role='cc-mode-dual-wrap']");
    // Both rebase and dual-axis are multi-series concepts: with one source,
    // rebase is just a single line indexed to 100 (no comparison) and
    // dual-axis needs two series to assign to L/R. Disable both until 2+.
    const allowMulti = ccModal.selected.size >= 2;
    if (reb) reb.disabled = !allowMulti;
    if (rebWrap) rebWrap.classList.toggle("cc-mode-opt-disabled", !allowMulti);
    if (dual) dual.disabled = !allowMulti;
    if (dualWrap) dualWrap.classList.toggle("cc-mode-opt-disabled", !allowMulti);
    if (raw) raw.checked = ccModal.mode === "raw";
    if (reb) reb.checked = ccModal.mode === "rebase" && allowMulti;
    if (dual) dual.checked = ccModal.mode === "dual-axis" && allowMulti;
  }

  // For dual-axis with no explicit assignment, default the first picked
  // source to left and everything else to right.
  function defaultRightAxisSources(): Set<string> {
    const ids = [...ccModal.selected];
    if (ids.length < 2) return new Set();
    return new Set(ids.slice(1));
  }

  // Returns the current right-axis assignment, falling back to the default
  // split when the explicit set is empty (initial state for fresh dual-axis).
  function effectiveRightAxisSources(): Set<string> {
    if (ccModal.rightAxisSources.size > 0) return ccModal.rightAxisSources;
    return defaultRightAxisSources();
  }

  // Launch the cc-modal in "merge a single-source chart into another
  // chart" mode. The dragged end MUST be single-source (the caller is
  // expected to have checked); the base can have any number of sources
  // and the merged chart contains base.sources ∪ {dragged.source}. The
  // base contributes its title / blurb / defaultDelta to the merged
  // chart; the dragged contributes only its source. Both originals stay
  // in the dashboard until Create is clicked — Cancel leaves the
  // dashboard exactly as it was before the merge attempt started.
  function openMergeModal(
    base: { chartId: string; secIdx: number; chartIdx: number },
    dragged: { chartId: string; secIdx: number; chartIdx: number },
  ): void {
    const baseSpec = chartEffectiveSpec(base.chartId);
    const draggedSpec = chartEffectiveSpec(dragged.chartId);
    if (draggedSpec.sources.length !== 1 || baseSpec.sources.length === 0) {
      // Defensive — caller should have checked, but bail rather than open
      // a misleading modal.
      return;
    }
    const draggedSource = draggedSpec.sources[0];
    if (baseSpec.sources.includes(draggedSource)) return; // duplicate-skip

    // Stamp the tip as seen — the user has discovered the feature.
    if (!isHoverMergeTipDismissed()) {
      dismissHoverMergeTip();
      // Re-render so the tip line goes away immediately on first use.
      // No-op if the tip wasn't rendered (e.g. already-dismissed users).
      renderComposition();
    }

    // Drive the modal through openCustomChartModal so all the standard
    // input wiring + render hooks run, then layer on the merge-specific
    // state. Pass no editingId so it opens in create mode.
    openCustomChartModal();
    // Base's metadata becomes the merged chart's metadata — but when the
    // base is a single-source chart whose title the user never customized,
    // recompose the title from the two sources so the merged tile reads
    // as a sensible combo ("VA-08 spending + WTI crude") instead of
    // inheriting a now-misleading single-source label.
    if (baseSpec.sources.length === 1 && baseTitleIsDefault(base.chartId)) {
      const baseSrcMeta = library?.sources[baseSpec.sources[0]] as
        | { name?: string; shortName?: string }
        | undefined;
      const draggedSrcMeta = library?.sources[draggedSource] as
        | { name?: string; shortName?: string }
        | undefined;
      const baseLabel =
        baseSrcMeta?.shortName ??
        baseSrcMeta?.name ??
        baseSpec.sources[0];
      const draggedLabel =
        draggedSrcMeta?.shortName ??
        draggedSrcMeta?.name ??
        draggedSource;
      ccModal.title = `${baseLabel} + ${draggedLabel}`;
    } else {
      ccModal.title = baseSpec.title;
    }
    ccModal.blurb = baseSpec.blurb ?? "";
    // Source order: keep base's existing order, then append dragged. This
    // preserves any (left,right) axis intent the base had — left-axis
    // sources stay in their leading slots, dragged becomes the new
    // trailing series. The user can rearrange via the modal's Swap (for
    // 2-source layouts) or the cc-modal source list ordering.
    const mergedSources = [...baseSpec.sources, draggedSource];
    ccModal.selected = new Set<string>(mergedSources);
    ccModal.selectedOrder = mergedSources;
    // Carry the base's rightAxis / normalize / scale forward so a user who
    // had carefully set up a dual-axis chart and is just adding a third
    // series doesn't lose their picks. We then re-evaluate dual-axis
    // viability below, since 3+ sources on a dual-axis chart may be
    // intentional but defaulting it off forces a recheck.
    if (isInlineId(base.chartId)) {
      const baseInline = state.inlineCharts[base.chartId];
      if (baseInline) {
        ccModal.mode = (baseInline.normalize as CustomChartMode | undefined) ?? "raw";
        ccModal.modeIsExplicit = !!baseInline.normalize;
        ccModal.rightAxisSources = new Set<string>(
          baseInline.rightAxisSources ?? [],
        );
        ccModal.logScale = baseInline.scale === "log";
      }
    }
    // If the base was dual-axis (a 2-series concern by design), adding a
    // 3rd source via merge isn't unambiguous — recompute a default mode
    // for the new mix rather than carry an awkward dual-axis forward. The
    // user can re-engage dual-axis explicitly inside the modal if they
    // actually want a 3-on-axes split.
    if (ccModal.mode === "dual-axis" && mergedSources.length > 2) {
      ccModal.mode = ccDefaultMode();
      ccModal.modeIsExplicit = false;
      ccModal.rightAxisSources = new Set<string>();
    }
    ccModal.pendingMerge = {
      baseChartId: base.chartId,
      baseSecIdx: base.secIdx,
      baseChartIdx: base.chartIdx,
      baseDefaultDelta: baseSpec.defaultDelta,
      draggedChartId: dragged.chartId,
      draggedSecIdx: dragged.secIdx,
      draggedChartIdx: dragged.chartIdx,
    };
    // Update the title input + blurb textarea to reflect the seeded state.
    const titleInput = shell.querySelector<HTMLInputElement>(
      "[data-role='cc-title']",
    );
    if (titleInput) titleInput.value = ccModal.title;
    const blurbInput = shell.querySelector<HTMLTextAreaElement>(
      "[data-role='cc-blurb']",
    );
    if (blurbInput) blurbInput.value = ccModal.blurb;
    const heading = shell.querySelector<HTMLElement>("#cc-modal-title");
    if (heading) {
      heading.textContent = `Combine: ${baseSpec.title} + ${draggedSpec.title}`;
    }
    const createBtn = shell.querySelector<HTMLButtonElement>(
      "[data-role='cc-create']",
    );
    if (createBtn) createBtn.textContent = "Combine charts";
    // Reflect the seeded source selection in the source list + controls.
    syncModeRadioFromState();
    syncLogUI();
    syncOpUI();
    renderCcModalTagChips();
    renderCustomChartSources();
    updateCustomChartCreateState();
    renderCustomChartPreview();
    track("compose_hover_merge_launched", {
      baseChartId: base.chartId,
      draggedChartId: dragged.chartId,
      baseSourceCount: baseSpec.sources.length,
      sources: packSourceIds(mergedSources),
    });
  }

  function closeCustomChartModal(): void {
    const backdrop = shell.querySelector<HTMLElement>("[data-role='cc-modal']");
    if (backdrop) backdrop.hidden = true;
    // Closing the modal — whether via Cancel, ×, ESC, or backdrop click —
    // clears any pending merge so a subsequent "+ Custom chart" doesn't
    // pick it back up. The Create handler clears pendingMerge before
    // closing on its own success path, so this is the cancel-side reset.
    ccModal.pendingMerge = null;
  }

  function updateCustomChartCreateState(): void {
    const btn = shell.querySelector<HTMLButtonElement>("[data-role='cc-create']");
    const count = shell.querySelector<HTMLElement>("[data-role='cc-count']");
    if (count) {
      const n = ccModal.selected.size;
      count.textContent = `${n} selected`;
    }
    if (btn) {
      // Title isn't required — an empty title gets a "Unnamed chart"
      // default on submit. Only source-picking is mandatory.
      const missingSources = ccModal.selected.size === 0;
      btn.disabled = missingSources;
      if (missingSources) {
        btn.title = "Pick at least one source first.";
      } else {
        btn.removeAttribute("title");
      }
    }
  }

  function filteredModalSources(): (LibrarySource & { tags?: string[] })[] {
    if (!library) return [];
    const q = ccModal.search.trim().toLowerCase();
    // Same exclusion as filteredSources: CD_TAG is the chip's master flag
    // (gated by passesCdFilter), not a literal source tag.
    const tagsRequired = [...ccModal.pickerTags].filter((t) => t !== CD_TAG);
    // Inject derived sources at the top of the universe so the user sees
    // their own creations before the firehose of library sources. Each
    // derived source carries its inherited+custom tag set so the
    // picker-tags filter works uniformly.
    const derivedAsLib: (LibrarySource & { tags?: string[] })[] = Object.entries(
      state.inlineSources,
    ).map(
      ([id, spec]) => ({
        id,
        name: spec.name,
        shortName: spec.name,
        description: `Derived: ${describeDerivedExpr(id)}`,
        tags: spec.tags ?? [],
      } as LibrarySource & { tags?: string[] }),
    );
    const all: (LibrarySource & { tags?: string[]; searchText?: string })[] = [
      ...derivedAsLib,
      ...Object.values(library.sources),
    ];
    return all.filter((s) => {
      const sTags = s.tags ?? [];
      // CD-visibility gate, mirroring filteredSources(). Derived sources
      // never have the CD_TAG (we don't synthesize it onto inline-source
      // tag sets), so they're always exempt from this filter regardless
      // of cc-modal CD state — derived sources stay visible.
      if (
        !passesCdFilter(
          s.id,
          sTags,
          ccModal.pickerTags,
          ccModal.cdState,
          ccModal.cdDistrict,
        )
      ) {
        return false;
      }
      // Metro / country chip drill-downs, mirroring filteredSources()
      // on the Sources tab. When a country (or metro) is selected, the
      // source MUST carry that entity's tag — everything else is
      // excluded, US-focused sources included. When NO entity is
      // selected, the source must not carry the master COUNTRY_TAG /
      // METRO_TAG (those stay hidden until the user opts in).
      if (ccModal.geo.selectedMetroCbsa) {
        const tag = `${METRO_TAG}:${ccModal.geo.selectedMetroCbsa}`;
        if (!sTags.includes(tag)) return false;
      } else if (sTags.includes(METRO_TAG)) {
        return false;
      }
      if (ccModal.geo.selectedCountryCode) {
        const tag = `${COUNTRY_TAG}:${ccModal.geo.selectedCountryCode}`;
        if (!sTags.includes(tag)) return false;
      } else if (sTags.includes(COUNTRY_TAG)) {
        return false;
      }
      for (const t of tagsRequired) {
        if (!sTags.includes(t)) return false;
      }
      if (q) {
        const hay =
          s.searchText ??
          `${s.name} ${s.shortName ?? ""} ${s.description ?? ""} ${s.id} ${sTags.join(" ")}`.toLowerCase();
        if (!hay.includes(q)) return false;
      }
      return true;
    });
  }

  // Render a chain of derived combinations as a string, recursively.
  function describeDerivedExpr(id: string): string {
    if (!isDerivedId(id)) {
      const s = library?.sources[id];
      return s?.shortName ?? s?.name ?? id;
    }
    const spec = state.inlineSources[id];
    if (!spec) return id;
    const symbol = spec.op === "divide" ? "÷" : spec.op === "sum" ? "+" : "−";
    return `${describeDerivedExpr(spec.a)} ${symbol} ${describeDerivedExpr(spec.b)}`;
  }

  function renderCustomChartSources(): void {
    const host = shell.querySelector<HTMLElement>("[data-role='cc-source-list']");
    if (!host) return;
    const sources = filteredModalSources();
    host.innerHTML = "";
    if (sources.length === 0) {
      host.innerHTML = '<p class="muted small">No sources match.</p>';
      return;
    }
    // Sort alphabetically by display name so the list stays predictable under search.
    sources.sort((a, b) => (a.shortName ?? a.name).localeCompare(b.shortName ?? b.name));
    for (const s of sources) {
      const row = document.createElement("label");
      row.className = "cc-source-row";
      const cb = document.createElement("input");
      cb.type = "checkbox";
      cb.checked = ccModal.selected.has(s.id);
      cb.addEventListener("change", () => {
        if (cb.checked) {
          ccModal.selected.add(s.id);
          if (!ccModal.selectedOrder.includes(s.id))
            ccModal.selectedOrder.push(s.id);
        } else {
          ccModal.selected.delete(s.id);
          ccModal.selectedOrder = ccModal.selectedOrder.filter((id) => id !== s.id);
        }
        // If user hasn't explicitly picked a mode, auto-default from scale
        // heuristics whenever the source set changes. If they have, keep
        // their pick — but flip rebase or dual-axis off when no longer 2+
        // sources, since neither concept is meaningful with a single series.
        if (!ccModal.modeIsExplicit) {
          ccModal.mode = ccDefaultMode();
        } else if (
          (ccModal.mode === "dual-axis" || ccModal.mode === "rebase") &&
          ccModal.selected.size < 2
        ) {
          ccModal.mode = "raw";
          ccModal.modeIsExplicit = false;
        }
        // Strip rightAxis assignment for sources that just got unchecked.
        if (!cb.checked) ccModal.rightAxisSources.delete(s.id);
        // Op requires exactly 2 sources; clear if no longer applicable.
        if (ccModal.op && ccModal.selected.size !== 2) {
          ccModal.op = null;
        }
        syncModeRadioFromState();
        syncLogUI();
        syncOpUI();
        updateCustomChartCreateState();
        renderCustomChartSources();
        renderCustomChartPreview();
      });
      row.appendChild(cb);
      const text = document.createElement("span");
      text.className = "cc-source-row-text";
      const primary = s.shortName ?? s.name;
      const secondary = s.shortName && s.shortName !== s.name ? s.name : "";
      text.innerHTML =
        `<span class="cc-source-primary">${escapeHtml(primary)}</span>` +
        (secondary ? `<span class="cc-source-secondary">${escapeHtml(secondary)}</span>` : "");
      row.appendChild(text);
      // Per-source L|R axis pill, only when dual-axis mode + this source is picked.
      if (ccModal.mode === "dual-axis" && ccModal.selected.has(s.id)) {
        const effRight = effectiveRightAxisSources();
        const isRight = effRight.has(s.id);
        const axisWrap = document.createElement("span");
        axisWrap.className = "cc-source-axis";
        const lBtn = document.createElement("button");
        lBtn.type = "button";
        lBtn.className = "cc-axis-pill" + (!isRight ? " cc-axis-pill-active" : "");
        lBtn.textContent = "L";
        lBtn.title = "Plot on the left axis";
        const rBtn = document.createElement("button");
        rBtn.type = "button";
        rBtn.className = "cc-axis-pill" + (isRight ? " cc-axis-pill-active" : "");
        rBtn.textContent = "R";
        rBtn.title = "Plot on the right axis";
        const setSide = (right: boolean, e: Event) => {
          e.preventDefault();
          e.stopPropagation();
          // Materialize the effective default into the explicit set the
          // first time the user touches an axis pill.
          if (ccModal.rightAxisSources.size === 0) {
            ccModal.rightAxisSources = new Set(effectiveRightAxisSources());
          }
          if (right) ccModal.rightAxisSources.add(s.id);
          else ccModal.rightAxisSources.delete(s.id);
          renderCustomChartSources();
          renderCustomChartPreview();
        };
        lBtn.addEventListener("click", (e) => setSide(false, e));
        rBtn.addEventListener("click", (e) => setSide(true, e));
        axisWrap.appendChild(lBtn);
        axisWrap.appendChild(rBtn);
        row.appendChild(axisWrap);
      }
      host.appendChild(row);
    }
  }

  // ---- Custom-chart preview rendering ----
  // Cache fetched source-data JSON by source ID so toggling sources doesn't
  // refetch. Cleared lazily — small payloads, page-scoped.
  type SeriesPoint = { t: string; v: number };
  type FetchedSeries = {
    id: string;
    name: string;
    points: SeriesPoint[];
  };
  const sourceDataCache: Map<string, Promise<FetchedSeries | null>> = new Map();

  // Modest palette echoing the chart-tile colors. Cycles for >8 sources.
  const CC_COLORS = [
    "#2563eb",
    "#dc2626",
    "#16a34a",
    "#9333ea",
    "#ea580c",
    "#0891b2",
    "#db2777",
    "#65a30d",
  ];

  async function fetchSourceSeries(sourceId: string): Promise<FetchedSeries | null> {
    if (sourceDataCache.has(sourceId)) return sourceDataCache.get(sourceId)!;
    const promise = (async () => {
      // Derived path: recursively fetch A and B, combine via op.
      if (isDerivedId(sourceId)) {
        const spec = state.inlineSources[sourceId];
        if (!spec) return null;
        const [a, b] = await Promise.all([
          fetchSourceSeries(spec.a),
          fetchSourceSeries(spec.b),
        ]);
        if (!a || !b) return null;
        const aMap = new Map<string, number>();
        for (const p of a.points) aMap.set(p.t, p.v);
        const bMap = new Map<string, number>();
        for (const p of b.points) bMap.set(p.t, p.v);
        const all = new Set<string>();
        for (const p of a.points) all.add(p.t);
        for (const p of b.points) all.add(p.t);
        const ordered = [...all].sort();
        let lastA: number | null = null;
        let lastB: number | null = null;
        const out: SeriesPoint[] = [];
        for (const t of ordered) {
          if (aMap.has(t)) lastA = aMap.get(t)!;
          if (bMap.has(t)) lastB = bMap.get(t)!;
          if (lastA === null || lastB === null) continue;
          let v: number;
          if (spec.op === "divide") {
            if (lastB === 0) continue;
            v = lastA / lastB;
          } else if (spec.op === "sum") {
            v = lastA + lastB;
          } else {
            v = lastA - lastB;
          }
          out.push({ t, v });
        }
        if (out.length === 0) return null;
        return { id: sourceId, name: spec.name, points: out };
      }
      const lib = library;
      const meta = lib?.sources[sourceId];
      if (!lib || !meta) return null;
      const rawPath = (meta as any).dataFile as string | undefined;
      if (!rawPath) return null;
      const url = `${baseUrl}/${rawPath.replace(/^\//, "")}`;
      try {
        const r = await fetch(url);
        if (!r.ok) return null;
        const json = await r.json();
        const points: SeriesPoint[] = Array.isArray(json?.points)
          ? (json.points as SeriesPoint[]).filter(
              (p) => p && typeof p.t === "string" && typeof p.v === "number",
            )
          : [];
        if (points.length === 0) return null;
        return { id: sourceId, name: meta.shortName ?? meta.name, points };
      } catch {
        return null;
      }
    })();
    sourceDataCache.set(sourceId, promise);
    return promise;
  }

  // Counter so a slow fetch from a stale modal state doesn't render over a
  // newer one when the user rapidly toggles sources.
  let ccPreviewToken = 0;

  async function renderCustomChartPreview(): Promise<void> {
    const plotHost = shell.querySelector<HTMLElement>("[data-role='cc-preview-plot']");
    const statusEl = shell.querySelector<HTMLElement>("[data-role='cc-preview-status']");
    const legendEl = shell.querySelector<HTMLElement>("[data-role='cc-preview-legend']");
    if (!plotHost || !statusEl || !legendEl) return;
    const token = ++ccPreviewToken;
    const ids = [...ccModal.selected];
    if (ids.length === 0) {
      plotHost.replaceChildren();
      legendEl.innerHTML = "";
      statusEl.textContent = "Pick a source to preview.";
      return;
    }
    statusEl.textContent = "Loading…";
    // Use selectedOrder so the user's explicit A/B order is honored when op
    // is set. Fall back to selection iteration order otherwise.
    const orderedIds = ccModal.selectedOrder.filter((id) =>
      ccModal.selected.has(id),
    );
    for (const id of ccModal.selected) {
      if (!orderedIds.includes(id)) orderedIds.push(id);
    }
    const series = (
      await Promise.all(orderedIds.map((id) => fetchSourceSeries(id)))
    ).filter((s): s is FetchedSeries => s !== null);
    if (token !== ccPreviewToken) return; // stale render

    if (series.length === 0) {
      plotHost.replaceChildren();
      legendEl.innerHTML = "";
      statusEl.textContent = "Couldn't load data for the selected sources.";
      return;
    }

    // Op short-circuit: if 2 sources + op set, collapse into a single
    // derived series and render as one line.
    if (ccModal.op && series.length === 2) {
      const a = series[0];
      const b = series[1];
      const aMap = new Map<string, number>();
      for (const p of a.points) aMap.set(p.t, p.v);
      const bMap = new Map<string, number>();
      for (const p of b.points) bMap.set(p.t, p.v);
      const all = new Set<string>();
      for (const p of a.points) all.add(p.t);
      for (const p of b.points) all.add(p.t);
      const ordered = [...all].sort();
      const combined: { t: Date; v: number }[] = [];
      let lastA: number | null = null;
      let lastB: number | null = null;
      for (const t of ordered) {
        if (aMap.has(t)) lastA = aMap.get(t)!;
        if (bMap.has(t)) lastB = bMap.get(t)!;
        if (lastA === null || lastB === null) continue;
        let v: number;
        if (ccModal.op === "divide") {
          if (lastB === 0) continue;
          v = lastA / lastB;
        } else if (ccModal.op === "sum") {
          v = lastA + lastB;
        } else {
          v = lastA - lastB;
        }
        combined.push({ t: new Date(t), v });
      }
      const symbol = ccModal.op === "divide" ? "÷" : ccModal.op === "sum" ? "+" : "−";
      statusEl.textContent = `${a.name} ${symbol} ${b.name}`;
      // Log scale on a derived single line is a legitimate ask (ratio of
      // market caps over decades, e.g.) so honor the checkbox here too.
      // Plot.lineY drops points where y ≤ 0 under log automatically, which
      // is fine — sums-that-go-negative or divisions-by-tiny-numbers will
      // simply not appear on the log view.
      const useLog = ccModal.logScale;
      const opPlot = Plot.plot({
        height: 220,
        width: plotHost.clientWidth || 360,
        marginLeft: 60,
        marginBottom: 24,
        marginTop: 8,
        marginRight: 12,
        style: {
          fontFamily:
            '"Inter Variable", Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif',
          fontSize: "11px",
          color: "#55524C",
          background: "transparent",
        },
        x: { label: null, ticks: 4 },
        y: {
          label: null,
          grid: true,
          ticks: 4,
          type: useLog ? "log" : undefined,
        },
        marks: [
          Plot.lineY(combined, {
            x: "t",
            y: "v",
            stroke: CC_COLORS[0],
            strokeWidth: 1.5,
          }),
        ],
      }) as HTMLElement;
      plotHost.replaceChildren(opPlot);
      legendEl.innerHTML = `<li><span class="cc-legend-dot" style="background:${CC_COLORS[0]}"></span><span>${escapeHtml(a.name)} ${symbol} ${escapeHtml(b.name)}</span></li>`;
      return;
    }
    // Effective mode for rendering: dual-axis needs at least 2 sources, and
    // both axes must end up with at least one series after partitioning.
    let mode: CustomChartMode = ccModal.mode;
    if (mode === "dual-axis") {
      if (series.length < 2) mode = "rebase";
      else {
        const eff = effectiveRightAxisSources();
        const rightCount = series.filter((s) => eff.has(s.id)).length;
        const leftCount = series.length - rightCount;
        if (rightCount === 0 || leftCount === 0) mode = "rebase";
      }
    }
    statusEl.textContent =
      `${series.length} series · ${mode === "dual-axis" ? "dual-axis" : mode === "rebase" ? "rebased to 100" : "raw"}`;

    const colored = series.map((s, i) => ({
      ...s,
      color: CC_COLORS[i % CC_COLORS.length],
    }));

    const width = plotHost.clientWidth || 360;
    const baseStyle = {
      fontFamily:
        '"Inter Variable", Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif',
      fontSize: "11px",
      color: "#55524C",
      background: "transparent",
    };

    let plot: HTMLElement;
    if (mode === "dual-axis") {
      const eff = effectiveRightAxisSources();
      const leftSeries = colored.filter((s) => !eff.has(s.id));
      const rightSeries = colored.filter((s) => eff.has(s.id));
      // Left domain: min/max across all left series. Right domain: same on
      // the right side. Right values are rescaled to fit the left domain
      // for plotting; the right axis's tickFormat un-rescales.
      const leftPts = leftSeries.flatMap((s) => s.points);
      const rightPts = rightSeries.flatMap((s) => s.points);
      const leftMin = Math.min(...leftPts.map((p) => p.v));
      const leftMax = Math.max(...leftPts.map((p) => p.v));
      const rightMin = Math.min(...rightPts.map((p) => p.v));
      const rightMax = Math.max(...rightPts.map((p) => p.v));
      const lRange = leftMax - leftMin || 1;
      const rRange = rightMax - rightMin || 1;
      const rescaleR = (v: number) =>
        leftMin + ((v - rightMin) / rRange) * lRange;
      const unrescaleR = (yPos: number) =>
        rightMin + ((yPos - leftMin) / lRange) * rRange;
      const marks: any[] = [];
      // A representative color per axis for the axis labels themselves: when
      // there's exactly one series on a side, use that series' color. With
      // multiple, use neutral so it doesn't claim allegiance to one line.
      const leftAxisColor =
        leftSeries.length === 1 ? leftSeries[0].color : "#55524C";
      const rightAxisColor =
        rightSeries.length === 1 ? rightSeries[0].color : "#55524C";
      for (const s of leftSeries) {
        const pts = s.points.map((p) => ({ t: new Date(p.t), v: p.v }));
        marks.push(
          Plot.lineY(pts, {
            x: "t",
            y: "v",
            stroke: s.color,
            strokeWidth: 1.4,
          }),
        );
      }
      for (const s of rightSeries) {
        const pts = s.points.map((p) => ({
          t: new Date(p.t),
          v: rescaleR(p.v),
        }));
        marks.push(
          Plot.lineY(pts, {
            x: "t",
            y: "v",
            stroke: s.color,
            strokeWidth: 1.4,
          }),
        );
      }
      marks.push(
        Plot.axisY({ anchor: "left", color: leftAxisColor, ticks: 4 }),
        Plot.axisY({
          anchor: "right",
          color: rightAxisColor,
          ticks: 4,
          tickFormat: (v: number) => unrescaleR(v).toFixed(2),
        }),
      );
      plot = Plot.plot({
        height: 220,
        width,
        marginLeft: 50,
        marginBottom: 24,
        marginTop: 8,
        marginRight: 50,
        style: baseStyle,
        x: { label: null, ticks: 4 },
        y: { label: null, grid: true, ticks: 4 },
        marks,
      }) as HTMLElement;
    } else {
      const marks: any[] = [];
      for (const s of colored) {
        const pts = s.points;
        if (pts.length < 2) continue;
        let plotPts: { t: Date; v: number }[];
        if (mode === "rebase") {
          const baseline = pts[0].v || 1;
          plotPts = pts.map((p) => ({
            t: new Date(p.t),
            v: (p.v / baseline) * 100,
          }));
        } else {
          plotPts = pts.map((p) => ({ t: new Date(p.t), v: p.v }));
        }
        marks.push(
          Plot.lineY(plotPts, {
            x: "t",
            y: "v",
            stroke: s.color,
            strokeWidth: 1.4,
          }),
        );
      }
      // Log scale only takes effect on the non-dual-axis branch (we
      // explicitly disallow log + dual-axis in the UI). We're already
      // inside the non-dual-axis branch here — TS has narrowed mode
      // to "raw" | "rebase" — so the previous `mode !== "dual-axis"`
      // guard was a tautology TS flagged. Keeping the comment as a
      // pointer for the parallel guard in the saved-spec branch.
      const useLog = ccModal.logScale;
      plot = Plot.plot({
        height: 220,
        width,
        marginLeft: 50,
        marginBottom: 24,
        marginTop: 8,
        marginRight: 12,
        style: baseStyle,
        x: { label: null, ticks: 4 },
        y: {
          label: mode === "rebase" ? "index (start = 100)" : null,
          grid: true,
          ticks: 4,
          type: useLog ? "log" : undefined,
        },
        marks,
      }) as HTMLElement;
    }
    plotHost.replaceChildren(plot);
    legendEl.innerHTML = colored
      .map(
        (s) =>
          `<li><span class="cc-legend-dot" style="background:${s.color}"></span><span>${escapeHtml(s.name)}</span></li>`,
      )
      .join("");
  }

  // ---- Derived-source modal ----
  // A derived source = A op B, where A and B can each be a real source ID
  // OR another derived source ID (recursive). Stored in state.inlineSources
  // keyed by `derived:<nanoid>`. Once created it appears in the source
  // picker for + Custom chart and as an A/B option for further derivation.

  interface DerivedModalState {
    name: string;
    op: "divide" | "sum" | "diff";
    a: string;
    b: string;
    aSearch: string;
    bSearch: string;
    // When true (default), creating the derived source also creates a
    // single-source inline chart in the current section. The "I want
    // X / Y as a tile right now" path is the dominant use case for
    // derived sources, so default on; user can opt out per-creation
    // when they're stockpiling sources for a multi-derive composition.
    addAsChart: boolean;
    // Shared tag-chip filter for both the A and B operand pickers.
    // Picking from related topics is the dominant case (Canada GDP ÷
    // US GDP — both "world", "macro"), so one shared filter strip
    // beats two separate ones. AND across selected tags. Cleared on
    // each open.
    pickerTags: Set<string>;
    // Congressional-district drill-down state shared by both pickers
    // (parallel to pickerTags). See CustomChartModalState for the
    // semantics; reset on each open.
    cdState: string | null;
    cdDistrict: string | null;
    // Metro + country drill-down state, mirroring libGeo / ccModal.geo.
    geo: GeoState;
  }
  const dsModal: DerivedModalState = {
    name: "",
    op: "divide",
    a: "",
    b: "",
    aSearch: "",
    bSearch: "",
    addAsChart: true,
    pickerTags: new Set<string>(),
    cdState: null,
    cdDistrict: null,
    geo: newGeoState(),
  };

  // Universe of pickable source IDs: every real source from library.json
  // plus every derived source already in state. Sorted: derived first
  // (so the user sees the ones they've created at the top), then real,
  // each block sorted by display name.
  function pickableSourceOptions(): { id: string; label: string; isDerived: boolean }[] {
    const derived = Object.entries(state.inlineSources).map(([id, spec]) => ({
      id,
      label: `${spec.name} (derived)`,
      isDerived: true,
    }));
    derived.sort((x, y) => x.label.localeCompare(y.label));
    const real = library
      ? Object.values(library.sources).map((s) => ({
          id: s.id,
          label: (s.shortName ?? s.name) + (s.shortName && s.shortName !== s.name ? ` — ${s.name}` : ""),
          isDerived: false,
        }))
      : [];
    real.sort((x, y) => x.label.localeCompare(y.label));
    return [...derived, ...real];
  }

  // Render one of the two source-picker lists (A or B) filtered by its
  // own search box. Clicking a row selects it. The currently-picked
  // source is highlighted; the other side's pick is marked dimly so the
  // user doesn't accidentally pick the same source twice.
  function renderDsPicker(side: "a" | "b"): void {
    const list = shell.querySelector<HTMLElement>(
      `[data-role='ds-${side}-list']`,
    );
    const current = shell.querySelector<HTMLElement>(
      `[data-role='ds-${side}-current']`,
    );
    if (!list) return;
    const search = (side === "a" ? dsModal.aSearch : dsModal.bSearch)
      .trim()
      .toLowerCase();
    // Same CD_TAG exclusion as the other two filter sites: it's a chip
    // toggle gated by passesCdFilter, not a literal tag-AND requirement.
    const tagsRequired = [...dsModal.pickerTags].filter((t) => t !== CD_TAG);
    const opts = pickableSourceOptions().filter((o) => {
      const oTags = sourceTagsFor(o.id);
      // CD-visibility gate runs first; derived sources lack CD_TAG so
      // they always pass through (consistent with cc-modal behavior).
      if (
        !passesCdFilter(
          o.id,
          oTags,
          dsModal.pickerTags,
          dsModal.cdState,
          dsModal.cdDistrict,
        )
      ) {
        return false;
      }
      // Metro + country chip drill-downs (mirrors cc-modal + Sources
      // tab). When an entity is selected, the source MUST carry that
      // tag — everything else is excluded, US-focused sources too.
      // When nothing's selected, the master metro/country-tagged
      // sources stay hidden.
      if (dsModal.geo.selectedMetroCbsa) {
        const tag = `${METRO_TAG}:${dsModal.geo.selectedMetroCbsa}`;
        if (!oTags.includes(tag)) return false;
      } else if (oTags.includes(METRO_TAG)) {
        return false;
      }
      if (dsModal.geo.selectedCountryCode) {
        const tag = `${COUNTRY_TAG}:${dsModal.geo.selectedCountryCode}`;
        if (!oTags.includes(tag)) return false;
      } else if (oTags.includes(COUNTRY_TAG)) {
        return false;
      }
      if (tagsRequired.length > 0) {
        for (const t of tagsRequired) {
          if (!oTags.includes(t)) return false;
        }
      }
      if (!search) return true;
      return (
        o.label.toLowerCase().includes(search) ||
        o.id.toLowerCase().includes(search) ||
        oTags.join(" ").toLowerCase().includes(search)
      );
    });
    list.innerHTML = "";
    if (opts.length === 0) {
      list.innerHTML = '<p class="muted small">No sources match.</p>';
    } else {
      const selectedId = side === "a" ? dsModal.a : dsModal.b;
      const otherId = side === "a" ? dsModal.b : dsModal.a;
      for (const o of opts) {
        const row = document.createElement("button");
        row.type = "button";
        row.className =
          "ds-source-row" +
          (o.id === selectedId ? " ds-source-row-selected" : "") +
          (o.id === otherId ? " ds-source-row-disabled" : "") +
          (o.isDerived ? " ds-source-row-derived" : "");
        row.textContent = o.label;
        if (o.id === otherId) {
          row.title = "Already picked on the other side";
          row.disabled = true;
        }
        row.addEventListener("click", () => {
          if (side === "a") dsModal.a = o.id;
          else dsModal.b = o.id;
          // Re-render both so the cross-disable state stays in sync.
          renderDsPicker("a");
          renderDsPicker("b");
          syncDerivedHint();
        });
        list.appendChild(row);
      }
    }
    if (current) {
      const id = side === "a" ? dsModal.a : dsModal.b;
      current.textContent = id ? `Picked: ${dsSourceLabel(id)}` : "No source picked yet.";
    }
  }

  function dsSourceLabel(id: string): string {
    if (!id) return "?";
    if (isDerivedId(id)) return state.inlineSources[id]?.name ?? id;
    const s = library?.sources[id];
    return s?.shortName ?? s?.name ?? id;
  }

  // Resolve the tag set of a single source ID. Real sources read from
  // library.json (populated by pipelines/backfill_source_tags.py).
  // Derived sources read from state.inlineSources[id].tags, which
  // itself was inherited from its own parents at creation time, so
  // arbitrary nesting flattens correctly without re-walking the tree.
  function sourceTagsFor(id: string): string[] {
    if (isDerivedId(id)) return state.inlineSources[id]?.tags ?? [];
    const s = library?.sources[id] as
      | (LibrarySource & { tags?: string[] })
      | undefined;
    return s?.tags ?? [];
  }

  // Derived sources' tag set = union(A.tags, B.tags) plus a "custom"
  // tag. Recursive derivation just works: when a derived source's
  // parent is itself derived, its tags already include "custom" + the
  // ancestor's parents' tags, so the union flattens correctly.
  function inheritedTagsForDerived(aId: string, bId: string): string[] {
    const s = new Set<string>([...sourceTagsFor(aId), ...sourceTagsFor(bId)]);
    s.add("custom");
    return [...s].sort();
  }

  // Union of every tag across the universe of pickable sources (library
  // + derived). The "custom" tag is implicitly only present when at
  // least one derived source exists (since that's where it comes from),
  // so we get the right "hide custom chip when there are no custom
  // sources" behavior for free.
  function allPickableSourceTags(): string[] {
    const s = new Set<string>();
    const addTag = (t: string) => {
      // Synthetic per-entity tags (metro:35620, country-specific:JPN, …)
      // never appear as standalone pills — they're surfaced through the
      // master chips' drilldowns instead. Strip them here so the chip
      // strip stays readable; the master METRO_TAG / COUNTRY_TAG values
      // themselves stay so renderModalTagChips can show a "Metros" /
      // "Countries" chip.
      if (t.startsWith(`${METRO_TAG}:`)) return;
      if (t.startsWith(`${COUNTRY_TAG}:`)) return;
      s.add(t);
    };
    if (library) {
      for (const id of Object.keys(library.sources)) {
        const src = library.sources[id] as LibrarySource & { tags?: string[] };
        for (const t of src.tags ?? []) addTag(t);
      }
    }
    for (const spec of Object.values(state.inlineSources)) {
      for (const t of spec.tags ?? []) addTag(t);
    }
    return [...s].sort();
  }

  // Generic chip-strip builder shared between the cc-modal source picker
  // and the ds-modal operand pickers. Caller supplies the active-tag
  // set + the re-render callback (different functions per modal). The
  // `congressional-district` tag is rendered specially as a drill-down
  // chip at the end of the strip (via appendCdDrillDown). Each modal
  // owns its own cdState / cdDistrict slot — the cdGetters bundle bridges
  // those state slots into this generic helper.
  function renderModalTagChips(
    hostSelector: string,
    selected: Set<string>,
    onToggle: () => void,
    _cdGetters: {
      getState: () => string | null;
      setState: (v: string | null) => void;
      getDistrict: () => string | null;
      setDistrict: (v: string | null) => void;
    },
  ): void {
    const host = shell.querySelector<HTMLElement>(hostSelector);
    if (!host) return;
    const tags = allPickableSourceTags();
    host.innerHTML = "";
    if (tags.length === 0) return;
    const makeChip = (tag: string, label: string, active: boolean) => {
      const b = document.createElement("button");
      b.type = "button";
      b.className = "tag-pill" + (active ? " tag-pill-active" : "");
      b.textContent = label;
      b.addEventListener("click", (e) => {
        e.preventDefault();
        if (tag === "") {
          selected.clear();
        } else if (selected.has(tag)) {
          selected.delete(tag);
        } else {
          selected.add(tag);
        }
        onToggle();
      });
      return b;
    };
    host.appendChild(makeChip("", "all", selected.size === 0));
    // CD / METRO / COUNTRY chips live in the geo-chips strip ABOVE this
    // row; topical tags only here. (See renderCdChip / renderMetroChip
    // / renderCountryChip + wireGeoChips for the geo strip wiring.)
    for (const t of tags) {
      if (t === CD_TAG || t === STATE_TAG) continue;
      if (t === METRO_TAG || t === COUNTRY_TAG) continue;
      host.appendChild(makeChip(t, t, selected.has(t)));
    }
  }

  // Equation-form name auto-derived from picked A, op, B. Used as both
  // the input's placeholder (so the user sees what they'll get if they
  // leave the field blank) and the fallback value on submit.
  function computeDerivedDefaultName(): string {
    if (!dsModal.a || !dsModal.b) return "";
    const symbol = dsModal.op === "divide" ? "÷" : dsModal.op === "sum" ? "+" : "−";
    return `${dsSourceLabel(dsModal.a)} ${symbol} ${dsSourceLabel(dsModal.b)}`;
  }

  function syncDerivedHint(): void {
    const hint = shell.querySelector<HTMLElement>("[data-role='ds-hint']");
    const create = shell.querySelector<HTMLButtonElement>("[data-role='ds-create']");
    const nameInput = shell.querySelector<HTMLInputElement>(
      "[data-role='ds-name']",
    );
    const defaultName = computeDerivedDefaultName();
    if (nameInput) {
      // Show the equation as the placeholder so the user sees what name
      // they'll get if they leave the field blank.
      nameInput.placeholder = defaultName || "e.g. Retail-gas / WTI";
    }
    if (hint) {
      const ready = !!(dsModal.a && dsModal.b && dsModal.a !== dsModal.b);
      hint.textContent = ready
        ? `→ ${dsModal.name.trim() || defaultName}`
        : !dsModal.a || !dsModal.b
          ? "Pick A and B."
          : dsModal.a === dsModal.b
            ? "A and B must be different."
            : "";
    }
    if (create) {
      const ready = !!(dsModal.a && dsModal.b && dsModal.a !== dsModal.b);
      create.disabled = !ready;
      if (!ready) {
        create.title = !dsModal.a || !dsModal.b
          ? "Pick A and B first."
          : "A and B must be different.";
      } else {
        create.removeAttribute("title");
      }
    }
  }

  function openDerivedSourceModal(): void {
    dsModal.name = "";
    dsModal.op = "divide";
    dsModal.a = "";
    dsModal.b = "";
    dsModal.aSearch = "";
    dsModal.bSearch = "";
    dsModal.addAsChart = true;
    dsModal.pickerTags = new Set<string>();
    dsModal.cdState = null;
    dsModal.cdDistrict = null;
    dsModal.geo = newGeoState();
    const backdrop = shell.querySelector<HTMLElement>("[data-role='ds-modal']");
    if (!backdrop) return;
    backdrop.hidden = false;
    const nameInput = shell.querySelector<HTMLInputElement>("[data-role='ds-name']");
    if (nameInput) {
      nameInput.value = "";
      // No initial focus on the name field — A/B picking is now the
      // primary action and the name fills in by itself.
    }
    const opSelect = shell.querySelector<HTMLSelectElement>("[data-role='ds-op']");
    if (opSelect) opSelect.value = "divide";
    const aSearch = shell.querySelector<HTMLInputElement>("[data-role='ds-a-search']");
    const bSearch = shell.querySelector<HTMLInputElement>("[data-role='ds-b-search']");
    if (aSearch) aSearch.value = "";
    if (bSearch) bSearch.value = "";
    const addAsChartChk = shell.querySelector<HTMLInputElement>(
      "[data-role='ds-add-as-chart']",
    );
    if (addAsChartChk) addAsChartChk.checked = true;
    // Clear any stale quick-divisor highlight from a prior open.
    shell
      .querySelectorAll<HTMLButtonElement>("[data-role='ds-quick']")
      .forEach((c) => c.classList.remove("ds-quick-chip-active"));
    renderDsModalTagChips();
    renderMetroChip("ds");
    renderCdChip("ds");
    renderCountryChip("ds");
    wireGeoChips("ds");
    renderDsPicker("a");
    renderDsPicker("b");
    syncDerivedHint();
  }

  function renderDsModalTagChips(): void {
    renderModalTagChips(
      "[data-role='ds-source-tags']",
      dsModal.pickerTags,
      () => {
        renderDsModalTagChips();
        renderDsPicker("a");
        renderDsPicker("b");
      },
      {
        getState: () => dsModal.cdState,
        setState: (v) => {
          dsModal.cdState = v;
        },
        getDistrict: () => dsModal.cdDistrict,
        setDistrict: (v) => {
          dsModal.cdDistrict = v;
        },
      },
    );
  }

  function closeDerivedSourceModal(): void {
    const backdrop = shell.querySelector<HTMLElement>("[data-role='ds-modal']");
    if (backdrop) backdrop.hidden = true;
  }

  function wireDerivedSourceModal(): void {
    const backdrop = shell.querySelector<HTMLElement>("[data-role='ds-modal']");
    const closeBtn = shell.querySelector<HTMLButtonElement>("[data-role='ds-close']");
    const cancelBtn = shell.querySelector<HTMLButtonElement>("[data-role='ds-cancel']");
    const createBtn = shell.querySelector<HTMLButtonElement>("[data-role='ds-create']");
    const nameInput = shell.querySelector<HTMLInputElement>("[data-role='ds-name']");
    const opSelect = shell.querySelector<HTMLSelectElement>("[data-role='ds-op']");
    const aSearch = shell.querySelector<HTMLInputElement>("[data-role='ds-a-search']");
    const bSearch = shell.querySelector<HTMLInputElement>("[data-role='ds-b-search']");

    closeBtn?.addEventListener("click", closeDerivedSourceModal);
    cancelBtn?.addEventListener("click", closeDerivedSourceModal);
    backdrop?.addEventListener("click", (e) => {
      if (e.target === backdrop) closeDerivedSourceModal();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape" || !backdrop || backdrop.hidden) return;
      closeDerivedSourceModal();
    });
    nameInput?.addEventListener("input", () => {
      dsModal.name = nameInput.value;
      syncDerivedHint();
    });
    opSelect?.addEventListener("change", () => {
      dsModal.op = opSelect.value as DerivedModalState["op"];
      syncDerivedHint();
    });
    aSearch?.addEventListener("input", () => {
      dsModal.aSearch = aSearch.value;
      renderDsPicker("a");
    });
    bSearch?.addEventListener("input", () => {
      dsModal.bSearch = bSearch.value;
      renderDsPicker("b");
    });
    const addAsChartChk = shell.querySelector<HTMLInputElement>(
      "[data-role='ds-add-as-chart']",
    );
    addAsChartChk?.addEventListener("change", () => {
      dsModal.addAsChart = addAsChartChk.checked;
    });
    // Quick-divisor chips: one-click pre-fill of op + B with a commonly
    // requested denominator (population / GDP / employment). The user
    // still picks A; the auto-name handles "A ÷ B" generation. We used
    // to also seed the name field with a template like "per capita",
    // but that clobbered the auto-name flow — "per capita" alone loses
    // the A's identity ("CA federal $ ÷ US population" beats just
    // "per capita"). Templates dropped; the chip only sets op + B now.
    const quickChips = shell.querySelectorAll<HTMLButtonElement>(
      "[data-role='ds-quick']",
    );
    quickChips.forEach((chip) => {
      chip.addEventListener("click", () => {
        const id = chip.dataset.divisorId ?? "";
        if (!id) return;
        dsModal.op = "divide";
        if (opSelect) opSelect.value = "divide";
        dsModal.b = id;
        // If the user had picked the same source as A, clear A — we
        // can't divide a source by itself, and the picker would mark
        // the row "Already picked on the other side" anyway.
        if (dsModal.a === id) dsModal.a = "";
        // Reflect the new active chip — primarily a visual cue that
        // the click registered (the rest of the UI updates too, but
        // the chip itself is what they just touched).
        quickChips.forEach((c) => c.classList.remove("ds-quick-chip-active"));
        chip.classList.add("ds-quick-chip-active");
        renderDsPicker("a");
        renderDsPicker("b");
        syncDerivedHint();
        // Funnel telemetry: which quick divisor wins? Useful for
        // deciding whether to add more (CPI, hours worked, etc.).
        track("compose_quick_divisor_picked", { divisor: id });
        if (aSearch) aSearch.focus();
      });
    });
    createBtn?.addEventListener("click", async () => {
      // Title is now optional — empty falls back to the auto-generated
      // "A {op} B" name. A and B still required and must differ.
      if (
        !dsModal.a ||
        !dsModal.b ||
        dsModal.a === dsModal.b
      )
        return;
      // Anon rate-limit gate. Derived-source creation draws from the
      // same per-IP budget as chart-adds — bot loops that generate
      // synthetic derived sources are the same threat shape as those
      // adding chart after chart.
      const allowed = await checkComposeAction("create_derived_source");
      if (!allowed) {
        closeDerivedSourceModal();
        showSigninPrompt("create_derived_source");
        return;
      }
      const effectiveName =
        dsModal.name.trim() || computeDerivedDefaultName();
      const id = DERIVED_PREFIX + nanoid(8);
      // Inherit parent tags + add "custom" so this new source shows up
      // under the custom-tag filter chip in the source picker (chip
      // only renders when at least one source has it; see Phase 5).
      const inheritedTags = inheritedTagsForDerived(dsModal.a, dsModal.b);
      state.inlineSources[id] = {
        op: dsModal.op,
        a: dsModal.a,
        b: dsModal.b,
        name: effectiveName,
        tags: inheritedTags,
      };
      // Optional auto-insert as a chart in the current section. The vast
      // majority of derived-source creations are "I want this ratio as a
      // tile now"; pre-checking the box and creating the chart here saves
      // the user from a follow-up trip through the cc-modal. Opt-out
      // covers the stockpiling-sources-for-later case.
      //
      // The auto-chart references BOTH parent sources with the op set,
      // not the freshly-created derived source. Same line either way
      // (combineTwo applied at render), but the multi-source-with-op
      // form preserves both component citations in the chart footer
      // and "Copy citation" output — feels more transparent than the
      // single-source-from-an-opaque-derived form.
      let autoChartCreated = false;
      if (dsModal.addAsChart) {
        clampActiveSection();
        const target = state.sections[activeSectionIdx];
        if (target) {
          const chartId = INLINE_PREFIX + nanoid(8);
          state.inlineCharts[chartId] = {
            title: effectiveName,
            sources: [dsModal.a, dsModal.b],
            normalize: "raw",
            op: dsModal.op,
          };
          target.charts.push(chartId);
          autoChartCreated = true;
        }
      }
      writeUrl();
      closeDerivedSourceModal();
      // Re-render the dashboard composition if we just appended a chart;
      // otherwise only the source-pickers need refreshing.
      if (autoChartCreated) renderComposition();
      // Refresh anything that lists sources (custom-chart modal, if open).
      renderCustomChartSources();
      // Funnel telemetry: derived sources are a power-user feature; tracking
      // op distribution tells us whether divide-ratios dominate (the case we
      // designed for) or sum/diff get real use. Including the operand source
      // IDs lets us spot common derived-source recipes (e.g. retail-gas/WTI).
      // `auto_chart` records whether the user opted into the "add as chart"
      // default — useful for tuning the default if usage skews the other way.
      track("compose_derived_source_created", {
        op: dsModal.op,
        sources: packSourceIds([dsModal.a, dsModal.b]),
        auto_chart: autoChartCreated ? 1 : 0,
      });
    });
  }

  function wireSigninPrompt(): void {
    const backdrop = shell.querySelector<HTMLElement>(
      "[data-role='signin-prompt']",
    );
    const closeBtn = shell.querySelector<HTMLButtonElement>(
      "[data-role='signin-prompt-close']",
    );
    const dismissBtn = shell.querySelector<HTMLButtonElement>(
      "[data-role='signin-prompt-dismiss']",
    );
    const signinBtn = shell.querySelector<HTMLButtonElement>(
      "[data-role='signin-prompt-signin']",
    );
    const close = () => {
      if (backdrop) backdrop.hidden = true;
    };
    closeBtn?.addEventListener("click", close);
    dismissBtn?.addEventListener("click", close);
    backdrop?.addEventListener("click", (e) => {
      if (e.target === backdrop) close();
    });
    // Local Supabase client — same factory the save flow uses below. The
    // module's createSupabase memoizes internally so we don't double-up.
    const sb = isSupabaseConfigured ? createSupabase() : null;
    if (signinBtn && sb) {
      signinBtn.addEventListener("click", async () => {
        // Same OAuth flow as the Save-to-account button. redirectTo back
        // to the current URL means the composer state (encoded in ?d=)
        // survives the round trip, so the user returns to the same
        // in-progress dashboard with their session token attached.
        track("compose_signin_prompt_clicked", {});
        try {
          await sb.auth.signInWithOAuth({
            provider: "google",
            options: {
              redirectTo: window.location.href,
              scopes: "openid email",
            },
          });
        } catch {
          // OAuth failure — leave the modal open so the user can retry
          // or dismiss. Network errors and provider 4xx land here.
        }
      });
    } else if (signinBtn) {
      // Supabase isn't configured in this build (no envvars). Hide the
      // sign-in CTA rather than offer a dead button; the close button
      // still works.
      signinBtn.style.display = "none";
    }
  }

  function wireCustomChartModal(): void {
    const backdrop = shell.querySelector<HTMLElement>("[data-role='cc-modal']");
    const closeBtn = shell.querySelector<HTMLButtonElement>("[data-role='cc-close']");
    const cancelBtn = shell.querySelector<HTMLButtonElement>("[data-role='cc-cancel']");
    const createBtn = shell.querySelector<HTMLButtonElement>("[data-role='cc-create']");
    const titleInput = shell.querySelector<HTMLInputElement>("[data-role='cc-title']");
    const searchInput = shell.querySelector<HTMLInputElement>("[data-role='cc-source-search']");
    const modeRadios = shell.querySelectorAll<HTMLInputElement>(
      "input[name='cc-mode']",
    );

    closeBtn?.addEventListener("click", closeCustomChartModal);
    cancelBtn?.addEventListener("click", closeCustomChartModal);
    // Click on the backdrop (outside the dialog) also closes.
    backdrop?.addEventListener("click", (e) => {
      if (e.target === backdrop) closeCustomChartModal();
    });
    // ESC closes the modal when it's open.
    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape" || !backdrop || backdrop.hidden) return;
      closeCustomChartModal();
    });
    titleInput?.addEventListener("input", () => {
      ccModal.title = titleInput.value;
      updateCustomChartCreateState();
    });
    const blurbInput = shell.querySelector<HTMLTextAreaElement>(
      "[data-role='cc-blurb']",
    );
    blurbInput?.addEventListener("input", () => {
      ccModal.blurb = blurbInput.value;
    });
    const percentDisplaySelect = shell.querySelector<HTMLSelectElement>(
      "[data-role='cc-percent-display-select']",
    );
    percentDisplaySelect?.addEventListener("change", () => {
      const v = percentDisplaySelect.value;
      ccModal.percentDisplay =
        v === "decimal" || v === "ratio" ? v : undefined;
      // No re-render needed — this only affects the saved spec; the
      // chart picks up the flag at render time.
    });
    searchInput?.addEventListener("input", () => {
      ccModal.search = searchInput.value;
      renderCustomChartSources();
    });
    modeRadios.forEach((r) => {
      r.addEventListener("change", () => {
        if (!r.checked) return;
        ccModal.mode = r.value as CustomChartMode;
        ccModal.modeIsExplicit = true;
        // Re-render the source list so the L|R pills appear/disappear as the
        // mode toggles into/out of dual-axis.
        renderCustomChartSources();
        // Log scale is incompatible with dual-axis; keep the checkbox state
        // honest as the user flips modes.
        syncLogUI();
        renderCustomChartPreview();
      });
    });

    const logCheckbox = shell.querySelector<HTMLInputElement>(
      "[data-role='cc-log']",
    );
    logCheckbox?.addEventListener("change", () => {
      // Defensive: even though we disable the checkbox in dual-axis mode,
      // a keyboard focus + space-bar could still flip it. Ignore that.
      if (ccModal.mode === "dual-axis") {
        logCheckbox.checked = false;
        return;
      }
      ccModal.logScale = logCheckbox.checked;
      renderCustomChartPreview();
    });

    const opSelect = shell.querySelector<HTMLSelectElement>("[data-role='cc-op-select']");
    opSelect?.addEventListener("change", () => {
      ccModal.op = (opSelect.value as ChartCombineOp | "") || null;
      syncOpUI();
      renderCustomChartPreview();
    });
    const opSwap = shell.querySelector<HTMLButtonElement>("[data-role='cc-op-swap']");
    opSwap?.addEventListener("click", () => {
      if (ccModal.selectedOrder.length === 2) {
        ccModal.selectedOrder = [
          ccModal.selectedOrder[1],
          ccModal.selectedOrder[0],
        ];
        syncOpUI();
        renderCustomChartPreview();
      }
    });
    createBtn?.addEventListener("click", () => {
      // Use selectedOrder so the user's explicit A/B order is preserved
      // for op'd charts. Fall back to insertion order if needed.
      const sourceIds = ccModal.selectedOrder.filter((id) =>
        ccModal.selected.has(id),
      );
      // Append any selected sources that didn't make it into selectedOrder
      // (defensive — shouldn't happen given the change handler).
      for (const id of ccModal.selected) {
        if (!sourceIds.includes(id)) sourceIds.push(id);
      }
      if (sourceIds.length === 0) return;
      // Title is optional; empty (or whitespace-only) gets a default so
      // the user isn't forced to name what might be a quick exploration.
      // Multiple "Unnamed chart"s on one dashboard is a self-inflicted
      // aesthetic — fixable by clicking the chart to rename — rather
      // than a structural problem.
      const effectiveTitle = ccModal.title.trim() || "Unnamed chart";
      // Final mode: rebase and dual-axis both need at least 2 sources to be
      // meaningful (rebasing a single series is just "indexed to 100" with no
      // comparison; dual-axis has nothing to assign to L/R). Clamp down to raw.
      const mode: CustomChartMode =
        (ccModal.mode === "dual-axis" || ccModal.mode === "rebase") &&
        sourceIds.length < 2
          ? "raw"
          : ccModal.mode;
      // Resolve rightAxisSources only when dual-axis. Persist explicit
      // user picks; if the user never touched the L/R pills, persist the
      // default split (first source left, rest right) so the rendered
      // chart matches the preview the user saw.
      let rightAxisSources: string[] | undefined;
      if (mode === "dual-axis") {
        const eff = effectiveRightAxisSources();
        const filtered = sourceIds.filter((id) => eff.has(id));
        rightAxisSources = filtered.length > 0 ? filtered : undefined;
      }
      // Op only valid with exactly 2 sources.
      const opToSave: ChartCombineOp | undefined =
        ccModal.op && sourceIds.length === 2 ? ccModal.op : undefined;
      // Log scale only valid with raw or rebase modes. Coerce off when
      // dual-axis is the final mode to keep the saved spec internally
      // consistent (so a state surviving across refreshes doesn't get
      // re-armed by some future UI fix).
      const scaleToSave: "linear" | "log" | undefined =
        ccModal.logScale && mode !== "dual-axis" ? "log" : undefined;
      const blurbToSave = ccModal.blurb.trim() || undefined;
      if (ccModal.editingId) {
        // Edit mode: preserve any fields we don't expose (e.g. render).
        const existing = state.inlineCharts[ccModal.editingId] ?? {
          title: "",
          sources: [] as string[],
        };
        state.inlineCharts[ccModal.editingId] = {
          ...existing,
          title: effectiveTitle,
          sources: sourceIds,
          normalize: mode,
          scale: scaleToSave,
          rightAxisSources,
          op: opToSave,
          blurb: blurbToSave,
          // Only persist percentDisplay when the chart's combine output
          // could actually be percent (divide on 2 sources); otherwise
          // the flag is dead weight in the saved state.
          percentDisplay:
            opToSave === "divide" && sourceIds.length === 2
              ? ccModal.percentDisplay
              : undefined,
        };
      } else {
        const id = INLINE_PREFIX + nanoid(8);
        state.inlineCharts[id] = {
          title: effectiveTitle,
          sources: sourceIds,
          normalize: mode,
          scale: scaleToSave,
          rightAxisSources,
          op: opToSave,
          blurb: blurbToSave,
          percentDisplay:
            opToSave === "divide" && sourceIds.length === 2
              ? ccModal.percentDisplay
              : undefined,
        };
        // Hover-merge path: the new chart replaces the BASE chart at its
        // section slot, and the DRAGGED chart is removed from its own
        // section. Base's defaultDelta (captured at merge launch) is
        // applied to the merged chart so the user's preferred window
        // survives the combine.
        const pm = ccModal.pendingMerge;
        if (pm) {
          if (pm.baseDefaultDelta) {
            state.inlineCharts[id].defaultDelta = pm.baseDefaultDelta;
          }
          const baseSec = state.sections[pm.baseSecIdx];
          const draggedSec = state.sections[pm.draggedSecIdx];
          // Remove the dragged chart first. If both are in the same section
          // and dragged was earlier, this shifts the base's index down by 1
          // — adjust before the replace.
          let baseIdx = pm.baseChartIdx;
          if (draggedSec) {
            draggedSec.charts.splice(pm.draggedChartIdx, 1);
            if (
              pm.baseSecIdx === pm.draggedSecIdx &&
              pm.draggedChartIdx < pm.baseChartIdx
            ) {
              baseIdx -= 1;
            }
          }
          if (baseSec && baseIdx >= 0 && baseIdx < baseSec.charts.length) {
            baseSec.charts.splice(baseIdx, 1, id);
            // Park the active-section focus on where the merged chart
            // landed so subsequent library adds land near it.
            activeSectionIdx = pm.baseSecIdx;
          } else if (baseSec) {
            // Defensive: indices stale (section reordered while modal open?).
            // Push to the end of the base section so the chart isn't lost.
            baseSec.charts.push(id);
          }
        } else {
          clampActiveSection();
          const target = state.sections[activeSectionIdx];
          if (target) target.charts.push(id);
        }
      }
      // Funnel telemetry: how often users create custom multi-source charts,
      // what scale modes (raw / rebase / dual-axis) they actually pick, and
      // which sources they combine. The source list lets us cross-check the
      // composition popularity signal against the library-add signal.
      track(
        ccModal.editingId
          ? "compose_custom_chart_edited"
          : ccModal.pendingMerge
            ? "compose_hover_merge_committed"
            : "compose_custom_chart_created",
        {
          sourceCount: sourceIds.length,
          mode,
          sources: packSourceIds(sourceIds),
        },
      );
      // Clear pendingMerge BEFORE closeCustomChartModal so the latter's
      // cancel-side reset is a no-op on the success path. (Both end up
      // null either way; this is just for readability.)
      ccModal.pendingMerge = null;
      writeUrl();
      renderComposition();
      closeCustomChartModal();
    });
  }

  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  // ---- Go ----
  hydrateFromUrl();
  wire();
  writeUrl(); // sync preview link

  loadLibrary()
    .then((lib) => {
      library = lib;
      // Render both tabs' filter strips eagerly so the counts are
      // accurate the first time the user opens either tab. Result
      // lists render lazily per tab on first activation, plus
      // immediately for the default tab (sources).
      renderTagFiltersSources();
      renderTagFiltersCharts();
      renderMetroChip();
      renderCdChip();
      renderCountryChip();
      renderSourcesList();
      renderComposition();
    })
    .catch((e) => {
      const host = shell.querySelector<HTMLElement>(
        "[data-role='lib-results-sources']",
      );
      if (host) host.innerHTML = `<p class="muted small">Failed to load library: ${escapeHtml(String(e))}</p>`;
    });
</script>

