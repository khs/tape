---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/compose.css";
export const prerender = true;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout
  title="Compose a dashboard — Tape"
  description="Build your own Tape dashboard from the chart library."
>
  <div class="composer-shell" data-base-url={baseUrl}>
    <div class="composer-topbar">
      <div class="composer-title-wrap">
        <input
          type="text"
          class="composer-title-input"
          data-role="title-input"
          placeholder="Untitled dashboard"
        />
      </div>
      <div class="composer-window-wrap">
        <label class="eyebrow" for="composer-default-delta">Time</label>
        <select id="composer-default-delta" data-role="default-delta">
          <option value="">Auto window</option>
          <option value="1w">1W trailing</option>
          <option value="1m">1M trailing</option>
          <option value="1y">1Y trailing</option>
          <option value="5y">5Y trailing</option>
          <option value="10y">10Y trailing</option>
          <option value="30y">30Y trailing</option>
          <option value="50y">50Y trailing</option>
          <option value="fixed">Fixed dates…</option>
        </select>
        <span class="composer-fixed-inputs" data-role="fixed-inputs" hidden>
          <input
            type="date"
            data-role="fixed-start"
            class="composer-date"
            aria-label="Start date"
          />
          <span class="muted small">→</span>
          <input
            type="date"
            data-role="fixed-end"
            class="composer-date"
            aria-label="End date"
          />
        </span>
      </div>
      <div class="composer-actions">
        <button type="button" class="btn-secondary" data-role="copy-share">Copy share link</button>
        <button type="button" class="btn-secondary" data-role="save" data-save-default-label="Save to my account">Save to my account</button>
        <a class="btn-primary" data-role="preview-link" href={`${baseUrl}/custom/`}>Preview &rarr;</a>
      </div>
    </div>

    <div class="composer-url-warn" data-role="url-warn" hidden>
      <strong>Heads up:</strong> the share link is getting long
      (<span data-role="url-warn-len">0</span> chars).
      Some browsers and servers cap URLs around 8&nbsp;KB.
      Use <strong>Save to my account</strong> to get a short
      <code>/u/&lt;slug&gt;/</code> link instead.
    </div>

    <div class="composer-url-overflow" data-role="url-overflow" hidden role="alert">
      <strong>Composition too large for the share link.</strong>
      Your work is safe in this tab
      (<span data-role="url-overflow-count">0</span> tiles,
      <span data-role="url-overflow-len">0</span>&nbsp;chars in the
      encoded state — the URL bar is keeping the last shorter version).
      To preserve it past a refresh:
      <ul>
        <li><strong>Save to your account</strong> — gets you a short
          <code>/u/&lt;slug&gt;/</code> link that handles any size.</li>
        <li>Or remove some tiles / split into smaller dashboards until
          the URL fits again.</li>
      </ul>
      <button type="button" class="btn-primary" data-role="url-overflow-save">
        Save to my account
      </button>
    </div>

    <div class="composer-description-wrap">
      <textarea
        class="composer-description-input"
        data-role="description-input"
        rows="2"
        placeholder="Add a short description for this dashboard (optional)…"></textarea>
    </div>

    <div class="composer-layout">
      <aside class="composer-library" data-active-tab="sources">
        <!--
          Two-tab library: "Sources" (primary, every available data
          series) and "Pregenerated charts" (curated multi-source /
          editorial chart specs). Sources is the default because the
          common case is "I want to track X" where X is a single
          series; pregenerated charts are for the "I want this
          specific comparison" case the editor has set up.
        -->
        <div class="lib-tabs" role="tablist">
          <button
            type="button"
            class="lib-tab lib-tab-active"
            data-role="lib-tab"
            data-tab="sources"
            role="tab"
            aria-selected="true"
          >Sources</button>
          <button
            type="button"
            class="lib-tab"
            data-role="lib-tab"
            data-tab="charts"
            role="tab"
            aria-selected="false"
          >Pregenerated charts</button>
          <button
            type="button"
            class="lib-tab"
            data-role="lib-tab"
            data-tab="maps"
            role="tab"
            aria-selected="false"
            title="Build a map from ACS demographic data"
          >Maps</button>
          <button
            type="button"
            class="lib-tab"
            data-role="lib-tab"
            data-tab="generators"
            role="tab"
            aria-selected="false"
            title="Mass-compose: same series across many metros / states / countries in one click"
          >Generators</button>
        </div>

        <div class="lib-panel" data-role="lib-panel-sources">
          <div class="lib-controls">
            <input
              type="search"
              class="lib-search"
              data-role="lib-search-sources"
              placeholder="Search sources by name, ticker, or tag..."
            />
            <!--
              Geo-chip strip — three chips, equal billing, above the
              topical tag pills:
                • US metro areas      (popover-with-searchable-list)
                • States & districts  (state + district inline dropdowns)
                • Regions & countries (popover-with-searchable-list)
              Order matches user-facing label order. Auto-hides only if
              none of the three has data (in practice always shown on
              the Sources tab).
            -->
            <div class="lib-geo-chips" data-role="lib-geo-chips" hidden>
              <div class="lib-geo-chip-wrap">
                <button
                  type="button"
                  class="lib-geo-chip"
                  data-role="lib-metro-chip"
                  aria-haspopup="listbox"
                  aria-expanded="false"
                >
                  <span class="lib-geo-chip-label" data-role="lib-metro-label"
                    >US metro areas &#9662;</span>
                  <span
                    class="lib-geo-chip-clear"
                    data-role="lib-metro-clear"
                    hidden
                    aria-label="Clear metro filter">&times;</span>
                </button>
                <div
                  class="lib-geo-popover"
                  data-role="lib-metro-popover"
                  role="listbox"
                  hidden
                >
                  <input
                    type="search"
                    class="lib-geo-search"
                    data-role="lib-metro-search"
                    placeholder="Search metros…"
                    aria-label="Search metros"
                  />
                  <div
                    class="lib-geo-list"
                    data-role="lib-metro-list"
                  ></div>
                </div>
              </div>
              <!--
                CD chip + drilldown rendered by renderCdChip(surface)
                into this host element. The chip + (when active) state
                + district dropdowns all live inline next to the metro
                + country chips. The host gets innerHTML-cleared and
                re-rendered each time CD state changes, which is OK
                because nothing else lives inside it.
              -->
              <div class="lib-geo-cd-host" data-role="lib-cd-chip-host"></div>
              <div class="lib-geo-chip-wrap">
                <button
                  type="button"
                  class="lib-geo-chip"
                  data-role="lib-country-chip"
                  aria-haspopup="listbox"
                  aria-expanded="false"
                >
                  <span class="lib-geo-chip-label" data-role="lib-country-label"
                    >Regions and countries &#9662;</span>
                  <span
                    class="lib-geo-chip-clear"
                    data-role="lib-country-clear"
                    hidden
                    aria-label="Clear country filter">&times;</span>
                </button>
                <div
                  class="lib-geo-popover"
                  data-role="lib-country-popover"
                  role="listbox"
                  hidden
                >
                  <input
                    type="search"
                    class="lib-geo-search"
                    data-role="lib-country-search"
                    placeholder="Search regions + countries…"
                    aria-label="Search regions + countries"
                  />
                  <div
                    class="lib-geo-list"
                    data-role="lib-country-list"
                  ></div>
                </div>
              </div>
            </div>
            <!--
              Tag-filter strip — "all" + topical tags only. Geo chips
              (CD + metro + country) live in the geo strip above.
            -->
            <div class="lib-tag-filters" data-role="tag-filters-sources"></div>
          </div>
          <div class="lib-results" data-role="lib-results-sources">
            <p class="muted small">Loading sources...</p>
          </div>
        </div>

        <div class="lib-panel" data-role="lib-panel-charts" hidden>
          <div class="lib-controls">
            <input
              type="search"
              class="lib-search"
              data-role="lib-search-charts"
              placeholder="Search pregenerated charts..."
            />
            <div class="lib-tag-filters" data-role="tag-filters-charts"></div>
          </div>
          <div class="lib-results" data-role="lib-results-charts">
            <p class="muted small">Loading pregenerated charts...</p>
          </div>
        </div>

        <!--
          Maps tab: build a map from ACS demographic data.
          Form-driven (not search-driven like the other two tabs) because
          the input set is a 5-axis cross-product (indicator × vintage ×
          geo × state × color) rather than a list to filter. Form values
          are written to a local mapBuilder state object; clicking "Add
          map" creates a `inlinemap:<id>` entry in state.inlineMaps and
          appends the reference to the active section.
        -->
        <div class="lib-panel lib-panel-maps" data-role="lib-panel-maps" hidden>
          <div class="map-builder">
            <p class="muted small map-builder-intro">
              Build a map of an ACS demographic indicator.
              The map is added to your current section like any other
              tile.
            </p>

            {/* Field order is intentional: pick geography first
                (it gates which indicators are available — state has
                the full set, county/tract/BG have a smaller fixed
                set), then the indicator, then styling, with vintage
                pushed near the bottom since it's the least
                impactful choice and gets clamped to whatever the
                indicator+geo combo actually has data for. */}
            <fieldset class="map-field">
              <legend class="map-field-label">Geography level</legend>
              <div class="map-geo-radios">
                <label class="map-radio-row">
                  <input type="radio" name="map-geo" value="state" data-role="map-geo" />
                  <span><strong>State</strong> &mdash; one tile per state. <em>Most indicators (20+).</em></span>
                </label>
                <label class="map-radio-row">
                  <input type="radio" name="map-geo" value="county" checked data-role="map-geo" />
                  <span><strong>County</strong> &mdash; ~3,140 US counties. <em>4 indicators.</em></span>
                </label>
                <label class="map-radio-row">
                  <input type="radio" name="map-geo" value="tract" data-role="map-geo" />
                  <span><strong>Tract</strong> &mdash; ~500&ndash;9,000 per state. <em>4 indicators.</em></span>
                </label>
                <label class="map-radio-row">
                  <input type="radio" name="map-geo" value="block-group" data-role="map-geo" />
                  <span><strong>Block group</strong> &mdash; up to ~30,000 per state. <em>2 indicators (only median income + education are published at this level).</em></span>
                </label>
              </div>
              <p class="muted small map-geo-caveat">
                More indicators are available at coarser geographies.
                Pick State if you want the full set.
              </p>
              <p class="muted small map-geo-warning" data-role="map-geo-warning" hidden>
                ⚠ Tract and block-group maps render thousands of polygons —
                more if you pick multiple states. Use the bbox section
                below to clip to an area of interest if scrolling feels
                sluggish.
              </p>
            </fieldset>

            <label class="map-field">
              <span class="map-field-label">Indicator</span>
              <select class="map-input" data-role="map-indicator"></select>
              <span class="muted small" data-role="map-indicator-info">&nbsp;</span>
            </label>

            <div class="map-field" data-role="map-state-field" hidden>
              <span class="map-field-label">State(s)</span>
              <div class="map-region-presets" data-role="map-region-presets">
                <span class="muted small">Quick regions:</span>
                <button
                  type="button"
                  class="map-region-chip"
                  data-role="map-region-preset"
                  data-states="DC,MD,VA"
                  title="DC + Maryland + Virginia"
                >DMV</button>
                <button
                  type="button"
                  class="map-region-chip"
                  data-role="map-region-preset"
                  data-states="NY,NJ,CT"
                  title="New York + New Jersey + Connecticut"
                >NY tri-state</button>
                <button
                  type="button"
                  class="map-region-chip"
                  data-role="map-region-preset"
                  data-states="MA,CT,RI,NH"
                  title="Massachusetts + Connecticut + Rhode Island + New Hampshire"
                >New England</button>
                <button
                  type="button"
                  class="map-region-chip"
                  data-role="map-region-preset"
                  data-states="PA,NJ,DE,MD"
                  title="Pennsylvania + New Jersey + Delaware + Maryland"
                >Mid-Atlantic</button>
                <button
                  type="button"
                  class="map-region-chip"
                  data-role="map-region-preset"
                  data-states="WA,OR,ID"
                  title="Washington + Oregon + Idaho"
                >Pac NW</button>
              </div>
              <select
                class="map-input map-state-multi"
                data-role="map-state"
                aria-label="States"
                multiple
                size="6"
              ></select>
              <span class="muted small">
                Pick up to 4 states. Use a region chip for quick fills,
                or <kbd>Ctrl</kbd>-click (<kbd>⌘</kbd>-click on Mac) for
                multi-select.
              </span>
              <span class="muted small" data-role="map-state-readout">&nbsp;</span>
            </div>

            <label class="map-field">
              <span class="map-field-label">Color scheme</span>
              <select class="map-input" data-role="map-color-scheme">
                <option value="viridis">Viridis (perceptually uniform)</option>
                <option value="batlow">Batlow (perceptually uniform)</option>
                <option value="reds">Reds</option>
                <option value="blues">Blues</option>
                <option value="greens">Greens</option>
                <option value="purples">Purples</option>
                <option value="oranges">Oranges</option>
                <option value="ylorrd">Yellow–Orange–Red</option>
                <option value="rdylgn">Red–Yellow–Green (diverging)</option>
              </select>
            </label>

            <fieldset class="map-field">
              <legend class="map-field-label">Color scale</legend>
              <div class="map-scale-radios">
                <label class="map-radio-row">
                  <input type="radio" name="map-scale" value="linear" checked data-role="map-scale" />
                  <span><strong>Linear</strong> &mdash; default</span>
                </label>
                <label class="map-radio-row">
                  <input type="radio" name="map-scale" value="log" data-role="map-scale" />
                  <span><strong>Log</strong> &mdash; better for long-tailed indicators (income, population)</span>
                </label>
              </div>
            </fieldset>

            <details class="map-bbox-section" data-role="map-bbox-details">
              <summary>Area of interest (optional)</summary>
              <p class="muted small">
                Draw a rectangle on the preview to clip the map to a sub-area
                of the selected state. Useful for metro-level views inside
                large states. Leave empty for whole-state coverage.
              </p>
              <div class="map-bbox-preview" data-role="map-bbox-preview">
                <p class="muted small">Pick a state above to enable bbox drawing.</p>
              </div>
              <div class="map-bbox-controls">
                <span class="muted small" data-role="map-bbox-readout">No area selected</span>
                <button type="button" class="btn-secondary map-bbox-clear" data-role="map-bbox-clear">Clear</button>
              </div>
            </details>

            <label class="map-field">
              <span class="map-field-label">Title (optional)</span>
              <input
                type="text"
                class="map-input"
                data-role="map-title"
                placeholder="Auto-generated from your selections"
              />
            </label>

            {/* Vintage near the bottom — least-impactful field, and
                the slider gets clamped to whatever the indicator+geo
                combo actually has data for, so it's a tail decision
                rather than a primary one. */}
            <div class="map-field">
              <span class="map-field-label">Vintage</span>
              <div class="map-vintage-row">
                <input
                  type="range"
                  min="2010"
                  max="2022"
                  value="2022"
                  step="1"
                  data-role="map-vintage"
                  aria-label="ACS 5-year vintage end-year"
                />
                <span class="map-vintage-readout" data-role="map-vintage-readout">2022</span>
              </div>
              <span class="muted small">
                ACS 5-year estimate ending in the selected calendar year.
                The slider auto-clamps to the indicator's earliest
                available year.
              </span>
            </div>

            <div class="map-actions">
              <button type="button" class="btn-primary map-add-btn" data-role="map-add-btn">
                + Add map to dashboard
              </button>
            </div>
          </div>
        </div>

        <!--
          Generators tab: mass-compose a section of charts for "the
          same series across many entities" — e.g. unemployment rate
          across the 50 largest MSAs, median income across every state,
          GDP across every G20 country. The catalog of available
          (geo-type, template) pairs is shipped at build time as
          public/generators-index.json by pipelines/_generate_generators_
          index.py, so the form populates without ~20k YAML loads in
          the browser.

          Three-step form:
            1. Geo-type (MSA / State / Country)
            2. Series template (dropdown filtered to the geo-type)
            3. Entity selection (All / preset / custom checkboxes)
          A readout below "Generate" reports how many entities the
          chosen template actually has data for vs how many the user
          selected — silent-skip the missing ones.
        -->
        <div class="lib-panel lib-panel-generators" data-role="lib-panel-generators" hidden>
          <div class="gen-builder">
            <p class="muted small">
              Two flavors: <strong>By indicator</strong> emits one tile
              per entity across the picked series (unemployment in every
              MSA). <strong>Profile</strong> emits one tile per series
              for the picked entity (everything we have about Virginia).
            </p>

            <fieldset class="map-field" data-role="gen-layout-section">
              <legend class="map-field-label">Layout</legend>
              <div class="map-geo-radios">
                <label class="map-radio-row">
                  <input type="radio" name="gen-layout" value="indicator" checked data-role="gen-layout" />
                  <span><strong>By indicator</strong> &mdash; one series &times; many entities</span>
                </label>
                <label class="map-radio-row">
                  <input type="radio" name="gen-layout" value="profile" data-role="gen-layout" />
                  <span><strong>Profile</strong> &mdash; one entity &times; every available series, ordered as a curated profile section</span>
                </label>
              </div>
            </fieldset>

            <fieldset class="map-field">
              <legend class="map-field-label">By</legend>
              <div class="map-geo-radios">
                <label class="map-radio-row">
                  <input type="radio" name="gen-geo" value="metro" checked data-role="gen-geo" />
                  <span><strong>Metro</strong> &mdash; US MSAs (CBSA-keyed)</span>
                </label>
                <label class="map-radio-row">
                  <input type="radio" name="gen-geo" value="state" data-role="gen-geo" />
                  <span><strong>State</strong> &mdash; 50 + DC</span>
                </label>
                <label class="map-radio-row">
                  <input type="radio" name="gen-geo" value="country" data-role="gen-geo" />
                  <span><strong>Country</strong> &mdash; sovereigns + a few aggregates</span>
                </label>
              </div>
            </fieldset>

            <label class="map-field" data-role="gen-template-wrap">
              <span class="map-field-label">Series template</span>
              <input
                type="search"
                class="map-input"
                data-role="gen-template-search"
                placeholder="Filter templates by name…"
              />
              <select class="map-input gen-template-select" data-role="gen-template" size="8"></select>
              <span class="muted small" data-role="gen-template-info">&nbsp;</span>
            </label>

            {/*
              Profile mode: pick ONE entity, then we'll emit one tile per
              available series template in the canonical PROFILE_ORDER
              (see the generators-index builder). Hidden by
              default — the layout toggle above flips this on. The
              indicator-summary span shows how many tiles will land
              in the dashboard so the user can preview the size before
              clicking Generate.
            */}
            <label class="map-field" data-role="gen-profile-wrap" hidden>
              <span class="map-field-label">Entity</span>
              <input
                type="search"
                class="map-input"
                data-role="gen-profile-search"
                placeholder="Filter entities by name…"
              />
              <select class="map-input gen-template-select" data-role="gen-profile-entity" size="8"></select>
              <span class="muted small" data-role="gen-profile-info">&nbsp;</span>
            </label>

            <fieldset class="map-field" data-role="gen-entity-section">
              <legend class="map-field-label">Entities</legend>

              <div class="gen-sort-row" data-role="gen-sort-row">
                <span class="gen-sort-label">Sort by</span>
                <label class="gen-sort-opt">
                  <input type="radio" name="gen-sort" value="alpha" checked data-role="gen-sort" />
                  <span>Alphabetical</span>
                </label>
                <label class="gen-sort-opt" data-role="gen-sort-pop-wrap">
                  <input type="radio" name="gen-sort" value="pop" data-role="gen-sort" />
                  <span>Population (largest first)</span>
                </label>
              </div>

              <div class="map-geo-radios">
                <label class="map-radio-row">
                  <input type="radio" name="gen-mode" value="all" checked data-role="gen-mode" />
                  <span><strong>All available</strong> for this template</span>
                </label>
                <label class="map-radio-row">
                  <input type="radio" name="gen-mode" value="preset" data-role="gen-mode" />
                  <span><strong>Preset</strong> &mdash; quick groupings (region / top-12)</span>
                </label>
                <label class="map-radio-row">
                  <input type="radio" name="gen-mode" value="custom" data-role="gen-mode" />
                  <span><strong>Custom</strong> &mdash; pick specific entities</span>
                </label>
              </div>

              <div data-role="gen-preset-wrap" class="gen-preset-wrap" hidden>
                <select class="map-input" data-role="gen-preset"></select>
              </div>

              <div data-role="gen-custom-wrap" class="gen-custom-wrap" hidden>
                <input
                  type="search"
                  class="map-input"
                  data-role="gen-entity-search"
                  placeholder="Search by name…"
                />
                <div class="gen-entity-actions">
                  <button type="button" class="btn-tertiary" data-role="gen-entity-all">Select all visible</button>
                  <button type="button" class="btn-tertiary" data-role="gen-entity-none">Clear</button>
                </div>
                <div class="gen-entity-list" data-role="gen-entity-list"></div>
              </div>
            </fieldset>

            <label class="map-field">
              <span class="map-field-label">Section title (optional)</span>
              <input
                type="text"
                class="map-input"
                data-role="gen-section-title"
                placeholder="Auto-generated from selections; leave blank to append to active section"
              />
              <span class="muted small">
                Blank = append into your current active section. With a title, a new section gets created.
              </span>
            </label>

            <div class="map-actions">
              <button type="button" class="btn-primary map-add-btn" data-role="gen-add-btn">
                + Generate
              </button>
              <p class="muted small" data-role="gen-readout">&nbsp;</p>
            </div>
          </div>
        </div>
      </aside>

      <main class="composer-composition">
        <div class="comp-empty" data-role="comp-empty">
          <p class="muted">Pick charts on the left to start composing. They'll appear here organized into sections.</p>
          <p class="muted small comp-empty-hint">
            Two ways in: click a source (or a Pregenerated chart) and it
            becomes a tile in the current section, or click <strong>+
            Custom chart</strong> below to combine several sources on one
            axis. <strong>+ Derived source</strong> turns A÷B,&nbsp;A−B,
            or A+B into a reusable source.
          </p>
          {/*
            First-touch escape hatch. A cold visitor landing on /compose/
            sees an empty canvas + four library tabs and may not know
            where to start. The walkthrough is the curated guided tour
            of every feature — link it here so the visitor has a
            "what does this thing do" path that isn't "click around
            until something happens."
          */}
          <p class="muted small comp-empty-walkthrough">
            First time?
            <a href={`${baseUrl}/walkthrough/`}>Take the 5-minute tour &rarr;</a>
          </p>
        </div>
        <div class="comp-sections" data-role="comp-sections"></div>
        <div class="comp-controls">
          <button type="button" class="btn-secondary" data-role="add-section">+ Add section</button>
          <button
            type="button"
            class="btn-secondary"
            data-role="add-markdown-section"
            title="Add a section that's just a markdown narrative block — no charts. Useful for context between chart sections."
          >+ Markdown block</button>
          <button type="button" class="btn-secondary" data-role="open-custom-chart">+ Custom chart</button>
          <button type="button" class="btn-secondary" data-role="open-derived-source">+ Derived source</button>
        </div>
      </main>
    </div>

    <footer class="composer-footer">
      <p>
        Want something not available here yet? Contact Keller Scholl at
        <a href="mailto:keller.scholl@gmail.com">keller.scholl@gmail.com</a>.
      </p>
    </footer>

    <!-- Per-chart blurb / title override modal. -->
    <div class="cc-modal-backdrop" data-role="cb-modal" hidden>
      <div class="cc-modal" role="dialog" aria-modal="true" aria-labelledby="cb-modal-title">
        <div class="cc-modal-header">
          <h3 id="cb-modal-title">Edit chart note</h3>
          <button type="button" class="cc-modal-close" data-role="cb-close" aria-label="Close">&times;</button>
        </div>
        <div class="cc-modal-body">
          <p class="muted small" data-role="cb-chart-name">&nbsp;</p>
          <label class="cc-field">
            <span class="eyebrow">Title (override)</span>
            <input type="text" data-role="cb-title" placeholder="Leave blank to keep the chart's default title" />
          </label>
          <label class="cc-field">
            <span class="eyebrow">Note shown when expanded</span>
            <textarea data-role="cb-blurb" rows="6" placeholder="What should readers notice about this chart in the context of your dashboard? Plain text. Leave blank to omit."></textarea>
          </label>
        </div>
        <div class="cc-modal-footer">
          <button type="button" class="btn-secondary" data-role="cb-cancel">Cancel</button>
          <button type="button" class="btn-primary" data-role="cb-save">Save</button>
        </div>
      </div>
    </div>

    <!-- Derived-source modal. Combines two sources (real or already-derived)
         into a new first-class source that can be used anywhere a regular
         source can. -->
    <div class="cc-modal-backdrop" data-role="ds-modal" hidden>
      <div class="cc-modal" role="dialog" aria-modal="true" aria-labelledby="ds-modal-title">
        <div class="cc-modal-header">
          <h3 id="ds-modal-title">New derived source</h3>
          <button type="button" class="cc-modal-close" data-role="ds-close" aria-label="Close">&times;</button>
        </div>
        <div class="cc-modal-body">
          <p class="muted small">
            Combines two existing sources (real or derived) into a new
            source you can use in any chart.
          </p>
          <div class="cc-field ds-quick-divisors">
            <span class="eyebrow">Quick: divide by…</span>
            <div class="ds-quick-chips" data-role="ds-quick-chips">
              <button
                type="button"
                class="ds-quick-chip"
                data-role="ds-quick"
                data-divisor-id="fred/us_population"
                data-name-template="per capita"
              >÷ US population</button>
              <button
                type="button"
                class="ds-quick-chip"
                data-role="ds-quick"
                data-divisor-id="fred/us_real_gdp"
                data-name-template="share of GDP"
              >÷ US GDP</button>
              <button
                type="button"
                class="ds-quick-chip"
                data-role="ds-quick"
                data-divisor-id="fred/payrolls"
                data-name-template="per worker"
              >÷ US employment</button>
              <button
                type="button"
                class="ds-quick-chip"
                data-role="ds-quick"
                data-divisor-id="fred/us_cpi"
                data-name-template="real (CPI-adjusted)"
                title="Plots the ratio of A to CPI. Shape is correct for 'is this growing faster than inflation?'; units are 'per CPI point' rather than textbook real dollars."
              >÷ CPI</button>
            </div>
            <p class="muted small ds-quick-help">
              Pre-fills the divisor and operation; pick the numerator (A) below.
            </p>
          </div>
          <label class="cc-field">
            <span class="eyebrow">Name</span>
            <input type="text" data-role="ds-name" placeholder="e.g. Retail-gas / WTI" />
          </label>
          <label class="cc-field">
            <span class="eyebrow">Operation</span>
            <select data-role="ds-op">
              <option value="divide">Divide (A ÷ B)</option>
              <option value="diff">Difference (A − B)</option>
              <option value="sum">Sum (A + B)</option>
              <option value="multiply">Multiply (A × B)</option>
            </select>
          </label>
          <div class="cc-field">
            <span class="eyebrow">Filter operands by tag (optional)</span>
            <!--
              Geo-chip strip — same three-chip layout as the Sources
              tab + cc-modal. Above the topical tag pills.
            -->
            <div class="lib-geo-chips" data-role="ds-geo-chips" hidden>
              <div class="lib-geo-chip-wrap">
                <button type="button" class="lib-geo-chip" data-role="ds-metro-chip" aria-haspopup="listbox" aria-expanded="false">
                  <span class="lib-geo-chip-label" data-role="ds-metro-label">US metro areas &#9662;</span>
                  <span class="lib-geo-chip-clear" data-role="ds-metro-clear" hidden aria-label="Clear metro filter">&times;</span>
                </button>
                <div class="lib-geo-popover" data-role="ds-metro-popover" role="listbox" hidden>
                  <input type="search" class="lib-geo-search" data-role="ds-metro-search" placeholder="Search metros…" aria-label="Search metros" />
                  <div class="lib-geo-list" data-role="ds-metro-list"></div>
                </div>
              </div>
              <div class="lib-geo-cd-host" data-role="ds-cd-chip-host"></div>
              <div class="lib-geo-chip-wrap">
                <button type="button" class="lib-geo-chip" data-role="ds-country-chip" aria-haspopup="listbox" aria-expanded="false">
                  <span class="lib-geo-chip-label" data-role="ds-country-label">Regions and countries &#9662;</span>
                  <span class="lib-geo-chip-clear" data-role="ds-country-clear" hidden aria-label="Clear country filter">&times;</span>
                </button>
                <div class="lib-geo-popover" data-role="ds-country-popover" role="listbox" hidden>
                  <input type="search" class="lib-geo-search" data-role="ds-country-search" placeholder="Search regions + countries…" aria-label="Search regions + countries" />
                  <div class="lib-geo-list" data-role="ds-country-list"></div>
                </div>
              </div>
            </div>
            <div class="cc-source-tags lib-tag-filters" data-role="ds-source-tags"></div>
          </div>
          <div class="cc-field">
            <span class="eyebrow">A (first operand)</span>
            <input
              type="search"
              class="cc-source-search"
              data-role="ds-a-search"
              placeholder="Search sources…"
            />
            <div class="cc-source-list ds-source-list" data-role="ds-a-list"></div>
            <p class="muted small ds-current" data-role="ds-a-current">No source picked yet.</p>
          </div>
          <!--
            Rebuild-total suggestion. Appears when A is a share/rate that
            carries derivedFrom metadata (a numerator ÷ denominator pair).
            One click sets op=Multiply and B=<denominator>, reconstructing
            the underlying count. See syncRebuildSuggestion().
          -->
          <div class="ds-rebuild" data-role="ds-rebuild" hidden>
            <button type="button" class="ds-rebuild-chip" data-role="ds-rebuild-apply"></button>
            <p class="muted small ds-rebuild-help" data-role="ds-rebuild-help"></p>
          </div>
          <!--
            Combine-hint suggestion (combineHint metadata). Appears when A
            carries a one-click partner (e.g. a NASS price whose quantity
            partner exists). One click sets op + B = partner and names the
            result (price × quantity → production value). See
            syncPxqSuggestion(). Reuses the ds-rebuild chip styling.
          -->
          <div class="ds-rebuild" data-role="ds-pxq" hidden>
            <button type="button" class="ds-rebuild-chip" data-role="ds-pxq-apply"></button>
            <p class="muted small ds-rebuild-help" data-role="ds-pxq-help"></p>
          </div>
          <div class="cc-field">
            <span class="eyebrow">B (second operand)</span>
            <input
              type="search"
              class="cc-source-search"
              data-role="ds-b-search"
              placeholder="Search sources…"
            />
            <div class="cc-source-list ds-source-list" data-role="ds-b-list"></div>
            <p class="muted small ds-current" data-role="ds-b-current">No source picked yet.</p>
          </div>
          <p class="cc-op-hint muted small" data-role="ds-hint">&nbsp;</p>
          <label class="ds-add-as-chart">
            <input type="checkbox" data-role="ds-add-as-chart" checked />
            <span>
              Also add as a chart to the current section
              <span class="muted small">— uncheck if you just want the source available for other charts.</span>
            </span>
          </label>
        </div>
        <div class="cc-modal-footer">
          <button type="button" class="btn-secondary" data-role="ds-cancel">Cancel</button>
          <button type="button" class="btn-primary" data-role="ds-create" disabled>Create source</button>
        </div>
      </div>
    </div>

    <!-- Custom-chart modal. Mounted with display:none; the script toggles it. -->
    <div class="cc-modal-backdrop" data-role="cc-modal" hidden>
      <div class="cc-modal" role="dialog" aria-modal="true" aria-labelledby="cc-modal-title">
        <div class="cc-modal-header">
          <h3 id="cc-modal-title">New custom chart</h3>
          <button type="button" class="cc-modal-close" data-role="cc-close" aria-label="Close">&times;</button>
        </div>
        <div class="cc-modal-body cc-modal-split">
          <div class="cc-modal-form">
            <label class="cc-field">
              <span class="eyebrow">Title</span>
              <input type="text" data-role="cc-title" placeholder="Give this chart a name…" />
            </label>
            <div class="cc-field">
              <div class="cc-sources-header">
                <span class="eyebrow">Sources</span>
                <span class="cc-sources-count" data-role="cc-count">0 selected</span>
              </div>
              <input type="search" class="cc-source-search" data-role="cc-source-search" placeholder="Search sources by name, ticker, or tag…" />
              <!--
                Geo-chip strip — same three-chip layout as the Sources
                tab, in the same order. Lives ABOVE the topical tag
                pills so geo picks are the first thing users see.
              -->
              <div class="lib-geo-chips" data-role="cc-geo-chips" hidden>
                <div class="lib-geo-chip-wrap">
                  <button type="button" class="lib-geo-chip" data-role="cc-metro-chip" aria-haspopup="listbox" aria-expanded="false">
                    <span class="lib-geo-chip-label" data-role="cc-metro-label">US metro areas &#9662;</span>
                    <span class="lib-geo-chip-clear" data-role="cc-metro-clear" hidden aria-label="Clear metro filter">&times;</span>
                  </button>
                  <div class="lib-geo-popover" data-role="cc-metro-popover" role="listbox" hidden>
                    <input type="search" class="lib-geo-search" data-role="cc-metro-search" placeholder="Search metros…" aria-label="Search metros" />
                    <div class="lib-geo-list" data-role="cc-metro-list"></div>
                  </div>
                </div>
                <div class="lib-geo-cd-host" data-role="cc-cd-chip-host"></div>
                <div class="lib-geo-chip-wrap">
                  <button type="button" class="lib-geo-chip" data-role="cc-country-chip" aria-haspopup="listbox" aria-expanded="false">
                    <span class="lib-geo-chip-label" data-role="cc-country-label">Regions and countries &#9662;</span>
                    <span class="lib-geo-chip-clear" data-role="cc-country-clear" hidden aria-label="Clear country filter">&times;</span>
                  </button>
                  <div class="lib-geo-popover" data-role="cc-country-popover" role="listbox" hidden>
                    <input type="search" class="lib-geo-search" data-role="cc-country-search" placeholder="Search regions + countries…" aria-label="Search regions + countries" />
                    <div class="lib-geo-list" data-role="cc-country-list"></div>
                  </div>
                </div>
              </div>
              <div class="cc-source-tags lib-tag-filters" data-role="cc-source-tags"></div>
              <div class="cc-source-list" data-role="cc-source-list"></div>
            </div>
            <fieldset class="cc-mode" data-role="cc-mode">
              <legend class="eyebrow">Scale</legend>
              <label class="cc-mode-opt">
                <input type="radio" name="cc-mode" value="raw" data-role="cc-mode-raw" />
                <span><strong>Raw</strong> — plot each series at its own value. Best when all picked sources share the same scale (e.g. several inflation rates).</span>
              </label>
              <label class="cc-mode-opt" data-role="cc-mode-rebase-wrap">
                <input type="radio" name="cc-mode" value="rebase" data-role="cc-mode-rebase" />
                <span><strong>Rebase</strong> — index every series to 100 at the window start. Best when scales differ wildly (mortgage rates + S&amp;P).</span>
              </label>
              <label class="cc-mode-opt" data-role="cc-mode-dual-wrap">
                <input type="radio" name="cc-mode" value="dual-axis" data-role="cc-mode-dual" />
                <span><strong>Dual-axis</strong> — split sources between left and right y-axes (any combination, e.g. one on the left, three on the right). Needs at least two sources.</span>
              </label>
            </fieldset>
            <label class="cc-field">
              <span class="eyebrow">Note (shown when expanded)</span>
              <textarea
                data-role="cc-blurb"
                rows="3"
                placeholder="What should readers notice about this chart? Plain text. Optional."
              ></textarea>
            </label>
            <label
              class="cc-log-opt"
              data-role="cc-log-wrap"
              title="Log-scale the y-axis. Makes exponential growth (market caps, GDP, prices over decades) read as a straight line. Disabled when dual-axis is selected — running log on one axis and linear on the other would be misleading."
            >
              <input type="checkbox" data-role="cc-log" />
              <span><strong>Log scale</strong> — makes exponential growth read as a straight line. Combine with raw or rebase; off with dual-axis.</span>
            </label>
            <!--
              percentDisplay control: only relevant when the chart's
              combine output would auto-render as percent (same-class
              divide, e.g. currency/currency). Visibility is gated in
              JS on (op === "divide" && exactly 2 sources) — leaving
              it visible always would invite confusion when it's a
              silent no-op.
            -->
            <label class="cc-field" data-role="cc-percent-display-wrap" hidden>
              <span class="eyebrow">Show divide result as</span>
              <select data-role="cc-percent-display-select">
                <option value="percent">Percent (104%)</option>
                <option value="decimal">Decimal (1.04)</option>
                <option value="ratio">Ratio (1.04:1)</option>
              </select>
            </label>

            <p class="muted small">
              Need to plot a ratio, sum, or difference?
              Click <strong>+ Derived source</strong> outside this modal
              first; then pick the derived source here like any other.
            </p>
          </div>
          <div class="cc-modal-preview">
            <div class="cc-preview-header">
              <span class="eyebrow">Preview</span>
              <span class="cc-preview-status muted small" data-role="cc-preview-status">Pick a source to preview.</span>
            </div>
            <div class="cc-preview-plot" data-role="cc-preview-plot"></div>
            <ul class="cc-preview-legend" data-role="cc-preview-legend"></ul>

            <!--
              Dialog-presentation controls — these affect what the reader
              sees when they expand the chart from a tile (NOT the
              preview above, which intentionally shows a stripped-down
              render so the underlying line stays readable while picking
              sources). Grouped on the right so the form's left column
              stays focused on the data pipeline (sources + scale + log
              + percent) and the right column owns "how it looks."
            -->
            <div class="cc-preview-presentation">
              <span class="eyebrow cc-preview-presentation-heading">Dialog presentation</span>

              <!--
                Default y-axis transform for the dialog plot. Readers can
                switch via pills in the dialog without persisting; this
                field is the FIRST-PAINT default. Three values:
                  level      — raw stored values (no transform)
                  yoy_pct    — 12-month % change at each date
                  index_100  — rebase visible window so first point = 100
              -->
              <label class="cc-field">
                <span class="eyebrow">Default y-axis transform</span>
                <select data-role="cc-transform-select">
                  <option value="level">Level (raw values)</option>
                  <option value="yoy_pct">YoY % (12-month change)</option>
                  <option value="index_100">Index = 100 (rebased)</option>
                </select>
                <span class="muted small">
                  Tile always shows raw level. Readers can flip the
                  dialog transform with the pill row; this picks what
                  they see on first open.
                </span>
              </label>

              <!--
                Background shading: semi-transparent date bands rendered
                BEHIND the line on the expanded chart. Multiple stack via
                alpha compositing. See src/lib/shading-presets.ts for the
                band definitions; the checkboxes mirror SHADING_LABELS.
                The 6 preset keys (recessions, president_party,
                senate_majority, house_majority, bear_markets, fed_chairs)
                are wired into the inline-chart state on save.
              -->
              <fieldset class="cc-field cc-shading" data-role="cc-shading">
                <legend class="eyebrow">Background shading</legend>
                <p class="muted small" style="margin-top: 0">
                  Optional date-band overlays behind the line on the
                  expanded chart.
                </p>
                <label class="cc-mode-opt">
                  <input type="checkbox" data-role="cc-shading-recessions" value="recessions" />
                  <span><strong>NBER recessions</strong> — gray bands during US recessions (1945-present).</span>
                </label>
                <label class="cc-mode-opt">
                  <input type="checkbox" data-role="cc-shading-president" value="president_party" />
                  <span><strong>Presidential party</strong> — blue during Democratic presidencies, red during Republican.</span>
                </label>
                <label class="cc-mode-opt">
                  <input type="checkbox" data-role="cc-shading-senate" value="senate_majority" />
                  <span><strong>Senate majority</strong> — blue / red by Senate party control.</span>
                </label>
                <label class="cc-mode-opt">
                  <input type="checkbox" data-role="cc-shading-house" value="house_majority" />
                  <span><strong>House majority</strong> — blue / red by House party control.</span>
                </label>
                <label class="cc-mode-opt">
                  <input type="checkbox" data-role="cc-shading-bear" value="bear_markets" />
                  <span><strong>S&amp;P 500 bear markets</strong> — drawdowns of at least 20% from prior peak.</span>
                </label>
                <label class="cc-mode-opt">
                  <input type="checkbox" data-role="cc-shading-fed" value="fed_chairs" />
                  <span><strong>Fed Chair tenures</strong> — Volcker onward.</span>
                </label>
              </fieldset>

              <!--
                Editorial annotations: text labels pinned to specific
                dates on the dialog plot. One annotation per line, in
                the format:
                  YYYY-MM-DD: label text
                  YYYY-MM-DD: another label | below
                Trailing "| above" or "| below" controls the vertical
                placement of the label (default above). Blank lines and
                # comment lines are ignored.
              -->
              <label class="cc-field">
                <span class="eyebrow">Annotations</span>
                <textarea
                  data-role="cc-annotations"
                  rows="4"
                  placeholder={"One per line, format:\n2008-09-15: Lehman collapse\n2020-03-15: COVID lockdown | below"}
                ></textarea>
                {/* Live "this annotation's date predates the earliest
                    selected source — it won't render at any window"
                    warning. The cc-modal's input listener recomputes
                    the offending list whenever the textarea changes or
                    the source selection changes; we hide the warning
                    when every annotation falls inside the union date
                    range of the picked sources. */}
                <p
                  class="cc-annotations-warn"
                  data-role="cc-annotations-warn"
                  hidden
                ></p>
                <span class="muted small">
                  Pin labels to specific dates on the expanded chart.
                  Format: <code>YYYY-MM-DD: label</code>. Optional
                  <code>| above</code> or <code>| below</code> suffix
                  controls vertical placement (default above). Blank
                  lines + # comments OK. Annotations don't appear in
                  the preview above — only in the expanded dialog.
                </span>
              </label>
            </div>
          </div>
        </div>
        <div class="cc-modal-footer">
          <button type="button" class="btn-secondary" data-role="cc-cancel">Cancel</button>
          <button type="button" class="btn-primary" data-role="cc-create" disabled>Create chart</button>
        </div>
      </div>
    </div>

    <!--
      Sign-in prompt: shown when an anonymous composer session has used
      its per-IP action budget (chart-adds + derived-source-creates,
      capped at 20 per 24h via the compose_action_check RPC). Real
      humans rarely hit this; bots do, fast.

      The Sign-in button reuses the existing Google OAuth flow (same as
      the Save-to-account button) with redirectTo=window.location.href
      so the in-progress composer state survives the round trip.
    -->
    <div class="cc-modal-backdrop" data-role="signin-prompt" hidden>
      <div class="cc-modal" role="dialog" aria-modal="true" aria-labelledby="signin-prompt-title">
        <div class="cc-modal-header">
          <h3 id="signin-prompt-title">Sign in to keep editing</h3>
          <button type="button" class="cc-modal-close" data-role="signin-prompt-close" aria-label="Close">&times;</button>
        </div>
        <div class="cc-modal-body">
          <p>
            You've added <strong>20 charts or sources</strong> from this network
            without an account. To keep editing — and to save dashboards so
            you can come back to them — sign in with Google.
          </p>
          <p class="muted small">
            No charges, no spam, no resale. Sign-in only lets us tell legitimate
            users apart from scripts so the free tier stays free. If you're on
            a shared network (library, office) and this seems wrong, email
            keller.scholl@gmail.com.
          </p>
        </div>
        <div class="cc-modal-footer">
          <button type="button" class="btn-secondary" data-role="signin-prompt-dismiss">Close</button>
          <button type="button" class="btn-primary" data-role="signin-prompt-signin">Sign in with Google</button>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import {
    decodeComposedState,
  } from "../lib/composer-state";
  import { createComposerGeoFilters } from "../lib/composer/geo-filter";
  import { createShareUrl } from "../lib/composer/share";
  import {
    createComposerStore,
    defaultSections,
    type UIState,
    type ChartOverride,
    type CustomChartMode,
    type ChartCombineOp,
  } from "../lib/composer/state";
  import { createMapsTab } from "../lib/composer/maps";
  import { createGeneratorsTab } from "../lib/composer/generators";
  import { createSeriesFetcher, CC_COLORS, type FetchedSeries } from "../lib/composer/series";
  import { createModalTagChips } from "../lib/composer/modal-tags";
  import { createDerivedSourceModal } from "../lib/composer/ds-modal";
  import { createCustomChartModal } from "../lib/composer/cc-modal";
  import { createGeoChips, type GeoSurface, type GeoSurfaceConfig } from "../lib/composer/geo-chips";
  import {
    DELTA_WINDOWS,
    DELTA_LABELS_SHORT,
    type DeltaWindow,
  } from "../lib/deltas";
  import {
    createSupabase,
    isSupabaseConfigured,
    readStoredSession,
    SUPABASE_REST_URL,
    SUPABASE_REST_ANON_KEY,
  } from "../lib/supabase";
  import { nanoid } from "nanoid";
  // d3-geo + topojson power the tile-preview map thumbnails. (The Maps tab's
  // own d3-brush bbox preview moved to src/lib/composer/maps.ts.) Bundler
  // tree-shakes to just these submodules so the home-page bundle stays light.
  import { geoAlbers, geoPath } from "d3-geo";
  import { feature as topoFeature } from "topojson-client";
  import * as Plot from "@observablehq/plot";
  import { track } from "../lib/track";
  import { packSourceIds } from "../lib/analytics-helpers";
  import {
    parseAnnotationLines,
    annotationsOutOfRangeSummary,
  } from "../lib/annotations";
  import { METRO_TAG } from "../lib/geographic-regions";
  import { COUNTRY_TAG } from "../lib/countries";
  import {
    CD_TAG,
    STATE_TAG,
    STATEWIDE_DISTRICT_CODE,
    parseCdSourceId,
    parseStateSourceId,
    formatDistrictLabel,
    formatCdShortLabel,
    stateNameFor,
  } from "../lib/congressional-districts";

  import {
    loadLibrary,
    type LibraryChart,
    type LibrarySource,
    type LibraryPayload,
  } from "../lib/composer/library";
  import {
    INLINE_PREFIX,
    isDerivedId,
    isInlineId,
    isInlineMapId,
  } from "../lib/composer/ids";

  const _shellMaybe = document.querySelector<HTMLElement>(".composer-shell");
  if (!_shellMaybe) throw new Error("composer shell missing");
  // Pin to a non-nullable local. The `let shell: HTMLElement = ...`
  // form would also work but a fresh const reads cleanest. Avoids
  // ~30 spurious "possibly null" errors in TS strict mode where the
  // narrowing from the if-guard doesn't propagate into closures.
  const shell: HTMLElement = _shellMaybe;
  const baseUrl = shell.dataset.baseUrl ?? "";

  // If `?edit=<slug>` is present, the composer is editing an existing saved
  // dashboard rather than creating a new one. Save becomes Update (PATCH).
  // We hold this outside the URL-encoded composed state so it never leaks
  // into shared links.
  let editingSlug: string | null = null;

  // If `?copy=1` is present, the composer was launched from a "Make a copy"
  // link on a saved dashboard. We DO want to keep the state, but NOT the
  // edit slug (a copy lands in a new row) — and we want the title to be
  // auto-incremented so the saved-dashboards list doesn't end up with two
  // "US macro" rows. The actual bump runs async after the Supabase session
  // is available (see applyCopyModeTitleBump).
  let copyMode = false;

  // ---- State ----

  // Single mutable store (Plan 2c) — see src/lib/composer/state.ts. The
  // never-reassigned slices (state, libGeo, ccModal, dsModal) are aliased so
  // the hundreds of existing references keep working unchanged; only the
  // reassigned scalars (store.sourcesSearchQuery / store.sourcesCdState / store.sourcesCdDistrict
  // / store.activeSectionIdx) are read & written as store.x.
  const store = createComposerStore();
  const state = store.state;

  // ---- URL state hydration on load ----
  function hydrateFromUrl(): void {
    const url = new URL(window.location.href);
    const editParam = url.searchParams.get("edit");
    const copyParam = url.searchParams.get("copy");
    if (copyParam === "1") {
      // Copy semantics override edit semantics — they're mutually
      // exclusive (a copy creates a NEW slug, an edit updates an
      // existing one). If both ever land in the same URL we treat it
      // as a copy.
      copyMode = true;
    } else if (editParam) {
      editingSlug = editParam;
    }
    const d = url.searchParams.get("d");
    if (!d) return;
    const res = decodeComposedState(d);
    if (!res.ok) {
      console.warn("Composed state decode failed:", res.message);
      return;
    }
    const s = res.state;
    state.title = s.title ?? "";
    state.description = s.description ?? "";
    state.defaultDelta = (s.defaultDelta as DeltaWindow | undefined) ?? "";
    state.fixedRange = s.fixedRange;
    if (s.sections && s.sections.length > 0) {
      state.sections = s.sections.map((sec) => ({
        title: sec.title,
        description: sec.description ?? "",
        charts: [...(sec.charts ?? [])],
        markdown: (sec as { markdown?: string }).markdown,
        defaultDelta: sec.defaultDelta as DeltaWindow | undefined,
        fixedRange: sec.fixedRange,
      }));
    } else if (s.charts && s.charts.length > 0) {
      state.sections = [
        { title: "Overview", description: "", charts: [...s.charts] },
      ];
    } else {
      state.sections = defaultSections();
    }
    state.inlineCharts = { ...(s.inlineCharts ?? {}) };
    state.inlineSources = { ...(s.inlineSources ?? {}) };
    state.inlineMaps = { ...(s.inlineMaps ?? {}) };
    state.chartOverrides = {
      ...((s.chartOverrides as Record<string, ChartOverride>) ?? {}),
    };
    // Preserve existing "adds go to the last section" default when a fork is loaded.
    store.activeSectionIdx = state.sections.length - 1;
  }

  // ---- URL state writing ----
  // The composed-state serializers + the share-URL writer live in
  // src/lib/composer/share.ts (Plan 2d). referencedInlineCharts /
  // referencedInlineSources / referencedChartOverrides are returned because
  // the Save-to-account path below serializes the same referenced defs.
  // editingSlug is read live (hydrateFromUrl above may set it after this runs).
  const {
    writeUrl,
    singleChartPreviewUrl,
    referencedInlineCharts,
    referencedInlineSources,
    referencedChartOverrides,
  } = createShareUrl({
    shell,
    baseUrl,
    state,
    getEditingSlug: () => editingSlug,
  });

  // (singleChartPreviewUrl + writeUrl now live in share.ts — see the factory
  //  destructure above.)

  // ---- Render ----
  let library: LibraryPayload | null = null;
  // Library panel has two tabs — Sources (primary) and Pregenerated
  // charts. Each tab keeps its own search query + selected-tag set so
  // switching tabs doesn't lose the user's current filter. The active
  // tab itself isn't kept in a module-scope variable — the DOM's
  // [aria-selected] + .lib-tab-active class on the tab buttons is
  // the source of truth, read on demand by setActiveLibTab callers.
  type LibTab = "sources" | "charts" | "maps" | "generators";
  const chartsSelectedTags: Set<string> = new Set<string>();
  const sourcesSelectedTags: Set<string> = new Set<string>();
  let chartsSearchQuery: string = "";
  // Geo-chip state. Same shape on three picker surfaces — the Sources
  // tab (libGeo), the cc-modal (ccModal.geo), and the ds-modal
  // (dsModal.geo) — so the same render/select/clear/popover code can
  // serve all three. The DOM-element selectors differ per surface;
  // the shared functions resolve them via GEO_SURFACES below.
  const libGeo = store.libGeo;

  // Per-surface state for the Congressional district drill-down. The
  // Sources tab keeps its picks across tab switches so a user browsing
  // TX-12 series doesn't lose their place when they hop to the chart
  // library tab. Parallel state lives on ccModal / dsModal for those
  // pickers; resets each modal-open.

  // Memoize the state→districts map (built from library source IDs)
  // because we look it up every time a dropdown re-renders, and rebuilding
  // it from ~2,200 source IDs on every keystroke would be wasteful.
  // Districts include the synthetic STATEWIDE_DISTRICT_CODE for any state
  // that has at least one state-level source — that's how the "Statewide"
  // dropdown option gets surfaced without special-casing the renderer.
  let cdsByStateCache: Map<string, string[]> | null = null;
  function cdsByState(state: string): string[] {
    if (!cdsByStateCache && library) {
      const m = new Map<string, Set<string>>();
      for (const id of Object.keys(library.sources)) {
        const parsedCd = parseCdSourceId(id);
        if (parsedCd) {
          if (!m.has(parsedCd.state)) m.set(parsedCd.state, new Set<string>());
          m.get(parsedCd.state)!.add(parsedCd.district);
        }
        const parsedState = parseStateSourceId(id);
        if (parsedState) {
          if (!m.has(parsedState.state))
            m.set(parsedState.state, new Set<string>());
          m.get(parsedState.state)!.add(STATEWIDE_DISTRICT_CODE);
        }
      }
      cdsByStateCache = new Map(
        [...m.entries()].map(([k, v]) => {
          // Sort districts with Statewide first (so it leads the dropdown),
          // then numeric/at-large/etc. in their natural string order.
          const list = [...v];
          list.sort((a, b) => {
            if (a === STATEWIDE_DISTRICT_CODE) return -1;
            if (b === STATEWIDE_DISTRICT_CODE) return 1;
            return a.localeCompare(b);
          });
          return [k, list];
        }),
      );
    }
    return cdsByStateCache?.get(state) ?? [];
  }

  // Distinct states represented in the library's CD or state-level
  // sources, ordered by display name. Computed once the library loads.
  function cdStatesAvailable(): string[] {
    if (!library) return [];
    const codes = new Set<string>();
    for (const id of Object.keys(library.sources)) {
      const parsedCd = parseCdSourceId(id);
      if (parsedCd) codes.add(parsedCd.state);
      const parsedState = parseStateSourceId(id);
      if (parsedState) codes.add(parsedState.state);
    }
    return [...codes].sort((a, b) =>
      stateNameFor(a).localeCompare(stateNameFor(b)),
    );
  }

  // Geo-region-visibility rules for one source ID + its tag list, shared by all
  // three picker surfaces (Sources tab, cc-modal, ds-modal). The matching logic
  // now lives in src/lib/source-filters.ts (pure + unit-tested, shared with
  // SourcePicker + the alerts page); createComposerGeoFilters binds it to the
  // composer's `library` and restores the per-query unlock memo + the CD chip's
  // "pick a state" gate. See src/lib/composer/geo-filter.ts (+ its parity test).
  //
  //   - Chip OFF: hide everything tagged CD_TAG / STATE_TAG (non-geo passes; a
  //     >=4-char state-name query unlocks that state's geo sources).
  //   - Chip ON, no state: hide all geo sources (the state pick is the gate).
  //   - Chip ON + state[, district]: keep that state's series per the district.
  const {
    passesCdFilter,
    passesMetroFilter,
    passesCountryFilter,
    passesCountyFilter,
  } = createComposerGeoFilters(() => library);

  // Maps tab — its form / d3 bbox preview / add-map logic lives in
  // src/lib/composer/maps.ts (Plan 2d). renderMapBuilder is the only entry
  // point (called by the library tab switch); the rest is factory-internal.
  // The topojson cache stays here — the tile-preview thumbnails share it.
  const mapBboxTopoCache = new Map<string, unknown>();
  const { renderMapBuilder } = createMapsTab({
    shell,
    state,
    store,
    mapBboxTopoCache,
    escapeHtml,
    renderComposition,
    writeUrl,
    checkComposeAction,
    showSigninPrompt,
    clampActiveSection,
  });

  // Generators tab — the mass-generate builder lives in
  // src/lib/composer/generators.ts (Plan 2d). renderGeneratorsBuilder is the
  // only entry point (the library tab switch awaits it).
  const { renderGeneratorsBuilder } = createGeneratorsTab({
    shell,
    baseUrl,
    state,
    store,
    escapeHtml,
    renderComposition,
    writeUrl,
    checkComposeAction,
    showSigninPrompt,
    clampActiveSection,
  });

  // Shared source-series fetcher (Plan 2d) — used by the tile-preview
  // thumbnails AND the custom-chart preview. One instance = one shared cache.
  const { fetchSourceSeries } = createSeriesFetcher({
    getLibrary: () => library,
    baseUrl,
    state,
  });

  // Shared modal tag-chip strip (Plan 2d) -- the topical-tag pills rendered by
  // BOTH the cc-modal and ds-modal source pickers. Geo chips render separately,
  // in the geo-chips strip above each modal tag row.
  const { renderModalTagChips } = createModalTagChips({
    shell,
    getLibrary: () => library,
    state,
  });

  // Shared geo-chip subsystem (Plan 2d) -- metro/country/CD chips for lib/cc/ds
  // live in src/lib/composer/geo-chips.ts. Built BEFORE the cc/ds factories
  // (they take these renderers via ctx). getSurfaceConfig = geoSurfaceConfig
  // (stays in compose, wires each surface); appendCdDrillDown stays in compose.
  const { renderMetroChip, renderCdChip, renderCountryChip, wireGeoChips } =
    createGeoChips({
      shell,
      getLibrary: () => library,
      getSurfaceConfig: geoSurfaceConfig,
      appendCdDrillDown,
      escapeHtml,
    });

  // Custom-chart modal + cc-preview (Plan 2d) -- the "+ Custom chart" builder
  // lives in src/lib/composer/cc-modal.ts. createCustomChartModal(ctx) returns
  // the entry points; renderCustomChartSources + renderCcModalTagChips are also
  // used by geoSurfaceConfig (cc surface), and renderCustomChartSources by
  // ds-modal (passed into its ctx) -- so this factory is built BEFORE ds-modal.
  const {
    openCustomChartModal,
    wireCustomChartModal,
    openMergeModal,
    renderCustomChartSources,
    renderCcModalTagChips,
  } = createCustomChartModal({
    shell,
    store,
    state,
    getLibrary: () => library,
    fetchSourceSeries,
    escapeHtml,
    renderComposition,
    writeUrl,
    clampActiveSection,
    passesCdFilter,
    passesMetroFilter,
    passesCountryFilter,
    passesCountyFilter,
    renderModalTagChips,
    renderMetroChip,
    renderCdChip,
    renderCountryChip,
    wireGeoChips,
    chartEffectiveSpec,
    baseTitleIsDefault,
    updateCcAnnotationsWarning,
    dismissHoverMergeTip,
    isHoverMergeTipDismissed,
  });

  // Derived-source modal (Plan 2d) -- the "+ Derived source" builder lives in
  // src/lib/composer/ds-modal.ts. createDerivedSourceModal(ctx) returns the
  // entry points; renderDsPicker / renderDsModalTagChips are also used by
  // geoSurfaceConfig (the shared geo-chip wiring) for the "ds" surface.
  const {
    openDerivedSourceModal,
    wireDerivedSourceModal,
    renderDsPicker,
    renderDsModalTagChips,
  } = createDerivedSourceModal({
    shell,
    store,
    state,
    getLibrary: () => library,
    passesCdFilter,
    passesMetroFilter,
    passesCountryFilter,
    renderModalTagChips,
    renderMetroChip,
    renderCdChip,
    renderCountryChip,
    wireGeoChips,
    checkComposeAction,
    showSigninPrompt,
    clampActiveSection,
    writeUrl,
    renderComposition,
    renderCustomChartSources,
  });

  // Index of the currently-focused section. Library clicks append here.

  function setActiveSection(idx: number): void {
    if (idx < 0 || idx >= state.sections.length) return;
    if (store.activeSectionIdx === idx) return;
    store.activeSectionIdx = idx;
    renderComposition();
  }

  function clampActiveSection(): void {
    if (store.activeSectionIdx >= state.sections.length) {
      store.activeSectionIdx = Math.max(0, state.sections.length - 1);
    }
  }

  function allChartTags(): string[] {
    if (!library) return [];
    const s = new Set<string>();
    for (const c of library.charts) for (const t of c.tags) s.add(t);
    return [...s].sort();
  }

  function allSourceTags(): string[] {
    if (!library) return [];
    const s = new Set<string>();
    for (const id of Object.keys(library.sources)) {
      const src = library.sources[id] as LibrarySource & { tags?: string[] };
      for (const t of src.tags ?? []) {
        // Hide synthetic metro tags from the tag-pill strip — they're
        // surfaced through the dedicated Metro chip + dropdown instead.
        // Filters both the bare `metro` tag and per-CBSA `metro:35620`
        // entries; users still see them via the geo chip's UI.
        if (t === METRO_TAG || t.startsWith(`${METRO_TAG}:`)) continue;
        // Same idea for country/region synthetic tags — surfaced via
        // the "Countries & regions" chip, not the topical pill strip.
        if (t === COUNTRY_TAG || t.startsWith(`${COUNTRY_TAG}:`)) continue;
        s.add(t);
      }
    }
    return [...s].sort();
  }

  function filteredCharts(): LibraryChart[] {
    if (!library) return [];
    const q = chartsSearchQuery.trim().toLowerCase();
    const tagsRequired = [...chartsSelectedTags];
    return library.charts.filter((c) => {
      // Multi-tag: every selected tag must be present (AND).
      for (const t of tagsRequired) {
        if (!c.tags.includes(t)) return false;
      }
      if (q) {
        // Server pre-built searchText (lowercased) when available; otherwise
        // synthesize from id/title/tags.
        const hay =
          (c as LibraryChart & { searchText?: string }).searchText ??
          (c.title + " " + c.id + " " + c.tags.join(" ")).toLowerCase();
        if (!hay.includes(q)) return false;
      }
      return true;
    });
  }

  // Parallel to filteredCharts but over the source universe. Sources
  // have tags + searchText set on the server by library.json.ts; we
  // mirror the AND-across-tags / case-insensitive search semantics.
  function filteredSources(): (LibrarySource & {
    id: string;
    tags: string[];
    searchText: string;
  })[] {
    if (!library) return [];
    const q = store.sourcesSearchQuery.trim().toLowerCase();
    // CD_TAG in the selected set is the master "States & districts" chip
    // toggle, not a literal tag a source must carry — passesCdFilter
    // already enforces the geo gate. State-level sources have STATE_TAG
    // (not CD_TAG), so leaving CD_TAG in the AND list rejects them.
    const tagsRequired = [...sourcesSelectedTags].filter((t) => t !== CD_TAG);
    const out: (LibrarySource & {
      id: string;
      tags: string[];
      searchText: string;
    })[] = [];
    for (const id of Object.keys(library.sources)) {
      const src = library.sources[id] as LibrarySource & {
        id?: string;
        tags?: string[];
        searchText?: string;
      };
      const tags = src.tags ?? [];
      // CD-visibility gate runs before tag-AND so that a user with the CD
      // chip off never sees any CD source, regardless of what other tag
      // chips they've selected.
      if (
        !passesCdFilter(
          id,
          tags,
          sourcesSelectedTags,
          store.sourcesCdState,
          store.sourcesCdDistrict,
          q,
        )
      ) {
        continue;
      }
      let ok = true;
      for (const t of tagsRequired) {
        if (!tags.includes(t)) {
          ok = false;
          break;
        }
      }
      if (!ok) continue;
      if (!passesMetroFilter(tags, libGeo.selectedMetroCbsa, q)) continue;
      if (!passesCountryFilter(tags, libGeo.selectedCountryCode, q)) continue;
      if (!passesCountyFilter(id, tags, q)) continue;
      // Synthetic geo-discovery hints (kind === "hint"): drop when
      // the query is empty so they don't clutter an unprompted browse.
      // When a query exists, they share the same text-search match
      // logic as real sources — their server-built searchText
      // intentionally covers every series name available at the
      // hint's level plus level-name synonyms.
      if (src.kind === "hint" && !q) continue;
      if (q) {
        const hay =
          src.searchText ??
          (src.name + " " + (src.shortName ?? "") + " " + id + " " + tags.join(" "))
            .toLowerCase();
        if (!hay.includes(q)) continue;
      }
      out.push({
        ...src,
        id,
        tags,
        searchText: src.searchText ?? "",
      });
    }
    // Source-picker ordering: by name. The categoryLabel-style folder
    // grouping used for charts doesn't help much for sources whose IDs
    // are mostly pipeline/<ticker> — a flat alphabetical list reads
    // cleaner. Hint cards stay together at the TOP regardless of
    // the alphabetical sort below, ordered by the hint.order field
    // (country → state → cd → metro → county → tract → bg).
    out.sort((a, b) => {
      const aIsHint = a.kind === "hint";
      const bIsHint = b.kind === "hint";
      if (aIsHint && !bIsHint) return -1;
      if (bIsHint && !aIsHint) return 1;
      if (aIsHint && bIsHint) {
        const ao = (a as LibrarySource & { order?: number }).order ?? 0;
        const bo = (b as LibrarySource & { order?: number }).order ?? 0;
        return ao - bo;
      }
      return a.name.localeCompare(b.name);
    });
    return out;
  }

  // Pretty label for the chart-folder prefix used as a category grouping.
  function categoryLabel(prefix: string): string {
    const map: Record<string, string> = {
      "us-macro": "US macro",
      "real-estate": "Real estate",
      tech: "Tech",
      stocks: "Stocks",
      countries: "Countries",
      commodities: "Commodities",
      markets: "Markets",
      oil: "Oil & energy",
      crypto: "Crypto",
      fx: "FX",
      government: "Government finances",
    };
    return map[prefix] ?? prefix;
  }

  function renderTagFiltersCharts(): void {
    const host = shell.querySelector<HTMLElement>(
      "[data-role='tag-filters-charts']",
    );
    if (!host || !library) return;
    const tags = allChartTags();
    host.innerHTML = "";
    const makeBtn = (tag: string, label: string, active: boolean) => {
      const b = document.createElement("button");
      b.type = "button";
      b.className = "tag-pill" + (active ? " tag-pill-active" : "");
      b.textContent = label;
      b.addEventListener("click", () => {
        if (tag === "") {
          chartsSelectedTags.clear();
        } else if (chartsSelectedTags.has(tag)) {
          chartsSelectedTags.delete(tag);
        } else {
          chartsSelectedTags.add(tag);
        }
        renderTagFiltersCharts();
        renderChartsList();
      });
      return b;
    };
    host.appendChild(
      makeBtn("", `all (${library.charts.length})`, chartsSelectedTags.size === 0),
    );
    for (const t of tags) {
      const count = library.charts.filter((c) => c.tags.includes(t)).length;
      host.appendChild(makeBtn(t, `${t} (${count})`, chartsSelectedTags.has(t)));
    }
  }

  // ---- Geo-chip system (Metro + Countries & regions) ----
  //
  // Three picker surfaces share the same chip behavior so the user has
  // identical UX for finding sources:
  //   • "lib"  — the Sources tab on the compose page (data-role
  //               prefix: lib-metro-* / lib-country-*).
  //   • "cc"   — the New custom chart (edit chart) modal (cc-metro-*,
  //               cc-country-*).
  //   • "ds"   — the New derived source modal (ds-metro-*,
  //               ds-country-*; two source lists rerender on change).
  //
  // Per-surface state lives in libGeo / ccModal.geo / dsModal.geo
  // (same GeoState shape). The render/open/close/select/clear
  // functions take a surface key, look up the state + the DOM
  // selectors + the right "redraw source list" callback, and act on
  // them. Adding a fourth surface later means adding an entry to
  // GEO_SURFACES, not duplicating ~200 lines.
  function geoSurfaceConfig(surface: GeoSurface): GeoSurfaceConfig {
    if (surface === "lib") {
      return {
        prefix: "lib",
        state: () => libGeo,
        // Refresh the tag-pill counts too: a geo-chip pick changes the
        // visible universe, so each topical tag's count must update or
        // the user sees stale "(N)" pills.
        onChange: () => {
          renderTagFiltersSources();
          renderSourcesList();
        },
        track: (e, p) => track(e, { ...p, surface: "compose-sources" }),
        cdSelectedTags: () => sourcesSelectedTags,
        getCdState: () => store.sourcesCdState,
        setCdState: (v) => { store.sourcesCdState = v; },
        getCdDistrict: () => store.sourcesCdDistrict,
        setCdDistrict: (v) => { store.sourcesCdDistrict = v; },
        refreshTags: () => renderTagFiltersSources(),
      };
    }
    if (surface === "cc") {
      return {
        prefix: "cc",
        state: () => ccModal.geo,
        onChange: () => renderCustomChartSources(),
        track: (e, p) => track(e, { ...p, surface: "cc-modal" }),
        cdSelectedTags: () => ccModal.pickerTags,
        getCdState: () => ccModal.cdState,
        setCdState: (v) => { ccModal.cdState = v; },
        getCdDistrict: () => ccModal.cdDistrict,
        setCdDistrict: (v) => { ccModal.cdDistrict = v; },
        refreshTags: () => renderCcModalTagChips(),
      };
    }
    return {
      prefix: "ds",
      state: () => dsModal.geo,
      // ds-modal has TWO source lists (A operand + B operand) — both
      // need to re-render on filter change.
      onChange: () => {
        renderDsPicker("a");
        renderDsPicker("b");
      },
      track: (e, p) => track(e, { ...p, surface: "ds-modal" }),
      cdSelectedTags: () => dsModal.pickerTags,
      getCdState: () => dsModal.cdState,
      setCdState: (v) => { dsModal.cdState = v; },
      getCdDistrict: () => dsModal.cdDistrict,
      setCdDistrict: (v) => { dsModal.cdDistrict = v; },
      refreshTags: () => renderDsModalTagChips(),
    };
  }
  // The geo-chip subsystem (metro/country/CD chips for lib/cc/ds) moved to
  // src/lib/composer/geo-chips.ts (Plan 2d). createGeoChips is destructured
  // above (before the cc/ds factories); geoSurfaceConfig + appendCdDrillDown
  // stay here. The 4 entry renderers flow into the lib surface + cc/ds ctx.

  // Parallel tag-filter strip for the Sources tab. Same UX pattern;
  // counts run against the source universe instead of charts. The
  // `congressional-district` tag is rendered specially as a drill-down
  // chip (state → district) at the end of the strip; see
  // appendCdDrillDown below.
  function renderTagFiltersSources(): void {
    const host = shell.querySelector<HTMLElement>(
      "[data-role='tag-filters-sources']",
    );
    if (!host || !library) return;
    const tags = allSourceTags();
    host.innerHTML = "";
    // Counts must reflect the SAME filter pipeline the source list uses
    // — chip state + search query + selected topical tags. Otherwise
    // the user sees "fiscal (6)" with "abil" typed, clicks fiscal, and
    // gets zero results because all six fiscal sources fail the
    // metro-only narrowing.
    //
    // Performance: one walk of `library.sources` instead of N tags ×
    // sources. For each source that passes the current filters, we
    // bump a counter for each of its topical tags (so we know exactly
    // how many results adding that tag would yield). 20k sources × ~5
    // tags each beats 50 tags × 20k sources × 3 unlock-cost-per-source
    // by ~3 orders of magnitude — the previous shape froze the UI
    // around the 4-char unlock boundary.
    const q = store.sourcesSearchQuery.trim().toLowerCase();
    const tagsRequired = [...sourcesSelectedTags].filter((t) => t !== CD_TAG);
    const libSources = library.sources;
    let allCount = 0;
    const tagCounts = new Map<string, number>();
    for (const id of Object.keys(libSources)) {
      const src = libSources[id] as LibrarySource & {
        tags?: string[];
        searchText?: string;
      };
      const sTags = src.tags ?? [];
      if (!passesCdFilter(id, sTags, sourcesSelectedTags, store.sourcesCdState, store.sourcesCdDistrict, q)) continue;
      if (!passesMetroFilter(sTags, libGeo.selectedMetroCbsa, q)) continue;
      if (!passesCountryFilter(sTags, libGeo.selectedCountryCode, q)) continue;
      if (!passesCountyFilter(id, sTags, q)) continue;
      let ok = true;
      for (const t of tagsRequired) {
        if (!sTags.includes(t)) { ok = false; break; }
      }
      if (!ok) continue;
      if (q) {
        const hay = src.searchText ??
          (src.name + " " + (src.shortName ?? "") + " " + id + " " + sTags.join(" ")).toLowerCase();
        if (!hay.includes(q)) continue;
      }
      allCount += 1;
      // Bucket per-tag for pill counts. Skip geo synthetic tags —
      // they're rendered through the geo chips, not as topical pills.
      for (const t of sTags) {
        if (t === CD_TAG || t === STATE_TAG) continue;
        if (t === COUNTRY_TAG || t.startsWith(`${COUNTRY_TAG}:`)) continue;
        if (t === METRO_TAG || t.startsWith(`${METRO_TAG}:`)) continue;
        tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
      }
    }
    const makeBtn = (tag: string, label: string, active: boolean) => {
      const b = document.createElement("button");
      b.type = "button";
      b.className = "tag-pill" + (active ? " tag-pill-active" : "");
      b.textContent = label;
      b.addEventListener("click", () => {
        if (tag === "") {
          sourcesSelectedTags.clear();
          store.sourcesCdState = null;
          store.sourcesCdDistrict = null;
        } else if (sourcesSelectedTags.has(tag)) {
          sourcesSelectedTags.delete(tag);
        } else {
          sourcesSelectedTags.add(tag);
        }
        renderTagFiltersSources();
        renderSourcesList();
      });
      return b;
    };
    host.appendChild(
      makeBtn("", `all (${allCount})`, sourcesSelectedTags.size === 0),
    );
    // The CD / metro / country chips live in the geo strip ABOVE this
    // row (renderCdChip, renderMetroChip, renderCountryChip). Topical
    // tags only here.
    // Geo breakdown active = a metro, country, or congressional-district
    // filter is engaged. At the plain "All" level a topical tag matching
    // only 1-2 sources is more clutter than help, so require >=3 to show
    // its pill; inside a geo drill-down (where per-place counts are
    // naturally small) keep the looser >=1 so refinements stay visible.
    const geoBreakdownActive =
      !!libGeo.selectedMetroCbsa ||
      !!libGeo.selectedCountryCode ||
      sourcesSelectedTags.has(CD_TAG);
    const minTagCount = geoBreakdownActive ? 1 : 3;
    for (const t of tags) {
      if (t === CD_TAG || t === STATE_TAG) continue; // surfaced via CD chip
      if (t === COUNTRY_TAG || t.startsWith(`${COUNTRY_TAG}:`)) continue; // country chip
      const count = tagCounts.get(t) ?? 0;
      // Hide sparse pills: a 0-count pill yields nothing, and at the All
      // level a 1-2 count pill is just noise (see minTagCount above).
      if (count < minTagCount) continue;
      host.appendChild(makeBtn(t, `${t} (${count})`, sourcesSelectedTags.has(t)));
    }
  }

  // Shared CD drill-down renderer used by all three picker surfaces. Adds
  // the "Congressional district" toggle chip; when active, appends a
  // State dropdown and (once state is picked) a District dropdown. The
  // getter / setter pairs keep this function neutral with respect to
  // which surface owns the state — each caller threads its own (state,
  // district, rerender) trio in.
  function appendCdDrillDown(
    host: HTMLElement,
    selectedTags: Set<string>,
    getState: () => string | null,
    setState: (v: string | null) => void,
    getDistrict: () => string | null,
    setDistrict: (v: string | null) => void,
    rerender: () => void,
  ): void {
    if (!library) return;
    // Total geo source count (CD + state-level series, across all states
    // + districts) shown on the chip so the user has a sense of what
    // they're toggling on.
    let geoCount = 0;
    for (const id of Object.keys(library.sources)) {
      const src = library.sources[id] as LibrarySource & { tags?: string[] };
      const tags = src.tags ?? [];
      if (tags.includes(CD_TAG) || tags.includes(STATE_TAG)) geoCount += 1;
    }
    const active = selectedTags.has(CD_TAG);
    const chip = document.createElement("button");
    chip.type = "button";
    chip.className = "tag-pill cd-tag-pill" + (active ? " tag-pill-active" : "");
    chip.textContent = `States & districts (${geoCount})`;
    chip.addEventListener("click", () => {
      if (selectedTags.has(CD_TAG)) {
        selectedTags.delete(CD_TAG);
        setState(null);
        setDistrict(null);
      } else {
        selectedTags.add(CD_TAG);
      }
      rerender();
    });
    host.appendChild(chip);
    if (!active) return;

    // State dropdown. Only states with at least one CD source appear,
    // ordered by display name so it reads alphabetically.
    const stateSel = document.createElement("select");
    stateSel.className = "cd-drilldown-select";
    stateSel.setAttribute("aria-label", "Congressional district — state");
    const promptOpt = document.createElement("option");
    promptOpt.value = "";
    promptOpt.textContent = "Pick a state…";
    stateSel.appendChild(promptOpt);
    const currentState = getState();
    for (const code of cdStatesAvailable()) {
      const o = document.createElement("option");
      o.value = code;
      o.textContent = stateNameFor(code);
      if (code === currentState) o.selected = true;
      stateSel.appendChild(o);
    }
    stateSel.addEventListener("change", () => {
      setState(stateSel.value || null);
      // Clearing the district whenever state changes avoids the awkward
      // "state=TX district=07 set; user picks CA → district stays as 07"
      // edge case where the old district might not exist in the new state.
      setDistrict(null);
      rerender();
    });
    host.appendChild(stateSel);

    // District dropdown only appears once a state is picked. "All districts"
    // is the no-narrowing option so a user can browse all of a state's CDs
    // before zeroing in on one.
    if (!currentState) return;
    const distSel = document.createElement("select");
    distSel.className = "cd-drilldown-select";
    distSel.setAttribute("aria-label", "Congressional district — district");
    const allOpt = document.createElement("option");
    allOpt.value = "";
    allOpt.textContent = "All districts";
    distSel.appendChild(allOpt);
    const currentDistrict = getDistrict();
    for (const dCode of cdsByState(currentState)) {
      const o = document.createElement("option");
      o.value = dCode;
      o.textContent = formatDistrictLabel(currentState, dCode);
      if (dCode === currentDistrict) o.selected = true;
      distSel.appendChild(o);
    }
    distSel.addEventListener("change", () => {
      setDistrict(distSel.value || null);
      rerender();
    });
    host.appendChild(distSel);
  }

  function renderChartsList(): void {
    const host = shell.querySelector<HTMLElement>(
      "[data-role='lib-results-charts']",
    );
    if (!host) return;
    const charts = filteredCharts();
    host.innerHTML = "";
    if (charts.length === 0) {
      host.innerHTML =
        '<p class="muted small">No charts match. Feel free to request one at <a href="mailto:keller.scholl@gmail.com">keller.scholl@gmail.com</a>.</p>';
      return;
    }
    // Group by chart-folder prefix (e.g. "us-macro/foo" → "us-macro"). Keeps
    // the result list scannable when many results are returned.
    const groups = new Map<string, LibraryChart[]>();
    for (const c of charts) {
      const prefix = c.id.includes("/") ? c.id.split("/")[0] : "other";
      if (!groups.has(prefix)) groups.set(prefix, []);
      groups.get(prefix)!.push(c);
    }
    const orderedPrefixes = [...groups.keys()].sort((a, b) =>
      categoryLabel(a).localeCompare(categoryLabel(b)),
    );
    for (const prefix of orderedPrefixes) {
      const group = groups.get(prefix)!;
      const heading = document.createElement("div");
      heading.className = "lib-group-heading";
      heading.textContent = `${categoryLabel(prefix)} (${group.length})`;
      host.appendChild(heading);
      for (const c of group) {
      const card = document.createElement("button");
      card.type = "button";
      card.className = "chart-card";
      card.dataset.chartId = c.id;
      card.innerHTML =
        `<div class="chart-card-title">${escapeHtml(c.title)}</div>` +
        `<div class="chart-card-meta">${c.tags.map(escapeHtml).join(" \u00b7 ")}</div>`;
      card.addEventListener("click", () => {
        void addChart(c.id);
      });
      host.appendChild(card);
      }
    }
  }

  // Parallel renderer for the Sources tab. Each card shows the source
  // name, short-name/ticker if distinct, the tag list, and a one-line
  // description. Clicking adds the source as a single-series inline
  // chart to the active section \u2014 the dominant case is "track this".
  function renderSourcesList(): void {
    const host = shell.querySelector<HTMLElement>(
      "[data-role='lib-results-sources']",
    );
    if (!host) return;
    const sources = filteredSources();
    host.innerHTML = "";
    if (sources.length === 0) {
      // Tailored empty-state copy for the CD drill-down: an unfiltered
      // empty list almost certainly means the user activated the CD
      // chip and hasn't picked a state yet, not that we have no data.
      if (sourcesSelectedTags.has(CD_TAG) && !store.sourcesCdState) {
        host.innerHTML =
          '<p class="muted small">Pick a state above to see its statewide and congressional-district series.</p>';
      } else {
        host.innerHTML =
          '<p class="muted small">No sources match. Feel free to request one at <a href="mailto:keller.scholl@gmail.com">keller.scholl@gmail.com</a>.</p>';
      }
      return;
    }
    for (const s of sources) {
      // Synthetic hint cards: render with a distinct style + a click
      // handler that engages the relevant geo chip instead of adding
      // a chart. Hints never become inline sources / charts \u2014 they
      // exist purely to bridge the discoverability gap between
      // "search for unemployment" and "geographic data exists at
      // level X." Sourced from src/lib/source-hints.ts.
      if (s.kind === "hint") {
        const chip = (s as LibrarySource & { chip?: string }).chip ?? "";
        const card = document.createElement("button");
        card.type = "button";
        card.className = "source-card source-card-hint";
        card.dataset.sourceId = s.id;
        card.dataset.hintChip = chip;
        const desc = s.description
          ? `<div class="source-card-desc">${escapeHtml(s.description)}</div>`
          : "";
        card.innerHTML =
          `<div class="source-card-title"><span class="source-card-hint-eyebrow">See also</span>${escapeHtml(s.name)}</div>` +
          desc;
        card.addEventListener("click", () => engageHintChip(chip));
        host.appendChild(card);
        continue;
      }
      const card = document.createElement("button");
      card.type = "button";
      card.className = "source-card";
      card.dataset.sourceId = s.id;
      // Geo sources get a state/district badge regardless of the source's
      // own shortName \u2014 when the user is browsing a state's series, the
      // district code is what they're scanning for. CDs read as "TX-12";
      // state-level series read as "TX statewide" so the two scopes are
      // visually distinct in the same list.
      const cdParsed = parseCdSourceId(s.id);
      const statePar = parseStateSourceId(s.id);
      let geoBadge = "";
      if (cdParsed) {
        geoBadge =
          `<span class="source-card-short source-card-cd-badge">${escapeHtml(formatCdShortLabel(cdParsed.state, cdParsed.district))}</span>`;
      } else if (statePar) {
        geoBadge =
          `<span class="source-card-short source-card-cd-badge">${escapeHtml(`${statePar.state.toUpperCase()} statewide`)}</span>`;
      }
      const shortBadge =
        !cdParsed && !statePar && s.shortName && s.shortName !== s.name
          ? `<span class="source-card-short">${escapeHtml(s.shortName)}</span>`
          : "";
      const tagsLine =
        s.tags.length > 0
          ? `<div class="source-card-tags">${s.tags.map(escapeHtml).join(" \u00b7 ")}</div>`
          : "";
      const desc = s.description
        ? `<div class="source-card-desc">${escapeHtml(s.description)}</div>`
        : "";
      card.innerHTML =
        `<div class="source-card-title">${escapeHtml(s.name)}${geoBadge}${shortBadge}</div>` +
        desc +
        tagsLine;
      card.addEventListener("click", () => {
        void addSourceAsChart(s.id);
      });
      host.appendChild(card);
    }
  }

  /**
   * Handle a click on a source-hint card. Engages the relevant
   * geo chip + clears the search field so the user sees the
   * sources that were hiding behind the chip. For tract / block-
   * group hints (chip === "maps-tab") we switch to the Maps tab
   * since those levels live there, not in Sources.
   */
  function engageHintChip(chip: string): void {
    const searchInput = shell.querySelector<HTMLInputElement>(
      "[data-role='lib-sources-search']",
    );
    if (chip === "maps-tab") {
      setActiveLibTab("maps");
      return;
    }
    if (chip === "metro") {
      // Open the metro popover so the user can pick a CBSA. No
      // default selection \u2014 they have to choose.
      const trigger = shell.querySelector<HTMLButtonElement>(
        "[data-role='lib-metro-chip']",
      );
      trigger?.click();
      // Clear the typed search so the chip's full result list is
      // visible (the search filter would otherwise still apply).
      if (searchInput) {
        searchInput.value = "";
        store.sourcesSearchQuery = "";
      }
      renderTagFiltersSources();
      renderSourcesList();
      return;
    }
    if (chip === "country") {
      const trigger = shell.querySelector<HTMLButtonElement>(
        "[data-role='lib-country-chip']",
      );
      trigger?.click();
      if (searchInput) {
        searchInput.value = "";
        store.sourcesSearchQuery = "";
      }
      renderTagFiltersSources();
      renderSourcesList();
      return;
    }
    if (chip === "cd") {
      // States & districts chip toggles via the tag-pill set
      // (CD_TAG sits in sourcesSelectedTags). Add it if missing
      // and clear the search.
      sourcesSelectedTags.add(CD_TAG);
      if (searchInput) {
        searchInput.value = "";
        store.sourcesSearchQuery = "";
      }
      renderTagFiltersSources();
      renderSourcesList();
      return;
    }
    if (chip === "county") {
      // No dedicated county chip yet \u2014 the hint copy instructs the
      // user to type the county name. We can't engage anything
      // useful programmatically; leave the search field intact so
      // they can continue typing.
      return;
    }
  }

  // Switch which library tab is showing. Tab buttons toggle aria-selected
  // + an active class; the two panels are direct siblings with `hidden`
  // attributes that swap. Re-renders the active tab in case its data
  // has changed since last view (e.g., a derived source was just added,
  // which the Sources tab should now show in its list).
  function setActiveLibTab(tab: LibTab): void {
    shell.querySelectorAll<HTMLButtonElement>("[data-role='lib-tab']").forEach((btn) => {
      const active = btn.dataset.tab === tab;
      btn.classList.toggle("lib-tab-active", active);
      btn.setAttribute("aria-selected", active ? "true" : "false");
    });
    // Tag the library shell with which tab is active so CSS can react —
    // the Maps tab specifically wants to cancel the panel-local
    // max-height so its "+ Add map" button can't get tucked under a
    // scrollbar. Other tabs keep the height cap (their result lists
    // scroll internally instead).
    const libraryHost = shell.querySelector<HTMLElement>(".composer-library");
    if (libraryHost) libraryHost.dataset.activeTab = tab;
    const panelSources = shell.querySelector<HTMLElement>(
      "[data-role='lib-panel-sources']",
    );
    const panelCharts = shell.querySelector<HTMLElement>(
      "[data-role='lib-panel-charts']",
    );
    const panelMaps = shell.querySelector<HTMLElement>(
      "[data-role='lib-panel-maps']",
    );
    const panelGenerators = shell.querySelector<HTMLElement>(
      "[data-role='lib-panel-generators']",
    );
    if (panelSources) panelSources.hidden = tab !== "sources";
    if (panelCharts) panelCharts.hidden = tab !== "charts";
    if (panelMaps) panelMaps.hidden = tab !== "maps";
    if (panelGenerators) panelGenerators.hidden = tab !== "generators";
    if (tab === "sources") {
      renderTagFiltersSources();
      renderSourcesList();
    } else if (tab === "charts") {
      renderTagFiltersCharts();
      renderChartsList();
    } else if (tab === "maps") {
      renderMapBuilder();
    } else if (tab === "generators") {
      void renderGeneratorsBuilder();
    }
    track("compose_lib_tab_switched", { tab });
  }

  // Promote a library chart in-place to an inline chart so the user
  // can fully edit it (sources, scale, mode, log, blurb, etc.) via
  // the cc-modal. Copies every editable field from the library chart's
  // spec into a fresh state.inlineCharts entry, then swaps the section's
  // reference to point at the new inline ID. The library chart YAML is
  // untouched; the inline copy is the user's working version going
  // forward.
  //
  // Returns the new inline chart ID (or null if the library entry was
  // missing). Caller is responsible for re-rendering composition + URL
  // state.
  function promoteLibraryChartToInline(
    libraryChartId: string,
    secIdx: number,
    chartIdx: number,
  ): string | null {
    const lib = library?.charts.find((c) => c.id === libraryChartId);
    if (!lib) return null;
    const inlineId = INLINE_PREFIX + nanoid(8);
    const override = state.chartOverrides[libraryChartId];
    // Override fields (title, blurb) win over library defaults \u2014 the
    // user's prior tweaks shouldn't get reset by an edit.
    state.inlineCharts[inlineId] = {
      title: override?.title || lib.title,
      sources: [...(lib.sources ?? [])],
      normalize: lib.normalize as CustomChartMode | undefined,
      scale: (lib as { scale?: "linear" | "log" }).scale,
      rightAxisSources: (lib as { rightAxisSources?: string[] }).rightAxisSources,
      op: (lib as { op?: ChartCombineOp }).op,
      blurb: override?.blurb || lib.blurb,
      percentDisplay: (lib as { percentDisplay?: "percent" | "decimal" })
        .percentDisplay,
    };
    const sec = state.sections[secIdx];
    if (sec && sec.charts[chartIdx] === libraryChartId) {
      sec.charts[chartIdx] = inlineId;
    }
    // The promoted inline copy now carries the title / blurb itself,
    // so the per-chart override on the original library ID is dead
    // weight. Drop it.
    if (override) delete state.chartOverrides[libraryChartId];
    track("compose_chart_promoted_to_inline", {
      from: libraryChartId,
      to: inlineId,
    });
    return inlineId;
  }

  // Add a library source as a single-series inline chart to the active
  // section. This is the new dominant path for "I want to track X" \u2014
  // separate from addChart() (pregenerated multi-source compositions)
  // and from the derived-source modal (computed ratios / sums / diffs).
  async function addSourceAsChart(sourceId: string): Promise<void> {
    clampActiveSection();
    const target = state.sections[store.activeSectionIdx];
    if (!target) return;
    const allowed = await checkComposeAction("add_source_as_chart");
    if (!allowed) {
      showSigninPrompt("add_source_as_chart");
      return;
    }
    const sourceMeta = library?.sources[sourceId] as
      | (LibrarySource & { name?: string })
      | undefined;
    const chartId = INLINE_PREFIX + nanoid(8);
    // Seed the chart's editorial annotations from the source's defaults
    // (e.g. FEC per-district redistricting boundary notes). The user can
    // edit or clear them in the chart-config modal — they're a starting
    // point, not a lock, so we materialize them into the spec rather than
    // re-deriving at render time (which would fight a user's removal).
    const seededAnnotations = sourceMeta?.defaultAnnotations;
    state.inlineCharts[chartId] = {
      title: sourceMeta?.name ?? sourceId,
      sources: [sourceId],
      normalize: "raw",
      ...(seededAnnotations && seededAnnotations.length
        ? { annotations: seededAnnotations }
        : {}),
    };
    target.charts.push(chartId);
    writeUrl();
    renderComposition();
    track("compose_source_added_as_chart", {
      sourceId,
      source: "library",
    });
  }

  // ---- Chart-spec helpers (shared by hover-merge + drag) ----
  // Resolve a chart's source-ID list, regardless of whether it's a library
  // or inline chart. Used to detect "single-source" charts for the hover-
  // merge interaction and to pre-fill the cc-modal on merge launch.
  function chartSourceIds(chartId: string): string[] {
    if (isInlineId(chartId)) {
      return state.inlineCharts[chartId]?.sources ?? [];
    }
    return library?.charts.find((c) => c.id === chartId)?.sources ?? [];
  }

  function isSingleSourceChart(chartId: string): boolean {
    return chartSourceIds(chartId).length === 1;
  }

  // Has the user customized this chart's title, or is it still the chart's
  // out-of-the-box default? Used by the hover-merge launcher to decide
  // whether to auto-rename the merged chart (default → recompose from
  // sources) or preserve a user-written title.
  //
  //   - Library chart: the YAML's title is the default. A non-empty
  //     chartOverrides[id].title is the user's customization.
  //   - Inline single-source chart: addSourceAsChart sets title to the
  //     source's `name`. If the inline title still matches that, treat
  //     it as the default. Also treat "" / "Unnamed chart" (the cc-modal's
  //     blank-input fallback) as default — the user clearly didn't pick
  //     a name on purpose.
  //   - Inline multi-source: too ambiguous to detect; treat as customized.
  function baseTitleIsDefault(chartId: string): boolean {
    if (isInlineId(chartId)) {
      const inline = state.inlineCharts[chartId];
      if (!inline) return true;
      const t = (inline.title ?? "").trim();
      if (!t || t === "Unnamed chart") return true;
      if (inline.sources.length === 1) {
        const src = library?.sources[inline.sources[0]] as
          | { name?: string }
          | undefined;
        if (src?.name && t === src.name) return true;
      }
      return false;
    }
    const override = state.chartOverrides[chartId];
    return !override?.title || !override.title.trim();
  }

  // Resolve a chart's effective display metadata (title / blurb / defaultDelta)
  // taking any per-chart override into account. Used by the hover-merge
  // launcher to preserve the BASE chart's metadata on the merged chart.
  function chartEffectiveSpec(chartId: string): {
    title: string;
    blurb?: string;
    defaultDelta?: DeltaWindow;
    sources: string[];
  } {
    if (isInlineId(chartId)) {
      const inline = state.inlineCharts[chartId];
      return {
        title: inline?.title ?? chartId,
        blurb: inline?.blurb,
        defaultDelta: inline?.defaultDelta as DeltaWindow | undefined,
        sources: inline?.sources ?? [],
      };
    }
    const chart = library?.charts.find((c) => c.id === chartId);
    const override = state.chartOverrides[chartId];
    return {
      title: override?.title || chart?.title || chartId,
      blurb: override?.blurb ?? chart?.blurb,
      defaultDelta: (override?.defaultDelta ?? chart?.defaultDelta) as DeltaWindow | undefined,
      sources: chart?.sources ?? [],
    };
  }

  // ---- Drag & drop helpers ----
  // Module-level handle on the currently-dragged tile during an in-flight
  // drag. Set on dragstart, cleared on dragend. Hover-merge consults this
  // to know which chart is being held — the HTML5 DataTransfer is only
  // readable on drop, not during dragover, so we can't ask the event for
  // the payload mid-flight. Reading it here is safe because all drags
  // route through our own dragstart handler, which sets this.
  let currentlyDraggedChart: {
    secIdx: number;
    chartIdx: number;
    chartId: string;
  } | null = null;

  // Hover-merge state. When a single-source dragged chart lingers over
  // another single-source chart's tile for HOVER_MERGE_HOLD_MS, we fire
  // the merge launcher. The buildup CSS class is added after a small
  // grace period so a fast-moving drag doesn't flicker the ring.
  const HOVER_MERGE_HOLD_MS = 1000;
  const HOVER_MERGE_BUILDUP_DELAY_MS = 200;
  let hoverMergeTimer: number | null = null;
  let hoverMergeBuildupTimer: number | null = null;
  let hoverMergeTile: HTMLElement | null = null;
  // When the merge timer fires it opens the cc-modal mid-drag — but the
  // browser is still in drag-in-progress mode. If the user then releases
  // the mouse over a grid, the grid's drop handler would fire and move
  // the dragged chart, corrupting the snapshot we just took for the
  // pending merge. Setting this flag at merge-launch and checking it in
  // the grid drop handler turns that drop into a no-op.
  let dragConsumedByMerge = false;
  function cancelHoverMerge(): void {
    if (hoverMergeTimer !== null) {
      window.clearTimeout(hoverMergeTimer);
      hoverMergeTimer = null;
    }
    if (hoverMergeBuildupTimer !== null) {
      window.clearTimeout(hoverMergeBuildupTimer);
      hoverMergeBuildupTimer = null;
    }
    if (hoverMergeTile) {
      hoverMergeTile.classList.remove("hover-merge-buildup");
      hoverMergeTile = null;
    }
  }

  // Touch long-press state. Mirrors the hover-merge timer but for touch
  // devices, where dragover doesn't fire. On a 600ms hold without significant
  // movement, we show a "Combine with…" menu listing other single-source
  // charts. Picking one calls openMergeModal with the picked-tile as base
  // and the long-pressed tile as dragged — matching desktop semantics
  // (drop target = base) so the inheritance rules read the same way
  // regardless of input modality.
  const LONG_PRESS_HOLD_MS = 600;
  const LONG_PRESS_MOVE_TOLERANCE_PX = 10;
  let longPressTimer: number | null = null;
  let longPressStart: { x: number; y: number } | null = null;
  let longPressFired = false;
  let longPressMenu: HTMLElement | null = null;

  function beginLongPress(
    tile: HTMLElement,
    chartId: string,
    secIdx: number,
    chartIdx: number,
    x: number,
    y: number,
  ): void {
    endLongPress(); // cancel any in-flight one
    longPressStart = { x, y };
    longPressFired = false;
    longPressTimer = window.setTimeout(() => {
      longPressTimer = null;
      longPressFired = true;
      openCombineWithMenu(tile, chartId, secIdx, chartIdx);
    }, LONG_PRESS_HOLD_MS);
  }

  function updateLongPress(x: number, y: number): void {
    if (!longPressStart || longPressTimer === null) return;
    const dx = x - longPressStart.x;
    const dy = y - longPressStart.y;
    if (Math.hypot(dx, dy) > LONG_PRESS_MOVE_TOLERANCE_PX) {
      // The user is scrolling or repositioning the finger — abort the
      // long-press so we don't fire mid-scroll.
      window.clearTimeout(longPressTimer);
      longPressTimer = null;
      longPressStart = null;
    }
  }

  function endLongPress(): void {
    if (longPressTimer !== null) {
      window.clearTimeout(longPressTimer);
      longPressTimer = null;
    }
    longPressStart = null;
  }

  function closeCombineWithMenu(): void {
    if (longPressMenu) {
      longPressMenu.remove();
      longPressMenu = null;
    }
  }

  // Render the "Combine with…" menu near the long-pressed tile. Each row
  // is a single-source chart in the dashboard with a source different from
  // the held tile's; tapping a row opens the merge modal. Tapping outside
  // the menu (or pressing Escape) dismisses it.
  function openCombineWithMenu(
    tile: HTMLElement,
    heldChartId: string,
    heldSecIdx: number,
    heldChartIdx: number,
  ): void {
    closeCombineWithMenu();
    const heldSource = chartSourceIds(heldChartId)[0];
    if (!heldSource) return;
    // Candidates: every other chart in the dashboard that doesn't already
    // include the held source. Multi-source candidates are allowed — the
    // held single-source gets appended to their existing source list,
    // matching the desktop hover-merge rule (dragged must be single-source;
    // target can be anything). Same-source skip prevents a no-op merge.
    const candidates: Array<{
      chartId: string;
      secIdx: number;
      chartIdx: number;
      title: string;
    }> = [];
    state.sections.forEach((sec, sIdx) => {
      sec.charts.forEach((cid, cIdx) => {
        if (sIdx === heldSecIdx && cIdx === heldChartIdx) return;
        const candSources = chartSourceIds(cid);
        if (candSources.length === 0) return;
        if (candSources.includes(heldSource)) return;
        candidates.push({
          chartId: cid,
          secIdx: sIdx,
          chartIdx: cIdx,
          title: chartEffectiveSpec(cid).title,
        });
      });
    });

    const menu = document.createElement("div");
    menu.className = "combine-with-menu";
    menu.setAttribute("role", "menu");
    const heading = document.createElement("div");
    heading.className = "combine-with-menu-heading";
    heading.textContent = `Combine "${chartEffectiveSpec(heldChartId).title}" with…`;
    menu.appendChild(heading);
    if (candidates.length === 0) {
      const empty = document.createElement("div");
      empty.className = "combine-with-menu-empty";
      empty.textContent =
        "No other charts to combine with. Add another chart first, or pick one that doesn't already include this series.";
      menu.appendChild(empty);
    } else {
      for (const cand of candidates) {
        const row = document.createElement("button");
        row.type = "button";
        row.className = "combine-with-menu-item";
        row.textContent = cand.title;
        row.addEventListener("click", (e) => {
          e.stopPropagation();
          closeCombineWithMenu();
          // Picked = base, held = dragged — matches desktop drag-onto-target
          // semantics so the merged chart keeps the picked target's
          // title/blurb/defaultDelta regardless of input modality.
          openMergeModal(
            {
              chartId: cand.chartId,
              secIdx: cand.secIdx,
              chartIdx: cand.chartIdx,
            },
            {
              chartId: heldChartId,
              secIdx: heldSecIdx,
              chartIdx: heldChartIdx,
            },
          );
        });
        menu.appendChild(row);
      }
    }
    const cancel = document.createElement("button");
    cancel.type = "button";
    cancel.className = "combine-with-menu-cancel";
    cancel.textContent = "Cancel";
    cancel.addEventListener("click", (e) => {
      e.stopPropagation();
      closeCombineWithMenu();
    });
    menu.appendChild(cancel);

    // Position the menu near the tile. Anchor to the tile's bottom-left
    // and clamp so it doesn't go off-screen on narrow viewports.
    document.body.appendChild(menu);
    const tileRect = tile.getBoundingClientRect();
    const menuRect = menu.getBoundingClientRect();
    let left = tileRect.left;
    let top = tileRect.bottom + 4;
    if (left + menuRect.width > window.innerWidth - 8) {
      left = Math.max(8, window.innerWidth - menuRect.width - 8);
    }
    if (top + menuRect.height > window.innerHeight - 8) {
      top = Math.max(8, tileRect.top - menuRect.height - 4);
    }
    menu.style.left = `${left}px`;
    menu.style.top = `${top}px`;
    longPressMenu = menu;

    // Dismiss on tap-outside or Escape.
    const onDocClick = (ev: Event) => {
      if (!longPressMenu) return;
      if (longPressMenu.contains(ev.target as Node)) return;
      closeCombineWithMenu();
      document.removeEventListener("click", onDocClick, true);
      document.removeEventListener("touchstart", onDocClick, true);
    };
    setTimeout(() => {
      document.addEventListener("click", onDocClick, true);
      document.addEventListener("touchstart", onDocClick, true);
    }, 0);
  }

  // localStorage-backed dismissal flag for the hover-merge tip line shown
  // under the composition. Persists per-browser. Cross-device sync for
  // logged-in users would require a server-side user_prefs row; deferred
  // until it's clear the feature is worth the schema migration.
  const HINT_KEY_HOVER_MERGE = "tape:hint-hover-merge-dismissed";
  function isHoverMergeTipDismissed(): boolean {
    try {
      return localStorage.getItem(HINT_KEY_HOVER_MERGE) === "1";
    } catch {
      // Private browsing or storage blocked — treat as not dismissed
      // (the tip just keeps showing; harmless).
      return false;
    }
  }
  function dismissHoverMergeTip(): void {
    try {
      localStorage.setItem(HINT_KEY_HOVER_MERGE, "1");
    } catch {
      /* storage blocked — accept that the tip will reappear on next load */
    }
  }

  // Compute the index at which a dragged tile should be inserted. The grid
  // is a multi-column CSS grid, so we walk tiles in DOM order and return the
  // first one the cursor is "before" in reading order: above its row, or in
  // its row but left of its horizontal midpoint. Empty grid → 0.
  function computeDropIndex(
    grid: HTMLElement,
    clientX: number,
    clientY: number,
  ): number {
    const tiles = [
      ...grid.querySelectorAll<HTMLElement>(".comp-tile:not(.dragging)"),
    ];
    for (let i = 0; i < tiles.length; i++) {
      const r = tiles[i].getBoundingClientRect();
      // Cursor is above this tile's row entirely → insert before it.
      if (clientY < r.top) return i;
      // Cursor is in this tile's row → look at X.
      if (clientY <= r.bottom) {
        if (clientX < r.left + r.width / 2) return i;
      }
      // Otherwise cursor is below this row — keep walking.
    }
    return tiles.length;
  }

  // Move chart from one (section, index) to another.
  // `toIdx` is computed against the POST-removal array (computeDropIndex
  // skips the .dragging tile), so for same-section moves we splice the
  // source out first and then insert at toIdx directly — no off-by-one.
  function moveChart(
    fromSec: number,
    fromIdx: number,
    toSec: number,
    toIdx: number,
  ): void {
    if (fromSec === toSec && fromIdx === toIdx) return; // dropped on own slot
    const fromArr = state.sections[fromSec]?.charts;
    const toArr = state.sections[toSec]?.charts;
    if (!fromArr || !toArr) return;
    const [chartId] = fromArr.splice(fromIdx, 1);
    toArr.splice(toIdx, 0, chartId);
    // Cross-section move: refocus on the destination so subsequent library
    // clicks land where the user was just operating.
    if (fromSec !== toSec) store.activeSectionIdx = toSec;
    writeUrl();
    renderComposition();
  }

  // Reorder sections. `toIdx` is the desired final index in the array
  // (i.e. drop "before section N" means toIdx = N; drop "after" means N + 1).
  function moveSection(fromSec: number, toIdx: number): void {
    if (
      fromSec < 0 ||
      fromSec >= state.sections.length ||
      toIdx < 0 ||
      toIdx > state.sections.length
    )
      return;
    if (fromSec === toIdx || fromSec === toIdx - 1) return; // same slot
    const [moved] = state.sections.splice(fromSec, 1);
    let actualIdx = toIdx;
    if (fromSec < toIdx) actualIdx--;
    state.sections.splice(actualIdx, 0, moved);
    // Keep the active section pointer pointing at the same logical section.
    if (store.activeSectionIdx === fromSec) {
      store.activeSectionIdx = actualIdx;
    } else if (
      fromSec < store.activeSectionIdx &&
      actualIdx >= store.activeSectionIdx
    ) {
      store.activeSectionIdx--;
    } else if (
      fromSec > store.activeSectionIdx &&
      actualIdx <= store.activeSectionIdx
    ) {
      store.activeSectionIdx++;
    }
    writeUrl();
    renderComposition();
  }

  // Re-check the cc-modal annotations textarea against the picked
  // sources' union date range. An annotation whose date falls outside
  // every source's coverage can never render at any window (the data
  // simply doesn't go back/forward that far) — flag those right in
  // the composer instead of letting the user discover the gap by
  // saving + opening the dialog + cycling windows + finding nothing.
  //
  // The actual range math lives in annotationsOutOfRangeSummary (pure,
  // unit-tested); this wrapper marshals library.json metadata + writes
  // the result into the warning element.
  function updateCcAnnotationsWarning(): void {
    const warn = shell.querySelector<HTMLElement>(
      "[data-role='cc-annotations-warn']",
    );
    if (!warn) return;
    const anns = parseAnnotationLines(ccModal.annotationsText);
    if (anns.length === 0 || !library || ccModal.selected.size === 0) {
      warn.hidden = true;
      warn.textContent = "";
      return;
    }
    const sourceRanges = [...ccModal.selected]
      .map((sid) => {
        const s = library!.sources[sid] as
          | { firstObservation?: string; lastObservation?: string }
          | undefined;
        return s ?? null;
      })
      .filter((s): s is { firstObservation?: string; lastObservation?: string } => s !== null);
    const { offBefore, offAfter, unionStart, unionEnd } =
      annotationsOutOfRangeSummary(anns, sourceRanges);
    const total = offBefore.length + offAfter.length;
    if (total === 0) {
      warn.hidden = true;
      warn.textContent = "";
      return;
    }
    const parts: string[] = [];
    if (offBefore.length > 0) {
      const dates = offBefore.map((a) => a.date).join(", ");
      parts.push(
        `${dates} ${offBefore.length === 1 ? "predates" : "predate"} the earliest source observation (${unionStart})`,
      );
    }
    if (offAfter.length > 0) {
      const dates = offAfter.map((a) => a.date).join(", ");
      parts.push(
        `${dates} ${offAfter.length === 1 ? "is" : "are"} past the latest source observation (${unionEnd})`,
      );
    }
    warn.textContent =
      `Heads up: ${parts.join("; ")}. ${total === 1 ? "It won't" : "They won't"} render at any window.`;
    warn.hidden = false;
  }

  // Returns a warning string if the chart's underlying sources don't cover
  // the dashboard's fixed range. Returns null when fully covered or when no
  // fixed range is set. Light-touch: pulls firstObservation/lastObservation
  // from the library.json manifest, no extra fetches.
  function coverageWarningFor(chartId: string): string | null {
    if (!state.fixedRange) return null;
    if (!library) return null;
    const sourceIds = isInlineId(chartId)
      ? state.inlineCharts[chartId]?.sources ?? []
      : library.charts.find((c) => c.id === chartId)?.sources ?? [];
    if (sourceIds.length === 0) return null;
    const start = state.fixedRange.start;
    const end = state.fixedRange.end;
    const issues: string[] = [];
    for (const sid of sourceIds) {
      const s = library.sources[sid] as
        | { firstObservation?: string; lastObservation?: string; shortName?: string; name?: string }
        | undefined;
      if (!s) continue;
      const first = s.firstObservation;
      const last = s.lastObservation;
      const label = s.shortName ?? s.name ?? sid;
      if (first && first > start) issues.push(`${label} starts ${first}`);
      if (last && last < end) issues.push(`${label} ends ${last}`);
    }
    return issues.length > 0 ? issues.join("; ") : null;
  }

  function wireGridDropTarget(grid: HTMLElement): void {
    grid.addEventListener("dragover", (e) => {
      // Only react to our own drag payload — leaves text-drag-from-elsewhere
      // alone so the browser can do its default thing.
      const types = e.dataTransfer?.types;
      if (!types || !Array.from(types).includes("application/x-legible-chart"))
        return;
      e.preventDefault();
      if (e.dataTransfer) e.dataTransfer.dropEffect = "move";
      grid.classList.add("drop-target");
    });
    grid.addEventListener("dragleave", (e) => {
      // Only clear when leaving the grid itself, not when crossing into a child.
      if (e.target === grid) grid.classList.remove("drop-target");
    });
    grid.addEventListener("drop", (e) => {
      const raw = e.dataTransfer?.getData("application/x-legible-chart");
      if (!raw) return;
      e.preventDefault();
      grid.classList.remove("drop-target");
      // If hover-merge fired its modal mid-drag, swallow this drop so the
      // dragged chart doesn't ALSO get moved into the target section.
      // The flag is reset on dragend so subsequent normal drags work.
      if (dragConsumedByMerge) return;
      let payload: { secIdx: number; chartIdx: number };
      try {
        payload = JSON.parse(raw);
      } catch {
        return;
      }
      const toSec = Number(grid.dataset.secIdx ?? "-1");
      if (toSec < 0) return;
      const toIdx = computeDropIndex(grid, e.clientX, e.clientY);
      moveChart(payload.secIdx, payload.chartIdx, toSec, toIdx);
    });
  }

  // ---- Tile previews ----------------------------------------------
  //
  // Each composer tile gets a lightweight visual preview appended below
  // its title/meta line: a sparkline for chart tiles, a tiny map
  // silhouette for inline-map tiles. The goal is "the composer should
  // approximate what Preview will render" — without bringing the full
  // ChartController stack into the editor (it expects SSR-rendered
  // bindings + a real chart context). These previews use the same
  // fetchSourceSeries cache + d3/topojson imports already in scope.

  // Per-tile preview render entrypoint. Dispatches by chart-id prefix.
  function renderTilePreview(host: HTMLElement, chartId: string): void {
    if (isInlineMapId(chartId)) {
      void renderTileMapPreview(host, chartId);
    } else {
      void renderTileSparkline(host, chartId);
    }
  }

  async function renderTileSparkline(
    host: HTMLElement,
    chartId: string,
  ): Promise<void> {
    // Resolve source IDs from inline or library chart.
    let sourceIds: string[] = [];
    if (isInlineId(chartId)) {
      sourceIds = state.inlineCharts[chartId]?.sources ?? [];
    } else {
      const c = library?.charts.find((x) => x.id === chartId);
      sourceIds = c?.sources ?? [];
    }
    if (sourceIds.length === 0) return;
    // Cap at 4 series so a multi-source comparison tile doesn't try
    // to draw 12 overlapping lines in a 64px preview.
    const showIds = sourceIds.slice(0, 4);
    const seriesList = await Promise.all(
      showIds.map((id) => fetchSourceSeries(id)),
    );
    const valid = seriesList.filter((s): s is FetchedSeries => s !== null);
    if (valid.length === 0) return;
    const width = host.clientWidth || 200;
    const height = 64;
    try {
      const marks = valid.map((s, i) =>
        Plot.lineY(
          s.points.map((p) => ({ t: new Date(p.t), v: p.v })),
          {
            x: "t",
            y: "v",
            stroke: CC_COLORS[i % CC_COLORS.length],
            strokeWidth: 1.2,
          },
        ),
      );
      const plot = Plot.plot({
        width,
        height,
        marginLeft: 2,
        marginRight: 2,
        marginTop: 4,
        marginBottom: 2,
        style: { background: "transparent" },
        x: { axis: null },
        y: { axis: null },
        marks,
      }) as HTMLElement;
      host.replaceChildren(plot);
    } catch {
      // Render failure — leave the host empty. The tile already shows
      // title + meta + (optional) coverage warning, so an empty
      // preview area is acceptable graceful degradation.
    }
  }

  // Mini-map preview for inline maps. Loads the same TopoJSON
  // the full /custom/ render uses, then paints a static silhouette
  // tinted by the data values (if available). When the data file
  // isn't present (newer indicator, narrower state set), falls back
  // to an outline-only render so the user still sees the geographic
  // shape of what they're about to compose.
  async function renderTileMapPreview(
    host: HTMLElement,
    mapId: string,
  ): Promise<void> {
    const spec = state.inlineMaps[mapId];
    if (!spec) return;
    let boundaryUrl: string;
    let layerName: string;
    if (spec.geo === "state") {
      boundaryUrl = "https://cdn.jsdelivr.net/npm/us-atlas@3/states-10m.json";
      layerName = "states";
    } else if (spec.geo === "county") {
      boundaryUrl = "https://cdn.jsdelivr.net/npm/us-atlas@3/counties-10m.json";
      layerName = "counties";
    } else if (spec.boundaryFile) {
      boundaryUrl = `${baseUrl}${spec.boundaryFile.startsWith("/") ? "" : "/"}${spec.boundaryFile}`;
      layerName = spec.geo === "block-group" ? "block_groups" : "tracts";
    } else if (spec.states && spec.states.length > 0) {
      // Multi-state inline map (no pre-built boundaryFile). Handled in
      // the multi-fetch branch below — set layerName here and a
      // placeholder boundaryUrl just so the single-fetch code path
      // (which the boundaryFile case still uses) compiles cleanly.
      boundaryUrl = "";
      layerName = spec.geo === "block-group" ? "block_groups" : "tracts";
    } else if (spec.state) {
      const seg = spec.geo === "block-group" ? "block-groups" : "tracts";
      boundaryUrl = `${baseUrl}/maps/${spec.state.toLowerCase()}-${seg}-topo.json`;
      layerName = spec.geo === "block-group" ? "block_groups" : "tracts";
    } else {
      return;
    }
    // Boundary fetch: single file in the common case, parallel multi-
    // fetch + merge for the multi-state Maps-tab spec. Used to be
    // single-fetch-only with the first state's silhouette serving as
    // a stand-in — but that was confusing to users who'd selected 4
    // states and only saw MA's outline (Keller, 2026-05-30). The
    // ~500KB-1MB per-state files are CDN-cached after first load, so
    // the worst-case multi-state preview adds 1-3 cached fetches on
    // subsequent renders.
    const isMultiState = !!(spec.states && spec.states.length > 0);
    // IMPORTANT: include `type: "FeatureCollection"`. d3's
    // geoAlbers().fitSize() reads the type tag to decide how to walk
    // the input — without it, fitSize silently produces NaN for the
    // projected scale + translate, and every path's `d` comes out as
    // "MNaN,NaN…", rendering an empty SVG. The pre-refactor code got
    // this for free because topojson.feature() returned a properly
    // tagged FeatureCollection; the refactor that introduced the
    // multi-state branch constructed `fc` as a bare { features: [] }
    // object and lost the tag.
    const fc: {
      type: "FeatureCollection";
      features: { id?: string | number; properties?: Record<string, unknown> }[];
    } = {
      type: "FeatureCollection",
      features: [],
    };
    if (isMultiState) {
      const seg = spec.geo === "block-group" ? "block-groups" : "tracts";
      const urls = spec.states!.map(
        (st) => `${baseUrl}/maps/${st.toLowerCase()}-${seg}-topo.json`,
      );
      const topos = await Promise.all(urls.map(async (u) => {
        try {
          if (mapBboxTopoCache.has(u)) {
            return mapBboxTopoCache.get(u) as { objects: Record<string, unknown> };
          }
          const r = await fetch(u);
          if (!r.ok) return null;
          const j = (await r.json()) as { objects: Record<string, unknown> };
          mapBboxTopoCache.set(u, j);
          return j;
        } catch {
          return null;
        }
      }));
      for (const t of topos) {
        if (!t) continue;
        const obj = (t.objects ?? {})[layerName];
        if (!obj) continue;
        const shard = topoFeature(t as never, obj as never) as unknown as {
          features: { id?: string | number; properties?: Record<string, unknown> }[];
        };
        fc.features.push(...shard.features);
      }
      if (fc.features.length === 0) return;
    } else {
      let topo: { objects: Record<string, unknown> } | null = null;
      try {
        if (mapBboxTopoCache.has(boundaryUrl)) {
          topo = mapBboxTopoCache.get(boundaryUrl) as typeof topo;
        } else {
          const r = await fetch(boundaryUrl);
          if (!r.ok) return;
          topo = await r.json();
          mapBboxTopoCache.set(boundaryUrl, topo);
        }
      } catch {
        return;
      }
      if (!topo) return;
      const obj = (topo.objects ?? {})[layerName];
      if (!obj) return;
      const single = topoFeature(topo as never, obj as never) as unknown as {
        features: typeof fc.features;
      };
      fc.features = single.features;
    }

    // Try to load the data file(s) so the preview can paint values,
    // not just outlines. Same path scheme ChartMap.astro uses.
    // Multi-state previews merge values from all state shards so the
    // tint is consistent across the displayed region — matches the
    // /custom/ + /u/<slug>/ behavior.
    const dataDirSeg =
      spec.geo === "block-group" ? "acs_block_group" : `acs_${spec.geo}`;
    const dataStates =
      spec.geo === "state" || spec.geo === "county"
        ? null
        : isMultiState
          ? spec.states!.map((s) => s.toLowerCase())
          : spec.state
            ? [spec.state.toLowerCase()]
            : null;
    let values: Record<string, number> = {};
    if (spec.geo === "state" || spec.geo === "county") {
      try {
        const r = await fetch(
          `${baseUrl}/data/${dataDirSeg}/${spec.indicator}_${spec.vintage}.json`,
        );
        if (r.ok) {
          const j = (await r.json()) as { values?: Record<string, number> };
          values = j.values ?? {};
        }
      } catch {
        // ignore — outline-only render
      }
    } else if (dataStates) {
      const shards = await Promise.all(dataStates.map(async (st) => {
        try {
          const r = await fetch(
            `${baseUrl}/data/${dataDirSeg}/${st}/${spec.indicator}_${spec.vintage}.json`,
          );
          if (!r.ok) return null;
          return (await r.json()) as { values?: Record<string, number> };
        } catch {
          return null;
        }
      }));
      for (const s of shards) {
        if (s?.values) Object.assign(values, s.values);
      }
    }

    const width = host.clientWidth || 200;
    const height = 110;
    const projection = geoAlbers().fitSize([width, height], fc as never);
    const pathGen = geoPath(projection);

    // Build a single-hue tint scale on log-or-linear by-extent.
    const vs: number[] = [];
    for (const f of fc.features) {
      const id = String(f.id ?? "");
      const v = values[id];
      if (typeof v === "number" && Number.isFinite(v)) vs.push(v);
    }
    const tintFor = (v: number | undefined): string => {
      if (v === undefined || !Number.isFinite(v) || vs.length === 0) {
        return "rgba(15, 118, 110, 0.10)"; // outline-only fallback
      }
      const min = Math.min(...vs);
      const max = Math.max(...vs);
      const t = max === min ? 0.5 : (v - min) / (max - min);
      // 0.15 -> 0.85 opacity range so even low values are visible and
      // high values don't fully saturate (preview, not the real chart).
      const alpha = 0.15 + 0.7 * t;
      return `rgba(15, 118, 110, ${alpha.toFixed(3)})`;
    };

    const svgNS = "http://www.w3.org/2000/svg";
    const svg = document.createElementNS(svgNS, "svg");
    svg.setAttribute("width", String(width));
    svg.setAttribute("height", String(height));
    svg.setAttribute("viewBox", `0 0 ${width} ${height}`);
    // Diagonal-stripe pattern for no-data regions. Same visual
    // language as the full ChartMap view's `map-no-data-*`
    // pattern, scaled down for the thumbnail (smaller tile = smaller
    // stripe gap). Distinguishes "no data published for this
    // polygon" from "valid data at the low end of the color ramp",
    // which the previous outline-only-faint-teal fallback didn't.
    // patternUnits=userSpaceOnUse keeps the stripes stable when the
    // tile re-renders at a different width.
    const patternId = `compose-no-data-${mapId.replace(/[^a-z0-9-]/gi, "-")}`;
    const defs = document.createElementNS(svgNS, "defs");
    const pattern = document.createElementNS(svgNS, "pattern");
    pattern.setAttribute("id", patternId);
    pattern.setAttribute("width", "5");
    pattern.setAttribute("height", "5");
    pattern.setAttribute("patternUnits", "userSpaceOnUse");
    pattern.setAttribute("patternTransform", "rotate(45)");
    const bg = document.createElementNS(svgNS, "rect");
    bg.setAttribute("width", "5");
    bg.setAttribute("height", "5");
    bg.setAttribute("fill", "#ececec");
    pattern.appendChild(bg);
    const stripe = document.createElementNS(svgNS, "line");
    stripe.setAttribute("x1", "0");
    stripe.setAttribute("y1", "0");
    stripe.setAttribute("x2", "0");
    stripe.setAttribute("y2", "5");
    stripe.setAttribute("stroke", "#bababa");
    stripe.setAttribute("stroke-width", "1.5");
    stripe.setAttribute("vector-effect", "non-scaling-stroke");
    pattern.appendChild(stripe);
    defs.appendChild(pattern);
    svg.appendChild(defs);
    let noDataPaths = 0;
    for (const f of fc.features) {
      const d = pathGen(f as never);
      if (!d) continue;
      const id = String(f.id ?? "");
      const v = values[id];
      const hasData = typeof v === "number" && Number.isFinite(v);
      if (!hasData) noDataPaths += 1;
      const p = document.createElementNS(svgNS, "path");
      p.setAttribute("d", d);
      p.setAttribute(
        "fill",
        hasData ? tintFor(v) : `url(#${patternId})`,
      );
      p.setAttribute("stroke", "rgba(15, 118, 110, 0.45)");
      p.setAttribute("stroke-width", "0.4");
      svg.appendChild(p);
    }
    // Replace the preview pane. If any regions came back hatched,
    // pin a short legend below the map so the reader knows what the
    // stripes mean. Hidden when every polygon has data (the most
    // common case) to keep the tile chrome-free.
    host.replaceChildren(svg);
    if (noDataPaths > 0) {
      const note = document.createElement("p");
      note.className = "comp-tile-preview-nodata-note";
      note.style.cssText =
        "margin: 4px 0 0; font-size: 10.5px; color: var(--color-neutral-500); display: flex; align-items: center; gap: 5px;";
      const swatch = document.createElement("span");
      swatch.style.cssText =
        "display: inline-block; width: 10px; height: 10px; border: 1px solid #bababa; background: repeating-linear-gradient(45deg, #ececec 0 1.5px, #bababa 1.5px 3px);";
      note.appendChild(swatch);
      const text = document.createElement("span");
      text.textContent = `${noDataPaths.toLocaleString()} region${noDataPaths === 1 ? "" : "s"} have no published data for this indicator + vintage`;
      note.appendChild(text);
      host.appendChild(note);
    }
  }

  function renderComposition(): void {
    const host = shell.querySelector<HTMLElement>("[data-role='comp-sections']");
    const empty = shell.querySelector<HTMLElement>("[data-role='comp-empty']");
    if (!host || !empty) return;
    host.innerHTML = "";
    const hasAny = state.sections.some((s) => s.charts.length > 0);
    empty.style.display = hasAny ? "none" : "";
    clampActiveSection();
    state.sections.forEach((sec, secIdx) => {
      const secEl = document.createElement("section");
      secEl.className =
        "comp-section" + (secIdx === store.activeSectionIdx ? " comp-section-active" : "");
      // Clicking anywhere on the section focuses it (except when the user is
      // interacting with an input/textarea/button inside it — those stop
      // propagation or handle their own logic).
      secEl.addEventListener("click", (e) => {
        const tag = (e.target as HTMLElement).tagName;
        if (tag === "INPUT" || tag === "TEXTAREA" || tag === "BUTTON") return;
        setActiveSection(secIdx);
      });
      // Section-reorder drop target. Only reacts to section-type payload —
      // chart drags route through the inner grid handlers, not the section.
      secEl.addEventListener("dragover", (e) => {
        const types = e.dataTransfer?.types;
        if (
          !types ||
          !Array.from(types).includes("application/x-legible-section")
        )
          return;
        e.preventDefault();
        if (e.dataTransfer) e.dataTransfer.dropEffect = "move";
        const r = secEl.getBoundingClientRect();
        const before = e.clientY < r.top + r.height / 2;
        secEl.classList.toggle("drop-before", before);
        secEl.classList.toggle("drop-after", !before);
      });
      secEl.addEventListener("dragleave", (e) => {
        if (e.target === secEl) {
          secEl.classList.remove("drop-before", "drop-after");
        }
      });
      secEl.addEventListener("drop", (e) => {
        const raw = e.dataTransfer?.getData("application/x-legible-section");
        if (!raw) return;
        e.preventDefault();
        secEl.classList.remove("drop-before", "drop-after");
        let payload: { secIdx: number };
        try {
          payload = JSON.parse(raw);
        } catch {
          return;
        }
        const r = secEl.getBoundingClientRect();
        const before = e.clientY < r.top + r.height / 2;
        const targetIdx = before ? secIdx : secIdx + 1;
        moveSection(payload.secIdx, targetIdx);
      });
      const header = document.createElement("div");
      header.className = "comp-section-header";
      // Drag handle — only this is draggable, so the input fields below
      // remain interactive without accidentally starting drags.
      const handle = document.createElement("span");
      handle.className = "comp-section-drag-handle";
      handle.title = "Drag to reorder section";
      handle.textContent = "⋮⋮"; // vertical ellipsis ×2
      handle.draggable = true;
      handle.addEventListener("dragstart", (e) => {
        if (!e.dataTransfer) return;
        e.dataTransfer.effectAllowed = "move";
        e.dataTransfer.setData(
          "application/x-legible-section",
          JSON.stringify({ secIdx }),
        );
        // No text/plain payload on purpose. Chrome's default dragover
        // on `<input>` / `<textarea>` accepts text/plain drops with
        // dropEffect="copy", which paints a bright green "+" cursor.
        // The composer is full of inputs (section titles, descriptions,
        // inline chart titles), so adding a text/plain shadow makes the
        // cursor flash green every time the user passes over one
        // mid-drag. Our own drop handlers read application/x-legible-
        // section, not text/plain, so dropping the duplicate costs us
        // nothing.
        secEl.classList.add("dragging");
      });
      handle.addEventListener("dragend", () => {
        secEl.classList.remove("dragging");
        shell
          .querySelectorAll<HTMLElement>(".comp-section.drop-before, .comp-section.drop-after")
          .forEach((s) => s.classList.remove("drop-before", "drop-after"));
      });
      header.appendChild(handle);
      const title = document.createElement("input");
      title.type = "text";
      title.className = "comp-section-title";
      title.value = sec.title;
      title.placeholder = "Section title";
      title.addEventListener("input", () => {
        sec.title = title.value;
        writeUrl();
      });
      title.addEventListener("focus", () => setActiveSection(secIdx));
      header.appendChild(title);
      if (secIdx === store.activeSectionIdx) {
        const hint = document.createElement("span");
        hint.className = "comp-section-active-hint";
        hint.textContent = "\u2190 adds go here";
        header.appendChild(hint);
      }
      const del = document.createElement("button");
      del.type = "button";
      del.className = "comp-section-del";
      del.title = "Remove section";
      del.textContent = "\u00d7";
      del.addEventListener("click", () => {
        if (sec.charts.length && !confirm("Remove section and its charts?")) return;
        state.sections.splice(secIdx, 1);
        if (state.sections.length === 0) state.sections = defaultSections();
        writeUrl();
        renderComposition();
      });
      header.appendChild(del);
      secEl.appendChild(header);

      const desc = document.createElement("textarea");
      desc.className = "comp-section-desc";
      desc.rows = 1;
      desc.placeholder = "Add commentary for this section (optional)…";
      desc.value = sec.description ?? "";
      desc.addEventListener("input", () => {
        sec.description = desc.value;
        writeUrl();
      });
      desc.addEventListener("focus", () => setActiveSection(secIdx));
      secEl.appendChild(desc);

      // Markdown body textarea. Shown initially only when the section
      // already has one (avoids cluttering the default chart-grid
      // sections with an unused field); a small "+ Notes (markdown)"
      // link below the description reveals it on demand.
      const md = document.createElement("textarea");
      md.className = "comp-section-md";
      md.rows = 4;
      md.placeholder =
        "Markdown body — **bold**, *italic*, [links](https://…), - bullets, " +
        "## headings. Renders between the description and the chart grid.";
      md.value = (sec as { markdown?: string }).markdown ?? "";
      const hasMd =
        typeof (sec as { markdown?: string }).markdown === "string" &&
        ((sec as { markdown?: string }).markdown ?? "").length > 0;
      md.hidden = !hasMd;
      md.addEventListener("input", () => {
        (sec as { markdown?: string }).markdown = md.value;
        writeUrl();
      });
      md.addEventListener("focus", () => setActiveSection(secIdx));
      secEl.appendChild(md);

      // "+ Notes (markdown)" toggle. Hidden once the markdown
      // textarea is visible — adding it twice has no effect, and the
      // toggle becomes noise.
      const mdToggle = document.createElement("button");
      mdToggle.type = "button";
      mdToggle.className = "comp-section-md-toggle";
      mdToggle.textContent = "+ Notes (markdown)";
      mdToggle.hidden = hasMd;
      mdToggle.addEventListener("click", () => {
        md.hidden = false;
        mdToggle.hidden = true;
        md.focus();
      });
      secEl.appendChild(mdToggle);

      // Section-level time-window override. Lets the composer pin
      // each section to its own window — useful for "show the same
      // charts across multiple decades" patterns. Mode select picks
      // between "inherit" (dashboard window applies), one of the
      // standard deltas (1y, 10y, 30y, …), or "custom" (date pair).
      // Mutually exclusive — picking a delta clears the custom range
      // and vice versa.
      const winRow = document.createElement("div");
      winRow.className = "comp-section-window";
      const winLabel = document.createElement("span");
      winLabel.className = "comp-section-window-label muted small";
      winLabel.textContent = "Window";
      winRow.appendChild(winLabel);

      const winSelect = document.createElement("select");
      winSelect.className = "comp-section-window-select";
      winSelect.title = "Override the dashboard-level window for this section";
      const optInherit = document.createElement("option");
      optInherit.value = "";
      optInherit.textContent = "Dashboard default";
      winSelect.appendChild(optInherit);
      for (const w of DELTA_WINDOWS) {
        const o = document.createElement("option");
        o.value = w;
        o.textContent = DELTA_LABELS_SHORT[w];
        winSelect.appendChild(o);
      }
      const optCustom = document.createElement("option");
      optCustom.value = "__custom";
      optCustom.textContent = "Custom dates…";
      winSelect.appendChild(optCustom);
      if (sec.fixedRange) winSelect.value = "__custom";
      else if (sec.defaultDelta) winSelect.value = sec.defaultDelta;
      else winSelect.value = "";
      winRow.appendChild(winSelect);

      // Two date inputs, shown only when "Custom dates" is the mode.
      const startInput = document.createElement("input");
      startInput.type = "date";
      startInput.className = "comp-section-window-date";
      startInput.placeholder = "Start";
      startInput.value = sec.fixedRange?.start ?? "";
      const endInput = document.createElement("input");
      endInput.type = "date";
      endInput.className = "comp-section-window-date";
      endInput.placeholder = "End";
      endInput.value = sec.fixedRange?.end ?? "";
      const dateWrap = document.createElement("span");
      dateWrap.className = "comp-section-window-dates";
      dateWrap.appendChild(startInput);
      const arrow = document.createElement("span");
      arrow.textContent = "→";
      arrow.className = "muted small";
      dateWrap.appendChild(arrow);
      dateWrap.appendChild(endInput);
      dateWrap.style.display = sec.fixedRange ? "" : "none";
      winRow.appendChild(dateWrap);

      function syncDateWrap() {
        dateWrap.style.display = winSelect.value === "__custom" ? "" : "none";
      }
      function applySectionWindow() {
        const v = winSelect.value;
        if (v === "") {
          sec.defaultDelta = undefined;
          sec.fixedRange = undefined;
        } else if (v === "__custom") {
          sec.defaultDelta = undefined;
          if (startInput.value && endInput.value) {
            sec.fixedRange = { start: startInput.value, end: endInput.value };
          } else {
            sec.fixedRange = undefined; // wait until both filled
          }
        } else {
          sec.defaultDelta = v as DeltaWindow;
          sec.fixedRange = undefined;
        }
        writeUrl();
      }
      winSelect.addEventListener("change", () => {
        syncDateWrap();
        applySectionWindow();
      });
      startInput.addEventListener("change", applySectionWindow);
      endInput.addEventListener("change", applySectionWindow);

      secEl.appendChild(winRow);

      const grid = document.createElement("div");
      grid.className = "comp-section-grid";
      grid.dataset.secIdx = String(secIdx);
      // Drag-to-reorder: every grid is a drop target for chart moves.
      wireGridDropTarget(grid);
      if (sec.charts.length === 0) {
        grid.innerHTML = '<p class="muted small comp-empty-slot">Empty section. Click a chart on the left, or drag a chart here.</p>';
      } else {
        sec.charts.forEach((chartId, chartIdx) => {
          const tile = document.createElement("div");
          let titleText: string;
          let metaText: string;
          if (isInlineMapId(chartId)) {
            // Inline-map tile. Before this branch existed the renderer
            // dropped maps into the library-chart else-branch, looked
            // for a YAML chart with that ID, didn't find one, and
            // rendered a bare "inlinemap:abc12345" string. Maps get
            // their own tile class so the CSS can size the preview
            // area for a square-ish map rather than the wider
            // timeseries sparkline.
            const m = state.inlineMaps[chartId];
            titleText = m?.title ?? chartId;
            const geoLabel = m?.geo === "block-group"
              ? "block group"
              : (m?.geo ?? "map");
            // Show state codes joined for multi-state regional maps;
            // fall back to single-state .state for back-compat with
            // saved dashboards from before the multi-state knob.
            const stateChunks =
              m?.states && m.states.length > 0
                ? m.states.join("+")
                : (m?.state ?? "");
            const stateLabel = stateChunks ? ` · ${stateChunks}` : "";
            metaText = `map · ${geoLabel} · ${m?.indicator ?? ""} (${m?.vintage ?? ""})${stateLabel}`;
            tile.className = "comp-tile comp-tile-map";
          } else if (isInlineId(chartId)) {
            const inline = state.inlineCharts[chartId];
            titleText = inline?.title ?? chartId;
            const sourceLabels = (inline?.sources ?? []).map((sid) => {
              if (isDerivedId(sid)) {
                return state.inlineSources[sid]?.name ?? sid;
              }
              const s = library?.sources[sid];
              return s?.shortName ?? s?.name ?? sid;
            });
            // Legacy chart-level op (deprecated by derived sources): keep
            // rendering correctly for any saved dashboards that still
            // carry it.
            const joiner = inline?.op === "divide"
              ? " ÷ "
              : inline?.op === "diff"
                ? " − "
                : inline?.op === "multiply"
                  ? " × "
                  : " + ";
            metaText = `custom · ${sourceLabels.join(joiner)}`;
            tile.className = "comp-tile comp-tile-inline";
          } else {
            const chart = library?.charts.find((c) => c.id === chartId);
            const override = state.chartOverrides[chartId];
            titleText = override?.title || chart?.title || chartId;
            const tagText = (chart?.tags ?? []).join(" \u00b7 ");
            metaText = override?.blurb
              ? `${tagText}${tagText ? " \u00b7 " : ""}note added`
              : tagText;
            tile.className =
              "comp-tile" + (override ? " has-override" : "");
          }
          tile.innerHTML =
            `<div class="comp-tile-title">${escapeHtml(titleText)}</div>` +
            `<div class="comp-tile-meta">${escapeHtml(metaText)}</div>` +
            `<div class="comp-tile-preview" data-role="tile-preview"></div>`;
          // Lazy-render the visual preview (sparkline for charts, mini
          // map for maps). Async + fire-and-forget — the tile
          // is already in the DOM with title/meta, the preview just
          // fills in when its data lands. Cached fetches make the
          // second render of a given source / topology near-instant.
          const previewHost = tile.querySelector<HTMLElement>(
            "[data-role='tile-preview']",
          );
          if (previewHost) void renderTilePreview(previewHost, chartId);
          // Fixed-range coverage check: highlight tiles whose underlying
          // sources don't fully cover the requested range. Doesn't reject —
          // the user can still ship a dashboard with partial coverage; we
          // just flag it.
          const coverageMsg = coverageWarningFor(chartId);
          if (coverageMsg) {
            tile.classList.add("comp-tile-coverage-warn");
            tile.title = `Outside fixed range: ${coverageMsg}`;
            const meta = tile.querySelector<HTMLElement>(".comp-tile-meta");
            if (meta) {
              const flag = document.createElement("span");
              flag.className = "comp-tile-coverage-flag";
              flag.textContent = " · partial coverage";
              meta.appendChild(flag);
            }
          }
          // Drag-to-reorder. Browsers only fire `click` if no drag happened,
          // so click-to-edit on inline tiles still works alongside this.
          tile.draggable = true;
          tile.dataset.secIdx = String(secIdx);
          tile.dataset.chartIdx = String(chartIdx);
          tile.addEventListener("dragstart", (e) => {
            if (!e.dataTransfer) return;
            e.dataTransfer.effectAllowed = "move";
            e.dataTransfer.setData(
              "application/x-legible-chart",
              JSON.stringify({ secIdx, chartIdx }),
            );
            // No text/plain payload — see the matching dragstart on
            // the section drag handle for the rationale. tl;dr: it
            // makes the cursor flash green over input fields because
            // Chrome's default dragover on inputs claims text/plain
            // drops as copy.
            tile.classList.add("dragging");
            currentlyDraggedChart = { secIdx, chartIdx, chartId };
          });
          tile.addEventListener("dragend", () => {
            tile.classList.remove("dragging");
            shell
              .querySelectorAll<HTMLElement>(".comp-section-grid.drop-target")
              .forEach((g) => g.classList.remove("drop-target"));
            currentlyDraggedChart = null;
            cancelHoverMerge();
            // Reset the merge-consumed flag so the next drag's drop fires
            // normally. (drop fires before dragend, so by the time we
            // get here the flag has already done its job for this drag.)
            dragConsumedByMerge = false;
          });
          // Hover-merge: holding a single-source chart over ANY chart
          // (single- or multi-source) for HOVER_MERGE_HOLD_MS opens the
          // cc-modal pre-filled with the union of sources. Dragging a
          // multi-source chart onto another chart does NOT engage merge —
          // multi → anything would need a picker for which sources to
          // bring across, which lives in the modal's own source-picker
          // anyway. The buildup ring fills during the hold so the user
          // knows what's coming and can cancel by moving the cursor off.
          tile.addEventListener("dragover", (e) => {
            // Only react to our own drag payload; ignore text drags / etc.
            const types = e.dataTransfer?.types;
            if (
              !types ||
              !Array.from(types).includes("application/x-legible-chart")
            ) {
              return;
            }
            const dragged = currentlyDraggedChart;
            if (!dragged) return;
            // Don't engage hover-merge over the dragged tile itself.
            if (dragged.secIdx === secIdx && dragged.chartIdx === chartIdx) {
              cancelHoverMerge();
              return;
            }
            // Dragged end MUST be single-source — that's the "I want to
            // add THIS series to that chart" gesture. The target can have
            // any number of sources; we just append.
            if (!isSingleSourceChart(dragged.chartId)) return;
            // Same-source skip: if the dragged source is already in the
            // target's source list, the merge would no-op (or worse,
            // duplicate). Stays a normal reorder.
            const draggedSrc = chartSourceIds(dragged.chartId)[0];
            const baseSrcs = chartSourceIds(chartId);
            if (baseSrcs.includes(draggedSrc)) return;
            // Already hovering this tile — let the existing timers run.
            if (hoverMergeTile === tile) return;
            // Hovering a new tile — reset and re-arm.
            cancelHoverMerge();
            hoverMergeTile = tile;
            hoverMergeBuildupTimer = window.setTimeout(() => {
              tile.classList.add("hover-merge-buildup");
              hoverMergeBuildupTimer = null;
            }, HOVER_MERGE_BUILDUP_DELAY_MS);
            hoverMergeTimer = window.setTimeout(() => {
              hoverMergeTimer = null;
              // Snapshot before cancelHoverMerge nukes them.
              const baseSec = secIdx;
              const baseIdx = chartIdx;
              const baseId = chartId;
              const dr = currentlyDraggedChart;
              cancelHoverMerge();
              if (!dr) return;
              // Block the drag's eventual drop (the user is probably
              // still holding the mouse) from also moving the chart.
              dragConsumedByMerge = true;
              openMergeModal(
                { chartId: baseId, secIdx: baseSec, chartIdx: baseIdx },
                { chartId: dr.chartId, secIdx: dr.secIdx, chartIdx: dr.chartIdx },
              );
            }, HOVER_MERGE_HOLD_MS);
          });
          tile.addEventListener("dragleave", (e) => {
            // dragleave fires when the cursor enters a child element too,
            // so check the related target — if we're still inside this
            // tile (e.g. moved onto the × button), do nothing.
            const related = e.relatedTarget as Node | null;
            if (related && tile.contains(related)) return;
            if (hoverMergeTile === tile) cancelHoverMerge();
          });
          // Touch long-press → "Combine with…" menu. Drag-hover doesn't
          // translate to touch (no hover state during a finger drag), so
          // we expose the same merge action via a long-press menu on
          // single-source tiles. The picked chart becomes the BASE
          // (matches the desktop semantics where the drop target = base);
          // the long-pressed chart is the dragged.
          tile.addEventListener("touchstart", (e) => {
            if (!isSingleSourceChart(chartId)) return;
            const t = e.touches[0];
            if (!t) return;
            beginLongPress(tile, chartId, secIdx, chartIdx, t.clientX, t.clientY);
          }, { passive: true });
          tile.addEventListener("touchmove", (e) => {
            const t = e.touches[0];
            if (!t) return;
            updateLongPress(t.clientX, t.clientY);
          }, { passive: true });
          tile.addEventListener("touchend", () => {
            endLongPress();
          });
          tile.addEventListener("touchcancel", () => {
            endLongPress();
          });
          // Every tile is editable. Inline tiles open their existing
          // edit flow directly; library tiles get a copy-and-promote
          // step first (library YAML stays untouched, an inline copy
          // becomes the editable working version).
          tile.classList.add("comp-tile-editable");
          tile.title = "Drag to reorder, click to edit";
          const openEditor = (): void => {
            if (isInlineId(chartId)) {
              openCustomChartModal(chartId);
              return;
            }
            const newId = promoteLibraryChartToInline(chartId, secIdx, chartIdx);
            if (!newId) {
              // Library entry vanished (deleted catalog file, stale
              // saved dashboard). Fall back to the lightweight blurb
              // modal so the user still has SOME way to edit the tile.
              openChartBlurbModal(chartId);
              return;
            }
            writeUrl();
            renderComposition();
            openCustomChartModal(newId);
          };
          tile.addEventListener("click", (e) => {
            // If a long-press just fired on this tile, the synthetic
            // click from touchend would otherwise open the editor on
            // top of the menu. Eat this click and reset.
            if (longPressFired) {
              longPressFired = false;
              e.stopPropagation();
              return;
            }
            openEditor();
          });
          const rm = document.createElement("button");
          rm.type = "button";
          rm.className = "comp-tile-del";
          rm.textContent = "\u00d7";
          rm.title = "Remove";
          // Don't let mousedown on the \u00d7 kick off a drag of the parent tile.
          rm.draggable = false;
          rm.addEventListener("mousedown", (e) => e.stopPropagation());
          rm.addEventListener("click", (e) => {
            e.stopPropagation();
            sec.charts.splice(chartIdx, 1);
            writeUrl();
            renderComposition();
          });
          // \u270e Edit button: for inline charts, opens the custom-chart modal;
          // for library charts, opens the per-chart blurb / title override.
          const edit = document.createElement("button");
          edit.type = "button";
          edit.className = "comp-tile-edit";
          edit.textContent = "\u270e";
          edit.title = "Edit chart";
          edit.draggable = false;
          edit.addEventListener("mousedown", (e) => e.stopPropagation());
          edit.addEventListener("click", (e) => {
            e.stopPropagation();
            openEditor();
          });
          // Preview button: opens THIS chart alone in /custom/ preview mode
          // (new tab), rendered exactly as it will appear — distinct from the
          // tiny inline sparkline. Photo/image glyph, sized a touch larger
          // than the edit pencil; sits in the bottom-right so it doesn't
          // crowd the top-right edit/remove controls.
          const preview = document.createElement("button");
          preview.type = "button";
          // Distinct class from the .comp-tile-preview visual-preview slot
          // (the lazy-filled chart thumbnail container) — they previously
          // collided, and the container's `> svg { width:100% }` rule
          // ballooned this button's icon into a full-size "broken-image"
          // looking glyph.
          preview.className = "comp-tile-preview-btn";
          preview.title = "Preview chart";
          preview.setAttribute("aria-label", "Preview chart");
          preview.draggable = false;
          preview.innerHTML =
            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" ' +
            'stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ' +
            'aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/>' +
            '<circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>';
          preview.addEventListener("mousedown", (e) => e.stopPropagation());
          preview.addEventListener("click", (e) => {
            e.stopPropagation();
            window.open(singleChartPreviewUrl(chartId), "_blank", "noopener");
          });
          tile.appendChild(preview);
          tile.appendChild(edit);
          tile.appendChild(rm);
          grid.appendChild(tile);
        });
      }
      secEl.appendChild(grid);
      host.appendChild(secEl);
    });

    // Hover-merge tip — shown until the user either dismisses it or
    // discovers the feature by hovering long enough to fire a merge.
    // Only worth showing when the dashboard has 2+ charts; with 0–1
    // there's nothing to combine yet.
    const totalCharts = state.sections.reduce(
      (n, s) => n + s.charts.length,
      0,
    );
    if (totalCharts >= 2 && !isHoverMergeTipDismissed()) {
      const tip = document.createElement("div");
      tip.className = "comp-hover-merge-tip";
      tip.innerHTML =
        '<span>Tip: drag a single-source chart onto another chart and hold for a moment to combine them.</span>' +
        '<button type="button" class="comp-hover-merge-tip-dismiss" aria-label="Dismiss tip">&times;</button>';
      const dismissBtn = tip.querySelector<HTMLButtonElement>(
        ".comp-hover-merge-tip-dismiss",
      );
      dismissBtn?.addEventListener("click", () => {
        dismissHoverMergeTip();
        tip.remove();
      });
      host.appendChild(tip);
    }
  }

  // ---- Anonymous composer rate-limit gate ----
  //
  // Anonymous users get 20 chart-adds + derived-source-creates per IP per
  // day before the composer prompts them to sign in (see migration 0004,
  // compose_action_check RPC). Signed-in users skip the roundtrip entirely.
  //
  // Once we've seen a denial in this tab, latch composeCapHit so subsequent
  // attempts skip the network call and go straight to the prompt — both
  // for UX (no roundtrip delay on each click) and to keep the per-IP
  // counter from creeping up on every refused attempt.
  let composeCapHit = false;

  async function checkComposeAction(action: string): Promise<boolean> {
    // Latch: once capped, stay capped until page reload (which happens
    // automatically after OAuth sign-in via the redirectTo flow).
    if (composeCapHit) return false;
    // Fast path: signed-in users always pass without a roundtrip.
    if (readStoredSession()) return true;
    try {
      const res = await fetch(
        `${SUPABASE_REST_URL}/rest/v1/rpc/compose_action_check`,
        {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            apikey: SUPABASE_REST_ANON_KEY,
            Authorization: `Bearer ${SUPABASE_REST_ANON_KEY}`,
          },
          body: JSON.stringify({ p_action: action }),
        },
      );
      if (!res.ok) return true; // fail-open on transport errors
      const allowed = await res.json();
      const ok = allowed === true;
      if (!ok) composeCapHit = true;
      return ok;
    } catch {
      return true; // fail-open on network errors
    }
  }

  function showSigninPrompt(reason: string): void {
    const backdrop = shell.querySelector<HTMLElement>(
      "[data-role='signin-prompt']",
    );
    if (backdrop) backdrop.hidden = false;
    // Funnel telemetry: which action triggered the prompt, so we can see
    // whether chart-adds or derived-source-creates drive the cap-hits.
    track("compose_signin_prompt_shown", { reason });
  }

  // ---- Mutations ----
  async function addChart(chartId: string): Promise<void> {
    clampActiveSection();
    const target = state.sections[store.activeSectionIdx];
    if (!target) return;
    if (target.charts.includes(chartId)) return; // don't duplicate (no budget cost)
    // Anon rate-limit gate. Authed users always pass; anon users above
    // their 20-per-day per-IP budget get the prompt instead of the add.
    const allowed = await checkComposeAction("add_chart");
    if (!allowed) {
      showSigninPrompt("add_chart");
      return;
    }
    target.charts.push(chartId);
    writeUrl();
    renderComposition();
    // Funnel telemetry: which charts are most popular adds, and how often
    // first-time users get past "open composer" → "actually pick a chart".
    // Include the chart's underlying source IDs so we can also see *source*
    // popularity at construction time, not just chart popularity.
    const libChart = library?.charts.find((c) => c.id === chartId);
    track("compose_chart_added", {
      chartId,
      source: "library",
      sources: libChart ? packSourceIds(libChart.sources) : "",
    });
  }

  // ---- Wire up controls ----
  function wire(): void {
    const titleInput = shell.querySelector<HTMLInputElement>("[data-role='title-input']");
    if (titleInput) {
      titleInput.value = state.title;
      titleInput.addEventListener("input", () => {
        state.title = titleInput.value;
        writeUrl();
      });
    }
    const descInput = shell.querySelector<HTMLTextAreaElement>("[data-role='description-input']");
    if (descInput) {
      descInput.value = state.description;
      descInput.addEventListener("input", () => {
        state.description = descInput.value;
        writeUrl();
      });
    }
    const ddSelect = shell.querySelector<HTMLSelectElement>("[data-role='default-delta']");
    const fixedInputs = shell.querySelector<HTMLElement>("[data-role='fixed-inputs']");
    const fixedStart = shell.querySelector<HTMLInputElement>("[data-role='fixed-start']");
    const fixedEnd = shell.querySelector<HTMLInputElement>("[data-role='fixed-end']");
    function syncTimeUI(): void {
      if (!ddSelect) return;
      const usingFixed = !!state.fixedRange;
      ddSelect.value = usingFixed ? "fixed" : state.defaultDelta;
      if (fixedInputs) fixedInputs.hidden = !usingFixed;
      if (usingFixed) {
        if (fixedStart) fixedStart.value = state.fixedRange!.start;
        if (fixedEnd) fixedEnd.value = state.fixedRange!.end;
      }
    }
    syncTimeUI();
    ddSelect?.addEventListener("change", () => {
      const v = ddSelect.value;
      if (v === "fixed") {
        // Initialize a sensible default range if there isn't one yet:
        // last 5 years to today.
        if (!state.fixedRange) {
          const today = new Date();
          const todayIso = today.toISOString().slice(0, 10);
          const fiveYearsAgo = new Date(today);
          fiveYearsAgo.setFullYear(today.getFullYear() - 5);
          state.fixedRange = {
            start: fiveYearsAgo.toISOString().slice(0, 10),
            end: todayIso,
          };
        }
        state.defaultDelta = "";
      } else {
        state.fixedRange = undefined;
        state.defaultDelta = v as UIState["defaultDelta"];
      }
      syncTimeUI();
      writeUrl();
      renderComposition(); // re-flag tiles for coverage
    });
    function onFixedInput(): void {
      if (!fixedStart || !fixedEnd) return;
      const start = fixedStart.value;
      const end = fixedEnd.value;
      // Only commit when both are valid and start <= end. Otherwise leave the
      // existing fixedRange untouched so the user can edit one box at a time.
      if (
        /^\d{4}-\d{2}-\d{2}$/.test(start) &&
        /^\d{4}-\d{2}-\d{2}$/.test(end) &&
        start <= end
      ) {
        state.fixedRange = { start, end };
        writeUrl();
        renderComposition();
      }
    }
    fixedStart?.addEventListener("change", onFixedInput);
    fixedEnd?.addEventListener("change", onFixedInput);
    const searchInputSources = shell.querySelector<HTMLInputElement>(
      "[data-role='lib-search-sources']",
    );
    if (searchInputSources) {
      searchInputSources.addEventListener("input", () => {
        store.sourcesSearchQuery = searchInputSources.value;
        // Refresh both — tag-pill counts depend on the current query
        // because the query narrows the universe each pill could match.
        renderTagFiltersSources();
        renderSourcesList();
      });
    }
    // ---- Geo-chip wiring (Sources tab) ----
    // wireGeoChips is reused by the cc-modal + ds-modal; here we wire
    // the Sources tab's geo strip the same way.
    wireGeoChips("lib");
    const searchInputCharts = shell.querySelector<HTMLInputElement>(
      "[data-role='lib-search-charts']",
    );
    if (searchInputCharts) {
      searchInputCharts.addEventListener("input", () => {
        chartsSearchQuery = searchInputCharts.value;
        renderChartsList();
      });
    }
    // Tab switching. Default tab (sources) is already visible from
    // the markup; clicking a tab swaps panels + re-renders the new
    // active tab so its data is fresh.
    shell.querySelectorAll<HTMLButtonElement>("[data-role='lib-tab']").forEach((btn) => {
      btn.addEventListener("click", () => {
        const tab = btn.dataset.tab as LibTab | undefined;
        if (
          tab === "sources" ||
          tab === "charts" ||
          tab === "maps" ||
          tab === "generators"
        ) {
          setActiveLibTab(tab);
        }
      });
    });
    const addSection = shell.querySelector<HTMLButtonElement>("[data-role='add-section']");
    if (addSection) {
      addSection.addEventListener("click", () => {
        state.sections.push({
          title: `Section ${state.sections.length + 1}`,
          description: "",
          charts: [],
        });
        store.activeSectionIdx = state.sections.length - 1;
        writeUrl();
        renderComposition();
      });
    }
    // Markdown-block button. Spawns a section that's pure narrative —
    // no charts, just a markdown body for context between chart
    // sections. The empty-title default keeps the renderer from
    // emitting an h2; users can fill in a heading or leave it
    // headless for flowing prose.
    const addMarkdownSection = shell.querySelector<HTMLButtonElement>(
      "[data-role='add-markdown-section']",
    );
    if (addMarkdownSection) {
      addMarkdownSection.addEventListener("click", () => {
        state.sections.push({
          title: "",
          description: "",
          charts: [],
          markdown:
            "Markdown block. **Bold**, *italic*, [links](https://example.com), " +
            "and lists work. Replace this with your narrative.",
        } as (typeof state.sections)[number]);
        store.activeSectionIdx = state.sections.length - 1;
        writeUrl();
        renderComposition();
      });
    }
    const openCustom = shell.querySelector<HTMLButtonElement>("[data-role='open-custom-chart']");
    if (openCustom) {
      openCustom.addEventListener("click", () => openCustomChartModal());
    }
    const openDerived = shell.querySelector<HTMLButtonElement>("[data-role='open-derived-source']");
    if (openDerived) {
      openDerived.addEventListener("click", () => openDerivedSourceModal());
    }
    wireCustomChartModal();
    wireChartBlurbModal();
    wireDerivedSourceModal();
    wireSigninPrompt();
    const copyShare = shell.querySelector<HTMLButtonElement>("[data-role='copy-share']");
    if (copyShare) {
      copyShare.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          copyShare.textContent = "Copied!";
          setTimeout(() => (copyShare.textContent = "Copy share link"), 1500);
          // Share-link copy is the closest proxy we have for "user found this
          // valuable enough to send to someone else." Track length so we can
          // also see how often URLs are uncomfortably long (the saved-vs-shared
          // breakpoint).
          track("compose_share_copied", {
            urlLength: window.location.href.length,
          });
        } catch {
          alert("Copy failed. URL is in the address bar.");
        }
      });
    }

    // ---- Save to account (Supabase) ----
    // Button is always visible; if not signed in, clicking triggers the OAuth
    // round-trip and returns the user to the composer with their state intact.
    const saveBtn = shell.querySelector<HTMLButtonElement>("[data-role='save']");
    const saveDefaultLabel =
      saveBtn?.dataset.saveDefaultLabel ?? "Save to my account";
    if (saveBtn) {
      saveBtn.textContent = editingSlug
        ? "Update dashboard"
        : saveDefaultLabel;
      saveBtn.title = editingSlug
        ? `Updates the saved dashboard at /u/${editingSlug}/`
        : "Saves this composition to your account";
    }

    // URL-overflow banner's CTA — funnel into the main Save button so
    // the OAuth + Supabase write path stays in one place.
    const overflowSaveBtn = shell.querySelector<HTMLButtonElement>(
      "[data-role='url-overflow-save']",
    );
    if (overflowSaveBtn && saveBtn) {
      overflowSaveBtn.addEventListener("click", () => {
        track("compose_url_overflow_save_clicked", {});
        saveBtn.click();
        // Scroll the save button into view so the user sees the OAuth /
        // confirmation feedback that comes next.
        saveBtn.scrollIntoView({ behavior: "smooth", block: "center" });
      });
    }
    if (saveBtn && isSupabaseConfigured) {
      const sb = createSupabase();
      if (sb) {
        saveBtn.addEventListener("click", async () => {
          // Step 1 of the save funnel: user clicked save. Captures whether
          // they were signed in or got bounced through OAuth.
          track("compose_save_attempted", {
            mode: editingSlug ? "update" : "create",
            wasSignedIn: !!readStoredSession(),
          });
          try {
            const stored = readStoredSession();
            if (!stored) {
              await sb.auth.signInWithOAuth({
                provider: "google",
                options: {
                  redirectTo: window.location.href,
                  scopes: "openid email",
                },
              });
              return;
            }
            const cleanSections = state.sections
              // A section is keep-worthy when it has charts OR a non-empty
              // markdown body. The two together cover both
              // "chart section" and "narrative-only block" cases.
              .filter(
                (s) =>
                  s.charts.length > 0 ||
                  (s.markdown && s.markdown.trim().length > 0),
              )
              .map((s) => ({
                title: s.title,
                description: s.description || undefined,
                charts: [...s.charts],
                markdown: s.markdown && s.markdown.trim().length > 0 ? s.markdown : undefined,
              }));
            if (cleanSections.length === 0) {
              alert("Add at least one chart or markdown block before saving.");
              return;
            }
            const stateJson = {
              v: 1,
              title: state.title || undefined,
              description: state.description || undefined,
              defaultDelta: state.defaultDelta || undefined,
              fixedRange: state.fixedRange,
              sections: cleanSections,
              inlineCharts: referencedInlineCharts(),
              inlineSources: referencedInlineSources(),
              chartOverrides: referencedChartOverrides(),
            };
            saveBtn.disabled = true;
            const restoreLabel = editingSlug ? "Update dashboard" : saveDefaultLabel;
            saveBtn.textContent = editingSlug ? "Updating…" : "Saving…";

            let targetSlug: string;
            let res: Response;
            if (editingSlug) {
              // PATCH the existing row — owner-only per RLS. If the caller
              // doesn't own this slug the request returns 204 with zero rows
              // matched, so we explicitly fetch representation to confirm.
              targetSlug = editingSlug;
              const url = `${SUPABASE_REST_URL}/rest/v1/saved_dashboards?slug=eq.${encodeURIComponent(targetSlug)}`;
              res = await fetch(url, {
                method: "PATCH",
                headers: {
                  "Content-Type": "application/json",
                  apikey: SUPABASE_REST_ANON_KEY,
                  Authorization: `Bearer ${stored.access_token}`,
                  Prefer: "return=representation",
                },
                body: JSON.stringify({
                  title: state.title || "Untitled dashboard",
                  state_json: stateJson,
                }),
              });
            } else {
              targetSlug = nanoid(10);
              res = await fetch(`${SUPABASE_REST_URL}/rest/v1/saved_dashboards`, {
                method: "POST",
                headers: {
                  "Content-Type": "application/json",
                  apikey: SUPABASE_REST_ANON_KEY,
                  Authorization: `Bearer ${stored.access_token}`,
                  Prefer: "return=minimal",
                },
                body: JSON.stringify({
                  slug: targetSlug,
                  owner_id: stored.user.id,
                  title: state.title || "Untitled dashboard",
                  state_json: stateJson,
                }),
              });
            }
            saveBtn.disabled = false;
            saveBtn.textContent = restoreLabel;
            if (!res.ok) {
              const msg = await res.text().catch(() => `HTTP ${res.status}`);
              console.error("[save] error:", msg);
              alert(`Save failed: ${msg}`);
              return;
            }
            if (editingSlug) {
              // PATCH with return=representation returns [] if RLS filtered
              // the update out (i.e. you don't own this slug). Treat that as
              // a permission error rather than silently no-op'ing.
              const rows = await res.json().catch(() => []);
              if (!Array.isArray(rows) || rows.length === 0) {
                alert(
                  "Couldn't update this dashboard — you may not own it, or it no longer exists.",
                );
                return;
              }
            }
            // Step 2 of the save funnel: persisted. compose_save_attempted →
            // compose_save_succeeded ratio tells us how often the save flow
            // actually completes vs. dies in OAuth or hits a Supabase error.
            track("compose_save_succeeded", {
              mode: editingSlug ? "update" : "create",
              slug: targetSlug,
            });
            // On create (not update) include ?just-saved=1 so the /u/<slug>/
            // page knows to surface the post-save email-signup prompt. Edits
            // skip the prompt — the user has already been through this flow.
            const arriveQuery = editingSlug ? "" : "?just-saved=1";
            window.location.href = `${baseUrl}/u/${targetSlug}/${arriveQuery}`;
          } catch (e) {
            console.error("[save] click handler threw:", e);
            alert(`Save failed: ${String(e)}`);
            saveBtn.disabled = false;
            saveBtn.textContent = "Save to my account";
          }
        });
      }
    }
  }

  // ---- Per-chart blurb / title override modal ----
  let cbEditingChartId: string | null = null;

  function openChartBlurbModal(chartId: string): void {
    cbEditingChartId = chartId;
    const existing = state.chartOverrides[chartId] ?? {};
    const libChart = library?.charts.find((c) => c.id === chartId);
    const backdrop = shell.querySelector<HTMLElement>("[data-role='cb-modal']");
    if (!backdrop) return;
    backdrop.hidden = false;
    const nameEl = shell.querySelector<HTMLElement>("[data-role='cb-chart-name']");
    if (nameEl) {
      nameEl.textContent = libChart?.title ?? chartId;
    }
    const titleInput = shell.querySelector<HTMLInputElement>("[data-role='cb-title']");
    if (titleInput) {
      titleInput.value = existing.title ?? "";
      titleInput.placeholder = `Leave blank to keep "${libChart?.title ?? chartId}"`;
      titleInput.focus();
    }
    const blurbInput = shell.querySelector<HTMLTextAreaElement>("[data-role='cb-blurb']");
    if (blurbInput) blurbInput.value = existing.blurb ?? "";
  }

  function closeChartBlurbModal(): void {
    cbEditingChartId = null;
    const backdrop = shell.querySelector<HTMLElement>("[data-role='cb-modal']");
    if (backdrop) backdrop.hidden = true;
  }

  function wireChartBlurbModal(): void {
    const backdrop = shell.querySelector<HTMLElement>("[data-role='cb-modal']");
    const closeBtn = shell.querySelector<HTMLButtonElement>("[data-role='cb-close']");
    const cancelBtn = shell.querySelector<HTMLButtonElement>("[data-role='cb-cancel']");
    const saveBtn = shell.querySelector<HTMLButtonElement>("[data-role='cb-save']");
    closeBtn?.addEventListener("click", closeChartBlurbModal);
    cancelBtn?.addEventListener("click", closeChartBlurbModal);
    backdrop?.addEventListener("click", (e) => {
      if (e.target === backdrop) closeChartBlurbModal();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape" || !backdrop || backdrop.hidden) return;
      closeChartBlurbModal();
    });
    saveBtn?.addEventListener("click", () => {
      if (!cbEditingChartId) return;
      const titleInput = shell.querySelector<HTMLInputElement>("[data-role='cb-title']");
      const blurbInput = shell.querySelector<HTMLTextAreaElement>("[data-role='cb-blurb']");
      const title = (titleInput?.value ?? "").trim();
      const blurb = (blurbInput?.value ?? "").trim();
      const existing = state.chartOverrides[cbEditingChartId] ?? {};
      const next: ChartOverride = { ...existing };
      if (title) next.title = title;
      else delete next.title;
      if (blurb) next.blurb = blurb;
      else delete next.blurb;
      if (Object.keys(next).length === 0) {
        delete state.chartOverrides[cbEditingChartId];
      } else {
        state.chartOverrides[cbEditingChartId] = next;
      }
      writeUrl();
      renderComposition();
      closeChartBlurbModal();
    });
  }

  // ---- Custom-chart modal ----
  // Modal state (ephemeral — does not live in composed state until Save is clicked).
  const ccModal = store.ccModal;

  // The custom-chart builder (source picker, mode/shading/annotation controls,
  // merge flow, live Plot preview) moved to src/lib/composer/cc-modal.ts (Plan
  // 2d). createCustomChartModal is destructured near the other 2d factories;
  // ccModal stays here so updateCcAnnotationsWarning can read its selection.

  // ---- Derived-source modal ----
  // A derived source = A op B, where A and B can each be a real source ID
  // OR another derived source ID (recursive). Stored in state.inlineSources
  // keyed by `derived:<nanoid>`. Once created it appears in the source
  // picker for + Custom chart and as an A/B option for further derivation.

  const dsModal = store.dsModal;

  // The derived-source builder (A/B pickers, suggestion chips, create flow)
  // moved to src/lib/composer/ds-modal.ts (Plan 2d). createDerivedSourceModal
  // is destructured near the other 2d factories above; dsModal stays here so
  // geoSurfaceConfig (the shared geo-chip wiring) can read its geo / cd state.

  function wireSigninPrompt(): void {
    const backdrop = shell.querySelector<HTMLElement>(
      "[data-role='signin-prompt']",
    );
    const closeBtn = shell.querySelector<HTMLButtonElement>(
      "[data-role='signin-prompt-close']",
    );
    const dismissBtn = shell.querySelector<HTMLButtonElement>(
      "[data-role='signin-prompt-dismiss']",
    );
    const signinBtn = shell.querySelector<HTMLButtonElement>(
      "[data-role='signin-prompt-signin']",
    );
    const close = () => {
      if (backdrop) backdrop.hidden = true;
    };
    closeBtn?.addEventListener("click", close);
    dismissBtn?.addEventListener("click", close);
    backdrop?.addEventListener("click", (e) => {
      if (e.target === backdrop) close();
    });
    // Local Supabase client — same factory the save flow uses below. The
    // module's createSupabase memoizes internally so we don't double-up.
    const sb = isSupabaseConfigured ? createSupabase() : null;
    if (signinBtn && sb) {
      signinBtn.addEventListener("click", async () => {
        // Same OAuth flow as the Save-to-account button. redirectTo back
        // to the current URL means the composer state (encoded in ?d=)
        // survives the round trip, so the user returns to the same
        // in-progress dashboard with their session token attached.
        track("compose_signin_prompt_clicked", {});
        try {
          await sb.auth.signInWithOAuth({
            provider: "google",
            options: {
              redirectTo: window.location.href,
              scopes: "openid email",
            },
          });
        } catch {
          // OAuth failure — leave the modal open so the user can retry
          // or dismiss. Network errors and provider 4xx land here.
        }
      });
    } else if (signinBtn) {
      // Supabase isn't configured in this build (no envvars). Hide the
      // sign-in CTA rather than offer a dead button; the close button
      // still works.
      signinBtn.style.display = "none";
    }
  }

  // wireCustomChartModal moved to src/lib/composer/cc-modal.ts (Plan 2d).

  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  // ---- Copy-mode title auto-increment ----
  //
  // When the composer is launched via "Make a copy" from /u/<slug>/,
  // we want the new dashboard's title to be the source title plus an
  // auto-incrementing " (N)" suffix so the user's saved-dashboards
  // list doesn't end up with two "US macro" rows.
  //
  // Algorithm: query the signed-in user's saved_dashboards for every
  // title that matches /^<base>(?: \(\d+\))?$/, find the max N (the
  // original counts as N=1), pick N+1.
  //
  // If the user isn't signed in OR the Supabase query fails, fall
  // back to "<base> (2)" — saving still works because the slug is
  // nanoid-generated, not derived from the title. The user can
  // hand-edit the title before saving if they want a specific name.
  async function applyCopyModeTitleBump(): Promise<void> {
    if (!copyMode) return;
    const baseTitle = (state.title ?? "").trim();
    if (!baseTitle) return;
    let nextTitle = `${baseTitle} (2)`;
    try {
      const sb = isSupabaseConfigured ? createSupabase() : null;
      const stored = readStoredSession();
      if (sb && stored) {
        const { data, error } = await sb
          .from("saved_dashboards")
          .select("title")
          .eq("owner_id", stored.user.id);
        if (!error && data) {
          // Strip an existing " (N)" off the base so copy-of-a-copy
          // produces "Foo (3)" instead of "Foo (2) (2)".
          const baseStripped = baseTitle.replace(/\s*\(\d+\)\s*$/, "");
          const escapedBase = baseStripped.replace(
            /[.*+?^${}()|[\]\\]/g, "\\$&",
          );
          const re = new RegExp(
            `^${escapedBase}(?:\\s*\\((\\d+)\\))?$`,
          );
          let maxN = 1;  // the original (no suffix) counts as N=1
          for (const row of data) {
            const t = (row as { title?: string }).title ?? "";
            const m = t.match(re);
            if (m) {
              const n = m[1] ? parseInt(m[1], 10) : 1;
              if (Number.isFinite(n) && n > maxN) maxN = n;
            }
          }
          nextTitle = `${baseStripped} (${maxN + 1})`;
        }
      }
    } catch (e) {
      console.warn("[compose] copy-mode title bump failed:", e);
    }
    state.title = nextTitle;
    const titleInput = shell.querySelector<HTMLInputElement>(
      "[data-role='title-input']",
    );
    if (titleInput) titleInput.value = nextTitle;
    writeUrl();
    track("compose_copy_started", {
      fromTitle: baseTitle,
      newTitle: nextTitle,
    });
  }

  // ---- Go ----
  hydrateFromUrl();
  wire();
  writeUrl(); // sync preview link
  void applyCopyModeTitleBump();

  loadLibrary(baseUrl)
    .then((lib) => {
      library = lib;
      // Render both tabs' filter strips eagerly so the counts are
      // accurate the first time the user opens either tab. Result
      // lists render lazily per tab on first activation, plus
      // immediately for the default tab (sources).
      renderTagFiltersSources();
      renderTagFiltersCharts();
      renderMetroChip();
      renderCdChip();
      renderCountryChip();
      renderSourcesList();
      renderComposition();
    })
    .catch((e) => {
      const host = shell.querySelector<HTMLElement>(
        "[data-role='lib-results-sources']",
      );
      if (host) host.innerHTML = `<p class="muted small">Failed to load library: ${escapeHtml(String(e))}</p>`;
    });
</script>

