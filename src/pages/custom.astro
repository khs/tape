---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionChart from "../components/SectionChart.astro";
import ChartController from "../components/ChartController.astro";
import { DELTA_LABELS_SHORT } from "../lib/deltas";
import { effectiveChart } from "../lib/resolve-dashboard";
import {
  resolveDashboardForRender,
  type DashboardForRender,
} from "../lib/resolve-dashboard-for-render";
import { decodeComposedState } from "../lib/composer-state";
import AnalyticsDashboardView from "../components/AnalyticsDashboardView.astro";
import { renderMarkdown } from "../lib/markdown";

// Server-rendered so `Astro.url.searchParams.get("d")` reads the request URL,
// not the (empty) build-time URL. The Vercel adapter turns this into a tiny
// serverless function.
export const prerender = false;

const dParam = Astro.url.searchParams.get("d");
const decoded = decodeComposedState(dParam);

// When the composer's Preview link hands off an edit context (i.e.
// the composer was launched from /u/<slug>/'s Edit button), the
// editingSlug ride along here. /custom/ uses it to:
//   - Show a "previewing edits to /u/<slug>/" banner instead of the
//     usual orphan-fork chrome.
//   - Switch the Save button to "Update dashboard", which UPDATES the
//     existing saved_dashboards row instead of INSERTing a new one.
// Bare /custom/?d=… without `&edit=` is the pre-existing path
// (anyone sharing a composer link gets a fresh copy on Save).
const editingSlug = Astro.url.searchParams.get("edit");

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

let title = "Composed dashboard";
let description: string | undefined;
let defaultDeltaRequested: DashboardForRender["defaultDelta"] | undefined;
let resolvedSections: DashboardForRender["sections"] = [];
let supported: DashboardForRender["supportedDeltas"] = [];
let barSnapshots: DashboardForRender["barSnapshots"] = new Map();
let viewedSourceIds: DashboardForRender["viewedSourceIds"] = [];
let viewedChartCount = 0;
let errorMessage: string | null = null;
let forkUrl: string | null = null;
let chartOverrides: Record<string, Partial<import("astro:content").CollectionEntry<"charts">["data"]>> | undefined;
let fixedRange: { start: string; end: string } | undefined;

if (!decoded.ok) {
  errorMessage = decoded.message;
} else {
  const st = decoded.state;
  title = st.title ?? "Composed dashboard";
  description = st.description;
  chartOverrides = st.chartOverrides as typeof chartOverrides;
  fixedRange = st.fixedRange;
  const r = await resolveDashboardForRender({
    sections: st.sections,
    charts: st.charts,
    chartOverrides,
    inlineCharts: st.inlineCharts,
    inlineSources: st.inlineSources,
    // Inline maps are a parallel registry to inlineCharts — resolve-
    // dashboard.ts dispatches `inlinemap:<id>` references through this
    // map and synthesizes a CollectionEntry with render="choropleth".
    // Without passing it here, every inline map silently drops out of
    // the resolved sections (filtered as "unresolved chart") and the
    // tile vanishes on Preview while still appearing in the composer.
    inlineMaps: st.inlineMaps,
  });
  resolvedSections = r.sections;
  supported = r.supportedDeltas;
  defaultDeltaRequested = r.defaultDelta;
  barSnapshots = r.barSnapshots;
  viewedSourceIds = r.viewedSourceIds;
  viewedChartCount = r.viewedChartCount;
  forkUrl = baseUrl + "/compose/?d=" + (dParam ?? "");
  // If we're previewing an edit, the "Open in composer" link should
  // keep the edit-slug context so the user lands back where they
  // started (Save still updates /u/<slug>/, not insert).
  if (editingSlug) {
    forkUrl += `&edit=${encodeURIComponent(editingSlug)}`;
  }
}

// viewedSourceIds / viewedChartCount / barSnapshots are populated by
// resolveDashboardForRender in the success branch above; the error branch
// leaves the empty defaults so the JSX renders the error panel cleanly.
---

<BaseLayout
  title={`${title} — Tape`}
  description={description}
  ogImage={dParam ? `/og.png?d=${encodeURIComponent(dParam)}` : undefined}
>
  <div
    class="dashboard-root max-w-[1200px] mx-auto px-6 pt-8 pb-16"
    data-dashboard-default-window={defaultDeltaRequested ?? "1m"}
  >
    {/* Breadcrumb shortcuts. Hidden client-side for signed-in users —
        the BaseLayout header already exposes "Compose" + "My dashboards"
        in the top-right, so this nav is duplicate chrome for anyone
        with a session. Anonymous viewers still see it (they don't
        have the signed-in header links). */}
    <nav class="text-xs text-neutral-500 mb-3" data-role="dashboard-breadcrumb">
      <a href={baseUrl || "/"} class="no-underline hover:text-neutral-900">All dashboards</a>
      <span class="mx-1">·</span>
      <a href={`${baseUrl}/compose/`} class="no-underline hover:text-neutral-900">Composer</a>
    </nav>

    {
      errorMessage ? (
        <div class="max-w-[640px] p-6 border hairline rounded bg-neutral-100 text-sm text-neutral-700 leading-relaxed">
          <p><strong>Couldn't render this composed dashboard.</strong></p>
          <p class="mt-2">{errorMessage}</p>
          <p class="mt-3">
            <a href={`${baseUrl}/compose/`} class="underline">Start from scratch &rarr;</a>
          </p>
        </div>
      ) : (
        <>
          <header class="mb-4">
            <div class="flex items-baseline justify-between flex-wrap gap-3">
              <h1 class="text-2xl font-semibold">{title}</h1>
              <div class="flex gap-2">
                <button
                  type="button"
                  class="text-xs text-neutral-600 hover:text-neutral-900 border hairline rounded-sm px-2 py-1 bg-white cursor-pointer"
                  data-role="copy-link"
                >
                  Copy link
                </button>
                <button
                  type="button"
                  class="text-xs text-neutral-600 hover:text-neutral-900 border hairline rounded-sm px-2 py-1 bg-white cursor-pointer"
                  data-role="save"
                  data-editing-slug={editingSlug ?? ""}
                >
                  {editingSlug ? "Update dashboard" : "Save to my account"}
                </button>
                {forkUrl && (
                  <a
                    href={forkUrl}
                    class="text-xs text-neutral-600 no-underline hover:text-neutral-900 border hairline rounded-sm px-2 py-1"
                  >
                    {editingSlug ? "Back to editing" : "Open in composer"} &rarr;
                  </a>
                )}
              </div>
              <script
                is:inline
                type="application/json"
                data-role="custom-state"
                set:html={JSON.stringify(decoded.ok ? decoded.state : null)}
              />
              <script
                is:inline
                type="application/json"
                data-role="custom-base-url"
                set:html={JSON.stringify(baseUrl)}
              />
              <script
                is:inline
                type="application/json"
                data-role="custom-editing-slug"
                set:html={JSON.stringify(editingSlug ?? null)}
              />
            </div>
            {description && (
              <p class="mt-2 text-sm text-neutral-600 max-w-[640px]">{description}</p>
            )}
            {editingSlug && (
              <p class="mt-2 text-xs text-neutral-600 max-w-[640px]" data-role="edit-preview-banner">
                Previewing unsaved edits to <a
                  href={`${baseUrl}/u/${editingSlug}/`}
                  class="underline"
                >{`/u/${editingSlug}/`}</a>.
                <strong>Update dashboard</strong> applies them; <strong>Back
                to editing</strong> returns to the composer with your changes
                intact.
              </p>
            )}
          </header>

          <script>
            import { createSupabase, isSupabaseConfigured, readStoredSession } from "../lib/supabase";
            import { nanoid } from "nanoid";
            import { track } from "../lib/track";

            // Hide the "All dashboards · Composer" breadcrumb for
            // signed-in viewers — those shortcuts already live in the
            // top-right BaseLayout header. Same logic lives on
            // src/pages/u/[slug].astro; keep them in sync.
            if (readStoredSession()) {
              const breadcrumb = document.querySelector<HTMLElement>(
                "[data-role='dashboard-breadcrumb']",
              );
              if (breadcrumb) breadcrumb.style.display = "none";
            }

            // --- Copy link ---
            const copyBtn = document.querySelector<HTMLButtonElement>(
              "[data-role='copy-link']",
            );
            copyBtn?.addEventListener("click", async () => {
              try {
                await navigator.clipboard.writeText(window.location.href);
                const original = copyBtn.textContent;
                copyBtn.textContent = "Copied!";
                setTimeout(() => (copyBtn.textContent = original), 1500);
                track("custom_share_copied", {
                  urlLength: window.location.href.length,
                });
              } catch {
                alert("Copy failed. URL is in the address bar.");
              }
            });

            // --- Save to my account ---
            const saveBtn = document.querySelector<HTMLButtonElement>(
              "[data-role='save']",
            );
            if (saveBtn && isSupabaseConfigured) {
              const sb = createSupabase();
              if (sb) {
                saveBtn.addEventListener("click", async () => {
                  // Step 1: user clicked save on a viewer page. Different
                  // event name from the composer save so we can tell which
                  // surface (composer vs. /custom/ viewer) is doing the work.
                  track("custom_save_attempted", {});
                  try {
                    const { data: sess } = await sb.auth.getSession();
                    const user = sess.session?.user ?? null;
                    if (!user) {
                      await sb.auth.signInWithOAuth({
                        provider: "google",
                        options: {
                          redirectTo: window.location.href,
                          scopes: "openid email",
                        },
                      });
                      return;
                    }
                    const stateEl =
                      document.querySelector<HTMLScriptElement>(
                        "[data-role='custom-state']",
                      );
                    const baseUrlEl =
                      document.querySelector<HTMLScriptElement>(
                        "[data-role='custom-base-url']",
                      );
                    if (!stateEl?.textContent) {
                      alert("No composition to save.");
                      return;
                    }
                    const state = JSON.parse(stateEl.textContent);
                    if (!state) {
                      alert("This dashboard's state is malformed.");
                      return;
                    }
                    const baseUrl =
                      (baseUrlEl?.textContent &&
                        JSON.parse(baseUrlEl.textContent)) ||
                      "";
                    // Read the edit-slug embedded in the SSR JSON
                    // sidecar. If set, we're updating an existing
                    // saved_dashboards row (the user came in through
                    // the composer's edit flow → Preview); otherwise
                    // we mint a fresh slug.
                    const editingSlugEl =
                      document.querySelector<HTMLScriptElement>(
                        "[data-role='custom-editing-slug']",
                      );
                    const editingSlug = editingSlugEl?.textContent
                      ? (JSON.parse(editingSlugEl.textContent) as string | null)
                      : null;
                    const restoreLabel = editingSlug
                      ? "Update dashboard"
                      : "Save to my account";
                    saveBtn.disabled = true;
                    saveBtn.textContent = editingSlug
                      ? "Updating…"
                      : "Saving…";
                    if (editingSlug) {
                      // UPDATE path — the existing /u/<slug>/ row is
                      // overwritten with the edited state. RLS on the
                      // saved_dashboards table guarantees only the
                      // owner's update will succeed; if the user isn't
                      // the owner (e.g. someone forged the &edit param
                      // on a shared link), the update affects zero
                      // rows and we fall back to insert as a fresh
                      // copy.
                      const { data: upd, error: updErr } = await sb
                        .from("saved_dashboards")
                        .update({
                          title: state.title || "Untitled dashboard",
                          state_json: state,
                        })
                        .eq("slug", editingSlug)
                        .select();
                      if (updErr) {
                        alert(`Update failed: ${updErr.message}`);
                        saveBtn.disabled = false;
                        saveBtn.textContent = restoreLabel;
                        return;
                      }
                      if (!upd || upd.length === 0) {
                        // RLS rejected the update — fall through to an
                        // insert as a fresh copy so the user's edits
                        // don't get lost.
                        console.warn(
                          "[custom save] update affected 0 rows (likely RLS / not owner); inserting as fresh copy",
                        );
                      } else {
                        track("custom_save_succeeded", {
                          slug: editingSlug, mode: "update",
                        });
                        window.location.href = `${baseUrl}/u/${editingSlug}/`;
                        return;
                      }
                    }
                    const slug = nanoid(10);
                    const { error } = await sb
                      .from("saved_dashboards")
                      .insert({
                        slug,
                        owner_id: user.id,
                        title: state.title || "Untitled dashboard",
                        state_json: state,
                      })
                      .select();
                    saveBtn.disabled = false;
                    saveBtn.textContent = restoreLabel;
                    if (error) {
                      alert(`Save failed: ${error.message}`);
                      return;
                    }
                    track("custom_save_succeeded", { slug, mode: "create" });
                    // ?just-saved=1 triggers the post-save email-capture
                    // prompt on the /u/<slug>/ page; the param is stripped
                    // after first read so it doesn't survive refresh/share.
                    window.location.href = `${baseUrl}/u/${slug}/?just-saved=1`;
                  } catch (e) {
                    console.error("[custom save] exception:", e);
                    alert(`Save failed: ${String(e)}`);
                    saveBtn.disabled = false;
                    saveBtn.textContent = "Save to my account";
                  }
                });
              }
            }
          </script>

          {fixedRange ? (
            <div class="dashboard-window" role="group" aria-label="Fixed range">
              <span class="eyebrow">Range</span>
              <span class="dashboard-fixed-range">
                {fixedRange.start} → {fixedRange.end}
              </span>
            </div>
          ) : (
            supported.length > 0 && (
              <div class="dashboard-window" role="group" aria-label="Default window">
                <span class="eyebrow">Window</span>
                <div class="pills" data-dashboard-window-control>
                  {supported.map((w) => (
                    <button
                      type="button"
                      class={
                        "pill" + (w === defaultDeltaRequested ? " pill-active" : "")
                      }
                      data-dashboard-window={w}
                      aria-pressed={w === defaultDeltaRequested ? "true" : "false"}
                    >
                      {DELTA_LABELS_SHORT[w]}
                    </button>
                  ))}
                </div>
              </div>
            )
          )}

          {resolvedSections.map((section) => {
            // Section-level window override beats dashboard-level
            // (which itself beats chart-level). See sectionSchema in
            // src/lib/composer-state.ts — the composer lets users
            // pin each section to its own decade or window.
            const sectionDelta = section.defaultDelta ?? defaultDeltaRequested;
            const sectionFixed = section.fixedRange ?? fixedRange;
            return (
            <section class={`dash-section${section.charts.length === 0 && section.markdown ? " dash-section-markdown" : ""}`}>
              {section.title && (
                <h2 class="section-heading">{section.title}</h2>
              )}
              {section.description && (
                <p class="section-description">{section.description}</p>
              )}
              {(section.fixedRange || section.defaultDelta) && (
                <p class="section-window muted small">
                  Window:{" "}
                  {section.fixedRange
                    ? `${section.fixedRange.start} → ${section.fixedRange.end}`
                    : section.defaultDelta}
                </p>
              )}
              {section.markdown && section.markdown.trim().length > 0 && (
                <div class="section-markdown" set:html={renderMarkdown(section.markdown)} />
              )}
              {section.charts.length > 0 && (
              <div class="chart-grid">
                {section.charts.map((c) => (
                  <SectionChart
                    chartId={c.chart.id}
                    chart={effectiveChart(c, chartOverrides?.[c.chart.id])}
                    sources={c.sources}
                    dashboardSlug="custom"
                    sectionDelta={sectionDelta}
                    sectionFixedRange={sectionFixed}
                    sectionLocked={!!(section.defaultDelta || section.fixedRange)}
                    preloaded={c.preloaded}
                    barSnapshot={barSnapshots.get(c.chart.id)}
                  />
                ))}
              </div>
              )}
            </section>
            );
          })}

          {resolvedSections.length === 0 && (
            <p class="mt-6 text-sm text-neutral-500">
              This composition has no charts yet. <a href={`${baseUrl}/compose/`} class="underline">Edit in composer</a>.
            </p>
          )}
        </>
      )
    }
  </div>

  <ChartController />
  {viewedChartCount > 0 && (
    <AnalyticsDashboardView
      sources={viewedSourceIds}
      surface="custom"
      chartCount={viewedChartCount}
    />
  )}
</BaseLayout>

<style>
  .dashboard-window {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }
  .dashboard-fixed-range {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: var(--text-xs);
    color: var(--color-neutral-700);
    background: var(--color-neutral-100);
    padding: 3px 8px;
    border-radius: var(--radius-sm);
  }
  .dashboard-window .pills {
    display: flex;
    gap: 4px;
    font-size: var(--text-xs);
    font-weight: 500;
  }
  .dashboard-window .pill {
    padding: 4px 10px;
    border: 1px solid rgba(55, 53, 47, 0.1);
    border-radius: var(--radius-sm);
    background: var(--color-white);
    color: var(--color-neutral-600);
    cursor: pointer;
    font: inherit;
  }
  .dashboard-window .pill:hover {
    background: var(--color-neutral-100);
  }
  .dashboard-window .pill-active,
  .dashboard-window .pill-active:hover {
    background: var(--color-neutral-900);
    color: var(--color-white);
    border-color: var(--color-neutral-900);
  }
  .dash-section {
    margin-bottom: 32px;
  }
  .section-heading {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-neutral-900);
    margin: 0 0 4px;
  }
  .section-description {
    font-size: var(--text-sm);
    color: var(--color-neutral-600);
    line-height: 1.5;
    margin: 0 0 12px;
    max-width: 720px;
    white-space: pre-wrap;
  }
  /* Markdown body inside a section. Editorial prose styling — see
     the equivalent block in src/pages/u/[slug].astro for the
     rationale comment. */
  .section-markdown {
    max-width: 720px;
    margin: 4px 0 16px;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-neutral-700);
  }
  .section-markdown :global(p) { margin: 0 0 10px; }
  .section-markdown :global(h2) { font-size: var(--text-base); font-weight: 600; color: var(--color-neutral-900); margin: 14px 0 6px; }
  .section-markdown :global(h3) { font-size: var(--text-sm); font-weight: 600; color: var(--color-neutral-900); margin: 12px 0 4px; }
  .section-markdown :global(h4) { font-size: var(--text-sm); font-weight: 600; color: var(--color-neutral-600); margin: 10px 0 4px; }
  .section-markdown :global(ul),
  .section-markdown :global(ol) { margin: 0 0 10px; padding-left: 22px; }
  .section-markdown :global(li) { margin: 0 0 3px; }
  .section-markdown :global(a) { color: var(--color-neutral-900); text-decoration: underline; text-underline-offset: 2px; }
  .section-markdown :global(code) { background: var(--color-neutral-100); padding: 1px 4px; border-radius: 3px; font-size: 0.92em; }
  .section-markdown :global(pre) { background: var(--color-neutral-100); padding: 8px 10px; border-radius: 3px; overflow-x: auto; font-size: 12px; }
  .section-markdown :global(pre code) { background: transparent; padding: 0; }
  .dash-section-markdown .section-markdown { max-width: 880px; }
  .dash-section-markdown { padding-bottom: 8px; border-bottom: 1px solid rgba(55, 53, 47, 0.06); }
  /* Section-level window override chip (see [...slug].astro for the
     rationale comment). */
  .section-window {
    margin: -4px 0 12px;
    font-variant-numeric: tabular-nums;
  }
  .chart-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 12px;
  }
  @media (min-width: 768px) {
    .chart-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
