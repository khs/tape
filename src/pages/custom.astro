---
import BaseLayout from "../layouts/BaseLayout.astro";
import Chart from "../components/Chart.astro";
import ChartChoropleth from "../components/ChartChoropleth.astro";
import ChartController from "../components/ChartController.astro";
import { DELTA_LABELS_SHORT } from "../lib/deltas";
import {
  resolveSections,
  dashboardSupportedDeltas,
  resolveDashboardDefault,
  effectiveChart,
} from "../lib/resolve-dashboard";
import { decodeComposedState } from "../lib/composer-state";
import AnalyticsDashboardView from "../components/AnalyticsDashboardView.astro";

// Server-rendered so `Astro.url.searchParams.get("d")` reads the request URL,
// not the (empty) build-time URL. The Vercel adapter turns this into a tiny
// serverless function.
export const prerender = false;

const dParam = Astro.url.searchParams.get("d");
const decoded = decodeComposedState(dParam);

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

let title = "Composed dashboard";
let description: string | undefined;
let defaultDeltaRequested: ReturnType<typeof resolveDashboardDefault> | undefined;
let resolvedSections: Awaited<ReturnType<typeof resolveSections>> = [];
let supported: ReturnType<typeof dashboardSupportedDeltas> = [];
let errorMessage: string | null = null;
let forkUrl: string | null = null;
let chartOverrides: Record<string, Partial<import("astro:content").CollectionEntry<"charts">["data"]>> | undefined;
let fixedRange: { start: string; end: string } | undefined;

if (!decoded.ok) {
  errorMessage = decoded.message;
} else {
  const st = decoded.state;
  title = st.title ?? "Composed dashboard";
  description = st.description;
  chartOverrides = st.chartOverrides as typeof chartOverrides;
  fixedRange = st.fixedRange;
  resolvedSections = await resolveSections({
    sections: st.sections,
    charts: st.charts,
    inlineCharts: st.inlineCharts,
    inlineSources: st.inlineSources,
  });
  supported = dashboardSupportedDeltas(resolvedSections);
  defaultDeltaRequested = resolveDashboardDefault(st.defaultDelta, supported);
  forkUrl = baseUrl + "/compose/?d=" + (dParam ?? "");
}

// Flatten resolved sources for the dashboard_viewed telemetry event.
const viewedSourceIds = Array.from(
  new Set(
    resolvedSections.flatMap((sec) =>
      sec.charts.flatMap((c) => c.sources.map((s) => s.id)),
    ),
  ),
);
const viewedChartCount = resolvedSections.reduce(
  (acc, sec) => acc + sec.charts.length,
  0,
);
---

<BaseLayout
  title={`${title} — Tape`}
  description={description}
  ogImage={dParam ? `/og.png?d=${encodeURIComponent(dParam)}` : undefined}
>
  <div
    class="dashboard-root max-w-[1200px] mx-auto px-6 pt-8 pb-16"
    data-dashboard-default-window={defaultDeltaRequested ?? "1m"}
  >
    <nav class="text-xs text-neutral-500 mb-3">
      <a href={baseUrl || "/"} class="no-underline hover:text-neutral-900">All dashboards</a>
      <span class="mx-1">·</span>
      <a href={`${baseUrl}/compose/`} class="no-underline hover:text-neutral-900">Composer</a>
    </nav>

    {
      errorMessage ? (
        <div class="max-w-[640px] p-6 border hairline rounded bg-neutral-100 text-sm text-neutral-700 leading-relaxed">
          <p><strong>Couldn't render this composed dashboard.</strong></p>
          <p class="mt-2">{errorMessage}</p>
          <p class="mt-3">
            <a href={`${baseUrl}/compose/`} class="underline">Start from scratch &rarr;</a>
          </p>
        </div>
      ) : (
        <>
          <header class="mb-4">
            <div class="flex items-baseline justify-between flex-wrap gap-3">
              <h1 class="text-2xl font-semibold">{title}</h1>
              <div class="flex gap-2">
                <button
                  type="button"
                  class="text-xs text-neutral-600 hover:text-neutral-900 border hairline rounded-sm px-2 py-1 bg-white cursor-pointer"
                  data-role="copy-link"
                >
                  Copy link
                </button>
                <button
                  type="button"
                  class="text-xs text-neutral-600 hover:text-neutral-900 border hairline rounded-sm px-2 py-1 bg-white cursor-pointer"
                  data-role="save"
                >
                  Save to my account
                </button>
                {forkUrl && (
                  <a
                    href={forkUrl}
                    class="text-xs text-neutral-600 no-underline hover:text-neutral-900 border hairline rounded-sm px-2 py-1"
                  >
                    Open in composer &rarr;
                  </a>
                )}
              </div>
              <script
                is:inline
                type="application/json"
                data-role="custom-state"
                set:html={JSON.stringify(decoded.ok ? decoded.state : null)}
              />
              <script
                is:inline
                type="application/json"
                data-role="custom-base-url"
                set:html={JSON.stringify(baseUrl)}
              />
            </div>
            {description && (
              <p class="mt-2 text-sm text-neutral-600 max-w-[640px]">{description}</p>
            )}
          </header>

          <script>
            import { createSupabase, isSupabaseConfigured } from "../lib/supabase";
            import { nanoid } from "nanoid";
            import { track } from "../lib/track";

            // --- Copy link ---
            const copyBtn = document.querySelector<HTMLButtonElement>(
              "[data-role='copy-link']",
            );
            copyBtn?.addEventListener("click", async () => {
              try {
                await navigator.clipboard.writeText(window.location.href);
                const original = copyBtn.textContent;
                copyBtn.textContent = "Copied!";
                setTimeout(() => (copyBtn.textContent = original), 1500);
                track("custom_share_copied", {
                  urlLength: window.location.href.length,
                });
              } catch {
                alert("Copy failed. URL is in the address bar.");
              }
            });

            // --- Save to my account ---
            const saveBtn = document.querySelector<HTMLButtonElement>(
              "[data-role='save']",
            );
            console.log("[custom save] button found:", !!saveBtn, "| sb configured:", isSupabaseConfigured);
            if (saveBtn && isSupabaseConfigured) {
              const sb = createSupabase();
              console.log("[custom save] sb client:", !!sb);
              if (sb) {
                saveBtn.addEventListener("click", async () => {
                  console.log("[custom save] click fired");
                  // Step 1: user clicked save on a viewer page. Different
                  // event name from the composer save so we can tell which
                  // surface (composer vs. /custom/ viewer) is doing the work.
                  track("custom_save_attempted", {});
                  try {
                    const { data: sess } = await sb.auth.getSession();
                    const user = sess.session?.user ?? null;
                    console.log("[custom save] user:", user?.email ?? null);
                    if (!user) {
                      console.log("[custom save] not signed in → redirecting to OAuth");
                      await sb.auth.signInWithOAuth({
                        provider: "google",
                        options: {
                          redirectTo: window.location.href,
                          scopes: "openid email",
                        },
                      });
                      return;
                    }
                    const stateEl =
                      document.querySelector<HTMLScriptElement>(
                        "[data-role='custom-state']",
                      );
                    const baseUrlEl =
                      document.querySelector<HTMLScriptElement>(
                        "[data-role='custom-base-url']",
                      );
                    console.log("[custom save] stateEl textContent length:", stateEl?.textContent?.length ?? 0);
                    if (!stateEl?.textContent) {
                      alert("No composition to save.");
                      return;
                    }
                    const state = JSON.parse(stateEl.textContent);
                    console.log("[custom save] parsed state:", state);
                    if (!state) {
                      alert("This dashboard's state is malformed.");
                      return;
                    }
                    const baseUrl =
                      (baseUrlEl?.textContent &&
                        JSON.parse(baseUrlEl.textContent)) ||
                      "";
                    const slug = nanoid(10);
                    console.log("[custom save] inserting slug:", slug);
                    saveBtn.disabled = true;
                    saveBtn.textContent = "Saving…";
                    const { data: ins, error } = await sb
                      .from("saved_dashboards")
                      .insert({
                        slug,
                        owner_id: user.id,
                        title: state.title || "Untitled dashboard",
                        state_json: state,
                      })
                      .select();
                    console.log("[custom save] insert result:", { ins, error });
                    saveBtn.disabled = false;
                    saveBtn.textContent = "Save to my account";
                    if (error) {
                      alert(`Save failed: ${error.message}`);
                      return;
                    }
                    track("custom_save_succeeded", { slug });
                    // ?just-saved=1 triggers the post-save email-capture
                    // prompt on the /u/<slug>/ page; the param is stripped
                    // after first read so it doesn't survive refresh/share.
                    window.location.href = `${baseUrl}/u/${slug}/?just-saved=1`;
                  } catch (e) {
                    console.error("[custom save] exception:", e);
                    alert(`Save failed: ${String(e)}`);
                    saveBtn.disabled = false;
                    saveBtn.textContent = "Save to my account";
                  }
                });
              }
            }
          </script>

          {fixedRange ? (
            <div class="dashboard-window" role="group" aria-label="Fixed range">
              <span class="eyebrow">Range</span>
              <span class="dashboard-fixed-range">
                {fixedRange.start} → {fixedRange.end}
              </span>
            </div>
          ) : (
            supported.length > 0 && (
              <div class="dashboard-window" role="group" aria-label="Default window">
                <span class="eyebrow">Window</span>
                <div class="pills" data-dashboard-window-control>
                  {supported.map((w) => (
                    <button
                      type="button"
                      class={
                        "pill" + (w === defaultDeltaRequested ? " pill-active" : "")
                      }
                      data-dashboard-window={w}
                      aria-pressed={w === defaultDeltaRequested ? "true" : "false"}
                    >
                      {DELTA_LABELS_SHORT[w]}
                    </button>
                  ))}
                </div>
              </div>
            )
          )}

          {resolvedSections.map((section) => {
            // Section-level window override beats dashboard-level
            // (which itself beats chart-level). See sectionSchema in
            // src/lib/composer-state.ts — the composer lets users
            // pin each section to its own decade or window.
            const sectionDelta = section.defaultDelta ?? defaultDeltaRequested;
            const sectionFixed = section.fixedRange ?? fixedRange;
            return (
            <section class="dash-section">
              {section.title && (
                <h2 class="section-heading">{section.title}</h2>
              )}
              {section.description && (
                <p class="section-description">{section.description}</p>
              )}
              {(section.fixedRange || section.defaultDelta) && (
                <p class="section-window muted small">
                  Window:{" "}
                  {section.fixedRange
                    ? `${section.fixedRange.start} → ${section.fixedRange.end}`
                    : section.defaultDelta}
                </p>
              )}
              <div class="chart-grid">
                {section.charts.map((c) => {
                  const eff = effectiveChart(c, chartOverrides?.[c.chart.id]);
                  // Same dispatch as the preset-dashboard renderer in
                  // pages/[...slug].astro: choropleth charts bind to a
                  // (geo, indicator, vintage) tuple instead of a list
                  // of time-series sources, so route them to
                  // ChartChoropleth. Composed maps from the Maps tab
                  // arrive here as inline-map chart IDs whose synthetic
                  // chart entry has render="choropleth".
                  if (eff.render === "choropleth") {
                    return (
                      <ChartChoropleth
                        chartId={c.chart.id}
                        chart={eff}
                        dashboardSlug="custom"
                      />
                    );
                  }
                  return (
                    <Chart
                      chartId={c.chart.id}
                      chart={eff}
                      sources={c.sources}
                      dashboardSlug="custom"
                      dashboardWindow={sectionDelta}
                      dashboardFixedRange={sectionFixed}
                      sectionLocked={!!(section.defaultDelta || section.fixedRange)}
                      preloaded={c.preloaded}
                    />
                  );
                })}
              </div>
            </section>
            );
          })}

          {resolvedSections.length === 0 && (
            <p class="mt-6 text-sm text-neutral-500">
              This composition has no charts yet. <a href={`${baseUrl}/compose/`} class="underline">Edit in composer</a>.
            </p>
          )}
        </>
      )
    }
  </div>

  <ChartController />
  {viewedChartCount > 0 && (
    <AnalyticsDashboardView
      sources={viewedSourceIds}
      surface="custom"
      chartCount={viewedChartCount}
    />
  )}
</BaseLayout>

<style>
  .dashboard-window {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }
  .dashboard-fixed-range {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: var(--text-xs);
    color: var(--color-neutral-700);
    background: var(--color-neutral-100);
    padding: 3px 8px;
    border-radius: var(--radius-sm);
  }
  .dashboard-window .pills {
    display: flex;
    gap: 4px;
    font-size: var(--text-xs);
    font-weight: 500;
  }
  .dashboard-window .pill {
    padding: 4px 10px;
    border: 1px solid rgba(55, 53, 47, 0.1);
    border-radius: var(--radius-sm);
    background: var(--color-white);
    color: var(--color-neutral-600);
    cursor: pointer;
    font: inherit;
  }
  .dashboard-window .pill:hover {
    background: var(--color-neutral-100);
  }
  .dashboard-window .pill-active {
    background: var(--color-neutral-900);
    color: var(--color-white);
    border-color: var(--color-neutral-900);
  }
  .dash-section {
    margin-bottom: 32px;
  }
  .section-heading {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-neutral-900);
    margin: 0 0 4px;
  }
  .section-description {
    font-size: var(--text-sm);
    color: var(--color-neutral-600);
    line-height: 1.5;
    margin: 0 0 12px;
    max-width: 720px;
    white-space: pre-wrap;
  }
  /* Section-level window override chip (see [...slug].astro for the
     rationale comment). */
  .section-window {
    margin: -4px 0 12px;
    font-variant-numeric: tabular-nums;
  }
  .chart-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 12px;
  }
  @media (min-width: 768px) {
    .chart-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
