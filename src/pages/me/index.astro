---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  ENTERPRISE_INQUIRY_URL,
  WALKTHROUGH_DASHBOARD_SLUG,
} from "../../lib/brand";
export const prerender = true;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

// "Last updated" reflects the BUILD/deploy date, captured at prerender time:
// this page is prerendered, so `new Date()` here is the instant `astro build`
// ran (on Vercel, the deploy time). Each deploy advances it, so it can't go
// stale the way the old hand-maintained LAST_FEATURE_UPDATE constant did
// (it sat at May 29 for weeks). Formatted UTC for a stable "Month D, YYYY".
const lastUpdatedDate = new Date();
const lastUpdatedLabel = lastUpdatedDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
---

<BaseLayout title="My dashboards — Tape">
  <div class="max-w-[880px] mx-auto px-6 py-10" data-me data-base-url={baseUrl}>
    <nav class="text-xs text-neutral-500 mb-3">
      <a href={baseUrl || "/"} class="no-underline hover:text-neutral-900">All dashboards</a>
    </nav>
    <h1 class="text-2xl font-semibold">My dashboards</h1>

    {/*
      Pre-paint initial state picked by the bottom script before
      hydration runs. Signed-out visitors used to see "Loading…" for a
      beat while the Supabase client booted, then have it replaced with
      the sign-in prompt — a small flicker but very obviously a flicker.
      Now the inline pre-paint script reads the cached Supabase session
      out of localStorage and either leaves "Loading…" (so the JS can
      fetch the dashboard list) or swaps to the sign-in prompt straight
      away.
    */}
    <div class="me-content mt-6" data-role="content">
      <p class="text-sm text-neutral-500">Loading…</p>
    </div>
    <script is:inline>
      // Synchronous, blocks paint. Cheap localStorage read so a signed-
      // out visitor never sees "Loading…" only to have it replaced.
      // Uses the same data-role / markup as the hydration's signed-out
      // branch so when the async render runs, it overwrites with
      // identical content and the click listener binds cleanly without
      // a visible re-render.
      // The HTML below is the canonical signed-out empty state. The
      // async script lower in the page renders BYTE-IDENTICAL markup
      // for the same case — when hydration runs, replaceChildren()
      // overwrites in place with no visible re-render. Keep the two
      // copies in sync; the duplication is deliberate (we can't
      // import a constant from a synchronous inline script).
      var SIGNED_OUT_HTML =
        '<section class="me-signin-empty">' +
          '<h2 class="me-signin-empty-title">Sign in to save dashboards.</h2>' +
          '<p class="me-signin-empty-pitch">An account on Tape gives you:</p>' +
          '<ul class="me-signin-empty-list">' +
            '<li>Saved dashboards at stable URLs you can paste into a draft.</li>' +
            '<li>A walkthrough seeded into your list — every Tape feature in one tour.</li>' +
            '<li>A pinnable default dashboard the home page loads first when you visit.</li>' +
            '<li>Indicator alerts that email you when a series crosses a threshold.</li>' +
          '</ul>' +
          '<button type="button" data-role="signin" class="me-signin-empty-cta">Sign in with Google &rarr;</button>' +
          '<p class="me-signin-empty-foot">We request the minimum OAuth scopes (openid + email). Details on /privacy/.</p>' +
        '</section>';
      (function () {
        try {
          var keys = Object.keys(localStorage);
          for (var i = 0; i < keys.length; i++) {
            // Supabase auth-token keys look like `sb-<ref>-auth-token`.
            if (/^sb-[^-]+-auth-token$/.test(keys[i])) {
              return; // signed in → leave "Loading…" for the list fetch
            }
          }
          var host = document.querySelector("[data-me] [data-role='content']");
          if (host) {
            host.innerHTML = SIGNED_OUT_HTML;
          }
        } catch (_e) {
          // localStorage blocked → fall through to "Loading…", the
          // async hydration will sort it out.
        }
      })();
    </script>

    {/* Account / tier block. Free tier is the only tier accounts get
        out-of-the-box. Enterprise is unlocked by inquiry → conversation →
        manual provisioning, not self-serve. The CTA links to the inquiry
        intake; the description tells users at a glance what enterprise
        gets vs. what they already have. */}
    <section class="account-section">
      <h2 class="account-eyebrow">Account</h2>
      <div class="account-card">
        <div class="account-tier">
          <span class="account-tier-name">Free</span>
          <span class="account-tier-blurb">
            You're on the free tier — all preset dashboards, the chart
            library, custom dashboards, and public sharing.
          </span>
        </div>
        {/* Walkthrough + last-update stamp. The walkthrough dashboard is
            curated to exercise every shipped feature; the date beside it is
            the BUILD/deploy date (computed at prerender time), so it advances
            automatically every deploy — no constant to hand-bump. Keep
            walkthrough.mdx current when shipping a feature. */}
        <div class="account-walkthrough">
          <div class="account-walkthrough-text">
            <p class="account-walkthrough-line">
              <strong>What's new.</strong> Tape was last updated on <strong>{lastUpdatedLabel}</strong>.
            </p>
            <p class="account-walkthrough-sub">
              The walkthrough dashboard exercises every shipped feature — a quick tour of what Tape can do.
            </p>
          </div>
          <a
            href={`${baseUrl}/${WALKTHROUGH_DASHBOARD_SLUG}/`}
            class="account-walkthrough-cta"
          >
            Open walkthrough &rarr;
          </a>
        </div>
        <div class="account-upgrade">
          <p class="account-upgrade-line">
            Need custom data sources, stability guarantees, whitelabeled
            embeds, or private dashboards?
          </p>
          <p class="account-upgrade-actions">
            <a href={ENTERPRISE_INQUIRY_URL} class="account-upgrade-cta">
              Ask about enterprise &rarr;
            </a>
          </p>
        </div>
      </div>
    </section>
  </div>

  <script>
    import { createSupabase, isSupabaseConfigured } from "../../lib/supabase";
    import { renderSavedDashboardList } from "../../lib/render-saved-dashboards";
    import { isAdmin } from "../../lib/admin";

    const host = document.querySelector<HTMLElement>("[data-me]");
    if (!host) throw new Error("me host missing");
    const baseUrl = host.dataset.baseUrl ?? "";
    const content = host.querySelector<HTMLElement>("[data-role='content']");

    const esc = (s: string): string =>
      s.replace(
        /[&<>"']/g,
        (c) =>
          (({
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#39;",
          }) as Record<string, string>)[c],
      );
    type MeAlertRow = {
      label: string | null;
      source_label: string;
      condition: string;
      threshold: number;
      paused: boolean;
    };
    const ALERT_COND_LABEL: Record<string, string> = {
      gt: ">",
      gte: "≥",
      lt: "<",
      lte: "≤",
      crosses_above: "crosses above",
      crosses_below: "crosses below",
      change_above: "changes by >",
    };

    // The user's alert rules, rendered below the dashboard list. /me/ is the
    // account home, so it surfaces every saved thing — dashboards AND alerts
    // — with a jump to the full manager. Secondary panel: a fetch failure
    // logs + skips rather than blanking the page.
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    async function renderAlertsSection(sb2: any, ownerId: string): Promise<void> {
      if (!content) return;
      let rules: MeAlertRow[] = [];
      try {
        const { data } = await sb2
          .from("alert_rules")
          .select("label,source_label,condition,threshold,paused")
          .eq("owner_id", ownerId)
          .order("updated_at", { ascending: false });
        rules = (data ?? []) as MeAlertRow[];
      } catch (e) {
        console.warn("[me] alerts load failed:", e);
        return;
      }
      const section = document.createElement("section");
      section.className = "me-alerts";
      const rows = rules
        .map((r) => {
          const cond = `${ALERT_COND_LABEL[r.condition] ?? r.condition} ${r.threshold}`;
          const name = r.label || r.source_label || "alert";
          const sub = r.label ? ` · ${r.source_label}` : "";
          const paused = r.paused
            ? ' <span class="me-alert-paused">paused</span>'
            : "";
          return `<li class="me-alert-row"><span class="me-alert-name">${esc(name)}</span><span class="me-alert-cond muted">${esc(cond)}${esc(sub)}</span>${paused}</li>`;
        })
        .join("");
      section.innerHTML =
        '<div class="me-alerts-head">' +
        '<h2 class="me-alerts-title">Alerts</h2>' +
        `<a class="me-alerts-manage" href="${baseUrl}/alerts/">Manage &rarr;</a>` +
        "</div>" +
        (rules.length
          ? `<ul class="me-alerts-list">${rows}</ul>`
          : `<p class="me-alerts-empty muted">No alerts yet. <a href="${baseUrl}/alerts/">Set one up &rarr;</a></p>`);
      content.appendChild(section);
    }

    async function render(): Promise<void> {
      if (!content) return;
      if (!isSupabaseConfigured) {
        content.innerHTML =
          '<p class="text-sm text-neutral-500">Supabase is not configured in this build.</p>';
        return;
      }
      const sb = createSupabase()!;
      const { data: sess } = await sb.auth.getSession();
      const user = sess.session?.user ?? null;
      if (!user) {
        // Byte-identical to the SIGNED_OUT_HTML constant defined in
        // the synchronous inline script above. The match matters:
        // when this async render fires, it replaces the pre-painted
        // markup with the same string, no visible re-flow.
        content.innerHTML =
          '<section class="me-signin-empty">' +
            '<h2 class="me-signin-empty-title">Sign in to save dashboards.</h2>' +
            '<p class="me-signin-empty-pitch">An account on Tape gives you:</p>' +
            '<ul class="me-signin-empty-list">' +
              '<li>Saved dashboards at stable URLs you can paste into a draft.</li>' +
              '<li>A walkthrough seeded into your list — every Tape feature in one tour.</li>' +
              '<li>A pinnable default dashboard the home page loads first when you visit.</li>' +
              '<li>Indicator alerts that email you when a series crosses a threshold.</li>' +
            '</ul>' +
            '<button type="button" data-role="signin" class="me-signin-empty-cta">Sign in with Google &rarr;</button>' +
            '<p class="me-signin-empty-foot">We request the minimum OAuth scopes (openid + email). Details on /privacy/.</p>' +
          '</section>';
        const btn = content.querySelector<HTMLButtonElement>("[data-role='signin']");
        btn?.addEventListener("click", async () => {
          await sb.auth.signInWithOAuth({
            provider: "google",
            options: {
              redirectTo: window.location.href,
              scopes: "openid email",
            },
          });
        });
        return;
      }
      // /me/ is the canonical "all your dashboards" view — no default
      // hero, no exclusions. The home page wraps this same renderer
      // with its own excludeSlug + onSetDefault wiring.
      const list = document.createElement("ul");
      list.className = "list-none p-0 m-0 flex flex-col gap-3";
      content.replaceChildren(list);
      await renderSavedDashboardList({
        host: list,
        baseUrl,
        sb,
        onMutate: () => render(),
      });
      await renderAlertsSection(sb, user.id);
      // Admin-only footer link to /me/diagnostics. Tiny, low-contrast,
      // below the dashboard list so it doesn't pull attention but is
      // always reachable. isAdmin trusts the OAuth-verified email on
      // the session.
      if (isAdmin(user.email)) {
        const adminFooter = document.createElement("p");
        adminFooter.className = "text-xs text-neutral-400 mt-6";
        adminFooter.innerHTML =
          `<a href="${baseUrl}/me/diagnostics/" class="no-underline hover:underline">Run diagnostics &rarr;</a>`;
        content.appendChild(adminFooter);
      }
    }

    render();
  </script>
</BaseLayout>

<style>
  /* Signed-out empty state — shipped to anonymous visitors who land
     on /me/ (Substack click-throughs, shared links from signed-in
     users, etc.). The earlier one-liner version didn't sell anything;
     this card spells out what an account gets you so the sign-in
     decision is informed. Visually echoes .account-card downstream
     so the page reads consistently once authed. */
  .me-signin-empty {
    margin-top: 28px;
    border: 1px solid rgba(55, 53, 47, 0.08);
    border-radius: var(--radius-sm);
    background: var(--color-white);
    padding: 24px 24px 20px;
    max-width: 560px;
  }
  .me-signin-empty-title {
    margin: 0 0 12px;
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--color-neutral-900);
    line-height: 1.25;
  }
  .me-signin-empty-pitch {
    margin: 0 0 8px;
    font-size: var(--text-sm);
    color: var(--color-neutral-700);
  }
  .me-signin-empty-list {
    list-style: disc;
    padding-left: 22px;
    margin: 0 0 18px;
    color: var(--color-neutral-700);
    font-size: var(--text-sm);
    line-height: 1.55;
  }
  .me-signin-empty-list li {
    margin-bottom: 4px;
  }
  .me-signin-empty-cta {
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 500;
    background: var(--color-accent);
    color: var(--color-white);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-sm);
    padding: 8px 16px;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
  }
  .me-signin-empty-cta:hover {
    background: var(--color-accent-hover, #0c5e58);
  }
  .me-signin-empty-foot {
    margin: 14px 0 0;
    font-size: var(--text-xs);
    color: var(--color-neutral-500);
    line-height: 1.4;
  }

  .account-section {
    margin-top: 48px;
    padding-top: 28px;
    border-top: 1px solid rgba(55, 53, 47, 0.08);
  }
  .account-eyebrow {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-neutral-500);
    margin: 0 0 14px;
  }
  .account-card {
    border: 1px solid rgba(55, 53, 47, 0.08);
    border-radius: var(--radius-sm);
    background: var(--color-white);
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .account-tier {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
  }
  .account-tier-name {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-neutral-900);
    background: var(--color-neutral-100);
    border-radius: var(--radius-sm);
    padding: 2px 10px;
  }
  .account-tier-blurb {
    font-size: var(--text-sm);
    color: var(--color-neutral-600);
    line-height: 1.5;
  }
  .account-walkthrough {
    padding-top: 14px;
    border-top: 1px solid rgba(55, 53, 47, 0.06);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .account-walkthrough-text {
    flex: 1 1 auto;
    min-width: 0;
  }
  .account-walkthrough-line {
    margin: 0 0 4px;
    font-size: var(--text-sm);
    color: var(--color-neutral-900);
    line-height: 1.5;
  }
  .account-walkthrough-sub {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--color-neutral-600);
    line-height: 1.4;
  }
  .account-walkthrough-cta {
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    color: var(--color-accent);
    white-space: nowrap;
  }
  .account-walkthrough-cta:hover {
    text-decoration: underline;
  }
  .account-upgrade {
    padding-top: 14px;
    border-top: 1px solid rgba(55, 53, 47, 0.06);
  }
  .account-upgrade-line {
    margin: 0 0 12px;
    font-size: var(--text-sm);
    color: var(--color-neutral-700);
    line-height: 1.5;
  }
  .account-upgrade-actions {
    margin: 0;
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    align-items: center;
  }
  .account-upgrade-cta {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    padding: 8px 14px;
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: var(--color-white);
    transition: filter 0.12s;
  }
  .account-upgrade-cta:hover {
    filter: brightness(1.06);
  }
  /* Alerts panel — the user's alert rules, below the dashboard list. */
  .me-alerts {
    margin-top: 28px;
    max-width: 560px;
  }
  .me-alerts-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 8px;
  }
  .me-alerts-title {
    margin: 0;
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-neutral-900);
  }
  .me-alerts-manage {
    font-size: var(--text-sm);
    color: var(--color-accent);
    text-decoration: none;
  }
  .me-alerts-manage:hover {
    text-decoration: underline;
  }
  .me-alerts-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .me-alert-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
    font-size: var(--text-sm);
    padding: 8px 12px;
    border: 1px solid rgba(55, 53, 47, 0.08);
    border-radius: var(--radius-sm);
    background: var(--color-white);
  }
  .me-alert-name {
    font-weight: 500;
    color: var(--color-neutral-900);
  }
  .me-alert-cond {
    font-size: var(--text-xs);
  }
  .me-alert-paused {
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-neutral-500);
  }
  .me-alerts-empty {
    font-size: var(--text-sm);
  }
</style>
