---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionChart from "../../components/SectionChart.astro";
import ChartController from "../../components/ChartController.astro";
import {
  resolveChart,
  effectiveChart,
  isVisibleChart,
} from "../../lib/resolve-dashboard";
import { resolveBarSnapshot } from "../../lib/resolve-bar-snapshots";
import { encodeComposedState } from "../../lib/composer-state";
import AnalyticsDashboardView from "../../components/AnalyticsDashboardView.astro";

export async function getStaticPaths() {
  const charts = await getCollection("charts");
  // Skip deprecated-without-alias entries (the composer hides them too).
  // Choropleth charts ARE included — SectionChart's dispatch handles
  // them (renders ChartChoropleth), and the welcome page's coverage
  // chips link here. They used to be filtered out under the rationale
  // that "snapshot-only doesn't fit the expand-a-tile UX," but in
  // practice choropleth has its own click-to-open dialog (the choro-
  // dialog with the year slider and full-screen toggle), so the
  // detail page works fine — click the tile, the choro dialog opens.
  return charts
    .filter(isVisibleChart)
    .map((c) => ({ params: { id: c.id }, props: { chartId: c.id } }));
}

interface Props {
  chartId: string;
}

const { chartId } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

const resolved = await resolveChart(chartId);
const effChart = resolved ? effectiveChart(resolved) : null;
// Bar charts need per-source snapshot data preloaded so ChartBar's
// JSX can render without an inline await. Cheap for the line +
// choropleth paths (single chart, single call) — bypass the
// filesystem read entirely when not needed.
const barSnapshot =
  resolved && effChart?.render === "bar"
    ? await resolveBarSnapshot(resolved.sources, effChart.barAsOf)
    : [];
const composeUrl =
  baseUrl +
  "/compose/?d=" +
  encodeComposedState({
    title: resolved?.chart.data.title ?? chartId,
    sections: [{ title: "Overview", charts: [chartId] }],
  });

// Source list for the dashboard_viewed telemetry event. Chart-detail pages
// have exactly one chart, so this is the source set of that single chart.
const viewedSourceIds = resolved?.sources.map((s) => s.id) ?? [];
---

<BaseLayout
  title={`${resolved?.chart.data.title ?? chartId} — Tape`}
  description={resolved?.chart.data.blurb ?? "A single chart from the Tape library."}
  ogImage={`/og.png?chart=${encodeURIComponent(chartId)}`}
>
  <div class="chart-detail max-w-[880px] mx-auto px-6 pt-8 pb-16" data-chart-id={chartId}>
    <nav class="text-xs text-neutral-500 mb-3">
      <a href={baseUrl || "/"} class="no-underline hover:text-neutral-900">All dashboards</a>
      <span class="mx-1">·</span>
      <a href={`${baseUrl}/compose/`} class="no-underline hover:text-neutral-900">Compose</a>
    </nav>

    {
      !resolved ? (
        <div class="p-6 border hairline rounded bg-neutral-100 text-sm text-neutral-700 leading-relaxed">
          <p><strong>Chart not found:</strong> <code>{chartId}</code></p>
          <p class="mt-2">
            <a href={`${baseUrl}/compose/`} class="underline">Open the composer &rarr;</a>
          </p>
        </div>
      ) : (
        <>
          <header class="mb-4">
            <div class="flex items-baseline justify-between flex-wrap gap-3">
              <h1 class="text-2xl font-semibold">{resolved.chart.data.title}</h1>
              <div class="flex gap-2 items-center">
                <a
                  href={composeUrl}
                  class="text-xs text-neutral-600 no-underline hover:text-neutral-900 border hairline rounded-sm px-2 py-1"
                >
                  Compose with this &rarr;
                </a>
                <button
                  type="button"
                  class="text-xs text-accent hover:underline border hairline rounded-sm px-2 py-1 bg-white cursor-pointer"
                  data-role="add-to-dashboard"
                  style="display: none"
                >
                  Add to my dashboard
                </button>
              </div>
            </div>
            {resolved.chart.data.tags && resolved.chart.data.tags.length > 0 && (
              <div class="mt-2 flex flex-wrap gap-1.5">
                {resolved.chart.data.tags.map((t) => (
                  <span class="text-xs text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">
                    {t}
                  </span>
                ))}
              </div>
            )}
          </header>

          <div class="chart-detail-tile">
            {/*
              SectionChart dispatches on chart.render. Without this,
              bar charts (countries/gdp_snapshot etc.) rendered via
              Chart.astro as multi-source line tiles — showing each
              source's delta-over-defaultDelta instead of the bar
              snapshot. Choropleth charts are filtered out of
              getStaticPaths above; the dispatch handles them
              gracefully if that filter is ever removed.
            */}
            <SectionChart
              chartId={chartId}
              chart={effChart!}
              sources={resolved.sources}
              dashboardSlug="chart"
              barSnapshot={barSnapshot}
            />
          </div>

          <p class="mt-3 text-xs text-neutral-500">
            Click the chart for the larger view, sources, and a longer time-window selector.
          </p>

          {/* Source links — one per underlying series, pointing to its
              canonical /source/<id>/ page. Single-source charts get a
              direct "View raw data + provenance" link; multi-source
              charts get the full list so a reader can drill into any
              constituent. */}
          {resolved.sources.length > 0 && (
            <p class="mt-2 text-xs text-neutral-500">
              {resolved.sources.length === 1 ? "Source: " : "Sources: "}
              {resolved.sources.map((s, i) => (
                <>
                  {i > 0 && <span>, </span>}
                  <a
                    href={`${baseUrl}/source/${s.id}/`}
                    class="underline hover:text-neutral-900"
                  >
                    {s.data.shortName ?? s.data.name}
                  </a>
                </>
              ))}
              {" — "}
              <span class="muted">click for provenance, license, and full citation.</span>
            </p>
          )}
        </>
      )
    }
  </div>

  <ChartController />

  {/*
    Auto-expand: open the chart's dialog immediately when the URL has
    ?expanded=1. The welcome page's coverage chips and the embed page's
    tile-click popouts both append this query string so the reader
    lands on the FULL chart view (window pills, transform pills, large
    plot, sources + citations) instead of a tile-they-have-to-click-
    again. Without it the popout shows just a tile and the reader has
    to click a second time to see what they actually came for —
    especially bad for bar charts whose tile shows mini-bars with no
    country labels.

    is:inline keeps this in the rendered HTML rather than getting
    bundled, so it executes synchronously alongside the load event
    without waiting on the chunked-script graph. Waits for `load`
    (not DOMContentLoaded) because the per-render-type hydration
    scripts (ChartController for line, ChartBar's own inline script
    for bar) attach their tile-click listeners after defer-script
    parsing — synthesizing a click before then would hit the bare
    button and do nothing.
  */}
  <script is:inline>
    window.addEventListener("load", function () {
      var params = new URLSearchParams(window.location.search);
      if (params.get("expanded") !== "1") return;
      // requestAnimationFrame defers one paint cycle past `load`
      // so any post-load microtask wiring (some hydration runs in
      // microtasks) lands before we click.
      requestAnimationFrame(function () {
        var tile = document.querySelector(".chart-detail-tile .chart-tile");
        if (tile && typeof tile.click === "function") tile.click();
      });
    });
  </script>

  {viewedSourceIds.length > 0 && (
    <AnalyticsDashboardView
      sources={viewedSourceIds}
      surface="chart"
      chartCount={1}
      slug={chartId}
    />
  )}

  <script>
    import { readStoredSession } from "../../lib/supabase";

    const root = document.querySelector<HTMLElement>(".chart-detail");
    if (root) {
      const chartId = root.dataset.chartId ?? "";
      const btn = root.querySelector<HTMLButtonElement>(
        "[data-role='add-to-dashboard']",
      );
      // Show the button only when the user is authed locally.
      if (btn) {
        const stored = readStoredSession();
        if (stored) btn.style.display = "";
        btn.addEventListener("click", () => {
          window.dispatchEvent(
            new CustomEvent("legible:add-to-dashboard", { detail: { chartId } }),
          );
        });
      }
    }
  </script>
</BaseLayout>

<style>
  .chart-detail-tile {
    /* The Chart tile wants ~220px min so a single tile in a centered column
       looks right; cap it so it doesn't stretch awkwardly wide on
       desktop. On phones (< 360px viewport — uncommon, but the iPhone
       SE 1st-gen at 320px does exist) the tile would otherwise
       overflow its parent's padding; width:100% with max-width caps
       handles both cases. */
    width: 100%;
    max-width: 360px;
  }
</style>
