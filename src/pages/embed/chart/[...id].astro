---
/**
 * Iframe-embeddable single chart.
 *
 * URL: `/embed/chart/<chart-id>?delta=<window>`
 *   chart-id: any library chart ID (us-macro/sp500, government/…, etc.)
 *   delta:    optional. One of 1w / 1m / ytd / 1y / 5y / 10y / 30y /
 *             50y. Falls back to the chart's defaultDelta.
 *
 * Renders the chart's TILE (not the full dialog), sized to fill the
 * iframe. The host page picks an iframe height (typically 280–400px)
 * and gets a snapshot the visiting reader can scan in a glance: title,
 * current value, delta over the picked window, sparkline. Clicking
 * the tile opens the full dialog with sources, pills, larger plot.
 *
 * Design choice: tile-mode rather than auto-opened-dialog because
 *   1. Tile renders synchronously without a JS-trigger race against
 *      the ChartController's tile-click wiring.
 *   2. The TILE is what an editorial reader needs at a glance — the
 *      DIALOG is an interactive deep-dive most readers won't want.
 *      The author already framed the chart's context by picking
 *      the delta; readers don't need a window picker in the embed.
 *   3. Sizing is simpler — fill 100% × 100% of the iframe with the
 *      tile, no fullscreen-modal CSS surgery needed.
 */
import EmbedLayout from "../../../layouts/EmbedLayout.astro";
import SectionChart from "../../../components/SectionChart.astro";
import ChartController from "../../../components/ChartController.astro";
import {
  resolveChart,
  effectiveChart,
} from "../../../lib/resolve-dashboard";
import { resolveBarSnapshot } from "../../../lib/resolve-bar-snapshots";
import { DELTA_WINDOWS, type DeltaWindow } from "../../../lib/deltas";

// SSR (rather than static getStaticPaths over every chart). With
// ~9000 chart IDs in the library, generating an embed page per chart
// at build time competes for Vercel build minutes against the
// already-static /chart/[...id] route. Embeds are mostly visited via
// host-page iframe loads that get cached at the host CDN; SSR cost
// per first-load is sub-second.
export const prerender = false;

const chartId = Astro.params.id ?? "";
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

// Pull the requested delta from the query string; defensively clamp
// to the canonical DeltaWindow set so a typo (?delta=foo) falls back
// to the chart's natural default.
const rawDelta = Astro.url.searchParams.get("delta") ?? "";
const requestedDelta: DeltaWindow | undefined =
  (DELTA_WINDOWS as readonly string[]).includes(rawDelta)
    ? (rawDelta as DeltaWindow)
    : undefined;

const resolved = await resolveChart(chartId);

// Effective chart spec (with any overrides applied). Cached for use
// in the render-type guard + the bar-snapshot preload below.
const effChart = resolved ? effectiveChart(resolved) : null;

// Bar charts need the per-source snapshot data preloaded so
// ChartBar's JSX can render without an inline await. Skipped for
// every other render type — the call is cheap (single chart) but
// no point hitting the filesystem when we won't use the result.
const barSnapshot =
  resolved && effChart?.render === "bar"
    ? await resolveBarSnapshot(resolved.sources, effChart.barAsOf)
    : [];

// Attribution chip on the EmbedLayout points at the canonical chart-
// detail page so a curious reader has a one-click path to the full
// site experience.
const attributionHref = `${baseUrl}/chart/${chartId}/`;
const title = resolved?.chart.data.title ?? chartId;
---

<EmbedLayout title={title} attributionHref={attributionHref}>
  {/* dashboard-root wrapper: ChartController's hydrate() reads the
      initial window from a .dashboard-root element's
      data-dashboard-default-window attribute. Without this wrapper,
      hydrate falls back to "1m" hardcoded — so an embed with
      ?delta=10y in the URL would render the 1m sparkline despite the
      tile's data-dashboard-window="10y" being set correctly.
      Caught by visiting /embed/chart/us-macro/vix/?delta=10y and
      seeing the 30-day caption + ~21 path points instead of 10 years
      of data. */}
  <div
    class="embed-shell dashboard-root"
    data-chart-id={chartId}
    data-attribution-href={attributionHref}
    data-dashboard-default-window={requestedDelta ?? resolved?.chart.data.defaultDelta ?? "1m"}
  >
    {
      !resolved || !effChart ? (
        <div class="embed-error">
          <p>
            Chart not found: <code>{chartId}</code>
          </p>
          <p>
            <a href={attributionHref}>Browse the chart library &rarr;</a>
          </p>
        </div>
      ) : (
        <div class="embed-tile-wrap">
          {/*
            SectionChart dispatches on chart.render — Chart for line,
            ChartBar for bar, ChartChoropleth for choropleth. Embedding
            Chart directly here used to render bar + choropleth charts
            as empty line-chart tiles (the welcome page's gdp_snapshot
            and county-map embeds came up blank).
          */}
          <SectionChart
            chartId={chartId}
            chart={effChart}
            sources={resolved.sources}
            dashboardSlug="embed"
            sectionDelta={requestedDelta}
            barSnapshot={barSnapshot}
          />
        </div>
      )
    }
  </div>

  <ChartController />

  <script>
    /*
      Tile-click routing. Two paths depending on the host:

        SAME-ORIGIN PARENT (our /welcome/ page):
          postMessage "tape:embed-popout" up to the parent so the
          parent renders the chart in its own full-viewport modal.
          The reader sees the chart break OUT of the iframe to fill
          the welcome page's viewport — proper editorial pop-out
          rather than a cramped in-iframe dialog.

        CROSS-ORIGIN PARENT (Substack, newsletter iframe, etc.):
          open /chart/<id>/ in a new tab. Postmessage between
          different origins would land in a parent that has no
          listener; new-tab is the universal fallback that respects
          the reader's host-page context (Substack post stays open
          in the original tab).

      Detection: same-origin parent is identified at load time via a
      handshake. Embed posts "tape:embed-handshake" to the parent on
      load; if the parent answers with "tape:host-ack" (only the
      welcome page does, currently), we flip parentWillPopOut and
      use the postMessage path on click. No ack within 250ms (cross-
      origin SecurityError on the location read, or parent doesn't
      listen) means use the new-tab fallback.

      Click handler runs at the capture phase so it fires BEFORE
      ChartController's bubble-phase handler that would otherwise
      call showModal() inside the iframe. preventDefault +
      stopPropagation suppress the in-iframe dialog entirely.
    */
    const embedShell = document.querySelector(".embed-shell");
    const chartHref = embedShell?.getAttribute("data-attribution-href") ?? "";
    const chartId = embedShell?.getAttribute("data-chart-id") ?? "";
    let parentWillPopOut = false;

    (function tryHandshake() {
      if (window.parent === window) return; // not iframed
      let parentOrigin: string;
      try {
        parentOrigin = window.parent.location.origin;
      } catch {
        return; // SecurityError → cross-origin, fall through to new-tab path
      }
      if (parentOrigin !== window.location.origin) return;
      function onHostAck(e: MessageEvent) {
        if (e.origin !== window.location.origin) return;
        if (e.data?.type === "tape:host-ack") {
          parentWillPopOut = true;
          window.removeEventListener("message", onHostAck);
        }
      }
      window.addEventListener("message", onHostAck);
      window.parent.postMessage(
        { type: "tape:embed-handshake", chartId },
        window.location.origin,
      );
      // Stop listening after a short window — if no ack arrived,
      // the parent isn't going to handle pop-outs and we fall back
      // to new-tab on click. Click handlers fire on user interaction
      // (long after page load), so a 250ms handshake budget is more
      // than enough headroom.
      setTimeout(() => window.removeEventListener("message", onHostAck), 250);
    })();

    if (chartHref) {
      // Append ?expanded=1 so wherever this URL ends up — same-origin
      // popout overlay or cross-origin new tab — the destination
      // chart-detail page auto-opens its dialog. The reader clicked
      // the tile to see "more," so landing them on the bare detail-
      // page tile (a tap-target they'd need to click AGAIN) is the
      // regression we're avoiding. chart-detail's inline script
      // listens for this query string and synthesizes the tile click
      // on load.
      const expandedHref = chartHref + "?expanded=1";
      document.addEventListener(
        "click",
        (e) => {
          const target = e.target as HTMLElement | null;
          if (!target) return;
          const tile = target.closest(".chart-tile");
          if (!tile) return;
          e.preventDefault();
          e.stopPropagation();
          if (parentWillPopOut) {
            window.parent.postMessage(
              { type: "tape:embed-popout", chartId, chartHref: expandedHref },
              window.location.origin,
            );
          } else {
            window.open(expandedHref, "_blank", "noopener,noreferrer");
          }
        },
        true, // capture phase — runs before ChartController's bubble listener
      );
    }
  </script>
</EmbedLayout>

<style is:global>
  /* Embed-mode size override: the tile by default is sized for a
     ~220-wide column inside a 3-up grid. Inside an iframe we want
     it to fill the host's chosen dimensions. The shell flex-grows
     and the tile picks up 100% height/width. */
  body.embed-body {
    overflow: hidden;
  }
  .embed-shell {
    position: fixed;
    inset: 0;
    overflow: hidden;
    padding: 14px 16px 24px;
    box-sizing: border-box;
  }
  .embed-shell .embed-tile-wrap {
    width: 100%;
    height: 100%;
  }
  /* The tile itself: take the full iframe area. Remove the hover
     ring and pointer-down affordance that the in-app tile has
     (visual noise without an in-app context). */
  .embed-shell .chart-tile {
    width: 100% !important;
    max-width: 100% !important;
    height: 100% !important;
    margin: 0 !important;
    border-radius: 4px;
    box-sizing: border-box;
    cursor: pointer;
  }
  /* Sparkline grows to fill leftover vertical space below the
     readout — gives the reader the longest visible sparkline the
     iframe can fit. Chart.astro's scoped CSS pins .tile-spark to a
     fixed 36px (or larger for multi-series); override here with
     auto-height + flex-grow so the sparkline stretches to fill the
     iframe's chosen dimensions. */
  .embed-shell .tile-spark,
  .embed-shell [data-role="tile-spark"] {
    height: auto !important;
    flex: 1 1 auto;
    min-height: 80px;
  }
  /* Tile title can wrap if the chart name is long; cap the
     amount of vertical real estate it claims. */
  .embed-shell .tile-title {
    font-size: 15px;
    line-height: 1.3;
  }
  /* Choropleth tiles: hide the stats eyebrow (count / range / median)
     in embeds. With the legend already off via the renderer's
     mode !== "tile" guard, the eyebrow is the last bit of chrome
     stealing vertical pixels from the map. The map itself + the
     chart title is enough at embed scale; full stats land in the
     pop-out's expanded view. Use the choro-eyebrow class directly
     so this only affects choropleth tiles, not bar/line tiles. */
  .embed-shell .choro-eyebrow {
    display: none !important;
  }
  /* Map canvas gets every leftover pixel below the title — without
     this, the canvas inherits a fixed min-height that leaves
     awkward blank space above the title or cuts off the map at
     embed dimensions.

     align-items: flex-start pins the SVG to the TOP of the canvas
     (the base .choro-canvas CSS centers vertically, which leaves
     a tall whitespace gap between the title and the map when the
     iframe is taller than the SVG's natural height — exactly what
     happens at the welcome page's 280px render-showcase iframes).
     Horizontal centering stays for visual balance. */
  .embed-shell .choro-canvas {
    flex: 1 1 auto;
    min-height: 0;
    align-items: flex-start;
  }
  .embed-shell .chart-tile.choro-tile {
    display: flex;
    flex-direction: column;
    /* Tighten the title→map spacing further — the default 8px gap
       reads as more whitespace than necessary at embed scale. */
    gap: 4px;
  }
  /* Hide the dialog entirely in embed mode. The script above
     intercepts tile clicks before they reach the dialog-opening
     handler, but if a dialog ever DOES open (e.g. via keyboard
     activation or a future code path), make sure it can't shove
     itself into the cramped iframe — defaults to display:none. */
  body.embed-body dialog {
    display: none !important;
  }
  /* Small "↗" affordance in the upper-right of the tile signaling
     that clicking opens elsewhere. Pseudo-element so it doesn't
     fight with the existing tile markup. Sits over the readout
     but above the sparkline; safely small (10px) at most embed
     sizes, doesn't compete with the chart for attention. */
  body.embed-body .chart-tile {
    position: relative;
  }
  body.embed-body .chart-tile::after {
    content: "↗";
    position: absolute;
    top: 8px;
    right: 10px;
    font-size: 13px;
    line-height: 1;
    color: #6f6c66;
    opacity: 0.7;
    pointer-events: none;
    transition: opacity 0.12s, color 0.12s;
  }
  body.embed-body .chart-tile:hover::after {
    opacity: 1;
    color: var(--color-accent);
  }
  .embed-error {
    padding: 24px;
    font-size: 13px;
    color: #6f6c66;
    max-width: 520px;
    margin: 40px auto;
    text-align: center;
  }
  .embed-error code {
    background: #f1efe9;
    padding: 1px 4px;
    border-radius: 2px;
    font-family: ui-monospace, monospace;
    color: #1c1c1a;
  }
</style>
