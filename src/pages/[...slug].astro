---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Chart from "../components/Chart.astro";
import ChartChoropleth from "../components/ChartChoropleth.astro";
import ChartController from "../components/ChartController.astro";
import { DELTA_LABELS_SHORT } from "../lib/deltas";
import {
  resolveSections,
  dashboardSupportedDeltas,
  resolveDashboardDefault,
  effectiveChart,
} from "../lib/resolve-dashboard";
import { encodeComposedState } from "../lib/composer-state";
import AnalyticsDashboardView from "../components/AnalyticsDashboardView.astro";

export async function getStaticPaths() {
  const dashboards = await getCollection("dashboards");
  return dashboards.map((d) => ({
    params: { slug: d.id },
    props: { dashboard: d },
  }));
}

interface Props {
  dashboard: CollectionEntry<"dashboards">;
}

const { dashboard } = Astro.props;

const resolvedSections = await resolveSections({
  sections: dashboard.data.sections,
  charts: dashboard.data.charts,
});
const supported = dashboardSupportedDeltas(resolvedSections);
const dashboardDefaultDelta = resolveDashboardDefault(
  dashboard.data.defaultDelta,
  supported,
);

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const { Content } = await render(dashboard);

// Flatten the resolved-source list for the dashboard_viewed telemetry event.
// Deduped server-side; the analytics helper will further truncate as needed.
const viewedSourceIds = Array.from(
  new Set(
    resolvedSections.flatMap((sec) =>
      sec.charts.flatMap((c) => c.sources.map((s) => s.id)),
    ),
  ),
);
const viewedChartCount = resolvedSections.reduce(
  (acc, sec) => acc + sec.charts.length,
  0,
);

const forkUrl =
  baseUrl +
  "/compose/?d=" +
  encodeComposedState({
    title: dashboard.data.title,
    description: dashboard.data.description,
    defaultDelta: dashboard.data.defaultDelta,
    sections: dashboard.data.sections ?? undefined,
    charts: !dashboard.data.sections ? dashboard.data.charts : undefined,
    // The cast here strips the override down to the three fields the
    // composer state schema accepts. The string→DeltaWindow narrowing
    // is sound because the source field already passed the dashboard-
    // schema validation, but TypeScript can't see through the
    // Object.fromEntries indirection so we annotate explicitly.
    chartOverrides: dashboard.data.chartOverrides
      ? Object.fromEntries(
          Object.entries(dashboard.data.chartOverrides).map(([k, v]) => [
            k,
            {
              title: v.title,
              defaultDelta: v.defaultDelta,
              blurb: v.blurb,
            },
          ]),
        )
      : undefined,
  });
---

<BaseLayout
  title={`${dashboard.data.title} — Tape`}
  description={dashboard.data.description ?? "Tape"}
  ogImage={`/og.png?dash=${encodeURIComponent(dashboard.id)}`}
>
  <div
    class="dashboard-root max-w-[1200px] mx-auto px-6 pt-8 pb-16"
    data-dashboard-default-window={dashboardDefaultDelta}
  >
    <nav class="text-xs text-neutral-500 mb-3">
      <a href={baseUrl || "/"} class="no-underline hover:text-neutral-900">
        All dashboards
      </a>
    </nav>
    <header class="mb-4">
      <div class="flex items-baseline justify-between flex-wrap gap-3">
        <h1 class="text-2xl font-semibold">{dashboard.data.title}</h1>
        <a href={forkUrl} class="fork-cta">
          Customize this dashboard &rarr;
        </a>
      </div>
      {dashboard.data.description && (
        <p class="mt-2 text-sm text-neutral-600 max-w-[640px]">
          {dashboard.data.description}
        </p>
      )}
    </header>

    <div class="dashboard-window" role="group" aria-label="Default window">
      <span class="eyebrow">Window</span>
      <div class="pills" data-dashboard-window-control>
        {
          supported.map((w) => (
            <button
              type="button"
              class={
                "pill" + (w === dashboardDefaultDelta ? " pill-active" : "")
              }
              data-dashboard-window={w}
              aria-pressed={w === dashboardDefaultDelta ? "true" : "false"}
            >
              {DELTA_LABELS_SHORT[w]}
            </button>
          ))
        }
      </div>
    </div>

    {
      resolvedSections.map((section) => {
        // Per-section overrides win over dashboard-level ones for the
        // charts in that section. fixedRange beats defaultDelta when
        // both are set (matches the dashboard-level precedence). The
        // user composes the same chart list across multiple sections
        // with different windows + commentary per window — e.g., a
        // "1990s" section + "2000s" + "2010s" each pinned to its decade.
        const sectionDelta = section.defaultDelta ?? dashboardDefaultDelta;
        const sectionFixed = section.fixedRange ?? dashboard.data.fixedRange;
        return (
        <section class="dash-section">
          {section.title && (
            <h2 class="section-heading">{section.title}</h2>
          )}
          {section.description && (
            <p class="section-description">{section.description}</p>
          )}
          {(section.fixedRange || section.defaultDelta) && (
            <p class="section-window muted small">
              Window:{" "}
              {section.fixedRange
                ? `${section.fixedRange.start} → ${section.fixedRange.end}`
                : section.defaultDelta}
            </p>
          )}
          <div class="chart-grid">
            {section.charts.map((c) => {
              const effective = effectiveChart(
                c,
                dashboard.data.chartOverrides?.[c.chart.id],
              );
              // Dispatch on render type. Choropleth doesn't take a
              // time-window or source list — only the chart's geo /
              // indicator / vintage fields. Everything else still
              // goes through the time-series Chart.astro.
              if (effective.render === "choropleth") {
                return (
                  <ChartChoropleth
                    chartId={c.chart.id}
                    chart={effective}
                    dashboardSlug={dashboard.id}
                  />
                );
              }
              return (
                <Chart
                  chartId={c.chart.id}
                  chart={effective}
                  sources={c.sources}
                  dashboardSlug={dashboard.id}
                  dashboardWindow={sectionDelta}
                  dashboardFixedRange={sectionFixed}
                  sectionLocked={!!(section.defaultDelta || section.fixedRange)}
                />
              );
            })}
          </div>
        </section>
        );
      })
    }

    {dashboard.data.aboutBlurb && (
      <section class="mt-10 pt-8 border-t hairline max-w-[640px]">
        <h2 class="text-xs font-medium uppercase tracking-wider text-neutral-500">
          About this dashboard
        </h2>
        <div class="mt-3 text-sm text-neutral-700 leading-relaxed prose-about">
          <p>
            {dashboard.data.aboutBlurb}{" "}
            You can{" "}
            <a href={forkUrl} class="underline hover:text-neutral-900">
              click here
            </a>{" "}
            for an editable link if you want to start playing around with it
            yourself.
          </p>
          <Content />
        </div>
      </section>
    )}
  </div>

  <ChartController />
  <AnalyticsDashboardView
    sources={viewedSourceIds}
    surface="preset"
    chartCount={viewedChartCount}
    slug={dashboard.id}
  />
</BaseLayout>

<style>
  /* Fork-this is the primary call-to-action on every preset dashboard page —
     it's the moment a curious viewer becomes someone composing their own
     thing. Sized and weighted accordingly: same brand-accent treatment as
     the homepage "Build your own" CTA, not a tiny outline link. */
  .fork-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    padding: 9px 16px;
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: var(--color-white);
    transition: filter 0.12s, transform 0.08s;
  }
  .fork-cta:hover {
    filter: brightness(1.06);
  }
  .fork-cta:active {
    transform: translateY(1px);
  }
  .dashboard-window {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }
  .dashboard-window .pills {
    display: flex;
    gap: 4px;
    font-size: var(--text-xs);
    font-weight: 500;
  }
  .dashboard-window .pill {
    padding: 4px 10px;
    border: 1px solid rgba(55, 53, 47, 0.1);
    border-radius: var(--radius-sm);
    background: var(--color-white);
    color: var(--color-neutral-600);
    cursor: pointer;
    font: inherit;
    transition: background 0.1s, color 0.1s;
  }
  .dashboard-window .pill:hover {
    background: var(--color-neutral-100);
  }
  .dashboard-window .pill-active {
    background: var(--color-neutral-900);
    color: var(--color-white);
    border-color: var(--color-neutral-900);
  }
  .dash-section {
    margin-bottom: 32px;
  }
  .dash-section:last-of-type {
    margin-bottom: 0;
  }
  .section-heading {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-neutral-900);
    margin: 0 0 4px;
  }
  .section-description {
    font-size: var(--text-sm);
    color: var(--color-neutral-600);
    line-height: 1.5;
    margin: 0 0 12px;
    max-width: 720px;
    white-space: pre-wrap;
  }
  /* Section-level window override chip. Renders below the
     description as a quiet caption — it's a structural label, not
     a primary heading. */
  .section-window {
    margin: -4px 0 12px;
    font-variant-numeric: tabular-nums;
  }
  .chart-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 12px;
  }
  @media (min-width: 768px) {
    .chart-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 1100px) {
    .chart-grid {
      grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    }
  }
  .prose-about :global(p) {
    margin: 0 0 0.9em;
  }
  .prose-about :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
