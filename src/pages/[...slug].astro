---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ChartController from "../components/ChartController.astro";
import DashboardGrid from "../components/DashboardGrid.astro";
import { resolveDashboardForRender } from "../lib/resolve-dashboard-for-render";
import { encodeComposedState } from "../lib/composer-state";
import AnalyticsDashboardView from "../components/AnalyticsDashboardView.astro";

export async function getStaticPaths() {
  const dashboards = await getCollection("dashboards");
  return dashboards.map((d) => ({
    params: { slug: d.id },
    props: { dashboard: d },
  }));
}

interface Props {
  dashboard: CollectionEntry<"dashboards">;
}

const { dashboard } = Astro.props;

// Shared resolve pipeline (see src/lib/resolve-dashboard-for-render.ts) —
// sections, window-pill set, default window, bar-snapshots, telemetry totals.
const {
  sections: resolvedSections,
  supportedDeltas: supported,
  defaultDelta: dashboardDefaultDelta,
  barSnapshots,
  viewedSourceIds,
  viewedChartCount,
} = await resolveDashboardForRender({
  sections: dashboard.data.sections,
  charts: dashboard.data.charts,
  chartOverrides: dashboard.data.chartOverrides,
  defaultDelta: dashboard.data.defaultDelta,
  fixedRange: dashboard.data.fixedRange,
});

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const { Content } = await render(dashboard);

const forkUrl =
  baseUrl +
  "/compose/?d=" +
  encodeComposedState({
    title: dashboard.data.title,
    description: dashboard.data.description,
    defaultDelta: dashboard.data.defaultDelta,
    sections: dashboard.data.sections ?? undefined,
    charts: !dashboard.data.sections ? dashboard.data.charts : undefined,
    // The composer URL-state schema now shares its chartOverride field set
    // with the dashboard schema (src/lib/chart-schema.ts), so a forked preset
    // carries the FULL override (emphasis, normalize, scale, transform,
    // annotations, shading, bar settings, …) rather than the old
    // title/defaultDelta/blurb subset. encodeComposedState strips undefined.
    chartOverrides: dashboard.data.chartOverrides ?? undefined,
  });
---

<BaseLayout
  title={`${dashboard.data.title} — Tape`}
  description={dashboard.data.description ?? "Tape"}
  ogImage={`/og.png?dash=${encodeURIComponent(dashboard.id)}`}
>
  <div
    class="dashboard-root max-w-[1200px] mx-auto px-6 pt-8 pb-16"
    data-dashboard-default-window={dashboardDefaultDelta}
  >
    <nav class="text-xs text-neutral-500 mb-3">
      <a href={baseUrl || "/"} class="no-underline hover:text-neutral-900">
        All dashboards
      </a>
    </nav>
    <header class="mb-4">
      <div class="flex items-baseline justify-between flex-wrap gap-3">
        <h1 class="text-2xl font-semibold">{dashboard.data.title}</h1>
        <a href={forkUrl} class="fork-cta">
          Customize this dashboard &rarr;
        </a>
      </div>
      {dashboard.data.description && (
        <p class="mt-2 text-sm text-neutral-600 max-w-[640px]">
          {dashboard.data.description}
        </p>
      )}
    </header>

    <DashboardGrid
      sections={resolvedSections}
      supportedDeltas={supported}
      defaultDelta={dashboardDefaultDelta}
      dashboardSlug={dashboard.id}
      fixedRange={dashboard.data.fixedRange}
      chartOverrides={dashboard.data.chartOverrides}
      barSnapshots={barSnapshots}
    />

    {dashboard.data.aboutBlurb && (
      <section class="mt-10 pt-8 border-t hairline max-w-[640px]">
        <h2 class="text-xs font-medium uppercase tracking-wider text-neutral-500">
          About this dashboard
        </h2>
        <div class="mt-3 text-sm text-neutral-700 leading-relaxed prose-about">
          <p>
            {dashboard.data.aboutBlurb}{" "}
            You can{" "}
            <a href={forkUrl} class="underline hover:text-neutral-900">
              click here
            </a>{" "}
            for an editable link if you want to start playing around with it
            yourself.
          </p>
          <Content />
        </div>
      </section>
    )}
  </div>

  <ChartController />
  <AnalyticsDashboardView
    sources={viewedSourceIds}
    surface="preset"
    chartCount={viewedChartCount}
    slug={dashboard.id}
  />
</BaseLayout>

<style>
  /* Fork-this is the primary call-to-action on every preset dashboard page —
     it's the moment a curious viewer becomes someone composing their own
     thing. Sized and weighted accordingly: same brand-accent treatment as
     the homepage "Build your own" CTA, not a tiny outline link. */
  .fork-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    padding: 9px 16px;
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: var(--color-white);
    transition: filter 0.12s, transform 0.08s;
  }
  .fork-cta:hover {
    filter: brightness(1.06);
  }
  .fork-cta:active {
    transform: translateY(1px);
  }
  .prose-about :global(p) {
    margin: 0 0 0.9em;
  }
  .prose-about :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
