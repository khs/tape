---
import BaseLayout from "../layouts/BaseLayout.astro";
export const prerender = true;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout
  title="Page not found — Tape"
  description="The page you were looking for doesn't exist on this site."
>
  <section class="notfound-root">
    <p class="notfound-code">404</p>
    <h1 class="notfound-title">This page doesn't exist.</h1>
    <p class="notfound-lead">
      The URL may be mistyped, or a dashboard that once lived here has been
      deleted or made private. Nothing's broken; the address just doesn't
      point at anything.
    </p>

    <nav class="notfound-links" aria-label="Where to go next">
      <a href={baseUrl || "/"}>Home</a>
      <a href={`${baseUrl}/compose/`}>Build a dashboard</a>
      <a href={`${baseUrl}/walkthrough/`}>Take the walkthrough</a>
    </nav>

    <p class="notfound-note">
      Followed a broken link from inside the site? Email
      <a href="mailto:keller.scholl@gmail.com">keller.scholl@gmail.com</a>
      with the URL and we'll fix it.
    </p>
  </section>
</BaseLayout>

<style>
  .notfound-root {
    max-width: 560px;
    margin: 0 auto;
    padding: 96px 24px 112px;
    color: var(--color-neutral-900);
    line-height: 1.6;
  }
  /* Large, quiet "404" — sets the tone without shouting. Neutral-300 keeps
     it decorative rather than the headline; the human line carries the
     message. Tabular figures so the three digits sit evenly. */
  .notfound-code {
    font-size: var(--text-5xl);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--color-neutral-300);
    font-variant-numeric: tabular-nums;
    margin: 0 0 12px;
  }
  .notfound-title {
    font-size: var(--text-2xl);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
  }
  .notfound-lead {
    font-size: var(--text-lg);
    color: var(--color-neutral-700);
    margin: 0 0 32px;
    line-height: 1.55;
  }
  .notfound-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .notfound-links a {
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    padding: 8px 14px;
    border: 1px solid var(--color-neutral-300);
    border-radius: var(--radius-sm);
    color: var(--color-neutral-800);
    background: var(--color-white);
    transition:
      border-color 0.12s,
      color 0.12s;
  }
  .notfound-links a:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  /* First link is the primary path back; give it accent emphasis so it
     reads as the default action, not just another neutral chip. */
  .notfound-links a:first-child {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-white);
  }
  .notfound-links a:first-child:hover {
    background: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
    color: var(--color-white);
  }
  .notfound-note {
    margin-top: 48px;
    padding-top: 16px;
    border-top: 1px solid rgba(55, 53, 47, 0.08);
    font-size: var(--text-sm);
    color: var(--color-neutral-500);
  }
  .notfound-note a {
    color: var(--color-accent);
  }
</style>
