---
import BaseLayout from "../layouts/BaseLayout.astro";
export const prerender = true;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout
  title="Not found | Tape"
  description="The page you were looking for doesn't exist on this site."
>
  <article class="notfound-root">
    <p class="notfound-eyebrow">404 · not found</p>
    <h1>The chart you wanted isn't here.</h1>
    <p class="lead">
      Either the URL is wrong, the dashboard has been deleted, or, if you
      followed a shared link, the underlying composition state has changed
      shape. The renderer is strict about that on purpose; better a 404
      than a chart that quietly means something different than it used to.
    </p>

    <h2>What to try</h2>
    <ul>
      <li>
        Go to <a href={baseUrl || "/"}>the home page</a> and pick a
        featured dashboard.
      </li>
      <li>
        <a href={`${baseUrl}/compose/`}>Open the composer</a> and
        build a new one.
      </li>
      <li>
        If you got here from a saved-dashboard link that used to work:
        the owner may have deleted it or flipped visibility to private.
      </li>
    </ul>

    <p class="footer-note">
      Found a broken link from inside this site? Email
      <a href="mailto:keller.scholl@gmail.com">keller.scholl@gmail.com</a>
      with the URL, we'll fix it.
    </p>
  </article>
</BaseLayout>

<style>
  .notfound-root {
    max-width: 640px;
    margin: 0 auto;
    padding: 80px 24px 96px;
    color: var(--color-neutral-900);
    line-height: 1.6;
  }
  .notfound-eyebrow {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-neutral-500);
    margin: 0 0 16px;
  }
  .notfound-root h1 {
    font-size: var(--text-3xl);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.025em;
    margin: 0 0 20px;
  }
  .notfound-root h2 {
    font-size: var(--text-base);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-neutral-500);
    margin: 36px 0 12px;
  }
  .notfound-root .lead {
    font-size: var(--text-lg);
    color: var(--color-neutral-800);
    margin: 0 0 8px;
  }
  .notfound-root ul {
    padding-left: 20px;
    margin: 0 0 24px;
  }
  .notfound-root li {
    margin: 6px 0;
    color: var(--color-neutral-700);
  }
  .footer-note {
    margin-top: 48px;
    padding-top: 16px;
    border-top: 1px solid rgba(55, 53, 47, 0.08);
    font-size: var(--text-sm);
    color: var(--color-neutral-500);
  }
</style>
