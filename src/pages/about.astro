---
import BaseLayout from "../layouts/BaseLayout.astro";
export const prerender = true;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout
  title="About — Legible Markets"
  description="What Legible Markets is, who it's for, and where the data comes from."
>
  <article class="about-root">
    <h1>About Legible Markets</h1>

    <p class="lead">
      DC isn't able to understand the information coming out of financial
      markets, except through specialized interpreters who often have their
      own agendas. Legible Markets aims to change that by enabling people to
      make dashboards of financial and economic information that they can
      share, remix, and understand.
      <a href={`${baseUrl}/compose/`}>Try it out</a>.
    </p>

    <h2>Where the data comes from</h2>
    <ul>
      <li><strong>FRED</strong> (St. Louis Fed) — rates, inflation, employment, GDP, and most US-macro series.</li>
      <li><strong>Yahoo Finance</strong> (via <code>yfinance</code>) — equity tickers, ETFs, futures.</li>
      <li><strong>World Bank Open Data</strong> — country GDP shares.</li>
      <li><strong>EIA</strong> — retail fuel prices (where applicable). Each chart links to all data sources it uses.</li>
    </ul>
    <p>
      None of this is investment advice. Series can be revised, restated, or
      deprecated by their providers; the site reflects whatever was current on
      the most recent refresh.
    </p>

    <h2>Stack</h2>
    <p>
      Astro + TypeScript on the front end (Observable Plot for charts), Python
      pipelines for data, Vercel for hosting, Supabase (Postgres + Auth) for
      saved dashboards.
      <a href="https://github.com/khs/legible-markets" rel="noopener">Source on GitHub</a>.
    </p>

    <h2>Built by</h2>
    <p>
      <a href="https://kellerscholl.com" rel="noopener">Keller Scholl</a>.
      Notes &amp; corrections welcome at
      <a href="mailto:keller.scholl@gmail.com">keller.scholl@gmail.com</a>.
    </p>

    <p class="footer-note">
      <a href={baseUrl || "/"}>&larr; All dashboards</a>
    </p>
  </article>
</BaseLayout>

<style>
  .about-root {
    max-width: 680px;
    margin: 0 auto;
    padding: 48px 24px 80px;
    color: var(--color-neutral-900);
    line-height: 1.6;
  }
  .about-root h1 {
    font-size: var(--text-2xl);
    font-weight: 600;
    margin: 0 0 16px;
  }
  .about-root h2 {
    font-size: var(--text-lg);
    font-weight: 600;
    margin: 28px 0 8px;
    color: var(--color-neutral-900);
  }
  .about-root p,
  .about-root ul {
    margin: 8px 0;
    color: var(--color-neutral-700);
  }
  .about-root ul {
    padding-left: 20px;
  }
  .about-root li {
    margin: 6px 0;
  }
  .about-root .lead {
    font-size: var(--text-base);
    color: var(--color-neutral-800);
    margin-top: 0;
  }
  .about-root code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    background: var(--color-neutral-100);
    padding: 1px 4px;
    border-radius: 3px;
    font-size: 0.92em;
  }
  .about-root a {
    color: var(--color-accent);
  }
  .footer-note {
    margin-top: 32px;
    padding-top: 16px;
    border-top: 1px solid rgba(55, 53, 47, 0.08);
    font-size: var(--text-sm);
  }
</style>
