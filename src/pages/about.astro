---
import BaseLayout from "../layouts/BaseLayout.astro";
import { LAST_FEATURE_UPDATE } from "../lib/brand";
export const prerender = true;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

// Render LAST_FEATURE_UPDATE in a UTC-anchored "Month D, YYYY" so
// the date is identical regardless of where the build runs (matches
// the equivalent date on /me/).
const lastUpdatedDate = new Date(`${LAST_FEATURE_UPDATE}T00:00:00Z`);
const lastUpdatedLabel = isNaN(lastUpdatedDate.valueOf())
  ? LAST_FEATURE_UPDATE
  : lastUpdatedDate.toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
      timeZone: "UTC",
    });
---

<BaseLayout
  title="About — Tape"
  description="Tape is a tool for writing about the economy: shareable, citation-ready dashboards composed from public data."
>
  <article class="about-root">
    <p class="about-eyebrow">About</p>
    <h1>A tool for writing about the economy.</h1>

    <p class="lead">
      It's Sunday night. A principal needs CPI and PCE on the same
      axes, going back to the 80s, by 8 a.m. Tape gets you from
      that ask to a chart you can paste into a memo — with a citation,
      a last-updated date, and a URL a colleague can open and modify.
    </p>

    <p class="about-byline">
      Built by <a href="https://kellerscholl.com" rel="noopener">Keller
      Scholl</a> — 7 years at the RAND Corporation, made Tape because
      he was tired of handling data manually.
    </p>

    <p class="about-stamp">
      Last shipped a new user-visible feature on <strong>{lastUpdatedLabel}</strong>.
      ~33,000 individual data series across 17 providers. Data
      refreshes weekly.
    </p>

    <p>
      The library covers US macro, all 435 congressional districts,
      OECD cross-country series, federal spending by state and
      district, the equity market by sector and ticker, crypto,
      foreign Treasury holdings, and ~1,800 other series. Every
      chart shows both the current level and the move over a window
      you pick. Every source links back to its provider. Every
      dashboard is a URL.
    </p>

    <p>
      You can pull a single chart, compose several into a dashboard,
      derive new series by dividing or summing existing ones (CA
      federal dollars per dollar of US GDP; oil priced in gold),
      and share the whole thing by copying the address bar. Saved
      dashboards live under your account; everything else works
      without signing in.
    </p>

    <h2>Where the data comes from</h2>
    <ul>
      <li>
        <strong>FRED</strong> (St. Louis Fed) — US Treasury yields,
        inflation, employment, GDP, federal spending by function,
        most US-macro series.
      </li>
      <li>
        <strong>BLS</strong> — state-level unemployment + payrolls for
        all 50 states and DC; productivity; CPI subcomponents.
      </li>
      <li>
        <strong>CBO</strong> — Congressional Budget Office Historical
        Budget Data plus the 10-year baseline projection from the most
        recent Budget &amp; Economic Outlook: federal debt, deficit,
        outlays, and revenues as a share of GDP.
      </li>
      <li>
        <strong>USAspending.gov</strong> — federal contracts, grants,
        loans, and direct payments by recipient state and by congressional
        district, fiscal-year, back to FY2008.
      </li>
      <li>
        <strong>Census Bureau</strong> — American Community Survey 5-year
        estimates (income, population, poverty, education) at the
        congressional-district and metro level, plus the Annual Survey
        of State Government Finances (general expenditures by state).
      </li>
      <li>
        <strong>NCES / NAEP</strong> — National Center for Education
        Statistics: K&ndash;12 spending per pupil (Common Core of Data
        F-33, via the Urban Institute Education Data Portal) and NAEP
        ("the Nation's Report Card") state achievement scores.
      </li>
      <li>
        <strong>SSA</strong> — Social Security Administration OASDI
        Trustees Report: program cost, income, and worker-to-beneficiary
        ratio, with the intermediate-cost long-range projection extended
        as a dashed line.
      </li>
      <li>
        <strong>EIA</strong> — U.S. Energy Information Administration
        state-level electricity net generation, annual, for all 50
        states and DC.
      </li>
      <li>
        <strong>OECD</strong> — harmonized cross-country comparisons of
        unemployment, CPI, government debt and deficit, life expectancy,
        and health spending.
      </li>
      <li>
        <strong>US Treasury</strong> — TIC system foreign-holder data for
        US Treasury securities.
      </li>
      <li>
        <strong>World Bank</strong> — country GDP series.
      </li>
      <li>
        <strong>USDA NASS</strong> — state and national crop yield,
        production, and value (corn, soybeans, wheat) from the QuickStats
        survey. This product uses the NASS API but is not endorsed or
        certified by NASS.
      </li>
      <li>
        <strong>CDC / NCHS</strong> — US life expectancy at birth by
        race and sex, and age-adjusted death rates for the leading
        causes of death, by state.
      </li>
      <li>
        <strong>USGS</strong> — National Water-Use Survey: freshwater
        withdrawals by sector (thermoelectric, irrigation, public
        supply, etc.) for the US and each state, released every five years.
      </li>
      <li>
        <strong>CMS Office of the Actuary</strong> — National Health
        Expenditure Accounts: total and personal health-care spending
        per capita, 1960&ndash;present.
      </li>
      <li>
        <strong>Zillow Research</strong> — Zillow Home Value Index
        (ZHVI) and Zillow Observed Rent Index (ZORI), nationally and
        for a dozen major metros, monthly back to 2000.
      </li>
      <li>
        <strong>Yahoo Finance</strong> (via <code>yfinance</code>) — equity
        tickers, ETFs, futures, FX, crypto spot prices.
      </li>
    </ul>
    <p>
      Each chart's expanded view lists exactly which sources it draws on
      and when each was last updated. Click <em>Copy citation</em> from
      any chart to get a citation block you can paste into a footnote.
    </p>
    <p>
      Want a feed we don't pull yet, or a feature we haven't built?
      <a href={`${baseUrl}/enterprise/`}>Enterprise support</a> covers
      custom data sources, private dashboards, one-click Excel export,
      and uptime commitments for teams whose work depends on the site.
    </p>

    <h2>How fresh is the data</h2>
    <p>
      Data refreshes weekly. Series can be revised, restated, or
      retired by their providers; the site reflects whatever was
      current on the most recent refresh.
    </p>

    <h2>Stack</h2>
    <p>
      Astro 5 (hybrid SSR) on the front end, Observable Plot for charts,
      Python pipelines for data, Vercel for hosting, Supabase (Postgres
      + Auth) for saved dashboards, PostHog for custom-event analytics.
      <a href="https://github.com/khs/tape" rel="noopener">
        Source on GitHub
      </a>.
    </p>

    <h2>Contact</h2>
    <p>
      Notes, corrections, and suggestions at
      <a href="mailto:keller.scholl@gmail.com">keller.scholl@gmail.com</a>.
      (Bio + project status moved to the top of this page.)
    </p>

    <h2 id="recent">Recent additions</h2>
    <ul>
      <li>
        <strong>Composer.</strong> Build a dashboard from any combination
        of library charts, raw sources, derived sources (divide / multiply
        / sum two existing series), or generator templates. Save it to
        your account, pin it as your homepage default, share by URL, or
        copy an <code>&lt;iframe&gt;</code> embed for a single chart.
        Try the <a href={`${baseUrl}/compose/`}>composer</a>.
      </li>
      <li>
        <strong>Generators tab.</strong> Pick a geography — any state,
        congressional district, MSA, or country — and the composer
        offers every series Tape has for it as a ready-to-add chart.
        Backed by ~1,800 per-state / per-CD / per-MSA / per-country
        source files, indexed in one click.
      </li>
      <li>
        <strong>Indicator alerts.</strong> Get an email when a series
        crosses a threshold (10-year Treasury yield above 5%, headline
        CPI YoY above 4%, etc.). Manage on the <a
          href={`${baseUrl}/alerts/`}>alerts page</a>; smart-dispatch
        auto-pauses noisy alerts.
      </li>
      <li>
        <strong>Spring 2026 data expansion.</strong> Eight new providers:
        CDC / NCHS (life expectancy + leading causes of death by state),
        USGS (water-use survey), CMS Office of the Actuary (national
        health expenditure per capita), USDA NASS + FRED (agricultural
        production, prices, food CPI), EIA (state electricity generation),
        NCES + NAEP (per-pupil spending, achievement scores by state),
        SSA Trustees Report (OASDI long-range projection), and CBO
        Budget &amp; Economic Outlook (federal debt / deficit baseline).
      </li>
      <li>
        <strong>Choropleth maps.</strong> ACS demographic indicators at
        state, county, census-tract, and block-group resolution. Click
        any tile for an expanded view with mouse-wheel zoom (Ctrl+/-/0
        for keyboard), a year slider through 2010&ndash;2022 vintages,
        color-scheme picker, and real fullscreen. Featured on the
        <a href={`${baseUrl}/va-08/`}>VA-08</a> and
        <a href={`${baseUrl}/federal-budget/`}>Federal-budget</a>
        dashboards.
      </li>
    </ul>

    <h2 id="disclaimers">Legal disclaimers</h2>
    <p>
      <strong>Not investment advice.</strong> Everything on this site is
      published for informational and educational purposes only. Nothing
      here is investment, financial, tax, legal, or trading advice, and
      nothing should be construed as a recommendation to buy, sell, or
      hold any security or other financial instrument. Market and
      economic data can be revised, delayed, restated, or simply wrong;
      reflected values are whatever the upstream provider returned at
      the most recent data refresh and may not be current. Do your own
      research, and consult a qualified professional before making any
      financial decision. The site, its data providers, and its author
      make no warranties of accuracy, completeness, timeliness, or
      fitness for any particular purpose, and accept no liability for
      losses arising from use of this information.
    </p>
    <p>
      <strong>Privacy &amp; analytics.</strong> The site uses Vercel Web
      Analytics for cookieless pageview counting (no IP storage, no
      fingerprinting, no cross-site tracking) and PostHog for custom
      product events (e.g. "a dashboard was saved", "a chart was
      expanded"). PostHog autocapture is enabled, which records clicks
      and form interactions with the same data-minimization defaults
      (no third-party trackers). If you create an account, your
      Google-provided email is stored in our Supabase database solely
      so we can attach your saved dashboards to you; we don't sell,
      share, or market against this information. You can delete your
      account and all associated saves at any time by emailing
      <a href="mailto:keller.scholl@gmail.com">keller.scholl@gmail.com</a>.
    </p>
    <p>
      <strong>Data licensing.</strong> Underlying series carry their
      providers' licensing terms. US government data — FRED, BLS, CBO,
      USAspending.gov, Census Bureau, NCES, SSA, EIA, US Treasury,
      USDA NASS, CDC / NCHS, USGS, and CMS — is in the public domain.
      The Urban Institute Education Data Portal (used as the access
      layer for NCES CCD) is licensed ODC-BY 1.0. World Bank Open Data
      is CC BY-4.0. OECD data is used under OECD terms. Zillow Research
      is used under Zillow's published terms (free for public use).
      Yahoo Finance is used under its terms of service. Charts and
      dashboards composed from these sources inherit those terms; please
      credit the underlying provider when reproducing data elsewhere.
    </p>

    <p class="footer-note">
      <a href={baseUrl || "/"}>&larr; All dashboards</a>
    </p>
  </article>
</BaseLayout>

<style>
  .about-root {
    max-width: 680px;
    margin: 0 auto;
    padding: 64px 24px 96px;
    color: var(--color-neutral-900);
    line-height: 1.65;
  }
  .about-eyebrow {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-neutral-500);
    margin: 0 0 16px;
  }
  .about-root h1 {
    font-size: var(--text-3xl);
    font-weight: 600;
    margin: 0 0 24px;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }
  /* Author byline (right under the .lead). Smaller + muted to read as
     a meta line, but with the link colored so the click affordance is
     visible. Lead-with-bio per the Patrick-McKenzie-pass — readers
     buying from a sole operator want to know who, before what. */
  .about-byline {
    font-size: var(--text-sm);
    color: var(--color-neutral-600);
    margin: 0 0 8px;
  }
  /* Trust-signal stamp: last-feature-ship date + scope + refresh
     cadence in a single sentence. Same muted weight as the byline so
     they read as a unit — three quick facts that establish the
     project is real, current, and broad. */
  .about-stamp {
    font-size: var(--text-sm);
    color: var(--color-neutral-600);
    margin: 0 0 24px;
  }
  .about-stamp strong {
    color: var(--color-neutral-800);
    font-weight: 600;
  }
  .about-root h2 {
    font-size: var(--text-base);
    font-weight: 600;
    margin: 40px 0 8px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-neutral-500);
  }
  .about-root p,
  .about-root ul {
    margin: 12px 0;
    color: var(--color-neutral-700);
    font-size: var(--text-base);
  }
  .about-root ul {
    padding-left: 20px;
  }
  .about-root li {
    margin: 6px 0;
  }
  .about-root .lead {
    font-size: var(--text-lg);
    color: var(--color-neutral-800);
    margin-top: 0;
    line-height: 1.55;
  }
  .about-root strong {
    color: var(--color-neutral-900);
    font-weight: 600;
  }
  .about-root em {
    font-style: italic;
  }
  .about-root code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    background: var(--color-neutral-100);
    padding: 1px 4px;
    border-radius: 3px;
    font-size: 0.92em;
  }
  .about-root a {
    color: var(--color-accent);
  }
  .footer-note {
    margin-top: 48px;
    padding-top: 16px;
    border-top: 1px solid rgba(55, 53, 47, 0.08);
    font-size: var(--text-sm);
  }
</style>
