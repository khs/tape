---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Chart from "../components/Chart.astro";
import ChartController from "../components/ChartController.astro";
import { DELTA_LABELS_SHORT } from "../lib/deltas";
import {
  resolveSections,
  effectiveChart,
  dashboardSupportedDeltas,
  resolveDashboardDefault,
} from "../lib/resolve-dashboard";

// Server-rendered so we can pick which preset dashboard to feature based on
// `?dash=<slug>` without pre-building N variants. The page is a pure
// function of the request URL, so Vercel's edge cache makes this
// effectively static — same URL, same response, no cold-start cost.
export const prerender = false;

const dashboards = await getCollection("dashboards");
const sorted = dashboards.sort(
  (a, b) => (a.data.order ?? 999) - (b.data.order ?? 999),
);

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

// Pick the active dashboard from the query string, falling back to the
// lowest-`order` dashboard for plain "/" loads. Tabs are <a> links to
// `/?dash=<slug>` variants, which Vercel will edge-cache by URL.
const requestedSlug = Astro.url.searchParams.get("dash");
const active =
  sorted.find((d) => d.id === requestedSlug) ?? sorted[0] ?? null;

// Full resolution for the active dashboard only. Resolving all 7 every
// request would pull ~20MB of JSON into the page payload; lazy-resolving
// just the one keeps the body weight to a single dashboard's worth
// (~1-3MB raw, much less gzipped) which is what `/<slug>/` pages already
// ship.
const activeSections = active
  ? await resolveSections({
      sections: active.data.sections,
      charts: active.data.charts,
    })
  : [];
const activeSupported = dashboardSupportedDeltas(activeSections);
const activeDefaultDelta = active
  ? resolveDashboardDefault(active.data.defaultDelta, activeSupported)
  : "1m";

type TabSpec = { slug: string; title: string };
const tabs: TabSpec[] = sorted.map((d) => ({
  slug: d.id,
  title: d.data.title,
}));
---

<BaseLayout
  title="Legible Markets"
  description="Shareable, citation-ready financial dashboards for the analysts, journalists, and staffers who have to explain what's happening in markets to people who don't read Bloomberg."
>
  {/* Marketing zone: hero + featured-dashboard preview. Shown to new
      visitors and to signed-in users without saves; hidden client-side
      for signed-in users who already have at least one saved dashboard
      (they get the slim "Your dashboards" lede instead). The wrapper
      lets the pre-paint script hide both halves with a single attribute
      toggle, no flicker. */}
  <div class="marketing-zone" data-role="marketing-zone">
    <div class="hero" data-role="hero">
      <h1 class="hero-title">Legible Markets</h1>
      <p class="hero-pitch">
        Shareable, citation-ready financial dashboards for the analysts,
        journalists, and staffers who have to explain what's happening in
        markets to people who don't read Bloomberg.
      </p>
      <p class="hero-cta-row">
        <a
          href={`${baseUrl}/compose/`}
          class="hero-cta-primary"
        >
          Build your own dashboard &rarr;
        </a>
        <a
          href={`${baseUrl}/explore/`}
          class="hero-cta-secondary"
        >
          Browse the chart library
        </a>
        <a
          href={`${baseUrl}/enterprise/`}
          class="hero-cta-secondary"
        >
          For organizations &rarr;
        </a>
      </p>
    </div>

    {/* Featured-dashboard preview: tabs + the active dashboard's full
        content rendered live. Tabs are <a> links to `/?dash=<slug>`
        variants, so tab clicks are real navigations — same caching
        story as visiting `/<slug>/` directly. Lets us ship one
        dashboard's worth of data per request instead of seven. */}
    {active && (
      <section
        class="featured dashboard-root"
        data-role="featured"
        data-dashboard-default-window={activeDefaultDelta}
      >
        <h2 class="section-eyebrow">Featured dashboards</h2>
        <div class="featured-tabs" role="tablist" aria-label="Preset dashboards">
          {tabs.map((t) => {
            const isActive = t.slug === active.id;
            return (
              <a
                role="tab"
                href={`${baseUrl}/?dash=${encodeURIComponent(t.slug)}#featured`}
                class={
                  "featured-tab" + (isActive ? " featured-tab-active" : "")
                }
                aria-selected={isActive ? "true" : "false"}
                aria-current={isActive ? "page" : undefined}
                data-role="featured-tab"
                data-slug={t.slug}
              >
                {t.title}
              </a>
            );
          })}
        </div>

        <div class="featured-active" id="featured">
          <header class="featured-header">
            <h3 class="featured-active-title">{active.data.title}</h3>
            {active.data.description && (
              <p class="featured-description">{active.data.description}</p>
            )}
            <p class="featured-open-row">
              <a
                href={`${baseUrl}/${active.id}/`}
                class="featured-open-link"
              >
                Open {active.data.title} dashboard &rarr;
              </a>
            </p>
          </header>

          {activeSupported.length > 0 && (
            <div
              class="dashboard-window"
              role="group"
              aria-label="Default window"
            >
              <span class="eyebrow">Window</span>
              <div class="pills" data-dashboard-window-control>
                {activeSupported.map((w) => (
                  <button
                    type="button"
                    class={
                      "pill" + (w === activeDefaultDelta ? " pill-active" : "")
                    }
                    data-dashboard-window={w}
                    aria-pressed={w === activeDefaultDelta ? "true" : "false"}
                  >
                    {DELTA_LABELS_SHORT[w]}
                  </button>
                ))}
              </div>
            </div>
          )}

          {activeSections.map((section) => (
            <section class="dash-section">
              {section.title && (
                <h4 class="section-heading">{section.title}</h4>
              )}
              {section.description && (
                <p class="section-description">{section.description}</p>
              )}
              <div class="chart-grid">
                {section.charts.map((c) => (
                  <Chart
                    chartId={c.chart.id}
                    chart={effectiveChart(
                      c,
                      active.data.chartOverrides?.[c.chart.id],
                    )}
                    sources={c.sources}
                    dashboardSlug={active.id}
                    dashboardWindow={activeDefaultDelta}
                  />
                ))}
              </div>
            </section>
          ))}
        </div>
      </section>
    )}
  </div>

  {/* Returning-user lede — shown in place of the marketing zone once we
      know the visitor is signed in and has at least one saved dashboard.
      Kept slim because the real content is the my-dashboards list right
      below. */}
  <div class="returning-hero" data-role="returning-hero" hidden>
    <h1 class="returning-title">Your dashboards</h1>
    <p class="returning-actions">
      <a href={`${baseUrl}/compose/`} class="hero-cta-primary">
        Build another &rarr;
      </a>
      <a href={`${baseUrl}/explore/`} class="hero-cta-secondary">
        Browse charts
      </a>
    </p>
  </div>

  {/* Synchronous, blocking pre-paint check: if the visitor already has a
      Supabase session in localStorage, hide the marketing zone (hero +
      featured-dashboard) immediately so they don't see a flash of
      content pitched at strangers. The async data fetch downstream then
      decides whether to surface the returning-user lede (has saves) or
      unhide the marketing zone again (signed in but no saves yet —
      uncommon but possible). */}
  <script is:inline define:vars={{ supabaseUrl: import.meta.env.PUBLIC_SUPABASE_URL ?? "" }}>
    (function () {
      try {
        if (!supabaseUrl) return;
        var m = supabaseUrl.match(/https:\/\/([^.]+)\.supabase\.co/);
        if (!m) return;
        var raw = localStorage.getItem("sb-" + m[1] + "-auth-token");
        if (!raw) return;
        var parsed = JSON.parse(raw);
        var s = (parsed && (parsed.currentSession || parsed)) || null;
        if (!s || !s.access_token) return;
        var zone = document.querySelector("[data-role='marketing-zone']");
        if (zone) zone.hidden = true;
      } catch (e) {
        /* swallow — worst case the marketing hero flashes for an instant */
      }
    })();
  </script>

  <div class="page-cols" data-base-url={baseUrl}>
    {/* Auth-injected "My dashboards" section. Stays at the top of the
        content area so returning users see their work first. */}
    <section
      class="my-section"
      data-role="my-section"
      style="display: none"
    >
      <h2 class="section-eyebrow">My dashboards</h2>
      <ul class="my-grid" data-role="my-list"></ul>
    </section>
  </div>

  <ChartController />

  <script>
    import {
      createSupabase,
      isSupabaseConfigured,
      readStoredSession,
      SUPABASE_REST_URL,
      SUPABASE_REST_ANON_KEY,
    } from "../lib/supabase";
    import { track } from "@vercel/analytics";

    // --- Featured-dashboard tab telemetry ---------------------------------
    // Tabs are real <a> links now (server picks the active dashboard from
    // ?dash=<slug>), so there's no client-side tab-state to manage. We
    // just fire a Vercel analytics event on each click so we can tell
    // which dashboard names actually pull users in.
    for (const tab of document.querySelectorAll<HTMLAnchorElement>(
      "[data-role='featured-tab']",
    )) {
      tab.addEventListener("click", () => {
        const slug = tab.dataset.slug;
        if (!slug) return;
        track("home_featured_tab_clicked", { slug });
      });
    }

    // --- Auth-gated "My dashboards" section -------------------------------
    // Same behavior as before: hidden by default, populated client-side
    // when there's a stored session.
    const host = document.querySelector<HTMLElement>("[data-base-url]");
    if (host && isSupabaseConfigured) {
      const baseUrl = host.dataset.baseUrl ?? "";
      const sb = createSupabase();
      if (sb) {
        function escapeHtml(s: string): string {
          return s
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;");
        }

        // Helpers to swap the page lede between the marketing zone (hero
        // + featured dashboard, for new visitors / signed-in users with
        // no saves) and the slim "Your dashboards" header (for returning
        // users with at least one save). The inline pre-paint script may
        // have already hidden the zone; these calls make sure the right
        // one is visible after the saves-fetch resolves.
        const marketingZone = document.querySelector<HTMLElement>(
          "[data-role='marketing-zone']",
        );
        const returningHero = document.querySelector<HTMLElement>(
          "[data-role='returning-hero']",
        );
        function showMarketingZone(): void {
          if (marketingZone) marketingZone.hidden = false;
          if (returningHero) returningHero.hidden = true;
        }
        function showReturningHero(): void {
          if (marketingZone) marketingZone.hidden = true;
          if (returningHero) returningHero.hidden = false;
        }

        async function refresh() {
          const mySection = host!.querySelector<HTMLElement>(
            "[data-role='my-section']",
          );
          const myList = host!.querySelector<HTMLUListElement>(
            "[data-role='my-list']",
          );
          if (!mySection || !myList) return;

          const stored = readStoredSession();
          console.log(
            "[home] stored session user:",
            stored?.user?.email ?? null,
          );
          if (!stored) {
            mySection.style.display = "none";
            showMarketingZone();
            return;
          }

          // Direct REST fetch — bypass supabase-js client to avoid any
          // getSession()/refresh deadlock. RLS enforces owner-or-public reads.
          const restUrl = `${SUPABASE_REST_URL}/rest/v1/saved_dashboards?select=slug,title,visibility,updated_at&order=updated_at.desc`;
          let data: Array<{
            slug: string;
            title: string;
            visibility: string;
            updated_at: string;
          }> | null = null;
          let errorMsg: string | null = null;
          try {
            const res = await fetch(restUrl, {
              headers: {
                apikey: SUPABASE_REST_ANON_KEY,
                Authorization: `Bearer ${stored.access_token}`,
              },
            });
            if (!res.ok) {
              errorMsg = `HTTP ${res.status}`;
            } else {
              data = await res.json();
            }
          } catch (e) {
            errorMsg = String(e);
          }
          console.log(
            "[home] saved_dashboards:",
            errorMsg ? `error: ${errorMsg}` : `${data?.length ?? 0} rows`,
          );
          if (errorMsg || !data || data.length === 0) {
            // Signed in but no saves yet → re-show marketing hero so they
            // see the value prop + Build-your-own CTA again. (Pre-paint
            // script optimistically hid the hero on session presence.)
            mySection.style.display = "none";
            showMarketingZone();
            return;
          }

          myList.innerHTML = "";
          for (const row of data) {
            const li = document.createElement("li");
            li.innerHTML = `<a href="${baseUrl}/u/${encodeURIComponent(row.slug)}/" class="my-card">
                <h3>${escapeHtml(row.title ?? "Untitled dashboard")}</h3>
                <p>${row.visibility === "private" ? "private · " : ""}updated ${new Date(row.updated_at).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}</p>
              </a>`;
            myList.appendChild(li);
          }
          mySection.style.display = "";
          // Signed in *and* has saves: the marketing pitch isn't for them.
          // Swap to the slim "Your dashboards" lede so their saved work is
          // the primary content above the fold.
          showReturningHero();
        }

        refresh();
        sb.auth.onAuthStateChange(() => refresh());
      }
    }
  </script>
</BaseLayout>

<style>
  .hero {
    max-width: 760px;
    margin: 0 auto;
    padding: 56px 24px 28px;
  }
  .hero-title {
    font-size: var(--text-3xl, 2.25rem);
    font-weight: 600;
    margin: 0 0 18px;
    letter-spacing: -0.01em;
    color: var(--color-neutral-900);
  }
  .hero-pitch {
    font-size: var(--text-lg, 1.125rem);
    line-height: 1.55;
    color: var(--color-neutral-700);
    margin: 0 0 28px;
    max-width: 660px;
  }
  .hero-cta-row {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
    margin: 0;
  }
  .hero-cta-primary {
    display: inline-block;
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    padding: 9px 16px;
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: var(--color-white);
    transition: filter 0.12s;
  }
  .hero-cta-primary:hover {
    filter: brightness(1.06);
  }
  .hero-cta-secondary {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-neutral-700);
    text-decoration: none;
  }
  .hero-cta-secondary:hover {
    color: var(--color-neutral-900);
    text-decoration: underline;
  }

  /* "Your dashboards" lede shown to signed-in users with saves. Slimmer
     than the marketing hero so their saved-dashboards grid is the primary
     content above the fold. */
  .returning-hero {
    max-width: 1120px;
    margin: 0 auto;
    padding: 40px 24px 16px;
  }
  .returning-hero[hidden] {
    display: none;
  }
  .returning-title {
    font-size: var(--text-2xl, 1.5rem);
    font-weight: 600;
    margin: 0 0 12px;
    color: var(--color-neutral-900);
    letter-spacing: -0.005em;
  }
  .returning-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin: 0;
  }

  .page-cols {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 24px 56px;
  }

  .section-eyebrow {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-neutral-500);
    margin: 0 0 14px;
  }

  /* My dashboards section */
  .my-section {
    margin-bottom: 40px;
  }
  .my-grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .my-card {
    display: block;
    padding: 16px;
    border: 1px solid rgba(55, 53, 47, 0.1);
    border-radius: var(--radius-sm);
    background: var(--color-white);
    text-decoration: none;
    color: var(--color-neutral-900);
    transition: border-color 0.12s;
  }
  .my-card:hover {
    border-color: rgba(55, 53, 47, 0.25);
  }
  .my-card h3 {
    font-size: var(--text-base);
    font-weight: 600;
    margin: 0;
  }
  .my-card p {
    font-size: var(--text-xs);
    color: var(--color-neutral-500);
    margin: 4px 0 0;
  }

  /* Marketing zone wraps hero + featured-dashboard so we can hide both
     in one DOM operation for signed-in-with-saves users. */
  .marketing-zone[hidden] {
    display: none;
  }
  .featured {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px 56px;
  }
  .featured-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 22px;
  }
  .featured-tab {
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 500;
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(55, 53, 47, 0.1);
    background: var(--color-white);
    color: var(--color-neutral-700);
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color 0.12s,
      border-color 0.12s,
      color 0.12s;
  }
  .featured-tab:hover {
    background: var(--color-neutral-100);
    color: var(--color-neutral-900);
  }
  .featured-tab-active,
  .featured-tab-active:hover {
    background: var(--color-neutral-900);
    color: var(--color-white);
    border-color: var(--color-neutral-900);
  }
  .featured-header {
    margin-bottom: 16px;
  }
  .featured-active-title {
    font-size: var(--text-xl, 1.25rem);
    font-weight: 600;
    margin: 0 0 4px;
    color: var(--color-neutral-900);
  }
  .featured-description {
    font-size: var(--text-sm);
    color: var(--color-neutral-600);
    line-height: 1.55;
    margin: 0 0 8px;
    max-width: 720px;
  }
  .featured-open-row {
    margin: 0;
  }
  .featured-open-link {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-accent);
    text-decoration: none;
  }
  .featured-open-link:hover {
    text-decoration: underline;
  }

  /* Mirror the dashboard-page styling for the inline chart grid so the
     featured-dashboard section reads as a real dashboard, not a teaser. */
  .featured .dashboard-window {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }
  .featured .dashboard-window .pills {
    display: flex;
    gap: 4px;
    font-size: var(--text-xs);
    font-weight: 500;
  }
  .featured .dashboard-window .pill {
    padding: 4px 10px;
    border: 1px solid rgba(55, 53, 47, 0.1);
    border-radius: var(--radius-sm);
    background: var(--color-white);
    color: var(--color-neutral-600);
    cursor: pointer;
    font: inherit;
  }
  .featured .dashboard-window .pill:hover {
    background: var(--color-neutral-100);
  }
  .featured .dashboard-window .pill-active {
    background: var(--color-neutral-900);
    color: var(--color-white);
    border-color: var(--color-neutral-900);
  }
  .featured .dash-section {
    margin-bottom: 32px;
  }
  .featured .section-heading {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-neutral-900);
    margin: 0 0 4px;
  }
  .featured .section-description {
    font-size: var(--text-sm);
    color: var(--color-neutral-600);
    line-height: 1.5;
    margin: 0 0 12px;
    max-width: 720px;
    white-space: pre-wrap;
  }
  .featured .chart-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 12px;
  }
  @media (min-width: 768px) {
    .featured .chart-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding: 36px 20px 20px;
    }
    .hero-title {
      font-size: 1.875rem;
    }
    .hero-pitch {
      font-size: 1rem;
    }
  }
</style>
