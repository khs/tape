---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Chart from "../components/Chart.astro";
import ChartController from "../components/ChartController.astro";
import { DELTA_LABELS_SHORT } from "../lib/deltas";
import {
  resolveSections,
  effectiveChart,
  dashboardSupportedDeltas,
  resolveDashboardDefault,
} from "../lib/resolve-dashboard";
import { DEFAULT_DASHBOARD_SLUG_KEY as DEFAULT_SLUG_KEY } from "../lib/brand";

// Server-rendered so we can pick which preset dashboard to feature based on
// `?dash=<slug>` without pre-building N variants. The page is a pure
// function of the request URL, so Vercel's edge cache makes this
// effectively static — same URL, same response, no cold-start cost.
export const prerender = false;

const dashboards = await getCollection("dashboards");
const sorted = dashboards.sort(
  (a, b) => (a.data.order ?? 999) - (b.data.order ?? 999),
);

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

// Pick the active dashboard from the query string, falling back to the
// lowest-`order` dashboard for plain "/" loads. Tabs are <a> links to
// `/?dash=<slug>` variants, which Vercel will edge-cache by URL.
const requestedSlug = Astro.url.searchParams.get("dash");
const active =
  sorted.find((d) => d.id === requestedSlug) ?? sorted[0] ?? null;

// Full resolution for the active dashboard only. Resolving all 7 every
// request would pull ~20MB of JSON into the page payload; lazy-resolving
// just the one keeps the body weight to a single dashboard's worth
// (~1-3MB raw, much less gzipped) which is what `/<slug>/` pages already
// ship.
const activeSections = active
  ? await resolveSections({
      sections: active.data.sections,
      charts: active.data.charts,
    })
  : [];
const activeSupported = dashboardSupportedDeltas(activeSections);
const activeDefaultDelta = active
  ? resolveDashboardDefault(active.data.defaultDelta, activeSupported)
  : "1m";

type TabSpec = { slug: string; title: string };
const tabs: TabSpec[] = sorted.map((d) => ({
  slug: d.id,
  title: d.data.title,
}));
---

<BaseLayout
  title="Tape"
  description="Citation-ready charts of the US economy, congressional districts, and the world. Free, composable, and built for the desk that has to explain what just happened."
>
  {/* Marketing zone: hero + featured-dashboard preview. Shown to new
      visitors and to signed-in users without saves; hidden client-side
      for signed-in users who already have at least one saved dashboard
      (they get the slim "Your dashboards" lede instead). The wrapper
      lets the pre-paint script hide both halves with a single attribute
      toggle, no flicker. */}
  <div class="marketing-zone" data-role="marketing-zone">
    <div class="hero" data-role="hero">
      <p class="hero-eyebrow">Tape</p>
      <h1 class="hero-title">
        Charts you can cite. Dashboards you can compose.
      </h1>
      <p class="hero-pitch">
        Free, source-linked charts of the US economy, all 435 congressional
        districts, and the rest of the world. Built for analysts,
        journalists, and policy staff who have to write the memo by
        Monday — every chart shows the level and the move, every
        source is citable, every dashboard is a URL you can paste
        into a draft.
      </p>
      <p class="hero-cta-row">
        <a
          href={`${baseUrl}/compose/`}
          class="hero-cta-primary"
        >
          Build a dashboard &rarr;
        </a>
        <a
          href={`${baseUrl}/enterprise/`}
          class="hero-cta-secondary"
        >
          For organizations &rarr;
        </a>
      </p>
    </div>


    {/* Featured-dashboard preview: one dashboard rendered inline as a
        teaser, with sibling tabs that link straight to each preset's
        canonical URL `/<slug>/`. The home page still uses `?dash=<slug>`
        on the server to pick which dashboard to feature for SEO/social
        unfurls of the home page itself, but tab clicks navigate to the
        clean preset URL so the address-bar URL Aaron copies always
        matches what he'd share. */}
    {active && (
      <section
        class="featured dashboard-root"
        data-role="featured"
        data-dashboard-default-window={activeDefaultDelta}
      >
        <h2 class="section-eyebrow">Featured dashboards</h2>
        <div class="featured-tabs" role="tablist" aria-label="Preset dashboards">
          {tabs.map((t) => {
            const isActive = t.slug === active.id;
            return (
              <a
                role="tab"
                href={`${baseUrl}/${encodeURIComponent(t.slug)}/`}
                class={
                  "featured-tab" + (isActive ? " featured-tab-active" : "")
                }
                aria-selected={isActive ? "true" : "false"}
                aria-current={isActive ? "page" : undefined}
                data-role="featured-tab"
                data-slug={t.slug}
              >
                {t.title}
              </a>
            );
          })}
        </div>

        <div class="featured-active" id="featured">
          <header class="featured-header">
            <h3 class="featured-active-title">{active.data.title}</h3>
            {active.data.description && (
              <p class="featured-description">{active.data.description}</p>
            )}
            <p class="featured-open-row">
              <a
                href={`${baseUrl}/${active.id}/`}
                class="featured-open-link"
              >
                Open {active.data.title} dashboard &rarr;
              </a>
            </p>
          </header>

          {activeSupported.length > 0 && (
            <div
              class="dashboard-window"
              role="group"
              aria-label="Default window"
            >
              <span class="eyebrow">Window</span>
              <div class="pills" data-dashboard-window-control>
                {activeSupported.map((w) => (
                  <button
                    type="button"
                    class={
                      "pill" + (w === activeDefaultDelta ? " pill-active" : "")
                    }
                    data-dashboard-window={w}
                    aria-pressed={w === activeDefaultDelta ? "true" : "false"}
                  >
                    {DELTA_LABELS_SHORT[w]}
                  </button>
                ))}
              </div>
            </div>
          )}

          {activeSections.map((section) => {
            // Per-section overrides win over the dashboard-level pill
            // for the charts inside this section. fixedRange beats
            // defaultDelta when both set. The user-facing pattern is
            // "show the same chart-set across N decades with a
            // different commentary per section" — each section can
            // pin its own window without disturbing the others.
            const sectionDelta = section.defaultDelta ?? activeDefaultDelta;
            const sectionFixed = section.fixedRange ?? active.data.fixedRange;
            return (
            <section class="dash-section">
              {section.title && (
                <h4 class="section-heading">{section.title}</h4>
              )}
              {section.description && (
                <p class="section-description">{section.description}</p>
              )}
              {(section.fixedRange || section.defaultDelta) && (
                <p class="section-window muted small">
                  Window:{" "}
                  {section.fixedRange
                    ? `${section.fixedRange.start} → ${section.fixedRange.end}`
                    : section.defaultDelta}
                </p>
              )}
              <div class="chart-grid">
                {section.charts.map((c) => (
                  <Chart
                    chartId={c.chart.id}
                    chart={effectiveChart(
                      c,
                      active.data.chartOverrides?.[c.chart.id],
                    )}
                    sources={c.sources}
                    dashboardSlug={active.id}
                    dashboardWindow={sectionDelta}
                    dashboardFixedRange={sectionFixed}
                    sectionLocked={!!(section.defaultDelta || section.fixedRange)}
                  />
                ))}
              </div>
            </section>
            );
          })}
        </div>
      </section>
    )}
  </div>

  {/* Returning-user lede — shown in place of the marketing zone once we
      know the visitor is signed in and has at least one saved dashboard.
      Kept slim because the real content is the my-dashboards list right
      below. */}
  <div class="returning-hero" data-role="returning-hero" hidden>
    <h1 class="returning-title">Your dashboards</h1>
    <p class="returning-actions">
      <a href={`${baseUrl}/compose/`} class="hero-cta-primary">
        Build another &rarr;
      </a>
    </p>
  </div>

  {/* Default-dashboard hero. Replaces the slim "Your dashboards" lede
      when the user has picked a default via the "Set as default" row
      action below. The slug lives in localStorage (tape:default-
      dashboard-slug); the script populates the title/meta/href from
      the matching saved_dashboards row and hides this section when
      no default is set OR the default points at a slug that no longer
      exists. Click-through navigates to /u/<slug>/ for the full
      rendered dashboard. */}
  <div class="default-hero" data-role="default-hero" hidden>
    <p class="default-hero-eyebrow">Default dashboard</p>
    <a
      class="default-hero-title-link"
      href="#"
      data-role="default-hero-link"
    >
      <h1 class="default-hero-title" data-role="default-hero-title">&nbsp;</h1>
    </a>
    <p class="default-hero-meta" data-role="default-hero-meta">&nbsp;</p>
    <p class="default-hero-actions">
      <a
        class="hero-cta-primary"
        href="#"
        data-role="default-hero-open"
      >
        Open dashboard &rarr;
      </a>
      <button
        type="button"
        class="hero-cta-secondary default-hero-clear"
        data-role="default-hero-clear"
        title="Stop pinning this dashboard to the top of the home page"
      >
        Clear default
      </button>
      <a href={`${baseUrl}/compose/`} class="hero-cta-secondary">
        Build another &rarr;
      </a>
    </p>
  </div>

  {/* Synchronous, blocking pre-paint check: if the visitor already has a
      Supabase session in localStorage, hide the marketing zone (hero +
      featured-dashboard) immediately so they don't see a flash of
      content pitched at strangers. The async data fetch downstream then
      decides whether to surface the returning-user lede (has saves) or
      unhide the marketing zone again (signed in but no saves yet —
      uncommon but possible).

      ALSO: if the user has a default-dashboard slug pinned AND we're
      not in a "skip redirect" mode (?nopin=1 or hash=#home — used by
      the /u/<slug>/ "Open the home page" link), bounce them straight
      to /u/<slug>/. Implements the watchlist primitive — the home
      page IS the user's dashboard for anyone who has set a default.
      Uses window.location.replace so the back button doesn't loop. */}
  <script is:inline define:vars={{
    supabaseUrl: import.meta.env.PUBLIC_SUPABASE_URL ?? "",
    baseUrl: baseUrl,
    DEFAULT_SLUG_KEY,
  }}>
    (function () {
      try {
        if (!supabaseUrl) return;
        var m = supabaseUrl.match(/https:\/\/([^.]+)\.supabase\.co/);
        if (!m) return;
        var raw = localStorage.getItem("sb-" + m[1] + "-auth-token");
        if (!raw) return;
        var parsed = JSON.parse(raw);
        var s = (parsed && (parsed.currentSession || parsed)) || null;
        if (!s || !s.access_token) return;
        var zone = document.querySelector("[data-role='marketing-zone']");
        if (zone) zone.hidden = true;

        // Default-dashboard redirect. Skip when:
        //   ?nopin=1 in the URL (the "Open the home page" link from
        //   /u/<slug>/ sets this so the user can get back to /)
        //   #home in the hash (alternative escape hatch)
        var params = new URLSearchParams(window.location.search);
        if (params.has("nopin")) return;
        if (window.location.hash === "#home") return;
        var slug = localStorage.getItem(DEFAULT_SLUG_KEY);
        if (!slug) return;
        // Sanity-check the slug shape so a corrupted localStorage
        // value can't bounce us to /u/<arbitrary-string>/.
        if (!/^[A-Za-z0-9_-]{1,80}$/.test(slug)) return;
        window.location.replace((baseUrl || "") + "/u/" + slug + "/?from=home");
      } catch (e) {
        /* swallow — worst case the marketing hero flashes for an instant */
      }
    })();
  </script>

  <div class="page-cols" data-base-url={baseUrl}>
    {/* Auth-injected "My dashboards" section. Hosts the same /me/-style
        card list (shared module: src/lib/render-saved-dashboards.ts)
        — Edit / Make a copy / Rename / Set URL / Set as default /
        Delete on each row, "+ Make new dashboard" tile leading the
        list. Previously this was a thinner card-grid view that the
        user said felt worse than /me/; the rebuild brings them to
        parity. The default-hero above is fed by the same data and
        the row whose slug matches the stored default is excluded
        from this list. */}
    <section
      class="my-section"
      data-role="my-section"
      style="display: none"
    >
      <h2 class="section-eyebrow">My dashboards</h2>
      <ul
        class="my-list list-none p-0 m-0 flex flex-col gap-3"
        data-role="my-list"
      ></ul>
    </section>

  </div>

  <ChartController />

  <script>
    import {
      createSupabase,
      isSupabaseConfigured,
      readStoredSession,
    } from "../lib/supabase";
    import { renderSavedDashboardList } from "../lib/render-saved-dashboards";
    import { track } from "../lib/track";
    import { DEFAULT_DASHBOARD_SLUG_KEY as DEFAULT_SLUG_KEY } from "../lib/brand";

    // --- Featured-dashboard tab telemetry ---------------------------------
    // Tabs are real <a> links now (server picks the active dashboard from
    // ?dash=<slug>), so there's no client-side tab-state to manage. We
    // just fire a Vercel analytics event on each click so we can tell
    // which dashboard names actually pull users in.
    for (const tab of document.querySelectorAll<HTMLAnchorElement>(
      "[data-role='featured-tab']",
    )) {
      tab.addEventListener("click", () => {
        const slug = tab.dataset.slug;
        if (!slug) return;
        track("home_featured_tab_clicked", { slug });
      });
    }

    // --- Default-dashboard slot ------------------------------------------
    // Slug lives in localStorage (per-browser, intentionally not synced
    // to Supabase — this is a personal pin, not part of the dashboard's
    // own state). DEFAULT_SLUG_KEY is the canonical name from
    // lib/brand.ts; the pre-paint inline-script above gets the same
    // value via its define:vars block.
    function readDefaultSlug(): string | null {
      try {
        return localStorage.getItem(DEFAULT_SLUG_KEY);
      } catch {
        return null;
      }
    }
    function writeDefaultSlug(slug: string | null): void {
      try {
        if (slug) localStorage.setItem(DEFAULT_SLUG_KEY, slug);
        else localStorage.removeItem(DEFAULT_SLUG_KEY);
      } catch {
        /* localStorage blocked — silently no-op; the default just won't
           persist across page loads on this browser. */
      }
    }

    // --- Auth-gated "My dashboards" section -------------------------------
    const host = document.querySelector<HTMLElement>("[data-base-url]");
    if (host && isSupabaseConfigured) {
      const baseUrl = host.dataset.baseUrl ?? "";
      // Non-null inside this block; the alias keeps TypeScript's
      // narrowing across the async refresh() closure (otherwise the
      // captured `sb` widens back to SupabaseClient | null when
      // referenced inside an async function).
      const sbMaybe = createSupabase();
      if (sbMaybe) {
        const sb = sbMaybe;
        const marketingZone = document.querySelector<HTMLElement>(
          "[data-role='marketing-zone']",
        );
        const returningHero = document.querySelector<HTMLElement>(
          "[data-role='returning-hero']",
        );
        const defaultHero = document.querySelector<HTMLElement>(
          "[data-role='default-hero']",
        );
        function showMarketingZone(): void {
          if (marketingZone) marketingZone.hidden = false;
          if (returningHero) returningHero.hidden = true;
          if (defaultHero) defaultHero.hidden = true;
        }
        function showReturningHero(useDefault: boolean): void {
          if (marketingZone) marketingZone.hidden = true;
          if (useDefault) {
            if (returningHero) returningHero.hidden = true;
            if (defaultHero) defaultHero.hidden = false;
          } else {
            if (returningHero) returningHero.hidden = false;
            if (defaultHero) defaultHero.hidden = true;
          }
        }

        function populateDefaultHero(row: {
          slug: string;
          title: string;
          updated_at: string;
        }): void {
          if (!defaultHero) return;
          const url = `${baseUrl}/u/${encodeURIComponent(row.slug)}/`;
          const titleEl = defaultHero.querySelector<HTMLElement>(
            "[data-role='default-hero-title']",
          );
          if (titleEl) titleEl.textContent = row.title || "Untitled dashboard";
          const titleLink = defaultHero.querySelector<HTMLAnchorElement>(
            "[data-role='default-hero-link']",
          );
          if (titleLink) titleLink.href = url;
          const openLink = defaultHero.querySelector<HTMLAnchorElement>(
            "[data-role='default-hero-open']",
          );
          if (openLink) openLink.href = url;
          const metaEl = defaultHero.querySelector<HTMLElement>(
            "[data-role='default-hero-meta']",
          );
          if (metaEl) {
            const dateStr = new Date(row.updated_at).toLocaleDateString(
              "en-US",
              { year: "numeric", month: "short", day: "numeric" },
            );
            metaEl.textContent = `Updated ${dateStr}.`;
          }
        }

        async function refresh(): Promise<void> {
          const mySection = host!.querySelector<HTMLElement>(
            "[data-role='my-section']",
          );
          const myList = host!.querySelector<HTMLUListElement>(
            "[data-role='my-list']",
          );
          if (!mySection || !myList) return;

          const stored = readStoredSession();
          if (!stored) {
            mySection.style.display = "none";
            showMarketingZone();
            return;
          }

          const defaultSlug = readDefaultSlug();

          // Wire the shared list renderer. excludeSlug pulls the
          // default-dashboard row out of the list so the hero above
          // is the only place it appears. onSetDefault is the
          // "Set as default" / "Clear default" row-button handler.
          const result = await renderSavedDashboardList({
            host: myList,
            baseUrl,
            sb,
            excludeSlug: defaultSlug,
            defaultSlug,
            onSetDefault: (slug) => {
              writeDefaultSlug(slug);
              track("home_default_dashboard_set", { slug: slug ?? "<cleared>" });
              void refresh();
            },
            onMutate: () => void refresh(),
          });

          if (!result || result.rows.length === 0) {
            // Signed in but no saves yet → re-show marketing hero so they
            // see the value prop + Build-your-own CTA again. (The pre-
            // paint script optimistically hid it on session presence.)
            mySection.style.display = "none";
            showMarketingZone();
            return;
          }

          // Excluded-row is the default the user picked. If the slug
          // they had stored no longer exists (deleted, renamed), the
          // shared module sees nothing to exclude — we drop the stale
          // pin so the hero isn't broken on next render.
          if (defaultSlug && !result.excludedRow) {
            writeDefaultSlug(null);
            void refresh();
            return;
          }

          mySection.style.display = "";
          if (result.excludedRow) {
            populateDefaultHero(result.excludedRow);
            showReturningHero(true);
          } else {
            showReturningHero(false);
          }
        }

        // Wire the "Clear default" button once — the element is static
        // markup, not re-rendered each refresh, so a single listener
        // is correct. (The earlier delegate-listener-inside-refresh
        // pattern is what made the X-delete button fire its confirm
        // three times.)
        const clearBtn = defaultHero?.querySelector<HTMLButtonElement>(
          "[data-role='default-hero-clear']",
        );
        clearBtn?.addEventListener("click", () => {
          writeDefaultSlug(null);
          track("home_default_dashboard_cleared", {});
          void refresh();
        });

        void refresh();
        sb.auth.onAuthStateChange(() => void refresh());
      }
    }
  </script>
</BaseLayout>

<style>
  .hero {
    max-width: 760px;
    margin: 0 auto;
    padding: 64px 24px 32px;
  }
  .hero-eyebrow {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-neutral-500);
    margin: 0 0 18px;
  }
  .hero-title {
    /* Big-and-tight is the highest-leverage editorial typography move:
       large display size paired with negative letter-spacing reads as
       confident rather than corporate. */
    font-size: var(--text-4xl, 3.25rem);
    font-weight: 600;
    margin: 0 0 22px;
    letter-spacing: -0.028em;
    line-height: 1.05;
    color: var(--color-neutral-900);
    max-width: 720px;
  }
  .hero-pitch {
    font-size: var(--text-lg, 1.125rem);
    line-height: 1.55;
    color: var(--color-neutral-700);
    margin: 0 0 28px;
    max-width: 640px;
  }
  .hero-cta-row {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
    margin: 0;
  }
  .hero-cta-primary {
    display: inline-block;
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    padding: 9px 16px;
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: var(--color-white);
    transition: filter 0.12s;
  }
  .hero-cta-primary:hover {
    filter: brightness(1.06);
  }
  .hero-cta-secondary {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-neutral-700);
    text-decoration: none;
  }
  .hero-cta-secondary:hover {
    color: var(--color-neutral-900);
    text-decoration: underline;
  }

  /* "Your dashboards" lede shown to signed-in users with saves. Slimmer
     than the marketing hero so their saved-dashboards grid is the primary
     content above the fold. */
  .returning-hero {
    max-width: 1120px;
    margin: 0 auto;
    padding: 40px 24px 16px;
  }
  .returning-hero[hidden] {
    display: none;
  }
  .returning-title {
    font-size: var(--text-2xl, 1.5rem);
    font-weight: 600;
    margin: 0 0 12px;
    color: var(--color-neutral-900);
    letter-spacing: -0.005em;
  }
  .returning-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin: 0;
  }

  .page-cols {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 24px 56px;
  }

  .section-eyebrow {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-neutral-500);
    margin: 0 0 14px;
  }

  /* My dashboards section. The list inside is built by
     renderSavedDashboardList from src/lib/render-saved-dashboards.ts
     using Tailwind utility classes (border / rounded / flex / ...).
     The CSS below is mostly margin / sectioning; the card chrome
     itself comes from Tailwind. */
  .my-section {
    margin-bottom: 40px;
  }
  .my-list {
    list-style: none;
  }

  /* Default-dashboard hero — shown when the user has pinned a
     dashboard via the "Set as default" row action. Sits in place of
     the slim "Your dashboards" lede; same .page-cols wrapping width
     so it doesn't compete with the list below. */
  .default-hero {
    max-width: 1120px;
    margin: 0 auto;
    padding: 40px 24px 20px;
  }
  .default-hero[hidden] {
    display: none;
  }
  .default-hero-eyebrow {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-neutral-500);
    margin: 0 0 8px;
  }
  .default-hero-title-link {
    text-decoration: none;
    color: inherit;
  }
  .default-hero-title-link:hover .default-hero-title {
    color: var(--color-accent);
  }
  .default-hero-title {
    font-size: var(--text-2xl, 1.5rem);
    font-weight: 600;
    margin: 0 0 6px;
    letter-spacing: -0.005em;
    color: var(--color-neutral-900);
    transition: color 0.12s ease;
  }
  .default-hero-meta {
    font-size: var(--text-sm);
    color: var(--color-neutral-600);
    line-height: 1.5;
    margin: 0 0 14px;
    max-width: 640px;
  }
  .default-hero-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin: 0;
  }
  .default-hero-clear {
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-neutral-700);
  }
  .default-hero-clear:hover {
    color: var(--color-neutral-900);
