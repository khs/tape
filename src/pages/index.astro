---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Chart from "../components/Chart.astro";
import ChartController from "../components/ChartController.astro";
import { resolveSections, effectiveChart } from "../lib/resolve-dashboard";

const dashboards = await getCollection("dashboards");
const sorted = dashboards.sort(
  (a, b) => (a.data.order ?? 999) - (b.data.order ?? 999),
);

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

// For each preset dashboard, resolve its first chart so we can render a
// live featured-chart tile on the homepage. We don't need every chart from
// every dashboard — just the first one as a flavor preview. This keeps the
// homepage payload bounded (~7 charts × 1 source-history each) vs. eagerly
// rendering every chart of every dashboard.
type Feature = {
  slug: string;
  title: string;
  description?: string;
  featuredChart: Awaited<ReturnType<typeof resolveSections>>[number]["charts"][number] | null;
};

const features: Feature[] = [];
for (const d of sorted) {
  const sections = await resolveSections({
    sections: d.data.sections,
    charts: d.data.charts,
  });
  const first = sections[0]?.charts?.[0] ?? null;
  features.push({
    slug: d.id,
    title: d.data.title,
    description: d.data.description,
    featuredChart: first,
  });
}

// The default-active feature when the homepage first renders. Earliest
// `order` value wins (already pre-sorted), so this is whatever the team
// considers the strongest visual hook.
const defaultActiveSlug = features[0]?.slug ?? "";
---

<BaseLayout
  title="Legible Markets"
  description="Shareable, citation-grade financial dashboards for the analysts, journalists, and congressional staff who have to explain what's happening in markets to people who don't read Bloomberg."
>
  <div class="hero" data-role="hero">
    <h1 class="hero-title">Legible Markets</h1>
    <p class="hero-pitch">
      Shareable, citation-grade financial dashboards for the analysts,
      journalists, and congressional staff who have to explain what's
      happening in markets to people who don't read Bloomberg.
    </p>
    <p class="hero-cta-row">
      <a
        href={`${baseUrl}/compose/`}
        class="hero-cta-primary"
      >
        Build your own dashboard &rarr;
      </a>
      <a
        href={`${baseUrl}/explore/`}
        class="hero-cta-secondary"
      >
        Browse the chart library
      </a>
    </p>
  </div>

  {/* Returning-user lede — shown in place of the marketing hero once we know
      the visitor is signed in and has at least one saved dashboard. Kept
      slim because the real content is the my-dashboards list right below. */}
  <div class="returning-hero" data-role="returning-hero" hidden>
    <h1 class="returning-title">Your dashboards</h1>
    <p class="returning-actions">
      <a href={`${baseUrl}/compose/`} class="hero-cta-primary">
        Build another &rarr;
      </a>
      <a href={`${baseUrl}/explore/`} class="hero-cta-secondary">
        Browse charts
      </a>
    </p>
  </div>

  {/* Synchronous, blocking pre-paint check: if the visitor already has a
      Supabase session in localStorage, hide the marketing hero immediately
      so they don't see a flash of "make your own dashboard" copy that's
      not for them. The async data fetch downstream then decides whether to
      surface the returning-user lede (has saves) or unhide the hero again
      (signed in but no saves yet — uncommon but possible). */}
  <script is:inline define:vars={{ supabaseUrl: import.meta.env.PUBLIC_SUPABASE_URL ?? "" }}>
    (function () {
      try {
        if (!supabaseUrl) return;
        var m = supabaseUrl.match(/https:\/\/([^.]+)\.supabase\.co/);
        if (!m) return;
        var raw = localStorage.getItem("sb-" + m[1] + "-auth-token");
        if (!raw) return;
        var parsed = JSON.parse(raw);
        var s = (parsed && (parsed.currentSession || parsed)) || null;
        if (!s || !s.access_token) return;
        var hero = document.querySelector("[data-role='hero']");
        if (hero) hero.hidden = true;
      } catch (e) {
        /* swallow — worst case the marketing hero flashes for an instant */
      }
    })();
  </script>

  <div class="page-cols" data-base-url={baseUrl}>
    {/* Auth-injected "My dashboards" section. Stays at the top of the
        content area so returning users see their work first. */}
    <section
      class="my-section"
      data-role="my-section"
      style="display: none"
    >
      <h2 class="section-eyebrow">My dashboards</h2>
      <ul class="my-grid" data-role="my-list"></ul>
    </section>

    {/* Featured-dashboard preview: tabs + the active dashboard's first
        chart rendered live. Each tile is hidden by default; client JS
        unhides the active one. Defaults to whichever dashboard sorts
        first by `order`. */}
    <section class="featured" data-role="featured">
      <h2 class="section-eyebrow">Featured dashboards</h2>
      <div class="featured-tabs" role="tablist" aria-label="Preset dashboards">
        {features.map((f) => (
          <button
            type="button"
            role="tab"
            class={
              "featured-tab" +
              (f.slug === defaultActiveSlug ? " featured-tab-active" : "")
            }
            data-role="featured-tab"
            data-slug={f.slug}
            aria-selected={f.slug === defaultActiveSlug ? "true" : "false"}
          >
            {f.title}
          </button>
        ))}
      </div>

      <div class="featured-panels">
        {features.map((f) => (
          <div
            class="featured-panel"
            data-role="featured-panel"
            data-slug={f.slug}
            hidden={f.slug !== defaultActiveSlug}
          >
            {f.description && (
              <p class="featured-description">{f.description}</p>
            )}
            {f.featuredChart ? (
              <div class="featured-tile-wrap">
                <Chart
                  chartId={f.featuredChart.chart.id}
                  chart={effectiveChart(f.featuredChart)}
                  sources={f.featuredChart.sources}
                  dashboardSlug={f.slug}
                  preloaded={f.featuredChart.preloaded}
                />
              </div>
            ) : (
              <p class="featured-empty">This dashboard has no charts yet.</p>
            )}
            <p class="featured-cta-row">
              <a
                href={`${baseUrl}/${f.slug}/`}
                class="featured-open-link"
              >
                Open {f.title} dashboard &rarr;
              </a>
            </p>
          </div>
        ))}
      </div>
    </section>
  </div>

  <ChartController />

  <script>
    import {
      createSupabase,
      isSupabaseConfigured,
      readStoredSession,
      SUPABASE_REST_URL,
      SUPABASE_REST_ANON_KEY,
    } from "../lib/supabase";
    import { track } from "@vercel/analytics";

    // --- Featured-dashboard tab switching ---------------------------------
    // Each preset dashboard's first chart is rendered server-side, hidden
    // by default. Tabs unhide one at a time. Active selection is also
    // mirrored to location.hash so refresh + share preserves the tab and
    // we can deep-link to "homepage with X dashboard featured".
    const tabs = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-role='featured-tab']"),
    );
    const panels = Array.from(
      document.querySelectorAll<HTMLElement>("[data-role='featured-panel']"),
    );

    function showFeatured(slug: string): void {
      let matched = false;
      for (const tab of tabs) {
        const active = tab.dataset.slug === slug;
        tab.classList.toggle("featured-tab-active", active);
        tab.setAttribute("aria-selected", active ? "true" : "false");
        if (active) matched = true;
      }
      for (const panel of panels) {
        const active = panel.dataset.slug === slug;
        panel.hidden = !active;
      }
      if (!matched && tabs[0]) {
        // Hash referenced a dashboard that no longer exists; fall back to
        // the default tab so we don't show an empty featured area.
        showFeatured(tabs[0].dataset.slug ?? "");
      }
    }

    // Honor a hash like #us-macro on first load.
    const initialHash = window.location.hash.replace(/^#/, "");
    if (initialHash && tabs.some((t) => t.dataset.slug === initialHash)) {
      showFeatured(initialHash);
    }

    for (const tab of tabs) {
      tab.addEventListener("click", () => {
        const slug = tab.dataset.slug;
        if (!slug) return;
        showFeatured(slug);
        // Update hash without scrolling; replaceState avoids cluttering
        // browser history with a tab-switch entry per click.
        history.replaceState(
          {},
          "",
          window.location.pathname + window.location.search + "#" + slug,
        );
        track("home_featured_tab_clicked", { slug });
      });
    }

    // --- Auth-gated "My dashboards" section -------------------------------
    // Same behavior as before: hidden by default, populated client-side
    // when there's a stored session.
    const host = document.querySelector<HTMLElement>("[data-base-url]");
    if (host && isSupabaseConfigured) {
      const baseUrl = host.dataset.baseUrl ?? "";
      const sb = createSupabase();
      if (sb) {
        function escapeHtml(s: string): string {
          return s
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;");
        }

        // Helpers to swap the page lede between the marketing hero (for
        // new visitors / signed-in users with no saves) and the slim
        // "Your dashboards" header (for returning users with at least one
        // save). The inline pre-paint script may have already hidden the
        // hero; these calls make sure the right one is visible after the
        // saves-fetch resolves.
        const hero = document.querySelector<HTMLElement>(
          "[data-role='hero']",
        );
        const returningHero = document.querySelector<HTMLElement>(
          "[data-role='returning-hero']",
        );
        function showMarketingHero(): void {
          if (hero) hero.hidden = false;
          if (returningHero) returningHero.hidden = true;
        }
        function showReturningHero(): void {
          if (hero) hero.hidden = true;
          if (returningHero) returningHero.hidden = false;
        }

        async function refresh() {
          const mySection = host!.querySelector<HTMLElement>(
            "[data-role='my-section']",
          );
          const myList = host!.querySelector<HTMLUListElement>(
            "[data-role='my-list']",
          );
          if (!mySection || !myList) return;

          const stored = readStoredSession();
          console.log(
            "[home] stored session user:",
            stored?.user?.email ?? null,
          );
          if (!stored) {
            mySection.style.display = "none";
            showMarketingHero();
            return;
          }

          // Direct REST fetch — bypass supabase-js client to avoid any
          // getSession()/refresh deadlock. RLS enforces owner-or-public reads.
          const restUrl = `${SUPABASE_REST_URL}/rest/v1/saved_dashboards?select=slug,title,visibility,updated_at&order=updated_at.desc`;
          let data: Array<{
            slug: string;
            title: string;
            visibility: string;
            updated_at: string;
          }> | null = null;
          let errorMsg: string | null = null;
          try {
            const res = await fetch(restUrl, {
              headers: {
                apikey: SUPABASE_REST_ANON_KEY,
                Authorization: `Bearer ${stored.access_token}`,
              },
            });
            if (!res.ok) {
              errorMsg = `HTTP ${res.status}`;
            } else {
              data = await res.json();
            }
          } catch (e) {
            errorMsg = String(e);
          }
          console.log(
            "[home] saved_dashboards:",
            errorMsg ? `error: ${errorMsg}` : `${data?.length ?? 0} rows`,
          );
          if (errorMsg || !data || data.length === 0) {
            // Signed in but no saves yet → re-show marketing hero so they
            // see the value prop + Build-your-own CTA again. (Pre-paint
            // script optimistically hid the hero on session presence.)
            mySection.style.display = "none";
            showMarketingHero();
            return;
          }

          myList.innerHTML = "";
          for (const row of data) {
            const li = document.createElement("li");
            li.innerHTML = `<a href="${baseUrl}/u/${encodeURIComponent(row.slug)}/" class="my-card">
                <h3>${escapeHtml(row.title ?? "Untitled dashboard")}</h3>
                <p>${row.visibility === "private" ? "private · " : ""}updated ${new Date(row.updated_at).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}</p>
              </a>`;
            myList.appendChild(li);
          }
          mySection.style.display = "";
          // Signed in *and* has saves: the marketing pitch isn't for them.
          // Swap to the slim "Your dashboards" lede so their saved work is
          // the primary content above the fold.
          showReturningHero();
        }

        refresh();
        sb.auth.onAuthStateChange(() => refresh());
      }
    }
  </script>
</BaseLayout>

<style>
  .hero {
    max-width: 760px;
    margin: 0 auto;
    padding: 56px 24px 28px;
  }
  .hero-title {
    font-size: var(--text-3xl, 2.25rem);
    font-weight: 600;
    margin: 0 0 18px;
    letter-spacing: -0.01em;
    color: var(--color-neutral-900);
  }
  .hero-pitch {
    font-size: var(--text-lg, 1.125rem);
    line-height: 1.55;
    color: var(--color-neutral-700);
    margin: 0 0 28px;
    max-width: 660px;
  }
  .hero-cta-row {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
    margin: 0;
  }
  .hero-cta-primary {
    display: inline-block;
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    padding: 9px 16px;
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: var(--color-white);
    transition: filter 0.12s;
  }
  .hero-cta-primary:hover {
    filter: brightness(1.06);
  }
  .hero-cta-secondary {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-neutral-700);
    text-decoration: none;
  }
  .hero-cta-secondary:hover {
    color: var(--color-neutral-900);
    text-decoration: underline;
  }

  /* "Your dashboards" lede shown to signed-in users with saves. Slimmer
     than the marketing hero so their saved-dashboards grid is the primary
     content above the fold. */
  .returning-hero {
    max-width: 1120px;
    margin: 0 auto;
    padding: 40px 24px 16px;
  }
  .returning-hero[hidden] {
    display: none;
  }
  .returning-title {
    font-size: var(--text-2xl, 1.5rem);
    font-weight: 600;
    margin: 0 0 12px;
    color: var(--color-neutral-900);
    letter-spacing: -0.005em;
  }
  .returning-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin: 0;
  }

  .page-cols {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 24px 56px;
  }

  .section-eyebrow {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-neutral-500);
    margin: 0 0 14px;
  }

  /* My dashboards section */
  .my-section {
    margin-bottom: 40px;
  }
  .my-grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .my-card {
    display: block;
    padding: 16px;
    border: 1px solid rgba(55, 53, 47, 0.1);
    border-radius: var(--radius-sm);
    background: var(--color-white);
    text-decoration: none;
    color: var(--color-neutral-900);
    transition: border-color 0.12s;
  }
  .my-card:hover {
    border-color: rgba(55, 53, 47, 0.25);
  }
  .my-card h3 {
    font-size: var(--text-base);
    font-weight: 600;
    margin: 0;
  }
  .my-card p {
    font-size: var(--text-xs);
    color: var(--color-neutral-500);
    margin: 4px 0 0;
  }

  /* Featured dashboards (tabs + live preview) */
  .featured-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 18px;
  }
  .featured-tab {
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 500;
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(55, 53, 47, 0.1);
    background: var(--color-white);
    color: var(--color-neutral-700);
    cursor: pointer;
    transition:
      background-color 0.12s,
      border-color 0.12s,
      color 0.12s;
  }
  .featured-tab:hover {
    background: var(--color-neutral-100);
    color: var(--color-neutral-900);
  }
  .featured-tab-active,
  .featured-tab-active:hover {
    background: var(--color-neutral-900);
    color: var(--color-white);
    border-color: var(--color-neutral-900);
  }
  .featured-panel[hidden] {
    display: none;
  }
  .featured-description {
    font-size: var(--text-sm);
    color: var(--color-neutral-600);
    line-height: 1.55;
    margin: 0 0 16px;
    max-width: 640px;
  }
  .featured-empty {
    font-size: var(--text-sm);
    color: var(--color-neutral-500);
  }
  /* Make the live preview tile stretch out a bit — on its own (not in a
     dashboard grid) it would otherwise render at the cramped min-width. */
  .featured-tile-wrap :global(.chart-tile) {
    max-width: 520px;
  }
  .featured-cta-row {
    margin: 18px 0 0;
  }
  .featured-open-link {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-accent);
    text-decoration: none;
  }
  .featured-open-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .hero {
      padding: 36px 20px 20px;
    }
    .hero-title {
      font-size: 1.875rem;
    }
    .hero-pitch {
      font-size: 1rem;
    }
  }
</style>
