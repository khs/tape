---
/**
 * /alerts/ — indicator alert management.
 *
 * Per-user. Lists every alert_rules row the signed-in user owns,
 * recent alert_triggers events, and an "+ Add rule" form to mint
 * new rules. All server state in Supabase; this page does the
 * REST round-trips directly via the user's session token (RLS
 * enforces ownership server-side).
 *
 * Schema lives in supabase/migrations/0005_indicator_alerts.sql.
 * Evaluation lives in pipelines/check_alerts.py and runs after each
 * data refresh.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import SourcePicker from "../components/SourcePicker.astro";

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout title="Alerts — Tape" description="Indicator alert rules: get notified when a series crosses a threshold.">
  <div class="alerts-page max-w-[920px] mx-auto px-6 pt-8 pb-16">
    <nav class="text-xs text-neutral-500 mb-3">
      <a href={baseUrl || "/"} class="no-underline hover:text-neutral-900">All dashboards</a>
      <span class="mx-1">·</span>
      <a href={`${baseUrl}/me/`} class="no-underline hover:text-neutral-900">My dashboards</a>
    </nav>

    <header class="alerts-header">
      <h1 class="alerts-title">Alerts</h1>
      <p class="alerts-subtitle">
        Get emailed whenever unemployment breaches 5%, or agricultural
        exports are below $150 billion in a given month. Not suitable for
        market reactions, as we will only email you at most once a week.
      </p>
    </header>

    {/* Sign-in gate. The body below is hidden by the inline script
        when the user isn't authed; an "Anonymous" notice takes its
        place. */}
    <section class="alerts-signin-gate" data-role="alerts-signin-gate" hidden>
      <p>
        <strong>Sign in</strong> to manage your alert rules. Rules are
        per-account; we don't track them anonymously.
      </p>
      <button type="button" class="btn-primary" data-role="alerts-signin-btn">
        Sign in with Google
      </button>
    </section>

    <section class="alerts-body" data-role="alerts-body" hidden>
      {/* Auto-pause banner. Renders only when at least one of the
          user's rules has pause_reason set — meaning the dispatcher
          gave up on it after enough delivery failures. The banner
          is silent for manually-paused rules (paused=true but
          pause_reason NULL). */}
      <section class="alerts-pause-banner" data-role="alerts-pause-banner" hidden>
        <strong>Some alerts were auto-paused.</strong>
        <span data-role="alerts-pause-banner-count"></span>
        Once you've fixed the issue (typically an email-delivery
        problem), resume from the rules list below.
      </section>

      {/* Quick-start examples. Each chip pre-fills the add-rule form
          with a canonical alert pattern — gets the user from "blank
          page" to "thinking about the right kinds of rules" in one
          click. The first-fire still requires clicking "Add rule"
          to confirm; the chips don't auto-save. */}
      <section class="alerts-quickstart">
        <h2 class="alerts-section-heading">Quick start</h2>
        <p class="muted small alerts-quickstart-hint">
          Click an example to pre-fill the form below, then adjust.
        </p>
        <div class="alerts-quickstart-chips" data-role="alerts-quickstart">
          <button
            type="button"
            class="alerts-quickstart-chip"
            data-source="fred/cpi_yoy"
            data-source-label="CPI YoY (US, all urban consumers)"
            data-condition="crosses_above"
            data-threshold="4.0"
            data-label="CPI inflation crosses above 4%"
          >
            CPI inflation crosses 4%
          </button>
          <button
            type="button"
            class="alerts-quickstart-chip"
            data-source="fred/us_unemployment"
            data-source-label="US unemployment rate"
            data-condition="crosses_above"
            data-threshold="5.0"
            data-label="Unemployment crosses above 5%"
          >
            Unemployment crosses 5%
          </button>
          <button
            type="button"
            class="alerts-quickstart-chip"
            data-source="fred/us_10y"
            data-source-label="10-year Treasury yield"
            data-condition="crosses_above"
            data-threshold="5.0"
            data-label="10Y yield crosses above 5%"
          >
            10Y yield crosses 5%
          </button>
          <button
            type="button"
            class="alerts-quickstart-chip"
            data-source="fred/curve_spread"
            data-source-label="10Y-2Y yield curve"
            data-condition="crosses_below"
            data-threshold="0"
            data-label="Yield curve inverts (10Y-2Y < 0)"
          >
            Yield curve inverts
          </button>
        </div>
      </section>

      {/* Add-rule form */}
      <section class="alerts-add">
        <h2 class="alerts-section-heading">Add rule</h2>
        <form class="alerts-add-form" data-role="alerts-add-form">
          {/*
            Source field — migrated 2026-05-26 from bespoke <input> +
            autocomplete <ul> to the shared SourcePicker component per
            the feedback_source_selection.md rule. Picking a card in
            the picker emits `source-picker:pick` on the picker root;
            the page-level listener (in the script block below) updates the
            hidden input + the "selected" display + triggers the
            current-value readout fetch.

            The hidden input keeps the existing form-submit contract:
            wireForm reads sourceInput.value / .dataset.label without
            change. wireQuickStart + the ?source=<id> deep-link path
            programmatically set the same fields.
          */}
          <div class="alerts-field alerts-field-source">
            <span class="alerts-field-label">Source</span>
            <div
              class="alerts-source-selected"
              data-role="alerts-source-selected"
              hidden
            >
              <span
                class="alerts-source-selected-name"
                data-role="alerts-source-selected-name"
              ></span>
              <button
                type="button"
                class="alerts-source-clear"
                data-role="alerts-source-clear"
                aria-label="Clear source selection"
              >&times;</button>
            </div>
            <input
              type="hidden"
              data-role="alerts-source-input"
            />
            {/* Library-picker mode (default). The container itself
                holds a `data-mode` attribute the script flips to
                "custom" to hide this picker + reveal the derived
                builder. */}
            <div
              class="alerts-source-mode"
              data-role="alerts-source-mode"
              data-mode="library"
            >
              <div data-role="alerts-source-library-pane">
                <SourcePicker
                  instanceId="alerts-source"
                  rootClass="alerts-source-picker"
                  searchPlaceholder="Search series — try 'cpi', '10y', 'unemployment'…"
                />
              </div>
            </div>
          </div>

          {/*
            Right-column wrapper. The grid-template-areas in CSS puts
            this entire <div> opposite the Source column, so Condition
            / Current Value / Threshold / Label all stack vertically
            beside the source-picker — instead of fighting the picker
            for vertical real estate via the legacy auto-flow grid.
          */}
          <div class="alerts-add-form-right">
            <label class="alerts-field">
              <span class="alerts-field-label">Condition</span>
              <select class="alerts-input" data-role="alerts-condition-select" required>
                {/* Edge-triggered conditions are the default — they fire
                    once, on the crossing. The fixed-level conditions
                    below re-fire every refresh while the series stays
                    past the threshold (see the warning under the
                    select), so they're offered but not the default. */}
                <option value="crosses_above" selected>Crosses above</option>
                <option value="crosses_below">Crosses below</option>
                <option value="gt">Stays above (&gt;)</option>
                <option value="gte">Stays at or above (&ge;)</option>
                <option value="lt">Stays below (&lt;)</option>
                <option value="lte">Stays at or below (&le;)</option>
                <option value="change_above">Absolute change &gt;</option>
              </select>
            </label>

            {/* Frequency hint. Only shown when the user has picked
                the "Absolute change >" condition AND we've inferred
                a cadence from the source's summary sparks — that
                condition compares each new observation against the
                prior one, so the user needs to know what "the prior
                one" means in time before picking a meaningful
                threshold. Inference logic in src/lib/frequency-infer.ts.
            */}
            <div
              class="alerts-frequency-hint"
              data-role="alerts-frequency-hint"
              hidden
            >
              <span data-role="alerts-frequency-hint-text"></span>
            </div>

            {/* Persistence warning. Shown when a fixed-level condition
                (gt / gte / lt / lte) is selected. Those re-evaluate on
                every refresh, so a series that sits past the threshold
                re-fires every release — most series persist, so that
                means an email every period. We default to the
                edge-triggered crosses_* conditions and warn here when
                the user opts into a level threshold. */}
            <div
              class="alerts-condition-warning"
              data-role="alerts-condition-warning"
              role="status"
              hidden
            >
              <span data-role="alerts-condition-warning-text"></span>
            </div>

            {/* Current-value readout. Appears once a real source is selected
                (picker click, quick-start chip, or deep-link prefill). Lives
                in the right column above Threshold so the user can see the
                live magnitude + unit right next to where they're typing a
                threshold. Hidden until a source is picked.

                The inner row holds the readout itself; the "See chart" link
                lives below it on its own row so the user can pop out the
                source's chart for context without leaving the form. */}
            <div
              class="alerts-current-value"
              data-role="alerts-current-value"
              hidden
            >
              <div class="alerts-current-value-row">
                <span class="alerts-current-value-label">Current value:</span>
                <span class="alerts-current-value-readout" data-role="alerts-current-value-readout"></span>
                <span class="alerts-current-value-asof muted" data-role="alerts-current-value-asof"></span>
              </div>
              <button
                type="button"
                class="alerts-chart-link"
                data-role="alerts-chart-link"
              >
                See chart &rarr;
              </button>
            </div>

            {/* Projected-value target. Shown only when the picked source
                carries a forecast (summary.latestProjection) — lets the user
                alert on where the latest forecast is headed (its furthest
                horizon) instead of the current actual. Stored as a
                "#projection" suffix on the rule's source_id. */}
            <div class="alerts-projection" data-role="alerts-projection" hidden>
              <span class="alerts-projection-label">Alert on</span>
              <label class="alerts-projection-opt">
                <input
                  type="radio"
                  name="alerts-target"
                  value="current"
                  checked
                  data-role="alerts-target-current"
                />
                Current value
              </label>
              <label class="alerts-projection-opt">
                <input
                  type="radio"
                  name="alerts-target"
                  value="projection"
                  data-role="alerts-target-projection"
                />
                Projected <span class="muted" data-role="alerts-projection-readout"></span>
              </label>
            </div>

            <label class="alerts-field">
              <span class="alerts-field-label">Threshold</span>
              <input
                type="number"
                class="alerts-input"
                data-role="alerts-threshold-input"
                step="any"
                placeholder="4.0"
                required
              />
              <span class="alerts-help">
                In the source's native units. For <code>fred/cpi_yoy</code>
                (a percent series), <code>4.0</code> means 4%. For a
                rate-spread, the raw difference. Read the source page
                if you're unsure.
              </span>
            </label>

            <label class="alerts-field">
              <span class="alerts-field-label">Label (optional)</span>
              <input
                type="text"
                class="alerts-input"
                data-role="alerts-label-input"
                placeholder="Inflation > 4%"
              />
            </label>
          </div>

          <div class="alerts-add-actions">
            <button type="submit" class="btn-primary" data-role="alerts-add-submit">
              Add rule
            </button>
            <span class="alerts-add-msg muted small" data-role="alerts-add-msg"></span>
          </div>
        </form>
      </section>

      {/* Active rules */}
      <section class="alerts-rules-wrap">
        <h2 class="alerts-section-heading">
          Your rules <span class="muted" data-role="alerts-rules-count"></span>
        </h2>
        <ul class="alerts-rules" data-role="alerts-rules-list"></ul>
        <p class="muted small" data-role="alerts-rules-empty" hidden>
          No rules yet. Add one above to get started.
        </p>
      </section>

      {/* Trigger feed */}
      <section class="alerts-feed-wrap">
        <div class="alerts-feed-head">
          <h2 class="alerts-section-heading">
            Recent fires <span class="muted" data-role="alerts-feed-count"></span>
          </h2>
          <button
            type="button"
            class="alerts-mark-all-read"
            data-role="alerts-mark-all-read"
            hidden
          >
            Mark all read
          </button>
        </div>
        <ul class="alerts-feed" data-role="alerts-feed-list"></ul>
        <p class="muted small" data-role="alerts-feed-empty" hidden>
          No triggers yet. The evaluator runs after each data refresh
          and writes here when a rule fires.
        </p>
      </section>
    </section>
  </div>

  {/*
    Chart-popout dialog. Opens when the user clicks "See chart" below
    the current-value readout. We iframe the canonical /source/<id>/
    page rather than rebuilding chart rendering inline — that route
    already SSRs the headline chart + provenance + delta pills, and
    keeping it as the single source of truth means the popout stays
    in sync with the rest of the site whenever the chart-rendering
    pipeline evolves.

    The dialog lives at page-level (outside .alerts-page) so its
    showModal() ends up in the browser's top-layer and isn't
    affected by any z-index in the form. Closed-by-default; opened
    by the chart-link click handler. ESC + backdrop click both close.
  */}
  <dialog
    class="alerts-chart-dialog"
    data-role="alerts-chart-dialog"
    aria-label="Source chart"
  >
    <header class="alerts-chart-dialog-header">
      <strong
        class="alerts-chart-dialog-title"
        data-role="alerts-chart-dialog-title"
      ></strong>
      <button
        type="button"
        class="alerts-chart-dialog-close"
        data-role="alerts-chart-dialog-close"
        aria-label="Close chart popout"
      >&times;</button>
    </header>
    <iframe
      class="alerts-chart-dialog-iframe"
      data-role="alerts-chart-dialog-iframe"
      title="Source chart popout"
      loading="lazy"
    ></iframe>
  </dialog>

  <script>
    import { escapeHtml } from "../lib/escape-html";
    import {
      createSupabase,
      isSupabaseConfigured,
      readStoredSession,
      SUPABASE_REST_URL,
      SUPABASE_REST_ANON_KEY,
    } from "../lib/supabase";
    import { sourceIdToPath } from "../lib/source-path";
    import { formatValue, type Formatting } from "../lib/format";
    import {
      getSharedLibrary,
      ensureGeoForSourceId,
    } from "../lib/library-loader";
    import {
      composeDefaultLabel,
      type AlertCondition,
    } from "../lib/alerts-label";
    import {
      inferFrequency,
      type SparkPoint,
    } from "../lib/frequency-infer";

    type AlertRule = {
      id: string;
      source_id: string;
      source_label: string;
      condition: string;
      threshold: number;
      label: string | null;
      last_value_seen: number | null;
      last_value_t: string | null;
      last_triggered_at: string | null;
      paused: boolean;
      pause_reason: string | null;
      created_at: string;
      updated_at: string;
      /** Migration 0007: when set, the rule evaluates A op B
       *  instead of source_id directly. source_id is a display-only
       *  sentinel ("derived:adhoc") for derived rules. */
      derived_spec?: {
        a: string;
        op: "divide" | "diff" | "sum";
        b: string;
      } | null;
    };
    type AlertTrigger = {
      id: string;
      rule_id: string;
      source_id: string;
      source_label: string;
      condition: string;
      threshold: number;
      observed_value: number;
      observed_t: string;
      triggered_at: string;
      acknowledged: boolean;
      notified_at: string | null;
      notify_error: string | null;
      notify_attempts: number | null;
    };

    // Sentinel that the dispatcher stamps on a trigger when it gives
    // up after exhausting retries. Anything matching this value (the
    // Unix epoch in ISO form) means "permanently failed delivery",
    // not "successfully delivered at the epoch".
    const NOTIFIED_DROPPED_SENTINEL = "1970-01-01T00:00:00";
    type LibrarySource = {
      id: string;
      name: string;
      shortName?: string;
      tags?: string[];
      // Full Formatting (style/decimals/notation/scaleFactor/etc.) — same
      // shape the chart renderer uses, so the current-value readout below
      // matches the formatting users see everywhere else on the site.
      formatting?: Formatting;
      unit?: string;
      dataFile?: string;
      lastObservation?: string;
    };
    // Shape of the <id>.summary.json sibling. `latest` powers the
    // current-value readout; `sparks` (per-window downsampled point
    // arrays) feeds the frequency inference shown when the user picks
    // the "Absolute change >" condition so they know whether each new
    // observation is a day, a week, or a month after the prior one.
    type SourceSummary = {
      latest?: { t: string; v: number };
      // Latest forecast vintage's curve (CBO/SSA). Present only for
      // projection-bearing sources; powers the "projected value" alert
      // target — the threshold compares against the furthest-horizon point.
      latestProjection?: {
        vintage: string;
        points: { t: string; v: number }[];
      };
      sparks?: Record<string, SparkPoint[]>;
    };

    const gate = document.querySelector<HTMLElement>("[data-role='alerts-signin-gate']");
    const body = document.querySelector<HTMLElement>("[data-role='alerts-body']");
    const signinBtn = document.querySelector<HTMLButtonElement>("[data-role='alerts-signin-btn']");
    const rulesList = document.querySelector<HTMLElement>("[data-role='alerts-rules-list']");
    const rulesEmpty = document.querySelector<HTMLElement>("[data-role='alerts-rules-empty']");
    const rulesCount = document.querySelector<HTMLElement>("[data-role='alerts-rules-count']");
    const feedList = document.querySelector<HTMLElement>("[data-role='alerts-feed-list']");
    const feedEmpty = document.querySelector<HTMLElement>("[data-role='alerts-feed-empty']");
    const feedCount = document.querySelector<HTMLElement>("[data-role='alerts-feed-count']");
    const markAllRead = document.querySelector<HTMLButtonElement>("[data-role='alerts-mark-all-read']");
    const pauseBanner = document.querySelector<HTMLElement>("[data-role='alerts-pause-banner']");
    const pauseBannerCount = document.querySelector<HTMLElement>("[data-role='alerts-pause-banner-count']");

    const form = document.querySelector<HTMLFormElement>("[data-role='alerts-add-form']");
    const sourceInput = document.querySelector<HTMLInputElement>("[data-role='alerts-source-input']");
    // Note: the legacy `alerts-source-list` autocomplete <ul> was
    // removed when SourcePicker took over. Don't reintroduce — the
    // feedback_source_selection.md rule applies.
    const conditionSelect = document.querySelector<HTMLSelectElement>("[data-role='alerts-condition-select']");
    const thresholdInput = document.querySelector<HTMLInputElement>("[data-role='alerts-threshold-input']");
    const labelInput = document.querySelector<HTMLInputElement>("[data-role='alerts-label-input']");
    const addMsg = document.querySelector<HTMLElement>("[data-role='alerts-add-msg']");

    // ---------- Default-label generator ----------
    //
    // The label field is optional, but most users want SOMETHING in the
    // alerts list + email subject — we autogen from
    // (source name, condition, threshold) so empty alerts don't happen
    // by default. The user can still type their own label; we get out
    // of the way the moment they do, and re-engage only if they clear
    // the field back to empty (treating an empty field as "let the
    // default take over").
    //
    // Pure composition logic + unit-formatting lives in
    // src/lib/alerts-label.ts (tested in its sibling). The DOM dance
    // here is just: track auto vs. manual state on the input itself
    // via dataset.auto, regenerate on source/condition/threshold
    // changes when auto is on, and lock the field to manual the
    // instant the user types something different.
    function isLabelAuto(): boolean {
      if (!labelInput) return false;
      // Empty value counts as "auto" so re-typing into an empty
      // field doesn't accidentally lock us into manual mode forever.
      return labelInput.dataset.auto === "1" || labelInput.value === "";
    }
    function markLabelAuto(): void {
      if (labelInput) labelInput.dataset.auto = "1";
    }
    function markLabelManual(): void {
      if (labelInput) labelInput.dataset.auto = "";
    }
    /** Show/hide the cadence hint that appears under the condition
     *  selector when the user picks "Absolute change >". The hint
     *  reads `summaryCache[id].sparks` and runs inferFrequency
     *  (src/lib/frequency-infer.ts) to turn the spark spacing into
     *  a "daily / weekly / monthly / quarterly / annual" bucket.
     *  Hidden whenever the condition isn't change_above, the
     *  source is derived (no sparks for "derived:adhoc"), or the
     *  summary hasn't loaded / has no usable sparks. Called from
     *  three places: source pick, condition change, and summary
     *  load — together those cover every state transition that
     *  could affect the hint. */
    function updateFrequencyHint(): void {
      if (
        !frequencyHintWrap ||
        !frequencyHintText ||
        !sourceInput ||
        !conditionSelect
      ) {
        return;
      }
      if (conditionSelect.value !== "change_above") {
        frequencyHintWrap.hidden = true;
        return;
      }
      const id = sourceInput.value.trim();
      if (!id || id === "derived:adhoc") {
        frequencyHintWrap.hidden = true;
        return;
      }
      const summary = summaryCache.get(id);
      if (!summary) {
        // Cache miss (still in flight or no .summary.json sibling).
        // Hide rather than show "unknown" — the post-summary call
        // from refreshCurrentValue will re-fire once data lands.
        frequencyHintWrap.hidden = true;
        return;
      }
      const freq = inferFrequency(summary.sparks);
      if (!freq) {
        frequencyHintWrap.hidden = true;
        return;
      }
      const dayWord = freq.days === 1 ? "day" : "days";
      frequencyHintText.textContent =
        `Observations are roughly ${freq.bucket} ` +
        `(~${freq.days} ${dayWord} between releases). ` +
        `Threshold compares each new observation against the prior one.`;
      frequencyHintWrap.hidden = false;
    }

    /** Show/hide the persistence warning under the condition selector.
     *  Fixed-level conditions (gt / gte / lt / lte) re-evaluate on every
     *  refresh, so a series that sits past the threshold re-fires every
     *  release — and most series persist past a level once they reach
     *  it, which means an email every period. The crosses_* conditions
     *  are edge-triggered (fire once, on the crossing), so we default to
     *  those and warn here when the user opts into a level threshold.
     *  Depends only on the selected condition; called alongside
     *  updateFrequencyHint at every condition transition. */
    function updateConditionWarning(): void {
      if (!conditionWarningWrap || !conditionWarningText || !conditionSelect) {
        return;
      }
      const v = conditionSelect.value;
      const isLevel = v === "gt" || v === "gte" || v === "lt" || v === "lte";
      if (!isLevel) {
        conditionWarningWrap.hidden = true;
        return;
      }
      conditionWarningText.textContent =
        "Heads up: a fixed threshold is re-checked on every refresh, so a " +
        "series that stays past it will email you every release — and most " +
        "series persist past a level once they reach it. To be notified " +
        "once, when it actually crosses, use “Crosses above” / " +
        "“Crosses below” instead.";
      conditionWarningWrap.hidden = false;
    }

    /** Recompute + write the default label IF the field is still in
     *  auto mode. No-op when the user has typed their own label. */
    function updateAutoLabel(): void {
      if (!labelInput || !sourceInput || !conditionSelect || !thresholdInput) {
        return;
      }
      if (!isLabelAuto()) return;
      const sourceName = sourceInput.dataset.label?.trim() ?? "";
      const condition = conditionSelect.value as AlertCondition;
      const thresholdRaw = thresholdInput.value;
      // Per-source formatting (needed for the "%" / "$" / " bps" /
      // compact-suffix unit handling). allSources is populated by
      // loadSourceCatalog; for derived ("derived:adhoc") rules there's
      // no entry, so we fall back to bare-number threshold rendering.
      const id = sourceInput.value;
      const src =
        id && id !== "derived:adhoc"
          ? allSources.find((s) => s.id === id)
          : undefined;
      const next = composeDefaultLabel({
        sourceName,
        condition,
        thresholdRaw,
        formatting: src?.formatting,
      });
      labelInput.value = next;
      markLabelAuto();
    }
    const currentValueWrap = document.querySelector<HTMLElement>("[data-role='alerts-current-value']");
    const currentValueReadout = document.querySelector<HTMLElement>("[data-role='alerts-current-value-readout']");
    const currentValueAsOf = document.querySelector<HTMLElement>("[data-role='alerts-current-value-asof']");
    const projectionWrap = document.querySelector<HTMLElement>("[data-role='alerts-projection']");
    const projectionReadout = document.querySelector<HTMLElement>("[data-role='alerts-projection-readout']");
    const projectionRadio = document.querySelector<HTMLInputElement>("[data-role='alerts-target-projection']");
    const currentRadio = document.querySelector<HTMLInputElement>("[data-role='alerts-target-current']");
    const frequencyHintWrap = document.querySelector<HTMLElement>(
      "[data-role='alerts-frequency-hint']",
    );
    const frequencyHintText = document.querySelector<HTMLElement>(
      "[data-role='alerts-frequency-hint-text']",
    );
    const conditionWarningWrap = document.querySelector<HTMLElement>(
      "[data-role='alerts-condition-warning']",
    );
    const conditionWarningText = document.querySelector<HTMLElement>(
      "[data-role='alerts-condition-warning-text']",
    );
    const chartLink = document.querySelector<HTMLButtonElement>(
      "[data-role='alerts-chart-link']",
    );
    const chartDialog = document.querySelector<HTMLDialogElement>(
      "[data-role='alerts-chart-dialog']",
    );
    const chartDialogTitle = document.querySelector<HTMLElement>(
      "[data-role='alerts-chart-dialog-title']",
    );
    const chartDialogIframe = document.querySelector<HTMLIFrameElement>(
      "[data-role='alerts-chart-dialog-iframe']",
    );
    const chartDialogClose = document.querySelector<HTMLButtonElement>(
      "[data-role='alerts-chart-dialog-close']",
    );

    // "See chart" → pop out the canonical /source/<id>/ page in a
    // modal iframe so the user can scan the recent range without
    // leaving the form. Iframed because that route already SSRs the
    // headline chart + delta pills + provenance; rebuilding inline
    // would duplicate logic. Derived ("derived:adhoc") sources have
    // no /source/<id>/ — the chart link is hidden in that mode.
    chartLink?.addEventListener("click", () => {
      const id = sourceInput?.value?.trim() ?? "";
      if (!id || id === "derived:adhoc") return;
      const label = sourceInput?.dataset.label ?? id;
      if (chartDialogTitle) chartDialogTitle.textContent = label;
      if (chartDialogIframe) {
        // Use BASE_URL so the path resolves correctly under any
        // prefix Astro is configured with (today: empty, but
        // historical builds shipped under /tape/).
        const base = (import.meta.env.BASE_URL || "/").replace(/\/$/, "");
        // Encode per path-segment so the provider/series slash stays a real
        // separator — encodeURIComponent(id) would make it "%2F" and the
        // /source/[...id] route would 404 ("Source not found").
        chartDialogIframe.src = `${base}/source/${sourceIdToPath(id)}/`;
      }
      chartDialog?.showModal();
    });
    chartDialogClose?.addEventListener("click", () => chartDialog?.close());
    // Click on the dialog backdrop (target === dialog itself) closes.
    // Clicks on the dialog's child content bubble with target !==
    // dialog so they're ignored here.
    chartDialog?.addEventListener("click", (e) => {
      if (e.target === chartDialog) chartDialog.close();
    });
    // Free the iframe's runtime on close so we don't leave a hidden
    // SPA running. The next open re-sets src and the iframe re-loads.
    chartDialog?.addEventListener("close", () => {
      if (chartDialogIframe) chartDialogIframe.src = "";
    });

    // ---------- Auto-label wiring ----------
    // Condition + threshold edits regenerate the default label
    // (when the user hasn't taken over with their own text).
    // 'change' is the right event for <select>; 'input' fires on
    // every keystroke for <input type=number>.
    conditionSelect?.addEventListener("change", () => {
      updateAutoLabel();
      // Frequency hint + persistence warning visibility both depend on
      // which condition is selected — flip immediately so they appear
      // / vanish in lockstep with the dropdown.
      updateFrequencyHint();
      updateConditionWarning();
    });
    thresholdInput?.addEventListener("input", () => updateAutoLabel());
    // Label edits decide auto vs. manual. Empty → re-engage auto +
    // immediately refill (user sees what the default would be without
    // having to bounce focus). Non-empty → lock to manual so future
    // condition/threshold edits don't clobber the user's text.
    labelInput?.addEventListener("input", () => {
      if (!labelInput) return;
      if (labelInput.value === "") {
        markLabelAuto();
        updateAutoLabel();
      } else {
        markLabelManual();
      }
    });

    if (!isSupabaseConfigured) {
      // Supabase env vars missing entirely — show a hard error rather
      // than the sign-in gate which would be misleading.
      if (gate) {
        gate.hidden = false;
        gate.innerHTML =
          "<p>Alerts require Supabase, which isn't configured on this build.</p>";
      }
    } else {
      const sb = createSupabase();
      const stored = readStoredSession();
      if (!stored) {
        if (gate) gate.hidden = false;
        signinBtn?.addEventListener("click", async () => {
          await sb?.auth.signInWithOAuth({
            provider: "google",
            options: {
              redirectTo: window.location.href,
              scopes: "openid email",
            },
          });
        });
      } else {
        if (body) body.hidden = false;
        void initAuthed(stored);
      }
    }

    function showInitError(): void {
      const host = document.querySelector<HTMLElement>(
        "[data-role='alerts-body']",
      );
      if (!host || host.querySelector("[data-role='alerts-init-error']")) return;
      const el = document.createElement("p");
      el.dataset.role = "alerts-init-error";
      el.setAttribute("role", "alert");
      el.className = "small";
      el.style.cssText =
        "color:#b91c1c;border:1px solid #fecaca;background:#fef2f2;border-radius:6px;padding:8px 12px;margin-bottom:12px;";
      el.textContent =
        "Some alert data couldn't load (network or service issue). The form still works — refresh to retry.";
      host.prepend(el);
    }

    async function initAuthed(stored: NonNullable<ReturnType<typeof readStoredSession>>): Promise<void> {
      // A10: a failed data load (network drop, Supabase outage, malformed
      // 200) must NOT leave the form rendered-but-dead. allSettled lets the
      // wiring proceed regardless; we surface a banner + log on any
      // rejection so the failure is visible, not silent.
      const results = await Promise.allSettled([
        loadRules(stored),
        loadTriggers(stored),
        loadSourceCatalog(),
      ]);
      const failed = results.filter((r) => r.status === "rejected");
      if (failed.length > 0) {
        for (const r of failed) {
          console.error(
            "alerts: initial data load failed:",
            (r as PromiseRejectedResult).reason,
          );
        }
        showInitError();
      }
      wireForm(stored);
      wireQuickStart();
      markAllRead?.addEventListener("click", () => {
        void markAllReadHandler(stored);
      });
      // Deep-link prefill from /alerts/?source=<id>. Lets a user land
      // on the page from a source-page "Watch for alerts" link with
      // the source field already populated.
      const params = new URLSearchParams(window.location.search);
      const presetSource = params.get("source");
      if (presetSource) {
        // A deep-link can target a geo source (e.g. a CD series' "Watch for
        // alerts" link); pull the geo block so the label resolves to a real
        // name rather than the raw id.
        await ensureSourceLoaded(presetSource);
        const label =
          allSources.find((s) => s.id === presetSource)?.name ?? presetSource;
        setSelectedSource(presetSource, label);
      }
    }

    // ---------- Source catalog + SourcePicker wiring ----------
    // The shared SourcePicker component handles the picker UI; we
    // still keep a local `allSources` array for refreshCurrentValue +
    // wireQuickStart + the deep-link prefill, which need to look up
    // a source's dataFile/formatting by id. Two fetches happen in
    // parallel (picker + this) — both hit the browser cache for the
    // 2nd, so cost is negligible.
    let allSources: LibrarySource[] = [];
    // The shared library object (lean manifest + any merged geo block). Held
    // so allSources can be rebuilt after the lazy geo block lands.
    let sharedLib: { sources?: Record<string, LibrarySource> } | null = null;

    function rebuildAllSources(): void {
      const map = sharedLib?.sources ?? {};
      allSources = Object.entries(map).map(([id, s]) => ({ ...s, id }));
    }

    async function loadSourceCatalog(): Promise<void> {
      try {
        // Shared lean manifest — same window-cached object the SourcePicker
        // island on this page uses, so a geo-block load it triggers is
        // visible here too (rebuildAllSources picks it up).
        sharedLib = await getSharedLibrary<{ sources?: Record<string, LibrarySource> }>();
        rebuildAllSources();
      } catch (e) {
        console.warn("alerts: source catalog fetch failed:", e);
      }
    }

    /** Ensure a source id is resolvable in allSources, pulling the lazy geo
     *  block if it's missing — e.g. an existing alert or a deep-link targeting
     *  a CD / state / metro / county / country source that lives in
     *  /library-geo.json, not the lean manifest. Returns true once present. */
    async function ensureSourceLoaded(id: string): Promise<boolean> {
      if (!id || id === "derived:adhoc") return false;
      if (allSources.some((s) => s.id === id)) return true;
      if (sharedLib) {
        // Pull just this id's per-entity geo slice. Always rebuild the
        // snapshot afterward (not gated on a global "geo loaded" flag): the
        // SourcePicker on this page may have already merged other entities
        // into the shared object, and rebuildAllSources must pick those up
        // too so the snapshot stays in sync with the shared library.
        await ensureGeoForSourceId(sharedLib, id);
        rebuildAllSources();
      }
      return allSources.some((s) => s.id === id);
    }

    /**
     * Wire the SourcePicker's `source-picker:pick` event to the
     * hidden form input + the "currently selected" display + the
     * current-value readout fetch. Pulled out as a helper so the
     * quick-start chip + deep-link prefill can call it
     * programmatically — they bypass the picker UI but should
     * still update the same DOM state a real pick would.
     */
    const sourceSelected = document.querySelector<HTMLElement>(
      "[data-role='alerts-source-selected']",
    );
    const sourceSelectedName = document.querySelector<HTMLElement>(
      "[data-role='alerts-source-selected-name']",
    );
    const sourceClearBtn = document.querySelector<HTMLButtonElement>(
      "[data-role='alerts-source-clear']",
    );

    /** Single-source alerts: once a source is picked, collapse the picker so
     *  only the selected chip + its clear-X remain; clicking X brings it back.
     *  Called from setSelectedSource (pick) + clearSelectedSource (X). */
    function applyPickerVisibility(hasSelection: boolean): void {
      const libPicker = document.querySelector<HTMLElement>(
        "[data-spicker-instance='alerts-source']",
      );
      if (libPicker) libPicker.hidden = hasSelection;
    }

    function setSelectedSource(id: string, label: string): void {
      if (!sourceInput) return;
      sourceInput.value = id;
      sourceInput.dataset.label = label;
      if (sourceSelected && sourceSelectedName) {
        if (id) {
          sourceSelectedName.textContent = label || id;
          sourceSelected.hidden = false;
        } else {
          sourceSelected.hidden = true;
          sourceSelectedName.textContent = "";
        }
      }
      applyPickerVisibility(!!id);
      void refreshCurrentValue(id);
      // Source change → recompute the auto-label so the user sees a
      // sensible default the moment they pick. No-op if they've
      // already typed a manual label.
      updateAutoLabel();
      // First-paint frequency-hint update. Reads cache only — the
      // summary may not be loaded yet for a fresh pick, in which
      // case the hint stays hidden until refreshCurrentValue fires
      // it again post-fetch.
      updateFrequencyHint();
    }

    function clearSelectedSource(): void {
      setSelectedSource("", "");
      if (currentValueWrap) currentValueWrap.hidden = true;
    }

    // Listener on the picker root. The picker dispatches a bubbling
    // CustomEvent named `source-picker:pick` with detail.{sourceId,
    // source}; we transform that into our local selection state.
    const pickerRoot = document.querySelector<HTMLElement>(
      "[data-spicker-instance='alerts-source']",
    );
    pickerRoot?.addEventListener("source-picker:pick", (e) => {
      const detail = (e as CustomEvent).detail as {
        sourceId?: string;
        source?: { name?: string };
      };
      const id = detail?.sourceId ?? "";
      const label = detail?.source?.name ?? id;
      setSelectedSource(id, label);
    });

    // Clear button on the "selected" display: empties the form's
    // hidden input + hides the readout. Doesn't reset the picker's
    // filter state — the user might want to pick another source from
    // the same search.
    sourceClearBtn?.addEventListener("click", () => {
      clearSelectedSource();
    });

    // ---------- Custom-indicator (A op B) builder: REMOVED 2026-06-08 ----------
    // Composite / derived-source alerts (alert on A op B) were pulled to
    // prioritize single-source reliability -- the feature also needed migration
    // 0007 (the derived_spec column), which was never applied to prod.
    //
    // TO RE-ADD PROPERLY LATER (Keller wants this back):
    //   1. Apply supabase/migrations/0007_alert_derived_spec.sql to prod.
    //   2. Re-add the A/B builder UI -- ideally matching the compose ds-modal
    //      two-picker + cross-disable UX (SourcePicker disabledIds exists now).
    //   3. Re-add the derived_spec read + the derived_spec POST field in the
    //      submit handler, and set source_id = "derived:adhoc".
    // Still in place (so re-add = UI + save-path + migration only): the rule
    // type derived_spec field, the "derived:adhoc" guards in the current-value
    // / sparkline code, and the check_alerts.py evaluator.

    // ---------- Current-value readout ----------
    // Whenever a valid source is selected, fetch its .summary.json sibling
    // and render the latest value with the source's own formatting. Lets
    // the user see at a glance whether the series ticks in "4.2" (a percent
    // already in percent terms) vs "4.2" (a count that's really 4.2
    // billion) vs "4200000000" (raw dollars) BEFORE they pick a threshold.
    //
    // Cache the in-flight fetch by id so quick source-flicking (autocomplete
    // arrowing, deep-link re-fires) doesn't stack network calls. Also cache
    // by source id to avoid refetching when the user clicks the same source.
    const summaryCache = new Map<string, SourceSummary | null>();

    async function refreshCurrentValue(sourceId: string): Promise<void> {
      if (!currentValueWrap || !currentValueReadout || !currentValueAsOf) return;
      const id = sourceId.trim();
      // Default the projection target hidden + reset to "current" on each
      // (re)load; the success path below re-shows it for forecast sources.
      if (projectionWrap) projectionWrap.hidden = true;
      if (currentRadio) currentRadio.checked = true;
      if (!id) {
        currentValueWrap.hidden = true;
        return;
      }
      // Pull the lazy geo block if this id isn't in the lean catalog (an
      // alert / deep-link on a geo source). Resolves immediately for the
      // common case (lean source already present).
      await ensureSourceLoaded(id);
      const src = allSources.find((s) => s.id === id);
      if (!src || !src.dataFile) {
        // Either the source catalog hasn't loaded yet or the typed string
        // isn't a real ID. Stay silent rather than flash an error — the
        // user might still be mid-typing.
        currentValueWrap.hidden = true;
        return;
      }
      // Show a brief "Loading…" state while the summary fetch is in flight.
      // Important enough to make visible: lets the user know the readout
      // will show up momentarily on slow connections, rather than them
      // assuming the feature is broken.
      currentValueWrap.hidden = false;
      currentValueReadout.textContent = "loading…";
      currentValueAsOf.textContent = "";

      let summary = summaryCache.get(id);
      if (summary === undefined) {
        summary = await fetchSourceSummary(src.dataFile);
        summaryCache.set(id, summary);
      }
      // Stale-response guard: if the user typed/clicked a different source
      // between the fetch starting and it returning, abandon this render.
      // sourceInput.value is the live source of truth.
      if (sourceInput?.value.trim() !== id) return;

      // Summary is now cached → flip the frequency hint on (if the
      // user has change_above selected). This runs unconditionally
      // because updateFrequencyHint's own gating handles the hide
      // case when condition isn't change_above.
      updateFrequencyHint();

      if (!summary?.latest) {
        // Summary file missing or has no `latest`. Some sources (e.g. small
        // ones that haven't run through build_summaries.py yet) won't have
        // a sibling .summary.json. Show a low-key fallback rather than
        // hiding entirely — at least confirms the source matches.
        currentValueReadout.textContent = "—";
        currentValueAsOf.textContent = "no recent data";
        return;
      }
      const fmt: Formatting = src.formatting ?? {
        style: "number",
        decimals: 2,
      };
      currentValueReadout.textContent = formatValue(summary.latest.v, fmt);
      currentValueAsOf.textContent = `as of ${summary.latest.t}`;

      // Forecast-bearing sources (CBO/SSA) get a "projected value" target:
      // alert on the latest forecast's furthest-horizon point instead of the
      // current actual. Saved as a "#projection" suffix on source_id (see
      // pipelines/check_alerts.py).
      const proj = summary.latestProjection;
      if (projectionWrap && proj?.points?.length) {
        const finalPt = proj.points[proj.points.length - 1];
        if (projectionReadout) {
          projectionReadout.textContent = `value (forecast: ${formatValue(finalPt.v, fmt)} by ${finalPt.t.slice(0, 4)})`;
        }
        projectionWrap.hidden = false;
      }
    }

    async function fetchSourceSummary(dataFile: string): Promise<SourceSummary | null> {
      // dataFile is relative ("data/fred/CPIAUCSL_PC1.json"); the .summary
      // sibling lives next to it. Resolve against BASE_URL the same way
      // loadSourceCatalog does.
      const summaryFile = dataFile.replace(/\.json$/, ".summary.json");
      const base = (import.meta.env.BASE_URL || "/").replace(/\/$/, "");
      const url = `${base}/${summaryFile}`;
      try {
        const r = await fetch(url);
        if (!r.ok) return null;
        return (await r.json()) as SourceSummary;
      } catch {
        return null;
      }
    }

    // Note: legacy "type the full source ID" input/change listeners
    // were removed when SourcePicker took over — the hidden input no
    // longer accepts user keystrokes. All source picks now flow
    // through setSelectedSource (picker click, quick-start chip, or
    // deep-link URL ?source=<id>), which already calls
    // refreshCurrentValue.

    // ---------- Rules CRUD ----------
    async function loadRules(stored: NonNullable<ReturnType<typeof readStoredSession>>): Promise<void> {
      const r = await fetch(
        `${SUPABASE_REST_URL}/rest/v1/alert_rules?owner_id=eq.${encodeURIComponent(stored.user.id)}&select=*&order=updated_at.desc`,
        {
          headers: {
            apikey: SUPABASE_REST_ANON_KEY,
            Authorization: `Bearer ${stored.access_token}`,
          },
        },
      );
      const rows: AlertRule[] = r.ok ? await r.json() : [];
      renderRules(rows, stored);
    }

    function renderRules(rows: AlertRule[], stored: NonNullable<ReturnType<typeof readStoredSession>>): void {
      if (!rulesList) return;
      rulesList.innerHTML = "";
      if (rulesCount) rulesCount.textContent = rows.length > 0 ? `(${rows.length})` : "";

      // Auto-pause banner. Show when ANY rule has pause_reason set
      // (auto-paused). Manual pauses (paused=true, pause_reason NULL)
      // don't surface a banner — that's a deliberate user choice.
      const autoPaused = rows.filter((r) => r.paused && r.pause_reason);
      if (pauseBanner) {
        if (autoPaused.length > 0) {
          pauseBanner.hidden = false;
          if (pauseBannerCount) {
            pauseBannerCount.textContent =
              autoPaused.length === 1
                ? "1 rule was paused after repeated delivery failures."
                : `${autoPaused.length} rules were paused after repeated delivery failures.`;
          }
        } else {
          pauseBanner.hidden = true;
        }
      }

      if (rows.length === 0) {
        if (rulesEmpty) rulesEmpty.hidden = false;
        return;
      }
      if (rulesEmpty) rulesEmpty.hidden = true;
      for (const r of rows) {
        const li = document.createElement("li");
        li.className = "alerts-rule" + (r.paused ? " alerts-rule-paused" : "");
        li.dataset.ruleId = r.id;
        // Distinguish auto-pause (pause_reason text) from manual
        // pause (paused=true, pause_reason NULL). Auto-pause shows
        // the reason text + a different border tint via the
        // -autopaused modifier class.
        const isAutoPaused = r.paused && !!r.pause_reason;
        if (isAutoPaused) li.classList.add("alerts-rule-autopaused");
        li.innerHTML = `
          <div class="alerts-rule-main">
            <div class="alerts-rule-label">${escapeHtml(r.label || defaultRuleLabel(r))}</div>
            <div class="alerts-rule-source">
              ${
                // Derived rules carry a sentinel source_id like
                // "derived:adhoc" that doesn't resolve to a real
                // /source/<id>/ page. Render the label as plain text
                // (with a small "custom" eyebrow) instead of a dead
                // link. Library-source rules keep their click-through.
                r.derived_spec
                  ? `<span class="alerts-rule-source-link alerts-rule-source-derived"><span class="alerts-rule-custom-eyebrow">custom</span>${escapeHtml(r.source_label)}</span>`
                  : `<a href="${(import.meta.env.BASE_URL || "/").replace(/\/$/, "")}/source/${escapeAttr(r.source_id)}/" class="alerts-rule-source-link">${escapeHtml(r.source_label)}</a>`
              }
              <span class="alerts-rule-condition mono">${escapeHtml(conditionPhrase(r))}</span>
            </div>
            <div class="alerts-rule-meta muted small">
              ${r.last_value_seen !== null && r.last_value_t ? `last value ${escapeHtml(String(r.last_value_seen))} on ${escapeHtml(r.last_value_t)}. ` : "Not yet evaluated. "}
              ${r.last_triggered_at ? `last fired ${escapeHtml(r.last_triggered_at.slice(0, 10))}.` : "Never fired."}
            </div>
            ${
              isAutoPaused && r.pause_reason
                ? `<div class="alerts-rule-pause-reason">${escapeHtml(r.pause_reason)}</div>`
                : ""
            }
          </div>
          <div class="alerts-rule-actions">
            <button type="button" data-action="toggle-pause" class="alerts-rule-action">${r.paused ? "Resume" : "Pause"}</button>
            <button type="button" data-action="delete" class="alerts-rule-action alerts-rule-action-danger">Delete</button>
          </div>
        `;
        rulesList.appendChild(li);
      }
      rulesList.querySelectorAll<HTMLButtonElement>("button[data-action]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const li = btn.closest<HTMLElement>(".alerts-rule");
          if (!li) return;
          const id = li.dataset.ruleId ?? "";
          const action = btn.dataset.action;
          if (action === "delete") {
            if (!confirm("Delete this alert rule? The trigger history is preserved.")) return;
            await fetch(`${SUPABASE_REST_URL}/rest/v1/alert_rules?id=eq.${encodeURIComponent(id)}`, {
              method: "DELETE",
              headers: {
                apikey: SUPABASE_REST_ANON_KEY,
                Authorization: `Bearer ${stored.access_token}`,
              },
            });
            await loadRules(stored);
          } else if (action === "toggle-pause") {
            const currentlyPaused = li.classList.contains("alerts-rule-paused");
            // Resuming clears BOTH paused and pause_reason (a manual
            // resume erases any auto-pause history). Pausing leaves
            // pause_reason alone — a manual pause has no reason text.
            const body = currentlyPaused
              ? { paused: false, pause_reason: null }
              : { paused: true };
            await fetch(`${SUPABASE_REST_URL}/rest/v1/alert_rules?id=eq.${encodeURIComponent(id)}`, {
              method: "PATCH",
              headers: {
                apikey: SUPABASE_REST_ANON_KEY,
                Authorization: `Bearer ${stored.access_token}`,
                "Content-Type": "application/json",
                Prefer: "return=minimal",
              },
              body: JSON.stringify(body),
            });
            await loadRules(stored);
          }
        });
      });
    }

    function defaultRuleLabel(r: AlertRule): string {
      return `${r.source_label} ${conditionPhrase(r)}`;
    }
    function conditionPhrase(r: AlertRule): string {
      const t = r.threshold;
      switch (r.condition) {
        case "gt": return `> ${t}`;
        case "gte": return `≥ ${t}`;
        case "lt": return `< ${t}`;
        case "lte": return `≤ ${t}`;
        case "crosses_above": return `crosses above ${t}`;
        case "crosses_below": return `crosses below ${t}`;
        case "change_above": return `|Δ| > ${t}`;
        default: return `${r.condition} ${t}`;
      }
    }

    // ---------- Trigger feed ----------
    async function loadTriggers(stored: NonNullable<ReturnType<typeof readStoredSession>>): Promise<void> {
      const r = await fetch(
        `${SUPABASE_REST_URL}/rest/v1/alert_triggers?owner_id=eq.${encodeURIComponent(stored.user.id)}&select=*&order=triggered_at.desc&limit=50`,
        {
          headers: {
            apikey: SUPABASE_REST_ANON_KEY,
            Authorization: `Bearer ${stored.access_token}`,
          },
        },
      );
      const rows: AlertTrigger[] = r.ok ? await r.json() : [];
      renderTriggers(rows, stored);
    }

    function notifyStatus(t: AlertTrigger): { label: string; cls: string } {
      // Three states based on notified_at:
      //   null            → "pending" (queued for next dispatch)
      //   sentinel epoch  → "delivery failed" (dispatcher gave up)
      //   anything else   → "delivered <date>"
      if (!t.notified_at) {
        return { label: "queued", cls: "alerts-status-queued" };
      }
      if (t.notified_at.startsWith(NOTIFIED_DROPPED_SENTINEL)) {
        return { label: "delivery failed", cls: "alerts-status-failed" };
      }
      return {
        label: `emailed ${t.notified_at.slice(0, 10)}`,
        cls: "alerts-status-sent",
      };
    }

    function renderTriggers(
      rows: AlertTrigger[],
      stored: NonNullable<ReturnType<typeof readStoredSession>>,
    ): void {
      if (!feedList) return;
      feedList.innerHTML = "";
      if (feedCount) feedCount.textContent = rows.length > 0 ? `(${rows.length})` : "";
      const unread = rows.filter((t) => !t.acknowledged);
      if (markAllRead) markAllRead.hidden = unread.length === 0;
      if (rows.length === 0) {
        if (feedEmpty) feedEmpty.hidden = false;
        return;
      }
      if (feedEmpty) feedEmpty.hidden = true;
      for (const t of rows) {
        const li = document.createElement("li");
        li.className = "alerts-trigger" + (t.acknowledged ? " alerts-trigger-ack" : "");
        li.dataset.triggerId = t.id;
        const status = notifyStatus(t);
        li.innerHTML = `
          <div class="alerts-trigger-when">${escapeHtml(t.triggered_at.slice(0, 10))}</div>
          <div class="alerts-trigger-main">
            <div class="alerts-trigger-headline">
              <strong>${escapeHtml(t.source_label)}</strong>
              <span class="mono">${escapeHtml(t.condition)} ${escapeHtml(String(t.threshold))}</span>
              → observed <strong>${escapeHtml(String(t.observed_value))}</strong>
              on ${escapeHtml(t.observed_t)}
            </div>
            <div class="alerts-trigger-meta muted small">
              <span class="alerts-status ${status.cls}">${escapeHtml(status.label)}</span>
              ${t.notify_error && t.notified_at && t.notified_at.startsWith(NOTIFIED_DROPPED_SENTINEL) ? `<span class="alerts-status-detail" title="${escapeAttr(t.notify_error)}">— ${escapeHtml(t.notify_error.slice(0, 80))}${t.notify_error.length > 80 ? "…" : ""}</span>` : ""}
            </div>
          </div>
          <div class="alerts-trigger-actions">
            ${t.acknowledged ? '<span class="alerts-trigger-ack-tag muted small">read</span>' : '<button type="button" class="alerts-trigger-action" data-action="ack">Mark read</button>'}
          </div>
        `;
        feedList.appendChild(li);
      }
      feedList.querySelectorAll<HTMLButtonElement>("button[data-action='ack']").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const li = btn.closest<HTMLElement>(".alerts-trigger");
          if (!li) return;
          const id = li.dataset.triggerId ?? "";
          // Optimistic UI: gray the row immediately so a slow PATCH
          // doesn't make the click feel unresponsive. loadTriggers()
          // resyncs the truth shortly.
          li.classList.add("alerts-trigger-ack");
          btn.disabled = true;
          try {
            await fetch(`${SUPABASE_REST_URL}/rest/v1/alert_triggers?id=eq.${encodeURIComponent(id)}`, {
              method: "PATCH",
              headers: {
                apikey: SUPABASE_REST_ANON_KEY,
                Authorization: `Bearer ${stored.access_token}`,
                "Content-Type": "application/json",
                Prefer: "return=minimal",
              },
              body: JSON.stringify({ acknowledged: true }),
            });
          } finally {
            await loadTriggers(stored);
          }
        });
      });
    }

    async function markAllReadHandler(
      stored: NonNullable<ReturnType<typeof readStoredSession>>,
    ): Promise<void> {
      // Bulk PATCH every unread trigger for this owner. PostgREST's
      // filter syntax lets us update many rows in a single request
      // (owner_id eq + acknowledged eq false) — much cheaper than
      // per-row PATCHes when a long batch went out and the user
      // clicks "mark all read" once.
      if (!markAllRead) return;
      markAllRead.disabled = true;
      try {
        await fetch(
          `${SUPABASE_REST_URL}/rest/v1/alert_triggers?owner_id=eq.${encodeURIComponent(stored.user.id)}&acknowledged=eq.false`,
          {
            method: "PATCH",
            headers: {
              apikey: SUPABASE_REST_ANON_KEY,
              Authorization: `Bearer ${stored.access_token}`,
              "Content-Type": "application/json",
              Prefer: "return=minimal",
            },
            body: JSON.stringify({ acknowledged: true }),
          },
        );
      } finally {
        markAllRead.disabled = false;
        await loadTriggers(stored);
      }
    }

    // ---------- Add-rule form ----------
    function wireForm(stored: NonNullable<ReturnType<typeof readStoredSession>>): void {
      form?.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!sourceInput || !conditionSelect || !thresholdInput || !labelInput || !addMsg) return;
        const baseId = sourceInput.value.trim();
        const threshold = parseFloat(thresholdInput.value);
        if (!baseId || !Number.isFinite(threshold)) {
          addMsg.textContent = "Need a source and a numeric threshold.";
          return;
        }
        // Projected-value target: append the "#projection" suffix the
        // evaluator recognizes (pipelines/check_alerts.py). Only when the
        // projection control is actually shown + selected for this source.
        const useProjection =
          !!projectionRadio?.checked && projectionWrap?.hidden === false;
        const sourceId = useProjection ? `${baseId}#projection` : baseId;
        const baseLabel =
          sourceInput.dataset.label ??
          allSources.find((s) => s.id === baseId)?.name ??
          baseId;
        const sourceLabel = useProjection
          ? `${baseLabel} (projected)`
          : baseLabel;
        addMsg.textContent = "Saving…";
        const res = await fetch(`${SUPABASE_REST_URL}/rest/v1/alert_rules`, {
          method: "POST",
          headers: {
            apikey: SUPABASE_REST_ANON_KEY,
            Authorization: `Bearer ${stored.access_token}`,
            "Content-Type": "application/json",
            Prefer: "return=minimal",
          },
          body: JSON.stringify({
            owner_id: stored.user.id,
            source_id: sourceId,
            source_label: sourceLabel,
            condition: conditionSelect.value,
            threshold,
            label: labelInput.value.trim() || null,

          }),
        });
        if (res.ok) {
          addMsg.textContent = "Saved.";
          // Use clearSelectedSource so the "selected" display hides
          // alongside the hidden input + current-value readout reset.
          // Doesn't clear the picker's filter state — the user might
          // want to add a second alert on a related source from the
          // same search.
          clearSelectedSource();
          thresholdInput.value = "";
          labelInput.value = "";
          // Re-engage auto-label so the next pick gets a fresh
          // default. clearSelectedSource doesn't touch the label
          // dataset, and the post-submit programmatic .value = ""
          // doesn't fire the input listener that would otherwise
          // re-engage auto.
          markLabelAuto();
          setTimeout(() => {
            if (addMsg) addMsg.textContent = "";
          }, 2000);
          await loadRules(stored);
        } else {
          // Surface the PostgREST error body so a save failure is diagnosable.
          const detail = await res.text().catch(() => "");
          console.warn("[alerts] rule save failed:", res.status, detail);
          addMsg.textContent = `Failed to save: HTTP ${res.status}`;
        }
      });
    }

    // Quick-start chip handler. Reads data attributes off the
    // clicked button and pre-fills the add-rule form. Doesn't auto-
    // submit — the user still has to click "Add rule" to confirm
    // (lets them tweak the threshold or condition first).
    function wireQuickStart(): void {
      const chips = document.querySelectorAll<HTMLButtonElement>(
        "[data-role='alerts-quickstart'] .alerts-quickstart-chip",
      );
      chips.forEach((chip) => {
        chip.addEventListener("click", () => {
          // Use the shared setter so the hidden input + "selected"
          // display + current-value readout all update together.
          // Same path the picker click takes — keeps the two flows
          // observably identical.
          setSelectedSource(
            chip.dataset.source ?? "",
            chip.dataset.sourceLabel ?? "",
          );
          if (conditionSelect) {
            conditionSelect.value = chip.dataset.condition ?? "crosses_above";
          }
          if (thresholdInput) {
            thresholdInput.value = chip.dataset.threshold ?? "";
          }
          // Setting <select>.value doesn't fire 'change', so refresh the
          // condition-dependent UI (cadence hint + persistence warning)
          // explicitly to match the chip's condition.
          updateFrequencyHint();
          updateConditionWarning();
          if (labelInput) {
            labelInput.value = chip.dataset.label ?? "";
            // Quick-start chips ship hand-written, editorial labels
            // ("Yield curve inverts (10Y-2Y < 0)") that read better
            // than the auto-default would. Mark the field manual so
            // later condition/threshold edits don't clobber it; the
            // user can still clear the field to re-engage the auto
            // composer if they want.
            markLabelManual();
          }
          // Scroll the form into view so the user sees the
          // pre-filled fields immediately.
          form?.scrollIntoView({ behavior: "smooth", block: "start" });
        });
      });
    }

    function escapeAttr(s: string): string {
      return escapeHtml(s);
    }
  </script>
</BaseLayout>

