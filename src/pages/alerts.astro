---
/**
 * /alerts/ — indicator alert management.
 *
 * Per-user. Lists every alert_rules row the signed-in user owns,
 * recent alert_triggers events, and an "+ Add rule" form to mint
 * new rules. All server state in Supabase; this page does the
 * REST round-trips directly via the user's session token (RLS
 * enforces ownership server-side).
 *
 * Schema lives in supabase/migrations/0005_indicator_alerts.sql.
 * Evaluation lives in pipelines/check_alerts.py and runs after each
 * data refresh.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import SourcePicker from "../components/SourcePicker.astro";

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout title="Alerts — Tape" description="Indicator alert rules: get notified when a series crosses a threshold.">
  <div class="alerts-page max-w-[920px] mx-auto px-6 pt-8 pb-16">
    <nav class="text-xs text-neutral-500 mb-3">
      <a href={baseUrl || "/"} class="no-underline hover:text-neutral-900">All dashboards</a>
      <span class="mx-1">·</span>
      <a href={`${baseUrl}/me/`} class="no-underline hover:text-neutral-900">My dashboards</a>
    </nav>

    <header class="alerts-header">
      <h1 class="alerts-title">Indicator alerts</h1>
      <p class="alerts-subtitle">
        Get notified when a series crosses a threshold. Rules check
        after every weekly market-data refresh and monthly demographics
        refresh — typically you'll see fires within a day of the source
        actually changing.
      </p>
    </header>

    {/* Sign-in gate. The body below is hidden by the inline script
        when the user isn't authed; an "Anonymous" notice takes its
        place. */}
    <section class="alerts-signin-gate" data-role="alerts-signin-gate" hidden>
      <p>
        <strong>Sign in</strong> to manage your alert rules. Rules are
        per-account; we don't track them anonymously.
      </p>
      <button type="button" class="btn-primary" data-role="alerts-signin-btn">
        Sign in with Google
      </button>
    </section>

    <section class="alerts-body" data-role="alerts-body" hidden>
      {/* Auto-pause banner. Renders only when at least one of the
          user's rules has pause_reason set — meaning the dispatcher
          gave up on it after enough delivery failures. The banner
          is silent for manually-paused rules (paused=true but
          pause_reason NULL). */}
      <section class="alerts-pause-banner" data-role="alerts-pause-banner" hidden>
        <strong>Some alerts were auto-paused.</strong>
        <span data-role="alerts-pause-banner-count"></span>
        Once you've fixed the issue (typically an email-delivery
        problem), resume from the rules list below.
      </section>

      {/* Quick-start examples. Each chip pre-fills the add-rule form
          with a canonical alert pattern — gets the user from "blank
          page" to "thinking about the right kinds of rules" in one
          click. The first-fire still requires clicking "Add rule"
          to confirm; the chips don't auto-save. */}
      <section class="alerts-quickstart">
        <h2 class="alerts-section-heading">Quick start</h2>
        <p class="muted small alerts-quickstart-hint">
          Click an example to pre-fill the form below, then adjust.
        </p>
        <div class="alerts-quickstart-chips" data-role="alerts-quickstart">
          <button
            type="button"
            class="alerts-quickstart-chip"
            data-source="fred/cpi_yoy"
            data-source-label="CPI YoY (US, all urban consumers)"
            data-condition="gte"
            data-threshold="4.0"
            data-label="CPI inflation at/above 4%"
          >
            CPI inflation ≥ 4%
          </button>
          <button
            type="button"
            class="alerts-quickstart-chip"
            data-source="fred/us_unemployment"
            data-source-label="US unemployment rate"
            data-condition="gte"
            data-threshold="5.0"
            data-label="Unemployment ≥ 5%"
          >
            Unemployment ≥ 5%
          </button>
          <button
            type="button"
            class="alerts-quickstart-chip"
            data-source="fred/us_10y"
            data-source-label="10-year Treasury yield"
            data-condition="gte"
            data-threshold="5.0"
            data-label="10Y yield ≥ 5%"
          >
            10Y yield ≥ 5%
          </button>
          <button
            type="button"
            class="alerts-quickstart-chip"
            data-source="fred/curve_spread"
            data-source-label="10Y-2Y yield curve"
            data-condition="crosses_below"
            data-threshold="0"
            data-label="Yield curve inverts (10Y-2Y < 0)"
          >
            Yield curve inverts
          </button>
          <button
            type="button"
            class="alerts-quickstart-chip"
            data-source="fred/vix"
            data-source-label="VIX"
            data-condition="gte"
            data-threshold="30"
            data-label="VIX ≥ 30 (stress threshold)"
          >
            VIX ≥ 30
          </button>
        </div>
      </section>

      {/* Add-rule form */}
      <section class="alerts-add">
        <h2 class="alerts-section-heading">Add rule</h2>
        <form class="alerts-add-form" data-role="alerts-add-form">
          {/*
            Source field — migrated 2026-05-26 from bespoke <input> +
            autocomplete <ul> to the shared SourcePicker component per
            the feedback_source_selection.md rule. Picking a card in
            the picker emits `source-picker:pick` on the picker root;
            the page-level listener (in <script> below) updates the
            hidden input + the "selected" display + triggers the
            current-value readout fetch.

            The hidden input keeps the existing form-submit contract:
            wireForm reads sourceInput.value / .dataset.label without
            change. wireQuickStart + the ?source=<id> deep-link path
            programmatically set the same fields.
          */}
          <div class="alerts-field alerts-field-source">
            <span class="alerts-field-label">Source</span>
            <div
              class="alerts-source-selected"
              data-role="alerts-source-selected"
              hidden
            >
              <span
                class="alerts-source-selected-name"
                data-role="alerts-source-selected-name"
              ></span>
              <button
                type="button"
                class="alerts-source-clear"
                data-role="alerts-source-clear"
                aria-label="Clear source selection"
              >&times;</button>
            </div>
            <input
              type="hidden"
              data-role="alerts-source-input"
            />
            <SourcePicker
              instanceId="alerts-source"
              rootClass="alerts-source-picker"
              searchPlaceholder="Search series — try 'cpi', '10y', 'unemployment'…"
            />
          </div>

          {/*
            Right-column wrapper. The grid-template-areas in CSS puts
            this entire <div> opposite the Source column, so Condition
            / Current Value / Threshold / Label all stack vertically
            beside the source-picker — instead of fighting the picker
            for vertical real estate via the legacy auto-flow grid.
          */}
          <div class="alerts-add-form-right">
            <label class="alerts-field">
              <span class="alerts-field-label">Condition</span>
              <select class="alerts-input" data-role="alerts-condition-select" required>
                <option value="gt">Greater than (&gt;)</option>
                <option value="gte" selected>At or above (&ge;)</option>
                <option value="lt">Less than (&lt;)</option>
                <option value="lte">At or below (&le;)</option>
                <option value="crosses_above">Crosses above</option>
                <option value="crosses_below">Crosses below</option>
                <option value="change_above">Absolute change &gt;</option>
              </select>
            </label>

            {/* Current-value readout. Appears once a real source is selected
                (picker click, quick-start chip, or deep-link prefill). Lives
                in the right column above Threshold so the user can see the
                live magnitude + unit right next to where they're typing a
                threshold. Hidden until a source is picked. */}
            <div
              class="alerts-current-value"
              data-role="alerts-current-value"
              hidden
            >
              <span class="alerts-current-value-label">Current value:</span>
              <span class="alerts-current-value-readout" data-role="alerts-current-value-readout"></span>
              <span class="alerts-current-value-asof muted" data-role="alerts-current-value-asof"></span>
            </div>

            <label class="alerts-field">
              <span class="alerts-field-label">Threshold</span>
              <input
                type="number"
                class="alerts-input"
                data-role="alerts-threshold-input"
                step="any"
                placeholder="4.0"
                required
              />
              <span class="alerts-help">
                In the source's native units. For <code>fred/cpi_yoy</code>
                (a percent series), <code>4.0</code> means 4%. For a
                rate-spread, the raw difference. Read the source page
                if you're unsure.
              </span>
            </label>

            <label class="alerts-field">
              <span class="alerts-field-label">Label (optional)</span>
              <input
                type="text"
                class="alerts-input"
                data-role="alerts-label-input"
                placeholder="Inflation > 4%"
              />
            </label>
          </div>

          <div class="alerts-add-actions">
            <button type="submit" class="btn-primary" data-role="alerts-add-submit">
              Add rule
            </button>
            <span class="alerts-add-msg muted small" data-role="alerts-add-msg"></span>
          </div>
        </form>
      </section>

      {/* Active rules */}
      <section class="alerts-rules-wrap">
        <h2 class="alerts-section-heading">
          Your rules <span class="muted" data-role="alerts-rules-count"></span>
        </h2>
        <ul class="alerts-rules" data-role="alerts-rules-list"></ul>
        <p class="muted small" data-role="alerts-rules-empty" hidden>
          No rules yet. Add one above to get started.
        </p>
      </section>

      {/* Trigger feed */}
      <section class="alerts-feed-wrap">
        <div class="alerts-feed-head">
          <h2 class="alerts-section-heading">
            Recent fires <span class="muted" data-role="alerts-feed-count"></span>
          </h2>
          <button
            type="button"
            class="alerts-mark-all-read"
            data-role="alerts-mark-all-read"
            hidden
          >
            Mark all read
          </button>
        </div>
        <ul class="alerts-feed" data-role="alerts-feed-list"></ul>
        <p class="muted small" data-role="alerts-feed-empty" hidden>
          No triggers yet. The evaluator runs after each data refresh
          and writes here when a rule fires.
        </p>
      </section>
    </section>
  </div>

  <script>
    import {
      createSupabase,
      isSupabaseConfigured,
      readStoredSession,
      SUPABASE_REST_URL,
      SUPABASE_REST_ANON_KEY,
    } from "../lib/supabase";
    import { formatValue, type Formatting } from "../lib/format";

    type AlertRule = {
      id: string;
      source_id: string;
      source_label: string;
      condition: string;
      threshold: number;
      label: string | null;
      last_value_seen: number | null;
      last_value_t: string | null;
      last_triggered_at: string | null;
      paused: boolean;
      pause_reason: string | null;
      created_at: string;
      updated_at: string;
    };
    type AlertTrigger = {
      id: string;
      rule_id: string;
      source_id: string;
      source_label: string;
      condition: string;
      threshold: number;
      observed_value: number;
      observed_t: string;
      triggered_at: string;
      acknowledged: boolean;
      notified_at: string | null;
      notify_error: string | null;
      notify_attempts: number | null;
    };

    // Sentinel that the dispatcher stamps on a trigger when it gives
    // up after exhausting retries. Anything matching this value (the
    // Unix epoch in ISO form) means "permanently failed delivery",
    // not "successfully delivered at the epoch".
    const NOTIFIED_DROPPED_SENTINEL = "1970-01-01T00:00:00";
    type LibrarySource = {
      id: string;
      name: string;
      shortName?: string;
      tags?: string[];
      // Full Formatting (style/decimals/notation/scaleFactor/etc.) — same
      // shape the chart renderer uses, so the current-value readout below
      // matches the formatting users see everywhere else on the site.
      formatting?: Formatting;
      unit?: string;
      dataFile?: string;
      lastObservation?: string;
    };
    // Shape of the <id>.summary.json sibling. We only need `latest`; the
    // rest (priors/sparks) is what powers tile rendering elsewhere.
    type SourceSummary = {
      latest?: { t: string; v: number };
    };

    const gate = document.querySelector<HTMLElement>("[data-role='alerts-signin-gate']");
    const body = document.querySelector<HTMLElement>("[data-role='alerts-body']");
    const signinBtn = document.querySelector<HTMLButtonElement>("[data-role='alerts-signin-btn']");
    const rulesList = document.querySelector<HTMLElement>("[data-role='alerts-rules-list']");
    const rulesEmpty = document.querySelector<HTMLElement>("[data-role='alerts-rules-empty']");
    const rulesCount = document.querySelector<HTMLElement>("[data-role='alerts-rules-count']");
    const feedList = document.querySelector<HTMLElement>("[data-role='alerts-feed-list']");
    const feedEmpty = document.querySelector<HTMLElement>("[data-role='alerts-feed-empty']");
    const feedCount = document.querySelector<HTMLElement>("[data-role='alerts-feed-count']");
    const markAllRead = document.querySelector<HTMLButtonElement>("[data-role='alerts-mark-all-read']");
    const pauseBanner = document.querySelector<HTMLElement>("[data-role='alerts-pause-banner']");
    const pauseBannerCount = document.querySelector<HTMLElement>("[data-role='alerts-pause-banner-count']");

    const form = document.querySelector<HTMLFormElement>("[data-role='alerts-add-form']");
    const sourceInput = document.querySelector<HTMLInputElement>("[data-role='alerts-source-input']");
    // Note: the legacy `alerts-source-list` autocomplete <ul> was
    // removed when SourcePicker took over. Don't reintroduce — the
    // feedback_source_selection.md rule applies.
    const conditionSelect = document.querySelector<HTMLSelectElement>("[data-role='alerts-condition-select']");
    const thresholdInput = document.querySelector<HTMLInputElement>("[data-role='alerts-threshold-input']");
    const labelInput = document.querySelector<HTMLInputElement>("[data-role='alerts-label-input']");
    const addMsg = document.querySelector<HTMLElement>("[data-role='alerts-add-msg']");
    const currentValueWrap = document.querySelector<HTMLElement>("[data-role='alerts-current-value']");
    const currentValueReadout = document.querySelector<HTMLElement>("[data-role='alerts-current-value-readout']");
    const currentValueAsOf = document.querySelector<HTMLElement>("[data-role='alerts-current-value-asof']");

    if (!isSupabaseConfigured) {
      // Supabase env vars missing entirely — show a hard error rather
      // than the sign-in gate which would be misleading.
      if (gate) {
        gate.hidden = false;
        gate.innerHTML =
          "<p>Alerts require Supabase, which isn't configured on this build.</p>";
      }
    } else {
      const sb = createSupabase();
      const stored = readStoredSession();
      if (!stored) {
        if (gate) gate.hidden = false;
        signinBtn?.addEventListener("click", async () => {
          await sb?.auth.signInWithOAuth({
            provider: "google",
            options: {
              redirectTo: window.location.href,
              scopes: "openid email",
            },
          });
        });
      } else {
        if (body) body.hidden = false;
        void initAuthed(stored);
      }
    }

    async function initAuthed(stored: NonNullable<ReturnType<typeof readStoredSession>>): Promise<void> {
      await Promise.all([loadRules(stored), loadTriggers(stored), loadSourceCatalog()]);
      wireForm(stored);
      wireQuickStart();
      markAllRead?.addEventListener("click", () => {
        void markAllReadHandler(stored);
      });
      // Deep-link prefill from /alerts/?source=<id>. Lets a user land
      // on the page from a source-page "Watch for alerts" link with
      // the source field already populated.
      const params = new URLSearchParams(window.location.search);
      const presetSource = params.get("source");
      if (presetSource) {
        const label =
          allSources.find((s) => s.id === presetSource)?.name ?? presetSource;
        setSelectedSource(presetSource, label);
      }
    }

    // ---------- Source catalog + SourcePicker wiring ----------
    // The shared SourcePicker component handles the picker UI; we
    // still keep a local `allSources` array for refreshCurrentValue +
    // wireQuickStart + the deep-link prefill, which need to look up
    // a source's dataFile/formatting by id. Two fetches happen in
    // parallel (picker + this) — both hit the browser cache for the
    // 2nd, so cost is negligible.
    let allSources: LibrarySource[] = [];

    async function loadSourceCatalog(): Promise<void> {
      try {
        const r = await fetch(`${(import.meta.env.BASE_URL || "/").replace(/\/$/, "")}/library.json`);
        if (!r.ok) return;
        const blob = (await r.json()) as { sources?: Record<string, LibrarySource> };
        const map = blob.sources ?? {};
        allSources = Object.entries(map).map(([id, s]) => ({ ...s, id }));
      } catch (e) {
        console.warn("alerts: source catalog fetch failed:", e);
      }
    }

    /**
     * Wire the SourcePicker's `source-picker:pick` event to the
     * hidden form input + the "currently selected" display + the
     * current-value readout fetch. Pulled out as a helper so the
     * quick-start chip + deep-link prefill can call it
     * programmatically — they bypass the picker UI but should
     * still update the same DOM state a real pick would.
     */
    const sourceSelected = document.querySelector<HTMLElement>(
      "[data-role='alerts-source-selected']",
    );
    const sourceSelectedName = document.querySelector<HTMLElement>(
      "[data-role='alerts-source-selected-name']",
    );
    const sourceClearBtn = document.querySelector<HTMLButtonElement>(
      "[data-role='alerts-source-clear']",
    );

    function setSelectedSource(id: string, label: string): void {
      if (!sourceInput) return;
      sourceInput.value = id;
      sourceInput.dataset.label = label;
      if (sourceSelected && sourceSelectedName) {
        if (id) {
          sourceSelectedName.textContent = label || id;
          sourceSelected.hidden = false;
        } else {
          sourceSelected.hidden = true;
          sourceSelectedName.textContent = "";
        }
      }
      void refreshCurrentValue(id);
    }

    function clearSelectedSource(): void {
      setSelectedSource("", "");
      if (currentValueWrap) currentValueWrap.hidden = true;
    }

    // Listener on the picker root. The picker dispatches a bubbling
    // CustomEvent named `source-picker:pick` with detail.{sourceId,
    // source}; we transform that into our local selection state.
    const pickerRoot = document.querySelector<HTMLElement>(
      "[data-spicker-instance='alerts-source']",
    );
    pickerRoot?.addEventListener("source-picker:pick", (e) => {
      const detail = (e as CustomEvent).detail as {
        sourceId?: string;
        source?: { name?: string };
      };
      const id = detail?.sourceId ?? "";
      const label = detail?.source?.name ?? id;
      setSelectedSource(id, label);
    });

    // Clear button on the "selected" display: empties the form's
    // hidden input + hides the readout. Doesn't reset the picker's
    // filter state — the user might want to pick another source from
    // the same search.
    sourceClearBtn?.addEventListener("click", () => {
      clearSelectedSource();
    });

    // ---------- Current-value readout ----------
    // Whenever a valid source is selected, fetch its .summary.json sibling
    // and render the latest value with the source's own formatting. Lets
    // the user see at a glance whether the series ticks in "4.2" (a percent
    // already in percent terms) vs "4.2" (a count that's really 4.2
    // billion) vs "4200000000" (raw dollars) BEFORE they pick a threshold.
    //
    // Cache the in-flight fetch by id so quick source-flicking (autocomplete
    // arrowing, deep-link re-fires) doesn't stack network calls. Also cache
    // by source id to avoid refetching when the user clicks the same source.
    const summaryCache = new Map<string, SourceSummary | null>();

    async function refreshCurrentValue(sourceId: string): Promise<void> {
      if (!currentValueWrap || !currentValueReadout || !currentValueAsOf) return;
      const id = sourceId.trim();
      if (!id) {
        currentValueWrap.hidden = true;
        return;
      }
      const src = allSources.find((s) => s.id === id);
      if (!src || !src.dataFile) {
        // Either the source catalog hasn't loaded yet or the typed string
        // isn't a real ID. Stay silent rather than flash an error — the
        // user might still be mid-typing.
        currentValueWrap.hidden = true;
        return;
      }
      // Show a brief "Loading…" state while the summary fetch is in flight.
      // Important enough to make visible: lets the user know the readout
      // will show up momentarily on slow connections, rather than them
      // assuming the feature is broken.
      currentValueWrap.hidden = false;
      currentValueReadout.textContent = "loading…";
      currentValueAsOf.textContent = "";

      let summary = summaryCache.get(id);
      if (summary === undefined) {
        summary = await fetchSourceSummary(src.dataFile);
        summaryCache.set(id, summary);
      }
      // Stale-response guard: if the user typed/clicked a different source
      // between the fetch starting and it returning, abandon this render.
      // sourceInput.value is the live source of truth.
      if (sourceInput?.value.trim() !== id) return;

      if (!summary?.latest) {
        // Summary file missing or has no `latest`. Some sources (e.g. small
        // ones that haven't run through build_summaries.py yet) won't have
        // a sibling .summary.json. Show a low-key fallback rather than
        // hiding entirely — at least confirms the source matches.
        currentValueReadout.textContent = "—";
        currentValueAsOf.textContent = "no recent data";
        return;
      }
      const fmt: Formatting = src.formatting ?? {
        style: "number",
        decimals: 2,
      };
      currentValueReadout.textContent = formatValue(summary.latest.v, fmt);
      currentValueAsOf.textContent = `as of ${summary.latest.t}`;
    }

    async function fetchSourceSummary(dataFile: string): Promise<SourceSummary | null> {
      // dataFile is relative ("data/fred/CPIAUCSL_PC1.json"); the .summary
      // sibling lives next to it. Resolve against BASE_URL the same way
      // loadSourceCatalog does.
      const summaryFile = dataFile.replace(/\.json$/, ".summary.json");
      const base = (import.meta.env.BASE_URL || "/").replace(/\/$/, "");
      const url = `${base}/${summaryFile}`;
      try {
        const r = await fetch(url);
        if (!r.ok) return null;
        return (await r.json()) as SourceSummary;
      } catch {
        return null;
      }
    }

    // Note: legacy "type the full source ID" input/change listeners
    // were removed when SourcePicker took over — the hidden input no
    // longer accepts user keystrokes. All source picks now flow
    // through setSelectedSource (picker click, quick-start chip, or
    // deep-link URL ?source=<id>), which already calls
    // refreshCurrentValue.

    // ---------- Rules CRUD ----------
    async function loadRules(stored: NonNullable<ReturnType<typeof readStoredSession>>): Promise<void> {
      const r = await fetch(
        `${SUPABASE_REST_URL}/rest/v1/alert_rules?owner_id=eq.${encodeURIComponent(stored.user.id)}&select=*&order=updated_at.desc`,
        {
          headers: {
            apikey: SUPABASE_REST_ANON_KEY,
            Authorization: `Bearer ${stored.access_token}`,
          },
        },
      );
      const rows: AlertRule[] = r.ok ? await r.json() : [];
      renderRules(rows, stored);
    }

    function renderRules(rows: AlertRule[], stored: NonNullable<ReturnType<typeof readStoredSession>>): void {
      if (!rulesList) return;
      rulesList.innerHTML = "";
      if (rulesCount) rulesCount.textContent = rows.length > 0 ? `(${rows.length})` : "";

      // Auto-pause banner. Show when ANY rule has pause_reason set
      // (auto-paused). Manual pauses (paused=true, pause_reason NULL)
      // don't surface a banner — that's a deliberate user choice.
      const autoPaused = rows.filter((r) => r.paused && r.pause_reason);
      if (pauseBanner) {
        if (autoPaused.length > 0) {
          pauseBanner.hidden = false;
          if (pauseBannerCount) {
            pauseBannerCount.textContent =
              autoPaused.length === 1
                ? "1 rule was paused after repeated delivery failures."
                : `${autoPaused.length} rules were paused after repeated delivery failures.`;
          }
        } else {
          pauseBanner.hidden = true;
        }
      }

      if (rows.length === 0) {
        if (rulesEmpty) rulesEmpty.hidden = false;
        return;
      }
      if (rulesEmpty) rulesEmpty.hidden = true;
      for (const r of rows) {
        const li = document.createElement("li");
        li.className = "alerts-rule" + (r.paused ? " alerts-rule-paused" : "");
        li.dataset.ruleId = r.id;
        // Distinguish auto-pause (pause_reason text) from manual
        // pause (paused=true, pause_reason NULL). Auto-pause shows
        // the reason text + a different border tint via the
        // -autopaused modifier class.
        const isAutoPaused = r.paused && !!r.pause_reason;
        if (isAutoPaused) li.classList.add("alerts-rule-autopaused");
        li.innerHTML = `
          <div class="alerts-rule-main">
            <div class="alerts-rule-label">${escapeHtml(r.label || defaultRuleLabel(r))}</div>
            <div class="alerts-rule-source">
              <a href="${(import.meta.env.BASE_URL || "/").replace(/\/$/, "")}/source/${escapeAttr(r.source_id)}/" class="alerts-rule-source-link">${escapeHtml(r.source_label)}</a>
              <span class="alerts-rule-condition mono">${escapeHtml(conditionPhrase(r))}</span>
            </div>
            <div class="alerts-rule-meta muted small">
              ${r.last_value_seen !== null && r.last_value_t ? `last value ${escapeHtml(String(r.last_value_seen))} on ${escapeHtml(r.last_value_t)}. ` : "Not yet evaluated. "}
              ${r.last_triggered_at ? `last fired ${escapeHtml(r.last_triggered_at.slice(0, 10))}.` : "Never fired."}
            </div>
            ${
              isAutoPaused && r.pause_reason
                ? `<div class="alerts-rule-pause-reason">${escapeHtml(r.pause_reason)}</div>`
                : ""
            }
          </div>
          <div class="alerts-rule-actions">
            <button type="button" data-action="toggle-pause" class="alerts-rule-action">${r.paused ? "Resume" : "Pause"}</button>
            <button type="button" data-action="delete" class="alerts-rule-action alerts-rule-action-danger">Delete</button>
          </div>
        `;
        rulesList.appendChild(li);
      }
      rulesList.querySelectorAll<HTMLButtonElement>("button[data-action]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const li = btn.closest<HTMLElement>(".alerts-rule");
          if (!li) return;
          const id = li.dataset.ruleId ?? "";
          const action = btn.dataset.action;
          if (action === "delete") {
            if (!confirm("Delete this alert rule? The trigger history is preserved.")) return;
            await fetch(`${SUPABASE_REST_URL}/rest/v1/alert_rules?id=eq.${encodeURIComponent(id)}`, {
              method: "DELETE",
              headers: {
                apikey: SUPABASE_REST_ANON_KEY,
                Authorization: `Bearer ${stored.access_token}`,
              },
            });
            await loadRules(stored);
          } else if (action === "toggle-pause") {
            const currentlyPaused = li.classList.contains("alerts-rule-paused");
            // Resuming clears BOTH paused and pause_reason (a manual
            // resume erases any auto-pause history). Pausing leaves
            // pause_reason alone — a manual pause has no reason text.
            const body = currentlyPaused
              ? { paused: false, pause_reason: null }
              : { paused: true };
            await fetch(`${SUPABASE_REST_URL}/rest/v1/alert_rules?id=eq.${encodeURIComponent(id)}`, {
              method: "PATCH",
              headers: {
                apikey: SUPABASE_REST_ANON_KEY,
                Authorization: `Bearer ${stored.access_token}`,
                "Content-Type": "application/json",
                Prefer: "return=minimal",
              },
              body: JSON.stringify(body),
            });
            await loadRules(stored);
          }
        });
      });
    }

    function defaultRuleLabel(r: AlertRule): string {
      return `${r.source_label} ${conditionPhrase(r)}`;
    }
    function conditionPhrase(r: AlertRule): string {
      const t = r.threshold;
      switch (r.condition) {
        case "gt": return `> ${t}`;
        case "gte": return `≥ ${t}`;
        case "lt": return `< ${t}`;
        case "lte": return `≤ ${t}`;
        case "crosses_above": return `crosses above ${t}`;
        case "crosses_below": return `crosses below ${t}`;
        case "change_above": return `|Δ| > ${t}`;
        default: return `${r.condition} ${t}`;
      }
    }

    // ---------- Trigger feed ----------
    async function loadTriggers(stored: NonNullable<ReturnType<typeof readStoredSession>>): Promise<void> {
      const r = await fetch(
        `${SUPABASE_REST_URL}/rest/v1/alert_triggers?owner_id=eq.${encodeURIComponent(stored.user.id)}&select=*&order=triggered_at.desc&limit=50`,
        {
          headers: {
            apikey: SUPABASE_REST_ANON_KEY,
            Authorization: `Bearer ${stored.access_token}`,
          },
        },
      );
      const rows: AlertTrigger[] = r.ok ? await r.json() : [];
      renderTriggers(rows, stored);
    }

    function notifyStatus(t: AlertTrigger): { label: string; cls: string } {
      // Three states based on notified_at:
      //   null            → "pending" (queued for next dispatch)
      //   sentinel epoch  → "delivery failed" (dispatcher gave up)
      //   anything else   → "delivered <date>"
      if (!t.notified_at) {
        return { label: "queued", cls: "alerts-status-queued" };
      }
      if (t.notified_at.startsWith(NOTIFIED_DROPPED_SENTINEL)) {
        return { label: "delivery failed", cls: "alerts-status-failed" };
      }
      return {
        label: `emailed ${t.notified_at.slice(0, 10)}`,
        cls: "alerts-status-sent",
      };
    }

    function renderTriggers(
      rows: AlertTrigger[],
      stored: NonNullable<ReturnType<typeof readStoredSession>>,
    ): void {
      if (!feedList) return;
      feedList.innerHTML = "";
      if (feedCount) feedCount.textContent = rows.length > 0 ? `(${rows.length})` : "";
      const unread = rows.filter((t) => !t.acknowledged);
      if (markAllRead) markAllRead.hidden = unread.length === 0;
      if (rows.length === 0) {
        if (feedEmpty) feedEmpty.hidden = false;
        return;
      }
      if (feedEmpty) feedEmpty.hidden = true;
      for (const t of rows) {
        const li = document.createElement("li");
        li.className = "alerts-trigger" + (t.acknowledged ? " alerts-trigger-ack" : "");
        li.dataset.triggerId = t.id;
        const status = notifyStatus(t);
        li.innerHTML = `
          <div class="alerts-trigger-when">${escapeHtml(t.triggered_at.slice(0, 10))}</div>
          <div class="alerts-trigger-main">
            <div class="alerts-trigger-headline">
              <strong>${escapeHtml(t.source_label)}</strong>
              <span class="mono">${escapeHtml(t.condition)} ${escapeHtml(String(t.threshold))}</span>
              → observed <strong>${escapeHtml(String(t.observed_value))}</strong>
              on ${escapeHtml(t.observed_t)}
            </div>
            <div class="alerts-trigger-meta muted small">
              <span class="alerts-status ${status.cls}">${escapeHtml(status.label)}</span>
              ${t.notify_error && t.notified_at && t.notified_at.startsWith(NOTIFIED_DROPPED_SENTINEL) ? `<span class="alerts-status-detail" title="${escapeAttr(t.notify_error)}">— ${escapeHtml(t.notify_error.slice(0, 80))}${t.notify_error.length > 80 ? "…" : ""}</span>` : ""}
            </div>
          </div>
          <div class="alerts-trigger-actions">
            ${t.acknowledged ? '<span class="alerts-trigger-ack-tag muted small">read</span>' : '<button type="button" class="alerts-trigger-action" data-action="ack">Mark read</button>'}
          </div>
        `;
        feedList.appendChild(li);
      }
      feedList.querySelectorAll<HTMLButtonElement>("button[data-action='ack']").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const li = btn.closest<HTMLElement>(".alerts-trigger");
          if (!li) return;
          const id = li.dataset.triggerId ?? "";
          // Optimistic UI: gray the row immediately so a slow PATCH
          // doesn't make the click feel unresponsive. loadTriggers()
          // resyncs the truth shortly.
          li.classList.add("alerts-trigger-ack");
          btn.disabled = true;
          try {
            await fetch(`${SUPABASE_REST_URL}/rest/v1/alert_triggers?id=eq.${encodeURIComponent(id)}`, {
              method: "PATCH",
              headers: {
                apikey: SUPABASE_REST_ANON_KEY,
                Authorization: `Bearer ${stored.access_token}`,
                "Content-Type": "application/json",
                Prefer: "return=minimal",
              },
              body: JSON.stringify({ acknowledged: true }),
            });
          } finally {
            await loadTriggers(stored);
          }
        });
      });
    }

    async function markAllReadHandler(
      stored: NonNullable<ReturnType<typeof readStoredSession>>,
    ): Promise<void> {
      // Bulk PATCH every unread trigger for this owner. PostgREST's
      // filter syntax lets us update many rows in a single request
      // (owner_id eq + acknowledged eq false) — much cheaper than
      // per-row PATCHes when a long batch went out and the user
      // clicks "mark all read" once.
      if (!markAllRead) return;
      markAllRead.disabled = true;
      try {
        await fetch(
          `${SUPABASE_REST_URL}/rest/v1/alert_triggers?owner_id=eq.${encodeURIComponent(stored.user.id)}&acknowledged=eq.false`,
          {
            method: "PATCH",
            headers: {
              apikey: SUPABASE_REST_ANON_KEY,
              Authorization: `Bearer ${stored.access_token}`,
              "Content-Type": "application/json",
              Prefer: "return=minimal",
            },
            body: JSON.stringify({ acknowledged: true }),
          },
        );
      } finally {
        markAllRead.disabled = false;
        await loadTriggers(stored);
      }
    }

    // ---------- Add-rule form ----------
    function wireForm(stored: NonNullable<ReturnType<typeof readStoredSession>>): void {
      form?.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!sourceInput || !conditionSelect || !thresholdInput || !labelInput || !addMsg) return;
        const sourceId = sourceInput.value.trim();
        const threshold = parseFloat(thresholdInput.value);
        if (!sourceId || !Number.isFinite(threshold)) {
          addMsg.textContent = "Need a source and a numeric threshold.";
          return;
        }
        const sourceLabel =
          sourceInput.dataset.label ??
          allSources.find((s) => s.id === sourceId)?.name ??
          sourceId;
        addMsg.textContent = "Saving…";
        const res = await fetch(`${SUPABASE_REST_URL}/rest/v1/alert_rules`, {
          method: "POST",
          headers: {
            apikey: SUPABASE_REST_ANON_KEY,
            Authorization: `Bearer ${stored.access_token}`,
            "Content-Type": "application/json",
            Prefer: "return=minimal",
          },
          body: JSON.stringify({
            owner_id: stored.user.id,
            source_id: sourceId,
            source_label: sourceLabel,
            condition: conditionSelect.value,
            threshold,
            label: labelInput.value.trim() || null,
          }),
        });
        if (res.ok) {
          addMsg.textContent = "Saved.";
          // Use clearSelectedSource so the "selected" display hides
          // alongside the hidden input + current-value readout reset.
          // Doesn't clear the picker's filter state — the user might
          // want to add a second alert on a related source from the
          // same search.
          clearSelectedSource();
          thresholdInput.value = "";
          labelInput.value = "";
          setTimeout(() => {
            if (addMsg) addMsg.textContent = "";
          }, 2000);
          await loadRules(stored);
        } else {
          addMsg.textContent = `Failed to save: HTTP ${res.status}`;
        }
      });
    }

    // Quick-start chip handler. Reads data attributes off the
    // clicked button and pre-fills the add-rule form. Doesn't auto-
    // submit — the user still has to click "Add rule" to confirm
    // (lets them tweak the threshold or condition first).
    function wireQuickStart(): void {
      const chips = document.querySelectorAll<HTMLButtonElement>(
        "[data-role='alerts-quickstart'] .alerts-quickstart-chip",
      );
      chips.forEach((chip) => {
        chip.addEventListener("click", () => {
          // Use the shared setter so the hidden input + "selected"
          // display + current-value readout all update together.
          // Same path the picker click takes — keeps the two flows
          // observably identical.
          setSelectedSource(
            chip.dataset.source ?? "",
            chip.dataset.sourceLabel ?? "",
          );
          if (conditionSelect) {
            conditionSelect.value = chip.dataset.condition ?? "gte";
          }
          if (thresholdInput) {
            thresholdInput.value = chip.dataset.threshold ?? "";
          }
          if (labelInput) {
            labelInput.value = chip.dataset.label ?? "";
          }
          // Scroll the form into view so the user sees the
          // pre-filled fields immediately.
          form?.scrollIntoView({ behavior: "smooth", block: "start" });
        });
      });
    }

    function escapeHtml(s: string): string {
      return s
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
    }
    function escapeAttr(s: string): string {
      return escapeHtml(s);
    }
  </script>
</BaseLayout>

