---
/**
 * /welcome/ — alternative landing page for Substack-driven traffic.
 *
 * The current "/" home page is heavy: it server-renders a full
 * featured-dashboard preview (one preset, fully resolved with ~30
 * tiles). That's the right move for returning visitors and SEO/OG
 * unfurls but it's also a lot for a first-time visitor wondering
 * "what IS this." This page is a leaner pitch — hero, three use-case
 * cards, a data-coverage grid, newsletter signup — without the
 * preset-dashboard inline render. Built so we can A/B it against
 * "/" without throwing away the existing home page.
 *
 * Anonymous-only by design. There's no signed-in branch here — the
 * regular "/" handles that flow. /welcome/ is the front door for
 * "I just clicked a Substack link" landings.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import EmailSignup from "../components/EmailSignup.astro";
import {
  WALKTHROUGH_DASHBOARD_SLUG,
  ENTERPRISE_INQUIRY_URL,
} from "../lib/brand";

export const prerender = true;

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

/**
 * Coverage grid content — hand-curated rather than derived from
 * library.json because:
 *   - The library has ~10k sources; auto-grouping them produces a
 *     wall of links, not a digestible category overview.
 *   - The hand-picked examples are the strongest sources per
 *     category, which is what advertises tape best.
 *   - Adding a new pipeline shouldn't silently change this grid.
 *
 * If a source ID here is renamed / removed, the link 404s. Acceptable
 * tradeoff for editorial control; the smoke test would catch a 404
 * on /source/<id>/ before it shipped to prod.
 */
interface CoverageItem {
  label: string;
  /** Optional canonical source page to navigate to via "Open full
   *  source page →" when the user wants more depth than the inline
   *  embed shows. Left undefined when the source is choropleth-only
   *  (no time-series source page applies). */
  sourceHref?: string;
  /** Chart ID for the inline embed iframe (/embed/chart/<id>/).
   *  Every chip carries one — the click handler swaps the iframe's
   *  src to this value so the chart renders inline without
   *  navigating away. */
  chartId: string;
}
interface CoverageCategory {
  title: string;
  blurb: string;
  items: CoverageItem[];
}
const COVERAGE: CoverageCategory[] = [
  {
    title: "US macro",
    blurb: "Inflation, rates, employment, output — the standard headline series, daily/monthly/quarterly as they update.",
    items: [
      { label: "CPI year-over-year", sourceHref: "/source/fred/cpi_yoy/", chartId: "us-macro/cpi" },
      { label: "Federal funds rate", sourceHref: "/source/fred/fed_funds/", chartId: "us-macro/fed_funds" },
      { label: "US unemployment rate", sourceHref: "/source/fred/us_unemployment/", chartId: "us-macro/unemployment" },
      { label: "Real GDP", sourceHref: "/source/fred/us_real_gdp/", chartId: "us-macro/real_gdp" },
      { label: "10-year Treasury yield", sourceHref: "/source/fred/us_10y/", chartId: "us-macro/ten_year" },
      { label: "S&P 500", sourceHref: "/source/fred/sp500/", chartId: "us-macro/sp500" },
    ],
  },
  {
    title: "Federal fiscal",
    blurb: "Outlook reports, the long arc of debt + deficits, social-insurance trustee projections.",
    items: [
      { label: "Federal debt (% of GDP)", sourceHref: "/source/fred/federal_debt_pct_gdp/", chartId: "government/federal_debt_pct_gdp" },
      { label: "Federal deficit (% of GDP)", sourceHref: "/source/fred/federal_deficit_pct_gdp/", chartId: "government/federal_deficit_pct_gdp" },
      { label: "Federal interest cost (% of GDP)", sourceHref: "/source/fred/federal_interest_pct_gdp/", chartId: "government/federal_interest_pct_gdp" },
      { label: "CBO budget outlook (revenues)", sourceHref: "/source/cbo/cbo_revenues_pct_gdp/", chartId: "government/cbo_revenues_pct_gdp" },
      { label: "SSA trust fund (cost % of GDP)", sourceHref: "/source/ssa/oasdi_income_pct_gdp/", chartId: "government/ssa_oasdi_cost_pct_gdp" },
    ],
  },
  {
    title: "Markets",
    blurb: "Volatility, futures curves, commodities — the things the desk has to write about when something breaks.",
    items: [
      { label: "VIX", sourceHref: "/source/fred/vix/", chartId: "us-macro/vix" },
      { label: "WTI crude futures curve", sourceHref: "/source/yahoo_futures/wti_curve/", chartId: "energy/wti_curve" },
      { label: "Brent crude futures curve", sourceHref: "/source/yahoo_futures/brent_curve/", chartId: "energy/brent_curve" },
      { label: "Henry Hub natgas curve", sourceHref: "/source/yahoo_futures/natgas_curve/", chartId: "energy/natgas_curve" },
      { label: "Corn futures curve", sourceHref: "/source/yahoo_futures/corn_curve/", chartId: "agriculture/corn_curve" },
    ],
  },
  {
    title: "Geographic",
    blurb: "All 435 congressional districts, all 50 states + DC, 393 US metros, plus ~50 countries. Some surface as bar snapshots (federal-spending breakdowns), others as line tiles, the choropleth-only ones live on the Maps tab in the composer.",
    items: [
      { label: "Federal spending by state (top 10)", sourceHref: "/source/usaspending/state_va/", chartId: "government/federal_spending_by_state_top10" },
      { label: "Per-CD spending (VA-08 in context)", sourceHref: "/source/usaspending/district_va_08/", chartId: "government/va_08_federal_spending" },
      { label: "Metro unemployment (DC area vs US)", sourceHref: "/source/bls/metro_unemployment_47900/", chartId: "government/dc_metro_unemployment_vs_us" },
      { label: "World Bank GDP (Germany shown)", sourceHref: "/source/worldbank_gdp_raw/germany/", chartId: "countries/germany" },
    ],
  },
  {
    title: "Stocks",
    blurb: "Market-cap-adjusted price history (SEC EDGAR + Yahoo) for the names that matter to the macro picture.",
    items: [
      { label: "Tesla", sourceHref: "/source/yahoo_marketcap/tsla_mc/", chartId: "stocks/tsla" },
      { label: "ExxonMobil vs WTI", sourceHref: "/source/yahoo_marketcap/xom_mc/", chartId: "stocks/xom_vs_wti" },
      { label: "Chevron vs WTI", chartId: "stocks/cvx_vs_wti" },
      { label: "Berkshire (Class B)", chartId: "stocks/brk_b" },
      { label: "JPMorgan", chartId: "stocks/jpm" },
    ],
  },
];

/**
 * Use-case cards. Three concrete actions the audience already knows
 * how to want — they don't need to be sold on what a dashboard IS,
 * they need to be sold on what Tape lets them DO with one.
 */
interface UseCase {
  eyebrow: string;
  title: string;
  body: string;
  cta: { label: string; href: string };
}
const USE_CASES: UseCase[] = [
  {
    eyebrow: "Compose",
    title: "Build a dashboard for your beat.",
    body: "Pick sources, combine A÷B / A+B / A−B as derived series, tag annotations on key dates (Lehman, COVID, Fed pivot), layer NBER recession bands or party-control shading, switch the y-axis between Level / YoY % / Index=100. Save at a stable URL — no code, no spreadsheet round-trip.",
    cta: { label: "Open the walkthrough", href: "/walkthrough/" },
  },
  {
    eyebrow: "Cite",
    title: "Drop a chart into a piece.",
    body: "Every source carries a citation block — provider, series ID, license, and last-updated date — plus a one-line APA-style citation and a copy-paste iframe embed that updates automatically as the data refreshes.",
    cta: { label: "See a source page", href: "/source/fred/cpi_yoy/" },
  },
  {
    eyebrow: "Alert",
    title: "Get told when CPI ticks above 4%.",
    body: "Set thresholds on any indicator we ship — greater-than, crosses-above, crosses-below, absolute change. We evaluate after every data refresh and email you on the cross. Auto-pauses gracefully if delivery starts failing.",
    cta: { label: "Set up an alert", href: "/alerts/" },
  },
];

/**
 * Render-type showcase: three small embedded charts demonstrating the
 * shapes data takes on Tape. Picked deliberately so each one looks
 * obviously different from the others — line is the daily/monthly
 * arc, bar is "where it stands today, ranked," choropleth is "how it
 * varies across geography." A reader scanning down the page sees
 * three render shapes and gets the breadth-of-render signal in
 * about three seconds.
 */
interface RenderShowcase {
  label: string;
  blurb: string;
  chartId: string;
  chartHref: string;
}
const RENDER_SHOWCASE: RenderShowcase[] = [
  {
    label: "Time series",
    blurb: "Daily / monthly / quarterly. Tile shows level + delta over the picked window; click to expand into the dialog with pills, sources, annotations.",
    chartId: "us-macro/cpi",
    chartHref: "/chart/us-macro/cpi/",
  },
  {
    label: "Bar snapshot",
    blurb: "Same data, at one moment in time. Horizontal or vertical, sorted descending by default. Good for ranking — who's spending the most, what's growing the fastest, where it lands today.",
    chartId: "countries/gdp_snapshot",
    chartHref: "/chart/countries/gdp_snapshot/",
  },
  {
    label: "Choropleth",
    blurb: "Cross-sectional geographic variation. State, county, tract, or block-group level, ACS demographics or any source the choropleth pipeline emits.",
    chartId: "government/us_bachelors_plus_pct_county_map_2022",
    chartHref: "/chart/government/us_bachelors_plus_pct_county_map_2022/",
  },
];

/**
 * Editorial-layer feature pills shown above the render showcase.
 * Reads as a compressed list of "what makes a Tape chart different
 * from a bare FRED screenshot." None of these are individually
 * differentiating, but the combination of them is.
 */
const EDITORIAL_FEATURES: string[] = [
  "Editorial annotations",
  "Background shading (recessions, party control, Fed chairs)",
  "Dual-axis multi-source",
  "Derived A÷B / A+B / A−B sources",
  "Y-axis transforms (Level / YoY % / Index=100)",
  "Window pills 1m → 50y",
  "Indicator alerts on threshold-cross",
  "Iframe embeds with live refresh",
];
---

<BaseLayout
  title="Tape — citation-ready charts of the US economy"
  description="Free, source-linked charts of the US economy, all 435 congressional districts, 393 US metros, and ~50 countries. Built for analysts, journalists, and policy staff."
>
  <main class="welcome">
    {/* Hero */}
    <section class="welcome-hero">
      <p class="welcome-eyebrow">Tape</p>
      <h1 class="welcome-title">
        Charts you can cite.
      </h1>
      <p class="welcome-pitch">
        Free, source-linked charts of the US economy, all 435 congressional
        districts, 393 US metros, and the rest of the world. Built for analysts,
        journalists, and policy staff who have to write the memo by Monday — every
        chart shows the level and the move, every source is citable, every dashboard
        is a URL you can paste into a draft.
      </p>
      <p class="welcome-cta-row">
        <a href={`${baseUrl}/compose/`} class="welcome-cta-primary">
          Build a dashboard &rarr;
        </a>
        <a href={ENTERPRISE_INQUIRY_URL} class="welcome-cta-secondary">
          For organizations &rarr;
        </a>
      </p>
      <p class="welcome-walkthrough-line">
        New here? <a href={`${baseUrl}/${WALKTHROUGH_DASHBOARD_SLUG}/`}>Take the 5-minute tour</a> — every Tape feature in one annotated dashboard.
      </p>
    </section>

    {/* Use-case cards */}
    <section class="welcome-use-cases">
      <p class="welcome-section-eyebrow">What you can do</p>
      <div class="welcome-use-grid">
        {USE_CASES.map((u) => (
          <article class="welcome-use-card">
            <p class="welcome-use-eyebrow">{u.eyebrow}</p>
            <h3 class="welcome-use-title">{u.title}</h3>
            <p class="welcome-use-body">{u.body}</p>
            <a href={`${baseUrl}${u.cta.href}`} class="welcome-use-cta">
              {u.cta.label} &rarr;
            </a>
          </article>
        ))}
      </div>
    </section>

    {/*
      Feature showcase — what a Tape chart actually looks like and what
      it carries that a bare FRED screenshot doesn't. Two parts:
        1. A row of editorial-feature pills (text-only) — the
           combination signal: not any one of these is differentiating,
           but the stack of them is.
        2. A 3-up grid of live embed iframes showing three render
           types (line / bar / choropleth). Each is the production
           /embed/chart/<id>/ endpoint, which means the same iframe
           handshake we use for the coverage chips applies here too —
           clicking a tile pops it OUT to the welcome-page viewport
           rather than opening a cramped in-iframe dialog.
    */}
    <section class="welcome-features-render" aria-labelledby="features-render-heading">
      <p class="welcome-section-eyebrow">What a Tape chart can do</p>
      <h2 id="features-render-heading" class="welcome-section-heading">
        Editorial layers, multiple render types.
      </h2>
      <p class="welcome-section-sub">
        Each chart carries the moves you'd want to make in a piece —
        annotations, recession bands, derived series, transforms,
        window pills — plus the right shape for the question. Live
        embeds below; click any one to pop it out.
      </p>
      <ul class="welcome-features-pills" aria-label="Editorial features available on every chart">
        {EDITORIAL_FEATURES.map((feature) => (
          <li class="welcome-features-pill">{feature}</li>
        ))}
      </ul>
      <div class="welcome-render-grid">
        {RENDER_SHOWCASE.map((r) => (
          <figure class="welcome-render-card">
            <figcaption class="welcome-render-caption">
              <p class="welcome-render-label">{r.label}</p>
              <p class="welcome-render-blurb">{r.blurb}</p>
            </figcaption>
            <iframe
              class="welcome-render-iframe"
              src={`${baseUrl}/embed/chart/${r.chartId}/`}
              title={`${r.label} example chart`}
              loading="lazy"
            ></iframe>
            <a
              class="welcome-render-link"
              href={`${baseUrl}${r.chartHref}`}
            >
              Open full chart &rarr;
            </a>
          </figure>
        ))}
      </div>
    </section>

    {/* Coverage grid */}
    <section class="welcome-coverage">
      <p class="welcome-section-eyebrow">What's covered</p>
      <h2 class="welcome-section-heading">
        A few representative series at each level.
      </h2>
      <p class="welcome-section-sub">
        The full library is ~10,000 sources. Click any chip to land on its source page — provenance,
        last-updated date, related charts, citation block.
      </p>
      <div class="welcome-coverage-grid">
        {COVERAGE.map((cat) => (
          <article class="welcome-coverage-card">
            <h3 class="welcome-coverage-title">{cat.title}</h3>
            <p class="welcome-coverage-blurb">{cat.blurb}</p>
            <ul class="welcome-coverage-list">
              {cat.items.map((item) => (
                <li>
                  {/*
                    Chips are <button>s (not <a>s) because clicking
                    them swaps the inline preview iframe rather than
                    navigating. The data-source-href carries the
                    fallback "open the full source page" URL the
                    preview region exposes after the iframe loads —
                    keeps the source-page link discoverable for users
                    who want the full citation block and metadata.
                  */}
                  <button
                    type="button"
                    class="welcome-coverage-chip"
                    data-chart-id={item.chartId}
                    data-source-href={item.sourceHref ? `${baseUrl}${item.sourceHref}` : ""}
                    data-label={item.label}
                  >
                    {item.label}
                  </button>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>

      {/*
        Inline chart-preview region. Empty by default; populated when
        the user clicks any chip. The iframe target is /embed/chart/
        <id>/ — Astro's chart-embed route renders a single tile sized
        to fill the iframe. Bar charts show as a horizontal-or-
        vertical snapshot, choropleth charts show as a map, ordinary
        time series show as a sparkline-plus-readout tile. So "card
        or map" depending on the chart's render type, no extra
        branching needed here.
      */}
      <div class="welcome-coverage-preview" data-role="coverage-preview" hidden>
        <div class="welcome-coverage-preview-head">
          <p class="welcome-coverage-preview-label" data-role="coverage-preview-label"></p>
          <a
            href="#"
            class="welcome-coverage-preview-source"
            data-role="coverage-preview-source"
            target="_blank"
            rel="noopener"
          >
            Open the full source page &rarr;
          </a>
        </div>
        <iframe
          class="welcome-coverage-iframe"
          data-role="coverage-iframe"
          src="about:blank"
          loading="lazy"
          title="Inline chart preview"
        ></iframe>
      </div>
    </section>

    <script>
      // Coverage-grid inline preview. Click a chip → iframe shows
      // /embed/chart/<id>/. Clicking another chip swaps the src.
      // Clicking the SAME chip toggles the preview closed (small
      // UX nicety: lets the user dismiss what they just opened).
      const baseUrl = (import.meta.env.BASE_URL || "/").replace(/\/$/, "");
      const previewBox = document.querySelector<HTMLElement>(
        "[data-role='coverage-preview']",
      );
      const iframe = document.querySelector<HTMLIFrameElement>(
        "[data-role='coverage-iframe']",
      );
      const labelEl = document.querySelector<HTMLElement>(
        "[data-role='coverage-preview-label']",
      );
      const sourceLink = document.querySelector<HTMLAnchorElement>(
        "[data-role='coverage-preview-source']",
      );
      let activeChartId: string | null = null;
      document.querySelectorAll<HTMLButtonElement>(".welcome-coverage-chip").forEach((chip) => {
        chip.addEventListener("click", () => {
          const chartId = chip.dataset.chartId ?? "";
          const sourceHref = chip.dataset.sourceHref ?? "";
          const label = chip.dataset.label ?? "";
          if (!chartId || !previewBox || !iframe) return;
          // Same chip toggled twice → close the preview.
          if (activeChartId === chartId && !previewBox.hidden) {
            previewBox.hidden = true;
            iframe.src = "about:blank";
            activeChartId = null;
            // Drop the chip's pressed state.
            document
              .querySelectorAll<HTMLButtonElement>(".welcome-coverage-chip-active")
              .forEach((el) => el.classList.remove("welcome-coverage-chip-active"));
            return;
          }
          // Otherwise: swap iframe to the new chart and update the
          // surrounding chrome (label, source link, active highlight).
          iframe.src = `${baseUrl}/embed/chart/${chartId}/`;
          if (labelEl) labelEl.textContent = label;
          if (sourceLink) {
            if (sourceHref) {
              sourceLink.href = sourceHref;
              sourceLink.style.display = "";
            } else {
              // Choropleth-only / chart-only chips don't have a source
              // page; hide the "Open source" link rather than 404.
              sourceLink.style.display = "none";
            }
          }
          previewBox.hidden = false;
          activeChartId = chartId;
          document
            .querySelectorAll<HTMLButtonElement>(".welcome-coverage-chip-active")
            .forEach((el) => el.classList.remove("welcome-coverage-chip-active"));
          chip.classList.add("welcome-coverage-chip-active");
          // Scroll just enough to bring the preview into view; nearest
          // keeps the chips visible above when possible. Respect the
          // user's prefers-reduced-motion setting — vestibular-
          // sensitive users get an instant jump instead of a slide.
          const prefersReduced = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
          ).matches;
          previewBox.scrollIntoView({
            behavior: prefersReduced ? "auto" : "smooth",
            block: "nearest",
          });
        });
      });

      // ---- Pop-out overlay (same-origin embed messaging) ----
      // The embed iframe sends "tape:embed-handshake" on load; we
      // respond "tape:host-ack" so the iframe knows we'll handle
      // pop-outs. On tile click the iframe then posts "tape:embed-
      // popout" with a chart href; we load it in the overlay's
      // own iframe at the welcome page's viewport size.
      //
      // origin-check both sides: only react to messages from the
      // SAME origin (sender always sets targetOrigin to our origin,
      // so cross-site iframes never round-trip here).
      const popoutOverlay = document.querySelector<HTMLElement>(
        "[data-role='popout-overlay']",
      );
      const popoutIframe = document.querySelector<HTMLIFrameElement>(
        "[data-role='popout-iframe']",
      );
      const popoutClose = document.querySelector<HTMLButtonElement>(
        "[data-role='popout-close']",
      );

      // Track the element that had focus when the popout opened so we
      // can hand focus back on close — keeps keyboard users anchored
      // to where they were instead of dumping them at <body>.
      let popoutLastFocus: HTMLElement | null = null;
      function openPopout(chartHref: string): void {
        if (!popoutOverlay || !popoutIframe) return;
        popoutLastFocus = document.activeElement as HTMLElement | null;
        popoutIframe.src = chartHref;
        popoutOverlay.hidden = false;
        // Lock the underlying welcome page so the reader can't scroll
        // it while the overlay's open. Restored on close.
        document.body.style.overflow = "hidden";
        // Defer focus until next tick so the hidden=false has taken
        // effect — focus() on a still-hidden element no-ops in some
        // browsers.
        requestAnimationFrame(() => popoutClose?.focus());
      }
      function closePopout(): void {
        if (!popoutOverlay || !popoutIframe) return;
        popoutOverlay.hidden = true;
        popoutIframe.src = "about:blank";
        document.body.style.overflow = "";
        // Restore focus to whoever had it before — typically the
        // chip the user just clicked. Use optional chaining: if the
        // saved element vanished (DOM change), just no-op.
        popoutLastFocus?.focus?.();
        popoutLastFocus = null;
      }

      window.addEventListener("message", (e) => {
        // Strict origin check: ignore everything not from us.
        if (e.origin !== window.location.origin) return;
        const data = e.data as
          | { type?: string; chartId?: string; chartHref?: string }
          | undefined;
        if (!data?.type) return;
        if (data.type === "tape:embed-handshake") {
          // Reply directly to the sender frame, not broadcast.
          (e.source as Window | null)?.postMessage(
            { type: "tape:host-ack" },
            e.origin,
          );
          return;
        }
        if (data.type === "tape:embed-popout" && data.chartHref) {
          openPopout(data.chartHref);
        }
      });

      popoutClose?.addEventListener("click", closePopout);
      // Click outside the modal iframe (on the dimming backdrop) closes.
      popoutOverlay?.addEventListener("click", (e) => {
        if (e.target === popoutOverlay) closePopout();
      });
      // Esc closes — standard expected behavior for modal overlays.
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && popoutOverlay && !popoutOverlay.hidden) {
          closePopout();
        }
      });

      // ---- Idle-time prefetch of coverage-chip embed pages ----
      //
      // Each coverage chip swaps the inline preview iframe's src to
      // /embed/chart/<id>/ when clicked — an SSR endpoint that has
      // ~200-500ms of cold-function latency on Vercel. Without help,
      // clicking a chip blocks on that roundtrip and the chart appears
      // a beat after the user expects.
      //
      // Inject <link rel="prefetch"> for each chip's embed URL once
      // the main page has settled. The browser fetches them in idle
      // time, caches the response, and a later iframe.src = same URL
      // pulls from cache instead of hitting the function. Click-to-
      // chart drops to ~tens-of-ms.
      //
      // requestIdleCallback would only fire when the main thread is
      // idle — perfect for this kind of non-blocking warm-up. Falls
      // back to setTimeout on Safari (no idle-callback support).
      //
      // Pointer-enter + focus also trigger an immediate prefetch for
      // any chip that the idle pass hasn't covered yet: covers fast
      // clickers and slow connections where idle is still draining.
      const prefetchedEmbeds = new Set<string>();
      function prefetchEmbed(chartId: string): void {
        if (!chartId || prefetchedEmbeds.has(chartId)) return;
        prefetchedEmbeds.add(chartId);
        const link = document.createElement("link");
        link.rel = "prefetch";
        link.href = `${baseUrl}/embed/chart/${chartId}/`;
        // `as=document` tells the browser to treat this as a top-
        // level HTML doc fetch (matching what the iframe will do),
        // so the cached response is reused correctly.
        link.setAttribute("as", "document");
        document.head.appendChild(link);
      }
      function bulkPrefetchChips(): void {
        document
          .querySelectorAll<HTMLButtonElement>(".welcome-coverage-chip")
          .forEach((chip) => {
            const id = chip.dataset.chartId;
            if (id) prefetchEmbed(id);
          });
      }
      const ric = (window as unknown as {
        requestIdleCallback?: (cb: () => void, opts?: { timeout?: number }) => void;
      }).requestIdleCallback;
      if (ric) {
        ric(bulkPrefetchChips, { timeout: 5000 });
      } else {
        setTimeout(bulkPrefetchChips, 1500);
      }
      document
        .querySelectorAll<HTMLButtonElement>(".welcome-coverage-chip")
        .forEach((chip) => {
          const id = chip.dataset.chartId;
          if (!id) return;
          const trigger = () => prefetchEmbed(id);
          chip.addEventListener("pointerenter", trigger, { once: true });
          chip.addEventListener("focus", trigger, { once: true });
        });
    </script>

    {/*
      Pop-out overlay for the coverage chart preview. The embed
      iframes on this page send a "tape:embed-popout" message when
      their tile is clicked; this overlay's listener catches it and
      loads the canonical /chart/<id>/ page in a fullscreen iframe,
      so the reader gets the dialog UI at the welcome page's
      viewport instead of squeezed into the 380px preview iframe.
      Same-origin only — Substack / newsletter / cross-origin
      embeds fall back to opening /chart/<id>/ in a new tab,
      handled by the embed page's script (no parent ack → new tab).
    */}
    <div
      class="welcome-popout-overlay"
      data-role="popout-overlay"
      role="dialog"
      aria-modal="true"
      aria-label="Expanded chart"
      hidden
    >
      <button
        type="button"
        class="welcome-popout-close"
        data-role="popout-close"
        aria-label="Close chart"
        title="Close (Esc)"
      >&times;</button>
      <iframe
        class="welcome-popout-iframe"
        data-role="popout-iframe"
        src="about:blank"
        title="Expanded chart view"
      ></iframe>
    </div>

    {/* Newsletter signup — quiet, low-friction. Anonymous visitors
        who aren't ready to compose / sign in can still leave their
        email and hear when new sources land. */}
    <section class="welcome-newsletter">
      <EmailSignup
        variant="banner"
        source="welcome-page"
        title="Hear when new data sources land."
        blurb="Monthly-ish updates. New features, new chart sources, the occasional analysis. No spam, easy to unsubscribe."
      />
    </section>
  </main>
</BaseLayout>

