---
/**
 * /welcome/ — alternative landing page for Substack-driven traffic.
 *
 * The current "/" home page is heavy: it server-renders a full
 * featured-dashboard preview (one preset, fully resolved with ~30
 * tiles). That's the right move for returning visitors and SEO/OG
 * unfurls but it's also a lot for a first-time visitor wondering
 * "what IS this." This page is a leaner pitch — hero, three use-case
 * cards, a data-coverage grid, newsletter signup — without the
 * preset-dashboard inline render. Built so we can A/B it against
 * "/" without throwing away the existing home page.
 *
 * Anonymous-only by design. There's no signed-in branch here — the
 * regular "/" handles that flow. /welcome/ is the front door for
 * "I just clicked a Substack link" landings.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import EmailSignup from "../components/EmailSignup.astro";
import {
  SOURCE_COUNT_DISPLAY,
  METRO_COUNT,
  COUNTRY_COUNT,
} from "../lib/source-count";
import { WALKTHROUGH_DASHBOARD_SLUG } from "../lib/brand";

export const prerender = true;

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

/**
 * Coverage grid content — hand-curated rather than derived from
 * library.json because:
 *   - The library has ~10k sources; auto-grouping them produces a
 *     wall of links, not a digestible category overview.
 *   - The hand-picked examples are the strongest sources per
 *     category, which is what advertises tape best.
 *   - Adding a new pipeline shouldn't silently change this grid.
 *
 * If a source ID here is renamed / removed, the link 404s. Acceptable
 * tradeoff for editorial control; the smoke test would catch a 404
 * on /source/<id>/ before it shipped to prod.
 */
interface CoverageItem {
  label: string;
  /** Optional canonical source page to navigate to via "Open full
   *  source page →" when the user wants more depth than the inline
   *  embed shows. Left undefined when the source is map-only
   *  (no time-series source page applies). */
  sourceHref?: string;
  /** Chart ID for the inline embed iframe (/embed/chart/<id>/).
   *  Every chip carries one — the click handler swaps the iframe's
   *  src to this value so the chart renders inline without
   *  navigating away. */
  chartId: string;
}
interface CoverageCategory {
  title: string;
  blurb: string;
  items: CoverageItem[];
}
const COVERAGE: CoverageCategory[] = [
  {
    title: "US macro",
    blurb: "Inflation, rates, employment, output. The standard headline series, daily/monthly/quarterly as they update.",
    items: [
      { label: "CPI year-over-year", sourceHref: "/source/fred/cpi_yoy/", chartId: "us-macro/cpi" },
      { label: "Federal funds rate", sourceHref: "/source/fred/fed_funds/", chartId: "us-macro/fed_funds" },
      { label: "US unemployment rate", sourceHref: "/source/fred/us_unemployment/", chartId: "us-macro/unemployment" },
      { label: "Real GDP", sourceHref: "/source/fred/us_real_gdp/", chartId: "us-macro/real_gdp" },
      { label: "10-year Treasury yield", sourceHref: "/source/fred/us_10y/", chartId: "us-macro/ten_year" },
    ],
  },
  {
    title: "Federal fiscal",
    blurb: "Outlook reports, the long arc of debt + deficits, social-insurance trustee projections.",
    items: [
      { label: "Federal debt (% of GDP)", sourceHref: "/source/fred/federal_debt_pct_gdp/", chartId: "government/federal_debt_pct_gdp" },
      { label: "Federal deficit (% of GDP)", sourceHref: "/source/fred/federal_deficit_pct_gdp/", chartId: "government/federal_deficit_pct_gdp" },
      { label: "Federal interest cost (% of GDP)", sourceHref: "/source/fred/federal_interest_pct_gdp/", chartId: "government/federal_interest_pct_gdp" },
      { label: "CBO budget outlook (revenues)", sourceHref: "/source/cbo/cbo_revenues_pct_gdp/", chartId: "government/cbo_revenues_pct_gdp" },
      { label: "SSA trust fund (cost % of GDP)", sourceHref: "/source/ssa/oasdi_income_pct_gdp/", chartId: "government/ssa_oasdi_cost_pct_gdp" },
    ],
  },
  {
    title: "Markets",
    blurb: "Volatility, futures curves, commodities, the dollar against the majors. The things the desk has to write about when something breaks.",
    items: [
      { label: "WTI crude futures curve", sourceHref: "/source/yahoo_futures/wti_curve/", chartId: "energy/wti_curve" },
      { label: "Brent crude futures curve", sourceHref: "/source/yahoo_futures/brent_curve/", chartId: "energy/brent_curve" },
      { label: "Henry Hub natgas curve", sourceHref: "/source/yahoo_futures/natgas_curve/", chartId: "energy/natgas_curve" },
      { label: "Corn futures curve", sourceHref: "/source/yahoo_futures/corn_curve/", chartId: "agriculture/corn_curve" },
    ],
  },
  {
    title: "Geographic",
    blurb: `Congressional districts, all 50 states + DC, ${METRO_COUNT} US metros, ${COUNTRY_COUNT} countries. Some surface as bar snapshots (federal-spending breakdowns), others as line tiles; the map-only ones live on the Maps tab in the composer.`,
    items: [
      { label: "Federal spending by state (top 10)", sourceHref: "/source/usaspending/state_va/", chartId: "government/federal_spending_by_state_top10" },
      { label: "Per-CD spending (VA-08 in context)", sourceHref: "/source/usaspending/district_va_08/", chartId: "government/va_08_federal_spending" },
      { label: "Metro unemployment (DC area vs US)", sourceHref: "/source/bls/metro_unemployment_47900/", chartId: "government/dc_metro_unemployment_vs_us" },
      { label: "World Bank GDP (Germany shown)", sourceHref: "/source/worldbank_gdp_raw/germany/", chartId: "countries/germany" },
    ],
  },
  {
    title: "Health, environment, agriculture",
    blurb: "Longer-tail series outside the standard markets picture: life expectancy, healthcare cost growth, water withdrawals, crop production. Often the right answer for sourcing a single statistic in a piece.",
    items: [
      { label: "US life expectancy at birth (CDC)", sourceHref: "/source/cdc_health/life_expectancy_us/", chartId: "us-macro/life_expectancy" },
      { label: "US health spending per capita (CMS)", sourceHref: "/source/cms_nhe/phc_per_capita/", chartId: "us-macro/health_spending_per_capita" },
      { label: "US water withdrawals (USGS)", sourceHref: "/source/usgs_water/total_us/", chartId: "us-macro/water_use_us" },
      { label: "US corn production (USDA NASS)", sourceHref: "/source/usda_nass/corn_production_us/", chartId: "us-macro/corn_production" },
      { label: "CPI: food at home vs food away", chartId: "us-macro/cpi_food_at_home_vs_away" },
    ],
  },
  {
    title: "Stocks",
    blurb: "Market-cap history (Yahoo prices × SEC EDGAR share counts) for the names that matter to the macro picture.",
    items: [
      { label: "Tesla", sourceHref: "/source/yahoo_marketcap/tsla_mc/", chartId: "stocks/tsla" },
      { label: "ExxonMobil vs WTI", sourceHref: "/source/yahoo_marketcap/xom_mc/", chartId: "stocks/xom_vs_wti" },
      { label: "Chevron vs WTI", chartId: "stocks/cvx_vs_wti" },
      { label: "Berkshire (Class B)", chartId: "stocks/brk_b" },
      { label: "JPMorgan", chartId: "stocks/jpm" },
    ],
  },
];

/**
 * Use-case cards. Three concrete actions the audience already knows
 * how to want — they don't need to be sold on what a dashboard IS,
 * they need to be sold on what Tape lets them DO with one.
 */
interface UseCase {
  eyebrow: string;
  title: string;
  body: string;
  cta: { label: string; href: string };
}
const USE_CASES: UseCase[] = [
  {
    eyebrow: "Compose",
    title: "Build your dashboard.",
    body: "Pick sources that range from macroeconomics to climate, or derive your own, like how many times larger the US economy is than China's. Add annotations for key events. Share with a link.",
    cta: { label: "Open the walkthrough", href: "/walkthrough/" },
  },
  {
    eyebrow: "Cite",
    title: "Drop a chart into a piece.",
    body: "Every source carries a citation block (provider, series ID, license, last-updated date), plus a one-line APA-style citation and a copy-paste iframe embed that updates automatically as the data refreshes.",
    cta: { label: "See a source page", href: "/source/fred/cpi_yoy/" },
  },
  {
    eyebrow: "Alert",
    title: "Get told when CPI ticks above 4%.",
    body: "Set thresholds on any indicator we ship: greater-than, crosses-above, crosses-below, absolute change. We evaluate after every data refresh and email you on the cross.",
    cta: { label: "Set up an alert", href: "/alerts/" },
  },
];

/**
 * Render-type showcase: three small embedded charts demonstrating the
 * shapes data takes on Tape. Picked deliberately so each one looks
 * obviously different from the others — line is the daily/monthly
 * arc, bar is "where it stands today, ranked," map is "how it
 * varies across geography." A reader scanning down the page sees
 * three render shapes and gets the breadth-of-render signal in
 * about three seconds.
 */
interface RenderShowcase {
  label: string;
  blurb: string;
  chartId: string;
  chartHref: string;
}
const RENDER_SHOWCASE: RenderShowcase[] = [
  {
    label: "Time series",
    blurb: "Daily / monthly / quarterly. The tile shows the level and the change over the picked window; click to expand for sources, annotations, and the full chart.",
    chartId: "us-macro/cpi",
    chartHref: "/chart/us-macro/cpi/",
  },
  {
    label: "Bar snapshot",
    blurb: "The same sources at one moment in time, sorted descending by default. Good for ranking: who's spending the most, what's growing the fastest, where it lands today.",
    chartId: "countries/gdp_snapshot",
    chartHref: "/chart/countries/gdp_snapshot/",
  },
  {
    label: "Map",
    blurb: "How a measure varies across the country. State, county, tract, or block-group level, with ACS demographic indicators and other geographic series.",
    chartId: "government/us_bachelors_plus_pct_county_map_2022",
    chartHref: "/chart/government/us_bachelors_plus_pct_county_map_2022/",
  },
];

/**
 * Editorial-layer feature pills shown above the render showcase.
 * Reads as a compressed list of "what makes a Tape chart different
 * from a bare FRED screenshot." None of these are individually
 * differentiating, but the combination of them is.
 */
const EDITORIAL_FEATURES: string[] = [
  "Annotations",
  "Background shading (recessions, party control, Fed chairs)",
  "Dual-axis multi-source",
  "Derived A÷B / A+B / A−B sources",
  "Y-axis transforms (Level / YoY % / Index=100)",
  "Time windows, 1m → 50y",
  "Indicator alerts on threshold-cross",
  "Iframe embeds with live refresh",
];
---

<BaseLayout
  title="Tape: compose and cite dashboards of the world's data"
  description="Free, source-linked charts and maps to describe the world. Build a dashboard from our sources, derive new series, or embed any chart into your Substack."
>
  <main class="welcome">
    {/* Hero */}
    <section class="welcome-hero">
      <h1 class="welcome-title">
        Research dashboards from {SOURCE_COUNT_DISPLAY} economic and geographic sources.
      </h1>
      <p class="welcome-pitch">
        Free, source-linked charts and maps to describe the world, from
        the dollar's path against the euro and yen to a map of household
        incomes in your congressional district. Build a dashboard from
        our sources, or derive new series: maybe the sum of corn and
        soybean production in your state. Add your own text, or embed
        any chart into your Substack post.
      </p>
      <p class="welcome-cta-row">
        <a href={`${baseUrl}/compose/`} class="welcome-cta-primary">
          Build a dashboard &rarr;
        </a>
        <a href={`${baseUrl}/enterprise/`} class="welcome-cta-secondary">
          For organizations &rarr;
        </a>
      </p>
      <p class="welcome-walkthrough-line">
        New here? <a href={`${baseUrl}/${WALKTHROUGH_DASHBOARD_SLUG}/`}>Take the 5-minute tour</a>: every Tape feature in one annotated dashboard.
      </p>
    </section>

    {/* Use-case cards */}
    <section class="welcome-use-cases">
      <p class="welcome-section-eyebrow">What you can do</p>
      <div class="welcome-use-grid">
        {USE_CASES.map((u) => (
          <article class="welcome-use-card">
            <p class="welcome-use-eyebrow">{u.eyebrow}</p>
            <h3 class="welcome-use-title">{u.title}</h3>
            <p class="welcome-use-body">{u.body}</p>
            <a href={`${baseUrl}${u.cta.href}`} class="welcome-use-cta">
              {u.cta.label} &rarr;
            </a>
          </article>
        ))}
      </div>
    </section>

    {/*
      Feature showcase — what a Tape chart actually looks like and what
      it carries that a bare FRED screenshot doesn't. Two parts:
        1. A row of editorial-feature pills (text-only) — the
           combination signal: not any one of these is differentiating,
           but the stack of them is.
        2. A 3-up grid of live embed iframes showing three render
           types (line / bar / map). Each is the production
           /embed/chart/<id>/ endpoint, which means the same iframe
           handshake we use for the coverage chips applies here too —
           clicking a tile pops it OUT to the welcome-page viewport
           rather than opening a cramped in-iframe dialog.
    */}
    <section class="welcome-features-render" aria-labelledby="features-render-heading">
      <p class="welcome-section-eyebrow">What a Tape chart can do</p>
      <h2 id="features-render-heading" class="welcome-section-heading">
        Editorial layers, multiple render types.
      </h2>
      <ul class="welcome-features-pills" aria-label="Editorial features available on every chart">
        {EDITORIAL_FEATURES.map((feature) => (
          <li class="welcome-features-pill">{feature}</li>
        ))}
      </ul>
      <div class="welcome-render-grid">
        {RENDER_SHOWCASE.map((r) => (
          <figure class="welcome-render-card">
            <figcaption class="welcome-render-caption">
              <p class="welcome-render-label">{r.label}</p>
              <p class="welcome-render-blurb">{r.blurb}</p>
            </figcaption>
            <iframe
              class="welcome-render-iframe"
              src={`${baseUrl}/embed/chart/${r.chartId}/`}
              title={`${r.label} example chart`}
              loading="lazy"
            ></iframe>
            <a
              class="welcome-render-link"
              href={`${baseUrl}${r.chartHref}`}
            >
              Open full chart &rarr;
            </a>
          </figure>
        ))}
      </div>
    </section>

    {/* Coverage grid */}
    <section class="welcome-coverage">
      <p class="welcome-section-eyebrow">What's covered</p>
      <h2 class="welcome-section-heading">
        A few representative series from each area.
      </h2>
      <p class="welcome-section-sub">
        The full library is {SOURCE_COUNT_DISPLAY} sources. Click any chip to preview the chart below;
        click the preview to expand into the full plot, sources, and citations.
      </p>
      <div class="welcome-coverage-grid">
        {COVERAGE.map((cat) => (
          <article class="welcome-coverage-card">
            <h3 class="welcome-coverage-title">{cat.title}</h3>
            <p class="welcome-coverage-blurb">{cat.blurb}</p>
            <ul class="welcome-coverage-list">
              {cat.items.map((item) => (
                <li>
                  {/*
                    Chip is a button (not an anchor): click swaps the
                    inline preview iframe below. Tile click inside the
                    iframe then escalates to the popout overlay for
                    the full dialog view (handled by the embed page's
                    postMessage handshake — see
                    src/pages/embed/chart/[...id].astro).
                  */}
                  <button
                    type="button"
                    class="welcome-coverage-chip"
                    data-chart-id={item.chartId}
                    data-source-href={item.sourceHref ? `${baseUrl}${item.sourceHref}` : ""}
                    data-label={item.label}
                  >
                    {item.label}
                  </button>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>

      {/*
        Inline preview region. Populated when the user clicks any
        chip. The iframe loads /embed/chart/<id>/ at a "big tile"
        size — non-compact enough that bar charts show country
        labels and maps show the full US map. Clicking the
        tile INSIDE the iframe sends a postMessage handshake to
        this page and the welcome popout opens at full-screen with
        the dialog auto-expanded.

        Height was bumped from the previous 380px to 540px because
        the bar tile (countries/gdp_snapshot, others) was rendering
        with mini-bars and no labels at the smaller height — the
        intermediate step looked like "click again to actually see
        the chart," which was the user's complaint.
      */}
      <div class="welcome-coverage-preview" data-role="coverage-preview" hidden>
        <p class="welcome-coverage-preview-label muted small" data-role="coverage-preview-label"></p>
        <iframe
          class="welcome-coverage-preview-iframe"
          data-role="coverage-preview-iframe"
          src="about:blank"
          loading="lazy"
          title="Inline chart preview"
        ></iframe>
      </div>
    </section>

    <script>
      // Coverage-grid chips: click → load the chart into the inline
      // preview iframe below as a "big tile" (~540px tall). The
      // user then clicks the tile in the iframe to escalate to the
      // popout overlay for the full dialog view — the embed page's
      // postMessage handshake handles that escalation (see
      // src/pages/embed/chart/[...id].astro).
      //
      // Why two steps: previously we tried one-click-to-popout but
      // the iframe wrapping the chart-detail page brought the full
      // BaseLayout nav with it ("new window in window"). The
      // two-step flow lets readers preview cheaply (inline tile) and
      // only escalate to the full dialog (popout, embed layout,
      // chrome-free) when they want more detail.
      const baseUrl = (import.meta.env.BASE_URL || "/").replace(/\/$/, "");
      const previewBox = document.querySelector<HTMLElement>(
        "[data-role='coverage-preview']",
      );
      const previewIframe = document.querySelector<HTMLIFrameElement>(
        "[data-role='coverage-preview-iframe']",
      );
      const previewLabel = document.querySelector<HTMLElement>(
        "[data-role='coverage-preview-label']",
      );
      let activeChipChartId: string | null = null;
      document.querySelectorAll<HTMLButtonElement>(".welcome-coverage-chip").forEach((chip) => {
        chip.addEventListener("click", () => {
          const chartId = chip.dataset.chartId ?? "";
          const label = chip.dataset.label ?? "";
          if (!chartId || !previewBox || !previewIframe) return;
          // Same chip toggled twice → close the preview. Lets the
          // reader dismiss with the same gesture they used to open.
          if (activeChipChartId === chartId && !previewBox.hidden) {
            previewBox.hidden = true;
            previewIframe.src = "about:blank";
            activeChipChartId = null;
            document
              .querySelectorAll<HTMLButtonElement>(".welcome-coverage-chip-active")
              .forEach((el) => el.classList.remove("welcome-coverage-chip-active"));
            return;
          }
          previewIframe.src = `${baseUrl}/embed/chart/${chartId}/`;
          if (previewLabel) previewLabel.textContent = label;
          previewBox.hidden = false;
          activeChipChartId = chartId;
          document
            .querySelectorAll<HTMLButtonElement>(".welcome-coverage-chip-active")
            .forEach((el) => el.classList.remove("welcome-coverage-chip-active"));
          chip.classList.add("welcome-coverage-chip-active");
          // Scroll the preview into view, respecting reduced-motion.
          const prefersReduced = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
          ).matches;
          previewBox.scrollIntoView({
            behavior: prefersReduced ? "auto" : "smooth",
            block: "nearest",
          });
        });
      });

      // ---- Pop-out overlay (same-origin embed messaging) ----
      // The embed iframe sends "tape:embed-handshake" on load; we
      // respond "tape:host-ack" so the iframe knows we'll handle
      // pop-outs. On tile click the iframe then posts "tape:embed-
      // popout" with a chart href; we load it in the overlay's
      // own iframe at the welcome page's viewport size.
      //
      // origin-check both sides: only react to messages from the
      // SAME origin (sender always sets targetOrigin to our origin,
      // so cross-site iframes never round-trip here).
      const popoutOverlay = document.querySelector<HTMLElement>(
        "[data-role='popout-overlay']",
      );
      const popoutIframe = document.querySelector<HTMLIFrameElement>(
        "[data-role='popout-iframe']",
      );
      const popoutClose = document.querySelector<HTMLButtonElement>(
        "[data-role='popout-close']",
      );
      const popoutSentinel = document.querySelector<HTMLElement>(
        "[data-role='popout-focus-sentinel']",
      );

      // Track the element that had focus when the popout opened so we
      // can hand focus back on close — keeps keyboard users anchored
      // to where they were instead of dumping them at <body>.
      let popoutLastFocus: HTMLElement | null = null;
      function openPopout(chartHref: string): void {
        if (!popoutOverlay || !popoutIframe) return;
        if (!popoutOverlay.hidden) {
          // Already open (e.g. a second tile click while the overlay is
          // up): swap the chart in place but keep the saved restore-focus
          // target + scroll lock, so closing still returns focus to the
          // original chip rather than to an element inside the overlay.
          popoutIframe.src = chartHref;
          return;
        }
        popoutLastFocus = document.activeElement as HTMLElement | null;
        popoutIframe.src = chartHref;
        popoutOverlay.hidden = false;
        // Lock the underlying welcome page so the reader can't scroll
        // it while the overlay's open. Restored on close.
        document.body.style.overflow = "hidden";
        // Defer focus until next tick so the hidden=false has taken
        // effect — focus() on a still-hidden element no-ops in some
        // browsers.
        requestAnimationFrame(() => popoutClose?.focus());
      }
      function closePopout(): void {
        if (!popoutOverlay || !popoutIframe) return;
        popoutOverlay.hidden = true;
        popoutIframe.src = "about:blank";
        document.body.style.overflow = "";
        // Restore focus to whoever had it before — typically the
        // chip the user just clicked. Use optional chaining: if the
        // saved element vanished (DOM change), just no-op.
        popoutLastFocus?.focus?.();
        popoutLastFocus = null;
      }

      window.addEventListener("message", (e) => {
        // Strict origin check: ignore everything not from us.
        if (e.origin !== window.location.origin) return;
        const data = e.data as
          | { type?: string; chartId?: string; chartHref?: string }
          | undefined;
        if (!data?.type) return;
        if (data.type === "tape:embed-handshake") {
          // Reply directly to the sender frame, not broadcast.
          (e.source as Window | null)?.postMessage(
            { type: "tape:host-ack" },
            e.origin,
          );
          return;
        }
        if (data.type === "tape:embed-popout" && data.chartHref) {
          openPopout(data.chartHref);
        }
      });

      popoutClose?.addEventListener("click", closePopout);
      // Forward focus-exit out of the iframe lands on the sentinel (the
      // tab stop right after the iframe); bounce it back to the top of the
      // overlay so focus can't reach the page sitting behind the modal.
      popoutSentinel?.addEventListener("focus", () => {
        if (popoutOverlay && !popoutOverlay.hidden) popoutClose?.focus();
      });
      // Click outside the modal iframe (on the dimming backdrop) closes.
      popoutOverlay?.addEventListener("click", (e) => {
        if (e.target === popoutOverlay) closePopout();
      });
      // Esc closes; Tab is trapped inside the overlay so keyboard focus
      // can't wander onto the welcome page sitting behind the modal.
      document.addEventListener("keydown", (e) => {
        if (!popoutOverlay || popoutOverlay.hidden) return;
        if (e.key === "Escape") {
          closePopout();
          return;
        }
        if (e.key !== "Tab") return;
        // Focus trap. The overlay's own focusable controls are the close
        // button and the iframe element; wrap at both ends so Tab /
        // Shift+Tab cycle between them instead of escaping to the page
        // behind. (Once focus descends INTO the same-origin iframe's own
        // document, its internal tab order is the embed's concern — those
        // Tab presses fire in the iframe document, not on this handler.)
        const focusable = Array.from(
          popoutOverlay.querySelectorAll<HTMLElement>(
            'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), iframe, [tabindex]:not([tabindex="-1"])',
          ),
        ).filter((el) => el.dataset.role !== "popout-focus-sentinel");
        if (focusable.length === 0) return;
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        const active = document.activeElement as HTMLElement | null;
        if (e.shiftKey) {
          if (active === first || !popoutOverlay.contains(active)) {
            e.preventDefault();
            last.focus();
          }
        } else if (active === last || !popoutOverlay.contains(active)) {
          e.preventDefault();
          first.focus();
        }
      });

      // ---- Semi-lazy progressive warm of coverage-chip embeds ----
      //
      // Each coverage chip points the inline preview iframe at
      // /embed/chart/<id>/. That endpoint is SSR, but its response is now
      // edge-cacheable (Cache-Control s-maxage, set in the embed page itself):
      // the FIRST hit to each URL is a ~1.5s cold render, every hit after is a
      // fast Vercel-edge HIT. The job here is to pay that first hit in the
      // background, before the reader clicks — so the click feels instant.
      //
      // Strategy ("semi-lazy"): while the page is open, warm embeds ONE AT A
      // TIME, continuously, via <link rel="prefetch" as="document"> (the
      // primitive whose cache partition matches the iframe's later navigation).
      // One at a time — not a ~30-request burst — so the speculative warming
      // never saturates the connection and slows the chart the reader actually
      // clicks.
      //   - Background driver: walks every chip's embed in order, warming the
      //     next only once the previous settles, then yielding to idle.
      //   - Urgent override: pointer-enter / focus warms THAT embed at once,
      //     out of band, so the reader's likely target jumps the queue. The
      //     driver dedupes against a warmed-set.
      //
      // Starts after window.load + requestIdleCallback (timeout 5000) so the
      // first warm never competes with the page's own load (incl. the
      // render-showcase iframes). Safari (no rIC) falls back to setTimeout.
      //
      // Verification hooks (answer "is it warming?" without grepping source):
      //   - console.info('[welcome:prefetch] ...') with a count + timing.
      //   - <html data-welcome-prefetch="<state>">: "queued" → "scheduled" →
      //     "warming" → "done" (or "skipped"). Pollable from headless tools.
      //   - CustomEvent("welcome:prefetch-fired") on window.
      //
      // Connection-quality gate: skip the speculative warming entirely on Save
      // Data or a 3G-or-worse perceived connection — the click-latency win
      // isn't worth ~30 speculative SSR fetches there. Touch-vs-pointer is NOT
      // a signal (many laptops have touchscreens; don't deny them the speedup).
      type NetInfo = { saveData?: boolean; effectiveType?: string };
      function shouldPrefetch(): boolean {
        const nav = navigator as unknown as { connection?: NetInfo };
        const conn = nav.connection;
        // Explicit Save Data preference → never prefetch.
        if (conn?.saveData) return false;
        // Anything below 4G → skip. By 2026 the median connection
        // is 4G or wifi; 3G or worse is constrained enough that
        // ~2MB of speculative SSR responses isn't justified by the
        // click-latency win. Note that effectiveType is the
        // browser's PERCEIVED throughput, not the radio type —
        // it's based on round-trip latency + bandwidth measurements,
        // so a wifi connection that's actually slow registers as
        // "3g" too. Either way the call's the same: skip.
        const eff = conn?.effectiveType;
        if (eff === "slow-2g" || eff === "2g" || eff === "3g") return false;
        return true;
      }
      if (shouldPrefetch()) {
        // State machine on <html data-welcome-prefetch> for tests / debugging:
        //   "queued" → "scheduled" → "warming" → "done" (or "skipped").
        document.documentElement.setAttribute("data-welcome-prefetch", "queued");

        // requestIdleCallback is absent in Safari + not in this script's TS DOM
        // lib; one typed accessor, with a setTimeout fallback so warming still
        // proceeds either way.
        const scheduleIdle = (cb: () => void, timeout: number): void => {
          const ric = (window as unknown as {
            requestIdleCallback?: (c: () => void, o?: { timeout?: number }) => void;
          }).requestIdleCallback;
          if (ric) ric(cb, { timeout });
          else setTimeout(cb, Math.min(timeout, 2000));
        };

        const warmed = new Set<string>(); // embeds we've injected a <link> for
        const queue: string[] = []; // background work-list; front = warmed next

        // Inject ONE <link rel="prefetch" as="document">. `as=document` matches
        // the iframe's later top-level navigation, so the now-edge-cacheable
        // embed response is reused on click instead of re-fetched.
        const warmOne = (id: string): HTMLLinkElement => {
          warmed.add(id);
          const link = document.createElement("link");
          link.rel = "prefetch";
          link.href = `${baseUrl}/embed/chart/${id}/`;
          link.setAttribute("as", "document");
          document.head.appendChild(link);
          return link;
        };

        // Urgent override: warm a chip's embed NOW (hover / focus), out of band
        // from the background walk. The driver skips anything already warmed.
        const warmUrgent = (id: string): void => {
          if (!id || warmed.has(id)) return;
          warmOne(id);
        };

        // Background driver: warm ONE embed at a time, advancing only when the
        // previous settles (load/error) or a fallback timeout fires — never two
        // at once, never a burst. "Always loading something" while the page is
        // open, without saturating the connection.
        let inFlight = false;
        const driveNext = (): void => {
          if (inFlight) return;
          let id: string | undefined = queue.shift();
          while (id !== undefined && warmed.has(id)) id = queue.shift();
          if (id === undefined) {
            document.documentElement.setAttribute("data-welcome-prefetch", "done");
            return;
          }
          inFlight = true;
          const link = warmOne(id);
          let advanced = false;
          const advance = (): void => {
            if (advanced) return;
            advanced = true;
            inFlight = false;
            scheduleIdle(driveNext, 1500); // yield to idle between warms
          };
          link.addEventListener("load", advance);
          link.addEventListener("error", advance);
          // Some browsers never fire load on a prefetch link — don't stall.
          setTimeout(advance, 4000);
        };

        const startDriver = (): void => {
          document.documentElement.setAttribute("data-welcome-prefetch", "warming");
          document
            .querySelectorAll<HTMLButtonElement>(".welcome-coverage-chip")
            .forEach((chip) => {
              const id = chip.dataset.chartId;
              if (id) queue.push(id);
            });
          // eslint-disable-next-line no-console
          console.info(
            `[welcome:prefetch] progressive warm: ${queue.length} embeds queued ` +
            `at t=${Math.round(performance.now())}ms`,
          );
          window.dispatchEvent(
            new CustomEvent("welcome:prefetch-fired", { detail: { count: queue.length } }),
          );
          driveNext();
        };

        // Start after window.load + idle so the first warm never competes with
        // the page's own resources (incl. the render-showcase iframes).
        const schedule = (): void => {
          document.documentElement.setAttribute("data-welcome-prefetch", "scheduled");
          scheduleIdle(startDriver, 5000);
        };
        if (document.readyState === "complete") schedule();
        else window.addEventListener("load", schedule, { once: true });

        // Pointer-enter / focus → warm THAT chip's embed immediately, ahead of
        // the background walk: the reader's likely target shouldn't wait its
        // turn. (Click already loads it into the preview iframe.)
        document
          .querySelectorAll<HTMLButtonElement>(".welcome-coverage-chip")
          .forEach((chip) => {
            const id = chip.dataset.chartId;
            if (!id) return;
            const urgent = (): void => warmUrgent(id);
            chip.addEventListener("pointerenter", urgent, { once: true });
            chip.addEventListener("focus", urgent, { once: true });
          });
      } else {
        // Slow connection / Save Data — record that we deliberately
        // skipped so a future debug session doesn't go hunting for a
        // bug that isn't one.
        document.documentElement.setAttribute(
          "data-welcome-prefetch", "skipped",
        );
      }
    </script>

    {/*
      Pop-out overlay for the coverage chart preview. The embed
      iframes on this page send a "tape:embed-popout" message when
      their tile is clicked; this overlay's listener catches it and
      loads the canonical /chart/<id>/ page in a fullscreen iframe,
      so the reader gets the dialog UI at the welcome page's
      viewport instead of squeezed into the 380px preview iframe.
      Same-origin only — Substack / newsletter / cross-origin
      embeds fall back to opening /chart/<id>/ in a new tab,
      handled by the embed page's script (no parent ack → new tab).
    */}
    <div
      class="welcome-popout-overlay"
      data-role="popout-overlay"
      role="dialog"
      aria-modal="true"
      aria-label="Expanded chart"
      hidden
    >
      <button
        type="button"
        class="welcome-popout-close"
        data-role="popout-close"
        aria-label="Close chart"
        title="Close (Esc)"
      >&times;</button>
      <iframe
        class="welcome-popout-iframe"
        data-role="popout-iframe"
        src="about:blank"
        title="Expanded chart view"
      ></iframe>
      {/* Focus sentinel. When the user Tabs forward past the iframe's own
          last control, focus lands here (the next tab stop after the
          iframe) and the handler bounces it back to the close button.
          That closes the one-keypress gap where focus would otherwise
          advance to a welcome-page element behind the modal. The parent
          keydown trap can't catch that Tab: it fires inside the
          same-origin iframe's document, not on this page. */}
      <div
        data-role="popout-focus-sentinel"
        tabindex="0"
        style="position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap;"
      ></div>
    </div>

    {/* Newsletter signup — quiet, low-friction. Anonymous visitors
        who aren't ready to compose / sign in can still leave their
        email and hear when new sources land. */}
    <section class="welcome-newsletter">
      <EmailSignup
        variant="banner"
        source="welcome-page"
        title="Hear when new data sources land."
        blurb="Monthly updates. New features, new chart sources, the occasional analysis. No spam, easy to unsubscribe."
      />
    </section>
  </main>
</BaseLayout>

