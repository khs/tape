---
import { getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionChart from "../../components/SectionChart.astro";
import ChartController from "../../components/ChartController.astro";
import { resolveBarSnapshots } from "../../lib/resolve-bar-snapshots";
import { DELTA_LABELS_SHORT } from "../../lib/deltas";
import {
  resolveSections,
  dashboardSupportedDeltas,
  resolveDashboardDefault,
  effectiveChart,
} from "../../lib/resolve-dashboard";
import {
  composedStateSchema,
  encodeComposedState,
  type ComposedState,
} from "../../lib/composer-state";
import { createSupabase, isSupabaseConfigured } from "../../lib/supabase";
import AnalyticsDashboardView from "../../components/AnalyticsDashboardView.astro";
import EmailSignup from "../../components/EmailSignup.astro";
import { renderMarkdown } from "../../lib/markdown";

export const prerender = false;

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const slug = Astro.params.slug!;

let notFound = false;
let errorMessage: string | null = null;
let state: ComposedState | null = null;
let ownerBadge: string | null = null;
let ownerId: string | null = null;

if (!isSupabaseConfigured) {
  errorMessage = "Supabase is not configured on this build.";
} else {
  const sb = createSupabase()!;
  const { data, error } = await sb
    .from("saved_dashboards")
    .select("title, state_json, visibility, owner_id")
    .eq("slug", slug)
    .maybeSingle();
  if (error) {
    errorMessage = "Couldn't load this dashboard.";
  } else if (!data) {
    // Either doesn't exist, or private-and-not-owned (RLS hides it as 404).
    notFound = true;
  } else {
    const parsed = composedStateSchema.safeParse(data.state_json);
    if (!parsed.success) {
      errorMessage = "This saved dashboard's state is malformed.";
    } else {
      state = parsed.data;
      // Prefer the saved title column over any embedded state title.
      if (data.title && !state.title) state.title = data.title;
      ownerBadge = data.visibility === "private" ? "private" : null;
      ownerId = data.owner_id ?? null;

      // Preset reference: when state.presetRef is set, the saved row
      // is a thin pointer to a curated preset (currently used for the
      // walkthrough seeded into every signed-in user's account). Swap
      // sections/charts/description with the preset's so the page
      // renders the LIVE preset content — updates to the preset YAML
      // flow through automatically, no snapshot drift.
      if (state.presetRef) {
        try {
          const preset = await getEntry("dashboards", state.presetRef);
          if (preset) {
            state = {
              ...state,
              title: preset.data.title,
              description: preset.data.description ?? state.description,
              defaultDelta: preset.data.defaultDelta ?? state.defaultDelta,
              sections: preset.data.sections,
              charts: preset.data.charts,
              chartOverrides: preset.data.chartOverrides,
              // Inline shapes can't exist on a preset (they're
              // composer-only), so clear them — the preset is the
              // sole source of truth for this row's content.
              inlineCharts: undefined,
              inlineSources: undefined,
              inlineMaps: undefined,
            };
          }
          // If preset is missing, fall through with the saved state as-is.
          // In practice it has empty sections, which renders as
          // "This dashboard has no charts" — a graceful failure.
        } catch {
          /* swallow — same fall-through behavior as missing preset */
        }
      }
    }
  }
}

let resolvedSections: Awaited<ReturnType<typeof resolveSections>> = [];
let supported: ReturnType<typeof dashboardSupportedDeltas> = [];
let defaultDelta: ReturnType<typeof resolveDashboardDefault> | undefined;
if (state) {
  resolvedSections = await resolveSections({
    sections: state.sections,
    charts: state.charts,
    inlineCharts: state.inlineCharts,
    inlineSources: state.inlineSources,
    // Inline maps need an explicit hand-off, same as inlineCharts —
    // resolve-dashboard.ts looks them up by `inlinemap:<id>` reference
    // and synthesizes a choropleth CollectionEntry. Without this the
    // map tiles silently disappear from saved dashboards while still
    // rendering in the composer.
    inlineMaps: state.inlineMaps,
  });
  supported = dashboardSupportedDeltas(resolvedSections);
  defaultDelta = resolveDashboardDefault(state.defaultDelta, supported);
}

// Bar-chart snapshots: pre-resolve for the JSX below (can't await
// inline in a .map). Returns an empty Map when no bar charts in the
// saved dashboard.
const barSnapshots = await resolveBarSnapshots(
  resolvedSections.flatMap((s) => s.charts),
);

// Flatten resolved sources for the dashboard_viewed telemetry event.
const viewedSourceIds = Array.from(
  new Set(
    resolvedSections.flatMap((sec) =>
      sec.charts.flatMap((c) => c.sources.map((s) => s.id)),
    ),
  ),
);
const viewedChartCount = resolvedSections.reduce(
  (acc, sec) => acc + sec.charts.length,
  0,
);

// Re-encode the resolved state into an ?d= blob so the OG endpoint renders
// the saved dashboard's actual hero chart (vs a bare title-only card). This
// dodges the need to give the OG endpoint a service-role Supabase key.
const ogD = state
  ? encodeComposedState({
      title: state.title,
      sections: state.sections,
      charts: state.charts,
      inlineCharts: state.inlineCharts,
      inlineSources: state.inlineSources,
      inlineMaps: state.inlineMaps,
    })
  : null;
---

<BaseLayout
  title={`${state?.title ?? "Saved dashboard"} — Tape`}
  ogImage={ogD ? `/og.png?d=${encodeURIComponent(ogD)}` : undefined}
>
  <div
    class="dashboard-root max-w-[1200px] mx-auto px-6 pt-8 pb-16"
    data-dashboard-default-window={defaultDelta ?? "1m"}
    data-slug={slug}
  >
    {/* Breadcrumb shortcuts. Hidden client-side for signed-in users —
        the BaseLayout header already exposes "Compose" + "My dashboards"
        in the top-right, so this nav is just noise for anyone who has
        a session. Anonymous viewers still see it (they don't have the
        signed-in header links). */}
    <nav class="text-xs text-neutral-500 mb-3" data-role="dashboard-breadcrumb">
      <a href={baseUrl || "/"} class="no-underline hover:text-neutral-900">All dashboards</a>
      <span class="mx-1">·</span>
      <a href={`${baseUrl}/compose/`} class="no-underline hover:text-neutral-900">Composer</a>
    </nav>

    {/* "Pinned as home view" notice. The home page redirects to this
        dashboard whenever the user has a tape:default-dashboard-slug
        set in localStorage matching this slug. The notice surfaces
        only on that path so the user understands why they landed here
        from / and has a clear escape hatch.

        Hidden by default; the inline script below reveals it on the
        page that matches the pinned slug + has ?from=home in the URL
        (so a direct navigation to /u/<slug>/ from a link doesn't
        surface the notice — it's specifically for the "I landed here
        because it's my default" case). */}
    <aside class="pinned-home-notice" data-role="pinned-home-notice" hidden>
      <span class="pinned-home-icon" aria-hidden="true">📌</span>
      <span class="pinned-home-text">
        This is your pinned home view. The home page redirects here
        whenever you visit Tape.
      </span>
      <a
        href={`${baseUrl || "/"}/?nopin=1`}
        class="pinned-home-link"
        data-role="pinned-home-open-home"
      >
        Open the home page &rarr;
      </a>
      <button
        type="button"
        class="pinned-home-clear"
        data-role="pinned-home-clear"
        aria-label="Unpin this dashboard"
        title="Stop pinning this dashboard as your home view"
      >
        Unpin
      </button>
    </aside>

    {notFound ? (
      <div class="max-w-[640px] p-6 border hairline rounded bg-neutral-100 text-sm text-neutral-700 leading-relaxed">
        <p><strong>Dashboard not found.</strong></p>
        <p class="mt-2">
          The dashboard at <code>/u/{slug}/</code> doesn't exist, or it was set to private by its owner.
        </p>
      </div>
    ) : errorMessage ? (
      <div class="max-w-[640px] p-6 border hairline rounded bg-neutral-100 text-sm text-neutral-700 leading-relaxed">
        <p><strong>{errorMessage}</strong></p>
      </div>
    ) : state ? (
      <>
        {/* Post-save email-capture banner. Rendered hidden; the inline
            script below reveals it only when the user just arrived from
            a successful save (?just-saved=1 in the URL, set by the
            composer) and hasn't dismissed the prompt this session. */}
        <div
          class="post-save-prompt"
          data-role="post-save-prompt"
          hidden
        >
          <button
            type="button"
            class="post-save-dismiss"
            data-role="post-save-dismiss"
            aria-label="Dismiss"
            title="Dismiss"
          >&times;</button>
          <EmailSignup
            variant="banner"
            source="post-save"
            title="Saved. Want to know when we add new sources?"
            blurb="Roughly monthly — new features, new chart sources, the occasional analysis. No spam, easy to unsubscribe."
          />
        </div>

        <header class="mb-4">
          <div class="flex items-baseline justify-between flex-wrap gap-3">
            <h1 class="text-2xl font-semibold">{state.title}</h1>
            <div class="flex gap-2 items-center">
              {ownerBadge && (
                <span class="text-xs px-2 py-0.5 rounded-sm bg-neutral-100 text-neutral-500 uppercase tracking-wider">private</span>
              )}
              <button
                type="button"
                class="text-xs text-neutral-600 hover:text-neutral-900 border hairline rounded-sm px-2 py-1 bg-white cursor-pointer"
                data-role="copy-link"
              >
                Copy link
              </button>
              {
                (() => {
                  const encoded = encodeComposedState({
                    title: state.title,
                    description: state.description,
                    defaultDelta: state.defaultDelta,
                    fixedRange: state.fixedRange,
                    sections: state.sections,
                    charts: state.charts,
                    chartOverrides: state.chartOverrides,
                    inlineCharts: state.inlineCharts,
                    inlineSources: state.inlineSources,
                    // Carry inlineMaps through to the composer when
                    // the user clicks Edit / Make a copy — without
                    // this they'd lose every map tile on the trip
                    // back to /compose/.
                    inlineMaps: state.inlineMaps,
                  });
                  return (
                    <>
                      <a
                        href={`${baseUrl}/compose/?d=${encoded}&edit=${slug}`}
                        class="text-xs text-accent no-underline hover:underline border hairline rounded-sm px-2 py-1"
                        data-role="edit-link"
                        data-owner-id={ownerId ?? ""}
                        style="display: none"
                      >
                        Edit &rarr;
                      </a>
                      <a
                        href={`${baseUrl}/compose/?d=${encoded}&copy=1`}
                        class="text-xs text-neutral-600 no-underline hover:text-neutral-900 border hairline rounded-sm px-2 py-1"
                        title={`Open the composer with a copy of "${state.title ?? "this dashboard"}" — Save creates a new dashboard at a fresh URL.`}
                      >
                        Make a copy &rarr;
                      </a>
                    </>
                  );
                })()
              }
            </div>
          </div>
          {state.description && (
            <p class="mt-2 text-sm text-neutral-600 max-w-[640px]">{state.description}</p>
          )}
        </header>

        {state.fixedRange ? (
          <div class="dashboard-window" role="group" aria-label="Fixed range">
            <span class="eyebrow">Range</span>
            <span class="dashboard-fixed-range">
              {state.fixedRange.start} → {state.fixedRange.end}
            </span>
          </div>
        ) : (
          supported.length > 0 && (
            <div class="dashboard-window" role="group" aria-label="Default window">
              <span class="eyebrow">Window</span>
              <div class="pills" data-dashboard-window-control>
                {supported.map((w) => (
                  <button
                    type="button"
                    class={"pill" + (w === defaultDelta ? " pill-active" : "")}
                    data-dashboard-window={w}
                    aria-pressed={w === defaultDelta ? "true" : "false"}
                  >
                    {DELTA_LABELS_SHORT[w]}
                  </button>
                ))}
              </div>
            </div>
          )
        )}

        {resolvedSections.map((section) => {
          // Section-level window override beats dashboard-level. See
          // the comment on the equivalent block in [...slug].astro for
          // the rationale ("repeat the same chart-set across decades").
          const sectionDelta = section.defaultDelta ?? defaultDelta;
          const sectionFixed = section.fixedRange ?? state.fixedRange;
          return (
          <section class={`dash-section${section.charts.length === 0 && section.markdown ? " dash-section-markdown" : ""}`}>
            {section.title && (
              <h2 class="section-heading">{section.title}</h2>
            )}
            {section.description && (
              <p class="section-description">{section.description}</p>
            )}
            {(section.fixedRange || section.defaultDelta) && (
              <p class="section-window muted small">
                Window:{" "}
                {section.fixedRange
                  ? `${section.fixedRange.start} → ${section.fixedRange.end}`
                  : section.defaultDelta}
              </p>
            )}
            {section.markdown && section.markdown.trim().length > 0 && (
              <div class="section-markdown" set:html={renderMarkdown(section.markdown)} />
            )}
            {section.charts.length > 0 && (
              <div class="chart-grid">
                {section.charts.map((c) => (
                  <SectionChart
                    chartId={c.chart.id}
                    chart={effectiveChart(c, state?.chartOverrides?.[c.chart.id])}
                    sources={c.sources}
                    dashboardSlug={`u-${slug}`}
                    sectionDelta={sectionDelta}
                    sectionFixedRange={sectionFixed}
                    sectionLocked={!!(section.defaultDelta || section.fixedRange)}
                    preloaded={c.preloaded}
                    barSnapshot={barSnapshots.get(c.chart.id)}
                  />
                ))}
              </div>
            )}
          </section>
          );
        })}

        {resolvedSections.length === 0 && (
          <p class="mt-6 text-sm text-neutral-500">
            This dashboard has no charts. <a class="underline" href={`${baseUrl}/compose/`}>Compose one</a>.
          </p>
        )}

        {/* "My dashboards" footer list. Renders only when the visitor
            landed here from the home-page redirect (?from=home set)
            AND they're signed in (the JS below gates on a Supabase
            session). The home page redirects to the user's pinned
            dashboard whenever localStorage has a tape:default-
            dashboard-slug, so under that flow this section IS the
            full home experience — the pinned dashboard above + the
            rest of the user's saved dashboards below. The list uses
            the same shared renderer as /me/ so the layout is
            consistent. */}
        <section
          class="home-footer-list"
          data-role="home-footer-list"
          hidden
        >
          <h2 class="home-footer-eyebrow">My dashboards</h2>
          <ul
            class="home-footer-list-ul list-none p-0 m-0 flex flex-col gap-3"
            data-role="home-footer-list-ul"
          ></ul>
        </section>

        <script>
          import { readStoredSession } from "../../lib/supabase";

          const btn = document.querySelector<HTMLButtonElement>(
            "[data-role='copy-link']",
          );
          btn?.addEventListener("click", async () => {
            try {
              await navigator.clipboard.writeText(window.location.href);
              const original = btn.textContent;
              btn.textContent = "Copied!";
              setTimeout(() => (btn.textContent = original), 1500);
            } catch {
              alert("Copy failed. URL is in the address bar.");
            }
          });

          // Reveal the Edit button when the current user is the owner of
          // this saved dashboard. Owner id is baked into the anchor as a data
          // attribute; we compare against the user stored locally.
          const editLink = document.querySelector<HTMLAnchorElement>(
            "[data-role='edit-link']",
          );
          const sessionForUi = readStoredSession();
          if (editLink) {
            const ownerId = editLink.dataset.ownerId ?? "";
            if (ownerId && sessionForUi && sessionForUi.user.id === ownerId) {
              editLink.style.display = "";
            }
          }

          // Hide the "All dashboards · Composer" breadcrumb for signed-in
          // viewers — those shortcuts already live in the top-right header
          // ("Compose" + "My dashboards"), so the in-page nav is duplicate
          // chrome for anyone with a session. Anonymous viewers keep it
          // since they don't see the signed-in header links.
          if (sessionForUi) {
            const breadcrumb = document.querySelector<HTMLElement>(
              "[data-role='dashboard-breadcrumb']",
            );
            if (breadcrumb) breadcrumb.style.display = "none";
          }
        </script>
      </>
    ) : null}
  </div>

  <ChartController />
  {viewedChartCount > 0 && (
    <AnalyticsDashboardView
      sources={viewedSourceIds}
      surface="saved"
      chartCount={viewedChartCount}
      slug={slug}
    />
  )}

  <script>
    // Reveal the post-save email-capture banner only when the user just
    // arrived from a successful save (the composer adds ?just-saved=1)
    // and hasn't dismissed the prompt this session. We strip the query
    // param after reveal so refresh doesn't re-prompt.
    const url = new URL(window.location.href);
    const justSaved = url.searchParams.get("just-saved") === "1";
    const dismissedKey = "lm:post-save-dismissed";
    const alreadyDismissed =
      sessionStorage.getItem(dismissedKey) === "1";
    const prompt = document.querySelector<HTMLElement>(
      "[data-role='post-save-prompt']",
    );
    if (justSaved && !alreadyDismissed && prompt) {
      prompt.hidden = false;
      // Strip the param so a refresh doesn't re-arm the prompt; also
      // tidier in case the user shares this URL elsewhere.
      url.searchParams.delete("just-saved");
      window.history.replaceState(
        {},
        "",
        url.pathname + (url.search ? url.search : "") + url.hash,
      );
    }
    if (prompt) {
      const dismissBtn = prompt.querySelector<HTMLButtonElement>(
        "[data-role='post-save-dismiss']",
      );
      dismissBtn?.addEventListener("click", () => {
        prompt.hidden = true;
        sessionStorage.setItem(dismissedKey, "1");
      });
      // Also auto-dismiss once a submission succeeds — the EmailSignup
      // component flips the status text to "Subscribed. Talk soon." on
      // success; observe it and collapse the prompt a moment later.
      const status = prompt.querySelector<HTMLElement>(
        "[data-role='email-signup-status']",
      );
      if (status) {
        const obs = new MutationObserver(() => {
          if (status.dataset.kind === "ok") {
            sessionStorage.setItem(dismissedKey, "1");
            setTimeout(() => {
              prompt.hidden = true;
            }, 1800);
            obs.disconnect();
          }
        });
        obs.observe(status, {
          attributes: true,
          attributeFilter: ["data-kind"],
          childList: true,
          characterData: true,
          subtree: true,
        });
      }
    }
  </script>

  <script>
    // Pinned-home-view notice. The home page's pre-paint script
    // redirects to this dashboard whenever localStorage has the
    // pinned-slug key matching the current slug. To make that
    // redirect transparent, surface a small notice on this page when:
    //   1. ?from=home is in the URL (the redirect tagged us)
    //   2. AND localStorage's pinned slug matches this slug
    // The notice has an "Unpin" button that clears the default
    // and a "Open the home page" link (the link itself carries
    // ?nopin=1 which the home-page redirect-script bypasses).
    import { DEFAULT_DASHBOARD_SLUG_KEY as DEFAULT_SLUG_KEY } from "../../lib/brand";
    {
      const notice = document.querySelector<HTMLElement>(
        "[data-role='pinned-home-notice']",
      );
      if (notice) {
        const here = document.querySelector<HTMLElement>("[data-slug]");
        const currentSlug = here?.dataset.slug ?? "";
        const fromHome =
          new URL(window.location.href).searchParams.get("from") === "home";
        const pinned = localStorage.getItem(DEFAULT_SLUG_KEY);
        if (fromHome && pinned && pinned === currentSlug) {
          notice.hidden = false;
        }
        const unpinBtn = notice.querySelector<HTMLButtonElement>(
          "[data-role='pinned-home-clear']",
        );
        unpinBtn?.addEventListener("click", () => {
          localStorage.removeItem(DEFAULT_SLUG_KEY);
          notice.hidden = true;
        });
      }
    }
  </script>

  <script>
    // Home-footer "My dashboards" list. Renders ONLY when:
    //   1. ?from=home is in the URL (home-page redirect tagged us)
    //   2. The visitor is signed in (we have a Supabase session)
    //
    // Under the "pinned home view" flow the home page redirects to
    // this dashboard, so the user expects to see both the dashboard
    // AND the rest of their saved dashboards (matching /me/'s
    // layout). When the user lands here from a direct /u/<slug>/
    // link, we skip rendering — the footer list would be confusing
    // out of context.
    import {
      createSupabase,
      isSupabaseConfigured,
      readStoredSession,
    } from "../../lib/supabase";
    import { renderSavedDashboardList } from "../../lib/render-saved-dashboards";
    import { DEFAULT_DASHBOARD_SLUG_KEY as DEFAULT_SLUG_KEY } from "../../lib/brand";

    (async () => {
      const fromHome =
        new URL(window.location.href).searchParams.get("from") === "home";
      if (!fromHome) return;
      if (!isSupabaseConfigured) return;
      const stored = readStoredSession();
      if (!stored) return;

      const sb = createSupabase();
      if (!sb) return;

      const section = document.querySelector<HTMLElement>(
        "[data-role='home-footer-list']",
      );
      const host = document.querySelector<HTMLUListElement>(
        "[data-role='home-footer-list-ul']",
      );
      if (!section || !host) return;

      const here = document.querySelector<HTMLElement>("[data-slug]");
      const currentSlug = here?.dataset.slug ?? "";

      // baseUrl mirror — the page module doesn't expose its
      // server-side `baseUrl` constant to client code; recompute
      // from import.meta.env at hydrate-time.
      const baseUrl = (import.meta.env.BASE_URL || "/").replace(/\/$/, "");

      const result = await renderSavedDashboardList({
        host,
        baseUrl,
        sb,
        // Hide the currently-pinned dashboard (= the dashboard the
        // user is already looking at above) — listing it here would
        // duplicate the pinned-home-notice block.
        excludeSlug: currentSlug,
        // Pin slug lives in localStorage; pass it through so the
        // "Set as default" buttons in the list reflect current state.
        defaultSlug: currentSlug,
        onSetDefault: (slug) => {
          try {
            if (slug) {
              localStorage.setItem(DEFAULT_SLUG_KEY, slug);
              // Navigate to the new pin so the page reflects it.
              window.location.href = `${baseUrl}/u/${encodeURIComponent(slug)}/?from=home`;
            } else {
              localStorage.removeItem(DEFAULT_SLUG_KEY);
              window.location.href = `${baseUrl || "/"}/?nopin=1`;
            }
          } catch {
            /* localStorage blocked — no-op */
          }
        },
        onMutate: () => {
          // Reload to re-render with fresh data — the listing flow
          // doesn't have a tight in-component refresh hook for this
          // page (the dashboard itself uses server-rendered state).
          window.location.reload();
        },
      });

      if (result && (result.rows.length > 0 || result.excludedRow)) {
        section.hidden = false;
      }
    })();
  </script>
</BaseLayout>

<style>
  /* Home-footer "My dashboards" list. Shown only when ?from=home (set
     by the home-page pre-paint redirect). Sits below the pinned
     dashboard's content; visually demarcated with a top border so it
     doesn't read as part of the dashboard above. */
  .home-footer-list {
    margin-top: 56px;
    padding-top: 28px;
    border-top: 1px solid rgba(55, 53, 47, 0.08);
  }
  .home-footer-list[hidden] {
    display: none;
  }
  .home-footer-eyebrow {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-neutral-500);
    margin: 0 0 14px;
  }
  .home-footer-list-ul {
    list-style: none;
  }
  .dashboard-window { display: flex; align-items: center; gap: 10px; margin-bottom: 20px; flex-wrap: wrap; }
  .dashboard-fixed-range {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: var(--text-xs);
    color: var(--color-neutral-700);
    background: var(--color-neutral-100);
    padding: 3px 8px;
    border-radius: var(--radius-sm);
  }
  .dashboard-window .pills { display: flex; gap: 4px; font-size: var(--text-xs); font-weight: 500; }
  .dashboard-window .pill { padding: 4px 10px; border: 1px solid rgba(55, 53, 47, 0.1); border-radius: var(--radius-sm); background: var(--color-white); color: var(--color-neutral-600); cursor: pointer; font: inherit; }
  .dashboard-window .pill:hover { background: var(--color-neutral-100); }
  .dashboard-window .pill-active,
  .dashboard-window .pill-active:hover { background: var(--color-neutral-900); color: var(--color-white); border-color: var(--color-neutral-900); }
