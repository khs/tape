---
import type { CollectionEntry } from "astro:content";
import {
  loadSourceData,
  loadSourceForTile,
  currentPoint,
  findPriorPoint,
  type TileSummary,
} from "../lib/load-data";
import {
  formatValue,
  formatDeltaDisplay,
  formatDate,
} from "../lib/format";
import {
  DELTA_DAYS,
  DELTA_LABELS_PAST,
  DELTA_LABELS_SHORT,
  closestSupported,
  DELTA_WINDOWS,
  type DeltaWindow,
} from "../lib/deltas";
import type { TimeSeriesData, TimeSeriesPoint } from "../lib/data-types";
import { seriesColor } from "../lib/series-colors";
import {
  combineTwo,
  combineOpLabel,
  combineOpFormatting,
  applyPercentDisplayOverride,
  type CombineOp,
} from "../lib/derive";
import { SITE_BRAND_URL } from "../lib/brand";

type ChartData = CollectionEntry<"charts">["data"];

interface Props {
  chartId: string;
  chart: ChartData;
  sources: CollectionEntry<"sources">[];
  dashboardSlug: string;
  dashboardWindow?: DeltaWindow;
  // When set, the chart renders a fixed [start, end] date range instead of
  // a trailing window. Both bounds are ISO YYYY-MM-DD. Wins over
  // dashboardWindow when present.
  dashboardFixedRange?: { start: string; end: string };
  // True when the tile belongs to a section that has its own window
  // override (defaultDelta or fixedRange). Surfaced as a data attr on
  // the tile root so the dashboard-level pill click handler can skip
  // it — section-pinned tiles shouldn't get rewindowed when the user
  // changes the dashboard-wide selection.
  sectionLocked?: boolean;
  // Side channel: pre-computed timeseries keyed by source ID. Used by
  // derived sources (which don't have a real data file). Real sources
  // can also be preloaded; we just won't read fs in that case.
  preloaded?: Record<string, TimeSeriesData>;
}

const {
  chartId,
  chart,
  sources,
  dashboardSlug,
  dashboardWindow,
  dashboardFixedRange,
  sectionLocked,
  preloaded,
} = Astro.props;

// Pull op (arithmetic combination) off the chart if set. When valid (op
// + exactly two sources), we collapse the chart into a single derived
// series after perSource is loaded; the rest of the pipeline then treats
// it as a single-source chart.
const chartOp =
  (chart as { op?: CombineOp }).op &&
  sources.length === 2
    ? ((chart as { op?: CombineOp }).op as CombineOp)
    : undefined;

// `isMulti` after any op collapse: if we have an op-driven collapse, the
// rendered chart is single-line.
const isMulti = !chartOp && sources.length > 1;
// Resolve normalize mode. If the chart didn't set one, pick a sensible
// default: "rebase" for multi-source charts, "raw" for single. Heuristic
// for same-scale multi-source ("3 percent rates": all match formatting +
// unit) is applied at compose time when the inline chart is built; when
// it's already explicit on the chart we honor whatever was set. Op'd
// charts always render raw (single derived line).
const normalize: "rebase" | "raw" | "dual-axis" =
  chartOp
    ? "raw"
    : ((chart.normalize as "rebase" | "raw" | "dual-axis" | undefined) ??
      (isMulti ? "rebase" : "raw"));

// Effective supportedDeltas = intersection of sources' supportedDeltas.
// Preserve the canonical order (DELTA_WINDOWS order).
const allSupported: DeltaWindow[] = DELTA_WINDOWS.filter((w) =>
  sources.every((s) => s.data.supportedDeltas.includes(w)),
);
const effectiveSupported: DeltaWindow[] =
  allSupported.length > 0
    ? allSupported
    : (sources[0].data.supportedDeltas as DeltaWindow[]);

// Effective default delta:
// 1) dashboardWindow (mapped to closest effectiveSupported)
// 2) chart.defaultDelta (mapped to closest effectiveSupported)
const defaultDelta: DeltaWindow = dashboardWindow
  ? closestSupported(dashboardWindow, effectiveSupported)
  : closestSupported(chart.defaultDelta, effectiveSupported);

// "Window mismatch" — the dashboard/section asked for one window
// but this chart's data couldn't reach it, so closestSupported
// fell back to a different one. We render the duration in bold on
// the tile + dialog descriptor so the reader notices the chart
// isn't actually showing what the dashboard pill claims it is.
// Bold suppressed when dashboard didn't request a specific window
// (the chart is rendering at its own defaultDelta, which can't be
// "mismatched" against nothing).
const windowMismatch: boolean = !!dashboardWindow && dashboardWindow !== defaultDelta;

function trimPoints(ts: TimeSeriesData, supported: DeltaWindow[]): TimeSeriesData {
  if (ts.points.length === 0) return ts;
  const maxDays = Math.max(...supported.map((w) => DELTA_DAYS[w]));
  // Anchor the cutoff to the latest data point, not `Date.now()`, and give a
  // generous buffer (≥ 1 year) so sparse series (quarterly, annual) always
  // keep at least one observation before the longest window's priorMs.
  const lastMs = new Date(ts.points[ts.points.length - 1].t).getTime();
  const cutoffMs = lastMs - (maxDays + 365) * 86400000;
  const trimmed = ts.points.filter((p) => new Date(p.t).getTime() >= cutoffMs);
  return { ...ts, points: trimmed };
}

interface PerSource {
  id: string;
  source: CollectionEntry<"sources">;
  label: string;
  color: string;
  // Full timeseries — present for op'd / fixed-range / preloaded charts
  // where downstream code (server combineTwo, server findPrior-by-date,
  // dialog rendering) needs the full points. Null when we only loaded
  // the tile summary.
  data: TimeSeriesData | null;
  // Compact summary — present for "simple" single-source charts where
  // the tile can render from precomputed priors + sparks alone. Null
  // when `data` is the source of truth.
  summary: TileSummary | null;
  current: { t: string; v: number } | null;
  prior: { t: string; v: number } | null;
  currentStr: string;
  priorStr: string | null;
  delta: ReturnType<typeof formatDeltaDisplay> | null;
  loadError: string | null;
}

// Decide whether we need to load the FULL timeseries for this chart, or
// can get away with just the tile summary. Full data is required when:
//
//   - chartOp is set:        combineTwo(a, b, op) needs both full series
//   - dashboardFixedRange:   priors anchored to a date pair, not a window
//   - preloaded[s.id]:       derived source — caller already has points
//
// "Simple" single/multi-source charts (the bulk of the dashboard) skip
// the full load and just read .summary.json. ~10× smaller per-tile
// payload; full data lazy-fetched client-side on dialog open.
const needsFullData = !!chartOp || !!dashboardFixedRange;

// Resolve every source in parallel. Branches on full vs summary load
// per the rule above. Both `loadSourceData` and `loadSourceForTile`
// are async (HTTP fetch fallback in serverless — see load-data.ts).
const perSourceRaw: PerSource[] = await Promise.all(sources.map(async (s, i) => {
  const label =
    chart.seriesLabels?.[i] ??
    s.data.shortName ??
    s.data.name;
  let data: TimeSeriesData | null = null;
  let summary: TileSummary | null = null;
  let loadError: string | null = null;
  // Preloaded (derived) always wins — caller already has the data.
  const preloadedHere = preloaded?.[s.id];
  if (preloadedHere) {
    data = preloadedHere;
  } else if (needsFullData) {
    try {
      const raw = await loadSourceData(s.data.dataFile);
      if (raw.kind === "timeseries") data = raw;
    } catch (e) {
      const msg = e instanceof Error ? e.message : String(e);
      loadError = `Data unavailable: ${s.data.dataFile} — ${msg.slice(0, 200)}`;
    }
  } else {
    try {
      summary = await loadSourceForTile(
        s.data.dataFile,
        s.data.supportedDeltas as DeltaWindow[],
      );
      if (!summary) {
        loadError = `Data unavailable: ${s.data.dataFile} — empty or missing summary`;
      }
    } catch (e) {
      const msg = e instanceof Error ? e.message : String(e);
      loadError = `Data unavailable: ${s.data.dataFile} — ${msg.slice(0, 200)}`;
    }
  }
  const trimmed = data ? trimPoints(data, s.data.supportedDeltas as DeltaWindow[]) : null;
  const effectiveDeltaForSource: DeltaWindow = closestSupported(
    defaultDelta,
    s.data.supportedDeltas as DeltaWindow[],
  );
  // Compute current/prior from whichever shape we loaded.
  //
  // - Fixed range (full data only): current = last point ≤ end;
  //   prior  = last point ≤ start.
  // - Summary mode: current = summary.latest; prior = summary.priors[w].
  // - Full data, trailing window: identical to current/findPrior on
  //   the full series (existing behavior).
  let current: { t: string; v: number } | null = null;
  let prior: { t: string; v: number } | null = null;
  if (dashboardFixedRange && trimmed) {
    const startMs = new Date(dashboardFixedRange.start).getTime();
    const endMs = new Date(dashboardFixedRange.end).getTime();
    let lastBeforeEnd: TimeSeriesPoint | null = null;
    let lastBeforeStart: TimeSeriesPoint | null = null;
    for (const p of trimmed.points) {
      const t = new Date(p.t).getTime();
      if (t <= endMs) lastBeforeEnd = p;
      if (t <= startMs) lastBeforeStart = p;
      else break;
    }
    current = lastBeforeEnd;
    prior = lastBeforeStart;
  } else if (trimmed) {
    current = currentPoint(trimmed);
    prior = findPriorPoint(trimmed, effectiveDeltaForSource);
  } else if (summary) {
    current = summary.latest;
    prior = summary.priors[effectiveDeltaForSource] ?? null;
  }
  const currentStr = current
    ? formatValue(current.v, s.data.formatting)
    : "—";
  const priorStr = prior ? formatValue(prior.v, s.data.formatting) : null;
  const delta =
    current && prior
      ? formatDeltaDisplay(current.v, prior.v, s.data.formatting)
      : null;
  return {
    id: s.id,
    source: s,
    label,
    color: seriesColor(i),
    data: trimmed,
    summary,
    current,
    prior,
    currentStr,
    priorStr,
    delta,
    loadError,
  };
}));

// If this is an op'd chart, collapse the two perSource entries into a
// single derived entry whose data is the combined timeseries. The rest
// of the rendering pipeline then treats this as a normal single-source
// chart.
let perSource: PerSource[] = perSourceRaw;
if (chartOp && perSourceRaw.length === 2 && perSourceRaw[0].data && perSourceRaw[1].data) {
  const a = perSourceRaw[0];
  const b = perSourceRaw[1];
  // combineOpFormatting returns the right output formatting for the
  // (A unit, B unit, op) combination AND a multiplier we apply to the
  // combined points before display — e.g. currency/currency divide
  // returns percent style + ×100 so "CA federal $ / US GDP" renders
  // as "1.10%" rather than "0.011". applyPercentDisplayOverride lets
  // a chart's `percentDisplay: "decimal"` flag flip the percent
  // output back to a raw 4-decimal ratio (e.g. WTI/Brent → "1.04"
  // rather than "104%").
  const userPercentDisplay = (chart as { percentDisplay?: "percent" | "decimal" })
    .percentDisplay;
  const opFmt = applyPercentDisplayOverride(
    combineOpFormatting(
      a.source.data.formatting,
      b.source.data.formatting,
      chartOp,
      // unitClass discriminates classes that share `style: number`
      // (US GDP-as-currency vs Case-Shiller-as-index, etc.). Each
      // source's unitClass is populated by
      // pipelines/backfill_unit_class.py and surfaces in library.json.
      (a.source.data as { unitClass?: import("../lib/derive").UnitClass })
        .unitClass,
      (b.source.data as { unitClass?: import("../lib/derive").UnitClass })
        .unitClass,
    ),
    userPercentDisplay,
  );
  const rawPoints = combineTwo(a.data!, b.data!, chartOp);
  const combinedPoints = opFmt.multiplier === 1
    ? rawPoints
    : rawPoints.map((p) => ({ t: p.t, v: p.v * opFmt.multiplier }));
  const opFormatting = opFmt.formatting;
  // Synthesize a single virtual perSource entry. We reuse a's source
  // collection entry as the carrier but override formatting through a
  // shadow object passed downstream where possible.
  const combinedData: TimeSeriesData | null =
    combinedPoints.length > 0
      ? {
          id: `${a.id}_${chartOp}_${b.id}`,
          name: `${a.label} ${combineOpLabel(chartOp)} ${b.label}`,
          kind: "timeseries",
          unit:
            chartOp === "divide"
              ? opFormatting.style === "percent"
                ? "%"
                : "ratio"
              : a.data!.unit,
          lastUpdated: a.data!.lastUpdated,
          points: combinedPoints,
        }
      : null;
  // Compute current/prior on the combined series with the same logic
  // used for the underlying singletons.
  let combinedCurrent: { t: string; v: number } | null = null;
  let combinedPrior: { t: string; v: number } | null = null;
  if (combinedData) {
    if (dashboardFixedRange) {
      const startMs = new Date(dashboardFixedRange.start).getTime();
      const endMs = new Date(dashboardFixedRange.end).getTime();
      for (const p of combinedData.points) {
        const t = new Date(p.t).getTime();
        if (t <= endMs) combinedCurrent = p;
        if (t <= startMs) combinedPrior = p;
        else if (t > endMs) break;
      }
    } else {
      combinedCurrent = currentPoint(combinedData);
      const eff = closestSupported(
        defaultDelta,
        a.source.data.supportedDeltas as DeltaWindow[],
      );
      combinedPrior = findPriorPoint(combinedData, eff);
    }
  }
  const currentStr = combinedCurrent
    ? formatValue(combinedCurrent.v, opFormatting)
    : "—";
  const priorStr = combinedPrior
    ? formatValue(combinedPrior.v, opFormatting)
    : null;
  const delta =
    combinedCurrent && combinedPrior
      ? formatDeltaDisplay(combinedCurrent.v, combinedPrior.v, opFormatting)
      : null;
  // Build a synthetic source entry that carries the new formatting so
  // downstream code (tile readouts, dialog readouts, plot tickFormat)
  // displays the derived series correctly. We piggyback on a's
  // CollectionEntry shape and override its data.formatting.
  const syntheticSource = {
    ...a.source,
    data: { ...a.source.data, formatting: opFormatting },
  } as CollectionEntry<"sources">;
  perSource = [
    {
      id: combinedData?.id ?? `${a.id}_${chartOp}_${b.id}`,
      source: syntheticSource,
      label: `${a.label} ${combineOpLabel(chartOp)} ${b.label}`,
      color: seriesColor(0),
      data: combinedData,
      // Op'd charts ship full combined points (there's no .summary.json
      // sibling for a derived series). Summary stays null.
      summary: null,
      current: combinedCurrent,
      prior: combinedPrior,
      currentStr,
      priorStr,
      delta,
      loadError: a.loadError ?? b.loadError,
    },
  ];
}

const primary = perSource[0];
const primarySource = primary.source;

// Effective emphasis for single-source case.
const effectiveEmphasis: "level" | "change" =
  chart.emphasis ?? primarySource.data.emphasis ?? "level";

// Descriptor for single-source (unchanged); for multi-source we render a list.
const directionWord =
  primary.delta?.direction === "up"
    ? "up"
    : primary.delta?.direction === "down"
      ? "down"
      : "roughly unchanged";

// singleDescriptor is split into (prefix, duration, suffix) so the
// duration can be wrapped in a span the CSS bolds when the chart's
// effective window mismatches the dashboard-requested one. When the
// chart has no prior reading (no over-the-X clause) the descriptor
// is just a one-shot string and duration is null.
type SingleDescriptorParts = {
  prefix: string;
  duration: string | null;
  suffix: string;
};
const singleDescriptor: SingleDescriptorParts =
  primary.current && primary.prior && primary.priorStr && primary.delta
    ? primary.delta.direction === "flat"
      ? {
          prefix: `${primarySource.data.name} is at ${primary.currentStr}, roughly unchanged over the `,
          duration: DELTA_LABELS_PAST[defaultDelta],
          suffix: ".",
        }
      : {
          prefix: `${primarySource.data.name} is at ${primary.currentStr}, ${directionWord} from ${primary.priorStr} over the `,
          duration: DELTA_LABELS_PAST[defaultDelta],
          suffix: ` (${primary.delta.text}).`,
        }
    : primary.current
      ? {
          prefix: `${primarySource.data.name} is at ${primary.currentStr}.`,
          duration: null,
          suffix: "",
        }
      : { prefix: "Data unavailable.", duration: null, suffix: "" };

const uniqueId = `dialog-${dashboardSlug}-${chartId.replace(/[^a-z0-9-]/gi, "-")}`;

const payload = {
  // chartId is forwarded so the client-side controller can attach it to
  // telemetry events (e.g. chart_image_exported) and any future per-chart
  // operations without re-deriving it from the normalized dialog ID.
  chartId,
  // Surface where this chart is being rendered — preset dashboard slug
  // (e.g. "us-macro"), "custom" for URL-state, "u-<slug>" for a saved
  // dashboard. Used by chart_expanded telemetry so we can answer
  // "which charts on which surfaces actually get opened?"
  surface: dashboardSlug,
  // Chart title — needed so the "Open as new dashboard" action can name
  // the resulting composed state with something more useful than "Untitled."
  title: chart.title,
  isMulti,
  normalize,
  // Y-axis scale ("linear" | "log"). Forwarded from chart spec so the
  // client renderer can pass type:"log" to Plot when set. Log + dual-axis
  // is meaningless (one log, one linear is misleading) so the renderer
  // ignores log when normalize === "dual-axis".
  scale: (chart as { scale?: "linear" | "log" }).scale ?? "linear",
  // Optional arithmetic op (divide/sum/diff) — collapsed at render time
  // but preserved here so "Open as new dashboard" can reconstruct the
  // original chart spec faithfully for inline charts.
  op: (chart as { op?: "divide" | "sum" | "diff" }).op,
  rightAxisSources: (chart as { rightAxisSources?: string[] }).rightAxisSources,
  // Background shading layers (see src/lib/shading-presets.ts). Each
  // preset key resolves to a list of date bands rendered as semi-
  // transparent rects behind the line on the dialog plot. Optional —
  // when omitted/empty, no bands draw.
  shading: (chart as { shading?: string[] }).shading,
  // Default y-axis transform for the dialog plot (level / yoy_pct /
  // index_100). Tile stays in level mode regardless; the pill row
  // in the dialog overrides per-session without persisting. See
  // src/lib/transforms.ts for the math.
  transform: (chart as { transform?: "level" | "yoy_pct" | "index_100" }).transform ?? "level",
  // Editorial annotations — labelled date markers rendered on the
  // dialog plot. See src/lib/annotations.ts.
  annotations:
    (chart as { annotations?: { date: string; label: string; position?: "above" | "below" }[] }).annotations,
  supportedDeltas: effectiveSupported,
  defaultDelta,
  fixedRange: dashboardFixedRange,
  // Each source ships in one of two shapes:
  //   - Full mode  ({ points }):   op'd / fixed-range / derived charts.
  //     Server has the full timeseries; dialog renders directly without
  //     a lazy fetch.
  //   - Summary mode ({ summary, dataFile }): single/multi-source
  //     trailing-window charts. Tile renders from precomputed priors +
  //     sparks; dialog open fires a fetch against dataFile to hydrate
  //     full `points` on demand.
  //
  // shortNames stay the same, formatting + supportedDeltas + emphasis
  // are needed in both shapes (window pill switching, etc.). dataFile
  // is included in BOTH shapes because the lazy-fetch path needs it,
  // and "Copy embed link" / "Open as new dashboard" sometimes round-
  // trip the source id back through the manifest.
  sources: perSource
    .filter((p) => p.data !== null || p.summary !== null)
    .map((p) => {
      const base = {
        id: p.id,
        name: p.source.data.name,
        shortName: p.label,
        color: p.color,
        formatting: p.source.data.formatting,
        supportedDeltas: p.source.data.supportedDeltas,
        emphasis: p.source.data.emphasis,
        dataFile: p.source.data.dataFile,
        provider: p.source.data.provenance?.provider ?? "Unknown",
        lastUpdated: p.data?.lastUpdated ?? p.summary!.lastUpdated,
      };
      if (p.data) {
        // Full mode: include all projection vintages so the dialog can
        // render the latest and (Phase 3) let the user pick an older one.
        // Op'd / combined series never carry projections — combineTwo
        // produces a derived points-only series.
        const projections = (p.data as { projections?: import("../lib/data-types").Projections })
          .projections;
        return projections
          ? { ...base, points: p.data.points, projections }
          : { ...base, points: p.data.points };
      }
      // Summary mode. Cast away Partial<> for client consumption — at use
      // sites we still check defined-ness because not every window may be
      // populated (sparse series, etc.).
      //
      // latestProjection ships per-tile when the source has projections;
      // the full vintage history isn't loaded until dialog-open lazy-fetch.
      return {
        ...base,
        summary: {
          latest: p.summary!.latest,
          priors: p.summary!.priors,
          sparks: p.summary!.sparks,
          ...(p.summary!.latestProjection
            ? { latestProjection: p.summary!.latestProjection }
            : {}),
        },
      };
    }),
};

const anyLoadError = perSource.find((p) => p.loadError);
const blurb = chart.blurb;

// For "Updated" footer, use the most recent among sources.
const mostRecentUpdate = payload.sources
  .map((s) => s.lastUpdated)
  .sort()
  .at(-1);
---

<button
  type="button"
  class={"chart-tile" + (isMulti ? " chart-tile-multi" : "")}
  data-chart-ref={uniqueId}
  data-emphasis={effectiveEmphasis}
  data-multi={isMulti ? "true" : "false"}
  data-series-count={String(perSource.length)}
  data-section-locked={sectionLocked ? "1" : undefined}
  data-dashboard-window={dashboardWindow ?? undefined}
  aria-haspopup="dialog"
  aria-label={`${chart.title} details`}
>
  <div class="tile-title">{chart.title}</div>

  {
    isMulti ? (
      <ul class="tile-series-list tabular" data-role="tile-series-list">
        {perSource.map((p) => (
          <li class="tile-series-row">
            <span class="series-dot" style={`background: ${p.color}`} />
            <span class="series-label">{p.label}</span>
            <span
              class="series-delta"
              data-role="series-delta"
              data-source-id={p.id}
              data-direction={p.delta?.direction ?? "flat"}
            >
              {p.delta ? p.delta.text : "—"}
            </span>
          </li>
        ))}
      </ul>
    ) : (
      <div class="tile-reading tabular">
        <span class="tile-value" data-role="tile-value">
          {primary.currentStr}
        </span>
        {primary.delta && (
          <span
            class="tile-delta"
            data-role="tile-delta"
            data-direction={primary.delta.direction}
          >
            {primary.delta.text}
          </span>
        )}
      </div>
    )
  }

  <div class="tile-spark" data-role="tile-spark" />
  <div
    class="tile-window muted"
    data-window-mismatch={windowMismatch ? "1" : undefined}
  >
    over the{" "}
    <span class="window-duration" data-role="window-duration">
      {DELTA_LABELS_PAST[defaultDelta]}
    </span>
  </div>
</button>

<dialog
  id={uniqueId}
  class="chart-dialog"
  data-chart-ref={uniqueId}
  data-emphasis={effectiveEmphasis}
  data-multi={isMulti ? "true" : "false"}
  data-dashboard-window={dashboardWindow ?? undefined}
  aria-labelledby={`${uniqueId}-title`}
>
  <div class="dialog-close-bar">
    <button
      type="button"
      class="dialog-action-btn"
      data-role="copy-image"
      aria-label="Copy chart as image to clipboard"
      title="Copy a watermarked PNG of this chart to the clipboard — paste it into Substack, a doc, or a slide"
    >
      Copy chart as image
    </button>
    <button
      type="button"
      class="dialog-action-btn"
      data-role="copy-embed-link"
      aria-label="Copy embed link for Substack, Twitter, etc."
      title="Copy a link that unfurls into a chart preview when pasted into Substack, Twitter, Slack, or Discord"
    >
      Copy embed link
    </button>
    <button
      type="button"
      class="dialog-action-btn"
      data-role="copy-embed-iframe"
      aria-label="Copy iframe embed code for blog posts"
      title="Copy an iframe HTML snippet that renders this chart live inside a blog post, Substack, or wiki. Includes the current window selection."
    >
      Copy embed code
    </button>
    <button
      type="button"
      class="dialog-action-btn"
      data-role="open-as-dashboard"
      aria-label="Open this chart as a new dashboard"
      title="Open the composer with this chart already added — a starting point to build around"
    >
      Open as new dashboard
    </button>
    <button
      type="button"
      class="dialog-action-btn"
      data-role="copy-citation"
      aria-label="Copy citation block to clipboard"
      title="Copy a citation block (title, providers, dates, URL) for use in a memo footnote or article reference"
    >
      Copy citation
    </button>
    <button type="button" class="dialog-close" aria-label="Close">
      &times;
    </button>
  </div>
  <div class="dialog-body">
    <header class="dialog-header">
      <h2 id={`${uniqueId}-title`}>{chart.title}</h2>
      {
        !isMulti && primarySource.data.description && (
          <p class="dialog-subtitle">{primarySource.data.description}</p>
        )
      }
    </header>

    {
      anyLoadError ? (
        <p class="dialog-error">{anyLoadError.loadError}</p>
      ) : isMulti ? (
        <div class="dialog-multi-readouts" data-role="multi-readouts">
          {perSource.map((p) => (
            <div class="multi-readout-row tabular" data-source-id={p.id}>
              <span class="series-dot" style={`background: ${p.color}`} />
              <span class="readout-label">{p.label}</span>
              <span class="readout-level" data-role="readout-level">
                {p.currentStr}
              </span>
              {p.delta && (
                <span
                  class="readout-delta-multi"
                  data-role="readout-delta"
                  data-direction={p.delta.direction}
                >
                  {p.delta.text}
                </span>
              )}
            </div>
          ))}
          <p
            class="multi-caption muted"
            data-role="descriptor"
            data-window-mismatch={windowMismatch ? "1" : undefined}
          >
            Over the{" "}
            <span class="window-duration" data-role="window-duration">
              {DELTA_LABELS_PAST[defaultDelta]}
            </span>
            .
          </p>
        </div>
      ) : (
        <>
          <div class="readout-row tabular">
            <span class="readout-value" data-role="value">
              {primary.currentStr}
            </span>
            {primary.delta && (
              <span
                class="readout-delta"
                data-role="delta-pct"
                data-direction={primary.delta.direction}
              >
                {primary.delta.text}
              </span>
            )}
          </div>
          <p
            class="descriptor"
            data-role="descriptor"
            data-window-mismatch={windowMismatch ? "1" : undefined}
          >
            {singleDescriptor.prefix}
            {singleDescriptor.duration && (
              <span class="window-duration" data-role="window-duration">
                {singleDescriptor.duration}
              </span>
            )}
            {singleDescriptor.suffix}
          </p>
        </>
      )
    }

    {
      !anyLoadError && (
        <>
          <div class="pills" role="group" aria-label="Delta window">
            {dashboardFixedRange && (
              <button
                type="button"
                class="pill pill-active"
                data-window="fixed"
                aria-pressed="true"
                title={`Custom range: ${dashboardFixedRange.start} → ${dashboardFixedRange.end}`}
              >
                Custom ({dashboardFixedRange.start} → {dashboardFixedRange.end})
              </button>
            )}
            {effectiveSupported.map((w) => (
              <button
                type="button"
                class={
                  "pill" +
                  (!dashboardFixedRange && w === defaultDelta ? " pill-active" : "")
                }
                data-window={w}
                aria-pressed={
                  !dashboardFixedRange && w === defaultDelta ? "true" : "false"
                }
              >
                {DELTA_LABELS_SHORT[w]}
              </button>
            ))}
          </div>
          {/* Y-axis transformation pills. Default = chart.transform (or
              "level" when unset). Per-session — clicking re-renders the
              full plot in the new view but doesn't persist back to
              the saved chart. See src/lib/transforms.ts for the math. */}
          <div class="pills transform-pills" role="group" aria-label="Y-axis transformation">
            <button
              type="button"
              class={"pill" + (payload.transform === "level" ? " pill-active" : "")}
              data-transform="level"
              aria-pressed={payload.transform === "level" ? "true" : "false"}
              title="Plot values at their stored level — no transformation."
            >
              Level
            </button>
            <button
              type="button"
              class={"pill" + (payload.transform === "yoy_pct" ? " pill-active" : "")}
              data-transform="yoy_pct"
              aria-pressed={payload.transform === "yoy_pct" ? "true" : "false"}
              title="Year-over-year percent change at each date. Drops the first year of points."
            >
              YoY %
            </button>
            <button
              type="button"
              class={"pill" + (payload.transform === "index_100" ? " pill-active" : "")}
              data-transform="index_100"
              aria-pressed={payload.transform === "index_100" ? "true" : "false"}
              title="Rebase the visible window: first point = 100, everything else proportional."
            >
              Index = 100
            </button>
          </div>
          {isMulti && normalize === "rebase" && (
            <p class="dialog-plot-caption muted">
              Values rebased to 100 at window start.
            </p>
          )}
          <div class="dialog-plot" data-role="plot" />
        </>
      )
    }

    {blurb && (
      <div class="dialog-blurb">
        <Fragment set:html={blurb} />
      </div>
    )}

    <footer class="dialog-footer muted">
      {
        isMulti ? (
          <span>
            Sources:{" "}
            {perSource.map((p, i) => (
              <>
                {i > 0 && ", "}
                <a
                  href={`/source/${p.source.id}/`}
                  title={`Open the source page for ${p.label}: provenance, license, citation, related charts.`}
                >
                  {p.label}
                </a>
                {p.source.data.provenance.url && (
                  <>
                    {" "}
                    (<a
                      href={p.source.data.provenance.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      title="Open the upstream provider's page"
                    >
                      upstream
                    </a>)
                  </>
                )}
              </>
            ))}
          </span>
        ) : (
          <span>
            Source:{" "}
            <a
              href={`/source/${primarySource.id}/`}
              title="Open the source page: provenance, license, citation, related charts."
            >
              {primarySource.data.provenance.provider}
              {primarySource.data.provenance.series &&
                ` — ${primarySource.data.provenance.series}`}
            </a>
            {primarySource.data.provenance.url && (
              <>
                {" "}
                (<a
                  href={primarySource.data.provenance.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  title="Open the upstream provider's page"
                >
                  upstream
                </a>)
              </>
            )}
          </span>
        )
      }
      {mostRecentUpdate && <span>Updated {formatDate(mostRecentUpdate)}</span>}
      <span class="dialog-footer-attribution">
        Chart made by: <strong>{SITE_BRAND_URL}</strong>
      </span>
    </footer>
  </div>

  {
    !anyLoadError && (
      <script
        is:inline
        type="application/json"
        data-chart-payload
        set:html={JSON.stringify(payload)}
      />
    )
  }
</dialog>

