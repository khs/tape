---
import type { CollectionEntry } from "astro:content";
import { loadSourceData, currentPoint, findPriorPoint } from "../lib/load-data";
import {
  formatValue,
  formatDelta,
  formatDeltaDisplay,
  formatDate,
} from "../lib/format";
import {
  DELTA_DAYS,
  DELTA_LABELS_PAST,
  DELTA_LABELS_SHORT,
  closestSupported,
  DELTA_WINDOWS,
  type DeltaWindow,
} from "../lib/deltas";
import type { TimeSeriesData } from "../lib/data-types";
import { seriesColor } from "../lib/series-colors";

type ChartData = CollectionEntry<"charts">["data"];

interface Props {
  chartId: string;
  chart: ChartData;
  sources: CollectionEntry<"sources">[];
  dashboardSlug: string;
  dashboardWindow?: DeltaWindow;
  // When set, the chart renders a fixed [start, end] date range instead of
  // a trailing window. Both bounds are ISO YYYY-MM-DD. Wins over
  // dashboardWindow when present.
  dashboardFixedRange?: { start: string; end: string };
}

const { chartId, chart, sources, dashboardSlug, dashboardWindow, dashboardFixedRange } =
  Astro.props;

const isMulti = sources.length > 1;
// Resolve normalize mode. If the chart didn't set one, pick a sensible
// default: "rebase" for multi-source charts, "raw" for single. Heuristic
// for same-scale multi-source ("3 percent rates": all match formatting +
// unit) is applied at compose time when the inline chart is built; when
// it's already explicit on the chart we honor whatever was set.
const normalize: "rebase" | "raw" | "dual-axis" =
  (chart.normalize as "rebase" | "raw" | "dual-axis" | undefined) ??
  (isMulti ? "rebase" : "raw");

// Effective supportedDeltas = intersection of sources' supportedDeltas.
// Preserve the canonical order (DELTA_WINDOWS order).
const allSupported: DeltaWindow[] = DELTA_WINDOWS.filter((w) =>
  sources.every((s) => s.data.supportedDeltas.includes(w)),
);
const effectiveSupported: DeltaWindow[] =
  allSupported.length > 0
    ? allSupported
    : (sources[0].data.supportedDeltas as DeltaWindow[]);

// Effective default delta:
// 1) dashboardWindow (mapped to closest effectiveSupported)
// 2) chart.defaultDelta (mapped to closest effectiveSupported)
const defaultDelta: DeltaWindow = dashboardWindow
  ? closestSupported(dashboardWindow, effectiveSupported)
  : closestSupported(chart.defaultDelta, effectiveSupported);

function trimPoints(ts: TimeSeriesData, supported: DeltaWindow[]): TimeSeriesData {
  if (ts.points.length === 0) return ts;
  const maxDays = Math.max(...supported.map((w) => DELTA_DAYS[w]));
  // Anchor the cutoff to the latest data point, not `Date.now()`, and give a
  // generous buffer (≥ 1 year) so sparse series (quarterly, annual) always
  // keep at least one observation before the longest window's priorMs.
  const lastMs = new Date(ts.points[ts.points.length - 1].t).getTime();
  const cutoffMs = lastMs - (maxDays + 365) * 86400000;
  const trimmed = ts.points.filter((p) => new Date(p.t).getTime() >= cutoffMs);
  return { ...ts, points: trimmed };
}

interface PerSource {
  id: string;
  source: CollectionEntry<"sources">;
  label: string;
  color: string;
  data: TimeSeriesData | null;
  current: { t: string; v: number } | null;
  prior: { t: string; v: number } | null;
  currentStr: string;
  priorStr: string | null;
  delta: ReturnType<typeof formatDelta> | null;
  loadError: string | null;
}

const perSource: PerSource[] = sources.map((s, i) => {
  const label =
    chart.seriesLabels?.[i] ??
    s.data.shortName ??
    s.data.name;
  let data: TimeSeriesData | null = null;
  let loadError: string | null = null;
  try {
    const raw = loadSourceData(s.data.dataFile);
    if (raw.kind === "timeseries") data = raw;
  } catch (e) {
    loadError = `Data unavailable: ${s.data.dataFile}`;
  }
  const trimmed = data ? trimPoints(data, s.data.supportedDeltas as DeltaWindow[]) : null;
  const effectiveDeltaForSource: DeltaWindow = closestSupported(
    defaultDelta,
    s.data.supportedDeltas as DeltaWindow[],
  );
  // For a fixed-range chart, current = last point at-or-before end;
  // prior = last point at-or-before start. (Using "at-or-before" for both
  // matches how the UI reads "as of <end>" / "as of <start>".)
  let current: { t: string; v: number } | null = null;
  let prior: { t: string; v: number } | null = null;
  if (dashboardFixedRange && trimmed) {
    const startMs = new Date(dashboardFixedRange.start).getTime();
    const endMs = new Date(dashboardFixedRange.end).getTime();
    let lastBeforeEnd: { t: string; v: number } | null = null;
    let lastBeforeStart: { t: string; v: number } | null = null;
    for (const p of trimmed.points) {
      const t = new Date(p.t).getTime();
      if (t <= endMs) lastBeforeEnd = p;
      if (t <= startMs) lastBeforeStart = p;
      else break; // points are sorted; nothing later will help start
    }
    current = lastBeforeEnd;
    prior = lastBeforeStart;
  } else if (trimmed) {
    current = currentPoint(trimmed);
    prior = findPriorPoint(trimmed, effectiveDeltaForSource);
  }
  const currentStr = current
    ? formatValue(current.v, s.data.formatting)
    : "—";
  const priorStr = prior ? formatValue(prior.v, s.data.formatting) : null;
  const delta =
    current && prior
      ? formatDeltaDisplay(current.v, prior.v, s.data.formatting)
      : null;
  return {
    id: s.id,
    source: s,
    label,
    color: seriesColor(i),
    data: trimmed,
    current,
    prior,
    currentStr,
    priorStr,
    delta,
    loadError,
  };
});

const primary = perSource[0];
const primarySource = primary.source;

// Effective emphasis for single-source case.
const effectiveEmphasis: "level" | "change" =
  chart.emphasis ?? primarySource.data.emphasis ?? "level";

// Descriptor for single-source (unchanged); for multi-source we render a list.
const directionWord =
  primary.delta?.direction === "up"
    ? "up"
    : primary.delta?.direction === "down"
      ? "down"
      : "roughly unchanged";

const singleDescriptor =
  primary.current && primary.prior && primary.priorStr && primary.delta
    ? primary.delta.direction === "flat"
      ? `${primarySource.data.name} is at ${primary.currentStr}, roughly unchanged over the ${DELTA_LABELS_PAST[defaultDelta]}.`
      : `${primarySource.data.name} is at ${primary.currentStr}, ${directionWord} from ${primary.priorStr} over the ${DELTA_LABELS_PAST[defaultDelta]} (${primary.delta.text}).`
    : primary.current
      ? `${primarySource.data.name} is at ${primary.currentStr}.`
      : "Data unavailable.";

const uniqueId = `dialog-${dashboardSlug}-${chartId.replace(/[^a-z0-9-]/gi, "-")}`;

const payload = {
  isMulti,
  normalize,
  rightAxisSources: (chart as { rightAxisSources?: string[] }).rightAxisSources,
  supportedDeltas: effectiveSupported,
  defaultDelta,
  fixedRange: dashboardFixedRange,
  sources: perSource
    .filter((p) => p.data !== null)
    .map((p) => ({
      id: p.id,
      name: p.source.data.name,
      shortName: p.label,
      color: p.color,
      formatting: p.source.data.formatting,
      supportedDeltas: p.source.data.supportedDeltas,
      emphasis: p.source.data.emphasis,
      points: p.data!.points,
      lastUpdated: p.data!.lastUpdated,
    })),
};

const anyLoadError = perSource.find((p) => p.loadError);
const blurb = chart.blurb;

// For "Updated" footer, use the most recent among sources.
const mostRecentUpdate = payload.sources
  .map((s) => s.lastUpdated)
  .sort()
  .at(-1);
---

<button
  type="button"
  class={"chart-tile" + (isMulti ? " chart-tile-multi" : "")}
  data-chart-ref={uniqueId}
  data-emphasis={effectiveEmphasis}
  data-multi={isMulti ? "true" : "false"}
  aria-haspopup="dialog"
  aria-label={`${chart.title} details`}
>
  <div class="tile-title">{chart.title}</div>

  {
    isMulti ? (
      <ul class="tile-series-list tabular" data-role="tile-series-list">
        {perSource.map((p) => (
          <li class="tile-series-row">
            <span class="series-dot" style={`background: ${p.color}`} />
            <span class="series-label">{p.label}</span>
            <span
              class="series-delta"
              data-role="series-delta"
              data-source-id={p.id}
              data-direction={p.delta?.direction ?? "flat"}
            >
              {p.delta ? p.delta.text : "—"}
            </span>
          </li>
        ))}
      </ul>
    ) : (
      <div class="tile-reading tabular">
        <span class="tile-value" data-role="tile-value">
          {primary.currentStr}
        </span>
        {primary.delta && (
          <span
            class="tile-delta"
            data-role="tile-delta"
            data-direction={primary.delta.direction}
          >
            {primary.delta.text}
          </span>
        )}
      </div>
    )
  }

  <div class="tile-spark" data-role="tile-spark" />
  <div class="tile-window muted">
    over the {DELTA_LABELS_PAST[defaultDelta]}
  </div>
</button>

<dialog
  id={uniqueId}
  class="chart-dialog"
  data-chart-ref={uniqueId}
  data-emphasis={effectiveEmphasis}
  data-multi={isMulti ? "true" : "false"}
  aria-labelledby={`${uniqueId}-title`}
>
  <div class="dialog-close-bar">
    <button type="button" class="dialog-close" aria-label="Close">
      &times;
    </button>
  </div>
  <div class="dialog-body">
    <header class="dialog-header">
      <h2 id={`${uniqueId}-title`}>{chart.title}</h2>
      {
        !isMulti && primarySource.data.description && (
          <p class="dialog-subtitle">{primarySource.data.description}</p>
        )
      }
    </header>

    {
      anyLoadError ? (
        <p class="dialog-error">{anyLoadError.loadError}</p>
      ) : isMulti ? (
        <div class="dialog-multi-readouts" data-role="multi-readouts">
          {perSource.map((p) => (
            <div class="multi-readout-row tabular" data-source-id={p.id}>
              <span class="series-dot" style={`background: ${p.color}`} />
              <span class="readout-label">{p.label}</span>
              <span class="readout-level" data-role="readout-level">
                {p.currentStr}
              </span>
              {p.delta && (
                <span
                  class="readout-delta-multi"
                  data-role="readout-delta"
                  data-direction={p.delta.direction}
                >
                  {p.delta.text}
                </span>
              )}
            </div>
          ))}
          <p class="multi-caption muted" data-role="descriptor">
            Over the {DELTA_LABELS_PAST[defaultDelta]}.
          </p>
        </div>
      ) : (
        <>
          <div class="readout-row tabular">
            <span class="readout-value" data-role="value">
              {primary.currentStr}
            </span>
            {primary.delta && (
              <span
                class="readout-delta"
                data-role="delta-pct"
                data-direction={primary.delta.direction}
              >
                {primary.delta.text}
              </span>
            )}
          </div>
          <p class="descriptor" data-role="descriptor">
            {singleDescriptor}
          </p>
        </>
      )
    }

    {
      !anyLoadError && (
        <>
          <div class="pills" role="group" aria-label="Delta window">
            {dashboardFixedRange && (
              <button
                type="button"
                class="pill pill-active"
                data-window="fixed"
                aria-pressed="true"
                title={`Custom range: ${dashboardFixedRange.start} → ${dashboardFixedRange.end}`}
              >
                Custom ({dashboardFixedRange.start} → {dashboardFixedRange.end})
              </button>
            )}
            {effectiveSupported.map((w) => (
              <button
                type="button"
                class={
                  "pill" +
                  (!dashboardFixedRange && w === defaultDelta ? " pill-active" : "")
                }
                data-window={w}
                aria-pressed={
                  !dashboardFixedRange && w === defaultDelta ? "true" : "false"
                }
              >
                {DELTA_LABELS_SHORT[w]}
              </button>
            ))}
          </div>
          {isMulti && normalize === "rebase" && (
            <p class="dialog-plot-caption muted">
              Values rebased to 100 at window start.
            </p>
          )}
          <div class="dialog-plot" data-role="plot" />
        </>
      )
    }

    {blurb && (
      <div class="dialog-blurb">
        <Fragment set:html={blurb} />
      </div>
    )}

    <footer class="dialog-footer muted">
      {
        isMulti ? (
          <span>
            Sources:{" "}
            {perSource.map((p, i) => (
              <>
                {i > 0 && ", "}
                {p.source.data.provenance.url ? (
                  <a
                    href={p.source.data.provenance.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {p.label}
                  </a>
                ) : (
                  <span>{p.label}</span>
                )}
              </>
            ))}
          </span>
        ) : (
          <span>
            Source: {primarySource.data.provenance.provider}
            {primarySource.data.provenance.series &&
              ` — ${primarySource.data.provenance.series}`}
            {primarySource.data.provenance.url && (
              <>
                {" "}
                (<a
                  href={primarySource.data.provenance.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  link
                </a>)
              </>
            )}
          </span>
        )
      }
      {mostRecentUpdate && <span>Updated {formatDate(mostRecentUpdate)}</span>}
    </footer>
  </div>

  {
    !anyLoadError && (
      <script
        type="application/json"
        data-chart-payload
        set:html={JSON.stringify(payload)}
      />
    )
  }
</dialog>

<style>
  .chart-tile {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
    text-align: left;
    padding: 14px 14px 12px;
    background: var(--color-white);
    border: 1px solid rgba(55, 53, 47, 0.08);
    border-radius: var(--radius);
    cursor: pointer;
    font: inherit;
    color: inherit;
    transition: border-color 0.15s, transform 0.08s;
  }
  .chart-tile:hover {
    border-color: rgba(55, 53, 47, 0.18);
  }
  .chart-tile:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .chart-tile:active {
    transform: translateY(1px);
  }
  .tile-title {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-neutral-600);
    letter-spacing: 0.005em;
    line-height: 1.3;
  }
  .chart-tile:not(.chart-tile-multi) .tile-title {
    min-height: 2.6em;
  }
  .tile-reading {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }
  .tile-value {
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--color-neutral-900);
    line-height: 1.1;
  }
  .tile-delta {
    font-size: var(--text-sm);
    font-weight: 500;
  }
  .tile-delta[data-direction="up"],
  .series-delta[data-direction="up"] {
    color: var(--color-success);
  }
  .tile-delta[data-direction="down"],
  .series-delta[data-direction="down"] {
    color: var(--color-error);
  }
  .tile-delta[data-direction="flat"],
  .series-delta[data-direction="flat"] {
    color: var(--color-neutral-500);
  }
  .chart-tile[data-emphasis="change"]:not(.chart-tile-multi) .tile-reading {
    flex-direction: row-reverse;
    justify-content: flex-end;
  }
  .chart-tile[data-emphasis="change"]:not(.chart-tile-multi) .tile-value {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-neutral-500);
  }
  .chart-tile[data-emphasis="change"]:not(.chart-tile-multi) .tile-delta {
    font-size: var(--text-xl);
    font-weight: 600;
  }
  .tile-series-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .tile-series-row {
    display: grid;
    grid-template-columns: 10px 1fr auto;
    align-items: baseline;
    gap: 8px;
    font-size: var(--text-sm);
  }
  .series-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    transform: translateY(0.5px);
  }
  .series-label {
    font-weight: 500;
    color: var(--color-neutral-700);
  }
  .series-delta {
    font-weight: 500;
    text-align: right;
  }
  .tile-spark {
    height: 36px;
    margin-top: 2px;
  }
  .tile-spark svg {
    display: block;
  }
  .tile-window {
    font-size: var(--text-xs);
  }
  .muted {
    color: var(--color-neutral-500);
  }

  .chart-dialog {
    width: min(92vw, 820px);
    max-height: 90vh;
    padding: 0;
    border: none;
    border-radius: var(--radius-lg);
    box-shadow:
      0 8px 32px rgba(55, 53, 47, 0.12),
      0 2px 8px rgba(55, 53, 47, 0.08);
    background: var(--color-white);
    color: var(--color-neutral-900);
  }
  .chart-dialog::backdrop {
    background: rgba(55, 53, 47, 0.45);
  }
  .dialog-close-bar {
    display: flex;
    justify-content: flex-end;
    padding: 8px 10px 0;
  }
  .dialog-close {
    background: transparent;
    border: none;
    font-size: 22px;
    line-height: 1;
    color: var(--color-neutral-500);
    cursor: pointer;
    padding: 4px 8px;
    border-radius: var(--radius-sm);
  }
  .dialog-close:hover {
    background: var(--color-neutral-100);
    color: var(--color-neutral-900);
  }
  .dialog-body {
    padding: 0 28px 24px;
    overflow-y: auto;
    max-height: calc(90vh - 40px);
  }
  .dialog-header h2 {
    font-size: var(--text-xl);
    font-weight: 600;
    margin: 0;
  }
  .dialog-subtitle {
    margin: 4px 0 0;
    font-size: var(--text-sm);
    color: var(--color-neutral-500);
  }
  .readout-row {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-top: 20px;
  }
  .readout-value {
    font-size: var(--text-3xl);
    font-weight: 600;
    line-height: 1;
  }
  .readout-delta {
    font-size: var(--text-lg);
    font-weight: 500;
  }
  .readout-delta[data-direction="up"],
  .readout-delta-multi[data-direction="up"] {
    color: var(--color-success);
  }
  .readout-delta[data-direction="down"],
  .readout-delta-multi[data-direction="down"] {
    color: var(--color-error);
  }
  .readout-delta[data-direction="flat"],
  .readout-delta-multi[data-direction="flat"] {
    color: var(--color-neutral-500);
  }
  .chart-dialog[data-emphasis="change"][data-multi="false"] .readout-row {
    flex-direction: row-reverse;
    justify-content: flex-end;
  }
  .chart-dialog[data-emphasis="change"][data-multi="false"] .readout-value {
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--color-neutral-500);
  }
  .chart-dialog[data-emphasis="change"][data-multi="false"] .readout-delta {
    font-size: var(--text-3xl);
    font-weight: 600;
  }
  .descriptor {
    margin: 12px 0 16px;
    font-size: var(--text-sm);
    color: var(--color-neutral-700);
    line-height: 1.55;
    max-width: 56ch;
  }
  .dialog-multi-readouts {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 20px;
    margin-bottom: 16px;
  }
  .multi-readout-row {
    display: grid;
    grid-template-columns: 12px 1fr auto auto;
    align-items: baseline;
    gap: 12px;
    padding: 4px 0;
    font-size: var(--text-base);
  }
  .readout-label {
    font-weight: 500;
    color: var(--color-neutral-800);
  }
  .readout-level {
    font-size: var(--text-sm);
    color: var(--color-neutral-500);
  }
  .readout-delta-multi {
    font-size: var(--text-base);
    font-weight: 600;
    text-align: right;
    min-width: 70px;
  }
  .multi-caption {
    font-size: var(--text-xs);
    margin: 4px 0 0;
  }
  .pills {
    display: flex;
    gap: 4px;
    margin-bottom: 16px;
    font-size: var(--text-xs);
    font-weight: 500;
  }
  .pill {
    padding: 4px 10px;
    border: 1px solid rgba(55, 53, 47, 0.1);
    border-radius: var(--radius-sm);
    background: var(--color-white);
    color: var(--color-neutral-600);
    cursor: pointer;
    font: inherit;
    transition: background 0.1s, color 0.1s;
  }
  .pill:hover {
    background: var(--color-neutral-100);
  }
  .pill-active {
    background: var(--color-neutral-900);
    color: var(--color-white);
    border-color: var(--color-neutral-900);
  }
  .dialog-plot {
    min-height: 260px;
    margin-bottom: 16px;
  }
  .dialog-plot-caption {
    font-size: var(--text-xs);
    margin: 0 0 6px;
  }
  .dialog-blurb {
    padding: 14px 0;
    font-size: var(--text-sm);
    color: var(--color-neutral-700);
    line-height: 1.6;
    border-top: 1px solid rgba(55, 53, 47, 0.08);
    border-bottom: 1px solid rgba(55, 53, 47, 0.08);
    max-width: 60ch;
  }
  .dialog-footer {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    font-size: var(--text-xs);
    margin-top: 14px;
  }
  .dialog-footer a {
    color: var(--color-neutral-500);
    text-decoration: underline;
    text-decoration-color: rgba(55, 53, 47, 0.2);
  }
  .dialog-footer a:hover {
    color: var(--color-neutral-700);
  }
  .dialog-error {
    padding: 20px;
    background: var(--color-neutral-100);
    border-radius: var(--radius);
    color: var(--color-neutral-600);
    font-size: var(--text-sm);
    margin-top: 20px;
  }
</style>
