---
/**
 * Shared dashboard body: the window-selector (or fixed-range chip), the
 * section loop with per-section window/range precedence, and the chart grid.
 * Extracted from the three renderers ([...slug], custom, index) that each
 * hand-rolled this same markup + CSS. Page chrome (header, fork/share links,
 * SEO, marketing hero, ChartController/Analytics mounts) stays on the page;
 * this component is purely the grid.
 *
 * Per-section precedence (preserved from the originals): a section's own
 * `defaultDelta`/`fixedRange` beats the dashboard-level default, which beats
 * the chart's own. `fixedRange` beats `defaultDelta` when both are set.
 */
import SectionChart from "./SectionChart.astro";
import { effectiveChart, type ResolvedSection } from "../lib/resolve-dashboard";
import { DELTA_LABELS_SHORT, type DeltaWindow } from "../lib/deltas";
import type { BarSnapshotEntry } from "../lib/resolve-bar-snapshots";
import { renderMarkdown } from "../lib/markdown";
import type { CollectionEntry } from "astro:content";

interface Props {
  sections: ResolvedSection[];
  supportedDeltas: DeltaWindow[];
  defaultDelta: DeltaWindow;
  dashboardSlug: string;
  fixedRange?: { start: string; end: string };
  chartOverrides?: Record<string, Partial<CollectionEntry<"charts">["data"]>>;
  barSnapshots: Map<string, BarSnapshotEntry[]>;
  /** Render the top-level fixed-range chip when a dashboard-level fixedRange is
   *  set (the /custom/ viewer does this; presets/home just pass it to charts). */
  showFixedRangeChip?: boolean;
  /** Section heading tag. "h2" for top-level pages; "h4" for the home page
   *  where sections nest under the featured dashboard's <h3>. */
  headingLevel?: "h2" | "h4";
}

const {
  sections,
  supportedDeltas,
  defaultDelta,
  dashboardSlug,
  fixedRange,
  chartOverrides,
  barSnapshots,
  showFixedRangeChip = false,
  headingLevel = "h2",
} = Astro.props;

const Heading = headingLevel;

// A dashboard with exactly one chart (across all sections) renders that
// chart inline in its full expanded form rather than as a clickable card.
// Markdown-only sections contribute no charts. Maps opt out (their expanded
// view is a shared modal); SectionChart forwards `solo` only to line + bar
// charts. The dashboard-level window selector is hidden in this mode since
// the inline expanded view carries its own range/transform controls.
const totalCharts = sections.reduce((n, s) => n + s.charts.length, 0);
const soloChart = totalCharts === 1;
---

{
  soloChart ? null : showFixedRangeChip && fixedRange ? (
    <div class="dashboard-window" role="group" aria-label="Fixed range">
      <span class="eyebrow">Range</span>
      <span class="dashboard-fixed-range">
        {fixedRange.start} → {fixedRange.end}
      </span>
    </div>
  ) : supportedDeltas.length > 0 ? (
    <div class="dashboard-window" role="group" aria-label="Default window">
      <span class="eyebrow">Window</span>
      <div class="pills" data-dashboard-window-control>
        {supportedDeltas.map((w) => (
          <button
            type="button"
            class={"pill" + (w === defaultDelta ? " pill-active" : "")}
            data-dashboard-window={w}
            aria-pressed={w === defaultDelta ? "true" : "false"}
          >
            {DELTA_LABELS_SHORT[w]}
          </button>
        ))}
        <button
          type="button"
          class="pill pill-reset"
          data-dashboard-window-reset
          title="Reset windows to the dashboard's defaults"
          aria-label="Reset windows to the dashboard's defaults"
        >
          Reset
        </button>
      </div>
    </div>
  ) : null
}

{
  sections.map((section) => {
    const sectionDelta = section.defaultDelta ?? defaultDelta;
    const sectionFixed = section.fixedRange ?? fixedRange;
    return (
      <section
        class={`dash-section${section.charts.length === 0 && section.markdown ? " dash-section-markdown" : ""}`}
      >
        {section.title && <Heading class="section-heading">{section.title}</Heading>}
        {section.description && (
          <p class="section-description">{section.description}</p>
        )}
        {(section.fixedRange || section.defaultDelta) && (
          <p class="section-window muted small">
            Window:{" "}
            {section.fixedRange
              ? `${section.fixedRange.start} → ${section.fixedRange.end}`
              : section.defaultDelta}
          </p>
        )}
        {section.markdown && section.markdown.trim().length > 0 && (
          <div class="section-markdown" set:html={renderMarkdown(section.markdown)} />
        )}
        {section.charts.length > 0 && (
          <div class={"chart-grid" + (soloChart ? " chart-grid-solo" : "")}>
            {section.charts.map((c) => (
              <SectionChart
                chartId={c.chart.id}
                chart={effectiveChart(c, chartOverrides?.[c.chart.id])}
                sources={c.sources}
                dashboardSlug={dashboardSlug}
                sectionDelta={sectionDelta}
                sectionFixedRange={sectionFixed}
                sectionLocked={!!(section.defaultDelta || section.fixedRange)}
                preloaded={c.preloaded}
                barSnapshot={barSnapshots.get(c.chart.id)}
                solo={soloChart}
              />
            ))}
          </div>
        )}
      </section>
    );
  })
}

{sections.length === 0 && <slot name="empty" />}

<style>
  .dashboard-window {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }
  .dashboard-fixed-range {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: var(--text-xs);
    color: var(--color-neutral-700);
    background: var(--color-neutral-100);
    padding: 3px 8px;
    border-radius: var(--radius-sm);
  }
  .dashboard-window .pills {
    display: flex;
    gap: 4px;
    font-size: var(--text-xs);
    font-weight: 500;
  }
  .dashboard-window .pill {
    padding: 4px 10px;
    border: 1px solid rgba(55, 53, 47, 0.1);
    border-radius: var(--radius-sm);
    background: var(--color-white);
    color: var(--color-neutral-600);
    cursor: pointer;
    font: inherit;
    transition: background 0.1s, color 0.1s;
  }
  .dashboard-window .pill:hover {
    background: var(--color-neutral-100);
  }
  .dashboard-window .pill-active,
  .dashboard-window .pill-active:hover {
    background: var(--color-neutral-900);
    color: var(--color-white);
    border-color: var(--color-neutral-900);
  }
  /* "Reset" is an action, not a window option — set apart with a small
     gap and a dashed, muted treatment so it doesn't read as a selectable
     window pill. */
  .dashboard-window .pill-reset {
    margin-left: 6px;
    border-style: dashed;
    color: var(--color-neutral-500);
  }
  .dashboard-window .pill-reset:hover {
    color: var(--color-neutral-900);
  }
  .dash-section {
    margin-bottom: 32px;
  }
  .dash-section:last-of-type {
    margin-bottom: 0;
  }
  .section-heading {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-neutral-900);
    margin: 0 0 4px;
  }
  .section-description {
    font-size: var(--text-sm);
    color: var(--color-neutral-600);
    line-height: 1.5;
    margin: 0 0 12px;
    max-width: 720px;
    white-space: pre-wrap;
  }
  /* Markdown body inside a section. Editorial prose styling — see
     the equivalent block in src/pages/u/[slug].astro for the rationale. */
  .section-markdown {
    max-width: 720px;
    margin: 4px 0 16px;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-neutral-700);
  }
  .section-markdown :global(p) { margin: 0 0 10px; }
  .section-markdown :global(h2) { font-size: var(--text-base); font-weight: 600; color: var(--color-neutral-900); margin: 14px 0 6px; }
  .section-markdown :global(h3) { font-size: var(--text-sm); font-weight: 600; color: var(--color-neutral-900); margin: 12px 0 4px; }
  .section-markdown :global(h4) { font-size: var(--text-sm); font-weight: 600; color: var(--color-neutral-600); margin: 10px 0 4px; }
  .section-markdown :global(ul),
  .section-markdown :global(ol) { margin: 0 0 10px; padding-left: 22px; }
  .section-markdown :global(li) { margin: 0 0 3px; }
  .section-markdown :global(a) { color: var(--color-neutral-900); text-decoration: underline; text-underline-offset: 2px; }
  .section-markdown :global(code) { background: var(--color-neutral-100); padding: 1px 4px; border-radius: 3px; font-size: 0.92em; }
  .section-markdown :global(pre) { background: var(--color-neutral-100); padding: 8px 10px; border-radius: 3px; overflow-x: auto; font-size: 12px; }
  .section-markdown :global(pre code) { background: transparent; padding: 0; }
  .dash-section-markdown .section-markdown { max-width: 880px; }
  .dash-section-markdown { padding-bottom: 8px; border-bottom: 1px solid rgba(55, 53, 47, 0.06); }
  /* Section-level window override chip — a quiet caption, not a heading. */
  .section-window {
    margin: -4px 0 12px;
    font-variant-numeric: tabular-nums;
  }
  .chart-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 12px;
  }
  @media (min-width: 768px) {
    .chart-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 1100px) {
    .chart-grid {
      grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    }
  }
  /* Solo single-chart dashboard: one full-width column so the inline expanded
     chart fills the whole grid area (the space the full set of cards would
     occupy) instead of being pinned to a single ~230px card column. The
     compound selector (0,2,0) beats the single-class media-query rules above
     at every breakpoint. The chart's own .chart-dialog-solo drops its width
     cap to match (Chart.astro / ChartBar.astro). */
  .chart-grid.chart-grid-solo {
    grid-template-columns: 1fr;
  }
</style>
