---
/**
 * Map (heatmap) chart tile.
 *
 * Renders one US map colored by an ACS indicator at a given vintage,
 * at one of four geographic granularities (state / county / tract /
 * block-group). State + county data is nationwide; tract + block-group
 * is sharded by state and may be further clipped via `bbox`.
 *
 * Flow:
 *   1. At build time (this frontmatter) we resolve the data file path
 *      from the chart's (geo, indicator, vintage, state) fields and
 *      read it server-side so the tile ships with the min/max range
 *      already known. Saves a roundtrip on first paint.
 *   2. We DON'T embed the full values map into the tile HTML —
 *      hundreds of regions × multiple tiles on a dashboard would
 *      bloat the page. The map renders client-side after fetching
 *      the values + the boundary TopoJSON.
 *   3. Boundary TopoJSON for state + county comes from us-atlas (one
 *      shared file at /maps/us-counties-albers-10m.json, contains
 *      both states + counties). Tract + block-group will be
 *      state-sharded TopoJSONs when those pipelines run.
 *
 * The tile is fixed at the chart's author-specified vintage. The
 * expanded dialog includes a year slider that swaps in sibling
 * vintages of the same indicator (server-side discovery globs the
 * data dir; slider hides when only one vintage is available).
 */
import type { CollectionEntry } from "astro:content";
import { promises as fs } from "node:fs";
import { pickVintages, combineShardVintages } from "../lib/map-vintages";
import { publicFilePath } from "../lib/public-dir";
import { stateCartogramVintages } from "../lib/cartogram-vintages";
import {
  isServerlessRuntime,
  resolveServerlessOrigin,
} from "../lib/load-data";

// Dual-mode read for files under public/. At build time / dev, reads
// directly from disk. At Vercel function runtime, public/data/ has
// been stripped from the function bundle (see astro.config.mjs's
// strip-data-from-function hook) — falls back to fetching from the
// deployment's own static-assets URL.
//
// load-data.ts has the same pattern for the SourceData + summary
// loaders; this is the map-flavored equivalent for snapshot
// JSON + boundary TopoJSON reads. Without the fetch fallback the
// /custom/ + /u/<slug>/ paths show "data not yet fetched" even though
// the files ARE in the static bundle.
async function readPublicFileText(rel: string): Promise<string | null> {
  if (!isServerlessRuntime()) {
    try {
      return await fs.readFile(publicFilePath(rel), "utf-8");
    } catch {
      return null;
    }
  }
  const origin = resolveServerlessOrigin();
  if (!origin) return null;
  try {
    const r = await fetch(`${origin}/${rel.replace(/^\//, "")}`);
    if (!r.ok) return null;
    return await r.text();
  } catch {
    return null;
  }
}

type ChartData = CollectionEntry<"charts">["data"];

interface Props {
  chartId: string;
  chart: ChartData;
  dashboardSlug: string;
}

// Explicit `as Props` so tsc treats the interface as referenced.
// Astro's language server normally infers Astro.props as the local
// Props type, but tsc's reachability check (which `astro check` runs
// alongside) flags unused declarations. Same pattern as SectionChart.
const { chartId, chart, dashboardSlug } = Astro.props as Props;

// Resolve the data file path from the chart's map fields. The
// pipeline writes:
//   public/data/acs_state/<indicator>_<vintage>.json
//   public/data/acs_county/<indicator>_<vintage>.json
//   public/data/acs_tract/<state>/<indicator>_<vintage>.json
//   public/data/acs_block_group/<state>/<indicator>_<vintage>.json
const geo = chart.geo!;        // refine() above guarantees non-empty
const indicator = chart.indicator!;
const vintage = chart.vintage!;
const stateCodes: string[] =
  (chart.states && chart.states.length > 0
    ? chart.states.map((s: string) => s.toLowerCase())
    : chart.state
      ? [chart.state.toLowerCase()]
      : []);
const dataDirSeg = geo === "block-group" ? "acs_block_group" : `acs_${geo}`;
// For state + county the data is one file shared across the country.
// For tract + block-group we have per-state shards; multi-state
// charts (e.g. DMV tracts = VA + MD + DC) load each shard
// client-side and merge in the renderer.
const dataFileRels: string[] =
  geo === "state" || geo === "county" || geo === "cd"
    ? [`data/${dataDirSeg}/${indicator}_${vintage}.json`]
    : stateCodes.map(
        (st) => `data/${dataDirSeg}/${st}/${indicator}_${vintage}.json`,
      );
// Client-facing data URLs. The server-side summary reads
// dataFileRels directly off disk; the client fetches the URLs
// version through map-canvas's data-data-urls attr.
const dataFileUrls = dataFileRels.map((r) => `/${r}`);

// Year-slider discovery. Glob the data directory for sibling
// vintages of the same (geo, indicator). For tract / block-group
// where data is sharded across states, the slider should only offer
// vintages present in ALL shards (otherwise switching to that year
// would render an incomplete-coverage map without warning the user
// the slider position is meaningful).
async function discoverVintages(): Promise<string[]> {
  // Pure parsing/intersection lives in ../lib/map-vintages (unit-tested).
  if (geo === "state" || geo === "county" || geo === "cd") {
    try {
      const files = await fs.readdir(
        publicFilePath("data", dataDirSeg),
      );
      return pickVintages(files, indicator);
    } catch { return []; }
  }
  // tract / block-group: intersection across per-state shards.
  const perState: string[][] = [];
  for (const st of stateCodes) {
    try {
      const files = await fs.readdir(
        publicFilePath("data", dataDirSeg, st),
      );
      perState.push(pickVintages(files, indicator));
    } catch { perState.push([]); }
  }
  return combineShardVintages(perState);
}
const availableVintages = await discoverVintages();

// Read the data file server-side so we can compute headline numbers
// (min, max, median) for the tile eyebrow + render an accurate legend
// scale without a client roundtrip on first paint.
//
// Note: we only ship the SUMMARY values into the tile HTML — full
// values map gets fetched client-side. Saves dashboard payload size.
interface SnapshotShape {
  geo: string;
  indicator: string;
  vintage: string;
  unit: string;
  decimals: number;
  valueLabel: string;
  lastUpdated: string;
  stateCode?: string;
  values: Record<string, number>;
}

let summary: {
  min: number;
  max: number;
  median: number;
  count: number;
  unit: string;
  decimals: number;
  valueLabel: string;
  lastUpdated: string;
} | null = null;
let loadError: string | null = null;
try {
  // Server-side summary read: load every shard the client would
  // load too, merge the values, and compute aggregate stats. Means
  // the tile eyebrow's range/median is accurate for multi-state
  // tract maps (e.g. DMV = VA + MD + DC merged) without waiting on
  // the client-side fetches to land.
  const mergedValues: Record<string, number> = {};
  let unit = "";
  let decimals = 0;
  let valueLabel = "";
  let lastUpdated = "";
  // Track how many shards were attempted vs. how many readable, so
  // the eyebrow can say "data not yet fetched" (zero shards read)
  // vs "no values in this region" (shards read but bbox empty).
  let shardsAttempted = 0;
  let shardsReadable = 0;
  for (const rel of dataFileRels) {
    shardsAttempted++;
    const raw = await readPublicFileText(rel);
    if (!raw) {
      // Missing shard — either the workflow hasn't fetched it yet, or
      // the file's not in the static bundle. Either way, fall through;
      // the renderer paints whatever IS available + the user sees a
      // partial map with missing regions blank.
      continue;
    }
    try {
      const parsed = JSON.parse(raw) as SnapshotShape;
      shardsReadable++;
      Object.assign(mergedValues, parsed.values);
      // Use the first shard's metadata fields; they should be
      // identical across shards since they come from the same
      // pipeline run with the same indicator config.
      if (!unit) {
        unit = parsed.unit;
        decimals = parsed.decimals;
        valueLabel = parsed.valueLabel;
        lastUpdated = parsed.lastUpdated;
      }
    } catch {
      // Malformed JSON — skip the shard.
    }
  }
  // For tract / block-group charts with a bbox, the boundary file
  // is pre-filtered to features whose bounding box intersects the
  // chart's bbox — only those features actually get rendered on the
  // client. To keep the eyebrow's count/range/median honest about
  // what the user sees, restrict the stats to those features rather
  // than reporting the full multi-state dataset.
  let effectiveValues: Record<string, number> = mergedValues;
  if (
    (geo === "tract" || geo === "block-group") &&
    chart.boundaryFile &&
    chart.bbox
  ) {
    try {
      // Dual-mode boundary read: same dance as the shard reads above.
      // Build / dev hits disk; the Vercel function falls back to the
      // deployment's static-assets URL since the boundary TopoJSONs
      // (some are 10+ MB) get stripped from the function bundle to
      // stay under the 250MB function-size limit.
      const boundaryRaw = await readPublicFileText(
        chart.boundaryFile.replace(/^\//, ""),
      );
      if (!boundaryRaw) {
        throw new Error("boundary read returned null");
      }
      const boundaryJson = JSON.parse(boundaryRaw) as {
        objects: Record<
          string,
          { geometries?: Array<{ id?: string; properties?: { id?: string } }> }
        >;
      };
      // Boundary IDs may live at top-level or under properties.id —
      // mirror the renderer's normalization.
      const boundaryIds = new Set<string>();
      for (const layer of Object.values(boundaryJson.objects ?? {})) {
        for (const g of layer.geometries ?? []) {
          const id = g.id ?? g.properties?.id;
          if (id) boundaryIds.add(id);
        }
      }
      const filtered: Record<string, number> = {};
      for (const [id, v] of Object.entries(mergedValues)) {
        if (boundaryIds.has(id)) filtered[id] = v;
      }
      // Only swap in the filtered set if we actually got a non-empty
      // intersection — otherwise fall through to the unfiltered set
      // so a misconfigured boundaryFile doesn't accidentally blank
      // the eyebrow.
      if (Object.keys(filtered).length > 0) {
        effectiveValues = filtered;
      }
    } catch {
      // Boundary file unreadable — keep the unfiltered stats.
    }
  }
  const vals = Object.values(effectiveValues).filter(
    (v): v is number => typeof v === "number" && Number.isFinite(v),
  );
  if (vals.length === 0) {
    // Distinguish "data not yet fetched" (no shards readable on
    // disk — most likely cause: the workflow hasn't run since the
    // chart was added) from "data here but nothing in the bbox"
    // (rare; suggests the bbox is mis-specified). Specific phrasing
    // helps the reader know whether to wait for a workflow run or
    // fix the chart YAML.
    if (shardsAttempted > 0 && shardsReadable === 0) {
      loadError = "data not yet fetched (will populate on next workflow run)";
    } else {
      loadError = "no values in snapshot";
    }
  } else {
    vals.sort((a, b) => a - b);
    summary = {
      min: vals[0],
      max: vals[vals.length - 1],
      median: vals[Math.floor(vals.length / 2)],
      count: vals.length,
      unit,
      decimals,
      valueLabel,
      lastUpdated,
    };
  }
} catch (e) {
  loadError = `data file unreadable: ${(e as Error).message}`;
}

function fmt(v: number, unit: string, decimals: number): string {
  if (unit === "USD" || unit === "USD/mo") {
    const s = v.toLocaleString("en-US", {
      style: "currency",
      currency: "USD",
      maximumFractionDigits: 0,
    });
    return unit === "USD/mo" ? `${s}/mo` : s;
  }
  if (unit === "count") {
    return v.toLocaleString("en-US", { maximumFractionDigits: 0 });
  }
  const rounded = v.toFixed(decimals);
  if (unit === "%") return `${rounded}%`;
  if (unit === "years") return `${rounded} yr`;
  if (unit === "min") return `${rounded} min`;
  return rounded;
}

const tileTitle = chart.title;
// Boundary file: state + county reuse the bundled US-wide file from
// us-atlas. Tract + block-group come from chart-specified TopoJSON
// (generated by mapshaper from Census Cartographic Boundary
// shapefiles). The TopoJSON's `objects` map must contain a layer
// named "states", "counties", "tracts", or "block_groups" to match
// the geo dispatch in the client paint().
// us-counties-2024-10m.json: cb_2024 Census Cartographic Boundary
// file, mapshaper-simplified, contains state + county layers. Newer
// than us-atlas's vintage so CT's 2022 Planning Region county FIPS
// (09110..09190) are present — the us-atlas file still has CT's old
// county FIPS (09001..09015) which no longer match ACS API output.
const defaultBoundary =
  geo === "cd"
    ? "/maps/us-cd118-10m.json"
    : geo === "state" || geo === "county"
      ? "/maps/us-counties-2024-10m.json"
      : "";
// Population-weighted CONTIGUOUS cartogram: a parallel precomputed boundary file
// per level (scripts/build_cartogram.mjs) whose polygons are warped so each
// unit's AREA tracks its population. Same object name + GEOID keys as the normal
// boundary, so the value-join and layer dispatch are unchanged — only the
// geometry (and the projection: it's pre-projected, drawn with identity) differ.
// STATE and COUNTY ship a cartogram. CD was dropped (equal-population districts
// over-warp into an unrecognizable mess); per-state tract/BG aren't built for the
// same reason (tracts/BGs are designed ~equal-population, so their cartograms come
// out near-uniform). Any other geo gets an empty string → cartogramAvailable
// false → no toggle, and a chart that sets cartogram:true on it falls through to
// the normal choropleth instead of 404ing.
const cartogramBoundary =
  geo === "state"
    ? "/maps/us-states-cartogram-pop.json"
    : geo === "county"
      ? "/maps/us-counties-cartogram-pop.json"
      : "";
// A cartogram asset exists for this geo → the dialog shows an Area/Population
// toggle. `cartogramDefault` is whether to START in population view (a curated
// chart may opt in with `cartogram: true`); the user can flip it either way.
const cartogramAvailable = cartogramBoundary !== "";
const cartogramDefault = (chart.cartogram ?? false) && cartogramAvailable;
// State cartograms are VINTAGED (one per election year 1976-2024); the client
// snaps a map's displayed vintage to the nearest. County is a SINGLE file
// (weighted by the latest immutable ACS population; county pop moves slowly, so
// one weight serves every vintage) — so its base/vintages stay empty and paint()
// falls back to the single cartogramUrl. cartogramBase + the vintages manifest
// let the client build the per-vintage URL for the vintaged (state) case.
const cartogramBase = geo === "state" ? "/maps/us-states-cartogram-pop-" : "";
const cartogramVintages = geo === "state" ? stateCartogramVintages() : [];
// Boundary resolution order:
//   1. Explicit chart.boundaryFile (pre-built regional bundle like
//      /maps/dmv-tracts-topo.json — used by curated dashboards that
//      stitched a custom region ahead of time).
//   2. Multi-state tract/BG: derive one /maps/<st>-<seg>-topo.json
//      per state in stateCodes. The client merges the FeatureCollections
//      after loading so a four-state region (DMV, NY-tri-state, etc.)
//      renders as one map.
//   3. defaultBoundary (state / county US-wide file).
const boundaryDirSeg =
  geo === "block-group" ? "block-groups" : "tracts";
const boundaryUrls: string[] = chart.boundaryFile
  ? [chart.boundaryFile]
  : geo === "tract" || geo === "block-group"
    ? stateCodes.map(
        (st) => `/maps/${st}-${boundaryDirSeg}-topo.json`,
      )
    : [defaultBoundary];
// Single-URL alias kept for back-compat with existing renderer code
// paths + the data-boundary-url attribute the dialog reuses.
const boundaryUrl = boundaryUrls[0] ?? defaultBoundary;
const boundaryUrlsJson = JSON.stringify(boundaryUrls);
const bbox = chart.bbox ?? null;
const colorScheme = chart.colorScheme ?? "blues";
const colorScale = chart.colorScale ?? "linear";
const bboxJson = bbox ? JSON.stringify(bbox) : "null";
const dataUrlsJson = JSON.stringify(dataFileUrls);
const vintagesJson = JSON.stringify(availableVintages);
const statesJoined = stateCodes.join(",");
---

<article
  class="chart-tile map-tile"
  data-chart-id={chartId}
  data-dashboard-slug={dashboardSlug}
  data-role="chart-tile"
  data-map="1"
  role="button"
  tabindex="0"
  aria-haspopup="dialog"
  aria-label={`${tileTitle}, open expanded map`}
>
  <header class="chart-tile-header">
    <div class="chart-tile-title">{tileTitle}</div>
    {summary && (
      <p class="map-eyebrow muted small">
        {summary.count} {geo === "state" ? "states" : geo === "county" ? "counties" : geo === "tract" ? "tracts" : geo === "cd" ? "districts" : "block groups"}
        {" · range "}
        {fmt(summary.min, summary.unit, summary.decimals)}
        {" – "}
        {fmt(summary.max, summary.unit, summary.decimals)}
        {" · median "}
        {fmt(summary.median, summary.unit, summary.decimals)}
      </p>
    )}
    {!summary && loadError && (
      <p class="map-eyebrow muted small text-error">
        Data unavailable: {loadError}
      </p>
    )}
  </header>
  <div
    class="map-canvas"
    data-role="map-canvas"
    data-chart-id={chartId}
    data-data-urls={dataUrlsJson}
    data-boundary-url={boundaryUrl}
    data-boundary-urls={boundaryUrlsJson}
    data-geo={geo}
    data-state={stateCodes[0] ?? ""}
    data-states={statesJoined}
    data-bbox={bboxJson}
    data-color-scheme={colorScheme}
    data-color-scale={colorScale}
    data-cartogram={cartogramDefault ? "1" : undefined}
    data-cartogram-url={cartogramBoundary || undefined}
    data-cartogram-base={cartogramBase || undefined}
    data-cartogram-vintages={cartogramVintages.length ? JSON.stringify(cartogramVintages) : undefined}
    data-value-label={summary?.valueLabel ?? ""}
    data-unit={summary?.unit ?? ""}
    data-decimals={summary?.decimals ?? 1}
    data-mode="tile"
    data-indicator={indicator}
    data-data-dir-seg={dataDirSeg}
    data-vintages={vintagesJson}
    data-vintage={vintage}
    data-skip-hydrate={summary ? undefined : "1"}
  >
    {!summary && loadError && (
      <p class="muted small">{loadError}</p>
    )}
  </div>
  {/*
    No "Updated X" footer on the tile — too much visual clutter for
    something users almost never act on. Expanded view shows it.
    Hover-on-tile shows region name + value via a fixed tooltip
    (wired by the script below).
  */}
</article>

<script>
  // Client-side renderer. Fetches the snapshot values + the boundary
  // TopoJSON in parallel, then paints a colored map via Observable
  // Plot's geo mark. Idempotent — safe to run twice if the user
  // navigates back to a cached page.
  import * as Plot from "@observablehq/plot";
  import * as topojson from "topojson-client";
  // d3-zoom + d3-selection are pulled from the umbrella d3 package
  // (transitive deps but published as part of d3 itself). Importing
  // from "d3" rather than the submodules keeps package.json tidy and
  // sidesteps the phantom-dep lint.
  import { select as d3select, zoom as d3zoom, zoomIdentity } from "d3";
  import type { ZoomBehavior, ZoomTransform } from "d3-zoom";
  // Colloquial names for 9800-series special-use tracts ("Pentagon",
  // "National Mall", etc.). Falls back to the topology's
  // "Census Tract NNNN" label when no curated entry exists.
  import { specialTractName } from "../lib/special-tract-names";
  import { disambiguateCountyCityNames } from "../lib/disambiguate-county-city";
  import { statePostalFromFips } from "../lib/state-fips";
  import { isMobileViewport } from "../lib/viewport";

  // Lazy-loaded county FIPS (5-digit) → name lookup. Block-group
  // hover labels need this to resolve the parent county from the
  // BG's 12-digit GEOID — without it the topology label is just
  // "Block Group 1" which repeats in every county and is useless
  // for orientation. Fetched once on the first BG render; the
  // Promise itself is cached so concurrent BG renders share the
  // single fetch. ~500KB file, but the browser caches it, and the
  // alternative (compiling a 3,140-row TS literal at build time)
  // would inflate every page's JS bundle even for charts that
  // never need it.
  let countyNamesPromise: Promise<Map<string, string>> | null = null;
  function loadCountyNames(): Promise<Map<string, string>> {
    if (countyNamesPromise) return countyNamesPromise;
    const root = (import.meta.env.BASE_URL || "/").replace(/\/$/, "");
    countyNamesPromise = (async () => {
      try {
        const r = await fetch(`${root}/maps/us-counties-2024-10m.json`);
        if (!r.ok) return new Map<string, string>();
        const topo = (await r.json()) as {
          objects?: { counties?: { geometries?: Array<{
            id?: string | number;
            properties?: { NAME?: string };
          }> } };
        };
        const m = new Map<string, string>();
        for (const g of topo.objects?.counties?.geometries ?? []) {
          if (g.id == null) continue;
          // The us-counties-2024-10m topology stores id as a numeric
          // value (e.g. 1069 for Houston, AL = "01069"). Pad to 5 to
          // match the 12-digit BG GEOID's state-county prefix.
          const id = String(g.id).padStart(5, "0");
          const name = g.properties?.NAME;
          if (name) m.set(id, name);
        }
        return m;
      } catch {
        // Network failure / 404: return empty map so the BG renderer
        // falls back to the tract-only label. Don't throw — a missing
        // county lookup shouldn't blank out the entire map.
        return new Map<string, string>();
      }
    })();
    return countyNamesPromise;
  }

  type ChoroBindings = {
    chartId: string;
    dataUrls: string[];   // 1+ shard files merged client-side
    boundaryUrl: string;  // Kept for back-compat with dialog code paths.
    /** Boundary URLs to load. Length 1 for single-state / pre-built
     *  regional bundles; length > 1 for multi-state regions composed
     *  ad-hoc from per-state TopoJSONs. */
    boundaryUrls: string[];
    geo: "state" | "county" | "tract" | "block-group" | "cd";
    state: string;
    bbox: [number, number, number, number] | null;
    colorScheme: string;
    colorScale: "linear" | "log" | "diverging";
    /** Population-weighted cartogram geometry (pre-projected planar coords →
     *  drawn with an identity projection, no state-border overlay). `cartogram`
     *  is the CURRENT mode (mutable via the dialog toggle); `cartogramUrl` is the
     *  cartogram boundary to load when it's on, or "" if none exists for this geo
     *  (toggle hidden). */
    cartogram: boolean;
    cartogramUrl: string;
    /** For VINTAGED cartograms (state): the URL prefix + available vintage years,
     *  so the client snaps `vintage` (the displayed year) to the nearest file.
     *  Empty for single-file levels (cd). */
    cartogramBase: string;
    cartogramVintages: number[];
    /** The vintage currently displayed (the year slider updates it). */
    vintage: string;
    valueLabel: string;
    unit: string;
    decimals: number;
  };

  // ---- Color scheme catalog ----
  // The list users see in the dropdown. Sequential mono-hue ramps +
  // two perceptually-uniform multi-hue options. Deliberately no
  // rainbow / sinebow / turbo / spectral / rdylgn — those fail
  // perceptual uniformity and/or colorblind accessibility (see the
  // "Why no rainbow?" disclosure below).
  //
  // Order matches user preference: highest-priority on top.
  type SchemeKey =
    | "reds" | "greys" | "viridis" | "batlow"
    | "blues" | "greens" | "oranges" | "purples"
    // Diverging red<->blue, for signed quantities like an election margin
    // (used with colorScale:"diverging", which pivots the scheme at 0).
    | "rdbu"
    // Sequential yellow->orange->red (e.g. the traffic-fatality-rate map).
    | "ylorrd";
  interface SchemeEntry {
    key: SchemeKey;
    label: string;
    // Either a Plot named scheme (string) or an explicit color stop
    // array Plot will interpolate across via `range`. Plot ships
    // most of these as named schemes; Batlow is vendored explicitly
    // from Crameri's v8 scientific colour-map table.
    plot: { scheme: string } | { range: string[] };
  }
  // Batlow 10-step sequential ramp from Crameri's published v8
  // table. Perceptually-uniform multi-hue (dark navy → blue → green
  // → yellow → orange → light beige). Crameri, F. (2018, v8.0.1):
  //   https://www.fabiocrameri.ch/colourmaps/
  // CC-BY-4.0; cite when published with these visuals.
  const BATLOW_STOPS: string[] = [
    "#011959", "#102d6a", "#1d4470", "#2b5b6c", "#3e7062",
    "#5f8053", "#909046", "#c39c4a", "#e9aa66", "#f9c69a",
  ];
  const SCHEMES: SchemeEntry[] = [
    { key: "reds",    label: "Red",     plot: { scheme: "reds" } },
    { key: "greys",   label: "Grey",    plot: { scheme: "greys" } },
    { key: "viridis", label: "Viridis", plot: { scheme: "viridis" } },
    { key: "batlow",  label: "Batlow",  plot: { range: BATLOW_STOPS } },
    { key: "blues",   label: "Blue",    plot: { scheme: "blues" } },
    { key: "greens",  label: "Green",   plot: { scheme: "greens" } },
    { key: "oranges", label: "Orange",  plot: { scheme: "oranges" } },
    { key: "purples", label: "Purple",  plot: { scheme: "purples" } },
    { key: "rdbu",    label: "Red-Blue", plot: { scheme: "rdbu" } },
    { key: "ylorrd",  label: "Yellow-Orange-Red", plot: { scheme: "ylorrd" } },
  ];
  function schemeByKey(key: string): SchemeEntry {
    return SCHEMES.find((s) => s.key === key) ?? SCHEMES[0];
  }

  // ---- Per-chart scheme override (localStorage) ----
  // Keyed by chart-id, so different charts on the same page keep
  // their own picks. The author's chart YAML colorScheme is the
  // default when no override exists. Multiple maps with different
  // colors on the same page is the design goal — each user pick
  // affects only the chart whose dialog produced it.
  function lsKey(chartId: string): string {
    return `tape.map.${chartId}.scheme`;
  }
  function loadOverride(chartId: string): string | null {
    try {
      return localStorage.getItem(lsKey(chartId));
    } catch {
      return null;
    }
  }
  function saveOverride(chartId: string, key: string): void {
    try {
      localStorage.setItem(lsKey(chartId), key);
    } catch {
      // localStorage blocked — the override is session-only.
    }
  }

  // Returns the effective scheme key for a chart: user override if
  // set, else the chart's author-specified default.
  function effectiveScheme(chartId: string, authorScheme: string): SchemeKey {
    const stored = loadOverride(chartId);
    const known = SCHEMES.map((s) => s.key);
    if (stored && (known as string[]).includes(stored)) {
      return stored as SchemeKey;
    }
    // Author's colorScheme might be any Plot scheme name. If it
    // happens to match one of our offered keys, use it; otherwise
    // fall back to blues. We DO render the author's choice exactly
    // on first paint via the data-color-scheme attr, but for the
    // dropdown's "selected" state we round it to one of our 8.
    if ((known as string[]).includes(authorScheme)) {
      return authorScheme as SchemeKey;
    }
    return "blues";
  }

  // Cache fetched boundary + values JSON across tiles on the same page
  // so a dashboard with N maps only does ONE boundary fetch.
  const boundaryCache = new Map<string, Promise<unknown>>();
  const valuesCache = new Map<string, Promise<Record<string, number>>>();

  function getBoundary(url: string): Promise<any> {
    let p = boundaryCache.get(url);
    if (!p) {
      p = fetch(url).then((r) => {
        if (!r.ok) throw new Error(`boundary ${url}: ${r.status}`);
        return r.json();
      });
      boundaryCache.set(url, p);
    }
    return p;
  }

  function getValues(url: string): Promise<Record<string, number>> {
    let p = valuesCache.get(url);
    if (!p) {
      p = fetch(url)
        .then((r) => {
          if (!r.ok) throw new Error(`values ${url}: ${r.status}`);
          return r.json();
        })
        .then((j) => j.values as Record<string, number>);
      valuesCache.set(url, p);
    }
    return p;
  }

  // Multi-shard fetch + merge. Used by tract / block-group charts
  // that span multiple states (DMV = VA + MD + DC). Each shard is
  // independently cached so charts with overlapping state coverage
  // share the underlying fetch.
  async function getMergedValues(urls: string[]): Promise<Record<string, number>> {
    if (urls.length === 1) return getValues(urls[0]);
    const shards = await Promise.all(urls.map(async (u) => {
      try { return await getValues(u); }
      catch { return {} as Record<string, number>; }
    }));
    const merged: Record<string, number> = {};
    for (const s of shards) Object.assign(merged, s);
    return merged;
  }

  function fmtValue(v: number | null, unit: string, decimals: number): string {
    if (v == null || !Number.isFinite(v)) return "—";
    if (unit === "USD" || unit === "USD/mo") {
      const s = v.toLocaleString("en-US", {
        style: "currency",
        currency: "USD",
        maximumFractionDigits: 0,
      });
      return unit === "USD/mo" ? `${s}/mo` : s;
    }
    if (unit === "count") {
      return v.toLocaleString("en-US", { maximumFractionDigits: 0 });
    }
    const r = v.toFixed(decimals);
    if (unit === "%") return `${r}%`;
    if (unit === "years") return `${r} yr`;
    if (unit === "min") return `${r} min`;
    return r;
  }

  // Shared, PRECOMPUTED states-only TopoJSON (minted at build by
  // scripts/build_us_states_topo.mjs from the county file's states layer). Used
  // for the state-boundary overlay on tract / block-group maps, whose per-state
  // boundary files carry no states layer — one small (~232KB) fetch cached for
  // the whole site, so there is NO client-side meshing anywhere.
  const STATES_BOUNDARY_URL = "/maps/us-states-10m.json";

  // Thicker state-boundary overlay for county / tract / block-group maps, built
  // entirely from PRECOMPUTED state geometry and cached (as a Promise) by
  // boundary-file set — computed at most once per set and reused across every
  // re-paint (tile -> expanded -> fullscreen, resize) and every chart instance,
  // never on the render hot path. County / state boundary files ship a `states`
  // layer we extract directly; per-state tract / block-group files have none, so
  // we extract just the in-view states from the shared us-states file. Feature
  // extraction only — no topojson.mesh / dissolve on the client.
  const STATE_BORDER_CACHE = new Map<string, Promise<any[]>>();
  function getStateBorders(
    topos: Array<unknown>,
    layerName: string,
    urls: string[],
    features: Array<{ id: string }>,
  ): Promise<any[]> {
    const key = layerName + "|" + [...urls].sort().join(",");
    const hit = STATE_BORDER_CACHE.get(key);
    if (hit) return hit;
    const built = (async (): Promise<any[]> => {
      const out: any[] = [];
      try {
        const embedded = topos.find(
          (t) => (t as { objects?: Record<string, unknown> })?.objects?.states,
        ) as { objects: Record<string, unknown> } | undefined;
        if (embedded) {
          // County / state file: extract its bundled states layer. These maps
          // are US-wide, so keep every state.
          const fc = topojson.feature(
            embedded as never,
            embedded.objects.states as never,
          ) as unknown as { features: any[] };
          out.push(...fc.features);
        } else {
          // Tract / block-group: pull the in-view states (first 2 chars of each
          // GEOID) from the shared precomputed file — one cached fetch, no mesh.
          const fips = new Set(features.map((f) => String(f.id).slice(0, 2)));
          const statesTopo = await getBoundary(STATES_BOUNDARY_URL);
          const fc = topojson.feature(
            statesTopo,
            statesTopo.objects.states,
          ) as unknown as {
            features: Array<{ id?: string; properties?: { GEOID?: string } }>;
          };
          for (const f of fc.features) {
            const fp = String(f.id ?? f.properties?.GEOID ?? "").slice(0, 2);
            if (fips.has(fp)) out.push(f);
          }
        }
      } catch (err) {
        console.warn("[map] state-border build failed:", err);
      }
      return out;
    })();
    STATE_BORDER_CACHE.set(key, built);
    return built;
  }

  async function paint(canvas: HTMLElement, b: ChoroBindings, mode: "tile" | "expanded" | "fullscreen") {
    // Pick the right TopoJSON object layer + GEOID key based on geo.
    // State features have id = 2-digit FIPS; county features have id
    // = 5-digit FIPS. Tract/block-group come from per-state TopoJSONs
    // we generated via mapshaper.
    let layerName: string;
    if (b.geo === "state") layerName = "states";
    else if (b.geo === "county") layerName = "counties";
    else if (b.geo === "tract") layerName = "tracts";
    else if (b.geo === "cd") layerName = "cd";
    else layerName = "block_groups";
    // In population (cartogram) mode, draw the precomputed cartogram boundary
    // instead of the normal one (it overrides the normal one/many boundary URLs).
    // State cartograms are VINTAGED: snap the displayed vintage to the nearest
    // available year so the geometry matches the era of the data — a 1976 election
    // map is weighted by 1976 population, not today's. CD + the no-vintage case
    // fall back to the single cartogramUrl.
    let urls: string[];
    if (b.cartogram && b.cartogramUrl) {
      let cgUrl = b.cartogramUrl;
      const target = parseInt(b.vintage, 10);
      if (b.cartogramBase && b.cartogramVintages.length > 0 && Number.isFinite(target)) {
        const best = b.cartogramVintages.reduce(
          (a, v) => (Math.abs(v - target) < Math.abs(a - target) ? v : a),
          b.cartogramVintages[0],
        );
        cgUrl = `${b.cartogramBase}${best}.json`;
      }
      urls = [cgUrl];
    } else {
      urls = b.boundaryUrls && b.boundaryUrls.length > 0 ? b.boundaryUrls : [b.boundaryUrl];
    }
    // Boundary-era selection. ACS vintages <= 2019 use the 2010-census tract /
    // block-group grid; 2020+ use the 2020 grid. The year slider rewrites
    // b.dataUrls per vintage but leaves the boundary fixed, so derive the era
    // HERE from the displayed vintage and swap a per-state topo to its -2010
    // sibling when pre-2020. Without this, scrubbing before 2020 joins old-grid
    // data onto new-grid polygons and renumbered areas falsely hatch as "no
    // data" (~15-19% of tracts; block groups nest in tracts and were
    // renumbered in the same redraw). Restricted to the 2-letter per-state
    // files (the only ones with a -2010 sibling); curated regional bundles
    // (dmv-tracts-topo.json etc.) have no sibling and are left as-is (those
    // charts default to a 2020-grid vintage anyway).
    if (b.geo === "tract" || b.geo === "block-group") {
      const seg = b.geo === "tract" ? "tracts" : "block-groups";
      const m = (b.dataUrls[0] || "").match(/_(\d{4})\.json$/);
      const yr = m ? Number(m[1]) : NaN;
      if (yr && yr <= 2019) {
        const perState = new RegExp(`/maps/[a-z]{2}-${seg}-topo\\.json$`);
        const tail = new RegExp(`-${seg}-topo\\.json$`);
        urls = urls.map((u) =>
          perState.test(u) ? u.replace(tail, `-${seg}-2010-topo.json`) : u,
        );
      }
    }
    // Multi-state regional maps: load N per-state TopoJSONs and
    // concatenate their FeatureCollections. Single-state and
    // pre-built regional bundles are the urls.length === 1 case
    // (still goes through the same path so failures behave
    // consistently). Per-shard failures are swallowed so a
    // partially-broken region still renders the states that DID
    // load — better than a blank tile if one state's topology
    // 404s.
    const topos = await Promise.all(urls.map(async (u) => {
      try { return await getBoundary(u); }
      catch (err) {
        console.warn(`[map] boundary fetch failed for ${u}:`, err);
        return null;
      }
    }));
    const values = await getMergedValues(b.dataUrls);
    // Group-quarters share per tract, for the hover tooltip: a tract that's
    // mostly group quarters (a prison, a college dorm cluster) is not a
    // residential neighborhood, so a 0% bachelor's reading there is an inmate
    // population, not a failing community. Derive the sibling
    // group_quarters_pct file URL from each data URL (same path, swapped
    // indicator). Tract-only, and wrapped so a missing GQ shard (pre-2012
    // vintages where B26001 doesn't exist, or any vintage before the backfill
    // lands) degrades to no annotation rather than throwing in paint().
    let gqValues: Record<string, number> = {};
    if (b.geo === "tract") {
      const gqUrls = b.dataUrls.map((u) =>
        u.replace(/\/[^/]+_(\d{4})\.json$/, "/group_quarters_pct_$1.json"),
      );
      try {
        gqValues = await getMergedValues(gqUrls);
      } catch {
        gqValues = {};
      }
    }
    // Reliability (coefficient of variation) of the displayed share, from the
    // <indicator>_cv_<vintage>.json sibling, to flag imprecise estimates in the
    // tooltip. The MIN_PCT_DENOM floor is a hard cutoff, not a confidence scale;
    // this surfaces the actual statistical uncertainty. Same graceful contract
    // as gqValues (median income + other non-share maps have no _cv sibling, so
    // this just stays empty there).
    let cvValues: Record<string, number> = {};
    if (b.geo === "tract") {
      const cvUrls = b.dataUrls.map((u) =>
        u.replace(/_(\d{4})\.json$/, "_cv_$1.json"),
      );
      try {
        cvValues = await getMergedValues(cvUrls);
      } catch {
        cvValues = {};
      }
    }
    const features: Array<{
      id: string;
      properties?: { name?: string; id?: string };
    }> = [];
    for (const topo of topos) {
      if (!topo) continue;
      const obj = (topo as { objects: Record<string, unknown> }).objects[layerName];
      if (!obj) continue;
      // topojson.feature's return type is typed as Feature<Point>
      // by default — at runtime it returns a FeatureCollection when
      // passed a GeometryCollection (which `objects[layerName]` always
      // is for our boundary files). Cast through `unknown` to bypass
      // the (technically correct) "no overlap" check.
      const fcShard = topojson.feature(topo as never, obj as never) as unknown as {
        features: typeof features;
      };
      features.push(...fcShard.features);
    }
    // Thicker state-boundary overlay so state outlines read over the fine
    // county / tract / block-group borders. Built once and memoized in
    // getStateBorders (precomputed "states" layer for county maps; one-time
    // shard mesh for tract / block-group) — never recomputed on re-paint.
    // Cartograms carry their own warped polygon borders; a state overlay would
    // be meshed from the un-distorted lon/lat topology and drawn in the wrong
    // (planar) space, so skip it.
    const drawStateBorders =
      !b.cartogram &&
      (b.geo === "county" || b.geo === "tract" || b.geo === "block-group");
    const stateBorders = drawStateBorders
      ? await getStateBorders(topos, layerName, urls, features)
      : [];
    // Normalize id at the feature level. Some boundary files (the
    // DMV-tract and VA-block-group TopoJSONs we generated with
    // mapshaper) carry the GEOID under properties.id instead of as
    // a top-level id — topojson.feature() doesn't promote it for us,
    // so values[f.id] would miss and the map would render with no
    // colored regions. Promote here so the rest of paint() (and
    // Plot's path data binding) can rely on f.id being the GEOID.
    //
    // Same trick for the display name: us-counties-2024-10m.json
    // has the human name under properties.NAME (uppercase, from
    // the cb_2024 Census file), our mapshaper-generated tract and
    // block-group files have it under properties.name (lowercase).
    // Normalize to properties.name so tooltips and titles can read
    // one key regardless of boundary-file vintage.
    // Block-group GEOIDs are 12 chars (state2 + county3 + tract6 + bg1).
    // To produce a useful hover label we need the parent county's
    // name — load the FIPS→name map once before the per-feature loop.
    // For non-BG geo levels this is skipped entirely.
    const countyNames = b.geo === "block-group"
      ? await loadCountyNames()
      : null;
    for (const f of features) {
      const props = (f as { properties?: { id?: string; name?: string; NAME?: string } }).properties;
      if (!f.id && props?.id) {
        (f as { id: string }).id = props.id;
      }
      if (props && !props.name && props.NAME) {
        props.name = props.NAME;
      }
      // Curated colloquial name for well-known 9800-series tracts —
      // "Pentagon" beats "Census Tract 9801". Apply once at paint
      // time rather than per pointermove in the tooltip handler:
      // we're already iterating features here, the lookup is O(1),
      // and amortizing over a single paint vs hundreds of hover
      // events per second makes a measurable difference on
      // multi-thousand-feature maps. specialTractName returns null
      // for non-curated GEOIDs so the topology label stands.
      const fid = (f as { id?: string }).id;
      if (fid && props) {
        const colloquial = specialTractName(fid);
        if (colloquial) props.name = colloquial;
      }
      // Block-group hover: the raw topology label is just
      // "Block Group N" — same N repeats in every county, which is
      // useless for orientation. Reformat to
      // "Block Group N, Tract X.YY, <County> County" using the
      // 12-digit GEOID and the lazy-loaded county-FIPS lookup.
      // If the lookup is unavailable, fall back to the tract-only
      // label so the hover stays informative.
      if (b.geo === "block-group" && fid && fid.length === 12 && props) {
        const countyFips = fid.slice(0, 5);          // state2 + county3
        const tractCode = fid.slice(5, 11);          // 6-digit tract code
        const bgNumber = fid.slice(11, 12);          // 1-digit BG number
        // Census tract display format is NNNN.NN — e.g. raw "020600"
        // is shown as "206.00". parseInt drops leading zeros on the
        // integer part to match the form the tract topology uses
        // ("Census Tract 9303.02").
        const tractInt = parseInt(tractCode.slice(0, 4), 10);
        const tractFrac = tractCode.slice(4, 6);
        const tractFormatted = `${tractInt}.${tractFrac}`;
        const countyName = countyNames?.get(countyFips);
        props.name = countyName
          ? `Block Group ${bgNumber}, Tract ${tractFormatted}, ${countyName} County`
          : `Block Group ${bgNumber}, Tract ${tractFormatted}`;
      }
    }
    // Disambiguate same-name county/independent-city pairs (Baltimore,
    // St. Louis, Fairfax, Franklin, Richmond, Roanoke). Rules and the
    // full collision list live in disambiguate-county-city.ts. The
    // overrides map only contains GEOIDs whose names need to change.
    {
      type Props = { name?: string };
      const collected: Array<{ id: string; name: string }> = [];
      for (const f of features) {
        const props = (f as { properties?: Props }).properties;
        const id = (f as { id?: string }).id;
        if (!props?.name || !id) continue;
        collected.push({ id, name: props.name });
      }
      const overrides = disambiguateCountyCityNames(collected);
      if (overrides.size > 0) {
        for (const f of features) {
          const id = (f as { id?: string }).id;
          if (!id) continue;
          const newName = overrides.get(id);
          if (!newName) continue;
          const p = (f as { properties?: Props }).properties;
          if (p) p.name = newName;
        }
      }
    }
    // County hover: suffix the two-letter state postal code, so "Travis"
    // reads "Travis, TX". Done AFTER the city/county disambiguation pass
    // (which keys on the bare name + state FIPS) so the suffix doesn't
    // defeat collision detection. Postal code (not "County"/"Parish"/
    // "Borough") because the local-government noun varies but ", TX" is
    // always right. 5-digit GEOID = state2 + county3.
    if (b.geo === "county") {
      type Props = { name?: string };
      for (const f of features) {
        const id = (f as { id?: string }).id;
        const p = (f as { properties?: Props }).properties;
        if (!p?.name || !id || id.length !== 5) continue;
        const postal = statePostalFromFips(id.slice(0, 2));
        if (postal && !p.name.endsWith(`, ${postal}`)) {
          p.name = `${p.name}, ${postal}`;
        }
      }
    }
    // Apply bbox clip if provided. We test whether ANY vertex of
    // each feature's polygon falls inside the bbox — that keeps the
    // tracts that straddle the edge of the bbox (which read more
    // naturally to the eye than a hard-clipped boundary) while
    // dropping everything fully outside. For DMV-level tract maps
    // this cuts ~3,500 polygons in VA+MD+DC down to ~700 in the
    // DC-area tracts.
    let clipped = features;
    if (b.bbox) {
      const [w, s, e, n] = b.bbox;
      const inBbox = (lng: number, lat: number) =>
        lng >= w && lng <= e && lat >= s && lat <= n;
      const anyVertexInBbox = (geom: any): boolean => {
        if (!geom) return false;
        if (geom.type === "Polygon") {
          for (const ring of geom.coordinates) {
            for (const pt of ring) {
              if (inBbox(pt[0], pt[1])) return true;
            }
          }
          return false;
        }
        if (geom.type === "MultiPolygon") {
          for (const poly of geom.coordinates) {
            for (const ring of poly) {
              for (const pt of ring) {
                if (inBbox(pt[0], pt[1])) return true;
              }
            }
          }
          return false;
        }
        return false;
      };
      clipped = features.filter((f) => anyVertexInBbox((f as any).geometry));
    }
    // Build a domain from observed values so the legend is tight.
    const obs: number[] = [];
    for (const f of clipped) {
      const v = values[f.id];
      if (typeof v === "number" && Number.isFinite(v)) obs.push(v);
    }
    if (obs.length === 0) {
      canvas.innerHTML = '<p class="muted small">No regions with values.</p>';
      return;
    }
    obs.sort((a, b2) => a - b2);
    // Trim 1% tails to keep one outlier from washing out the rest.
    const lo = obs[Math.max(0, Math.floor(obs.length * 0.01))];
    const hi = obs[Math.min(obs.length - 1, Math.ceil(obs.length * 0.99))];
    const colorDomain: [number, number] = [lo, hi];
    canvas.innerHTML = "";
    // Always project at render time. us-counties-10m.json (the
    // geographic-coords variant) lets Plot's albers-usa projection
    // auto-fit to whatever (width, height) we pass — including the
    // Alaska + Hawaii insets at canonical positions, which the
    // pre-projected file couldn't do without us also pinning the
    // viewport to its native 975×610.
    // Plot sizes per render mode. Tile is the dashboard thumbnail;
    // expanded is the dialog default; fullscreen fills the viewport
    // when the user clicks Full screen.
    const vw = window.innerWidth || 1200;
    const vh = window.innerHeight || 800;
    // The /chart/ page tags <html> with this class when hosted inside the
    // welcome-page popout iframe (a near-full-screen viewport). There the
    // modest 1000px expanded width leaves wide grey margins, so widen it to
    // fill. Standalone /chart/ visits + embeds (no class) keep the modest
    // 1000px so the expanded dialog still fits a laptop page.
    const inPopout =
      typeof document !== "undefined" &&
      document.documentElement.classList.contains("chart-detail-host-popout");
    // Fullscreen caps generous enough to actually use a 2K/4K
    // display — 1600 × 1000 was leaving 30%+ of the screen blank on
    // common dev monitors. Expanded stays modest off-popout so the dialog
    // still fits within the page on typical laptop widths.
    const width =
      mode === "fullscreen" ? Math.min(vw - 40, 2400)
      : mode === "expanded" ? (inPopout ? Math.min(vw - 64, 1700) : 1000)
      // Tile mode: fill the container when it's wider than the legacy 620
      // default — the /chart/<id>/ detail page, the welcome popout, and big
      // embeds give the map a full-width container. Keep 620 as a FLOOR so
      // small dashboard-grid tiles render exactly as before (the svg's
      // max-width:100% scales the 620 canvas down to the cell). Without this
      // the map stayed a fixed 620px and sat left-aligned with a wide blank
      // gap on the right in any container wider than 620.
      : Math.max(620, Math.round(canvas.clientWidth || 0));
    const height =
      mode === "fullscreen" ? Math.min(vh - 160, 1500)
      // Expanded keeps the ~1.6 aspect (1000×620); scale with width in the
      // popout so the widened map isn't letterboxed.
      : mode === "expanded" ? (inPopout ? Math.round(width * 0.62) : 620)
      // Scale tile height with width to preserve the 620×360 aspect, so the
      // map fills the wider canvas instead of being pinned to a fixed 360
      // height (which would re-introduce horizontal gaps via the projection).
      : Math.round(width * (360 / 620));
    // Resolve the scheme: user override (if any) > chart author's
    // colorScheme > Blues fallback. Plot's color spec accepts EITHER
    // a named scheme string OR an explicit range[] of stops (which
    // we need for Batlow, since Plot doesn't ship Batlow as a named
    // scheme).
    const sk = effectiveScheme(b.chartId, b.colorScheme);
    const entry = schemeByKey(sk);
    // Diverging (signed quantities like an election margin): pivot the scheme
    // at 0 and use a SYMMETRIC domain [-m, m] so 0 is the neutral midpoint
    // (white) and equal-magnitude positive/negative read as equal-intensity
    // opposite hues. Sequential scales keep the tight [1st, 99th] domain.
    const isDiverging = b.colorScale === "diverging";
    const divMax = Math.max(Math.abs(lo), Math.abs(hi)) || 1;
    const colorSpec: Record<string, unknown> = {
      type: isDiverging ? "diverging" : b.colorScale,
      ...(isDiverging ? { pivot: 0 } : {}),
      domain: isDiverging ? [-divMax, divMax] : colorDomain,
      // Tile mode: drop the legend. A map tile is short
      // (~280px in embeds, ~200px in dashboard grids); the legend
      // figure consumes 30-50px of vertical space, leaving the
      // actual map a thin strip. The expanded / fullscreen views
      // have plenty of room for the legend so it's only off here.
      legend: mode !== "tile",
      label: b.valueLabel,
      // colorDomain is trimmed to [1st, 99th] percentile to keep
      // the legend tight; without clamp:true, Plot extrapolates
      // the rgb-interpolated range BEYOND the endpoint stops for
      // out-of-domain values, which produces invalid colors and
      // renders extreme counties as transparent (read: white) on
      // the map. Clamping pegs values below domain[0] to range[0]
      // and values above domain[1] to range[last], so the extremes
      // get the legend's endpoint color instead of disappearing.
      clamp: true,
    };
    if ("scheme" in entry.plot) {
      colorSpec.scheme = entry.plot.scheme;
    } else {
      colorSpec.range = entry.plot.range;
      colorSpec.interpolate = "rgb";
    }
    // Projection per geo level.
    //   • state / county: albers-usa puts Alaska + Hawaii in
    //     canonical insets at the bottom-left.
    //   • tract / block-group: regular albers with an EXPLICIT
    //     domain pointing at the clipped FeatureCollection. Plus
    //     a rotate + parallels computed from that domain's geographic
    //     extent so north points STRAIGHT UP at the rendered region.
    //
    // The rotate / parallels matter for off-center regions like New
    // England (MA+CT+RI+NH). d3.geoAlbers defaults to rotate=[96,0] /
    // parallels=[29.5, 45.5] — calibrated for the contiguous US with
    // central meridian at 96°W. New England sits around 71°W, so with
    // the default rotation the meridians visibly curve and "north" at
    // the eastern edge tilts ~6° east-of-up. Re-centering on the bbox
    // (rotate longitude to the bbox-center, set parallels to bracket
    // the latitude range) puts the central meridian in the middle of
    // the rendered region — meridians are vertical, north is up.
    //
    // Without the explicit domain, Plot's auto-fit for the bare
    // "albers" projection sometimes produced a viewport with the DMV
    // crammed into a sliver — visually that read as a white tile
    // because the actual polygons sat off the visible canvas.
    let projection: unknown;
    if (b.cartogram) {
      // Cartogram geometry is already projected (planar Albers-USA, screen
      // y-down). Use identity in OBJECT form WITH an explicit domain so Plot
      // scales + centers the planar coords to fill the frame. The bare
      // "identity" string only passes coordinates through 1:1 (Plot's fit
      // transform runs solely when a domain is given) — that would clip the
      // map on tiles and render it tiny at fullscreen. No reflectY: the coords
      // already point y-down like the SVG.
      projection = {
        type: "identity",
        domain: { type: "FeatureCollection", features: clipped },
      };
    } else if (b.geo === "state" || b.geo === "county" || b.geo === "cd") {
      projection = "albers-usa";
    } else {
      // Compute the geographic bbox of the clipped features so we can
      // center the projection on them. Walk each feature's geometry
      // once — cheap relative to the actual paint.
      let minLon = Infinity, maxLon = -Infinity;
      let minLat = Infinity, maxLat = -Infinity;
      const visit = (geom: unknown): void => {
        if (!geom || typeof geom !== "object") return;
        const g = geom as { type?: string; coordinates?: unknown };
        if (g.type === "Polygon" && Array.isArray(g.coordinates)) {
          for (const ring of g.coordinates as number[][][]) {
            for (const pt of ring) {
              if (pt[0] < minLon) minLon = pt[0];
              if (pt[0] > maxLon) maxLon = pt[0];
              if (pt[1] < minLat) minLat = pt[1];
              if (pt[1] > maxLat) maxLat = pt[1];
            }
          }
        } else if (g.type === "MultiPolygon" && Array.isArray(g.coordinates)) {
          for (const poly of g.coordinates as number[][][][]) {
            for (const ring of poly) {
              for (const pt of ring) {
                if (pt[0] < minLon) minLon = pt[0];
                if (pt[0] > maxLon) maxLon = pt[0];
                if (pt[1] < minLat) minLat = pt[1];
                if (pt[1] > maxLat) maxLat = pt[1];
              }
            }
          }
        }
      };
      for (const f of clipped) visit((f as { geometry?: unknown }).geometry);
      const ok = Number.isFinite(minLon) && Number.isFinite(maxLat);
      const centerLon = ok ? (minLon + maxLon) / 2 : -96;
      // Parallels bracket the latitude range with a small inset so
      // they're well inside the rendered region (d3 albers wants the
      // standard parallels close to the data's latitudinal extent).
      const latPad = ok ? Math.max(0.1, (maxLat - minLat) * 0.15) : 0;
      const parallels: [number, number] = ok
        ? [minLat + latPad, maxLat - latPad]
        : [29.5, 45.5];
      projection = {
        type: "albers",
        rotate: [-centerLon, 0],
        parallels,
        domain: { type: "FeatureCollection", features: clipped },
      };
    }
    const plotSpec = {
      projection,
      width,
      height,
      margin: 6,
      color: colorSpec,
      marks: [
        Plot.geo(clipped, {
          fill: (d: any) => values[d.id] ?? null,
          stroke: "white",
          strokeWidth: 0.3,
          title: (d: any) => {
            const v = values[d.id];
            // properties.name has already had the curated-colloquial
            // override applied in the normalize loop above (see
            // `specialTractName` block), so we can just read it.
            const name = d.properties?.name ?? d.id;
            // ACS top-codes tract median household income at $250,001; show the
            // open-ended bucket it really represents instead of a false-precise
            // figure (the cap clusters in high-income DMV/coastal tracts).
            const valStr =
              b.unit === "USD" && v === 250001
                ? "over $250,000"
                : fmtValue(v ?? null, b.unit, b.decimals);
            let s = `${name}\n${valStr}`;
            // Group-quarters context so an extreme reading reads as a prison /
            // dorm, not a neighborhood: >=30% is mostly institutional; a 10-30%
            // band (a facility inside an otherwise-residential tract) still
            // pulls the numbers off, so flag it, more softly.
            const gq = gqValues[d.id];
            if (typeof gq === "number") {
              if (gq >= 30) s += `\n${Math.round(gq)}% group quarters`;
              else if (gq >= 10) s += `\npartly group quarters (${Math.round(gq)}%)`;
            }
            // Statistical reliability: ACS estimates from small samples carry a
            // wide margin of error. CV > 30% is the conventional "interpret
            // with caution" line.
            const cv = cvValues[d.id];
            if (typeof cv === "number" && cv >= 30) {
              s += `\nimprecise estimate (CV ${Math.round(cv)}%)`;
            }
            return s;
          },
        }),
        // Thicker, darker state outlines drawn ON TOP of the choropleth so state
        // borders stand out over the fine county / tract / block-group lines.
        // Built once + memoized by getStateBorders; empty for state / cd maps, so
        // the spread contributes nothing there. pointer-events:none keeps the
        // hover tooltip bound to the filled regions underneath.
        ...(stateBorders.length
          ? [
              Plot.geo(stateBorders, {
                stroke: "#444",
                strokeWidth: mode === "tile" ? 0.6 : 0.9,
                fill: "none",
                pointerEvents: "none",
              }),
            ]
          : []),
      ],
    };
    let fig: HTMLElement | null = null;
    try {
      fig = (Plot as any).plot(plotSpec);
    } catch (e) {
      // Plot can throw on malformed colorSpec (e.g. clamp option
      // misalignment), invalid projection, or NaN in coordinates.
      // Without this catch the failure bubbles up to hydrateOne's
      // catch which renders a generic "Map failed to load" — but
      // the user still wants the error visible in the console.
      console.error("[map] Plot.plot threw:", e, plotSpec);
      canvas.innerHTML = `<p class="muted small">Map render failed: ${String((e as Error)?.message ?? e)}</p>`;
      return;
    }
    if (!fig) {
      // Plot returned undefined / null — defensive case, shouldn't
      // normally happen but better a visible message than silent
      // white space.
      console.error("[map] Plot.plot returned nothing", plotSpec);
      canvas.innerHTML = `<p class="muted small">Map render produced no output (${clipped.length} regions, ${obs.length} values).</p>`;
      return;
    }
    canvas.appendChild(fig);
    // After-append diagnostic — but deferred a rAF so we measure
    // AFTER the first layout pass. Without the defer, the SVG reads
    // 0×0 at append time on every healthy map (the parent flexbox
    // hasn't laid out yet), spamming 5+ warnings per page load on
    // any dashboard with maps. The genuine-bug signal (a permanently
    // stuck 0-size SVG) still surfaces because rAF resolves before
    // paint.
    const svgChild = fig.querySelector?.("svg") as SVGSVGElement | null;
    if (svgChild) {
      requestAnimationFrame(() => {
        const svgW = svgChild.clientWidth ?? 0;
        const svgH = svgChild.clientHeight ?? 0;
        if (svgW === 0 || svgH === 0) {
          console.warn(
            `[map] ${b.chartId}: rendered svg has zero size ` +
            `(${svgW}×${svgH}) — features=${clipped.length}, values=${obs.length}`,
          );
        }
      });
    }
    // Tooltip on hover. Performance-tuned because the chart can carry
    // thousands of <path> elements (3,143 counties, ~74k tracts) and
    // a naive mousemove handler that runs `closest("path")` plus DOM
    // writes on every pointer event chews 5-10ms per move — the user
    // sees noticeable lag tracking the cursor.
    //
    // Three optimizations:
    //   1. rAF-throttle: at most one tooltip update per animation
    //      frame, even if the browser fires 60+ mousemove events.
    //   2. Direct target check: e.target IS the path the cursor is
    //      over (SVG pointer-events default), so we skip closest().
    //      Falls through to closest() only when the target wasn't a
    //      path (e.g. SVG background).
    //   3. DOM writes batched in the rAF: position + textContent +
    //      visibility flip happen together, one layout cycle.
    // fig might be a <figure> wrapping the SVG (when legend:true) or
    // the SVG directly. Cast through HTMLElement so addEventListener
    // accepts MouseEvent listeners — without the cast TS narrows
    // svg to Element which only types listeners as Event.
    //
    // When `color.legend: true`, Plot inserts the legend as its OWN
    // <svg> element inside the figure BEFORE the main plot svg (see
    // node_modules/@observablehq/plot/src/plot.js: `figure.append(
    // ...legends, svg)`). The legend svg has its own <g> groups
    // (axis labels, gradient stops) but zero geo paths, so naively
    // taking the first <svg> via querySelector("svg") binds the
    // tooltip + zoom code to the WRONG svg — the map renders fine
    // visually but pointer events + d3-zoom find 0 paths and
    // silently no-op. Pick the svg with the most descendant <path>
    // elements; that's the one carrying the geo marks regardless
    // of how many legend svgs Plot decides to attach.
    let svg: HTMLElement;
    if (fig.tagName.toLowerCase() === "svg") {
      svg = fig as HTMLElement;
    } else {
      const svgCandidates = (fig as HTMLElement).querySelectorAll("svg");
      let bestSvg: Element | null = null;
      let bestPathCount = -1;
      for (const candidate of svgCandidates) {
        const c = candidate.querySelectorAll("path").length;
        if (c > bestPathCount) {
          bestSvg = candidate;
          bestPathCount = c;
        }
      }
      svg = ((bestSvg as HTMLElement | null) ?? fig) as HTMLElement;
    }
    // Tag the geo svg so the fullscreen layout fills ONLY it. Plot also
    // appends a color-legend svg to the figure; a blanket `svg{width:100%}`
    // in the wide layout stretched that legend to the full width too,
    // scaling its tick text up ~7x (the giant "10 20 30 40 50"). The
    // legend keeps its natural size; only this geo svg fills.
    svg.classList.add("map-geo-svg");
    // Two cases produce a "no data" tract that would otherwise render
    // as a hole in the map:
    //
    //   1. 9800-series tracts: Census reserves 6-digit tract codes
    //      starting with "98" for special land-use areas — military
    //      bases, parks, airports, water bodies. By design these have
    //      no resident population and ACS publishes nothing for them.
    //   2. Tract splits and missing-data gaps: the topology file may
    //      include tracts (e.g., Fairfax 4405.04) that the ACS vintage
    //      didn't publish — typically because the tract was newly
    //      split from a parent tract after the ACS sample was drawn,
    //      or because disclosure-avoidance suppressed it.
    //
    // Both cases get the same VISUAL treatment (grey diagonal hatch)
    // so they read as "intentionally not colored" rather than a bug;
    // the TOOLTIP distinguishes the cause.
    //
    // GEOID is state(2)+county(3)+tract(6) — tract portion's first two
    // digits start at index 5. Block-group adds a single digit at the
    // end (12 total) but the tract portion sits at the same index.
    const isSpecialLandUseTract = (geoid: string): boolean => {
      return geoid.length >= 7 && geoid.slice(5, 7) === "98";
    };
    // Diagnostic constants live here so they're visible from the
    // hatching block AND the zoom-setup block below. Bump when
    // shipping a new behavior so a screenshot of devtools tells us
    // whether the user is on the right bundle.
    const CHORO_BUILD = "hatch-v6-all-levels-2026-05-30";
    // Hatch ALL no-data polygons regardless of geo level. The earlier
    // gate (tract / block-group only) made sense when the only
    // no-data case was 9800-series special-land-use tracts. With the
    // expansion to per-state metro maps + state-level partial-coverage
    // indicators, state and county levels also need the same visual
    // "intentionally not colored" treatment instead of rendering as
    // confusing white holes against the colored regions.
    {
      const svgEl = svg as unknown as SVGSVGElement;
      // Inject the hatching pattern into <defs> once per dialog. The
      // ID is per-canvas so multiple maps on the same page don't
      // collide. patternUnits="userSpaceOnUse" + non-scaling-stroke
      // on the line keeps the stripes visually stable across d3-zoom
      // levels (without it, zooming in 16× turns the hatch into solid
      // blocks of grey).
      const safeId = b.chartId.replace(/[^a-z0-9-]/gi, "-");
      const patternId = `map-no-data-${safeId}`;
      let defs = svgEl.querySelector("defs");
      if (!defs) {
        defs = document.createElementNS("http://www.w3.org/2000/svg", "defs");
        svgEl.insertBefore(defs, svgEl.firstChild);
      }
      if (!defs.querySelector(`#${patternId}`)) {
        const pattern = document.createElementNS(
          "http://www.w3.org/2000/svg",
          "pattern",
        );
        pattern.setAttribute("id", patternId);
        pattern.setAttribute("width", "8");
        pattern.setAttribute("height", "8");
        pattern.setAttribute("patternUnits", "userSpaceOnUse");
        pattern.setAttribute("patternTransform", "rotate(45)");
        const bg = document.createElementNS(
          "http://www.w3.org/2000/svg",
          "rect",
        );
        bg.setAttribute("width", "8");
        bg.setAttribute("height", "8");
        bg.setAttribute("fill", "#ececec");
        pattern.appendChild(bg);
        const stripe = document.createElementNS(
          "http://www.w3.org/2000/svg",
          "line",
        );
        stripe.setAttribute("x1", "0");
        stripe.setAttribute("y1", "0");
        stripe.setAttribute("x2", "0");
        stripe.setAttribute("y2", "8");
        stripe.setAttribute("stroke", "#bababa");
        stripe.setAttribute("stroke-width", "2.5");
        stripe.setAttribute("vector-effect", "non-scaling-stroke");
        pattern.appendChild(stripe);
        defs.appendChild(pattern);
      }
      // Re-fill any path whose feature has no value in `values`. This
      // covers BOTH 9800-series special-land-use tracts AND any other
      // tract the data doesn't cover this vintage (post-2020 splits,
      // disclosure-suppressed cells, etc.). The tooltip handler
      // (below) reads the same value-presence check and chooses the
      // explanation text based on whether isSpecialLandUseTract.
      const allPaths = svgEl.querySelectorAll<SVGPathElement>("path");
      let hatchedSpecial = 0;
      let hatchedMissing = 0;
      const specialExamples: string[] = [];
      const missingExamples: string[] = [];
      allPaths.forEach((p) => {
        const d = (p as unknown as { __data__?: { id?: string } }).__data__;
        if (!d?.id) return;
        const v = values[d.id];
        if (v != null && Number.isFinite(v)) return;
        p.setAttribute("fill", `url(#${patternId})`);
        if (isSpecialLandUseTract(d.id)) {
          hatchedSpecial += 1;
          if (specialExamples.length < 3) specialExamples.push(d.id);
        } else {
          hatchedMissing += 1;
          if (missingExamples.length < 3) missingExamples.push(d.id);
        }
      });
      // Diagnostic: only log when something was actually hatched, so a
      // page with N healthy maps doesn't add N noise lines per render.
      if (hatchedSpecial + hatchedMissing > 0) {
        console.info(
          `[map ${CHORO_BUILD}] ${b.chartId} (${b.geo}, mode=${mode}): ` +
          `hatched ${hatchedSpecial} special-land-use (e.g. ${specialExamples.join(", ") || "—"}) ` +
          `+ ${hatchedMissing} missing-data (e.g. ${missingExamples.join(", ") || "—"})`,
        );
      }
      // Static legend note: when any regions came back hatched, pin a
      // one-liner under the figure explaining what the stripes mean.
      // The per-region hover tooltip explains specific cases (9800
      // special land use vs missed vintage) but a reader scanning the
      // map needs to know the visual code WITHOUT hovering every grey
      // polygon. Mode "tile" suppresses (dashboard thumbnails are
      // chrome-free) but expanded + fullscreen show it. Skipped when
      // every polygon has data (most common case).
      const totalHatched = hatchedSpecial + hatchedMissing;
      if (totalHatched > 0 && mode !== "tile") {
        // De-dupe if a re-paint happens — replace any prior note.
        canvas.querySelector(".map-nodata-note")?.remove();
        const note = document.createElement("p");
        note.className = "map-nodata-note";
        note.style.cssText =
          "margin: 6px 4px 0; font-size: 12px; color: var(--color-neutral-600); display: flex; align-items: center; gap: 6px;";
        const swatch = document.createElement("span");
        swatch.style.cssText =
          "display: inline-block; width: 14px; height: 14px; border: 1px solid #bababa; background: repeating-linear-gradient(45deg, #ececec 0 2.5px, #bababa 2.5px 5px); flex-shrink: 0;";
        note.appendChild(swatch);
        const text = document.createElement("span");
        text.textContent =
          `Hatched: ${totalHatched.toLocaleString()} region${totalHatched === 1 ? "" : "s"} with no published data for this indicator + vintage. Hover for details.`;
        note.appendChild(text);
        canvas.appendChild(note);
      }
    }
    const tooltip = document.createElement("div");
    tooltip.className = "map-tooltip";
    tooltip.style.display = "none";
    canvas.appendChild(tooltip);
    const rectCache = { rect: canvas.getBoundingClientRect() };
    // Stash the current paint's rectCache on the canvas so the ONE persistent
    // resize listener (attached below, once per canvas) always refreshes the
    // latest paint's cache. paint() runs on every zoom / color-scheme / vintage
    // / cartogram / fullscreen toggle, so attaching a fresh window listener each
    // time would leak one per re-paint. Guard with a flag on the canvas node so
    // a second paint() reuses the existing listener instead of adding a duplicate.
    const stash = canvas as unknown as {
      __mapRectCache?: { rect: DOMRect };
      __mapResizeBound?: boolean;
    };
    stash.__mapRectCache = rectCache;
    if (!stash.__mapResizeBound) {
      stash.__mapResizeBound = true;
      window.addEventListener(
        "resize",
        () => {
          const rc = stash.__mapRectCache;
          if (rc) rc.rect = canvas.getBoundingClientRect();
        },
        { passive: true },
      );
    }
    let pendingEv: MouseEvent | null = null;
    let rafQueued = false;
    function flushTooltip() {
      rafQueued = false;
      const ev = pendingEv;
      pendingEv = null;
      if (!ev) return;
      const target = ev.target as Element | null;
      // Hot path: most mousemove targets land directly on a <path>.
      let path: Element | null =
        target && target.tagName === "path" ? target : null;
      if (!path && target) path = target.closest("path");
      if (!path) {
        if (tooltip.style.display !== "none") tooltip.style.display = "none";
        return;
      }
      const d = (path as any).__data__ as
        | { id?: string; properties?: { name?: string } } | undefined;
      if (!d?.id) {
        if (tooltip.style.display !== "none") tooltip.style.display = "none";
        return;
      }
      const v = values[d.id];
      // properties.name already carries the curated colloquial
      // override (set at paint time in the normalize loop, see
      // `specialTractName` block above) — no per-pointermove lookup.
      const name = d.properties?.name ?? d.id;
      if (v == null || !Number.isFinite(v)) {
        // No-data polygon — explain why it's hatched. The two
        // tract/block-group special cases get a sharper message
        // (9800-series special-land-use vs missed-vintage); state /
        // county get a generic "not published for this indicator +
        // vintage" since the cause isn't usually knowable from the
        // geo code alone (could be sample suppression, indicator
        // doesn't cover that region, etc.).
        const isTractGeo = b.geo === "tract" || b.geo === "block-group";
        if (isTractGeo && isSpecialLandUseTract(d.id)) {
          tooltip.textContent =
            `${name}: special land use (no resident population, no ACS data)`;
        } else if (isTractGeo) {
          tooltip.textContent =
            `${name}: no data published for this vintage`;
        } else {
          tooltip.textContent =
            `${name}: no data published for this indicator + vintage`;
        }
        tooltip.style.display = "block";
        tooltip.style.left = (ev.clientX - rectCache.rect.left + 12) + "px";
        tooltip.style.top = (ev.clientY - rectCache.rect.top + 12) + "px";
        return;
      }
      tooltip.textContent = `${name}: ${fmtValue(v, b.unit, b.decimals)}`;
      tooltip.style.display = "block";
      tooltip.style.left = (ev.clientX - rectCache.rect.left + 12) + "px";
      tooltip.style.top = (ev.clientY - rectCache.rect.top + 12) + "px";
    }
    svg.addEventListener("mousemove", (ev: MouseEvent) => {
      pendingEv = ev;
      if (rafQueued) return;
      rafQueued = true;
      requestAnimationFrame(flushTooltip);
    }, { passive: true });
    svg.addEventListener("mouseleave", () => {
      pendingEv = null;
      tooltip.style.display = "none";
    });

    // Zoom: enabled for county-and-finer maps in the expanded /
    // fullscreen dialog. State-level maps are already a single-
    // screen view so zoom would be confusing; tiles stay non-zoom
    // so a click-and-drag still passes through to the expand-tile
    // click handler without ambiguity.
    //
    // Strategy: d3-zoom on the SVG element with a transform applied
    // to Plot's geo <g> group only (NOT the color legend group).
    // Mouse wheel zooms; click-and-drag pans; ctrl+= / ctrl+- / ctrl+0
    // give keyboard control while the dialog is open.
    //
    // translateExtent is set to the SVG viewBox so pans hit the
    // edges of the rendered area instead of wandering into empty
    // space. scaleExtent caps zoom at 16× — beyond that, polygon
    // rendering gets pixelated.
    //
    // vector-effect: non-scaling-stroke on the paths keeps the 0.3px
    // boundary lines crisp at every zoom level (otherwise 16× zoom
    // turns them into thick smudges).
    if (b.geo !== "state" && mode !== "tile") {
      // svg was cast to HTMLElement above so addEventListener works
      // with MouseEvent listeners. Re-cast through unknown here
      // since the runtime element IS an SVG; TypeScript just lost
      // that info through the earlier HTMLElement cast.
      const svgEl = svg as unknown as SVGSVGElement;
      // Find the zoom target by following the actual path elements
      // back to their common ancestor — DON'T rely on aria-label.
      // Plot's diagnostic output revealed that with legend:true +
      // a custom projection domain, the geo group's aria-label
      // attribute isn't applied: the user saw 4 <g> elements in
      // the SVG, all with null aria-label. The canonical d3-zoom-
      // for-map pattern (per Brett Johnson's Zoomable
      // Map + d3-zoom docs) is to bind d3-zoom to the SVG
      // and apply the transform to a single <g> that wraps every
      // path. We find that g empirically: walk up from path[0]
      // until we hit either a g whose siblings are also paths or
      // the SVG itself; that's our zoom target.
      const allPaths = svgEl.querySelectorAll<SVGPathElement>("path");
      let geoGroup: SVGGElement | null = null;
      if (allPaths.length > 0) {
        // Find the g that contains the most descendant paths — for
        // most Plot outputs that's the geo mark group regardless of
        // whether aria-label was applied.
        let bestG: SVGGElement | null = null;
        let bestCount = 0;
        svgEl.querySelectorAll<SVGGElement>("g").forEach((g) => {
          const c = g.querySelectorAll("path").length;
          if (c > bestCount) {
            bestG = g;
            bestCount = c;
          }
        });
        if (bestG && bestCount === allPaths.length) {
          // The best g contains EVERY path in the SVG — perfect
          // zoom target.
          geoGroup = bestG;
        } else {
          // Either no g exists or the best one doesn't contain all
          // paths. Wrap everything in a new g we create, so we have
          // a clean zoom target.
          const wrapper = document.createElementNS(
            "http://www.w3.org/2000/svg",
            "g",
          ) as SVGGElement;
          wrapper.setAttribute("data-role", "map-zoom-wrap");
          // Move every direct child of the SVG except <style>,
          // <defs>, and <title> into the wrapper. Those non-render
          // elements should stay at the top level.
          const skipTags = new Set(["style", "defs", "title", "desc"]);
          const children = Array.from(svgEl.children);
          for (const c of children) {
            if (skipTags.has(c.tagName.toLowerCase())) continue;
            wrapper.appendChild(c);
          }
          svgEl.appendChild(wrapper);
          geoGroup = wrapper;
        }
      }
      // Diagnostic so a screenshot of devtools tells us whether zoom
      // failed to set up. Only log the SKIPPED case — the healthy case
      // shouldn't add a line per render to every dashboard with maps.
      if (!geoGroup) {
        console.info(
          `[map ${CHORO_BUILD}] ${b.chartId} (${b.geo}, mode=${mode}): ` +
          `zoom setup SKIPPED (no paths found); ` +
          `figure=${(fig as HTMLElement).tagName}, svg=${svgEl.tagName}, ` +
          `total-paths=${allPaths.length}, ` +
          `groups=${svgEl.querySelectorAll("g").length}`,
        );
      }
      if (geoGroup) {
        // Apply non-scaling-stroke to every geo path. Plot doesn't
        // expose a hook for this; the cheapest path is a one-shot
        // attribute set after render.
        geoGroup.querySelectorAll<SVGPathElement>("path").forEach(
          (p: SVGPathElement) =>
            p.setAttribute("vector-effect", "non-scaling-stroke"),
        );
        // ViewBox-aware translateExtent: pulled from the rendered
        // SVG's viewBox so panning is bounded to actual content
        // rather than an arbitrary [0, width]×[0, height] box.
        let extentMinX = 0, extentMinY = 0;
        let extentMaxX = (svgEl.viewBox?.baseVal?.width ?? 0) || svgEl.clientWidth;
        let extentMaxY = (svgEl.viewBox?.baseVal?.height ?? 0) || svgEl.clientHeight;
        if (svgEl.viewBox?.baseVal) {
          extentMinX = svgEl.viewBox.baseVal.x;
          extentMinY = svgEl.viewBox.baseVal.y;
          extentMaxX = extentMinX + svgEl.viewBox.baseVal.width;
          extentMaxY = extentMinY + svgEl.viewBox.baseVal.height;
        }
        // Bind d3-zoom to the SVG element itself (canonical
        // pattern; see Brett Johnson's Zoomable Map and the
        // d3-zoom docs). Previous attempt attached to the canvas
        // wrapper div hoping to catch wheel events on the legend
        // area too, but d3-zoom's touch-detection probe runs on
        // the bound element and is SVG-specific — binding to a div
        // silently skipped touch listener registration on some
        // browsers. Bind to SVG; the manual wheel listener below
        // catches wheel events that hit the canvas-wrap padding
        // outside the SVG bounds.
        const listenerEl = svgEl as unknown as Element;
        const listenerSel = d3select<Element, unknown>(listenerEl);
        const geoSel = d3select(geoGroup);
        const zoom = d3zoom<Element, unknown>()
          .scaleExtent([1, 16])
          .translateExtent([[extentMinX, extentMinY], [extentMaxX, extentMaxY]])
          .filter((event: Event) => {
            // Allow mouse wheel for zoom, drag for pan. Block right
            // click + dblclick. Don't gate on ctrlKey for wheel
            // (so plain scroll zooms, matching the dialog's hint).
            if (event.type === "wheel") return true;
            if (event.type === "mousedown") {
              return (event as MouseEvent).button === 0;
            }
            return event.type !== "dblclick";
          })
          .on("zoom", (event: { transform: ZoomTransform }) => {
            geoSel.attr("transform", event.transform.toString());
          });
        listenerSel.call(zoom);
        // Initialize the zoom transform to identity so subsequent
        // .scaleBy calls have a defined baseline. Without this,
        // d3-zoom's internal __zoom property isn't seeded and
        // scaleBy operates on undefined transform state — sometimes
        // working, sometimes silently no-op'ing (depends on
        // browser-internal property iteration order).
        listenerSel.call(zoom.transform, zoomIdentity);
        // Stash the zoom binding on the canvas DOM node so the
        // dialog-level keyboard shortcut + reset button can reach
        // it. Using a hidden property avoids polluting the global
        // namespace and survives multiple maps on the page.
        (canvas as unknown as { __mapZoom?: unknown }).__mapZoom = {
          zoom, sel: listenerSel,
        };
        // Visual affordance: cursor changes to grab so the user
        // knows the canvas is interactive.
        (canvas.style as CSSStyleDeclaration).cursor = "grab";
        // Belt-and-suspenders wheel zoom. d3-zoom registers its own
        // wheel listener via call(zoom), but several user reports
        // suggest that's getting swallowed by something (browser
        // quirk, focus state, swallowed-by-dialog-scroll). Add a
        // separate non-passive wheel listener that calls into the
        // same zoomScaleBy helper so plain mouse-scroll always
        // triggers some zoom action even if d3-zoom's built-in
        // doesn't. preventDefault() blocks any browser default
        // (e.g. dialog scroll). The factor matches the +/- button
        // step so muscle memory translates.
        const wheelHandler = (e: WheelEvent) => {
          if (!e.deltaY) return;
          e.preventDefault();
          const factor = e.deltaY < 0 ? 1.15 : 1 / 1.15;
          zoomScaleBy(canvas, factor);
        };
        // Remove the previous paint's wheel handler before adding this one.
        // paint() re-runs on every zoom / color-scheme / vintage / cartogram /
        // fullscreen toggle, so without this each re-paint would stack another
        // wheel listener on the canvas. The new handler reads current zoom state
        // through zoomScaleBy -> canvas.__mapZoom (re-stashed above each paint),
        // so it always operates on the latest projection / transform.
        const wheelStash = canvas as unknown as {
          __mapWheelHandler?: (e: WheelEvent) => void;
        };
        if (wheelStash.__mapWheelHandler) {
          canvas.removeEventListener(
            "wheel",
            wheelStash.__mapWheelHandler as EventListener,
          );
        }
        wheelStash.__mapWheelHandler = wheelHandler;
        canvas.addEventListener("wheel", wheelHandler, { passive: false });
      }
    }
  }

  // Programmatic-zoom helpers exposed for the dialog's keyboard
  // shortcuts + reset button. They look up the zoom binding cached
  // on the dialog canvas at paint time.
  function getZoomCtx(canvas: HTMLElement | null) {
    if (!canvas) return null;
    return (canvas as unknown as {
      __mapZoom?: {
        zoom: ZoomBehavior<Element, unknown>;
        sel: ReturnType<typeof d3select<Element, unknown>>;
      };
    }).__mapZoom ?? null;
  }
  function zoomScaleBy(canvas: HTMLElement, factor: number) {
    const ctx = getZoomCtx(canvas);
    if (!ctx) {
      console.warn(
        "[map] zoomScaleBy: no __mapZoom on canvas — " +
        "zoom block didn't run during paint(). data-geo=" +
        canvas.dataset.geo + ", mode=" + canvas.dataset.mode,
      );
      return;
    }
    ctx.sel.transition().duration(180).call(ctx.zoom.scaleBy, factor);
  }
  function zoomReset(canvas: HTMLElement) {
    const ctx = getZoomCtx(canvas);
    if (!ctx) {
      console.warn(
        "[map] zoomReset: no __mapZoom on canvas — " +
        "zoom block didn't run during paint(). data-geo=" +
        canvas.dataset.geo + ", mode=" + canvas.dataset.mode,
      );
      return;
    }
    ctx.sel.transition().duration(200).call(ctx.zoom.transform, zoomIdentity);
  }

  // Hydrate ONE map canvas: parse its data-* bindings and paint it.
  // Returns the paint promise so a scheduler can await completion (the
  // desktop ordered pool below relies on this). Idempotent via the
  // data-hydrated guard, and a no-op for canvases the server flagged
  // data-skip-hydrate.
  async function hydrateOne(canvas: HTMLElement): Promise<void> {
    if (canvas.dataset.hydrated === "1") return;
    canvas.dataset.hydrated = "1";
    // When the server side already determined that no data file
    // was readable for this chart (typically: chart was added
    // after the last workflow run, the underlying data hasn't
    // been fetched yet), bail out without trying to client-fetch.
    // Otherwise the client request would 404 and overwrite the
    // helpful "data not yet fetched" eyebrow message with a
    // cryptic "values …json: 404" error.
    if (canvas.dataset.skipHydrate === "1") return;
    // Three render sizes: tile (dashboard thumbnail), expanded
    // (dialog default), fullscreen (CSS-wide dialog). Previously
    // narrowed to two and "fullscreen" silently fell through to
    // "tile" — that's why the Full-screen toggle visibly flipped
    // the dialog width but the SVG inside stayed thumbnail-sized.
    const raw = canvas.dataset.mode;
    const mode: "tile" | "expanded" | "fullscreen" =
      raw === "fullscreen" ? "fullscreen"
      : raw === "expanded" ? "expanded"
      : "tile";
    let parsedDataUrls: string[] = [];
    try {
      parsedDataUrls = JSON.parse(canvas.dataset.dataUrls ?? "[]");
    } catch { /* leave empty; canvas will render "no data" */ }
    let parsedBoundaryUrls: string[] = [];
    try {
      parsedBoundaryUrls = JSON.parse(canvas.dataset.boundaryUrls ?? "[]");
    } catch { /* leave empty; falls back to single boundaryUrl below */ }
    if (parsedBoundaryUrls.length === 0 && canvas.dataset.boundaryUrl) {
      parsedBoundaryUrls = [canvas.dataset.boundaryUrl];
    }
    // Guard the bbox parse too (mirrors the URL parses above) so a
    // malformed data-bbox can't throw. This matters now that hydrateOne
    // feeds the fire-and-forget IO callback + desktop pool, where a
    // synchronous throw would surface as an unhandled rejection and kill
    // one pool worker. bbox is server-emitted so this is belt-and-
    // suspenders; a missing bbox just means a full-extent projection.
    let parsedBbox: [number, number, number, number] | null = null;
    try {
      if (canvas.dataset.bbox && canvas.dataset.bbox !== "null") {
        parsedBbox = JSON.parse(canvas.dataset.bbox) as
          [number, number, number, number];
      }
    } catch { /* malformed bbox → null → full-extent projection */ }
    const b: ChoroBindings = {
      chartId: canvas.dataset.chartId ?? "",
      dataUrls: parsedDataUrls,
      boundaryUrl: canvas.dataset.boundaryUrl ?? "",
      boundaryUrls: parsedBoundaryUrls,
      geo: (canvas.dataset.geo ?? "county") as ChoroBindings["geo"],
      state: canvas.dataset.state ?? "",
      bbox: parsedBbox,
      colorScheme: canvas.dataset.colorScheme ?? "blues",
      colorScale: (canvas.dataset.colorScale ?? "linear") as
        ChoroBindings["colorScale"],
      cartogram: canvas.dataset.cartogram === "1",
      cartogramUrl: canvas.dataset.cartogramUrl ?? "",
      cartogramBase: canvas.dataset.cartogramBase ?? "",
      cartogramVintages: (() => {
        try { return JSON.parse(canvas.dataset.cartogramVintages ?? "[]") as number[]; }
        catch { return []; }
      })(),
      vintage: canvas.dataset.vintage ?? "",
      valueLabel: canvas.dataset.valueLabel ?? "",
      unit: canvas.dataset.unit ?? "",
      decimals: Number(canvas.dataset.decimals ?? "1"),
    };
    await paint(canvas, b, mode).catch((e) => {
      canvas.innerHTML = `<p class="muted small">Map failed to load: ${String(e?.message ?? e)}</p>`;
    });
  }

  // Initial page-load hydration, strategy by viewport. A dashboard can
  // stack many maps and each pulls a heavy per-state TopoJSON (block-
  // group files run 250-420 KB), so painting all of them at once is
  // wasteful and gives the above-the-fold maps no priority.
  //   • Mobile: PURE LAZY. An IntersectionObserver hydrates each map
  //     only as it nears the viewport (400px lead), so a long page
  //     never fetches megabytes the reader may never scroll to.
  //   • Desktop: LOAD ALL, TOP-TO-BOTTOM. Every map hydrates, but
  //     through a small ordered concurrency pool (DOM order == visual
  //     order) so the top maps get the connection + render budget
  //     first instead of N maps racing the main thread at once.
  // The dialog / slider / fullscreen / scheme re-render paths call
  // hydrateOne directly on their own canvas, so this strategy governs
  // only the first paint — the mobile laziness isn't undone later.
  function hydrateInitial() {
    const canvases = Array.from(
      document.querySelectorAll<HTMLElement>("[data-role='map-canvas']"),
    );
    if (canvases.length === 0) return;
    if (isMobileViewport() && "IntersectionObserver" in window) {
      const io = new IntersectionObserver((entries, obs) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          obs.unobserve(entry.target);
          hydrateOne(entry.target as HTMLElement);
        }
      }, { rootMargin: "400px 0px" });
      canvases.forEach((c) => io.observe(c));
      return;
    }
    // Desktop (or no IntersectionObserver support): ordered pool.
    // Workers pull from a shared cursor in DOM order, so the first
    // CONCURRENCY maps start immediately and each completion advances
    // to the next map down the page. CONCURRENCY 4 stays under the
    // browser's ~6 per-host connection cap while keeping the main
    // thread from rendering every map simultaneously.
    const CONCURRENCY = 4;
    let next = 0;
    async function worker(): Promise<void> {
      while (next < canvases.length) {
        await hydrateOne(canvases[next++]);
      }
    }
    for (let i = 0; i < Math.min(CONCURRENCY, canvases.length); i++) {
      void worker();
    }
  }

  // ---- Click-to-expand ----
  //
  // Behaves like the other dashboard chart tiles' click-to-expand —
  // opens a native <dialog> with showModal(), so ESC dismisses for
  // free and the focus trap is automatic. Inside the dialog: bigger
  // version of the same map, a "Full screen" toggle, the metadata
  // footer that used to clutter the tile.
  //
  // Click wiring uses document-level event delegation, which is the
  // boring-and-correct shape: no per-tile setup ordering issues, no
  // missed tiles that hydrated late, no double-bind risk on re-render.
  function ensureDialog(): HTMLDialogElement {
    let dialog = document.querySelector<HTMLDialogElement>("#map-expand-dialog");
    if (dialog) return dialog;
    dialog = document.createElement("dialog");
    dialog.id = "map-expand-dialog";
    dialog.className = "map-dialog";
    // Accessible name: the dialog's visible title heading (its textContent is
    // set per-open in showExpanded). aria-labelledby points at that heading so
    // screen readers announce "<map title>, dialog" instead of a bare "dialog".
    dialog.setAttribute("aria-labelledby", "map-dialog-title-h");
    // Build the scheme-picker options HTML once.
    const optsHtml = SCHEMES.map(
      (s) => `<option value="${s.key}">${s.label}</option>`,
    ).join("");
    dialog.innerHTML = `
      <header class="map-dialog-header">
        <div class="map-dialog-titles">
          <h3 class="map-dialog-title" id="map-dialog-title-h"></h3>
          <p class="map-dialog-eyebrow muted small"></p>
        </div>
        <div class="map-dialog-actions">
          <label class="map-dialog-scheme">
            <span class="muted small">Color</span>
            <select class="map-dialog-scheme-select" aria-label="Color scheme">${optsHtml}</select>
          </label>
          <label class="map-dialog-cartogram" hidden>
            <span class="muted small">Shape</span>
            <select class="map-dialog-cartogram-select" aria-label="Weight map shapes by land area or population">
              <option value="area">Land area</option>
              <option value="pop">Population</option>
            </select>
          </label>
          <button type="button" class="map-dialog-zoom-out" aria-label="Zoom out" title="Zoom out (Ctrl+−)">−</button>
          <button type="button" class="map-dialog-zoom-in" aria-label="Zoom in" title="Zoom in (Ctrl+=)">+</button>
          <button type="button" class="map-dialog-zoom-reset" aria-label="Reset zoom" title="Reset zoom (Ctrl+0)">⟲ Reset zoom</button>
          <button type="button" class="map-dialog-fullscreen" aria-label="Toggle full screen">⤢ Full screen</button>
          <button type="button" class="map-dialog-close" aria-label="Close">&times;</button>
        </div>
      </header>
      <div class="map-dialog-year" hidden>
        <label class="muted small" for="map-year-slider">Year</label>
        <input class="map-dialog-year-slider" id="map-year-slider" type="range" min="0" max="0" value="0" step="1" aria-label="ACS 5-year vintage" />
        <output class="map-dialog-year-readout"></output>
      </div>
      <details class="map-dialog-why">
        <summary>Why no rainbow?</summary>
        <p>
          Rainbow color maps look bright but mislead the reader. The
          eye can't perceive equal steps of a value as equal steps in
          color across a rainbow ramp — yellow regions visually pop
          out, dim blues blur together — so a 60th-percentile region
          can read as more extreme than an 85th-percentile one. The
          effect is worse for the ~8% of men with red-green color
          vision differences, who can't reliably order the yellow /
          green / red bands at all. Mono-hue ramps preserve the
          value's ordinal information; perceptually uniform multi-hue
          (Viridis, Batlow) do so while still covering a wider color
          gamut.
        </p>
        <p class="muted small">
          Reference: Crameri, Shephard &amp; Heron,
          <a href="https://doi.org/10.1038/s41467-020-19160-7"
             target="_blank" rel="noopener noreferrer">The misuse of colour in
          science communication</a> (Nature Communications, 2020).
        </p>
      </details>
      <div class="map-dialog-canvas-wrap"></div>
      <footer class="map-dialog-footer">
        <p class="muted small map-dialog-meta"></p>
        <p class="muted small map-dialog-zoom-hint" hidden>Scroll to zoom · drag to pan · Ctrl+0 to reset</p>
      </footer>
    `;
    document.body.appendChild(dialog);
    // Backdrop click → close. <dialog> exposes the ::backdrop pseudo-
    // element but its click target is the dialog itself; we detect
    // by checking that the click landed on the dialog and not on a
    // descendant.
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog!.close();
    });
    dialog.querySelector(".map-dialog-close")?.addEventListener("click", () => {
      dialog!.close();
    });
    // Fullscreen toggle — CSS-only expansion of the dialog to fill
    // the viewport. NOT the OS Fullscreen API (which removes the
    // browser chrome and was disorienting). The .map-dialog-wide
    // class flips the dialog to 100vw × 100vh; we then re-paint the
    // canvas in "fullscreen" mode so the SVG actually grows to fill
    // the new space.
    const fullscreenBtn = dialog.querySelector<HTMLButtonElement>(".map-dialog-fullscreen");
    function syncFullscreenUI(isFs: boolean) {
      if (fullscreenBtn) {
        fullscreenBtn.textContent = isFs ? "⤡ Exit full screen" : "⤢ Full screen";
      }
      dialog!.classList.toggle("map-dialog-wide", isFs);
      const dialogCanvas = dialog!.querySelector<HTMLElement>(
        "[data-role='map-canvas']",
      );
      if (dialogCanvas) {
        dialogCanvas.dataset.mode = isFs ? "fullscreen" : "expanded";
        dialogCanvas.removeAttribute("data-hydrated");
        dialogCanvas.innerHTML = "";
        // Defer to next frame so the new .map-dialog-wide layout
        // applies before paint() reads window dimensions. Without
        // this, the SVG is sometimes sized using the pre-toggle
        // viewport.
        requestAnimationFrame(() => hydrateOne(dialogCanvas));
      }
    }
    fullscreenBtn?.addEventListener("click", () => {
      const isFs = dialog!.classList.contains("map-dialog-wide");
      syncFullscreenUI(!isFs);
    });
    dialog.addEventListener("close", () => {
      // Clear the canvas so re-opening doesn't show a stale map for
      // a moment while the new one paints.
      const wrap = dialog!.querySelector(".map-dialog-canvas-wrap") as HTMLElement;
      if (wrap) wrap.innerHTML = "";
      dialog!.classList.remove("map-dialog-wide");
      // Reset the fullscreen button text. The dialog is SHARED across
      // every map chart on the page (single #map-expand-dialog
      // node via ensureDialog), so leaving the text as "Exit full screen"
      // means the next chart that opens this dialog shows stale label
      // text — and the next click reads classList (correctly NOT wide
      // after the line above) and toggles INTO fullscreen, even though
      // the button claims it'll exit. That's why entering fullscreen on
      // a chart felt like it required two clicks: the first click
      // matched the stale "exit" text to the actually-not-wide state.
      if (fullscreenBtn) fullscreenBtn.textContent = "⤢ Full screen";
    });
    // Reset-zoom button: returns the map to its initial scale +
    // translate via the d3-zoom programmatic API. Visible only when
    // there's a zoom binding active (county-and-finer); on state
    // maps it would be a no-op so we hide it via classList.
    const resetBtn = dialog.querySelector<HTMLButtonElement>(
      ".map-dialog-zoom-reset",
    );
    resetBtn?.addEventListener("click", () => {
      const dialogCanvas = dialog!.querySelector<HTMLElement>(
        "[data-role='map-canvas']",
      );
      if (dialogCanvas) zoomReset(dialogCanvas);
    });
    // Manual zoom-in / zoom-out buttons. Same factor (1.5x) as the
    // keyboard shortcuts. Useful when wheel zoom isn't behaving
    // (touchpad-without-momentum, browser quirks, etc.) — the user
    // can always reach the same zoom states via these.
    const zoomInBtn = dialog.querySelector<HTMLButtonElement>(
      ".map-dialog-zoom-in",
    );
    const zoomOutBtn = dialog.querySelector<HTMLButtonElement>(
      ".map-dialog-zoom-out",
    );
    zoomInBtn?.addEventListener("click", () => {
      const dialogCanvas = dialog!.querySelector<HTMLElement>(
        "[data-role='map-canvas']",
      );
      if (dialogCanvas) zoomScaleBy(dialogCanvas, 1.5);
    });
    zoomOutBtn?.addEventListener("click", () => {
      const dialogCanvas = dialog!.querySelector<HTMLElement>(
        "[data-role='map-canvas']",
      );
      if (dialogCanvas) zoomScaleBy(dialogCanvas, 1 / 1.5);
    });
    // Keyboard shortcuts while the dialog has focus:
    //   Ctrl/Cmd + = / + → zoom in
    //   Ctrl/Cmd + -     → zoom out
    //   Ctrl/Cmd + 0     → reset
    // We preventDefault so the browser's page-zoom shortcuts don't
    // trigger (the user explicitly asked for those to be hijacked).
    // Scoped to dialog.open so we don't capture the keys at other
    // times in the page.
    dialog.addEventListener("keydown", (e: KeyboardEvent) => {
      if (!(e.ctrlKey || e.metaKey)) return;
      const dialogCanvas = dialog!.querySelector<HTMLElement>(
        "[data-role='map-canvas']",
      );
      if (!dialogCanvas) return;
      if (e.key === "=" || e.key === "+") {
        e.preventDefault();
        zoomScaleBy(dialogCanvas, 1.5);
      } else if (e.key === "-" || e.key === "_") {
        e.preventDefault();
        zoomScaleBy(dialogCanvas, 1 / 1.5);
      } else if (e.key === "0") {
        e.preventDefault();
        zoomReset(dialogCanvas);
      }
    });
    // Scheme picker: on change, persist the override for the chart
    // currently displayed in the dialog, then re-paint the dialog
    // canvas + the source tile so the user sees the new color
    // immediately in both places.
    const sel = dialog.querySelector<HTMLSelectElement>(
      ".map-dialog-scheme-select",
    );
    sel?.addEventListener("change", () => {
      const chartId = dialog!.dataset.activeChartId;
      if (!chartId || !sel.value) return;
      saveOverride(chartId, sel.value);
      // Re-paint dialog canvas in place.
      const dialogCanvas = dialog!.querySelector<HTMLElement>(
        "[data-role='map-canvas']",
      );
      if (dialogCanvas) {
        dialogCanvas.removeAttribute("data-hydrated");
        dialogCanvas.innerHTML = "";
      }
      // Re-paint the source tile canvas too — different charts on
      // the page keep their own schemes, but the chart whose dialog
      // we changed should update its tile in lockstep.
      const tileCanvas = document.querySelector<HTMLElement>(
        `[data-map='1'][data-chart-id='${chartId}'] [data-role='map-canvas']`,
      );
      if (tileCanvas) {
        tileCanvas.removeAttribute("data-hydrated");
        tileCanvas.innerHTML = "";
      }
      if (dialogCanvas) hydrateOne(dialogCanvas);
      if (tileCanvas) hydrateOne(tileCanvas);
    });
    // Area / Population toggle: swap the boundary geometry on both the dialog
    // canvas and the source tile, then re-paint both. Not persisted — resets to
    // the chart's default on reload (unlike the scheme override).
    const cartoSelEl = dialog.querySelector<HTMLSelectElement>(
      ".map-dialog-cartogram-select",
    );
    cartoSelEl?.addEventListener("change", () => {
      const chartId = dialog!.dataset.activeChartId;
      if (!chartId) return;
      const mode = cartoSelEl.value === "pop" ? "1" : "0";
      const canvases = [
        dialog!.querySelector<HTMLElement>("[data-role='map-canvas']"),
        document.querySelector<HTMLElement>(
          `[data-map='1'][data-chart-id='${chartId}'] [data-role='map-canvas']`,
        ),
      ];
      for (const canvas of canvases) {
        if (!canvas) continue;
        canvas.dataset.cartogram = mode;
        canvas.removeAttribute("data-hydrated");
        canvas.innerHTML = "";
        hydrateOne(canvas);
      }
    });
    // Year slider: split between `input` (cheap — readout follows the
    // thumb as the user drags) and `change` (expensive — actual
    // fetch + re-paint, fires once when the user releases). This
    // avoids triggering a paint on every pixel of drag while still
    // feeling responsive.
    const slider = dialog.querySelector<HTMLInputElement>(
      ".map-dialog-year-slider",
    );
    slider?.addEventListener("input", () => {
      const vintages = (
        (slider.dataset.vintages ? JSON.parse(slider.dataset.vintages) : []) as string[]
      );
      const idx = Math.max(0, Math.min(vintages.length - 1, parseInt(slider.value, 10) || 0));
      const newVintage = vintages[idx];
      if (!newVintage) return;
      const readout = dialog!.querySelector<HTMLElement>(
        ".map-dialog-year-readout",
      );
      if (readout) readout.textContent = newVintage;
    });
    slider?.addEventListener("change", () => {
      const vintages = (
        (slider.dataset.vintages ? JSON.parse(slider.dataset.vintages) : []) as string[]
      );
      const idx = Math.max(0, Math.min(vintages.length - 1, parseInt(slider.value, 10) || 0));
      const newVintage = vintages[idx];
      if (!newVintage) return;
      const readout = dialog!.querySelector<HTMLElement>(
        ".map-dialog-year-readout",
      );
      if (readout) readout.textContent = newVintage;
      const dialogCanvas = dialog!.querySelector<HTMLElement>(
        "[data-role='map-canvas']",
      );
      if (!dialogCanvas) return;
      // Rebuild dataUrls by swapping the vintage. URL shape:
      //   /data/<dataDirSeg>/[<state>/]<indicator>_<vintage>.json
      const indicatorId = dialogCanvas.dataset.indicator ?? "";
      const dirSeg = dialogCanvas.dataset.dataDirSeg ?? "";
      const states = (dialogCanvas.dataset.states ?? "")
        .split(",").map((s) => s.trim()).filter(Boolean);
      const isShardedByState =
        dirSeg === "acs_tract" || dirSeg === "acs_block_group";
      let urls: string[];
      if (isShardedByState) {
        urls = states.map((st) =>
          `/data/${dirSeg}/${st}/${indicatorId}_${newVintage}.json`);
      } else {
        urls = [`/data/${dirSeg}/${indicatorId}_${newVintage}.json`];
      }
      dialogCanvas.dataset.dataUrls = JSON.stringify(urls);
      dialogCanvas.dataset.vintage = newVintage;
      dialogCanvas.removeAttribute("data-hydrated");
      dialogCanvas.innerHTML = "";
      // Refresh the meta footer to reflect the new vintage's
      // lastUpdated stamp (different vintages may have been
      // re-fetched on different workflow runs).
      const firstUrl = urls[0];
      if (firstUrl) {
        fetch(firstUrl)
          .then((r) => r.json())
          .then((j) => {
            const meta = dialog!.querySelector<HTMLElement>(
              ".map-dialog-meta",
            );
            if (!meta) return;
            const updated = j.lastUpdated
              ? new Date(j.lastUpdated).toLocaleDateString("en-US", {
                  year: "numeric", month: "short", day: "numeric",
                })
              : "";
            meta.textContent = `ACS 5-year · vintage ${j.vintage} · ${j.geo} level · updated ${updated}`;
          })
          .catch(() => {});
      }
      hydrateOne(dialogCanvas);
    });
    return dialog;
  }

  function openExpanded(tile: HTMLElement) {
    const canvasSrc = tile.querySelector<HTMLElement>("[data-role='map-canvas']");
    if (!canvasSrc) return;
    const title = tile.querySelector<HTMLElement>(".chart-tile-title")?.textContent ?? "";
    const eyebrow = tile.querySelector<HTMLElement>(".map-eyebrow")?.textContent ?? "";
    const dialog = ensureDialog();
    const chartId = tile.dataset.chartId ?? "";
    dialog.dataset.activeChartId = chartId;
    (dialog.querySelector(".map-dialog-title") as HTMLElement).textContent = title;
    (dialog.querySelector(".map-dialog-eyebrow") as HTMLElement).textContent = eyebrow;
    // Pre-select the dropdown to the currently-effective scheme so
    // the user sees their current choice (default OR override).
    const sel = dialog.querySelector<HTMLSelectElement>(
      ".map-dialog-scheme-select",
    );
    if (sel) {
      const authorScheme = canvasSrc.dataset.colorScheme ?? "blues";
      sel.value = effectiveScheme(chartId, authorScheme);
    }
    // Area / Population toggle: shown only when a cartogram asset exists for this
    // map's geo; preselect the chart's current mode.
    const cartoWrap = dialog.querySelector<HTMLElement>(".map-dialog-cartogram");
    const cartoSel = dialog.querySelector<HTMLSelectElement>(
      ".map-dialog-cartogram-select",
    );
    if (cartoWrap && cartoSel) {
      if (canvasSrc.dataset.cartogramUrl) {
        cartoSel.value = canvasSrc.dataset.cartogram === "1" ? "pop" : "area";
        cartoWrap.hidden = false;
      } else {
        cartoWrap.hidden = true;
      }
    }
    // Zoom controls are only useful for county-and-finer maps —
    // state maps don't get a zoom binding. Hide accordingly so the
    // dialog header doesn't show dead buttons. Same hide-rule for
    // the "scroll to zoom" hint in the footer.
    const zoomBtns = dialog.querySelectorAll<HTMLButtonElement>(
      ".map-dialog-zoom-reset, .map-dialog-zoom-in, .map-dialog-zoom-out",
    );
    const zoomHint = dialog.querySelector<HTMLElement>(
      ".map-dialog-zoom-hint",
    );
    const isStateLevel = canvasSrc.dataset.geo === "state";
    zoomBtns.forEach((b) => { b.hidden = isStateLevel; });
    if (zoomHint) zoomHint.hidden = isStateLevel;
    // Year slider: configure range from the tile's data-vintages.
    // Show only when there's more than one vintage to choose from —
    // a single-vintage indicator (or one with discovery failure)
    // gets a hidden slider so the dialog stays uncluttered.
    const yearWrap = dialog.querySelector<HTMLElement>(".map-dialog-year");
    const slider = dialog.querySelector<HTMLInputElement>(
      ".map-dialog-year-slider",
    );
    const yearReadout = dialog.querySelector<HTMLElement>(
      ".map-dialog-year-readout",
    );
    let vintages: string[] = [];
    try {
      vintages = JSON.parse(canvasSrc.dataset.vintages ?? "[]") as string[];
    } catch { /* default empty */ }
    const defaultVintage = canvasSrc.dataset.vintage ?? "";
    if (yearWrap && slider) {
      if (vintages.length > 1) {
        slider.min = "0";
        slider.max = String(vintages.length - 1);
        slider.dataset.vintages = JSON.stringify(vintages);
        const defaultIdx = Math.max(0, vintages.indexOf(defaultVintage));
        slider.value = String(defaultIdx);
        if (yearReadout) yearReadout.textContent = vintages[defaultIdx];
        yearWrap.hidden = false;
      } else {
        yearWrap.hidden = true;
      }
    }
    // Fresh canvas — copy the source tile's data-* attrs so the
    // expanded paint runs with identical bindings + mode=expanded.
    const wrap = dialog.querySelector(".map-dialog-canvas-wrap") as HTMLElement;
    wrap.innerHTML = "";
    const expandedCanvas = document.createElement("div");
    expandedCanvas.className = "map-canvas map-canvas-expanded";
    expandedCanvas.setAttribute("data-role", "map-canvas");
    for (const attr of Array.from(canvasSrc.attributes)) {
      if (attr.name === "class") continue;
      expandedCanvas.setAttribute(attr.name, attr.value);
    }
    expandedCanvas.setAttribute("data-mode", "expanded");
    expandedCanvas.removeAttribute("data-hydrated");
    wrap.appendChild(expandedCanvas);
    // Metadata footer: read the first snapshot shard's vintage +
    // lastUpdated. For multi-shard charts (DMV tracts merge VA + MD
    // + DC), all shards come from the same pipeline run with the
    // same vintage, so reading the first one is fine.
    let firstUrl = "";
    try {
      const urls = JSON.parse(canvasSrc.dataset.dataUrls ?? "[]");
      firstUrl = urls[0] ?? "";
    } catch { /* no urls — meta stays empty */ }
    if (firstUrl) {
      fetch(firstUrl)
        .then((r) => r.json())
        .then((j) => {
          const meta = dialog.querySelector(".map-dialog-meta") as HTMLElement;
          const updated = j.lastUpdated
            ? new Date(j.lastUpdated).toLocaleDateString("en-US", {
                year: "numeric", month: "short", day: "numeric",
              })
            : "";
          meta.textContent = `ACS 5-year · vintage ${j.vintage} · ${j.geo} level · updated ${updated}`;
        })
        .catch(() => {});
    }
    // In the welcome popout (?expanded=1 → body.embed-body-expanded) the
    // iframe IS the dialog stage, so open the map already FILLING it
    // (.map-dialog-wide) rather than at the centered default that leaves a
    // grey margin. Applying the wide layout + fullscreen canvas mode HERE,
    // before the initial hydrate, means the map renders ONCE at fill size —
    // no open-then-toggle re-hydrate, which was the visible "contortion."
    // (The flex-column figure rule keeps the legend from clipping at this
    // size.) This lands on the exact same end-state the "Full screen"
    // button produces; the button still toggles back to centered if wanted.
    if (document.body.classList.contains("embed-body-expanded")) {
      dialog.classList.add("map-dialog-wide");
      expandedCanvas.setAttribute("data-mode", "fullscreen");
      const fsBtn = dialog.querySelector(".map-dialog-fullscreen");
      if (fsBtn) fsBtn.textContent = "⤡ Exit full screen";
    }
    // Open BEFORE hydrating so the dialog's contentBoxes are
    // measurable and Plot can size correctly.
    if (typeof (dialog as HTMLDialogElement).showModal === "function") {
      dialog.showModal();
    } else {
      // Very old browsers without <dialog>. The polyfill case is
      // mostly safari-iOS-pre-15. Fall back to a plain open.
      (dialog as unknown as { open: boolean }).open = true;
    }
    hydrateOne(expandedCanvas);
  }

  function init() {
    hydrateInitial();
    // Delegate clicks on map tiles to the document, so we don't
    // race the per-tile DOM-ready handler and don't miss tiles
    // hydrated late (e.g. by routing or re-mounts).
    document.addEventListener("click", (e) => {
      const tile = (e.target as HTMLElement | null)?.closest<HTMLElement>(
        "[data-map='1']",
      );
      if (!tile) return;
      // Ignore clicks that originated inside an already-open dialog
      // (re-clicks on the expanded canvas shouldn't re-trigger
      // the open).
      if ((e.target as HTMLElement | null)?.closest(".map-dialog")) return;
      openExpanded(tile);
    });
    // Keyboard activation: the tile is role="button" tabindex="0", so it
    // takes focus in the tab order. Enter/Space must open the dialog too
    // (line/bar tiles get this free by being real <button>s). Only act
    // when the tile ITSELF is focused, so a key aimed at a control inside
    // it isn't hijacked; preventDefault stops Space from scrolling.
    document.addEventListener("keydown", (e) => {
      if (e.key !== "Enter" && e.key !== " " && e.key !== "Spacebar") return;
      const target = e.target as HTMLElement | null;
      const tile = target?.closest<HTMLElement>("[data-map='1']");
      if (!tile || target !== tile) return;
      if (target.closest(".map-dialog")) return;
      e.preventDefault();
      openExpanded(tile);
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
</script>

<style>
  .map-tile {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 12px;
    border: 1px solid rgba(55, 53, 47, 0.1);
    border-radius: var(--radius-md);
    background: var(--color-white);
    min-height: 320px;
    /* Maps need width to be useful — a 220px tile would be unreadable.
       Span two grid columns on a typical dashboard layout; the
       chart-grid template falls back gracefully on narrow viewports
       where there's only one column anyway. */
    grid-column: span 2;
  }
  /* The map tile is a focusable role=button article; the line tile's
     focus ring (Chart.astro) is component-scoped and doesn't reach here,
     so define a matching one so all tile types focus identically and a
     future global outline reset can't make this an invisible-focus bug. */
  .map-tile:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  @media (max-width: 720px) {
    .map-tile { grid-column: span 1; }
  }
  .map-tile .chart-tile-header { margin: 0; }
  .map-tile .chart-tile-title {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-neutral-900);
  }
  .map-eyebrow { margin: 2px 0 0; }
</style>

<style is:global>
  /* GLOBAL, not scoped — everything from here down styles nodes the
     script creates at runtime (the expand <dialog> via createElement/
     innerHTML, the hover tooltip, the dialog's canvas). Astro scoping
     compiles each selector to `.x[data-astro-cid-…]`, an attribute
     JS-created nodes never carry, so in a scoped block ALL of these
     rules are silently dead: the dialog rendered with UA styles only
     (pinned top-left under Tailwind's `* { margin: 0 }` preflight)
     and the Full-screen toggle flipped a class no rule matched.
     .map-canvas also lives here because it's dual-context: the tile's
     canvas is template-rendered but the dialog's is JS-created. */
  .map-canvas {
    flex: 1;
    min-height: 240px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .map-canvas { position: relative; }
  .map-canvas svg { max-width: 100%; height: auto; }
  /* Custom mousemove tooltip — bypasses the slow native SVG <title>
     hover delay. Positioned absolutely inside the canvas wrapper so
     scrolling doesn't desync it from the cursor. */
  .map-tooltip {
    position: absolute;
    padding: 4px 8px;
    background: var(--color-neutral-900);
    color: var(--color-white);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    line-height: 1.4;
    pointer-events: none;
    white-space: nowrap;
    z-index: 10;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.18);
  }

  /* ---- Click-to-expand dialog (native <dialog>) ---- */
  /* Browsers center <dialog> automatically when opened via
     showModal(); they also paint a default ::backdrop.
     overflow-y: auto + overscroll-behavior: contain together
     give us scrollability for tall dialogs without letting the
     dialog steal wheel events when the cursor is over the map —
     d3-zoom relies on the wheel reaching the SVG to trigger
     scroll-to-zoom. overscroll-behavior: contain stops the
     scroll chain at the dialog boundary in either direction. */
  .map-dialog {
    /* See chart-dialog comment: Tailwind v4 preflight zeros margin
       on every element, defeating <dialog>'s UA-default margin:auto
       centering. Restore it. */
    margin: auto;
    border: none;
    padding: 0;
    background: var(--color-white);
    border-radius: var(--radius-md);
    max-width: min(1100px, 96vw);
    max-height: 92vh;
    width: min(1100px, 96vw);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.2);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .map-dialog::backdrop {
    background: rgba(0, 0, 0, 0.45);
  }
  .map-dialog:fullscreen,
  .map-dialog.map-dialog-wide {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    border-radius: 0;
    margin: 0;
    /* Force the dialog to fill the viewport when CSS-toggled wide,
       overriding the centered positioning the browser uses for
       showModal() by default. */
    top: 0;
    left: 0;
    /* Flex column so the canvas-wrap can grow to fill whatever
       height the header / year slider / footer don't claim. The
       canvas inside reads window.innerHeight at paint time so the
       SVG actually sizes to the available space instead of staying
       at expanded-mode dimensions. */
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .map-dialog.map-dialog-wide .map-dialog-canvas-wrap {
    flex: 1 1 auto;
    min-height: 0;
    overflow: hidden;
  }
  .map-dialog-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 20px 8px;
  }
  .map-dialog-titles { flex: 1; min-width: 0; }
  .map-dialog-title {
    margin: 0;
    font-size: var(--text-base);
    font-weight: 600;
  }
  .map-dialog-eyebrow {
    margin: 4px 0 0;
  }
  .map-dialog-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }
  .map-dialog-fullscreen {
    font-size: var(--text-xs);
    background: transparent;
    border: 1px solid rgba(55, 53, 47, 0.12);
    border-radius: var(--radius-sm);
    padding: 4px 10px;
    cursor: pointer;
    color: var(--color-neutral-700);
  }
  .map-dialog-fullscreen:hover { background: var(--color-neutral-100); }
  /* Reset-zoom button: same visual weight as fullscreen so the
     dialog action row reads as a row of utility controls. Hidden
     via [hidden] attr on state-level maps where there's no zoom
     to reset. */
  .map-dialog-zoom-reset {
    font-size: var(--text-xs);
    background: transparent;
    border: 1px solid rgba(55, 53, 47, 0.12);
    border-radius: var(--radius-sm);
    padding: 4px 10px;
    cursor: pointer;
    color: var(--color-neutral-700);
  }
  .map-dialog-zoom-reset:hover { background: var(--color-neutral-100); }
  .map-dialog-zoom-reset[hidden] { display: none; }
  /* Manual +/- buttons — same visual treatment as the reset, narrower
     to keep the action row compact. Tabular-numeric padding so the
     glyphs sit centered in their boxes. */
  .map-dialog-zoom-in,
  .map-dialog-zoom-out {
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1;
    background: transparent;
    border: 1px solid rgba(55, 53, 47, 0.12);
    border-radius: var(--radius-sm);
    padding: 4px 10px;
    cursor: pointer;
    color: var(--color-neutral-700);
    min-width: 28px;
  }
  .map-dialog-zoom-in:hover,
  .map-dialog-zoom-out:hover { background: var(--color-neutral-100); }
  .map-dialog-zoom-in[hidden],
  .map-dialog-zoom-out[hidden] { display: none; }
  /* Color-scheme picker in the dialog actions row. Tightly styled so
     it doesn't dominate the dialog header — it's a refinement, not a
     primary action. */
  .map-dialog-scheme,
  .map-dialog-cartogram {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-xs);
  }
  .map-dialog-cartogram[hidden] { display: none; }
  .map-dialog-scheme-select,
  .map-dialog-cartogram-select {
    font-size: var(--text-xs);
    background: var(--color-white);
    border: 1px solid rgba(55, 53, 47, 0.12);
    border-radius: var(--radius-sm);
    padding: 3px 8px;
    color: var(--color-neutral-800);
    cursor: pointer;
  }
  /* Year-slider row. Spans below the header so the slider has room
     to breathe. Hidden when only one vintage is available — single-
     year charts shouldn't show a slider that can't move. */
  .map-dialog-year {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 20px 4px;
    font-size: var(--text-xs);
    color: var(--color-neutral-700);
  }
  .map-dialog-year[hidden] { display: none; }
  .map-dialog-year-slider {
    flex: 1;
    min-width: 200px;
    max-width: 460px;
    accent-color: var(--color-accent);
  }
  .map-dialog-year-readout {
    font-variant-numeric: tabular-nums;
    min-width: 4ch;
    color: var(--color-neutral-900);
    font-weight: 600;
  }
  /* "Why no rainbow?" disclosure. Collapsed by default; expands
     inline above the map. Reads as a sidebar note, not a primary
     element of the dialog. */
  .map-dialog-why {
    margin: 0 20px 8px;
    color: var(--color-neutral-700);
  }
  .map-dialog-why summary {
    cursor: pointer;
    font-size: var(--text-xs);
    color: var(--color-neutral-500);
    user-select: none;
  }
  .map-dialog-why summary:hover { color: var(--color-neutral-800); }
  .map-dialog-why p {
    margin: 8px 0 0;
    font-size: var(--text-sm);
    line-height: 1.55;
    max-width: 64ch;
  }
  .map-dialog-why a { color: var(--color-accent); }
  .map-dialog-close {
    font-size: 22px;
    line-height: 1;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 4px 8px;
    color: var(--color-neutral-500);
  }
  .map-dialog-close:hover { color: var(--color-neutral-900); }
  .map-dialog-canvas-wrap {
    padding: 0 12px 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    /* Block wheel-as-scroll at the wrapper boundary so the SVG inside
       owns all wheel events — d3-zoom captures them via preventDefault
       on the SVG. Without this, wheel events near the edge of the
       wrap bubble up to the scrollable dialog and the user scrolls
       the dialog instead of zooming the map. */
    overscroll-behavior: contain;
  }
  .map-canvas-expanded {
    width: 100%;
    /* touch-action: none routes trackpad pinch + two-finger pans to
       d3-zoom instead of the browser's native page-zoom / scroll. */
    touch-action: none;
    overscroll-behavior: contain;
  }
  .map-canvas-expanded svg { max-width: 100%; height: auto; }
  /* In fullscreen, fit the SVG inside the flex-grown canvas wrap
     (height-bounded by the wrap, not by intrinsic aspect-ratio scaling
     from width). The default rule above sets max-width:100% +
     height:auto, which scales the SVG by width only — at a 1900-wide
     wrap on a 1080-tall viewport the resulting height (~1200px after
     aspect-ratio scaling) blew past the dialog's 100vh and surfaced a
     vertical scrollbar even though .map-dialog-wide has
     overflow:hidden. Explicit max-height + width/height: 100% lets the
     SVG's built-in viewBox + preserveAspectRatio="xMidYMid meet" do
     the right thing: scale to fit within the wrap, leaving whitespace
     on whichever axis runs short. */
  .map-dialog.map-dialog-wide .map-dialog-canvas-wrap {
    overflow: hidden;
  }
  .map-dialog.map-dialog-wide .map-canvas-expanded {
    width: 100%;
    height: 100%;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  /* Plot wraps the legend + map in a <figure> (figure.append(
     ...legends, svg)). Left as a plain block, that figure's height is
     just its content (legend + a height:100% map that resolves against
     an indefinite parent → intrinsic), so the figure grows TALLER than
     the centered canvas and its top — the legend — clips out of view.
     Make the figure an explicit flex column with a DEFINITE height
     (100% of the canvas): the legend takes its natural height at the
     top and the map flex-fills the rest, so neither clips. */
  .map-dialog.map-dialog-wide .map-canvas-expanded > figure {
    margin: 0;
    width: 100%;
    height: 100%;
    min-height: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
  }
  .map-dialog.map-dialog-wide .map-canvas-expanded svg.map-geo-svg {
    /* flex:1 + min-height:0 lets the map yield vertical space to the
       legend instead of forcing the old overflow; preserveAspectRatio
       "xMidYMid meet" then fits the drawing inside whatever box the
       flex row leaves it. */
    flex: 1 1 auto;
    min-height: 0;
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
  }
  /* The Plot color-legend svg (no geo paths) sits above the map. Its
     intrinsic ~240px width renders tiny in a fullscreen dialog; clamp it
     to a readable band (never the full-width giant the old svg{width:100%}
     rule produced). flex:0 0 auto keeps it at its own height at the top. */
  .map-dialog.map-dialog-wide .map-canvas-expanded svg:not(.map-geo-svg) {
    flex: 0 0 auto;
    width: clamp(280px, 38%, 500px);
    height: auto;
    max-width: 90%;
  }
  .map-dialog-footer {
    padding: 8px 20px 16px;
    border-top: 1px solid rgba(55, 53, 47, 0.06);
  }
  .map-dialog-footer p { margin: 0; }
  .map-dialog-zoom-hint { margin-top: 4px !important; opacity: 0.7; }
  .map-dialog-zoom-hint[hidden] { display: none; }
</style>
