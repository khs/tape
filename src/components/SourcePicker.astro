---
/**
 * SourcePicker — the canonical source-selection component for Tape.
 *
 * Per ~/.claude/projects/.../memory/feedback_source_selection.md, every
 * source-picker surface in the app MUST use this component (composer's
 * Sources tab, cc-modal chart-creator, alerts page, future surfaces).
 * Do NOT build a parallel `<input>` + autocomplete pattern; the rule
 * exists precisely to prevent that.
 *
 * What it ships:
 *   - Search input (text matching against id + name + shortName + tags)
 *   - Topical tag chips (rates, equity-index, large-stocks, macro, …)
 *   - Source cards with name + short description + meta
 *   - Hint cards (synthetic discoverability bridges from
 *     src/lib/source-hints.ts) that engage relevant filter chips
 *
 * Coming in Phase 1b (next commit):
 *   - Geo-chip popovers (metro / state+CD / country drill-downs)
 *
 * Coming in Phases 2-4:
 *   - Mounted in compose.astro (Sources tab + cc-modal), alerts.astro
 *
 * # API
 *
 * Multiple instances on one page coexist via `instanceId`. State is
 * scoped per-instance — selecting a tag chip in one mount doesn't
 * affect the other.
 *
 * The component fetches /library.json on first mount and caches it
 * on `window.__tapeSourcePickerLib` so 2nd+ mounts on the same page
 * hit memory.
 *
 * Click events bubble up as a CustomEvent named `source-picker:pick`
 * with `detail: { sourceId, source }`. Hosts listen via:
 *
 *   const root = document.querySelector("[data-spicker-instance='X']");
 *   root.addEventListener("source-picker:pick", (e) => {
 *     const { sourceId, source } = (e as CustomEvent).detail;
 *     ...
 *   });
 *
 * Hint-card clicks fire `source-picker:hint` instead — the host
 * usually doesn't need to handle these (the component engages the
 * appropriate filter chip itself) but they're exposed for analytics.
 */
interface Props {
  /** Unique identifier on the page. Required when mounting multiple
   *  instances; safe to set even on single-mount pages for
   *  forward compatibility. */
  instanceId: string;
  /** Optional placeholder for the search input. */
  searchPlaceholder?: string;
  /** Optional CSS classes to add to the root container. */
  rootClass?: string;
  /** Hide the search input. Rare — use for tight modal layouts where
   *  the host already provides a search surface. */
  hideSearch?: boolean;
  /** Sources to render at the TOP of the results list, before
   *  library sources. Cc-modal uses this for user-defined derived
   *  sources. The host can also update this client-side by
   *  dispatching a `source-picker:set-extra-sources` event with
   *  detail: { sources: LibrarySource[] } on the picker root. */
  extraSources?: ReadonlyArray<{
    id: string;
    name: string;
    shortName?: string;
    description?: string;
    tags?: string[];
  }>;
  /** Source IDs to render DISABLED (greyed, non-clickable) -- e.g. the
   *  ds-modal disables the source picked on the other A/B side. Update
   *  client-side via a `source-picker:set-disabled-ids` event with
   *  detail: { ids: string[] } on the picker root. */
  disabledIds?: ReadonlyArray<string>;
  /** Rich cards: geo badges (CD/state) + tags line + shortName. For the
   *  Sources-tab browser, where ~435 same-named district cards must be
   *  distinguishable. Default off -> the simple modal-picker card. */
  richCards?: boolean;
}
const {
  instanceId,
  searchPlaceholder = "Search sources by name, ticker, or tag…",
  rootClass = "",
  hideSearch = false,
  extraSources = [],
  disabledIds = [],
  richCards = false,
} = Astro.props;
// Serialize extraSources into a JSON-encoded data attribute so the
// client-side script can read them at boot. Updates after first
// render flow via the `source-picker:set-extra-sources` event.
const extraSourcesJson = extraSources.length > 0
  ? JSON.stringify(extraSources)
  : "";
---

<div
  class={`source-picker ${rootClass}`}
  data-spicker-instance={instanceId}
  data-spicker-extra-sources={extraSourcesJson}
  data-spicker-disabled-ids={disabledIds.length > 0 ? JSON.stringify(disabledIds) : ""}
  data-spicker-rich={richCards ? "1" : ""}
>
  {!hideSearch && (
    <input
      type="search"
      class="source-picker-search"
      data-spicker-role="search"
      placeholder={searchPlaceholder}
    />
  )}
  <!-- Geo-chip strip: three chips (metro / state+CD / country),
       each with a popover that contains a search input + selectable
       list. Order matches the composer (metro, CD, country). The
       CD-host gets filled dynamically because CD has a two-step
       drill-down (state → district). -->
  <div class="source-picker-geo-chips" data-spicker-role="geo-chips">
    <div class="source-picker-geo-chip-wrap">
      <button
        type="button"
        class="source-picker-geo-chip"
        data-spicker-role="metro-chip"
        aria-haspopup="listbox"
        aria-expanded="false"
      >
        <span data-spicker-role="metro-label">US metro areas &#9662;</span>
        <span
          class="source-picker-geo-chip-clear"
          data-spicker-role="metro-clear"
          hidden
          aria-label="Clear metro filter">&times;</span>
      </button>
      <div
        class="source-picker-geo-popover"
        data-spicker-role="metro-popover"
        role="listbox"
        hidden
      >
        <input
          type="search"
          class="source-picker-geo-search"
          data-spicker-role="metro-search"
          placeholder="Search metros…"
          aria-label="Search metros"
        />
        <div
          class="source-picker-geo-list"
          data-spicker-role="metro-list"
        ></div>
      </div>
    </div>
    <div
      class="source-picker-geo-cd-host"
      data-spicker-role="cd-host"
    ></div>
    <div class="source-picker-geo-chip-wrap">
      <button
        type="button"
        class="source-picker-geo-chip"
        data-spicker-role="country-chip"
        aria-haspopup="listbox"
        aria-expanded="false"
      >
        <span data-spicker-role="country-label"
          >Regions and countries &#9662;</span>
        <span
          class="source-picker-geo-chip-clear"
          data-spicker-role="country-clear"
          hidden
          aria-label="Clear country filter">&times;</span>
      </button>
      <div
        class="source-picker-geo-popover"
        data-spicker-role="country-popover"
        role="listbox"
        hidden
      >
        <input
          type="search"
          class="source-picker-geo-search"
          data-spicker-role="country-search"
          placeholder="Search regions + countries…"
          aria-label="Search regions + countries"
        />
        <div
          class="source-picker-geo-list"
          data-spicker-role="country-list"
        ></div>
      </div>
    </div>
  </div>
  <!-- Tag-chip filter strip. Populated client-side once library.json
       loads — tags are union of all sources' .tags arrays minus geo
       tags (those have their own chips above). -->
  <div class="source-picker-tags" data-spicker-role="tags"></div>
  <!-- Results list. Renders source-cards + hint-cards. Initial copy
       reads "Loading…" until the library.json fetch resolves. -->
  <div class="source-picker-results" data-spicker-role="results">
    <p class="muted small">Loading sources…</p>
  </div>
</div>

<script>
  import { METRO_TAG } from "../lib/geographic-regions";
  import { COUNTRY_TAG } from "../lib/countries";
  import {
    CD_TAG,
    STATE_TAG,
    STATEWIDE_DISTRICT_CODE,
    US_STATES,
    parseCdSourceId,
    parseStateSourceId,
    stateNameFor,
    formatCdShortLabel,
  } from "../lib/congressional-districts";
  import { COUNTY_TAG } from "../lib/county-sources";
  import {
    passesMetroFilter,
    passesCountryFilter,
    passesCdFilter,
    passesCountyFilter,
    unlockedMetrosForQuery,
    unlockedCountriesForQuery,
    unlockedStatesForQuery,
    UNLOCK_QUERY_MIN_CHARS,
  } from "../lib/source-filters";
  import { isMobileViewport } from "../lib/viewport";

  /**
   * Source-side shape returned by /library.json. Mirrors the inline
   * type compose.astro defines — kept in sync intentionally; if the
   * library payload changes, both places update.
   */
  interface LibrarySource {
    id?: string;
    name: string;
    shortName?: string;
    description?: string;
    kind?: string;
    tags?: string[];
    searchText?: string;
    chip?: string;
    order?: number;
  }
  interface LibraryPayload {
    sources?: Record<string, LibrarySource>;
    metros?: Record<string, { shortName: string; name: string }>;
    countries?: Record<string, { name: string }>;
    metroTag?: string;
    countryTag?: string;
    /** Build-time precomputed topical-tag counts per geo-filter
     *  state. Keys: "__all" | "metro:<cbsa>" | "country:<code>" |
     *  "cd:<state>:any" | "cd:<state>:state" | "cd:<state>:<dst>".
     *  Multi-geo combinations are not precomputed; the picker falls
     *  back to "__all" when more than one geo chip is active. Built
     *  in src/pages/library.json.ts. */
    tagCountsByGeo?: Record<string, Record<string, number>>;
  }

  /** Per-instance state. Each SourcePicker mount keeps its own
   *  filter/search state so multiple instances on the same page don't
   *  cross-contaminate (the cc-modal can filter to metros without
   *  affecting the main Sources tab). */
  interface InstanceState {
    root: HTMLElement;
    instanceId: string;
    searchQuery: string;
    selectedTags: Set<string>;
    /** Selected CBSA code for the metro chip, or null = chip inactive. */
    selectedMetroCbsa: string | null;
    /** Selected country/region code, or null = chip inactive. */
    selectedCountryCode: string | null;
    /** CD chip's state-FIPS pick. null = chip inactive. */
    cdState: string | null;
    /** CD chip's district code OR STATEWIDE_DISTRICT_CODE. null = "any
     *  district within the picked state". */
    cdDistrict: string | null;
    /** Whether the user has interacted with this instance yet — gates
     *  certain UI states (e.g. hint cards only show after a query). */
    hasInteracted: boolean;
    /** Source IDs the host is "tracking" (e.g. already-selected in
     *  cc-modal's source set). Rendered with a check indicator so the
     *  user knows which they've already picked. Click-to-pick on a
     *  marked card still emits source-picker:pick — the host
     *  interprets that as toggle-off. */
    markedIds: Set<string>;
    /** Source IDs rendered disabled (non-clickable) -- the ds-modal sets
     *  these to the source picked on the other A/B side. */
    disabledIds: Set<string>;
    rich: boolean;
    /** Sources passed in via the `extraSources` prop OR set
     *  client-side via the `source-picker:set-extra-sources` event.
     *  Rendered at the top of the results, above library sources. */
    extraSources: LibrarySource[];
    /** Pending setTimeout id for the mobile debounce path, or null
     *  when nothing scheduled. Cleared + replaced whenever a fresh
     *  schedule call comes in mid-debounce. Used only by
     *  scheduleRender — desktop bypasses this entirely. */
    pendingScheduleId: number | null;
  }
  const instances = new Map<string, InstanceState>();
  /** Debounce window on mobile between the last keystroke and the
   *  filter/render pass. Imperceptible during a natural typing
   *  burst, prevents per-keystroke re-walks of the source list on
   *  low-end phones. Desktop bypasses this. */
  const MOBILE_RENDER_DEBOUNCE_MS = 100;

  // Module-level library cache. The first mount fetches; later mounts
  // (cc-modal opens after main page renders) share. Stashed on window
  // so a soft hydration doesn't double-fetch.
  type WindowWithCache = Window & {
    __tapeSourcePickerLib?: Promise<LibraryPayload>;
  };
  async function loadLibrary(): Promise<LibraryPayload> {
    const w = window as WindowWithCache;
    if (w.__tapeSourcePickerLib) return w.__tapeSourcePickerLib;
    const base = (import.meta.env.BASE_URL || "/").replace(/\/$/, "");
    w.__tapeSourcePickerLib = (async () => {
      try {
        const r = await fetch(`${base}/library.json`);
        if (!r.ok) throw new Error(`library.json status=${r.status}`);
        return (await r.json()) as LibraryPayload;
      } catch (e) {
        console.warn("[source-picker] library.json load failed:", e);
        return { sources: {} };
      }
    })();
    return w.__tapeSourcePickerLib;
  }

  /**
   * Umbrella tags considered "geo" — get their own chip row,
   * excluded from the topical tag-chip strip so the user isn't
   * confused by two routes to the same filter.
   */
  const GEO_UMBRELLA_TAGS: ReadonlySet<string> = new Set([
    METRO_TAG,
    COUNTRY_TAG,
    CD_TAG,
    STATE_TAG,
    COUNTY_TAG,
  ]);

  /**
   * Is this tag a geo tag (umbrella OR per-entity)? Per-entity geo
   * tags look like `metro:10180`, `country-specific:USA`, etc. —
   * one per CBSA / country / district. Without filtering them
   * we'd render hundreds of per-entity chips that duplicate what
   * the geo-chip popovers handle.
   */
  function isGeoTag(tag: string): boolean {
    if (GEO_UMBRELLA_TAGS.has(tag)) return true;
    for (const umbrella of GEO_UMBRELLA_TAGS) {
      if (tag.startsWith(umbrella + ":")) return true;
    }
    return false;
  }

  // ---------- Geo-filter helpers ---------------------------------------
  //
  // The actual filter logic lives in src/lib/source-filters.ts — pure
  // functions, unit-tested in source-filters.test.ts. Here we just
  // import them; filteredSources() below calls them per-source.
  //
  // Perf note: each passes*Filter call internally computes the
  // unlocked* sets, which walks the metros/countries arrays. For
  // ~20k sources × 3 filter types, that's a lot of redundant work
  // per render. If profiling shows this is slow, add an optional
  // pre-computed unlocks parameter to the lib functions and have
  // filteredSources hoist the computation outside the per-source
  // loop. Today the ~5ms cost is below the perceptible threshold.
  //
  // Suppress unused-import warnings for the unlocked* helpers —
  // they're only directly used if we add the hoisting optimization.
  void unlockedStatesForQuery;
  void unlockedMetrosForQuery;
  void unlockedCountriesForQuery;

  /** Apply current filter state to the library. Returns a sorted list
   *  ready to render — extraSources first, then hint cards, then
   *  alphabetical by name. */
  function filteredSources(
    state: InstanceState,
    lib: LibraryPayload,
  ): Array<LibrarySource & { id: string; tags: string[] }> {
    const sources = lib.sources ?? {};
    const q = state.searchQuery.trim().toLowerCase();
    const tagsRequired = [...state.selectedTags].filter(
      (t) => !isGeoTag(t),
    );
    const out: Array<LibrarySource & { id: string; tags: string[] }> = [];
    // ExtraSources: pass them through the same tag-filter + search-
    // filter pipeline as library sources. Skip the geo filters (extras
    // are host-defined and typically don't have geo tags). Keep them
    // at the top of the result list by appending FIRST + sorting them
    // to the top via the .isExtra flag in the sort comparator.
    for (const src of state.extraSources) {
      const tags = src.tags ?? [];
      let ok = true;
      for (const t of tagsRequired) {
        if (!tags.includes(t)) {
          ok = false;
          break;
        }
      }
      if (!ok) continue;
      if (q) {
        const hay = (
          src.name +
          " " +
          (src.shortName ?? "") +
          " " +
          src.id +
          " " +
          tags.join(" ")
        ).toLowerCase();
        if (!hay.includes(q)) continue;
      }
      // Tag as an extra so the sort comparator can lift it above
      // library sources, and the renderer can style it differently
      // if it wants.
      (src as LibrarySource & { kind?: string }).kind ??= "extra";
      out.push({ ...src, id: src.id!, tags });
    }
    for (const id of Object.keys(sources)) {
      const src = sources[id];
      const tags = src.tags ?? [];
      let ok = true;
      for (const t of tagsRequired) {
        if (!tags.includes(t)) {
          ok = false;
          break;
        }
      }
      if (!ok) continue;
      // The lib's passes*Filter helpers are pure (no per-instance
      // state); we feed them the per-instance state's relevant fields
      // explicitly. The unlocked* sets they compute internally are
      // cheap on small libraries but for the ~20k-source library
      // would recompute every iteration if not memoized. Pre-compute
      // here once per render and intercept the calls via the
      // memoStateUnlocks etc. wrappers — TODO: when passes*Filter
      // accepts an optional pre-computed unlock arg, switch to that.
      if (!passesCdFilter(id, tags, state.cdState, state.cdDistrict, q))
        continue;
      if (
        !passesMetroFilter(tags, state.selectedMetroCbsa, q, lib)
      )
        continue;
      if (
        !passesCountryFilter(tags, state.selectedCountryCode, q, lib)
      )
        continue;
      if (!passesCountyFilter(id, tags, q)) continue;
      // Hint cards: only show with a query. An unprompted library
      // browse should be a clean list of real sources.
      if (src.kind === "hint" && !q) continue;
      if (q) {
        const hay = (
          src.searchText ??
          src.name +
            " " +
            (src.shortName ?? "") +
            " " +
            id +
            " " +
            tags.join(" ")
        ).toLowerCase();
        if (!hay.includes(q)) continue;
      }
      out.push({ ...src, id, tags });
    }
    out.sort((a, b) => {
      // Sort precedence: extras → hints → alphabetical.
      const aIsExtra = a.kind === "extra";
      const bIsExtra = b.kind === "extra";
      if (aIsExtra && !bIsExtra) return -1;
      if (bIsExtra && !aIsExtra) return 1;
      const aIsHint = a.kind === "hint";
      const bIsHint = b.kind === "hint";
      if (aIsHint && !bIsHint) return -1;
      if (bIsHint && !aIsHint) return 1;
      if (aIsHint && bIsHint) {
        return (a.order ?? 0) - (b.order ?? 0);
      }
      return a.name.localeCompare(b.name);
    });
    return out;
  }

  /** Map current geo-chip state to the bucket key in
   *  lib.tagCountsByGeo. Returns "__all" when no chip is active, OR
   *  when MULTIPLE chips are active (the precompute doesn't carry
   *  pairwise intersections to avoid combinatorial bucket explosion;
   *  the "All" fallback is a deliberate simplification — multi-chip
   *  selection is rare and the counts mostly serve as relative
   *  hints, not exact totals). */
  function geoFilterKey(state: InstanceState): string {
    const chipsActive =
      (state.selectedMetroCbsa ? 1 : 0) +
      (state.selectedCountryCode ? 1 : 0) +
      (state.cdState ? 1 : 0);
    if (chipsActive !== 1) return "__all";
    if (state.selectedMetroCbsa) return `metro:${state.selectedMetroCbsa}`;
    if (state.selectedCountryCode) return `country:${state.selectedCountryCode}`;
    if (state.cdState) {
      if (state.cdDistrict === null) return `cd:${state.cdState}:any`;
      if (state.cdDistrict === STATEWIDE_DISTRICT_CODE)
        return `cd:${state.cdState}:state`;
      return `cd:${state.cdState}:${state.cdDistrict}`;
    }
    return "__all";
  }

  /** Topical tag counts for the strip.
   *
   *  Three paths, picked by query length:
   *   1. Below the 4-char unlock threshold AND a single geo chip
   *      (or no chip) is engaged → use the precomputed
   *      `lib.tagCountsByGeo` bucket. O(1) — the common case.
   *   2. At 4+ chars (unlock pattern fires) → walk
   *      `filteredSources` and tally topical tags on the matching
   *      set. This is the only way counts can reflect query-driven
   *      geo unlocks (typing "virginia" surfaces VA sources via
   *      the state-name unlock; the bucket has no key for that).
   *      ~7–18 ms on a desktop V8 against the ~21 k-source
   *      library. Mobile gets the debounced scheduler (see
   *      scheduleRender) to absorb that cost without per-keystroke
   *      jank.
   *   3. Precomputed table missing (older deploy) → fall back to
   *      the pre-precompute behavior (global walk, not filter-
   *      aware). Should never run in practice.
   *
   *  Currently selected topical tags that aren't in the result set
   *  still render with count 0 so the user can see what's active
   *  and unselect it. */
  function topicalTagCounts(
    state: InstanceState,
    lib: LibraryPayload,
  ): Array<{ tag: string; count: number }> {
    const trimmedQuery = state.searchQuery.trim();
    // Path 2: query is in unlock range (or longer) — walk to get
    // counts that match what the user sees in the results list.
    if (trimmedQuery.length >= UNLOCK_QUERY_MIN_CHARS) {
      const counts = new Map<string, number>();
      // Re-uses filteredSources so the chip counts are guaranteed
      // to match the rendered card list. Extras + hints are
      // excluded from topical counts (extras are host-provided,
      // hints are discoverability bridges — neither is a "real"
      // pickable source for tag-count purposes).
      const matches = filteredSources(state, lib);
      for (const m of matches) {
        if (m.kind === "hint") continue;
        if (m.kind === "extra") continue;
        for (const t of m.tags) {
          if (isGeoTag(t)) continue;
          counts.set(t, (counts.get(t) ?? 0) + 1);
        }
      }
      for (const t of state.selectedTags) {
        if (!isGeoTag(t) && !counts.has(t)) counts.set(t, 0);
      }
      return Array.from(counts.entries())
        .map(([tag, count]) => ({ tag, count }))
        .sort((a, b) => a.tag.localeCompare(b.tag));
    }
    // Path 1: cheap bucket lookup.
    const key = geoFilterKey(state);
    const bucket = lib.tagCountsByGeo?.[key];
    if (bucket) {
      const counts = new Map<string, number>(Object.entries(bucket));
      for (const t of state.selectedTags) {
        if (!isGeoTag(t) && !counts.has(t)) counts.set(t, 0);
      }
      return Array.from(counts.entries())
        .map(([tag, count]) => ({ tag, count }))
        .sort((a, b) => a.tag.localeCompare(b.tag));
    }
    // Path 3: legacy fallback — no precomputed table.
    const counts = new Map<string, number>();
    for (const id of Object.keys(lib.sources ?? {})) {
      const src = lib.sources![id];
      if (src.kind === "hint") continue;
      for (const t of src.tags ?? []) {
        if (isGeoTag(t)) continue;
        counts.set(t, (counts.get(t) ?? 0) + 1);
      }
    }
    for (const t of state.selectedTags) {
      if (!isGeoTag(t) && !counts.has(t)) counts.set(t, 0);
    }
    return Array.from(counts.entries())
      .map(([tag, count]) => ({ tag, count }))
      .sort((a, b) => a.tag.localeCompare(b.tag));
  }

  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function renderTagChips(state: InstanceState, lib: LibraryPayload): void {
    const host = state.root.querySelector<HTMLElement>(
      "[data-spicker-role='tags']",
    );
    if (!host) return;
    const tagCounts = topicalTagCounts(state, lib);
    const totalCount = tagCounts.reduce((s, t) => s + t.count, 0);
    const parts: string[] = [];
    // "All" chip always first — clears the tag filter. The count
    // is the sum of all topical counts (not the actual library
    // size, since geo-only sources aren't represented).
    const allActive = state.selectedTags.size === 0;
    parts.push(
      `<button type="button" class="source-picker-chip${allActive ? " source-picker-chip-active" : ""}" data-spicker-tag="">All <span class="source-picker-chip-count">${totalCount}</span></button>`,
    );
    for (const { tag, count } of tagCounts) {
      const active = state.selectedTags.has(tag);
      parts.push(
        `<button type="button" class="source-picker-chip${active ? " source-picker-chip-active" : ""}" data-spicker-tag="${escapeHtml(tag)}">${escapeHtml(tag)} <span class="source-picker-chip-count">${count}</span></button>`,
      );
    }
    host.innerHTML = parts.join("");
    // Per-chip click handlers (NOT delegated — same reasoning as
    // /me/'s saved-dashboard renderer: re-rendering the strip would
    // accumulate listeners on the parent otherwise).
    host
      .querySelectorAll<HTMLButtonElement>("[data-spicker-tag]")
      .forEach((btn) => {
        btn.addEventListener("click", () => {
          const tag = btn.dataset.spickerTag ?? "";
          if (tag === "") {
            // "All" chip — clear selection.
            state.selectedTags.clear();
          } else {
            // Tag chip — toggle membership.
            if (state.selectedTags.has(tag)) state.selectedTags.delete(tag);
            else state.selectedTags.add(tag);
          }
          renderTagChips(state, lib);
          renderResults(state, lib);
        });
      });
  }

  /** Geo state changed (chip picked/cleared, CD district changed,
   *  hint card activated a chip). Re-render BOTH the tag chips
   *  (counts depend on the active geo bucket) AND the results.
   *  Centralized so every geo-state mutation funnels through one
   *  helper rather than each site remembering to update both.
   *
   *  Chip-state changes are RARE compared to keystrokes (the user
   *  clicks a chip ~once per session), so this stays synchronous
   *  on both desktop and mobile — debouncing here would feel laggy
   *  for no perf gain. The mobile-aware debounce is scoped to
   *  search-input changes via scheduleRender. */
  function applyGeoFilterChange(
    state: InstanceState,
    lib: LibraryPayload,
  ): void {
    renderTagChips(state, lib);
    renderResults(state, lib);
  }

  /** Mobile-aware render scheduler for search-input keystrokes.
   *
   *  Desktop: run synchronously. Each keystroke fires a fresh
   *  filteredSources walk + tag-count tally. On a fast desktop
   *  V8 this is ~7–18 ms per keystroke against the production
   *  21 k-source library — well below the 16.67 ms frame budget
   *  for the average case, with the occasional one-frame stutter
   *  on heavy unlocks (e.g. typing "virg" unlocks ~50 VA sources).
   *
   *  Mobile: 100 ms debounce. Each fresh keystroke cancels the
   *  pending render and queues a new one. Mobile V8 is ~3–5×
   *  slower, so a per-keystroke walk would land at ~25–50 ms +
   *  GC pressure — definitely jank during a typing burst. The
   *  100 ms window is short enough to feel responsive after the
   *  user stops typing (humans typically pause >150 ms between
   *  words) and long enough to absorb a single word's keystrokes
   *  into one render.
   *
   *  Differentiator: 640 px CSS breakpoint via isMobileViewport.
   *  Same one Chart.astro, ChartController, index.astro, etc.
   *  use for layout — keeps behavioral + visual breakpoints in
   *  lockstep. See src/lib/viewport.ts for the constant. */
  function scheduleRender(
    state: InstanceState,
    lib: LibraryPayload,
  ): void {
    // Cancel any in-flight debounce — the newest call carries the
    // latest state, which is the only one we want to render.
    if (state.pendingScheduleId !== null) {
      window.clearTimeout(state.pendingScheduleId);
      state.pendingScheduleId = null;
    }
    if (!isMobileViewport()) {
      // Desktop: synchronous, no debounce.
      renderTagChips(state, lib);
      renderResults(state, lib);
      return;
    }
    // Mobile: queue a single delayed render.
    state.pendingScheduleId = window.setTimeout(() => {
      state.pendingScheduleId = null;
      renderTagChips(state, lib);
      renderResults(state, lib);
    }, MOBILE_RENDER_DEBOUNCE_MS);
  }

  // Rich card extras (geo badges + tags + shortName) for the Sources-tab
  // browser. CD/state sources get a "TX-12" / "TX statewide" badge -- without
  // it the ~435 same-named district cards would be visually identical.
  function richCardExtras(
    s: { id: string; name: string; shortName?: string; tags?: string[] },
  ): { badges: string; tags: string } {
    const cd = parseCdSourceId(s.id);
    const st = parseStateSourceId(s.id);
    let badges = "";
    if (cd) {
      badges = `<span class="source-picker-card-short source-picker-card-cd-badge">${escapeHtml(formatCdShortLabel(cd.state, cd.district))}</span>`;
    } else if (st) {
      badges = `<span class="source-picker-card-short source-picker-card-cd-badge">${escapeHtml(st.state.toUpperCase() + " statewide")}</span>`;
    } else if (s.shortName && s.shortName !== s.name) {
      badges = `<span class="source-picker-card-short">${escapeHtml(s.shortName)}</span>`;
    }
    const tagList = s.tags ?? [];
    const tags =
      tagList.length > 0
        ? `<div class="source-picker-card-tags">${tagList.map(escapeHtml).join(" · ")}</div>`
        : "";
    return { badges, tags };
  }

  function renderResults(state: InstanceState, lib: LibraryPayload): void {
    const host = state.root.querySelector<HTMLElement>(
      "[data-spicker-role='results']",
    );
    if (!host) return;
    const matches = filteredSources(state, lib);
    if (matches.length === 0) {
      const q = state.searchQuery.trim();
      const hasFilters =
        q.length > 0 ||
        state.selectedTags.size > 0 ||
        !!state.selectedMetroCbsa ||
        !!state.selectedCountryCode ||
        !!state.cdState;
      // Recovery ladder, not a dead end: name what was searched, offer a
      // one-click reset (a zero-result on a ~35k-source library is almost
      // always a typo or an over-narrow filter), THEN the request mailto.
      host.innerHTML =
        `<div class="source-picker-empty">` +
        `<p class="muted small">No sources match${q ? ` “${escapeHtml(q)}”` : ""}.</p>` +
        (hasFilters
          ? `<button type="button" class="source-picker-clear-btn" data-spicker-role="clear-filters">Clear search &amp; filters</button>`
          : "") +
        `<p class="muted small">Still missing something? <a href="mailto:keller.scholl@gmail.com">Request a source</a>.</p>` +
        `</div>`;
      const clearBtn = host.querySelector<HTMLButtonElement>(
        "[data-spicker-role='clear-filters']",
      );
      clearBtn?.addEventListener("click", () => {
        state.searchQuery = "";
        state.selectedTags.clear();
        state.selectedMetroCbsa = null;
        state.selectedCountryCode = null;
        state.cdState = null;
        state.cdDistrict = null;
        const searchInput = state.root.querySelector<HTMLInputElement>(
          "[data-spicker-role='search']",
        );
        if (searchInput) searchInput.value = "";
        updateChipLabel(state, "metro", "US metro areas", false);
        updateChipLabel(state, "country", "Regions and countries", false);
        renderCdChip(state, lib);
        renderTagChips(state, lib);
        renderResults(state, lib);
      });
      return;
    }
    const parts: string[] = [];
    for (const s of matches) {
      if (s.kind === "hint") {
        // Hint card — different style + engages a filter chip on
        // click rather than picking a source.
        const chip = s.chip ?? "";
        const desc = s.description
          ? `<div class="source-picker-card-desc">${escapeHtml(s.description)}</div>`
          : "";
        parts.push(
          `<button type="button" class="source-picker-card source-picker-card-hint" data-spicker-source-id="${escapeHtml(s.id)}" data-spicker-hint-chip="${escapeHtml(chip)}">` +
            `<div class="source-picker-card-title"><span class="source-picker-card-hint-eyebrow">See also</span>${escapeHtml(s.name)}</div>` +
            desc +
            `</button>`,
        );
      } else {
        // Real source card (or extra).
        const desc = s.description
          ? `<div class="source-picker-card-desc">${escapeHtml(s.description)}</div>`
          : "";
        const id = `<div class="source-picker-card-id muted small">${escapeHtml(s.id)}</div>`;
        if (state.disabledIds.has(s.id)) {
          // Disabled card (e.g. picked on the other A/B side in the ds-modal):
          // no data-spicker-source-id, so no pick handler binds.
          parts.push(
            `<div class="source-picker-card source-picker-card-disabled" aria-disabled="true">` +
              `<div class="source-picker-card-title">${escapeHtml(s.name)} <span class="source-picker-card-disabled-note">already picked</span></div>` +
              desc +
              id +
              `</div>`,
          );
          continue;
        }
        const marked = state.markedIds.has(s.id);
        const extraCls = s.kind === "extra" ? " source-picker-card-extra" : "";
        const markedCls = marked ? " source-picker-card-marked" : "";
        // The "✓" badge is right-aligned in the card header so the
        // user can scan-mark which sources they've already picked
        // without color-coding being the only signal.
        const markBadge = marked
          ? `<span class="source-picker-card-mark" aria-label="Already selected">✓</span>`
          : "";
        const richEx = state.rich
          ? richCardExtras(s)
          : { badges: "", tags: "" };
        parts.push(
          `<button type="button" class="source-picker-card${extraCls}${markedCls}" data-spicker-source-id="${escapeHtml(s.id)}"${marked ? ' data-spicker-marked="1"' : ""}>` +
            `<div class="source-picker-card-title">${escapeHtml(s.name)}${richEx.badges}${markBadge}</div>` +
            desc +
            richEx.tags +
            id +
            `</button>`,
        );
      }
    }
    host.innerHTML = parts.join("");
    // Per-button click handlers.
    host
      .querySelectorAll<HTMLButtonElement>("[data-spicker-source-id]")
      .forEach((btn) => {
        btn.addEventListener("click", () => {
          const sourceId = btn.dataset.spickerSourceId ?? "";
          if (!sourceId) return;
          const hintChip = btn.dataset.spickerHintChip;
          if (hintChip != null) {
            // Hint-card click: engage the relevant filter chip + also
            // dispatch a `source-picker:hint` event so hosts can hook
            // analytics (or handle host-level chips like "maps-tab").
            // The chip-engagement logic mirrors compose.astro's old
            // hint-card behavior — the hint's `chip` field tells us
            // which chip to activate. Formats:
            //   BARE (what src/lib/source-hints.ts emits today):
            //   "metro" | "country" | "cd" → open that chip's popover
            //                                so the user picks an entity
            //   "county"                   → no-op (the hint copy says
            //                                to type the county name)
            //   "maps-tab"                 → host-level (the composer
            //                                switches to its Maps tab)
            //   PREFIXED (entity-specific, for hosts that synthesize
            //   their own hint sources):
            //   "metro:10180"           → metro chip, CBSA Abilene
            //   "country:AUS"           → country chip, Australia
            //   "cd:VA:8"               → CD chip, VA-08
            //   "cd:VA:__state__"       → CD chip, VA statewide
            //   "cd:VA"                 → CD chip, VA (any district)
            state.root.dispatchEvent(
              new CustomEvent("source-picker:hint", {
                detail: { sourceId, chip: hintChip },
                bubbles: true,
              }),
            );
            if (
              hintChip === "metro" ||
              hintChip === "country" ||
              hintChip === "cd"
            ) {
              // Bare level chip: clear the search (so the post-pick
              // list isn't still narrowed by the hint's query — same
              // behavior as the composer's old engageHintChip), then
              // open the chip's popover. The open is DEFERRED a tick:
              // this click is still bubbling, and the document-level
              // outside-click closer would otherwise immediately close
              // the popover we just opened (the hint card isn't inside
              // a chip/popover, so the closer's guard doesn't exempt
              // it). For "cd" with a state already picked there is no
              // cd-chip button (the active chip renders a district
              // dropdown instead) — the deferred click no-ops, which
              // is right: that state's sources are already surfaced.
              state.searchQuery = "";
              const searchEl = state.root.querySelector<HTMLInputElement>(
                "[data-spicker-role='search']",
              );
              if (searchEl) searchEl.value = "";
              renderTagChips(state, lib);
              renderResults(state, lib);
              window.setTimeout(() => {
                state.root
                  .querySelector<HTMLButtonElement>(
                    `[data-spicker-role='${hintChip}-chip']`,
                  )
                  ?.click();
              }, 0);
              return;
            }
            if (hintChip === "county" || hintChip === "maps-tab") {
              // county: leave the typed search intact — the hint copy
              // instructs the user to type the county name. maps-tab:
              // nothing to engage in the picker; the host handles it
              // via the source-picker:hint event dispatched above.
              return;
            }
            if (hintChip.startsWith("metro:")) {
              const code = hintChip.slice("metro:".length);
              state.selectedMetroCbsa = code;
              updateChipLabel(
                state,
                "metro",
                lib.metros?.[code]?.shortName ?? code,
                true,
              );
            } else if (hintChip.startsWith("country:")) {
              const code = hintChip.slice("country:".length);
              state.selectedCountryCode = code;
              updateChipLabel(
                state,
                "country",
                lib.countries?.[code]?.name ?? code,
                true,
              );
            } else if (hintChip.startsWith("cd:")) {
              const rest = hintChip.slice("cd:".length).split(":");
              state.cdState = rest[0] ?? null;
              state.cdDistrict = rest[1] ?? null;
              renderCdChip(state, lib);
            }
            applyGeoFilterChange(state, lib);
            return;
          }
          // Real source pick.
          const source = lib.sources?.[sourceId];
          state.root.dispatchEvent(
            new CustomEvent("source-picker:pick", {
              detail: { sourceId, source },
              bubbles: true,
            }),
          );
        });
      });
  }

  /** Boot one instance. Idempotent — calling twice on the same root
   *  is a no-op the second time. */
  async function bootInstance(root: HTMLElement): Promise<void> {
    const instanceId = root.dataset.spickerInstance ?? "";
    if (!instanceId) {
      console.warn("[source-picker] missing data-spicker-instance");
      return;
    }
    if (instances.has(instanceId)) return; // already booted

    // Parse server-rendered extraSources data attribute. Hosts can
    // also update this client-side via the source-picker:set-extra-
    // sources event (e.g. cc-modal's derived-source list changes
    // when the user creates a new derived source).
    let disabledIdsInit: string[] = [];
    const disabledJson = root.dataset.spickerDisabledIds;
    if (disabledJson) {
      try {
        disabledIdsInit = JSON.parse(disabledJson) as string[];
      } catch (e) {
        console.warn("[source-picker] bad disabled-ids JSON:", e);
      }
    }
    let extraSources: LibrarySource[] = [];
    const extraJson = root.dataset.spickerExtraSources;
    if (extraJson) {
      try {
        extraSources = JSON.parse(extraJson) as LibrarySource[];
      } catch (e) {
        console.warn("[source-picker] bad extra-sources JSON:", e);
      }
    }
    const state: InstanceState = {
      root,
      instanceId,
      searchQuery: "",
      selectedTags: new Set(),
      selectedMetroCbsa: null,
      selectedCountryCode: null,
      cdState: null,
      cdDistrict: null,
      hasInteracted: false,
      markedIds: new Set(),
      disabledIds: new Set(disabledIdsInit),
      rich: root.dataset.spickerRich === "1",
      extraSources,
      pendingScheduleId: null,
    };
    instances.set(instanceId, state);

    // Host-driven updates: markedIds + extraSources via CustomEvent
    // on the picker root. Either updates the relevant state field
    // and triggers a re-render of just the results.
    root.addEventListener("source-picker:set-marked-ids", ((
      e: Event,
    ) => {
      const detail = (e as CustomEvent).detail as { ids?: string[] };
      state.markedIds = new Set(detail?.ids ?? []);
      loadLibrary().then((lib) => renderResults(state, lib));
    }) as EventListener);

    root.addEventListener("source-picker:set-extra-sources", ((
      e: Event,
    ) => {
      const detail = (e as CustomEvent).detail as {
        sources?: LibrarySource[];
      };
      state.extraSources = detail?.sources ?? [];
      loadLibrary().then((lib) => renderResults(state, lib));
    }) as EventListener);

    root.addEventListener("source-picker:set-disabled-ids", ((
      e: Event,
    ) => {
      const detail = (e as CustomEvent).detail as { ids?: string[] };
      state.disabledIds = new Set(detail?.ids ?? []);
      loadLibrary().then((lib) => renderResults(state, lib));
    }) as EventListener);

    // Wire search input. Goes through the mobile-aware scheduler:
    // on desktop the render fires immediately, on mobile it's
    // debounced 100 ms so a typing burst doesn't grind through
    // ~21 k sources per keystroke. The scheduler ALSO re-renders
    // the tag chips (counts become query-aware once the query
    // hits 4+ chars — see topicalTagCounts's path 2).
    const searchInput = root.querySelector<HTMLInputElement>(
      "[data-spicker-role='search']",
    );
    searchInput?.addEventListener("input", () => {
      state.searchQuery = searchInput.value;
      state.hasInteracted = true;
      loadLibrary().then((lib) => scheduleRender(state, lib));
    });

    // Initial library load, then render every dependent UI piece.
    const lib = await loadLibrary();
    wireGeoChips(state, lib);
    renderCdChip(state, lib);
    renderTagChips(state, lib);
    renderResults(state, lib);
  }

  // ---------- Geo chips: popover open/close + selection wiring -------

  /** Close every open popover in EVERY instance — used when the user
   *  clicks outside any popover. */
  function closeAllPopovers(): void {
    document
      .querySelectorAll<HTMLElement>("[data-spicker-role$='-popover']")
      .forEach((p) => {
        p.hidden = true;
      });
    document
      .querySelectorAll<HTMLButtonElement>(
        "[data-spicker-role$='-chip']",
      )
      .forEach((b) => b.setAttribute("aria-expanded", "false"));
  }
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement | null;
    // If the click is inside ANY popover or chip, leave the open
    // popovers alone (their own handlers manage state). Otherwise
    // close everything.
    if (
      target?.closest("[data-spicker-role$='-popover']") ||
      target?.closest("[data-spicker-role$='-chip']")
    ) {
      return;
    }
    closeAllPopovers();
  });

  function togglePopover(
    chip: HTMLButtonElement,
    popover: HTMLElement,
  ): void {
    const isOpen = !popover.hidden;
    // Close every other popover first, then toggle this one.
    closeAllPopovers();
    if (!isOpen) {
      popover.hidden = false;
      chip.setAttribute("aria-expanded", "true");
      // Focus the popover's search input for instant typing.
      popover
        .querySelector<HTMLInputElement>(
          "[data-spicker-role$='-search']",
        )
        ?.focus();
    }
  }

  function renderGeoList(
    listEl: HTMLElement,
    entries: Array<{ code: string; primary: string; secondary?: string }>,
    query: string,
    onPick: (code: string) => void,
  ): void {
    const q = query.trim().toLowerCase();
    const filtered = q
      ? entries.filter(
          (e) =>
            e.primary.toLowerCase().includes(q) ||
            (e.secondary ?? "").toLowerCase().includes(q),
        )
      : entries;
    if (filtered.length === 0) {
      listEl.innerHTML =
        '<p class="muted small source-picker-geo-empty">No matches.</p>';
      return;
    }
    listEl.innerHTML = filtered
      .map(
        (e) =>
          `<button type="button" class="source-picker-geo-item" data-spicker-geo-code="${escapeHtml(e.code)}">` +
            `<span class="source-picker-geo-item-primary">${escapeHtml(e.primary)}</span>` +
            (e.secondary
              ? `<span class="source-picker-geo-item-secondary">${escapeHtml(e.secondary)}</span>`
              : "") +
            `</button>`,
      )
      .join("");
    listEl
      .querySelectorAll<HTMLButtonElement>("[data-spicker-geo-code]")
      .forEach((btn) => {
        btn.addEventListener("click", () => {
          onPick(btn.dataset.spickerGeoCode ?? "");
        });
      });
  }

  function updateChipLabel(
    state: InstanceState,
    role: "metro" | "country",
    label: string,
    hasClear: boolean,
  ): void {
    const labelEl = state.root.querySelector<HTMLElement>(
      `[data-spicker-role='${role}-label']`,
    );
    const clearEl = state.root.querySelector<HTMLElement>(
      `[data-spicker-role='${role}-clear']`,
    );
    if (labelEl) labelEl.innerHTML = escapeHtml(label) + " &#9662;";
    if (clearEl) clearEl.hidden = !hasClear;
  }

  function wireGeoChips(state: InstanceState, lib: LibraryPayload): void {
    // ----- Metro chip -----
    const metroChip = state.root.querySelector<HTMLButtonElement>(
      "[data-spicker-role='metro-chip']",
    );
    const metroPop = state.root.querySelector<HTMLElement>(
      "[data-spicker-role='metro-popover']",
    );
    const metroSearch = state.root.querySelector<HTMLInputElement>(
      "[data-spicker-role='metro-search']",
    );
    const metroList = state.root.querySelector<HTMLElement>(
      "[data-spicker-role='metro-list']",
    );
    const metroClear = state.root.querySelector<HTMLElement>(
      "[data-spicker-role='metro-clear']",
    );
    const metroEntries = Object.entries(lib.metros ?? {})
      .map(([code, entry]) => ({
        code,
        primary: entry.shortName,
        secondary: entry.name,
      }))
      .sort((a, b) => a.primary.localeCompare(b.primary));

    function refreshMetroList(): void {
      if (!metroList) return;
      renderGeoList(metroList, metroEntries, metroSearch?.value ?? "", (code) => {
        state.selectedMetroCbsa = code;
        const entry = lib.metros?.[code];
        updateChipLabel(
          state,
          "metro",
          entry?.shortName ?? code,
          true,
        );
        closeAllPopovers();
        applyGeoFilterChange(state, lib);
      });
    }

    metroChip?.addEventListener("click", (e) => {
      // The clear-X is a child of the chip; clicking it should reset
      // state, not toggle the popover. Detect via target.
      if (
        (e.target as HTMLElement | null)?.dataset.spickerRole ===
        "metro-clear"
      ) {
        return; // metroClear's own handler below
      }
      if (metroPop) togglePopover(metroChip, metroPop);
      refreshMetroList();
    });
    metroSearch?.addEventListener("input", refreshMetroList);
    metroClear?.addEventListener("click", (e) => {
      e.stopPropagation();
      state.selectedMetroCbsa = null;
      updateChipLabel(state, "metro", "US metro areas", false);
      applyGeoFilterChange(state, lib);
    });

    // ----- Country chip -----
    const countryChip = state.root.querySelector<HTMLButtonElement>(
      "[data-spicker-role='country-chip']",
    );
    const countryPop = state.root.querySelector<HTMLElement>(
      "[data-spicker-role='country-popover']",
    );
    const countrySearch = state.root.querySelector<HTMLInputElement>(
      "[data-spicker-role='country-search']",
    );
    const countryList = state.root.querySelector<HTMLElement>(
      "[data-spicker-role='country-list']",
    );
    const countryClear = state.root.querySelector<HTMLElement>(
      "[data-spicker-role='country-clear']",
    );
    const countryEntries = Object.entries(lib.countries ?? {})
      .map(([code, entry]) => ({ code, primary: entry.name }))
      .sort((a, b) => a.primary.localeCompare(b.primary));

    function refreshCountryList(): void {
      if (!countryList) return;
      renderGeoList(
        countryList,
        countryEntries,
        countrySearch?.value ?? "",
        (code) => {
          state.selectedCountryCode = code;
          updateChipLabel(
            state,
            "country",
            lib.countries?.[code]?.name ?? code,
            true,
          );
          closeAllPopovers();
          applyGeoFilterChange(state, lib);
        },
      );
    }

    countryChip?.addEventListener("click", (e) => {
      if (
        (e.target as HTMLElement | null)?.dataset.spickerRole ===
        "country-clear"
      )
        return;
      if (countryPop) togglePopover(countryChip, countryPop);
      refreshCountryList();
    });
    countrySearch?.addEventListener("input", refreshCountryList);
    countryClear?.addEventListener("click", (e) => {
      e.stopPropagation();
      state.selectedCountryCode = null;
      updateChipLabel(state, "country", "Regions and countries", false);
      applyGeoFilterChange(state, lib);
    });
  }

  // ---------- CD chip (two-step drill-down) ---------------------------
  //
  // The CD chip is structurally different from metro + country: when
  // inactive it's a single chip; when a state is picked it expands
  // inline to show the state name + a district dropdown. Rerendering
  // the whole CD area every state-or-district change is OK (nothing
  // else lives in the cd-host element).

  function renderCdChip(state: InstanceState, lib: LibraryPayload): void {
    const host = state.root.querySelector<HTMLElement>(
      "[data-spicker-role='cd-host']",
    );
    if (!host) return;
    if (!state.cdState) {
      // Chip inactive — just the state-selector button.
      host.innerHTML =
        `<div class="source-picker-geo-chip-wrap">` +
          `<button type="button" class="source-picker-geo-chip" data-spicker-role="cd-chip" aria-haspopup="listbox" aria-expanded="false">` +
            `<span>States &amp; districts &#9662;</span>` +
          `</button>` +
          `<div class="source-picker-geo-popover" data-spicker-role="cd-popover" role="listbox" hidden>` +
            `<input type="search" class="source-picker-geo-search" data-spicker-role="cd-state-search" placeholder="Search states…" aria-label="Search states" />` +
            `<div class="source-picker-geo-list" data-spicker-role="cd-state-list"></div>` +
          `</div>` +
        `</div>`;
      const chip = host.querySelector<HTMLButtonElement>(
        "[data-spicker-role='cd-chip']",
      );
      const pop = host.querySelector<HTMLElement>(
        "[data-spicker-role='cd-popover']",
      );
      const search = host.querySelector<HTMLInputElement>(
        "[data-spicker-role='cd-state-search']",
      );
      const list = host.querySelector<HTMLElement>(
        "[data-spicker-role='cd-state-list']",
      );
      const stateEntries = US_STATES.map((s) => ({
        code: s.code,
        primary: s.name,
      })).sort((a, b) => a.primary.localeCompare(b.primary));
      function refresh(): void {
        if (!list) return;
        renderGeoList(list, stateEntries, search?.value ?? "", (code) => {
          state.cdState = code;
          state.cdDistrict = null;
          closeAllPopovers();
          renderCdChip(state, lib);
          applyGeoFilterChange(state, lib);
        });
      }
      chip?.addEventListener("click", () => {
        if (chip && pop) togglePopover(chip, pop);
        refresh();
      });
      search?.addEventListener("input", refresh);
      return;
    }
    // Chip active — state picked. Show state name + district dropdown
    // (statewide / all / specific CDs) + clear-X.
    const stateName = stateNameFor(state.cdState);
    const districtOptions: Array<{ value: string; label: string }> = [
      { value: "__any__", label: "Any district" },
      { value: STATEWIDE_DISTRICT_CODE, label: "Statewide series only" },
    ];
    // Distinct districts available for this state. We don't ship a
    // per-state district inventory in library.json today, so we
    // derive from sources whose IDs parse as CD for the picked state.
    const cdsForState = new Set<string>();
    for (const id of Object.keys(lib.sources ?? {})) {
      const tags = lib.sources?.[id]?.tags ?? [];
      if (!tags.includes(CD_TAG)) continue;
      const parsed = parseCdSourceId(id);
      if (parsed?.state === state.cdState) cdsForState.add(parsed.district);
    }
    for (const d of Array.from(cdsForState).sort()) {
      districtOptions.push({
        value: d,
        label: formatCdShortLabel(state.cdState, d),
      });
    }
    const selectedValue = state.cdDistrict ?? "__any__";
    host.innerHTML =
      `<div class="source-picker-geo-cd-active">` +
        `<span class="source-picker-geo-cd-state">${escapeHtml(stateName)}</span>` +
        `<select class="source-picker-geo-cd-select" data-spicker-role="cd-district-select" aria-label="District">` +
          districtOptions
            .map(
              (opt) =>
                `<option value="${escapeHtml(opt.value)}"${opt.value === selectedValue ? " selected" : ""}>${escapeHtml(opt.label)}</option>`,
            )
            .join("") +
        `</select>` +
        `<button type="button" class="source-picker-geo-chip-clear" data-spicker-role="cd-clear" aria-label="Clear state filter">&times;</button>` +
      `</div>`;
    const select = host.querySelector<HTMLSelectElement>(
      "[data-spicker-role='cd-district-select']",
    );
    const clear = host.querySelector<HTMLElement>(
      "[data-spicker-role='cd-clear']",
    );
    select?.addEventListener("change", () => {
      const v = select.value;
      state.cdDistrict = v === "__any__" ? null : v;
      applyGeoFilterChange(state, lib);
    });
    clear?.addEventListener("click", () => {
      state.cdState = null;
      state.cdDistrict = null;
      renderCdChip(state, lib);
      applyGeoFilterChange(state, lib);
    });
  }

  // Boot every SourcePicker instance on the page when DOM is ready.
  // Astro pages may include multiple instances (composer's main tab
  // + cc-modal); each gets booted exactly once.
  function bootAll(): void {
    document
      .querySelectorAll<HTMLElement>("[data-spicker-instance]")
      .forEach((root) => {
        // Boot async; errors logged but don't block other instances.
        bootInstance(root).catch((e) =>
          console.warn("[source-picker] boot failed:", e),
        );
      });
  }
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", bootAll);
  } else {
    bootAll();
  }

  // All imports above are used; if you add a new dep and TS warns
  // about it being unused, that's a sign it's not wired into a code
  // path yet — fix that rather than adding a `void` stub.
</script>

