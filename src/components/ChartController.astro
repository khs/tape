---
// One-per-dashboard script. Hydrates every chart tile and dialog on the page:
//   - renders the (multi-)sparkline on each tile
//   - wires click -> dialog.showModal()
//   - renders the full chart on first dialog open
//   - handles the window-pill group (recompute reading/delta/descriptor/plot)
//   - handles the dashboard-level window selector with closest-supported fallback
//   - closes on backdrop click and the X button
---

<script>
  import * as Plot from "@observablehq/plot";
  import {
    DELTA_DAYS,
    DELTA_LABELS_PAST,
    closestSupported,
    windowStartMs,
    windowDays,
    type DeltaWindow,
  } from "../lib/deltas";
  import {
    formatValue,
    formatDelta,
    formatDeltaDisplay,
    formatDate,
    type Formatting,
  } from "../lib/format";
  import { SITE_BRAND_URL } from "../lib/brand";
  import { readStoredSession } from "../lib/supabase";
  import { track } from "@vercel/analytics";

  // One-shot auth probe — used to decide whether tile sparkline tooltips
  // include the "Click to zoom in" affordance line. Signed-in users have
  // already discovered the click-to-expand interaction; signed-out users
  // probably haven't, so they get a small extra cue. Read once at hydrate
  // time; if the user signs in or out mid-session the page reloads
  // anyway (the auth nav buttons trigger that), so we don't need to
  // refresh this flag.
  const showClickHint = !readStoredSession();
  const TILE_HINT = showClickHint ? "Click to zoom in" : null;

  type Point = { t: string; v: number };
  type Direction = "up" | "down" | "flat";

  type SourcePayload = {
    id: string;
    name: string;
    shortName: string;
    color: string;
    points: Point[];
    formatting: Formatting;
    supportedDeltas: DeltaWindow[];
    emphasis: "level" | "change";
    lastUpdated: string;
  };

  type Payload = {
    /** Chart ID, e.g. "us-macro/sp500" — forwarded from server for telemetry. */
    chartId?: string;
    isMulti: boolean;
    normalize: "rebase" | "raw" | "dual-axis";
    supportedDeltas: DeltaWindow[];
    defaultDelta: DeltaWindow;
    sources: SourcePayload[];
    // For dual-axis with 3+ sources or explicit assignment: source IDs that
    // plot on the right axis. Empty/missing → first source on left, rest right.
    rightAxisSources?: string[];
    // Fixed [start, end] date range. When set, overrides the trailing-window
    // mode entirely; tile delta and full plot both use these bounds.
    fixedRange?: { start: string; end: string };
  };

  function findPrior(points: Point[], targetMs: number): Point | null {
    if (points.length === 0) return null;
    if (new Date(points[0].t).getTime() > targetMs) return null;
    let best: Point = points[0];
    for (const p of points) {
      if (new Date(p.t).getTime() <= targetMs) best = p;
      else break;
    }
    return best;
  }

  function directionWord(d: Direction): string {
    return d === "up" ? "up" : d === "down" ? "down" : "roughly unchanged";
  }

  /**
   * Rebase a series to 100 at the window start. Baseline = latest point at or
   * before startMs; falls back to the earliest point if all points are after
   * startMs. This handles sparse (annual) series where no observation lies
   * exactly at the chosen window boundary.
   */
  function rebasePoints(points: Point[], startMs: number): Point[] {
    if (points.length === 0) return points;
    let baseline: number = points[0].v;
    for (const p of points) {
      if (new Date(p.t).getTime() <= startMs) baseline = p.v;
      else break;
    }
    if (baseline === 0) return points;
    return points.map((p) => ({ t: p.t, v: (p.v / baseline) * 100 }));
  }

  // Tip-ready point: t as a Date (Plot's preferred time format), v as the
  // value the line actually plots (raw, rebased, or rescaled depending on
  // the chart's normalize mode), and vRaw as the original-units value so
  // hover tooltips can show "actual price" even when the line shows an
  // indexed or rescaled-to-the-other-axis value.
  type TipPoint = {
    t: Date;
    v: number;
    vRaw: number;
    iso: string;
  };

  /**
   * One series' contribution to the combined hover bundle: the source
   * (for label + formatting), the series's TipPoints in render order, and
   * any per-series quirks the title formatter needs to know about.
   */
  type BundleSeries = {
    source: SourcePayload;
    pts: TipPoint[];
    rebased?: boolean;
  };

  /** One row of the combined-tip dataset: an x-time + pre-formatted lines. */
  type Bundle = {
    t: Date;
    lines: string[];
  };

  /**
   * Build the combined-tip dataset: one row per x value in the union of
   * series, each row carrying the pre-formatted lines that the tip box
   * will render. We do the forward-fill (use the last point at or before
   * x) here so the tip mirrors how Plot draws the line between sparse
   * observations — important for charts that mix daily ETF prices with
   * annual GDP, where the GDP value should "carry through" to the next
   * year's observation, not vanish between data points.
   *
   * Doing this once at render time (instead of inside the title()
   * callback Plot invokes on every pointer move) keeps hover-update
   * cheap even on multi-source plots with hundreds of points.
   */
  function buildBundles(series: BundleSeries[]): Bundle[] {
    if (series.length === 0) return [];
    const allMs = new Set<number>();
    for (const s of series) for (const p of s.pts) allMs.add(p.t.getTime());
    const sorted = [...allMs].sort((a, b) => a - b);
    return sorted.map((xMs) => {
      const t = new Date(xMs);
      const lines: string[] = [formatDate(t.toISOString())];
      for (const s of series) {
        let best: TipPoint | null = null;
        for (const p of s.pts) {
          if (p.t.getTime() <= xMs) best = p;
          else break;
        }
        if (!best) continue;
        const label = s.source.shortName || s.source.name;
        const rawStr = formatValue(best.vRaw, s.source.formatting);
        // For rebased lines, also show the on-axis index so the value
        // ties to what the user sees on the y-axis.
        const indexStr = s.rebased
          ? `  ·  index ${best.v.toFixed(1)}`
          : "";
        lines.push(`${label}: ${rawStr}${indexStr}`);
      }
      return { t, lines };
    });
  }

  /**
   * Final string handed to Plot.tip's `title` channel. Optionally prepends
   * an affordance hint (e.g. "Click to zoom in") above the data lines.
   */
  function bundleTitle(b: Bundle, hint?: string | null): string {
    return hint ? `${hint}\n${b.lines.join("\n")}` : b.lines.join("\n");
  }

  // Shared tip-mark styling. Inline so Plot's tip box font matches the rest
  // of the plot chrome — without this it falls back to the SVG defaults
  // (Helvetica) and looks foreign next to our Inter axes.
  const TIP_STYLE = {
    fill: "#fefefe",
    stroke: "#dcdcda",
    fontFamily:
      '"Inter Variable", Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif',
    fontSize: 12,
  };

  function visibleRange(
    points: Point[],
    window: DeltaWindow,
    leadIn = 0.15,
  ): { visible: Point[]; startMs: number } {
    const last = points[points.length - 1];
    const lastMs = new Date(last.t).getTime();
    // YTD anchors to Jan 1; trailing windows just subtract DELTA_DAYS.
    // windowStartMs encapsulates that decision.
    const startMs = windowStartMs(lastMs, window);
    // Lead-in buffer scales with the *actual* visible window length, so a
    // YTD plot on Jan 15 gets a tiny lead-in instead of half a year of it.
    const visibleStart = startMs - windowDays(window, new Date(lastMs)) * 86400000 * leadIn;
    const visible = points.filter(
      (p) => new Date(p.t).getTime() >= visibleStart,
    );
    return { visible, startMs };
  }

  // Same shape as visibleRange but driven by a fixed [start, end] range.
  // No lead-in buffer at the trailing edge — we want the rendered window
  // to end exactly at `end`, even if the source has more recent points.
  function visibleRangeFixed(
    points: Point[],
    startMs: number,
    endMs: number,
  ): { visible: Point[]; startMs: number } {
    const visible = points.filter((p) => {
      const t = new Date(p.t).getTime();
      return t >= startMs && t <= endMs;
    });
    return { visible, startMs };
  }

  function renderSparkSingle(
    container: HTMLElement,
    source: SourcePayload,
    window: DeltaWindow,
    fixed?: { start: string; end: string },
  ): void {
    if (source.points.length < 2) return;
    const { visible } = fixed
      ? visibleRangeFixed(
          source.points,
          new Date(fixed.start).getTime(),
          new Date(fixed.end).getTime(),
        )
      : visibleRange(source.points, window, 0);
    if (visible.length < 2) return;

    const width = container.clientWidth || 220;
    // Build TipPoints + a one-series bundle so the tile gets the same
    // hover-to-read-value affordance as the dialog. Cheap (one source's
    // points already in memory).
    const pts: TipPoint[] = visible.map((p) => ({
      t: new Date(p.t),
      v: p.v,
      vRaw: p.v,
      iso: p.t,
    }));
    const bundles = buildBundles([{ source, pts }]);
    const plot = Plot.plot({
      height: 36,
      width,
      axis: null,
      marginLeft: 0,
      marginRight: 0,
      marginTop: 2,
      marginBottom: 2,
      marks: [
        Plot.lineY(pts, {
          x: "t",
          y: "v",
          stroke: source.color,
          strokeWidth: 1.5,
        }),
        ...(bundles.length > 0
          ? [
              Plot.tip(
                bundles,
                Plot.pointerX({
                  x: "t",
                  title: (b: Bundle) => bundleTitle(b, TILE_HINT),
                  ...TIP_STYLE,
                }),
              ),
            ]
          : []),
      ],
    });
    container.replaceChildren(plot);
  }

  function renderSparkMulti(
    container: HTMLElement,
    payload: Payload,
    window: DeltaWindow,
  ): void {
    const fixed = payload.fixedRange;
    const fStart = fixed ? new Date(fixed.start).getTime() : 0;
    const fEnd = fixed ? new Date(fixed.end).getTime() : 0;
    const width = container.clientWidth || 220;

    // Dual-axis: rescale every right-axis series to fit the left axis's
    // domain so both groups render legibly in the spark. (No axis labels;
    // sparks are axis-less anyway.)
    if (
      payload.normalize === "dual-axis" &&
      payload.sources.length >= 2
    ) {
      const explicit = payload.rightAxisSources ?? [];
      const rightSet = new Set(
        explicit.length > 0
          ? explicit
          : payload.sources.slice(1).map((s) => s.id),
      );
      const matLeft = payload.sources
        .filter((s) => !rightSet.has(s.id))
        .map((s) => {
          const eff = closestSupported(window, s.supportedDeltas);
          const { visible } = fixed
            ? visibleRangeFixed(s.points, fStart, fEnd)
            : visibleRange(s.points, eff, 0);
          return { s, visible };
        });
      const matRight = payload.sources
        .filter((s) => rightSet.has(s.id))
        .map((s) => {
          const eff = closestSupported(window, s.supportedDeltas);
          const { visible } = fixed
            ? visibleRangeFixed(s.points, fStart, fEnd)
            : visibleRange(s.points, eff, 0);
          return { s, visible };
        });
      const haveLeft = matLeft.some((m) => m.visible.length >= 2);
      const haveRight = matRight.some((m) => m.visible.length >= 2);
      if (haveLeft && haveRight) {
        const flatL = matLeft.flatMap((m) => m.visible.map((p) => p.v));
        const flatR = matRight.flatMap((m) => m.visible.map((p) => p.v));
        const lMin = Math.min(...flatL);
        const lMax = Math.max(...flatL);
        const rMin = Math.min(...flatR);
        const rMax = Math.max(...flatR);
        const dL = lMax - lMin || 1;
        const dR = rMax - rMin || 1;
        const rescaleR = (v: number) => lMin + ((v - rMin) / dR) * dL;
        const dualMarks: any[] = [];
        const dualBundleSeries: BundleSeries[] = [];
        for (const m of matLeft) {
          if (m.visible.length < 2) continue;
          const pts: TipPoint[] = m.visible.map((p) => ({
            t: new Date(p.t),
            v: p.v,
            vRaw: p.v,
            iso: p.t,
          }));
          dualMarks.push(
            Plot.lineY(pts, {
              x: "t",
              y: "v",
              stroke: m.s.color,
              strokeWidth: 1.25,
            }),
          );
          dualBundleSeries.push({ source: m.s, pts });
        }
        for (const m of matRight) {
          if (m.visible.length < 2) continue;
          const pts: TipPoint[] = m.visible.map((p) => ({
            t: new Date(p.t),
            v: rescaleR(p.v),
            vRaw: p.v,
            iso: p.t,
          }));
          dualMarks.push(
            Plot.lineY(pts, {
              x: "t",
              y: "v",
              stroke: m.s.color,
              strokeWidth: 1.25,
            }),
          );
          dualBundleSeries.push({ source: m.s, pts });
        }
        const dualBundles = buildBundles(dualBundleSeries);
        if (dualBundles.length > 0) {
          dualMarks.push(
            Plot.tip(
              dualBundles,
              Plot.pointerX({
                x: "t",
                title: (b: Bundle) => bundleTitle(b, TILE_HINT),
                ...TIP_STYLE,
              }),
            ),
          );
        }
        const dualPlot = Plot.plot({
          height: 48,
          width,
          axis: null,
          marginLeft: 0,
          marginRight: 0,
          marginTop: 2,
          marginBottom: 2,
          marks: dualMarks,
        });
        container.replaceChildren(dualPlot);
        return;
      }
      // Degenerate split (one side empty) — fall through to non-dual branch.
    }

    const marks: any[] = [];
    const sparkBundles: BundleSeries[] = [];
    for (const s of payload.sources) {
      const eff = closestSupported(window, s.supportedDeltas);
      const { visible, startMs } = fixed
        ? visibleRangeFixed(s.points, fStart, fEnd)
        : visibleRange(s.points, eff, 0);
      if (visible.length < 2) continue;
      // Inline the rebase math so the TipPoint keeps both raw + plotted v.
      let baseline = visible[0].v;
      for (const p of visible) {
        if (new Date(p.t).getTime() <= startMs) baseline = p.v;
        else break;
      }
      const useRebase = payload.normalize === "rebase" && baseline !== 0;
      const pts: TipPoint[] = visible.map((p) => ({
        t: new Date(p.t),
        v: useRebase ? (p.v / baseline) * 100 : p.v,
        vRaw: p.v,
        iso: p.t,
      }));
      marks.push(
        Plot.lineY(pts, {
          x: "t",
          y: "v",
          stroke: s.color,
          strokeWidth: 1.25,
        }),
      );
      sparkBundles.push({ source: s, pts, rebased: useRebase });
    }
    const bundles = buildBundles(sparkBundles);
    if (bundles.length > 0) {
      marks.push(
        Plot.tip(
          bundles,
          Plot.pointerX({
            x: "t",
            title: (b: Bundle) => bundleTitle(b, TILE_HINT),
            ...TIP_STYLE,
          }),
        ),
      );
    }
    const plot = Plot.plot({
      height: 48,
      width,
      axis: null,
      marginLeft: 0,
      marginRight: 0,
      marginTop: 2,
      marginBottom: 2,
      marks,
    });
    container.replaceChildren(plot);
  }

  function renderFullPlot(
    container: HTMLElement,
    payload: Payload,
    window: DeltaWindow,
  ): void {
    const width = container.clientWidth || 700;

    // Dual-axis: at least 2 sources, partition into left and right groups
    // by rightAxisSources (or default = first source left, rest right).
    if (
      payload.normalize === "dual-axis" &&
      payload.sources.length >= 2
    ) {
      const explicit = payload.rightAxisSources ?? [];
      const rightSet = new Set(
        explicit.length > 0
          ? explicit
          : payload.sources.slice(1).map((s) => s.id),
      );
      const leftSrcs = payload.sources.filter((s) => !rightSet.has(s.id));
      const rightSrcs = payload.sources.filter((s) => rightSet.has(s.id));
      // Need at least one series on each side; otherwise fall through to the
      // generic non-dual-axis branch below.
      if (leftSrcs.length > 0 && rightSrcs.length > 0) {
        const fixed = payload.fixedRange;
        const fStart = fixed ? new Date(fixed.start).getTime() : 0;
        const fEnd = fixed ? new Date(fixed.end).getTime() : 0;
        // Materialize visible ranges per source — fixed range when set, else
        // window-based.
        const matLeft = leftSrcs.map((s) => {
          if (fixed) return { s, ...visibleRangeFixed(s.points, fStart, fEnd) };
          const eff = closestSupported(window, s.supportedDeltas);
          return { s, ...visibleRange(s.points, eff, 0.15) };
        });
        const matRight = rightSrcs.map((s) => {
          if (fixed) return { s, ...visibleRangeFixed(s.points, fStart, fEnd) };
          const eff = closestSupported(window, s.supportedDeltas);
          return { s, ...visibleRange(s.points, eff, 0.15) };
        });
        const haveLeft = matLeft.some((m) => m.visible.length >= 2);
        const haveRight = matRight.some((m) => m.visible.length >= 2);
        if (haveLeft && haveRight) {
          const flatL = matLeft.flatMap((m) => m.visible.map((p) => p.v));
          const flatR = matRight.flatMap((m) => m.visible.map((p) => p.v));
          const lMin = Math.min(...flatL);
          const lMax = Math.max(...flatL);
          const rMin = Math.min(...flatR);
          const rMax = Math.max(...flatR);
          const dL = lMax - lMin || 1;
          const dR = rMax - rMin || 1;
          const rescaleR = (v: number) => lMin + ((v - rMin) / dR) * dL;
          const unscaleR = (yPos: number) =>
            rMin + ((yPos - lMin) / dL) * dR;
          const marks: any[] = [];
          // Per-series TipPoints collected into a single bundle so the tip
          // box can show all series' values at the hovered x in one box,
          // rather than four overlapping boxes (the previous bug).
          const bundleSeries: BundleSeries[] = [];
          for (const m of matLeft) {
            if (m.visible.length < 2) continue;
            // Left-axis values plot at their natural scale, so v === vRaw.
            // Carrying vRaw uniformly across both sides lets the same tip
            // builder format either side without branching.
            const pts: TipPoint[] = m.visible.map((p) => ({
              t: new Date(p.t),
              v: p.v,
              vRaw: p.v,
              iso: p.t,
            }));
            marks.push(
              Plot.lineY(pts, {
                x: "t",
                y: "v",
                stroke: m.s.color,
                strokeWidth: 1.75,
              }),
              Plot.dot(pts.slice(-1), {
                x: "t",
                y: "v",
                fill: m.s.color,
                r: 3.5,
              }),
            );
            bundleSeries.push({ source: m.s, pts });
          }
          for (const m of matRight) {
            if (m.visible.length < 2) continue;
            // Right-axis values are rescaled into the left axis's range so
            // both series share one y-domain. vRaw preserves the raw value
            // so the hover tip shows the real number, not the rescaled one.
            const pts: TipPoint[] = m.visible.map((p) => ({
              t: new Date(p.t),
              v: rescaleR(p.v),
              vRaw: p.v,
              iso: p.t,
            }));
            marks.push(
              Plot.lineY(pts, {
                x: "t",
                y: "v",
                stroke: m.s.color,
                strokeWidth: 1.75,
              }),
              Plot.dot(pts.slice(-1), {
                x: "t",
                y: "v",
                fill: m.s.color,
                r: 3.5,
              }),
            );
            bundleSeries.push({ source: m.s, pts });
          }
          const bundles = buildBundles(bundleSeries);
          if (bundles.length > 0) {
            marks.push(
              Plot.tip(
                bundles,
                Plot.pointerX({
                  x: "t",
                  title: (b: Bundle) => bundleTitle(b),
                  ...TIP_STYLE,
                }),
              ),
            );
          }
          // Axis colors: when only one series on a side, color the axis to
          // match. With multiple, keep neutral so it doesn't claim allegiance.
          const leftAxisColor =
            leftSrcs.length === 1 ? leftSrcs[0].color : "#55524C";
          const rightAxisColor =
            rightSrcs.length === 1 ? rightSrcs[0].color : "#55524C";
          // Tick formatting picks formatting from the single side-source if
          // unique, otherwise just compact numeric.
          const leftFmt = leftSrcs[0]?.formatting;
          const rightFmt = rightSrcs[0]?.formatting;
          marks.push(
            Plot.axisY({
              anchor: "left",
              color: leftAxisColor,
              ticks: 5,
              tickFormat: (v: number) =>
                formatValue(v, { ...leftFmt, decimals: 1 }),
            }),
            Plot.axisY({
              anchor: "right",
              color: rightAxisColor,
              ticks: 5,
              tickFormat: (v: number) =>
                formatValue(unscaleR(v), { ...rightFmt, decimals: 1 }),
            }),
          );
          const plot = Plot.plot({
            height: 280,
            width,
            marginLeft: 64,
            marginBottom: 28,
            marginTop: 10,
            marginRight: 64,
            style: {
              fontFamily:
                '"Inter Variable", Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif',
              fontSize: "12px",
              color: "#55524C",
              background: "transparent",
            },
            x: { label: null, ticks: 5 },
            y: { label: null, grid: true, ticks: 5 },
            marks,
          });
          container.replaceChildren(plot);
          return;
        }
      }
      // If we get here, the dual-axis split was degenerate; fall through.
    }

    const marks: any[] = [];
    let dashStartDrawn = false;
    const fixed = payload.fixedRange;
    const fStart = fixed ? new Date(fixed.start).getTime() : 0;
    const fEnd = fixed ? new Date(fixed.end).getTime() : 0;
    const rebaseMode = payload.normalize === "rebase" && payload.isMulti;
    const bundleSeries: BundleSeries[] = [];
    for (const s of payload.sources) {
      const eff = closestSupported(window, s.supportedDeltas);
      const { visible, startMs } = fixed
        ? visibleRangeFixed(s.points, fStart, fEnd)
        : visibleRange(s.points, eff, 0.15);
      if (visible.length < 2) continue;
      // Compute rebase baseline up-front (same logic as rebasePoints, inlined
      // so we can build TipPoints that carry both rebased v and raw vRaw in
      // a single pass — the hover tip wants raw values).
      let baseline = visible[0].v;
      for (const p of visible) {
        if (new Date(p.t).getTime() <= startMs) baseline = p.v;
        else break;
      }
      const useRebase = rebaseMode && baseline !== 0;
      const pts: TipPoint[] = visible.map((p) => ({
        t: new Date(p.t),
        v: useRebase ? (p.v / baseline) * 100 : p.v,
        vRaw: p.v,
        iso: p.t,
      }));
      if (!dashStartDrawn) {
        marks.push(
          Plot.ruleX([new Date(startMs)], {
            stroke: "#DCDCDA",
            strokeDasharray: "3,3",
          }),
        );
        dashStartDrawn = true;
      }
      marks.push(
        Plot.lineY(pts, {
          x: "t",
          y: "v",
          stroke: s.color,
          strokeWidth: 1.75,
        }),
        Plot.dot(pts.slice(-1), {
          x: "t",
          y: "v",
          fill: s.color,
          r: 3.5,
        }),
      );
      bundleSeries.push({ source: s, pts, rebased: useRebase });
    }
    const bundles = buildBundles(bundleSeries);
    if (bundles.length > 0) {
      // One combined tip showing all series at the hovered x. Previously we
      // pushed a separate Plot.tip per series, which produced overlapping
      // boxes (and thus illegible tooltips) on multi-series plots.
      marks.push(
        Plot.tip(
          bundles,
          Plot.pointerX({
            x: "t",
            title: (b: Bundle) => bundleTitle(b),
            ...TIP_STYLE,
          }),
        ),
      );
    }
    // For single-source plots, use the source's own formatting for y-axis ticks
    // so big numbers compact down to "$3T" etc. For multi-source rebased, leave
    // default (values are always around 100).
    const singleSource =
      !payload.isMulti && payload.sources.length === 1
        ? payload.sources[0]
        : null;
    const tickFormat = singleSource
      ? (v: number) => formatValue(v, { ...singleSource.formatting, decimals: 1 })
      : undefined;

    const plot = Plot.plot({
      height: 280,
      width,
      marginLeft: 64,
      marginBottom: 28,
      marginTop: 10,
      marginRight: 16,
      style: {
        fontFamily:
          '"Inter Variable", Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif',
        fontSize: "12px",
        color: "#55524C",
        background: "transparent",
      },
      x: { label: null, ticks: 5 },
      y: { label: null, grid: true, ticks: 5, tickFormat },
      marks,
    });
    container.replaceChildren(plot);
  }

  function updateTile(
    tile: HTMLElement,
    payload: Payload,
    window: DeltaWindow,
  ): void {
    const fixed = payload.fixedRange;
    const captionEl = tile.querySelector<HTMLElement>(".tile-window");
    if (captionEl) {
      if (fixed) {
        captionEl.textContent = `${fixed.start} → ${fixed.end}`;
      } else {
        captionEl.textContent = `over the ${DELTA_LABELS_PAST[window]}`;
      }
    }

    const sparkEl = tile.querySelector<HTMLElement>(
      '[data-role="tile-spark"]',
    );

    // For fixed-range, current = last point ≤ end; prior = last point ≤ start.
    const fStart = fixed ? new Date(fixed.start).getTime() : 0;
    const fEnd = fixed ? new Date(fixed.end).getTime() : 0;
    function pickFixed(points: Point[]): { current: Point | null; prior: Point | null } {
      let current: Point | null = null;
      let prior: Point | null = null;
      for (const p of points) {
        const t = new Date(p.t).getTime();
        if (t <= fEnd) current = p;
        if (t <= fStart) prior = p;
        else if (t > fEnd) break;
      }
      return { current, prior };
    }

    if (payload.isMulti) {
      for (const s of payload.sources) {
        const eff = closestSupported(window, s.supportedDeltas);
        let current: Point | null;
        let prior: Point | null;
        if (fixed) {
          ({ current, prior } = pickFixed(s.points));
        } else {
          const last = s.points[s.points.length - 1];
          if (!last) continue;
          current = last;
          const priorMs = windowStartMs(new Date(last.t).getTime(), eff);
          prior = findPrior(s.points, priorMs);
        }
        const row = tile.querySelector<HTMLElement>(
          `[data-role="series-delta"][data-source-id="${CSS.escape(s.id)}"]`,
        );
        if (row) {
          if (current && prior) {
            const dd = formatDeltaDisplay(current.v, prior.v, s.formatting);
            row.textContent = dd.text;
            row.dataset.direction = dd.direction;
          } else {
            row.textContent = "—";
            row.dataset.direction = "flat";
          }
        }
      }
      if (sparkEl) renderSparkMulti(sparkEl, payload, window);
    } else {
      const s = payload.sources[0];
      if (!s || s.points.length === 0) return;
      const eff = closestSupported(window, s.supportedDeltas);
      let current: Point | null;
      let prior: Point | null;
      if (fixed) {
        ({ current, prior } = pickFixed(s.points));
      } else {
        const last = s.points[s.points.length - 1];
        current = last;
        const priorMs = windowStartMs(new Date(last.t).getTime(), eff);
        prior = findPrior(s.points, priorMs);
      }

      const valEl = tile.querySelector<HTMLElement>('[data-role="tile-value"]');
      if (valEl)
        valEl.textContent = current ? formatValue(current.v, s.formatting) : "—";

      const deltaEl = tile.querySelector<HTMLElement>(
        '[data-role="tile-delta"]',
      );
      if (deltaEl && current && prior) {
        const dd = formatDeltaDisplay(current.v, prior.v, s.formatting);
        deltaEl.textContent = dd.text;
        deltaEl.dataset.direction = dd.direction;
      } else if (deltaEl) {
        deltaEl.textContent = "";
      }

      if (sparkEl) renderSparkSingle(sparkEl, s, eff, fixed);
    }
  }

  function updateDialog(
    dialog: HTMLDialogElement,
    payload: Payload,
    window: DeltaWindow,
  ): void {
    const fixed = payload.fixedRange;
    const fStart = fixed ? new Date(fixed.start).getTime() : 0;
    const fEnd = fixed ? new Date(fixed.end).getTime() : 0;
    function pickFixed(points: Point[]): { current: Point | null; prior: Point | null } {
      let current: Point | null = null;
      let prior: Point | null = null;
      for (const p of points) {
        const t = new Date(p.t).getTime();
        if (t <= fEnd) current = p;
        if (t <= fStart) prior = p;
        else if (t > fEnd) break;
      }
      return { current, prior };
    }

    if (payload.isMulti) {
      for (const s of payload.sources) {
        const eff = closestSupported(window, s.supportedDeltas);
        let current: Point | null;
        let prior: Point | null;
        if (fixed) {
          ({ current, prior } = pickFixed(s.points));
        } else {
          const last = s.points[s.points.length - 1];
          if (!last) continue;
          current = last;
          const priorMs = windowStartMs(new Date(last.t).getTime(), eff);
          prior = findPrior(s.points, priorMs);
        }
        const row = dialog.querySelector<HTMLElement>(
          `.multi-readout-row[data-source-id="${CSS.escape(s.id)}"]`,
        );
        if (!row) continue;
        const levelEl = row.querySelector<HTMLElement>(
          '[data-role="readout-level"]',
        );
        const deltaEl = row.querySelector<HTMLElement>(
          '[data-role="readout-delta"]',
        );
        if (levelEl)
          levelEl.textContent = current ? formatValue(current.v, s.formatting) : "—";
        if (deltaEl) {
          if (current && prior) {
            const dd = formatDeltaDisplay(current.v, prior.v, s.formatting);
            deltaEl.textContent = dd.text;
            deltaEl.dataset.direction = dd.direction;
          } else {
            deltaEl.textContent = "—";
            deltaEl.dataset.direction = "flat";
          }
        }
      }
      const captionEl = dialog.querySelector<HTMLElement>(
        '[data-role="descriptor"]',
      );
      if (captionEl) {
        captionEl.textContent = fixed
          ? `${fixed.start} → ${fixed.end}.`
          : `Over the ${DELTA_LABELS_PAST[window]}.`;
      }
    } else {
      const s = payload.sources[0];
      if (!s) return;
      const eff = closestSupported(window, s.supportedDeltas);
      let current: Point | null;
      let prior: Point | null;
      if (fixed) {
        ({ current, prior } = pickFixed(s.points));
      } else {
        const last = s.points[s.points.length - 1];
        current = last;
        const priorMs = windowStartMs(new Date(last.t).getTime(), eff);
        prior = findPrior(s.points, priorMs);
      }

      const currentStr = current ? formatValue(current.v, s.formatting) : "—";
      const valEl = dialog.querySelector<HTMLElement>('[data-role="value"]');
      if (valEl) valEl.textContent = currentStr;

      const deltaEl = dialog.querySelector<HTMLElement>(
        '[data-role="delta-pct"]',
      );
      const descriptorEl = dialog.querySelector<HTMLElement>(
        '[data-role="descriptor"]',
      );

      if (current && prior) {
        const dd = formatDeltaDisplay(current.v, prior.v, s.formatting);
        if (deltaEl) {
          deltaEl.textContent = dd.text;
          deltaEl.dataset.direction = dd.direction;
        }
        const priorStr = formatValue(prior.v, s.formatting);
        const periodPhrase = fixed
          ? `from ${fixed.start} to ${fixed.end}`
          : `over the ${DELTA_LABELS_PAST[eff]}`;
        if (descriptorEl) {
          descriptorEl.textContent =
            dd.direction === "flat"
              ? `${s.name} is at ${currentStr}, roughly unchanged ${periodPhrase}.`
              : `${s.name} is at ${currentStr}, ${directionWord(dd.direction)} from ${priorStr} ${periodPhrase} (${dd.text}).`;
        }
      } else {
        if (deltaEl) {
          deltaEl.textContent = "";
          deltaEl.dataset.direction = "flat";
        }
        if (descriptorEl) {
          const periodPhrase = fixed
            ? `the range ${fixed.start} → ${fixed.end}`
            : `the ${DELTA_LABELS_PAST[eff]}`;
          descriptorEl.textContent = `${s.name} is at ${currentStr}. History doesn't cover ${periodPhrase}.`;
        }
      }
    }

    const plotEl = dialog.querySelector<HTMLElement>('[data-role="plot"]');
    if (plotEl) renderFullPlot(plotEl, payload, window);
    // (Pill-active toggling is handled by the call site so that the "fixed"
    // pill — whose data-window value isn't a DeltaWindow — can be activated
    // alongside regular windows.)
  }

  interface TileCtx {
    tile: HTMLElement;
    dialog: HTMLDialogElement;
    payload: Payload;
    currentWindow: DeltaWindow;
    // "fixed" when the dialog should render the dashboard's fixedRange;
    // otherwise the user's currently-selected DeltaWindow. When a chart
    // ships with a fixed range, this defaults to "fixed" but the user can
    // toggle to a trailing window from the dialog's pill row.
    selectedView: DeltaWindow | "fixed";
    dialogInitialized: boolean;
  }

  // Build the payload to pass to update functions based on whether the
  // viewer is in fixed-range mode or trailing-window mode. In trailing
  // mode we strip the dashboard's fixedRange so the renderers fall back
  // to window logic.
  function effectivePayload(payload: Payload, useFixed: boolean): Payload {
    if (useFixed) return payload;
    if (!payload.fixedRange) return payload;
    return { ...payload, fixedRange: undefined };
  }

  // Toggle pill-active class to match the current view selection.
  function setActivePill(
    dialog: HTMLDialogElement,
    selected: DeltaWindow | "fixed",
  ): void {
    dialog
      .querySelectorAll<HTMLButtonElement>("button[data-window]")
      .forEach((p) => {
        const active = p.dataset.window === selected;
        p.classList.toggle("pill-active", active);
        p.setAttribute("aria-pressed", active ? "true" : "false");
      });
  }

  // ---- Save-as-image export ----
  // Capture the dialog's currently-rendered SVG, wrap it in a branded
  // header/footer container, rasterize via Canvas, and trigger a download.
  // Keeps the user inside the page (no server roundtrip) and the watermark
  // makes the image attributable when it ends up in a slide deck or memo.

  function escapeXml(s: string): string {
    return s
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&apos;");
  }

  function slugifyForFilename(s: string): string {
    return (
      s
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-+|-+$/g, "")
        .slice(0, 60) || "chart"
    );
  }

  /**
   * Inline computed font/fill/stroke styles on every node of the SVG clone so
   * the serialized markup renders the same in a fresh <img> tag as it does on
   * the live page (where external CSS supplies most of the styling). Without
   * this step, the exported PNG comes out with wrong fonts, default black
   * strokes, and missing fills.
   */
  function inlineComputedStyles(
    live: SVGSVGElement,
    cloned: SVGSVGElement,
  ): void {
    const liveNodes = live.querySelectorAll<SVGElement>("*");
    const clonedNodes = cloned.querySelectorAll<SVGElement>("*");
    const wanted = [
      "fill",
      "stroke",
      "stroke-width",
      "stroke-linecap",
      "stroke-linejoin",
      "stroke-dasharray",
      "stroke-opacity",
      "fill-opacity",
      "opacity",
      "font-family",
      "font-size",
      "font-weight",
      "text-anchor",
      "dominant-baseline",
      "color",
    ];
    for (let i = 0; i < liveNodes.length && i < clonedNodes.length; i++) {
      const styles = getComputedStyle(liveNodes[i]);
      let inline = "";
      for (const prop of wanted) {
        const val = styles.getPropertyValue(prop);
        if (val && val !== "none" && val !== "normal") {
          inline += `${prop}:${val};`;
        }
      }
      if (inline) clonedNodes[i].setAttribute("style", inline);
    }
  }

  /**
   * Capture the dialog's chart as a watermarked PNG Blob. Returns the Blob
   * plus a filename, ready for either clipboard-write or a download anchor
   * fallback. Caller decides which.
   */
  async function captureDialogPng(
    dialog: HTMLDialogElement,
    payload: Payload,
    currentWindow: DeltaWindow,
  ): Promise<{ blob: Blob; filename: string } | null> {
    const plotEl = dialog.querySelector<HTMLElement>('[data-role="plot"]');
    const liveSvg = plotEl?.querySelector<SVGSVGElement>("svg");
    if (!liveSvg) return null;

    const titleEl = dialog.querySelector<HTMLHeadingElement>(
      ".dialog-header h2",
    );
    const title = titleEl?.textContent?.trim() ?? "Chart";

    // Source attribution line. Mirrors the existing dialog footer but
    // flattened into a single string so it renders cleanly in the export.
    const sourceLabels = payload.sources.map((s) => s.shortName || s.name);
    const sourceLine = sourceLabels.join(" · ");

    // Window label (e.g. "5y", "10y") so the exported image is self-describing
    // when it's pasted into a slide divorced from the dashboard context.
    const windowLabel = currentWindow.toUpperCase();

    // Latest data timestamp across all sources, so the image carries its own
    // recency stamp.
    let mostRecent = "";
    for (const s of payload.sources) {
      if (s.lastUpdated > mostRecent) mostRecent = s.lastUpdated;
    }
    const updatedStr = mostRecent
      ? new Date(mostRecent).toLocaleDateString(undefined, {
          year: "numeric",
          month: "short",
          day: "numeric",
        })
      : "";

    // Clone the live SVG and freeze its styling — Plot's output relies on
    // CSS rules from the page; without inlining computed styles, the export
    // would lose fonts/strokes.
    const cloned = liveSvg.cloneNode(true) as SVGSVGElement;
    inlineComputedStyles(liveSvg, cloned);

    const liveRect = liveSvg.getBoundingClientRect();
    const plotW = Math.max(640, Math.round(liveRect.width || 720));
    const plotH = Math.max(280, Math.round(liveRect.height || 360));
    cloned.setAttribute("width", String(plotW));
    cloned.setAttribute("height", String(plotH));

    const pad = 28;
    const headerH = 64 + (sourceLine ? 22 : 0);
    const footerH = 28;
    const W = plotW + pad * 2;
    const H = plotH + headerH + footerH + pad * 2;

    // Build the wrapper SVG that contains: branded eyebrow, title, optional
    // source line, the cloned plot, and watermark footer.
    const plotInner = new XMLSerializer().serializeToString(cloned);
    const wrapper = [
      `<svg xmlns="http://www.w3.org/2000/svg" width="${W}" height="${H}" viewBox="0 0 ${W} ${H}" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif">`,
      `<rect width="${W}" height="${H}" fill="#fefefe"/>`,
      `<text x="${pad}" y="${pad + 14}" font-size="11" font-weight="600" letter-spacing="1.2" fill="#0d7a6a">LEGIBLE MARKETS</text>`,
      `<text x="${pad}" y="${pad + 46}" font-size="22" font-weight="600" fill="#111">${escapeXml(title)}</text>`,
      sourceLine
        ? `<text x="${pad}" y="${pad + 70}" font-size="13" fill="#666">${escapeXml(sourceLine)} · ${escapeXml(windowLabel)} window</text>`
        : "",
      `<g transform="translate(${pad}, ${pad + headerH})">${plotInner}</g>`,
      `<text x="${pad}" y="${H - pad / 2}" font-size="12" fill="#888">${escapeXml(SITE_BRAND_URL)}</text>`,
      updatedStr
        ? `<text x="${W - pad}" y="${H - pad / 2}" font-size="12" fill="#888" text-anchor="end">Data through ${escapeXml(updatedStr)}</text>`
        : "",
      `</svg>`,
    ].join("");

    const svgBlob = new Blob([wrapper], {
      type: "image/svg+xml;charset=utf-8",
    });
    const url = URL.createObjectURL(svgBlob);

    try {
      const img = new Image();
      img.decoding = "sync";
      const loaded = new Promise<void>((resolve, reject) => {
        img.onload = () => resolve();
        img.onerror = () => reject(new Error("svg load failed"));
      });
      img.src = url;
      await loaded;

      // 2× DPR for crisp output regardless of the user's screen.
      const dpr = 2;
      const canvas = document.createElement("canvas");
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      const ctx = canvas.getContext("2d");
      if (!ctx) throw new Error("2d context unavailable");
      ctx.scale(dpr, dpr);
      ctx.drawImage(img, 0, 0);

      const blob = await new Promise<Blob | null>((resolve) => {
        canvas.toBlob((b) => resolve(b), "image/png");
      });
      if (!blob) throw new Error("toBlob returned null");
      return {
        blob,
        filename: `${slugifyForFilename(title)}-${currentWindow}.png`,
      };
    } finally {
      URL.revokeObjectURL(url);
    }
  }

  /**
   * Trigger a browser download of the given blob as a fallback when the
   * clipboard image-write API isn't available. Returned as a Promise so the
   * caller can await completion (the click happens synchronously but the
   * browser kicks the download asynchronously).
   */
  function downloadBlob(blob: Blob, filename: string): void {
    const dlUrl = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = dlUrl;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    setTimeout(() => URL.revokeObjectURL(dlUrl), 0);
  }

  /**
   * Try to write the PNG to the system clipboard. Returns true on success,
   * false if the browser doesn't support image clipboard writes (older
   * Firefox or Safari) or if the user denied clipboard permission.
   */
  async function copyImageToClipboard(blob: Blob): Promise<boolean> {
    try {
      const Ctor = (window as unknown as { ClipboardItem?: typeof ClipboardItem })
        .ClipboardItem;
      if (!Ctor || !navigator.clipboard?.write) return false;
      const item = new Ctor({ [blob.type]: blob });
      await navigator.clipboard.write([item]);
      return true;
    } catch {
      return false;
    }
  }

  function hydrate(): void {
    const dashRoot = document.querySelector<HTMLElement>(".dashboard-root");
    const dashDefault = (dashRoot?.dataset.dashboardDefaultWindow ??
      "1m") as DeltaWindow;

    const tileContexts: TileCtx[] = [];
    const tiles = document.querySelectorAll<HTMLElement>(
      ".chart-tile[data-chart-ref]",
    );
    tiles.forEach((tile) => {
      const ref = tile.dataset.chartRef;
      if (!ref) return;
      const dialog = document.getElementById(ref);
      if (!(dialog instanceof HTMLDialogElement)) return;

      const payloadEl = dialog.querySelector<HTMLScriptElement>(
        "script[data-chart-payload]",
      );
      if (!payloadEl?.textContent) return;
      let payload: Payload;
      try {
        payload = JSON.parse(payloadEl.textContent);
      } catch {
        return;
      }

      const ctx: TileCtx = {
        tile,
        dialog,
        payload,
        currentWindow: closestSupported(dashDefault, payload.supportedDeltas),
        selectedView: payload.fixedRange ? "fixed" : "_window",
        dialogInitialized: false,
      } as TileCtx;
      // Fix sentinel "_window": replace with the actual window value.
      if (ctx.selectedView === ("_window" as unknown as DeltaWindow)) {
        ctx.selectedView = ctx.currentWindow;
      }
      tileContexts.push(ctx);
      updateTile(tile, payload, ctx.currentWindow);

      tile.addEventListener("click", () => {
        dialog.showModal();
        if (!ctx.dialogInitialized) {
          const useFixed = ctx.selectedView === "fixed";
          updateDialog(
            dialog,
            effectivePayload(payload, useFixed),
            ctx.currentWindow,
          );
          setActivePill(dialog, ctx.selectedView);
          ctx.dialogInitialized = true;
        }
      });

      dialog
        .querySelectorAll<HTMLButtonElement>("button[data-window]")
        .forEach((pill) => {
          pill.addEventListener("click", (e) => {
            e.stopPropagation();
            const w = pill.dataset.window;
            if (!w) return;
            if (w === "fixed") {
              ctx.selectedView = "fixed";
              updateDialog(
                dialog,
                effectivePayload(payload, true),
                ctx.currentWindow,
              );
            } else {
              ctx.currentWindow = w as DeltaWindow;
              ctx.selectedView = ctx.currentWindow;
              updateDialog(
                dialog,
                effectivePayload(payload, false),
                ctx.currentWindow,
              );
            }
            setActivePill(dialog, ctx.selectedView);
          });
        });

      dialog.addEventListener("click", (e) => {
        if (e.target === dialog) dialog.close();
      });

      const closeBtn = dialog.querySelector<HTMLElement>(".dialog-close");
      if (closeBtn) {
        closeBtn.addEventListener("click", () => dialog.close());
      }

      const embedLinkBtn = dialog.querySelector<HTMLButtonElement>(
        "[data-role='copy-embed-link']",
      );
      if (embedLinkBtn) {
        embedLinkBtn.addEventListener("click", async (e) => {
          e.stopPropagation();
          if (embedLinkBtn.disabled) return;
          // Substack / Twitter / Slack / Discord auto-unfurl URLs via OG
          // meta tags. For library charts we link to the chart-detail page
          // (/chart/<id>/) whose OG image is a rich rendered preview of
          // that specific chart. For ad-hoc inline charts (composer-only,
          // no detail page) fall back to the current page URL — that's
          // still a real page with its own OG card.
          const chartId = payload.chartId ?? "";
          const origin = window.location.origin;
          const isInline = chartId.startsWith("inline:");
          const link =
            chartId && !isInline
              ? `${origin}/chart/${chartId}/`
              : window.location.href;
          const originalLabel = embedLinkBtn.textContent ?? "Copy embed link";
          embedLinkBtn.disabled = true;
          try {
            await navigator.clipboard.writeText(link);
            embedLinkBtn.textContent = "Copied!";
            // Strong intent signal — separate from share-link copy because
            // this one's specifically about distribution to a different
            // surface, not just "share the URL I'm on".
            track("chart_embed_link_copied", {
              chartId,
              window: ctx.currentWindow,
              sources: payload.sources
                .map((s) => s.id)
                .slice(0, 8)
                .join(","),
            });
          } catch {
            embedLinkBtn.textContent = "Copy failed";
          } finally {
            setTimeout(() => {
              embedLinkBtn.disabled = false;
              embedLinkBtn.textContent = originalLabel;
            }, 1500);
          }
        });
      }

      const copyImgBtn = dialog.querySelector<HTMLButtonElement>(
        "[data-role='copy-image']",
      );
      if (copyImgBtn) {
        copyImgBtn.addEventListener("click", async (e) => {
          e.stopPropagation();
          if (copyImgBtn.disabled) return;
          // Defensive: the dialog must have rendered its plot before capture
          // works. Forcing render here is cheap and idempotent.
          if (!ctx.dialogInitialized) {
            const useFixed = ctx.selectedView === "fixed";
            updateDialog(
              dialog,
              effectivePayload(payload, useFixed),
              ctx.currentWindow,
            );
            setActivePill(dialog, ctx.selectedView);
            ctx.dialogInitialized = true;
          }
          const originalLabel = copyImgBtn.textContent ?? "Copy chart as image";
          copyImgBtn.disabled = true;
          copyImgBtn.textContent = "Copying…";
          try {
            const captured = await captureDialogPng(
              dialog,
              payload,
              ctx.currentWindow,
            );
            if (!captured) throw new Error("capture failed");
            // Clipboard image-write is what we want — paste directly into
            // Substack / a Google Doc / a slide. Browsers without
            // ClipboardItem (old Firefox, ancient Safari) gracefully fall
            // back to a file download so the action still produces *something*.
            const clipboardOk = await copyImageToClipboard(captured.blob);
            let outcome: "clipboard" | "download";
            if (clipboardOk) {
              copyImgBtn.textContent = "Copied!";
              outcome = "clipboard";
            } else {
              downloadBlob(captured.blob, captured.filename);
              copyImgBtn.textContent = "Downloaded";
              outcome = "download";
            }
            setTimeout(() => {
              copyImgBtn.disabled = false;
              copyImgBtn.textContent = originalLabel;
            }, 1500);
            // Telemetry: image export is a strong intent signal. `outcome`
            // distinguishes clipboard from the older-browser download path
            // so we can see how often the fallback is hit.
            track("chart_image_copied", {
              chartId: payload.chartId ?? "",
              window: ctx.currentWindow,
              outcome,
              sources: payload.sources
                .map((s) => s.id)
                .slice(0, 8)
                .join(","),
            });
          } catch (err) {
            console.error("[copy image] failed:", err);
            copyImgBtn.textContent = "Failed";
            setTimeout(() => {
              copyImgBtn.disabled = false;
              copyImgBtn.textContent = originalLabel;
            }, 1500);
          }
        });
      }
    });

    const dashPills = document.querySelectorAll<HTMLButtonElement>(
      "[data-dashboard-window-control] button[data-dashboard-window]",
    );
    dashPills.forEach((pill) => {
      pill.addEventListener("click", () => {
        const want = pill.dataset.dashboardWindow as DeltaWindow | undefined;
        if (!want) return;
        dashPills.forEach((p) => {
          const active = p === pill;
          p.classList.toggle("pill-active", active);
          p.setAttribute("aria-pressed", active ? "true" : "false");
        });
        tileContexts.forEach((ctx) => {
          const w = closestSupported(want, ctx.payload.supportedDeltas);
          ctx.currentWindow = w;
          // Track the user's intent at the dashboard level so reopening
          // the dialog reflects the active selection, not the trailing
          // pre-click state.
          ctx.selectedView = w;
          updateTile(ctx.tile, ctx.payload, w);
          if (ctx.dialogInitialized) {
            updateDialog(ctx.dialog, ctx.payload, w);
            // Mirror the dashboard-level pill state into the dialog's
            // per-chart pill row so the highlighted pill matches what's
            // actually plotted — otherwise the dialog shows stale
            // selection after a dashboard-level window change.
            setActivePill(ctx.dialog, w);
          }
        });
      });
    });

    let resizeTimer: number | undefined;
    window.addEventListener("resize", () => {
      if (resizeTimer) window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        tileContexts.forEach((ctx) => {
          const sparkEl = ctx.tile.querySelector<HTMLElement>(
            '[data-role="tile-spark"]',
          );
          if (!sparkEl) return;
          if (ctx.payload.isMulti) {
            renderSparkMulti(sparkEl, ctx.payload, ctx.currentWindow);
          } else {
            const s = ctx.payload.sources[0];
            if (s) {
              const eff = closestSupported(
                ctx.currentWindow,
                s.supportedDeltas,
              );
              renderSparkSingle(sparkEl, s, eff);
            }
          }
        });
      }, 150);
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", hydrate);
  } else {
    hydrate();
  }
</script>
