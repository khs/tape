---
// One-per-dashboard script. Hydrates every chart tile and dialog on the page:
//   - renders the (multi-)sparkline on each tile
//   - wires click -> dialog.showModal()
//   - renders the full chart on first dialog open
//   - handles the window-pill group (recompute reading/delta/descriptor/plot)
//   - handles the dashboard-level window selector with closest-supported fallback
//   - closes on backdrop click and the X button
---

<script>
  import * as Plot from "@observablehq/plot";
  import {
    DELTA_LABELS_PAST,
    DELTA_LABELS_SHORT,
    DELTA_DAYS,
    closestSupported,
    windowStartMs,
    windowDays,
    type DeltaWindow,
  } from "../lib/deltas";
  import {
    formatValue,
    formatDeltaDisplay,
    formatDate,
    magnitudeFromFormatting,
    type Formatting,
  } from "../lib/format";
  import {
    bandsFor,
    SHADING_FILL_OPACITY,
    type ShadingKey,
  } from "../lib/shading-presets";
  import {
    applyTransform,
    transformFormatting,
    type TransformKey,
  } from "../lib/transforms";
  import {
    annotationsHiddenSummary,
    type Annotation,
  } from "../lib/annotations";
  import { SITE_BRAND_URL } from "../lib/brand";
  import { readStoredSession } from "../lib/supabase";
  import {
    encodeComposedState,
    type InlineChart,
  } from "../lib/composer-state";
  import { track } from "../lib/track";

  // One-shot auth probe — used to decide whether tile sparkline tooltips
  // include the "Click to zoom in" affordance line. Signed-in users have
  // already discovered the click-to-expand interaction; signed-out users
  // probably haven't, so they get a small extra cue. Read once at hydrate
  // time; if the user signs in or out mid-session the page reloads
  // anyway (the auth nav buttons trigger that), so we don't need to
  // refresh this flag.
  const showClickHint = !readStoredSession();
  const TILE_HINT = showClickHint ? "Click to zoom in" : null;

  type Point = { t: string; v: number };
  type Direction = "up" | "down" | "flat";

  /** Compact per-window data shipped on the page for tile-only rendering. */
  type SummaryPayload = {
    latest: Point;
    priors: Partial<Record<DeltaWindow, Point>>;
    sparks: Partial<Record<DeltaWindow, Point[]>>;
    /**
     * Most recent projection vintage, baked in for tile-mode rendering.
     * Full vintage history (older as-of dates) lives in the full data
     * file and is loaded lazily on dialog open.
     */
    latestProjection?: {
      vintage: string;
      points: Point[];
    };
  };

  /**
   * Projections (vintage_date -> points) for full-mode sources. Same
   * shape as `TimeSeriesData.projections` in src/lib/data-types.ts.
   * Phase 2 renderer uses only the latest vintage; older vintages
   * ride along for future Phase 3 vintage-picker work.
   */
  type ProjectionMap = Record<string, Point[]>;

  type SourcePayload = {
    id: string;
    name: string;
    shortName: string;
    color: string;
    /**
     * Full timeseries. Either:
     *  - present from the start (op'd / fixed-range / derived charts —
     *    server bakes them in), OR
     *  - injected later by the lazy-fetch on first dialog open.
     * Tile-only code paths must NOT assume this is set; use the helpers
     * `tileCurrent` / `tilePrior` / `tileSparkPoints` below, which fall
     * back to `summary` automatically.
     */
    points?: Point[];
    /**
     * Per-window summary shipped for "simple" trailing-window charts so
     * the tile renders without the full series. Mutually exclusive with
     * `points` at server-render time; once lazy-fetch hydrates `points`
     * both can coexist on the same payload object (the helpers prefer
     * points when present).
     */
    summary?: SummaryPayload;
    /**
     * Static-asset path to fetch the full timeseries from. Used by the
     * lazy-fetch path on first dialog open when only `summary` was
     * shipped. Always set; safe to omit defensively but server should
     * never produce a payload without it.
     */
    dataFile?: string;
    /**
     * Full projection map (every vintage). Only present in full mode —
     * summary-mode payloads carry just the latest vintage inside
     * `summary.latestProjection` instead. The lazy-fetch path on dialog
     * open populates this when hydrating a summary-mode payload.
     */
    projections?: ProjectionMap;
    formatting: Formatting;
    supportedDeltas: DeltaWindow[];
    emphasis: "level" | "change";
    lastUpdated: string;
    /** Upstream data provider for citation block. Optional for back-compat. */
    provider?: string;
  };

  type Payload = {
    /** Chart ID, e.g. "us-macro/sp500" — forwarded from server for telemetry. */
    chartId?: string;
    /** Surface (preset slug / "custom" / "u-<slug>" / "chart") — for telemetry. */
    surface?: string;
    /** Chart title — used as the seed title when "Open as new dashboard" fires. */
    title?: string;
    isMulti: boolean;
    normalize: "rebase" | "raw" | "dual-axis";
    /** Y-axis scale. "log" only respected when normalize !== "dual-axis". */
    scale?: "linear" | "log";
    /** Optional arithmetic op (divide/sum/diff), preserved for inline-chart roundtrip. */
    op?: "divide" | "sum" | "diff";
    supportedDeltas: DeltaWindow[];
    defaultDelta: DeltaWindow;
    sources: SourcePayload[];
    // For dual-axis with 3+ sources or explicit assignment: source IDs that
    // plot on the right axis. Empty/missing → first source on left, rest right.
    rightAxisSources?: string[];
    // Fixed [start, end] date range. When set, overrides the trailing-window
    // mode entirely; tile delta and full plot both use these bounds.
    fixedRange?: { start: string; end: string };
    /**
     * Background shading layers. Each entry is a preset key resolved
     * via bandsFor() — `recessions`, `president_party`, `senate_majority`,
     * `house_majority`, `bear_markets`, `fed_chairs`. The renderer adds
     * Plot.rectX marks for the bands BEFORE the line marks so the
     * line stays on top. Multiple stack via alpha compositing.
     */
    shading?: ShadingKey[];
    /**
     * Default y-axis transform for the dialog plot ("level" / "yoy_pct"
     * / "index_100"). The transform pills in the dialog override
     * per-session via ctx.currentTransform without re-emitting the
     * payload; this field is the FIRST-PAINT default the pills are
     * initialized to.
     */
    transform?: TransformKey;
    /**
     * Editorial annotations — date-pinned text labels. Rendered as
     * Plot.ruleX vertical guides + Plot.text labels at the top/
     * bottom of the dialog plot. See src/lib/annotations.ts.
     */
    annotations?: Annotation[];
  };

  /**
   * Build Plot marks for editorial annotations — a vertical dashed
   * guide line at each annotation's date + a small text label
   * floating above/below the plot.
   *
   * Filtered to annotations whose date falls inside the visible
   * window; off-window annotations would draw outside the plot
   * frame and serve no purpose at the current zoom.
   *
   * Visual style:
   *   - 1px dashed line in muted neutral gray, low opacity
   *   - Label in small 10px Inter, positioned just inside the
   *     plot's top edge (above) or bottom edge (below)
   *   - text-anchor inferred from position relative to the plot
   *     middle so labels near the right edge align left-end-to-
   *     marker instead of running off-screen
   */
  function annotationMarks(
    annotations: Annotation[] | undefined,
    domainStart: Date | null,
    domainEnd: Date | null,
  ): any[] {
    if (!annotations || annotations.length === 0) return [];
    const marks: any[] = [];
    const startMs = domainStart ? domainStart.getTime() : -Infinity;
    const endMs = domainEnd ? domainEnd.getTime() : Infinity;
    const visible = annotations
      .map((a) => ({
        ...a,
        dateObj: new Date(a.date),
      }))
      .filter((a) => {
        const ms = a.dateObj.getTime();
        return ms >= startMs && ms <= endMs;
      });
    if (visible.length === 0) return [];
    // Vertical guide lines, one per annotation. Drawn first so the
    // line label sits visually on top.
    marks.push(
      Plot.ruleX(visible, {
        x: "dateObj",
        stroke: "#6f6c66",
        strokeDasharray: "2,3",
        strokeOpacity: 0.55,
      }),
    );
    // Group annotations by position so we can apply different
    // frame anchors. Above-the-line at top, below at bottom.
    const aboveAnns = visible.filter((a) => (a.position ?? "above") === "above");
    const belowAnns = visible.filter((a) => a.position === "below");
    if (aboveAnns.length > 0) {
      marks.push(
        Plot.text(aboveAnns, {
          x: "dateObj",
          text: "label",
          frameAnchor: "top",
          dy: 6,
          textAnchor: "middle",
          fill: "#1c1c1a",
          fontSize: 10,
          fontWeight: 500,
        }),
      );
    }
    if (belowAnns.length > 0) {
      marks.push(
        Plot.text(belowAnns, {
          x: "dateObj",
          text: "label",
          frameAnchor: "bottom",
          dy: -6,
          textAnchor: "middle",
          fill: "#1c1c1a",
          fontSize: 10,
          fontWeight: 500,
        }),
      );
    }
    return marks;
  }

  /**
   * Update the "X annotations outside this window" hint underneath the
   * dialog plot. Off-window annotations get filtered by annotationMarks
   * so labels don't draw outside the frame; this surfaces the count
   * (and a recommended longer window when one would cover everything)
   * so the user understands why nothing rendered.
   *
   * Pure summary math lives in annotationsHiddenSummary so it can be
   * unit-tested; this wrapper just routes the result into the DOM.
   * Lookup: the hint <p> is a sibling of the plot container inside the
   * dialog. Tile rendering uses different roles (`tile-spark` etc.) and
   * has no `annotations-hidden-notice`, so the lookup fails safely there.
   */
  function updateAnnotationsHiddenNotice(
    plotContainer: HTMLElement,
    annotations: Annotation[] | undefined,
    domainMs: [number, number],
    supported: DeltaWindow[] | undefined,
  ): void {
    const notice = plotContainer.parentElement?.querySelector<HTMLElement>(
      "[data-role='annotations-hidden-notice']",
    );
    if (!notice) return;
    const windowDaysList = (supported ?? [])
      .filter((w) => DELTA_DAYS[w] !== undefined)
      .map((w) => ({ key: w as string, days: DELTA_DAYS[w] }));
    const { count, recommendedKey } = annotationsHiddenSummary(
      annotations,
      domainMs,
      windowDaysList,
    );
    if (count === 0) {
      notice.hidden = true;
      notice.textContent = "";
      return;
    }
    const noun = count === 1 ? "annotation" : "annotations";
    const recoText = recommendedKey
      ? ` Try the ${DELTA_LABELS_SHORT[recommendedKey as DeltaWindow]} window.`
      : "";
    notice.textContent = `${count} ${noun} outside this window.${recoText}`;
    notice.hidden = false;
  }

  /**
   * Build Plot.rectX marks for every requested shading preset, clipped
   * to the visible date window so a "1y" tile doesn't paint 80 years
   * of recession bands behind it.
   */
  function shadingMarks(
    shading: ShadingKey[] | undefined,
    domainStart: Date | null,
    domainEnd: Date | null,
  ): any[] {
    if (!shading || shading.length === 0) return [];
    const marks: any[] = [];
    const startMs = domainStart ? domainStart.getTime() : -Infinity;
    const endMs = domainEnd ? domainEnd.getTime() : Infinity;
    for (const key of shading) {
      const bands = bandsFor(key);
      if (bands.length === 0) continue;
      // Filter to bands that overlap the visible window. A band overlaps
      // when its [start, end] intersects [domainStart, domainEnd].
      const visible = bands
        .map((b) => ({
          ...b,
          startDate: new Date(b.start),
          endDate: new Date(b.end),
        }))
        .filter(
          (b) =>
            b.endDate.getTime() >= startMs && b.startDate.getTime() <= endMs,
        );
      if (visible.length === 0) continue;
      // Group bands by fill color and emit one Plot.rectX per group
      // with a CONSTANT fill string. Both the column-string form
      // (`fill: "fill"`) and the function form (`fill: (d) => d.fill`)
      // push values through Plot's fill channel scale, which auto-
      // detects ordinal for hex-string inputs and assigns palette
      // colors instead of using the values literally — so president_
      // party showed teal+amber instead of blue+red, fed_chairs
      // showed the wrong grays, etc. A constant `fill: "#XXXXXX"`
      // string is NOT a channel encoding and bypasses the scale.
      // Group keeps the mark count small (recessions: 1 mark;
      // president_party: 2 marks — one per party color).
      const byFill = new Map<string, typeof visible>();
      for (const band of visible) {
        const list = byFill.get(band.fill);
        if (list) list.push(band);
        else byFill.set(band.fill, [band]);
      }
      for (const [fillColor, group] of byFill) {
        marks.push(
          Plot.rectX(group, {
            x1: "startDate",
            x2: "endDate",
            fill: fillColor,
            fillOpacity: SHADING_FILL_OPACITY,
            // Title (hover tooltip) shows the band's label, e.g.
            // "2007-09 to 2009-06: Great Recession" or "Obama
            // (Democratic)".
            title: "label",
          }),
        );
      }
    }
    return marks;
  }

  /**
   * Multi-source raw-mode axis rescaling.
   *
   * When a multi-source chart is in "raw" mode AND its sources are
   * stored at meaningfully different magnitudes (e.g. one in raw
   * dollars, another in billions of dollars), the natural plot puts
   * the smaller-magnitude series TINY and the larger-magnitude one
   * dominant — even though the on-screen face value of the smaller
   * one (700) is "bigger" than the face value of the larger one (300
   * for "300B"). Without intervention, a $700 share price plots
   * higher than a $300B market cap, which is the wrong intuition.
   *
   * Fix: detect the magnitude split via the suffix in each source's
   * formatting block (' B' = 1e9, ' M' = 1e6, etc — see
   * magnitudeFromFormatting), then multiply each series' plotted v by
   * `mag / maxMag` so all values share the LARGEST-magnitude source's
   * unit. The y-axis tick formatter uses the largest-magnitude
   * source's formatting (e.g. ' B' suffix), so tick labels read as
   * "$300B" and the smaller series plots as essentially zero at the
   * bottom of the chart.
   *
   * Returns null when not applicable — single-source, rebase mode,
   * dual-axis mode, or all sources already share a magnitude. In those
   * cases callers preserve the existing branch behavior.
   *
   * Tooltips are unaffected: TipPoint.vRaw carries the un-scaled value
   * and the per-source `formatting` block formats it natively, so
   * hovering still reads "$700.00" and "$300.0 B" on the two series.
   */
  function rawAxisRescaleFor(payload: Payload): {
    scales: Map<string, number>;
    axisFormatting: Formatting;
  } | null {
    if (!payload.isMulti) return null;
    if (payload.normalize !== "raw") return null;
    if (payload.sources.length < 2) return null;
    const mags = payload.sources.map((s) => ({
      id: s.id,
      mag: magnitudeFromFormatting(s.formatting),
      fmt: s.formatting,
    }));
    const max = Math.max(...mags.map((m) => m.mag));
    const min = Math.min(...mags.map((m) => m.mag));
    if (max <= min) return null;
    const scales = new Map<string, number>();
    for (const m of mags) scales.set(m.id, m.mag / max);
    const top = mags.find((m) => m.mag === max)!;
    return { scales, axisFormatting: top.fmt };
  }

  function findPrior(points: Point[], targetMs: number): Point | null {
    if (points.length === 0) return null;
    if (new Date(points[0].t).getTime() > targetMs) return null;
    let best: Point = points[0];
    for (const p of points) {
      if (new Date(p.t).getTime() <= targetMs) best = p;
      else break;
    }
    return best;
  }

  // ---------- Dual-mode source readers (Phase 2) ----------
  //
  // The page payload ships either `points` (full timeseries) or `summary`
  // (precomputed latest + per-window priors + downsampled sparks) per
  // source. Tile-only code paths (initial readout, sparkline, tile
  // window-pill switch) should route through these helpers so they work
  // in either mode. Dialog-only code paths can read `points` directly —
  // by the time the dialog renders, the lazy-fetch below has populated
  // it on summary-only sources.

  /** Latest observation for `s`. */
  function tileCurrent(
    s: SourcePayload,
    fixed?: { start: string; end: string },
  ): Point | null {
    if (fixed) {
      // Fixed range: last point at-or-before `end`. Server guarantees
      // `points` is present when fixedRange is in effect.
      const pts = s.points;
      if (!pts) return null;
      const endMs = new Date(fixed.end).getTime();
      let best: Point | null = null;
      for (const p of pts) {
        const t = new Date(p.t).getTime();
        if (t <= endMs) best = p;
        else break;
      }
      return best;
    }
    if (s.summary) return s.summary.latest;
    const pts = s.points;
    if (!pts || pts.length === 0) return null;
    return pts[pts.length - 1];
  }

  /** Prior observation for the given trailing window (or fixed.start). */
  function tilePrior(
    s: SourcePayload,
    window: DeltaWindow,
    fixed?: { start: string; end: string },
  ): Point | null {
    if (fixed) {
      const pts = s.points;
      if (!pts) return null;
      const startMs = new Date(fixed.start).getTime();
      let best: Point | null = null;
      for (const p of pts) {
        const t = new Date(p.t).getTime();
        if (t <= startMs) best = p;
        else break;
      }
      return best;
    }
    if (s.summary) return s.summary.priors[window] ?? null;
    const pts = s.points;
    if (!pts || pts.length === 0) return null;
    const last = pts[pts.length - 1];
    const priorMs = windowStartMs(new Date(last.t).getTime(), window);
    return findPrior(pts, priorMs);
  }

  /**
   * Points to render the tile sparkline for the given window. In summary
   * mode this is the precomputed ~30-point downsample; in full mode it's
   * the live slice of the full series. Either way the returned points
   * are already trimmed to the visible range — callers don't need to
   * call visibleRange themselves.
   */
  function tileSparkPoints(
    s: SourcePayload,
    window: DeltaWindow,
    fixed?: { start: string; end: string },
  ): Point[] {
    return tileVisibleAndStart(s, window, fixed).visible;
  }

  /**
   * Same as tileSparkPoints, but also returns startMs — the timestamp
   * that should be treated as "window start" for rebase-baseline math.
   * In summary mode that's the first spark point's timestamp (close to
   * but not exactly the nominal window start, since sparks are
   * downsampled from real observations). In full mode it's the
   * theoretical window-start derived from the window key.
   */
  function tileVisibleAndStart(
    s: SourcePayload,
    window: DeltaWindow,
    fixed?: { start: string; end: string },
  ): { visible: Point[]; startMs: number } {
    if (fixed) {
      const pts = s.points;
      if (!pts) return { visible: [], startMs: 0 };
      return visibleRangeFixed(
        pts,
        new Date(fixed.start).getTime(),
        new Date(fixed.end).getTime(),
      );
    }
    const summarySpark = s.summary?.sparks[window];
    if (summarySpark && summarySpark.length > 0) {
      return {
        visible: summarySpark,
        // First spark point ≈ window start. Used as the rebase anchor;
        // for sparse series the exact value differs from windowStartMs
        // but that's already how renderSparkMulti's inline-rebase loop
        // works (it scans for the last point at-or-before startMs).
        startMs: new Date(summarySpark[0].t).getTime(),
      };
    }
    const pts = s.points;
    if (!pts) return { visible: [], startMs: 0 };
    return visibleRange(pts, window, 0);
  }

  /**
   * Points + start anchor + x-axis domain for the DIALOG'S full plot.
   *
   *  - Full mode (s.points present): 0.15 lead-in buffer at the left
   *    edge so the plot doesn't start abruptly at the window boundary.
   *  - Low-fidelity preview mode (s.points absent, summary present):
   *    use the precomputed ~30-point spark for this window so the
   *    dialog renders a recognizable chart shape immediately while
   *    the full-data fetch is in flight. Reads coarse but instant.
   *
   * `domainMs` is the canonical x-axis range that the HIGH-FI render
   * will use, returned in BOTH modes so the caller can pin Plot's
   * x.domain. Without this pinning, the low-fi x-axis fits to the
   * spark range (window-start → today) while the high-fi x-axis
   * extends 0.15 of the window earlier, so when the upgrade lands
   * the whole line appears to shift right within the plot area.
   * Pinning the domain instead means the upgrade just fills in the
   * empty pad on the left, without moving anything that's already
   * drawn.
   *
   * Caller is responsible for triggering a re-render once full points
   * arrive (see the dialog-open handler in hydrate()).
   */
  function dialogPlotPoints(
    s: SourcePayload,
    window: DeltaWindow,
    fixed?: { start: string; end: string },
  ): {
    visible: Point[];
    startMs: number;
    domainMs: [number, number] | null;
  } {
    if (fixed) {
      const fStart = new Date(fixed.start).getTime();
      const fEnd = new Date(fixed.end).getTime();
      if (!s.points) return { visible: [], startMs: 0, domainMs: null };
      const r = visibleRangeFixed(s.points, fStart, fEnd);
      return { ...r, domainMs: [fStart, fEnd] };
    }
    // For trailing windows, the high-fi x-axis runs from
    // (windowStart − leadInDays) to lastMs. Compute that anchor once
    // off the latest observation we have access to — full mode reads
    // the last point of s.points; low-fi mode reads the spark's last
    // point, which is the latest observation (sparks are right-aligned).
    const lastMsFromFull = s.points
      ? new Date(s.points[s.points.length - 1].t).getTime()
      : null;
    const spark = !s.points ? s.summary?.sparks[window] : undefined;
    const lastMsFromSpark =
      spark && spark.length > 0
        ? new Date(spark[spark.length - 1].t).getTime()
        : null;
    const lastMs = lastMsFromFull ?? lastMsFromSpark;
    let domainMs: [number, number] | null = null;
    if (lastMs !== null) {
      const winStart = windowStartMs(lastMs, window);
      const leadInMs =
        windowDays(window, new Date(lastMs)) * 86400000 * 0.15;
      domainMs = [winStart - leadInMs, lastMs];
    }

    if (s.points) {
      return { ...visibleRange(s.points, window, 0.15), domainMs };
    }
    if (!spark || spark.length === 0)
      return { visible: [], startMs: 0, domainMs: null };
    return {
      visible: spark,
      // Use the theoretical window start (not spark[0].t) so the dashed
      // window-boundary rule line lands at the same x in both renders.
      startMs: windowStartMs(lastMs!, window),
      domainMs,
    };
  }

  // ---------- Projections (Phase 2 of Forecast UI) ----------
  //
  // A source can ship forward-looking projections in two shapes:
  //   - Full mode: every vintage on `s.projections` (lex-max picked).
  //   - Summary mode: just the latest vintage on `s.summary.latestProjection`.
  // The lazy-fetch on dialog open hydrates `s.projections` from the full
  // file when present, so dialog renders always have all vintages.
  //
  // For Phase 2 we render the latest vintage only (no picker — that's
  // Phase 3). The dashed continuation begins at the last historical
  // point so the solid/dashed transition visually connects.

  /**
   * Return the dashed-line tail to draw for `s` after the last historical
   * point in `hist`, or null if there's nothing forward-looking to add.
   *
   * The returned `tail` includes the last historical point (`hist`'s
   * final entry) prepended, so the dashed Plot.lineY connects to the
   * solid line at the seam without a gap.
   */
  function projectionTail(
    s: SourcePayload,
    hist: Point[],
  ): { tail: Point[]; vintage: string } | null {
    let vintage: string | null = null;
    let projPts: Point[] | null = null;
    if (s.projections) {
      const keys = Object.keys(s.projections);
      if (keys.length > 0) {
        keys.sort();
        vintage = keys[keys.length - 1];
        projPts = s.projections[vintage];
      }
    } else if (s.summary?.latestProjection) {
      vintage = s.summary.latestProjection.vintage;
      projPts = s.summary.latestProjection.points;
    }
    if (!projPts || projPts.length === 0 || !vintage) return null;
    // Cutoff = last historical point's timestamp. We want STRICTLY-after
    // projection points (anything at or before is already on the solid
    // line and would just overdraw it).
    const lastHist = hist.length > 0 ? hist[hist.length - 1] : null;
    const cutoffMs = lastHist ? new Date(lastHist.t).getTime() : -Infinity;
    const forward = projPts.filter((p) => new Date(p.t).getTime() > cutoffMs);
    if (forward.length === 0) return null;
    const tail = lastHist ? [lastHist, ...forward] : forward;
    return { tail, vintage };
  }

  // ---------- Lazy-fetch of full points (Phase 2) ----------
  //
  // On dialog open we hydrate full `points` for any source that only has
  // `summary`. Module-scoped cache keyed by dataFile keeps repeated
  // open/close cycles instant — once a source's points are in memory
  // for the session, every subsequent fetch is a no-op.

  type FetchedFull = {
    points: Point[];
    projections?: ProjectionMap;
  };

  const fetchPromiseCache = new Map<string, Promise<FetchedFull | null>>();

  async function fetchFullPoints(dataFile: string): Promise<FetchedFull | null> {
    const cached = fetchPromiseCache.get(dataFile);
    if (cached) return cached;
    const p = (async () => {
      try {
        // Relative URL — same origin as the rendered page, so it
        // works for the production hostname, preview deploys, custom
        // domains, and local astro preview without any env detection.
        const res = await fetch(`/${dataFile}`);
        if (!res.ok) return null;
        const raw = (await res.json()) as
          | { points?: Point[]; projections?: ProjectionMap }
          | undefined;
        if (!raw?.points) return null;
        return raw.projections
          ? { points: raw.points, projections: raw.projections }
          : { points: raw.points };
      } catch {
        return null;
      }
    })();
    fetchPromiseCache.set(dataFile, p);
    return p;
  }

  /**
   * Ensures every source on the payload has `points` populated. No-op
   * for sources that already do (op'd / fixed-range / previously
   * fetched). Returns metrics for telemetry: how many sources were
   * fetched and the wall-clock time for the parallel batch.
   *
   * Also hydrates `projections` when present on the fetched payload —
   * the dialog plot can then show the full vintage history (Phase 3
   * picker uses this), and the dashed extension upgrade-renders from
   * the same source of truth that the tile used.
   */
  async function ensureAllFullPoints(
    payload: Payload,
  ): Promise<{ fetched: number; totalMs: number; failed: number }> {
    const need = payload.sources.filter(
      (s) => !s.points && s.dataFile,
    );
    if (need.length === 0) return { fetched: 0, totalMs: 0, failed: 0 };
    const t0 = performance.now();
    const results = await Promise.all(
      need.map((s) => fetchFullPoints(s.dataFile!)),
    );
    let failed = 0;
    for (let i = 0; i < need.length; i++) {
      const fetched = results[i];
      if (fetched) {
        need[i].points = fetched.points;
        if (fetched.projections) need[i].projections = fetched.projections;
      } else {
        failed += 1;
      }
    }
    return {
      fetched: need.length - failed,
      totalMs: Math.round(performance.now() - t0),
      failed,
    };
  }

  function directionWord(d: Direction): string {
    return d === "up" ? "up" : d === "down" ? "down" : "roughly unchanged";
  }

  // Minimal HTML escape — used when the dialog descriptor renderer
  // switched from textContent to innerHTML (to wrap the duration
  // token in a styleable span). The source name + formatted value
  // strings come from YAML/format.ts and aren't user input today,
  // but escaping keeps the path safe if a future source name picks
  // up a "&" or "<" character.
  const HTML_ESCAPES: Record<string, string> = {
    "&": "&amp;",
    "<": "&lt;",
    ">": "&gt;",
    '"': "&quot;",
    "'": "&#39;",
  };
  function escapeHtml(s: string): string {
    return s.replace(/[&<>"']/g, (c) => HTML_ESCAPES[c]);
  }

  // (Previously defined a standalone rebasePoints helper here; the
  // actual rebasing logic is inlined at the render site below since
  // it needs to thread through the same loop as bivariate / dual-axis
  // rescaling. Function removed to silence the unused-symbol hint.)

  // Tip-ready point: t as a Date (Plot's preferred time format), v as the
  // value the line actually plots (raw, rebased, or rescaled depending on
  // the chart's normalize mode), and vRaw as the original-units value so
  // hover tooltips can show "actual price" even when the line shows an
  // indexed or rescaled-to-the-other-axis value.
  type TipPoint = {
    t: Date;
    v: number;
    vRaw: number;
    iso: string;
  };

  /**
   * One series' contribution to the combined hover bundle: the source
   * (for label + formatting), the series's TipPoints in render order, and
   * any per-series quirks the title formatter needs to know about.
   */
  type BundleSeries = {
    source: SourcePayload;
    pts: TipPoint[];
    rebased?: boolean;
  };

  /**
   * One row of the combined-tip dataset: an x-time, a y-anchor (the mean
   * of all series' displayed values at this x, used so the tip floats up
   * and down with the chart instead of sitting at a fixed y), and the
   * pre-formatted lines that the tip box renders.
   */
  type Bundle = {
    t: Date;
    y: number;
    lines: string[];
  };

  /**
   * Build the combined-tip dataset: one row per x value in the union of
   * series, each row carrying the pre-formatted lines that the tip box
   * will render. We do the forward-fill (use the last point at or before
   * x) here so the tip mirrors how Plot draws the line between sparse
   * observations — important for charts that mix daily ETF prices with
   * annual GDP, where the GDP value should "carry through" to the next
   * year's observation, not vanish between data points.
   *
   * Doing this once at render time (instead of inside the title()
   * callback Plot invokes on every pointer move) keeps hover-update
   * cheap even on multi-source plots with hundreds of points.
   */
  function buildBundles(series: BundleSeries[]): Bundle[] {
    if (series.length === 0) return [];
    const allMs = new Set<number>();
    for (const s of series) for (const p of s.pts) allMs.add(p.t.getTime());
    const sorted = [...allMs].sort((a, b) => a - b);
    return sorted.map((xMs) => {
      const t = new Date(xMs);
      const lines: string[] = [formatDate(t.toISOString())];
      // Collect the displayed y values for each series at this x so we can
      // place the tip near the cluster of actual data instead of at a fixed
      // height. This is what makes the tip "follow" the chart as you scrub.
      const ys: number[] = [];
      for (const s of series) {
        let best: TipPoint | null = null;
        for (const p of s.pts) {
          if (p.t.getTime() <= xMs) best = p;
          else break;
        }
        if (!best) continue;
        ys.push(best.v);
        const label = s.source.shortName || s.source.name;
        const rawStr = formatValue(best.vRaw, s.source.formatting);
        // For rebased lines, also show the on-axis index so the value
        // ties to what the user sees on the y-axis.
        const indexStr = s.rebased
          ? `  ·  index ${best.v.toFixed(1)}`
          : "";
        lines.push(`${label}: ${rawStr}${indexStr}`);
      }
      const y =
        ys.length > 0 ? ys.reduce((a, b) => a + b, 0) / ys.length : 0;
      return { t, y, lines };
    });
  }

  /**
   * Final string handed to Plot.tip's `title` channel. Optionally prepends
   * an affordance hint (e.g. "Click to zoom in") above the data lines.
   */
  function bundleTitle(b: Bundle, hint?: string | null): string {
    return hint ? `${hint}\n${b.lines.join("\n")}` : b.lines.join("\n");
  }

  // Shared tip-mark styling. Inline so Plot's tip box font matches the rest
  // of the plot chrome — without this it falls back to the SVG defaults
  // (Helvetica) and looks foreign next to our Inter axes.
  const TIP_STYLE = {
    fill: "#fefefe",
    stroke: "#dcdcda",
    fontFamily:
      '"Inter Variable", Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif',
    fontSize: 12,
  };

  /**
   * Singleton HTML hover-card for the dialog plot.
   *
   * Plot's built-in tip mark is rendered as SVG <g> inside the plot's
   * <svg>, which means it's bounded by the SVG viewport AND by every
   * ancestor with overflow: hidden (notably .dialog-body's
   * overflow-y: auto on a scrollable dialog). On multi-source charts
   * — energy futures curves, country baskets, sector rollups — the
   * tip listing all series at the hovered x grows taller than fits
   * either above or below the cursor inside the plot frame, and the
   * bottom lines get clipped. The user can't see Brazil's GDP because
   * the tip overflows the plot's bottom edge and dialog-body cuts it.
   *
   * Solving via SVG `overflow: visible` is insufficient — the tip
   * still gets clipped by dialog-body's scroll container. The only
   * clean fix is to render the hover-card as an HTML element attached
   * to document.body with position: fixed, escaping the SVG +
   * dialog-body chain entirely. It can be as tall as the series list
   * needs, and it block out whatever's underneath (per design intent:
   * the hover-card is the most mobile element and should not be
   * subordinated to the chart frame's bounds).
   *
   * Singleton: one card serves every dialog plot on the page. Plot.tip
   * still drives tile sparklines (which fit in the tile's overflow:
   * visible spillover area), so this card only shows on dialog hover.
   *
   * pointer-events: none → never intercepts hover detection on the
   * underlying chart.
   *
   * Top-layer note: `<dialog showModal()>` puts the dialog in the
   * browser's TOP LAYER, which renders above all normal-flow z-indexed
   * content — including this card if it lives on document.body. So
   * z-index alone wasn't enough: the card came up BEHIND the dialog
   * backdrop, clipped at the dialog edges (user-visible regression:
   * hovering on a multi-series dialog plot showed the right half of
   * the country-value listing cut off at the dialog border).
   *
   * The fix is to re-parent the card to the active dialog on each
   * update — children of a top-layer element render in that same
   * top layer. Falls back to document.body when no dialog is open
   * (welcome-page in-flow embeds, source-page tiles, etc.).
   */
  let _hoverCardEl: HTMLDivElement | null = null;
  function getHoverCard(): HTMLDivElement {
    if (_hoverCardEl) return _hoverCardEl;
    const el = document.createElement("div");
    el.className = "chart-hover-card";
    el.setAttribute("role", "tooltip");
    el.setAttribute("aria-hidden", "true");
    el.hidden = true;
    document.body.appendChild(el);
    _hoverCardEl = el;
    return el;
  }

  /**
   * Pick the right parent for the hover-card. If a `<dialog>` is
   * open via showModal(), re-parent the card INTO the dialog so it
   * joins the dialog's top-layer stacking context. Otherwise leave
   * it on document.body where position: fixed + a very high z-index
   * suffices to paint above the page.
   */
  function reparentHoverCard(card: HTMLDivElement): void {
    // querySelector("dialog[open]") catches both <dialog open> and
    // a dialog opened via showModal() (which sets the open attribute).
    // Multiple-open is rare; pick the LAST one matched, which by DOM
    // order is the most recently injected / on-top dialog.
    const dialogs = document.querySelectorAll<HTMLDialogElement>("dialog[open]");
    const target = dialogs.length > 0 ? dialogs[dialogs.length - 1] : document.body;
    if (card.parentNode !== target) {
      target.appendChild(card);
    }
  }

  function updateHoverCard(
    lines: string[],
    cursorClientX: number,
    cursorClientY: number,
  ): void {
    const card = getHoverCard();
    // Re-parent into the active dialog (if any) so the card paints
    // in the dialog's top layer rather than behind it. No-op when
    // already in the right place.
    reparentHoverCard(card);
    // Rebuild rows: first line is the date header, rest are
    // "Series: value" rows. Plain text — bundleTitle already does
    // the formatting and we just want each line on its own row.
    while (card.firstChild) card.removeChild(card.firstChild);
    for (let i = 0; i < lines.length; i++) {
      const row = document.createElement("div");
      row.className =
        i === 0 ? "chart-hover-row chart-hover-date" : "chart-hover-row";
      row.textContent = lines[i];
      card.appendChild(row);
    }
    card.hidden = false;
    // Position with viewport-edge flipping. Default places the card
    // to the bottom-right of the cursor; if it would extend past the
    // viewport, flip to the other side. Measure AFTER setting
    // content (offsetWidth/Height reflect current rendering).
    const offset = 14;
    const margin = 8;
    const vw = window.innerWidth;
    const vh = window.innerHeight;
    // Reset to top-left first so offsetWidth/Height reflect the
    // natural unconstrained size, not the previous frame's clipped
    // size.
    card.style.left = "0px";
    card.style.top = "0px";
    const cw = card.offsetWidth;
    const ch = card.offsetHeight;
    let x = cursorClientX + offset;
    let y = cursorClientY + offset;
    if (x + cw > vw - margin) x = cursorClientX - offset - cw;
    if (y + ch > vh - margin) y = cursorClientY - offset - ch;
    if (x < margin) x = margin;
    if (y < margin) y = margin;
    card.style.left = `${x}px`;
    card.style.top = `${y}px`;
  }

  function hideHoverCard(): void {
    if (_hoverCardEl) _hoverCardEl.hidden = true;
  }

  /**
   * Wire pointermove on a dialog plot container to drive the
   * HTML hover-card. The bundles + domain + plot margins live in a
   * per-container state object that renderFullPlot replaces on each
   * re-render (window pill click, zoom gesture, etc.) — we only
   * attach the DOM listeners ONCE per container even though the
   * underlying SVG gets swapped repeatedly via container.replaceChildren.
   *
   * Snapping math: convert cursor.clientX → fraction of the plot's
   * data area (between marginLeft and width - marginRight) →
   * domain time → nearest bundle by t. Cheap linear scan since
   * bundles is at most a few hundred points.
   *
   * pointerleave hides the card. We DON'T listen on pointerout — that
   * fires on every child swap inside the SVG (axes redrawing, etc.)
   * and would flicker the card off as the user moves between marks.
   */
  type HoverWireState = {
    bundles: Bundle[];
    domainMs: [number, number] | null;
    marginLeft: number;
    marginRight: number;
  };
  type WiredHoverContainer = HTMLElement & {
    _tapeHoverState?: HoverWireState;
    _tapeHoverBound?: boolean;
  };
  function wireHoverCard(
    container: HTMLElement,
    state: HoverWireState,
  ): void {
    const wired = container as WiredHoverContainer;
    wired._tapeHoverState = state;
    if (wired._tapeHoverBound) return;
    wired._tapeHoverBound = true;

    function nearestBundle(clientX: number): Bundle | null {
      const s = wired._tapeHoverState;
      if (!s || s.bundles.length === 0 || !s.domainMs) return null;
      const svg = container.querySelector("svg");
      if (!svg) return null;
      const rect = svg.getBoundingClientRect();
      const innerLeft = rect.left + s.marginLeft;
      const innerWidth = rect.width - s.marginLeft - s.marginRight;
      if (innerWidth <= 0) return null;
      const frac = (clientX - innerLeft) / innerWidth;
      // Allow a tiny over-extension on either side so the tip
      // doesn't flicker off when the cursor is exactly on the
      // axis line.
      if (frac < -0.02 || frac > 1.02) return null;
      const span = s.domainMs[1] - s.domainMs[0];
      const target = s.domainMs[0] + frac * span;
      let best: Bundle | null = null;
      let bestDist = Infinity;
      for (const b of s.bundles) {
        const d = Math.abs(b.t.getTime() - target);
        if (d < bestDist) {
          bestDist = d;
          best = b;
        }
      }
      return best;
    }

    function onMove(e: PointerEvent): void {
      // During pan/pinch the data is sliding under the cursor; the
      // tip flickers. The gesture handler toggles "gesture-active"
      // on the container — we mirror the existing Plot.tip
      // suppression by hiding the HTML card too.
      if (container.classList.contains("gesture-active")) {
        hideHoverCard();
        return;
      }
      const b = nearestBundle(e.clientX);
      if (!b) {
        hideHoverCard();
        return;
      }
      updateHoverCard(b.lines, e.clientX, e.clientY);
    }
    function onLeave(): void {
      hideHoverCard();
    }
    container.addEventListener("pointermove", onMove, { passive: true });
    container.addEventListener("pointerleave", onLeave);
  }

  function visibleRange(
    points: Point[],
    window: DeltaWindow,
    leadIn = 0.15,
  ): { visible: Point[]; startMs: number } {
    const last = points[points.length - 1];
    const lastMs = new Date(last.t).getTime();
    // YTD anchors to Jan 1; trailing windows just subtract DELTA_DAYS.
    // windowStartMs encapsulates that decision.
    const startMs = windowStartMs(lastMs, window);
    // Lead-in buffer scales with the *actual* visible window length, so a
    // YTD plot on Jan 15 gets a tiny lead-in instead of half a year of it.
    const visibleStart = startMs - windowDays(window, new Date(lastMs)) * 86400000 * leadIn;
    const visible = points.filter(
      (p) => new Date(p.t).getTime() >= visibleStart,
    );
    return { visible, startMs };
  }

  // Same shape as visibleRange but driven by a fixed [start, end] range.
  // No lead-in buffer at the trailing edge — we want the rendered window
  // to end exactly at `end`, even if the source has more recent points.
  function visibleRangeFixed(
    points: Point[],
    startMs: number,
    endMs: number,
  ): { visible: Point[]; startMs: number } {
    const visible = points.filter((p) => {
      const t = new Date(p.t).getTime();
      return t >= startMs && t <= endMs;
    });
    return { visible, startMs };
  }

  function renderSparkSingle(
    container: HTMLElement,
    source: SourcePayload,
    window: DeltaWindow,
    fixed?: { start: string; end: string },
    shading?: ShadingKey[],
  ): void {
    // tileSparkPoints handles both summary (precomputed) and full (live
    // slice) modes — the returned array is already trimmed to the window.
    const visible = tileSparkPoints(source, window, fixed);
    if (visible.length < 2) return;

    const width = container.clientWidth || 220;
    // Container height is driven by CSS so multi-series cards can grow
    // taller — see .chart-tile-multi[data-series-count] rules in Chart.astro.
    const height = container.clientHeight || 36;
    // Build TipPoints + a one-series bundle so the tile gets the same
    // hover-to-read-value affordance as the dialog. Cheap (one source's
    // points already in memory).
    const pts: TipPoint[] = visible.map((p) => ({
      t: new Date(p.t),
      v: p.v,
      vRaw: p.v,
      iso: p.t,
    }));
    const bundles = buildBundles([{ source, pts }]);
    // Phase 2 projection: dashed forward extension on the sparkline so
    // the tile previews the same forecast shape the dialog will show.
    // For futures-curve sources, this IS the headline information.
    const sparkMarks: any[] = [];
    // Shading goes BEFORE the line so the band is rendered behind it.
    // Clip to the visible window for the tile sparkline so a 1y view
    // doesn't paint 80 years of background context.
    if (pts.length > 0) {
      sparkMarks.push(
        ...shadingMarks(shading, pts[0].t, pts[pts.length - 1].t),
      );
    }
    sparkMarks.push(
      Plot.lineY(pts, {
        x: "t",
        y: "v",
        stroke: source.color,
        strokeWidth: 1.5,
      }),
    );
    const sparkTail = projectionTail(source, visible);
    if (sparkTail) {
      const projPts = sparkTail.tail.map((p) => ({ t: new Date(p.t), v: p.v }));
      sparkMarks.push(
        Plot.lineY(projPts, {
          x: "t",
          y: "v",
          stroke: source.color,
          strokeWidth: 1.25,
          strokeDasharray: "4,2.5",
          strokeOpacity: 0.65,
        }),
      );
    }
    if (bundles.length > 0) {
      sparkMarks.push(
        Plot.tip(
          bundles,
          Plot.pointerX({
            x: "t",
            // Anchor the tip's y to the bundle's mean displayed-y so
            // it floats up/down with the chart line instead of sitting
            // at a fixed vertical position. Plot's auto anchor logic
            // then picks above/below based on available space, so the
            // tip naturally avoids covering the line cluster.
            y: "y",
            title: (b: Bundle) => bundleTitle(b, TILE_HINT),
            ...TIP_STYLE,
          }),
        ),
      );
    }
    const plot = Plot.plot({
      height,
      width,
      axis: null,
      marginLeft: 0,
      marginRight: 0,
      marginTop: 2,
      marginBottom: 2,
      marks: sparkMarks,
    });
    container.replaceChildren(plot);
  }

  function renderSparkMulti(
    container: HTMLElement,
    payload: Payload,
    window: DeltaWindow,
  ): void {
    const fixed = payload.fixedRange;
    const width = container.clientWidth || 220;
    // Spark height is driven by CSS (.chart-tile-multi[data-series-count])
    // so cards with more legend rows naturally grow a taller sparkline.
    const height = container.clientHeight || 48;

    // Dual-axis: rescale every right-axis series to fit the left axis's
    // domain so both groups render legibly in the spark. (No axis labels;
    // sparks are axis-less anyway.)
    if (
      payload.normalize === "dual-axis" &&
      payload.sources.length >= 2
    ) {
      const explicit = payload.rightAxisSources ?? [];
      const rightSet = new Set(
        explicit.length > 0
          ? explicit
          : payload.sources.slice(1).map((s) => s.id),
      );
      const matLeft = payload.sources
        .filter((s) => !rightSet.has(s.id))
        .map((s) => {
          const eff = closestSupported(window, s.supportedDeltas);
          const { visible } = tileVisibleAndStart(s, eff, fixed);
          return { s, visible };
        });
      const matRight = payload.sources
        .filter((s) => rightSet.has(s.id))
        .map((s) => {
          const eff = closestSupported(window, s.supportedDeltas);
          const { visible } = tileVisibleAndStart(s, eff, fixed);
          return { s, visible };
        });
      const haveLeft = matLeft.some((m) => m.visible.length >= 2);
      const haveRight = matRight.some((m) => m.visible.length >= 2);
      if (haveLeft && haveRight) {
        const flatL = matLeft.flatMap((m) => m.visible.map((p) => p.v));
        const flatR = matRight.flatMap((m) => m.visible.map((p) => p.v));
        const lMin = Math.min(...flatL);
        const lMax = Math.max(...flatL);
        const rMin = Math.min(...flatR);
        const rMax = Math.max(...flatR);
        const dL = lMax - lMin || 1;
        const dR = rMax - rMin || 1;
        const rescaleR = (v: number) => lMin + ((v - rMin) / dR) * dL;
        const dualMarks: any[] = [];
        const dualBundleSeries: BundleSeries[] = [];
        for (const m of matLeft) {
          if (m.visible.length < 2) continue;
          const pts: TipPoint[] = m.visible.map((p) => ({
            t: new Date(p.t),
            v: p.v,
            vRaw: p.v,
            iso: p.t,
          }));
          dualMarks.push(
            Plot.lineY(pts, {
              x: "t",
              y: "v",
              stroke: m.s.color,
              strokeWidth: 1.25,
            }),
          );
          dualBundleSeries.push({ source: m.s, pts });
        }
        for (const m of matRight) {
          if (m.visible.length < 2) continue;
          const pts: TipPoint[] = m.visible.map((p) => ({
            t: new Date(p.t),
            v: rescaleR(p.v),
            vRaw: p.v,
            iso: p.t,
          }));
          dualMarks.push(
            Plot.lineY(pts, {
              x: "t",
              y: "v",
              stroke: m.s.color,
              strokeWidth: 1.25,
            }),
          );
          dualBundleSeries.push({ source: m.s, pts });
        }
        const dualBundles = buildBundles(dualBundleSeries);
        if (dualBundles.length > 0) {
          dualMarks.push(
            Plot.tip(
              dualBundles,
              Plot.pointerX({
                x: "t",
                y: "y",
                title: (b: Bundle) => bundleTitle(b, TILE_HINT),
                ...TIP_STYLE,
              }),
            ),
          );
        }
        const dualPlot = Plot.plot({
          height,
          width,
          axis: null,
          marginLeft: 0,
          marginRight: 0,
          marginTop: 2,
          marginBottom: 2,
          marks: dualMarks,
        });
        container.replaceChildren(dualPlot);
        return;
      }
      // Degenerate split (one side empty) — fall through to non-dual branch.
    }

    const marks: any[] = [];
    const sparkBundles: BundleSeries[] = [];
    // Shading goes first so bands render BEHIND the line marks. Domain
    // bounds derived later inside the source loop — we use the FIRST
    // populated visible[] to set the bounds since all sources share
    // the same x-window in non-dual sparklines.
    let sparkDomainStart: Date | null = null;
    let sparkDomainEnd: Date | null = null;
    // Mixed-magnitude rescale: applied in raw mode when the chart's
    // sources span unit magnitudes (e.g. share price + market cap).
    // See rawAxisRescaleFor for the contract; null in rebase / dual /
    // single-source / same-magnitude cases.
    const sparkRescale = rawAxisRescaleFor(payload);
    for (const s of payload.sources) {
      const eff = closestSupported(window, s.supportedDeltas);
      // tileVisibleAndStart returns either the precomputed summary spark
      // (already trimmed to the window) or a live slice of the full
      // series, with the startMs that should anchor the rebase baseline.
      const { visible, startMs } = tileVisibleAndStart(s, eff, fixed);
      if (visible.length < 2) continue;
      // Inline the rebase math so the TipPoint keeps both raw + plotted v.
      let baseline = visible[0].v;
      for (const p of visible) {
        if (new Date(p.t).getTime() <= startMs) baseline = p.v;
        else break;
      }
      const useRebase = payload.normalize === "rebase" && baseline !== 0;
      const axisScale = sparkRescale?.scales.get(s.id) ?? 1;
      const pts: TipPoint[] = visible.map((p) => ({
        t: new Date(p.t),
        v: useRebase ? (p.v / baseline) * 100 : p.v * axisScale,
        vRaw: p.v,
        iso: p.t,
      }));
      if (sparkDomainStart === null) sparkDomainStart = pts[0].t;
      const tEnd = pts[pts.length - 1].t;
      if (sparkDomainEnd === null || tEnd.getTime() > sparkDomainEnd.getTime()) {
        sparkDomainEnd = tEnd;
      }
      marks.push(
        Plot.lineY(pts, {
          x: "t",
          y: "v",
          stroke: s.color,
          strokeWidth: 1.25,
        }),
      );
      sparkBundles.push({ source: s, pts, rebased: useRebase });
    }
    // Prepend shading marks so they paint behind the lines we just
    // pushed. (Splice-at-0 keeps the existing mark order otherwise.)
    if (marks.length > 0) {
      const sh = shadingMarks(payload.shading, sparkDomainStart, sparkDomainEnd);
      if (sh.length > 0) marks.unshift(...sh);
    }
    const bundles = buildBundles(sparkBundles);
    if (bundles.length > 0) {
      marks.push(
        Plot.tip(
          bundles,
          Plot.pointerX({
            x: "t",
            y: "y",
            title: (b: Bundle) => bundleTitle(b, TILE_HINT),
            ...TIP_STYLE,
          }),
        ),
      );
    }
    const plot = Plot.plot({
      height,
      width,
      axis: null,
      marginLeft: 0,
      marginRight: 0,
      marginTop: 2,
      marginBottom: 2,
      // Honor the chart's log-scale flag here as well so the sparkline shape
      // matches what the dialog shows. The dual-axis branch above returns
      // before reaching this code path, so we don't need to gate on normalize.
      y: payload.scale === "log" ? { type: "log" } : undefined,
      marks,
    });
    container.replaceChildren(plot);
  }

  function renderFullPlot(
    container: HTMLElement,
    payload: Payload,
    window: DeltaWindow,
    zoomedDomainMs?: [number, number] | null,
  ): void {
    const width = container.clientWidth || 700;

    // Note: renderFullPlot is called both for the low-fidelity preview
    // (from summary.sparks, while the full-data fetch is in flight) and
    // for the high-fidelity upgrade (after fetch resolves). The
    // dialogPlotPoints helper handles both transparently: full points
    // when available, otherwise the window's precomputed spark.

    // Dual-axis: at least 2 sources, partition into left and right groups
    // by rightAxisSources (or default = first source left, rest right).
    if (
      payload.normalize === "dual-axis" &&
      payload.sources.length >= 2
    ) {
      const explicit = payload.rightAxisSources ?? [];
      const rightSet = new Set(
        explicit.length > 0
          ? explicit
          : payload.sources.slice(1).map((s) => s.id),
      );
      const leftSrcs = payload.sources.filter((s) => !rightSet.has(s.id));
      const rightSrcs = payload.sources.filter((s) => rightSet.has(s.id));
      // Need at least one series on each side; otherwise fall through to the
      // generic non-dual-axis branch below.
      if (leftSrcs.length > 0 && rightSrcs.length > 0) {
        const fixed = payload.fixedRange;
        // Materialize visible ranges per source. dialogPlotPoints reads
        // full points when available (0.15 lead-in), otherwise falls
        // back to the precomputed summary spark for this window — the
        // low-fidelity preview path. domainMs is the canonical x range
        // we'll pin so the upgrade doesn't shift the line laterally.
        const matLeft = leftSrcs.map((s) => {
          const eff = closestSupported(window, s.supportedDeltas);
          return { s, ...dialogPlotPoints(s, eff, fixed) };
        });
        const matRight = rightSrcs.map((s) => {
          const eff = closestSupported(window, s.supportedDeltas);
          return { s, ...dialogPlotPoints(s, eff, fixed) };
        });
        // x.domain pinning: any source's domainMs works since they're
        // computed from the same window. Multi-source spread (one
        // source lags another by a few days) → up to a one-day x-axis
        // discrepancy, visually negligible.
        const dualDomainMs =
          matLeft.find((m) => m.domainMs)?.domainMs ??
          matRight.find((m) => m.domainMs)?.domainMs ??
          null;
        const haveLeft = matLeft.some((m) => m.visible.length >= 2);
        const haveRight = matRight.some((m) => m.visible.length >= 2);
        if (haveLeft && haveRight) {
          const flatL = matLeft.flatMap((m) => m.visible.map((p) => p.v));
          const flatR = matRight.flatMap((m) => m.visible.map((p) => p.v));
          const lMin = Math.min(...flatL);
          const lMax = Math.max(...flatL);
          const rMin = Math.min(...flatR);
          const rMax = Math.max(...flatR);
          const dL = lMax - lMin || 1;
          const dR = rMax - rMin || 1;
          const rescaleR = (v: number) => lMin + ((v - rMin) / dR) * dL;
          const unscaleR = (yPos: number) =>
            rMin + ((yPos - lMin) / dL) * dR;
          const marks: any[] = [];
          // Shading goes first so it paints BEHIND the lines pushed below.
          if (dualDomainMs) {
            marks.push(
              ...shadingMarks(
                payload.shading,
                new Date(dualDomainMs[0]),
                new Date(dualDomainMs[1]),
              ),
            );
          }
          // Per-series TipPoints collected into a single bundle so the tip
          // box can show all series' values at the hovered x in one box,
          // rather than four overlapping boxes (the previous bug).
          const bundleSeries: BundleSeries[] = [];
          for (const m of matLeft) {
            if (m.visible.length < 2) continue;
            // Left-axis values plot at their natural scale, so v === vRaw.
            // Carrying vRaw uniformly across both sides lets the same tip
            // builder format either side without branching.
            const pts: TipPoint[] = m.visible.map((p) => ({
              t: new Date(p.t),
              v: p.v,
              vRaw: p.v,
              iso: p.t,
            }));
            marks.push(
              Plot.lineY(pts, {
                x: "t",
                y: "v",
                stroke: m.s.color,
                strokeWidth: 1.75,
              }),
              Plot.dot(pts.slice(-1), {
                x: "t",
                y: "v",
                fill: m.s.color,
                r: 3.5,
              }),
            );
            bundleSeries.push({ source: m.s, pts });
          }
          for (const m of matRight) {
            if (m.visible.length < 2) continue;
            // Right-axis values are rescaled into the left axis's range so
            // both series share one y-domain. vRaw preserves the raw value
            // so the hover tip shows the real number, not the rescaled one.
            const pts: TipPoint[] = m.visible.map((p) => ({
              t: new Date(p.t),
              v: rescaleR(p.v),
              vRaw: p.v,
              iso: p.t,
            }));
            marks.push(
              Plot.lineY(pts, {
                x: "t",
                y: "v",
                stroke: m.s.color,
                strokeWidth: 1.75,
              }),
              Plot.dot(pts.slice(-1), {
                x: "t",
                y: "v",
                fill: m.s.color,
                r: 3.5,
              }),
            );
            bundleSeries.push({ source: m.s, pts });
          }
          const dualBundles = buildBundles(bundleSeries);
          if (dualBundles.length > 0) {
            // See standard-branch comment + getHoverCard doc: tip
            // moved to an HTML card outside the SVG. Keep a vertical
            // guide line for the snap cue.
            marks.push(
              Plot.ruleX(
                dualBundles,
                Plot.pointerX({
                  x: "t",
                  stroke: "#1c1c1a",
                  strokeOpacity: 0.3,
                  strokeWidth: 1,
                }),
              ),
            );
          }
          // Axis colors: when only one series on a side, color the axis to
          // match. With multiple, keep neutral so it doesn't claim allegiance.
          const leftAxisColor =
            leftSrcs.length === 1 ? leftSrcs[0].color : "#55524C";
          const rightAxisColor =
            rightSrcs.length === 1 ? rightSrcs[0].color : "#55524C";
          // Tick formatting picks formatting from the single side-source if
          // unique, otherwise just compact numeric.
          const leftFmt = leftSrcs[0]?.formatting;
          const rightFmt = rightSrcs[0]?.formatting;
          marks.push(
            Plot.axisY({
              anchor: "left",
              color: leftAxisColor,
              ticks: 5,
              tickFormat: (v: number) =>
                formatValue(v, { ...leftFmt, decimals: 1 }),
            }),
            Plot.axisY({
              anchor: "right",
              color: rightAxisColor,
              ticks: 5,
              tickFormat: (v: number) =>
                formatValue(unscaleR(v), { ...rightFmt, decimals: 1 }),
            }),
          );
          const plot = Plot.plot({
            height: 280,
            width,
            marginLeft: 64,
            marginBottom: 28,
            marginTop: 10,
            marginRight: 64,
            style: {
              fontFamily:
                '"Inter Variable", Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif',
              fontSize: "12px",
              color: "#55524C",
              background: "transparent",
            },
            x: dualDomainMs
              ? {
                  label: null,
                  ticks: 5,
                  domain: [new Date(dualDomainMs[0]), new Date(dualDomainMs[1])],
                }
              : { label: null, ticks: 5 },
            y: { label: null, grid: true, ticks: 5 },
            marks,
          });
          container.replaceChildren(plot);
          // HTML hover-card wiring. Bundles + domain power the
          // pointermove-driven multi-series listing that replaced
          // the SVG-bound Plot.tip on this branch. Margins match
          // the Plot.plot config above (64 left + 64 right for the
          // two y-axes).
          wireHoverCard(container, {
            bundles: dualBundles,
            domainMs: dualDomainMs,
            marginLeft: 64,
            marginRight: 64,
          });
          return;
        }
      }
      // If we get here, the dual-axis split was degenerate; fall through.
    }

    const marks: any[] = [];
    let dashStartDrawn = false;
    const fixed = payload.fixedRange;
    // Active y-axis transform. Defaults to "level" when unset. Applied
    // BEFORE rebase/rescale/log so the rest of the pipeline operates on
    // post-transform values.
    const transform: TransformKey = payload.transform ?? "level";
    const transformActive = transform !== "level";
    // rebaseMode = the existing multi-source "rebase to 100 at window
    // start" path. Skip when transform="index_100" (the transform IS
    // a rebase already; running both would double-rebase to 100 and
    // produce a meaningless flat line). transform="yoy_pct" doesn't
    // conflict — yoy_pct produces a percentage series that we just
    // plot at face value.
    const rebaseMode =
      payload.normalize === "rebase" &&
      payload.isMulti &&
      transform !== "index_100";
    // Mixed-magnitude raw-mode rescale. Null in rebase/dual-axis/
    // single-source/same-magnitude cases. See rawAxisRescaleFor.
    // Skip the rescale entirely when a transform is active — the
    // transformed values are in their own unit (%/index), so the
    // mixed-magnitude rescaler doesn't apply.
    const fullRescale = transformActive ? null : rawAxisRescaleFor(payload);
    const bundleSeries: BundleSeries[] = [];
    let standardDomainMs: [number, number] | null = null;
    for (const s of payload.sources) {
      const eff = closestSupported(window, s.supportedDeltas);
      // dialogPlotPoints: full-data slice when present (0.15 lead-in),
      // otherwise the precomputed summary spark for this window. The
      // low-fi preview path renders coarse but instantly. domainMs
      // is the canonical x-axis range — same value in both modes —
      // which we pin on Plot.plot below so a low→high upgrade doesn't
      // shift the line within the plot area.
      const rawSlice = dialogPlotPoints(s, eff, fixed);
      const visible = transformActive
        ? applyTransform(
            rawSlice.visible.map((p) => ({ t: p.t, v: p.v })),
            transform,
          )
        : rawSlice.visible;
      const startMs = rawSlice.startMs;
      const domainMs = rawSlice.domainMs;
      if (!standardDomainMs && domainMs) standardDomainMs = domainMs;
      if (visible.length < 2) continue;
      // Compute rebase baseline up-front (same logic as rebasePoints, inlined
      // so we can build TipPoints that carry both rebased v and raw vRaw in
      // a single pass — the hover tip wants raw values).
      let baseline = visible[0].v;
      for (const p of visible) {
        if (new Date(p.t).getTime() <= startMs) baseline = p.v;
        else break;
      }
      const useRebase = rebaseMode && baseline !== 0;
      const axisScale = fullRescale?.scales.get(s.id) ?? 1;
      const pts: TipPoint[] = visible.map((p) => ({
        t: new Date(p.t),
        v: useRebase ? (p.v / baseline) * 100 : p.v * axisScale,
        vRaw: p.v,
        iso: p.t,
      }));
      if (!dashStartDrawn) {
        marks.push(
          Plot.ruleX([new Date(startMs)], {
            stroke: "#DCDCDA",
            strokeDasharray: "3,3",
          }),
        );
        dashStartDrawn = true;
      }
      marks.push(
        Plot.lineY(pts, {
          x: "t",
          y: "v",
          stroke: s.color,
          strokeWidth: 1.75,
        }),
        Plot.dot(pts.slice(-1), {
          x: "t",
          y: "v",
          fill: s.color,
          r: 3.5,
        }),
      );
      // Forecast UI Phase 2: render the latest projection vintage as a
      // dashed continuation past the last historical point. Apply the
      // same rebase divisor used for the solid line so multi-source
      // rebased plots stay self-consistent. Skipped when a y-axis
      // transform is active — projecting a YoY rate or an index
      // forward from raw-level projection points produces visual
      // discontinuities; punt to v2 when there's a use case.
      const tail = transformActive ? null : projectionTail(s, visible);
      if (tail) {
        const projPts: TipPoint[] = tail.tail.map((p) => ({
          t: new Date(p.t),
          v: useRebase ? (p.v / baseline) * 100 : p.v * axisScale,
          vRaw: p.v,
          iso: p.t,
        }));
        marks.push(
          Plot.lineY(projPts, {
            x: "t",
            y: "v",
            stroke: s.color,
            strokeWidth: 1.5,
            strokeDasharray: "5,3",
            strokeOpacity: 0.7,
          }),
        );
        // Extend the canonical x-domain to include the latest projection
        // date so the dashed tail actually fits in the plot frame.
        const lastProjMs = projPts[projPts.length - 1].t.getTime();
        if (standardDomainMs && lastProjMs > standardDomainMs[1]) {
          standardDomainMs = [standardDomainMs[0], lastProjMs];
        }
      }
      bundleSeries.push({ source: s, pts, rebased: useRebase });
    }
    // Prepend shading marks so they paint BEHIND the line marks already
    // pushed. Domain bounds derived from standardDomainMs (which spans
    // the visible window incl. any projection-tail extension).
    if (marks.length > 0 && standardDomainMs) {
      const sh = shadingMarks(
        payload.shading,
        new Date(standardDomainMs[0]),
        new Date(standardDomainMs[1]),
      );
      if (sh.length > 0) marks.unshift(...sh);
    }
    // Append annotation marks AFTER the line marks so labels +
    // vertical guides paint ON TOP of the chart. Annotations are
    // editorial overlays — they should be the last thing the
    // reader's eye lands on.
    if (standardDomainMs) {
      const annMarks = annotationMarks(
        payload.annotations,
        new Date(standardDomainMs[0]),
        new Date(standardDomainMs[1]),
      );
      if (annMarks.length > 0) marks.push(...annMarks);
    }
    // "Annotations outside the visible window" hint. annotationMarks
    // silently drops off-window annotations so labels don't draw
    // outside the plot frame — without a note, the user who typed
    // "2008-09-15: Lehman" on a 1y window sees nothing and assumes
    // the feature is broken. Surface the count + suggest the smallest
    // standard window that would cover every annotation.
    if (standardDomainMs) {
      updateAnnotationsHiddenNotice(
        container,
        payload.annotations,
        standardDomainMs,
        payload.supportedDeltas,
      );
    }
    const bundles = buildBundles(bundleSeries);
    if (bundles.length > 0) {
      // Vertical guide line at the hovered x — the visual snap cue.
      // Replaces Plot.tip's SVG box, which on multi-series plots
      // grew taller than fits inside the plot frame and got clipped
      // at the bottom. The full series-listing now lives in an
      // HTML hover-card rendered to <body> (see wireHoverCard
      // below + getHoverCard helper above), so it can extend as
      // tall as needed without being trapped by the chart frame.
      marks.push(
        Plot.ruleX(
          bundles,
          Plot.pointerX({
            x: "t",
            stroke: "#1c1c1a",
            strokeOpacity: 0.3,
            strokeWidth: 1,
          }),
        ),
      );
    }
    // For single-source plots, use the source's own formatting for y-axis ticks
    // so big numbers compact down to "$3T" etc. For multi-source rebased, leave
    // default (values are always around 100). For multi-source raw with
    // mixed magnitudes (fullRescale active), use the largest-magnitude
    // source's formatting so the ticks render in the natural axis unit
    // (e.g. share-price + market-cap → ticks read "$300B").
    // When a transform is active, override the formatting via
    // transformFormatting so YoY% reads with a "%" suffix and
    // index_100 reads as a plain index number regardless of the
    // input series' native units.
    const singleSource =
      !payload.isMulti && payload.sources.length === 1
        ? payload.sources[0]
        : null;
    const baseFmt = singleSource?.formatting ?? fullRescale?.axisFormatting;
    const tickFormat = transformActive
      ? (v: number) =>
          formatValue(v, transformFormatting(baseFmt ?? { style: "number", decimals: 1 }, transform))
      : singleSource
        ? (v: number) => formatValue(v, { ...singleSource.formatting, decimals: 1 })
        : fullRescale
          ? (v: number) => formatValue(v, { ...fullRescale.axisFormatting, decimals: 1 })
          : undefined;

    const plot = Plot.plot({
      height: 280,
      width,
      marginLeft: 64,
      marginBottom: 28,
      marginTop: 10,
      marginRight: 16,
      style: {
        fontFamily:
          '"Inter Variable", Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif',
        fontSize: "12px",
        color: "#55524C",
        background: "transparent",
      },
      x: (() => {
        // Pinch-to-zoom / swipe-to-pan override. When the user has
        // gestured a custom domain (zoomedDomainMs), that wins over
        // the chart's natural windowed domain. Cleared by a window-
        // pill click or the reset button — see attachZoomGestures
        // for the lifecycle.
        const effective = zoomedDomainMs ?? standardDomainMs;
        return effective
          ? {
              label: null,
              ticks: 5,
              domain: [new Date(effective[0]), new Date(effective[1])],
            }
          : { label: null, ticks: 5 };
      })(),
      y: {
        label: null,
        grid: true,
        ticks: 5,
        tickFormat,
        // Log scale is honored in the standard (non-dual-axis) branch.
        // Dual-axis takes its own branch above and never reaches here,
        // so we don't need to guard against `normalize === "dual-axis"`
        // — the dual-axis branch ignores payload.scale entirely.
        // YoY% can be negative during contractions; log doesn't work
        // with negatives, so force linear when transform is yoy_pct.
        type:
          payload.scale === "log" && transform !== "yoy_pct"
            ? "log"
            : undefined,
      },
      marks,
    });
    container.replaceChildren(plot);
    // HTML hover-card wiring. The dialog plot's multi-series listing
    // now renders to an HTML element appended to document.body (via
    // wireHoverCard → getHoverCard); the SVG-bound Plot.tip would
    // have been clipped by .dialog-body's overflow-y on dense
    // charts. Margins match the Plot.plot config above (64 left +
    // 16 right standard).
    wireHoverCard(container, {
      bundles,
      domainMs: zoomedDomainMs ?? standardDomainMs ?? null,
      marginLeft: 64,
      marginRight: 16,
    });
  }

  /**
   * Pinch-to-zoom + swipe-to-pan on the dialog plot.
   *
   * Pointer Events unify mouse + touch + pen, so this same handler
   * serves desktop drag + mobile touch + trackpad pinch. Wheel events
   * separately drive desktop zoom.
   *
   * Gesture state machine:
   *   * Single pointer down → standby (Plot's tip can still hover).
   *   * Single pointer move >= 6 px → pan mode active. Track delta
   *     in pixels, convert to ms via the current domain span, shift
   *     the domain.
   *   * Second pointer down → pinch mode active. Track midpoint +
   *     distance. Scale the domain around the midpoint as the
   *     distance changes.
   *   * All pointers up → end gesture, leave ctx.zoomedDomainMs set
   *     so a subsequent gesture continues from where the user
   *     released.
   *
   * Wheel events: anchor on the wheel cursor's x-position, scale
   * domain by 1.15^(deltaY/100) — narrowing on scroll-up, widening
   * on scroll-down. preventDefault() so the page doesn't scroll
   * underneath the plot.
   *
   * Re-render is throttled via requestAnimationFrame so successive
   * pointermove events coalesce into one Plot.plot() call per
   * frame. Plot's re-render is ~50ms; at 60fps the frame budget is
   * 16ms, so the rAF batch keeps perceived latency snappy without
   * over-rendering.
   *
   * Reset: a small "↺ Reset zoom" button appears once the user has
   * zoomed/panned. Window-pill clicks also clear the zoom (a new
   * window has its own natural domain).
   */
  function attachZoomGestures(plotEl: HTMLElement, ctx: TileCtx): void {
    if (ctx.zoomGesturesAttached) return;
    ctx.zoomGesturesAttached = true;

    // Per-gesture state. Reinitialized on first pointerdown of a
    // new gesture; cleared on last pointerup.
    interface GestureState {
      pointers: Map<number, { x: number; y: number }>;
      mode: "none" | "pan" | "pinch";
      startDomainMs: [number, number] | null;
      startCentroidX: number;
      startDistance: number;
      startPlotWidth: number;
      startPlotLeft: number;
    }
    const gesture: GestureState = {
      pointers: new Map(),
      mode: "none",
      startDomainMs: null,
      startCentroidX: 0,
      startDistance: 0,
      startPlotWidth: 0,
      startPlotLeft: 0,
    };
    let pendingRender = false;

    function currentDomain(): [number, number] | null {
      // Domain at the moment a gesture starts: prefer the gesture-
      // set zoom, else recover the natural domain from the rendered
      // Plot SVG. Plot stamps the visible date range into the
      // outermost <svg>'s viewBox indirectly — we read it via the
      // x-axis tick range as a fallback. For simplicity, just trust
      // ctx.zoomedDomainMs when set, otherwise read from the
      // payload + window via a helper.
      if (ctx.zoomedDomainMs) return ctx.zoomedDomainMs;
      // Recover the natural domain by calling dialogPlotPoints for
      // the first source and reading its domainMs. Mirrors the same
      // logic renderFullPlot uses.
      const s = ctx.payload.sources[0];
      if (!s) return null;
      const eff = closestSupported(ctx.currentWindow, s.supportedDeltas);
      const fixed = ctx.selectedView === "fixed" ? ctx.payload.fixedRange : undefined;
      const { domainMs } = dialogPlotPoints(s, eff, fixed);
      return domainMs;
    }

    function plotRect(): DOMRect {
      // The rendered SVG sits inside plotEl. Read its bounding rect
      // to convert pointer screenX → fraction within the plot area.
      // Plot's margins (left ~64, right ~16 for standard) mean the
      // SVG is slightly wider than the data area, but for v1 gesture
      // math we treat the SVG width as the data width — close
      // enough that the visible pan still feels accurate to within
      // a few pixels.
      const svg = plotEl.querySelector("svg");
      return (svg ?? plotEl).getBoundingClientRect();
    }

    function centroid(): { x: number; distance: number } {
      const pts = [...gesture.pointers.values()];
      if (pts.length === 0) return { x: 0, distance: 0 };
      if (pts.length === 1) return { x: pts[0].x, distance: 0 };
      const cx = (pts[0].x + pts[1].x) / 2;
      const dx = pts[0].x - pts[1].x;
      const dy = pts[0].y - pts[1].y;
      const distance = Math.hypot(dx, dy);
      return { x: cx, distance };
    }

    function rerenderSoon(): void {
      // Coalesce successive pointermove events to one render per
      // animation frame.
      if (pendingRender) return;
      pendingRender = true;
      requestAnimationFrame(() => {
        pendingRender = false;
        renderFullPlot(
          plotEl,
          ctx.payload,
          ctx.currentWindow,
          ctx.zoomedDomainMs,
        );
        updateResetVisibility();
      });
    }

    function captureStart(): void {
      const dom = currentDomain();
      const rect = plotRect();
      const c = centroid();
      gesture.startDomainMs = dom;
      gesture.startCentroidX = c.x;
      gesture.startDistance = c.distance;
      gesture.startPlotWidth = rect.width;
      gesture.startPlotLeft = rect.left;
    }

    function onPointerDown(e: PointerEvent): void {
      // Skip if the pointer is on a Plot.tip box or other interactive
      // element inside the plot — let those handle their own events.
      // For SVG path / rect targets we proceed to gesture.
      gesture.pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
      try {
        (e.target as Element).setPointerCapture?.(e.pointerId);
      } catch {
        /* setPointerCapture can throw on detached elements; safe to ignore */
      }
      if (gesture.pointers.size === 1) {
        // Standby. Don't enter pan until movement threshold.
        gesture.mode = "none";
      } else if (gesture.pointers.size === 2) {
        gesture.mode = "pinch";
        captureStart();
      }
    }

    function onPointerMove(e: PointerEvent): void {
      const prev = gesture.pointers.get(e.pointerId);
      if (!prev) return;
      gesture.pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
      if (gesture.pointers.size === 1) {
        // Pan mode — but only after MOVEMENT_THRESHOLD pixels so a
        // simple tap doesn't accidentally pan.
        const dx = e.clientX - (gesture.mode === "pan" ? gesture.startCentroidX : prev.x);
        if (gesture.mode === "none") {
          if (Math.abs(dx) < 6) return;
          gesture.mode = "pan";
          captureStart();
          // Re-anchor so the first frame of pan doesn't snap-jump.
          gesture.startCentroidX = e.clientX;
        }
        if (gesture.mode !== "pan" || !gesture.startDomainMs) return;
        const screenDeltaX = e.clientX - gesture.startCentroidX;
        const domainSpan = gesture.startDomainMs[1] - gesture.startDomainMs[0];
        const domainDeltaMs =
          (-screenDeltaX / gesture.startPlotWidth) * domainSpan;
        ctx.zoomedDomainMs = [
          gesture.startDomainMs[0] + domainDeltaMs,
          gesture.startDomainMs[1] + domainDeltaMs,
        ];
        e.preventDefault();
        rerenderSoon();
      } else if (gesture.pointers.size === 2 && gesture.mode === "pinch") {
        if (!gesture.startDomainMs) return;
        const c = centroid();
        if (gesture.startDistance === 0) return;
        // scale > 1 → zooming IN (smaller domain span). scale < 1 →
        // zooming OUT (wider domain). The pinch-distance ratio is
        // currentDistance / startDistance, so newSpan = startSpan / ratio.
        const ratio = c.distance / gesture.startDistance;
        if (!Number.isFinite(ratio) || ratio === 0) return;
        const startSpan = gesture.startDomainMs[1] - gesture.startDomainMs[0];
        const newSpan = startSpan / ratio;
        // Anchor the zoom at the centroid: the date under the
        // centroid x-pixel stays at the same x-pixel after zoom.
        const centroidFrac =
          (gesture.startCentroidX - gesture.startPlotLeft) /
          gesture.startPlotWidth;
        const centroidDomainMs =
          gesture.startDomainMs[0] + centroidFrac * startSpan;
        ctx.zoomedDomainMs = [
          centroidDomainMs - centroidFrac * newSpan,
          centroidDomainMs + (1 - centroidFrac) * newSpan,
        ];
        e.preventDefault();
        rerenderSoon();
      }
    }

    function onPointerUp(e: PointerEvent): void {
      gesture.pointers.delete(e.pointerId);
      if (gesture.pointers.size === 0) {
        gesture.mode = "none";
      } else if (gesture.pointers.size === 1 && gesture.mode === "pinch") {
        // Dropped from 2 pointers to 1 — fall back to pan mode with
        // the remaining pointer as the anchor.
        gesture.mode = "none";
        captureStart();
      }
    }

    function onWheel(e: WheelEvent): void {
      const dom = currentDomain();
      if (!dom) return;
      const rect = plotRect();
      const frac = (e.clientX - rect.left) / rect.width;
      // Scroll up (deltaY < 0) → zoom in (narrower span).
      const factor = Math.pow(1.15, e.deltaY / 100);
      const span = dom[1] - dom[0];
      const newSpan = span * factor;
      const centroidMs = dom[0] + frac * span;
      ctx.zoomedDomainMs = [
        centroidMs - frac * newSpan,
        centroidMs + (1 - frac) * newSpan,
      ];
      e.preventDefault();
      rerenderSoon();
    }

    // Reset-zoom button. Inserted once, lives until the dialog
    // closes. Shows up next to the window pills once the user has
    // gestured a custom zoom.
    function ensureResetButton(): HTMLButtonElement | null {
      const dlg = ctx.dialog;
      let btn = dlg.querySelector<HTMLButtonElement>("[data-role='zoom-reset']");
      if (btn) return btn;
      // Find the window-pills row to inject the reset alongside.
      const pillsRow = dlg.querySelector<HTMLElement>(".pills");
      if (!pillsRow) return null;
      btn = document.createElement("button");
      btn.type = "button";
      btn.className = "zoom-reset-btn";
      btn.dataset.role = "zoom-reset";
      btn.textContent = "↺ Reset zoom";
      btn.hidden = true;
      btn.addEventListener("click", () => {
        ctx.zoomedDomainMs = null;
        rerenderSoon();
      });
      // Append to the end of the pills row so it sits visually after
      // the window-pill cluster without disturbing pill ordering.
      pillsRow.appendChild(btn);
      return btn;
    }
    function updateResetVisibility(): void {
      const btn = ensureResetButton();
      if (!btn) return;
      btn.hidden = !ctx.zoomedDomainMs;
    }

    // Wire listeners on the plot container. Use { passive: false }
    // so we can preventDefault() inside pan / pinch to stop the
    // browser from scrolling the page underneath a touch drag.
    plotEl.addEventListener("pointerdown", onPointerDown);
    plotEl.addEventListener("pointermove", onPointerMove, { passive: false });
    plotEl.addEventListener("pointerup", onPointerUp);
    plotEl.addEventListener("pointercancel", onPointerUp);
    plotEl.addEventListener("wheel", onWheel, { passive: false });
    // Suppress Plot's hover tip during an active gesture — the tip
    // box flickers as the data slides under the cursor during a pan
    // and reads as visual noise. Re-shows once the gesture ends.
    // Implemented via a CSS class toggled by the gesture handler;
    // styled in Chart.astro to hide [aria-label="tip"] inside the
    // plot when the wrapper has the class.
    function setGestureFlag(active: boolean): void {
      plotEl.classList.toggle("gesture-active", active);
    }
    // Patch the listeners to flip the flag.
    plotEl.addEventListener("pointermove", (e) => {
      if (gesture.mode === "pan" || gesture.mode === "pinch")
        setGestureFlag(true);
    }, { passive: true });
    plotEl.addEventListener("pointerup", () => {
      if (gesture.pointers.size === 0) setGestureFlag(false);
    });
    plotEl.addEventListener("pointercancel", () => setGestureFlag(false));
    // CSS touch-action: pan-y so vertical page scroll still works
    // when the user is NOT actively touching the plot area. Within
    // the plot, our touchmove preventDefault locks horizontal
    // scrolling to the gesture handler.
    plotEl.style.touchAction = "pan-y";
    updateResetVisibility();
  }

  function updateTile(
    tile: HTMLElement,
    payload: Payload,
    window: DeltaWindow,
  ): void {
    const fixed = payload.fixedRange;
    // Window mismatch = the dashboard (or section) asked for one
    // window but this chart ended up rendering at a different one.
    // tile.dataset.dashboardWindow tracks the "asked-for" value (set
    // at server render time and updated by the dashboard-pill click
    // handler for non-section-locked tiles). When the user manually
    // overrides via a tile/dialog pill, dashboardWindow stays put so
    // the mismatch reflects "this isn't what the dashboard asked for."
    const dashWanted = tile.dataset.dashboardWindow as DeltaWindow | undefined;
    const mismatch = !fixed && !!dashWanted && dashWanted !== window;
    const captionEl = tile.querySelector<HTMLElement>(".tile-window");
    if (captionEl) {
      if (fixed) {
        captionEl.textContent = `${fixed.start} → ${fixed.end}`;
      } else {
        // innerHTML rather than textContent so the duration wraps in
        // the span the CSS bolds on mismatch. DELTA_LABELS_PAST keys
        // are author-controlled (compile-time constants), no XSS risk.
        captionEl.innerHTML = `over the <span class="window-duration" data-role="window-duration">${DELTA_LABELS_PAST[window]}</span>`;
      }
      if (mismatch) captionEl.setAttribute("data-window-mismatch", "1");
      else captionEl.removeAttribute("data-window-mismatch");
    }

    const sparkEl = tile.querySelector<HTMLElement>(
      '[data-role="tile-spark"]',
    );

    // Tile readouts and sparkline route through tileCurrent / tilePrior /
    // tile{Spark,VisibleAndStart} so they work in both summary mode (no
    // full points shipped) and full mode (op'd / fixed-range / hydrated).
    if (payload.isMulti) {
      for (const s of payload.sources) {
        const eff = closestSupported(window, s.supportedDeltas);
        const current = tileCurrent(s, fixed);
        const prior = tilePrior(s, eff, fixed);
        const row = tile.querySelector<HTMLElement>(
          `[data-role="series-delta"][data-source-id="${CSS.escape(s.id)}"]`,
        );
        if (row) {
          if (current && prior) {
            const dd = formatDeltaDisplay(current.v, prior.v, s.formatting);
            row.textContent = dd.text;
            row.dataset.direction = dd.direction;
          } else {
            row.textContent = "—";
            row.dataset.direction = "flat";
          }
        }
      }
      if (sparkEl) renderSparkMulti(sparkEl, payload, window);
    } else {
      const s = payload.sources[0];
      if (!s) return;
      const eff = closestSupported(window, s.supportedDeltas);
      const current = tileCurrent(s, fixed);
      const prior = tilePrior(s, eff, fixed);

      const valEl = tile.querySelector<HTMLElement>('[data-role="tile-value"]');
      if (valEl)
        valEl.textContent = current ? formatValue(current.v, s.formatting) : "—";

      const deltaEl = tile.querySelector<HTMLElement>(
        '[data-role="tile-delta"]',
      );
      if (deltaEl && current && prior) {
        const dd = formatDeltaDisplay(current.v, prior.v, s.formatting);
        deltaEl.textContent = dd.text;
        deltaEl.dataset.direction = dd.direction;
      } else if (deltaEl) {
        deltaEl.textContent = "";
      }

      if (sparkEl) renderSparkSingle(sparkEl, s, eff, fixed, payload.shading);
    }
  }

  function updateDialog(
    dialog: HTMLDialogElement,
    payload: Payload,
    window: DeltaWindow,
  ): void {
    // updateDialog runs only after dialog-open lazy-fetch has hydrated
    // `points` on every source that was shipped summary-only. So both
    // summary and points may be present here; tileCurrent / tilePrior
    // produce the same observation either way (summary.priors[w] is
    // the same point findPrior would return on full points).
    const fixed = payload.fixedRange;
    if (payload.isMulti) {
      for (const s of payload.sources) {
        const eff = closestSupported(window, s.supportedDeltas);
        const current = tileCurrent(s, fixed);
        const prior = tilePrior(s, eff, fixed);
        const row = dialog.querySelector<HTMLElement>(
          `.multi-readout-row[data-source-id="${CSS.escape(s.id)}"]`,
        );
        if (!row) continue;
        const levelEl = row.querySelector<HTMLElement>(
          '[data-role="readout-level"]',
        );
        const deltaEl = row.querySelector<HTMLElement>(
          '[data-role="readout-delta"]',
        );
        if (levelEl)
          levelEl.textContent = current ? formatValue(current.v, s.formatting) : "—";
        if (deltaEl) {
          if (current && prior) {
            const dd = formatDeltaDisplay(current.v, prior.v, s.formatting);
            deltaEl.textContent = dd.text;
            deltaEl.dataset.direction = dd.direction;
          } else {
            deltaEl.textContent = "—";
            deltaEl.dataset.direction = "flat";
          }
        }
      }
      const captionEl = dialog.querySelector<HTMLElement>(
        '[data-role="descriptor"]',
      );
      if (captionEl) {
        const dashWantedMulti = dialog.dataset.dashboardWindow as DeltaWindow | undefined;
        const mismatchMulti = !fixed && !!dashWantedMulti && dashWantedMulti !== window;
        if (fixed) {
          captionEl.textContent = `${fixed.start} → ${fixed.end}.`;
        } else {
          captionEl.innerHTML = `Over the <span class="window-duration" data-role="window-duration">${DELTA_LABELS_PAST[window]}</span>.`;
        }
        if (mismatchMulti) captionEl.setAttribute("data-window-mismatch", "1");
        else captionEl.removeAttribute("data-window-mismatch");
      }
    } else {
      const s = payload.sources[0];
      if (!s) return;
      const eff = closestSupported(window, s.supportedDeltas);
      const current = tileCurrent(s, fixed);
      const prior = tilePrior(s, eff, fixed);

      const currentStr = current ? formatValue(current.v, s.formatting) : "—";
      const valEl = dialog.querySelector<HTMLElement>('[data-role="value"]');
      if (valEl) valEl.textContent = currentStr;

      const deltaEl = dialog.querySelector<HTMLElement>(
        '[data-role="delta-pct"]',
      );
      const descriptorEl = dialog.querySelector<HTMLElement>(
        '[data-role="descriptor"]',
      );

      // Mismatch is computed against eff (the chart's effective
      // window after closestSupported) so when the dashboard asked
      // for one window and the chart's data only supports another,
      // the duration token gets bolded in the descriptor.
      const dashWantedSingle = dialog.dataset.dashboardWindow as DeltaWindow | undefined;
      const mismatchSingle = !fixed && !!dashWantedSingle && dashWantedSingle !== eff;
      // Tiny helper: emit the period phrase as either plain text
      // (fixed-range case, no mismatch concept) or HTML with the
      // duration span the CSS bolds on mismatch.
      const periodHtml = fixed
        ? `from ${escapeHtml(fixed.start)} to ${escapeHtml(fixed.end)}`
        : `over the <span class="window-duration" data-role="window-duration">${DELTA_LABELS_PAST[eff]}</span>`;
      if (current && prior) {
        const dd = formatDeltaDisplay(current.v, prior.v, s.formatting);
        if (deltaEl) {
          deltaEl.textContent = dd.text;
          deltaEl.dataset.direction = dd.direction;
        }
        const priorStr = formatValue(prior.v, s.formatting);
        if (descriptorEl) {
          descriptorEl.innerHTML =
            dd.direction === "flat"
              ? `${escapeHtml(s.name)} is at ${escapeHtml(currentStr)}, roughly unchanged ${periodHtml}.`
              : `${escapeHtml(s.name)} is at ${escapeHtml(currentStr)}, ${directionWord(dd.direction)} from ${escapeHtml(priorStr)} ${periodHtml} (${escapeHtml(dd.text)}).`;
        }
      } else {
        if (deltaEl) {
          deltaEl.textContent = "";
          deltaEl.dataset.direction = "flat";
        }
        if (descriptorEl) {
          const noHistoryPeriod = fixed
            ? `the range ${escapeHtml(fixed.start)} → ${escapeHtml(fixed.end)}`
            : `the <span class="window-duration" data-role="window-duration">${DELTA_LABELS_PAST[eff]}</span>`;
          descriptorEl.innerHTML = `${escapeHtml(s.name)} is at ${escapeHtml(currentStr)}. History doesn't cover ${noHistoryPeriod}.`;
        }
      }
      if (descriptorEl) {
        if (mismatchSingle) descriptorEl.setAttribute("data-window-mismatch", "1");
        else descriptorEl.removeAttribute("data-window-mismatch");
      }
    }

    const plotEl = dialog.querySelector<HTMLElement>('[data-role="plot"]');
    if (plotEl) renderFullPlot(plotEl, payload, window);
    // (Pill-active toggling is handled by the call site so that the "fixed"
    // pill — whose data-window value isn't a DeltaWindow — can be activated
    // alongside regular windows.)
  }

  interface TileCtx {
    tile: HTMLElement;
    dialog: HTMLDialogElement;
    payload: Payload;
    currentWindow: DeltaWindow;
    // "fixed" when the dialog should render the dashboard's fixedRange;
    // otherwise the user's currently-selected DeltaWindow. When a chart
    // ships with a fixed range, this defaults to "fixed" but the user can
    // toggle to a trailing window from the dialog's pill row.
    selectedView: DeltaWindow | "fixed";
    dialogInitialized: boolean;
    // Currently-active y-axis transform for the dialog plot. Defaults
    // to payload.transform on first open; pill clicks update it
    // without re-emitting the payload.
    currentTransform: TransformKey;
    // Pinch-to-zoom / swipe-to-pan state. When the user has gestured
    // a custom x-domain, it lives here as [startMs, endMs] in ms-
    // since-epoch. Null means "use the chart's natural windowed
    // domain" (the default). Reset by window-pill clicks (a new
    // window has its own natural domain) or the reset button.
    zoomedDomainMs: [number, number] | null;
    // Whether the gesture-event listeners have been attached. Set
    // once per dialog after first open; subsequent re-renders reuse
    // the same listeners.
    zoomGesturesAttached: boolean;
  }

  // Build the payload to pass to update functions based on whether the
  // viewer is in fixed-range mode or trailing-window mode. In trailing
  // mode we strip the dashboard's fixedRange so the renderers fall back
  // to window logic.
  function effectivePayload(payload: Payload, useFixed: boolean): Payload {
    if (useFixed) return payload;
    if (!payload.fixedRange) return payload;
    return { ...payload, fixedRange: undefined };
  }

  // Toggle pill-active class to match the current view selection.
  function setActivePill(
    dialog: HTMLDialogElement,
    selected: DeltaWindow | "fixed",
  ): void {
    dialog
      .querySelectorAll<HTMLButtonElement>("button[data-window]")
      .forEach((p) => {
        const active = p.dataset.window === selected;
        p.classList.toggle("pill-active", active);
        p.setAttribute("aria-pressed", active ? "true" : "false");
      });
  }

  // ---- Save-as-image export ----
  // Capture the dialog's currently-rendered SVG, wrap it in a branded
  // header/footer container, rasterize via Canvas, and trigger a download.
  // Keeps the user inside the page (no server roundtrip) and the watermark
  // makes the image attributable when it ends up in a slide deck or memo.

  function escapeXml(s: string): string {
    return s
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&apos;");
  }

  function slugifyForFilename(s: string): string {
    return (
      s
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-+|-+$/g, "")
        .slice(0, 60) || "chart"
    );
  }

  /**
   * Inline computed font/fill/stroke styles on every node of the SVG clone so
   * the serialized markup renders the same in a fresh <img> tag as it does on
   * the live page (where external CSS supplies most of the styling). Without
   * this step, the exported PNG comes out with wrong fonts, default black
   * strokes, and missing fills.
   */
  function inlineComputedStyles(
    live: SVGSVGElement,
    cloned: SVGSVGElement,
  ): void {
    const liveNodes = live.querySelectorAll<SVGElement>("*");
    const clonedNodes = cloned.querySelectorAll<SVGElement>("*");
    const wanted = [
      "fill",
      "stroke",
      "stroke-width",
      "stroke-linecap",
      "stroke-linejoin",
      "stroke-dasharray",
      "stroke-opacity",
      "fill-opacity",
      "opacity",
      "font-family",
      "font-size",
      "font-weight",
      "text-anchor",
      "dominant-baseline",
      "color",
    ];
    for (let i = 0; i < liveNodes.length && i < clonedNodes.length; i++) {
      const styles = getComputedStyle(liveNodes[i]);
      let inline = "";
      for (const prop of wanted) {
        const val = styles.getPropertyValue(prop);
        if (val && val !== "none" && val !== "normal") {
          inline += `${prop}:${val};`;
        }
      }
      if (inline) clonedNodes[i].setAttribute("style", inline);
    }
  }

  /**
   * Capture the dialog's chart as a watermarked PNG Blob. Returns the Blob
   * plus a filename, ready for either clipboard-write or a download anchor
   * fallback. Caller decides which.
   */
  async function captureDialogPng(
    dialog: HTMLDialogElement,
    payload: Payload,
    currentWindow: DeltaWindow,
  ): Promise<{ blob: Blob; filename: string } | null> {
    const plotEl = dialog.querySelector<HTMLElement>('[data-role="plot"]');
    const liveSvg = plotEl?.querySelector<SVGSVGElement>("svg");
    if (!liveSvg) return null;

    const titleEl = dialog.querySelector<HTMLHeadingElement>(
      ".dialog-header h2",
    );
    const title = titleEl?.textContent?.trim() ?? "Chart";

    // Source attribution line. Mirrors the existing dialog footer but
    // flattened into a single string so it renders cleanly in the export.
    const sourceLabels = payload.sources.map((s) => s.shortName || s.name);
    const sourceLine = sourceLabels.join(" · ");

    // Window label (e.g. "5y", "10y") so the exported image is self-describing
    // when it's pasted into a slide divorced from the dashboard context.
    const windowLabel = currentWindow.toUpperCase();

    // Latest data timestamp across all sources, so the image carries its own
    // recency stamp.
    let mostRecent = "";
    for (const s of payload.sources) {
      if (s.lastUpdated > mostRecent) mostRecent = s.lastUpdated;
    }
    const updatedStr = mostRecent
      ? new Date(mostRecent).toLocaleDateString(undefined, {
          year: "numeric",
          month: "short",
          day: "numeric",
        })
      : "";

    // Clone the live SVG and freeze its styling — Plot's output relies on
    // CSS rules from the page; without inlining computed styles, the export
    // would lose fonts/strokes.
    const cloned = liveSvg.cloneNode(true) as SVGSVGElement;
    inlineComputedStyles(liveSvg, cloned);

    const liveRect = liveSvg.getBoundingClientRect();
    const plotW = Math.max(640, Math.round(liveRect.width || 720));
    const plotH = Math.max(280, Math.round(liveRect.height || 360));
    cloned.setAttribute("width", String(plotW));
    cloned.setAttribute("height", String(plotH));

    const pad = 28;
    const headerH = 64 + (sourceLine ? 22 : 0);
    const footerH = 28;
    const W = plotW + pad * 2;
    const H = plotH + headerH + footerH + pad * 2;

    // Build the wrapper SVG that contains: branded eyebrow, title, optional
    // source line, the cloned plot, and watermark footer.
    const plotInner = new XMLSerializer().serializeToString(cloned);
    const wrapper = [
      `<svg xmlns="http://www.w3.org/2000/svg" width="${W}" height="${H}" viewBox="0 0 ${W} ${H}" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif">`,
      `<rect width="${W}" height="${H}" fill="#fefefe"/>`,
      `<text x="${pad}" y="${pad + 14}" font-size="11" font-weight="600" letter-spacing="1.2" fill="#0d7a6a">LEGIBLE MARKETS</text>`,
      `<text x="${pad}" y="${pad + 46}" font-size="22" font-weight="600" fill="#111">${escapeXml(title)}</text>`,
      sourceLine
        ? `<text x="${pad}" y="${pad + 70}" font-size="13" fill="#666">${escapeXml(sourceLine)} · ${escapeXml(windowLabel)} window</text>`
        : "",
      `<g transform="translate(${pad}, ${pad + headerH})">${plotInner}</g>`,
      `<text x="${pad}" y="${H - pad / 2}" font-size="12" fill="#888">${escapeXml(SITE_BRAND_URL)}</text>`,
      updatedStr
        ? `<text x="${W - pad}" y="${H - pad / 2}" font-size="12" fill="#888" text-anchor="end">Data through ${escapeXml(updatedStr)}</text>`
        : "",
      `</svg>`,
    ].join("");

    const svgBlob = new Blob([wrapper], {
      type: "image/svg+xml;charset=utf-8",
    });
    const url = URL.createObjectURL(svgBlob);

    try {
      const img = new Image();
      img.decoding = "sync";
      const loaded = new Promise<void>((resolve, reject) => {
        img.onload = () => resolve();
        img.onerror = () => reject(new Error("svg load failed"));
      });
      img.src = url;
      await loaded;

      // 2× DPR for crisp output regardless of the user's screen.
      const dpr = 2;
      const canvas = document.createElement("canvas");
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      const ctx = canvas.getContext("2d");
      if (!ctx) throw new Error("2d context unavailable");
      ctx.scale(dpr, dpr);
      ctx.drawImage(img, 0, 0);

      const blob = await new Promise<Blob | null>((resolve) => {
        canvas.toBlob((b) => resolve(b), "image/png");
      });
      if (!blob) throw new Error("toBlob returned null");
      return {
        blob,
        filename: `${slugifyForFilename(title)}-${currentWindow}.png`,
      };
    } finally {
      URL.revokeObjectURL(url);
    }
  }

  /**
   * Trigger a browser download of the given blob as a fallback when the
   * clipboard image-write API isn't available. Returned as a Promise so the
   * caller can await completion (the click happens synchronously but the
   * browser kicks the download asynchronously).
   */
  function downloadBlob(blob: Blob, filename: string): void {
    const dlUrl = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = dlUrl;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    setTimeout(() => URL.revokeObjectURL(dlUrl), 0);
  }

  /**
   * Try to write the PNG to the system clipboard. Returns true on success,
   * false if the browser doesn't support image clipboard writes (older
   * Firefox or Safari) or if the user denied clipboard permission.
   */
  async function copyImageToClipboard(blob: Blob): Promise<boolean> {
    try {
      const Ctor = (window as unknown as { ClipboardItem?: typeof ClipboardItem })
        .ClipboardItem;
      if (!Ctor || !navigator.clipboard?.write) return false;
      const item = new Ctor({ [blob.type]: blob });
      await navigator.clipboard.write([item]);
      return true;
    } catch {
      return false;
    }
  }

  function hydrate(): void {
    // Phase 2 telemetry: record when hydrate starts so we can emit a
    // dashboard_perf_loaded event at the end with init wall-time.
    const hydrateStartMs = performance.now();
    const dashRoot = document.querySelector<HTMLElement>(".dashboard-root");
    const dashDefault = (dashRoot?.dataset.dashboardDefaultWindow ??
      "1m") as DeltaWindow;

    const tileContexts: TileCtx[] = [];
    const tiles = document.querySelectorAll<HTMLElement>(
      ".chart-tile[data-chart-ref]",
    );
    tiles.forEach((tile) => {
      const ref = tile.dataset.chartRef;
      if (!ref) return;
      const dialog = document.getElementById(ref);
      if (!(dialog instanceof HTMLDialogElement)) return;

      const payloadEl = dialog.querySelector<HTMLScriptElement>(
        "script[data-chart-payload]",
      );
      if (!payloadEl?.textContent) return;
      let payload: Payload;
      try {
        payload = JSON.parse(payloadEl.textContent);
      } catch {
        return;
      }

      const ctx: TileCtx = {
        tile,
        dialog,
        payload,
        currentWindow: closestSupported(dashDefault, payload.supportedDeltas),
        selectedView: payload.fixedRange ? "fixed" : "_window",
        dialogInitialized: false,
        currentTransform: payload.transform ?? "level",
        zoomedDomainMs: null,
        zoomGesturesAttached: false,
      } as TileCtx;
      // Fix sentinel "_window": replace with the actual window value.
      if (ctx.selectedView === ("_window" as unknown as DeltaWindow)) {
        ctx.selectedView = ctx.currentWindow;
      }
      tileContexts.push(ctx);
      updateTile(tile, payload, ctx.currentWindow);

      tile.addEventListener("click", () => {
        // Two-phase open for snappier perceived latency:
        //
        //   1. SYNCHRONOUS LOW-FI: showModal opens the frame; updateDialog
        //      runs immediately. In summary mode, the plot renders from
        //      summary.sparks[window] (precomputed ~30 points) — visually
        //      coarser than the high-fi version, but on-screen within a
        //      few ms instead of waiting for a network fetch.
        //
        //   2. BACKGROUND HIGH-FI: ensureAllFullPoints fetches the full
        //      timeseries. When it resolves, we re-render. The Plot
        //      library swaps the marks in place — readouts don't change
        //      (precomputed priors are exact), so users see a smooth
        //      "upgrade in resolution" rather than a flash of new
        //      content.
        //
        // For op'd / fixed-range / derived charts, s.points was already
        // shipped and the first render IS high-fi. The fetch returns
        // fetched=0 and the re-render is a cheap no-op.
        dialog.showModal();
        if (!ctx.dialogInitialized) {
          const tOpen = performance.now();
          const useFixed = ctx.selectedView === "fixed";
          // Phase 1: low-fi (or high-fi if points are already present).
          updateDialog(
            dialog,
            effectivePayload(payload, useFixed),
            ctx.currentWindow,
          );
          setActivePill(dialog, ctx.selectedView);
          ctx.dialogInitialized = true;
          // Attach pinch-to-zoom + swipe-to-pan + wheel-zoom gestures
          // on the plot element. Idempotent — guarded by
          // ctx.zoomGesturesAttached so reopening the dialog doesn't
          // double-bind. See attachZoomGestures for the full state
          // machine.
          const plotElForZoom = dialog.querySelector<HTMLElement>("[data-role='plot']");
          if (plotElForZoom) attachZoomGestures(plotElForZoom, ctx);
          const tFirstPaintMs = Math.round(performance.now() - tOpen);

          // Phase 2: high-fi upgrade. Async, but no await on the open
          // path so the click handler itself doesn't block — we fire
          // the perf event from inside the promise's then().
          ensureAllFullPoints(payload).then((fetchStats) => {
            if (fetchStats.fetched > 0) {
              // Got real points — re-render to upgrade visual fidelity.
              // updateDialog is idempotent; readout values are unchanged
              // since summary.priors[w] matches the full-data prior.
              updateDialog(
                dialog,
                effectivePayload(payload, useFixed),
                ctx.currentWindow,
              );
            }
            // fetchStats.failed > 0 → low-fi preview stays in place.
            // Readouts are still correct (summary priors are exact);
            // users get a usable chart, just coarser than ideal. Not
            // worth a user-visible error for the rare network blip.

            track("chart_expanded", {
              chartId: payload.chartId ?? "unknown",
              surface: payload.surface ?? "unknown",
              window: ctx.currentWindow,
              lazy_fetched_sources: fetchStats.fetched,
              lazy_fetch_failed: fetchStats.failed,
              lazy_fetch_ms: fetchStats.totalMs,
              // Time-to-first-paint: low-fi plot on screen. The signal
              // users actually feel when they click. Phase-2 target: <50ms.
              time_to_first_paint_ms: tFirstPaintMs,
              // Time-to-high-fi: when the full-resolution plot replaces
              // the preview. Roughly tFirstPaint + fetch + Plot re-render.
              open_to_render_ms: Math.round(performance.now() - tOpen),
            });
          });
        } else {
          // Second+ open — dialog is already initialized + points cached.
          // No fetch, no re-render needed.
          track("chart_expanded", {
            chartId: payload.chartId ?? "unknown",
            surface: payload.surface ?? "unknown",
            window: ctx.currentWindow,
            lazy_fetched_sources: 0,
            lazy_fetch_failed: 0,
            lazy_fetch_ms: 0,
            time_to_first_paint_ms: 0,
            open_to_render_ms: 0,
          });
        }
      });

      dialog
        .querySelectorAll<HTMLButtonElement>("button[data-window]")
        .forEach((pill) => {
          pill.addEventListener("click", (e) => {
            e.stopPropagation();
            // Pills become clickable as soon as showModal() runs, but the
            // dialog's lazy-fetch (in the tile-click handler above) may
            // still be in flight. updateDialog → renderFullPlot needs
            // `s.points` populated; bail out until init completes. The
            // tile-click handler is async + awaits the fetch, so this
            // race window is sub-second.
            if (!ctx.dialogInitialized) return;
            const w = pill.dataset.window;
            if (!w) return;
            // A new window means a new natural domain. Drop the
            // gesture-set zoom so the subsequent updateDialog renders
            // at the window's natural scale + the next gesture starts
            // from there.
            ctx.zoomedDomainMs = null;
            if (w === "fixed") {
              ctx.selectedView = "fixed";
              updateDialog(
                dialog,
                effectivePayload(payload, true),
                ctx.currentWindow,
              );
            } else {
              ctx.currentWindow = w as DeltaWindow;
              ctx.selectedView = ctx.currentWindow;
              updateDialog(
                dialog,
                effectivePayload(payload, false),
                ctx.currentWindow,
              );
            }
            setActivePill(dialog, ctx.selectedView);
            // Hide the reset-zoom chip after window switch since zoom
            // was just cleared.
            const resetBtn = dialog.querySelector<HTMLButtonElement>(
              "[data-role='zoom-reset']",
            );
            if (resetBtn) resetBtn.hidden = true;
          });
        });

      // Y-axis transform pills (Level / YoY % / Index = 100). Pure
      // view-state — flipping the transform re-renders the full plot
      // without mutating the saved chart spec. The transform field on
      // payload is sticky to the dashboard-author's choice; pill
      // clicks override per-session by mutating ctx.payload.transform
      // so the existing renderFullPlot call path picks up the change.
      dialog
        .querySelectorAll<HTMLButtonElement>("button[data-transform]")
        .forEach((pill) => {
          pill.addEventListener("click", (e) => {
            e.stopPropagation();
            if (!ctx.dialogInitialized) return;
            const t = pill.dataset.transform as TransformKey | undefined;
            if (!t) return;
            ctx.currentTransform = t;
            ctx.payload.transform = t;
            // Re-render the dialog with the new transform active. The
            // updateDialog path passes payload (which now carries the
            // new transform) into renderFullPlot.
            const useFixed = ctx.selectedView === "fixed";
            updateDialog(
              dialog,
              effectivePayload(payload, useFixed),
              ctx.currentWindow,
            );
            // Update pill-active class within this transform-pill
            // group (separate from window pills above).
            dialog
              .querySelectorAll<HTMLButtonElement>("button[data-transform]")
              .forEach((p) => {
                const active = p.dataset.transform === t;
                p.classList.toggle("pill-active", active);
                p.setAttribute("aria-pressed", active ? "true" : "false");
              });
            track("chart_transform_changed", {
              chartId: payload.chartId ?? "",
              transform: t,
              surface: payload.surface ?? "",
            });
          });
        });

      dialog.addEventListener("click", (e) => {
        if (e.target === dialog) dialog.close();
      });

      // Hide the floating hover-card when the dialog closes. Without
      // this, closing via backdrop click / Escape can leave the card
      // visible (pointerleave may not fire if the dialog disappears
      // out from under a still-stationary cursor).
      dialog.addEventListener("close", () => hideHoverCard());

      const closeBtn = dialog.querySelector<HTMLElement>(".dialog-close");
      if (closeBtn) {
        closeBtn.addEventListener("click", () => dialog.close());
      }

      const embedLinkBtn = dialog.querySelector<HTMLButtonElement>(
        "[data-role='copy-embed-link']",
      );
      if (embedLinkBtn) {
        embedLinkBtn.addEventListener("click", async (e) => {
          e.stopPropagation();
          if (embedLinkBtn.disabled) return;
          // Substack / Twitter / Slack / Discord auto-unfurl URLs via OG
          // meta tags. For library charts we link to the chart-detail page
          // (/chart/<id>/) whose OG image is a rich rendered preview of
          // that specific chart. For ad-hoc inline charts (composer-only,
          // no detail page) fall back to the current page URL — that's
          // still a real page with its own OG card.
          const chartId = payload.chartId ?? "";
          const origin = window.location.origin;
          const isInline = chartId.startsWith("inline:");
          const link =
            chartId && !isInline
              ? `${origin}/chart/${chartId}/`
              : window.location.href;
          const originalLabel = embedLinkBtn.textContent ?? "Copy embed link";
          embedLinkBtn.disabled = true;
          try {
            await navigator.clipboard.writeText(link);
            embedLinkBtn.textContent = "Copied!";
            // Strong intent signal — separate from share-link copy because
            // this one's specifically about distribution to a different
            // surface, not just "share the URL I'm on".
            track("chart_embed_link_copied", {
              chartId,
              window: ctx.currentWindow,
              sources: payload.sources
                .map((s) => s.id)
                .slice(0, 8)
                .join(","),
            });
          } catch {
            embedLinkBtn.textContent = "Copy failed";
          } finally {
            setTimeout(() => {
              embedLinkBtn.disabled = false;
              embedLinkBtn.textContent = originalLabel;
            }, 1500);
          }
        });
      }

      // "Copy embed code" — generates the iframe HTML snippet that
      // renders this chart live inside a Substack post / blog / wiki.
      // Carries the current window selection in ?delta= so the embed
      // reproduces what the user is seeing on screen right now (not
      // the chart's default window).
      const embedIframeBtn = dialog.querySelector<HTMLButtonElement>(
        "[data-role='copy-embed-iframe']",
      );
      if (embedIframeBtn) {
        embedIframeBtn.addEventListener("click", async (e) => {
          e.stopPropagation();
          if (embedIframeBtn.disabled) return;
          const chartId = payload.chartId ?? "";
          const isInline = chartId.startsWith("inline:");
          if (isInline) {
            // Inline charts have no stable URL — the iframe-embed
            // path only makes sense for library charts. Tell the user
            // and bail.
            embedIframeBtn.disabled = true;
            const orig = embedIframeBtn.textContent ?? "Copy embed code";
            embedIframeBtn.textContent = "Save first";
            setTimeout(() => {
              embedIframeBtn.disabled = false;
              embedIframeBtn.textContent = orig;
            }, 1500);
            return;
          }
          // Build the iframe snippet against window.location.origin.
          // ChartController doesn't know about SITE_BRAND_URL —
          // origin is the deployed Vercel URL today, the real tape.io
          // host once that DNS is in place.
          const origin = window.location.origin;
          const params = new URLSearchParams();
          if (ctx.currentWindow) params.set("delta", ctx.currentWindow);
          const qs = params.toString();
          const url = `${origin}/embed/chart/${chartId}/${qs ? `?${qs}` : ""}`;
          // Iframe dims: 700×420 is a sensible default that fits
          // most blog column widths AND leaves enough vertical room
          // for the title + readout + sparkline at readable scale.
          // The user can resize in their host editor as needed.
          const snippet =
            `<iframe src="${url}" width="700" height="420" ` +
            `style="border:0; max-width:100%;" loading="lazy" ` +
            `title="${(payload.title ?? chartId).replace(/"/g, "&quot;")}" ` +
            `allow="clipboard-write"></iframe>`;
          const originalLabel = embedIframeBtn.textContent ?? "Copy embed code";
          embedIframeBtn.disabled = true;
          try {
            await navigator.clipboard.writeText(snippet);
            embedIframeBtn.textContent = "Copied!";
            track("chart_embed_iframe_copied", {
              chartId,
              window: ctx.currentWindow,
              surface: payload.surface ?? "",
            });
          } catch {
            embedIframeBtn.textContent = "Copy failed";
          } finally {
            setTimeout(() => {
              embedIframeBtn.disabled = false;
              embedIframeBtn.textContent = originalLabel;
            }, 1500);
          }
        });
      }

      const openAsDashBtn = dialog.querySelector<HTMLButtonElement>(
        "[data-role='open-as-dashboard']",
      );
      if (openAsDashBtn) {
        openAsDashBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          // Build a minimal composed state containing just this chart, then
          // bounce to /compose/?d=... so the user lands in the composer with
          // the chart already added and the original chart's title pre-seeded
          // as the dashboard title.
          //
          // Two branches: library charts (e.g. "us-macro/sp500") only need
          // their ID — the composer resolves them via the content
          // collection. Inline charts (composer-built, "inline:abc123") need
          // their full spec carried over inlineCharts because there's no
          // server-side source of truth for them.
          const chartId = payload.chartId ?? "";
          const isInline = chartId.startsWith("inline:");
          const seedTitle = payload.title ?? "New dashboard";
          // Preserve the user's current time window — if they were
          // looking at YTD on this chart, the new dashboard should open
          // at YTD too. closestSupported() in the composer falls back
          // gracefully if some chart in the dashboard doesn't support it.
          const seedDelta = ctx.currentWindow;
          let dParam: string;
          if (chartId && !isInline) {
            // Library chart: composer resolves chartId via getEntry().
            dParam = encodeComposedState({
              title: seedTitle,
              defaultDelta: seedDelta,
              sections: [
                { title: "Overview", charts: [chartId] },
              ],
            });
          } else {
            // Inline chart: reconstruct its InlineChart spec from the
            // payload. The composer keeps it under inlineCharts[id] and
            // renders it like the original dashboard would have.
            const inlineId = chartId || `inline:${Math.random().toString(36).slice(2, 10)}`;
            const inlineSpec: InlineChart = {
              title: seedTitle,
              sources: payload.sources.map((s) => s.id),
              normalize: payload.normalize,
              scale: payload.scale === "log" ? "log" : undefined,
              rightAxisSources: payload.rightAxisSources,
              op: payload.op,
              defaultDelta: seedDelta,
            };
            dParam = encodeComposedState({
              title: seedTitle,
              defaultDelta: seedDelta,
              sections: [
                { title: "Overview", charts: [inlineId] },
              ],
              inlineCharts: { [inlineId]: inlineSpec },
            });
          }
          // Telemetry: each click is a strong-intent "I want to build
          // around this chart" signal; valuable for prioritizing which
          // charts deserve more attention from the curation pass.
          track("chart_open_as_dashboard", {
            chartId,
            window: ctx.currentWindow,
            sources: payload.sources
              .map((s) => s.id)
              .slice(0, 8)
              .join(","),
          });
          // The site doesn't run under a subpath, so an absolute /compose/ is
          // safe. If we ever deploy under a base prefix this should pick up
          // a baseUrl helper instead.
          window.location.href = `/compose/?d=${dParam}`;
        });
      }

      const copyCitationBtn = dialog.querySelector<HTMLButtonElement>(
        "[data-role='copy-citation']",
      );
      if (copyCitationBtn) {
        copyCitationBtn.addEventListener("click", async (e) => {
          e.stopPropagation();
          // Citation format intentionally plain-text (not Markdown, not
          // BibTeX) because the most common paste target is a memo
          // footnote, a Substack body, or an email — places where rich
          // formatting gets eaten anyway. The block reads naturally as a
          // prose footnote and degrades to a single-line summary if
          // line breaks are stripped.
          const today = new Date().toISOString().slice(0, 10);
          const providers = Array.from(
            new Set(payload.sources.map((s) => s.provider ?? "Unknown")),
          );
          // Latest "as-of" date across all underlying source files —
          // this is the data vintage the chart represents, not the
          // retrieval date.
          const asOf = payload.sources
            .map((s) => (s.lastUpdated ?? "").slice(0, 10))
            .filter(Boolean)
            .sort()
            .at(-1);
          const title = payload.title ?? "Untitled chart";
          const window = ctx.currentWindow;
          const url = window ? `${location.origin}${location.pathname}` : location.href;
          // Compose the block. Each line is a sentence so a reader who
          // pastes it into a paragraph still gets readable prose.
          const lines = [
            `"${title}." Tape.`,
            `Data: ${providers.join("; ")}.`,
            asOf ? `Data through ${asOf}.` : null,
            `Retrieved ${today} from ${url}.`,
          ].filter((x): x is string => x !== null);
          const block = lines.join(" ");
          try {
            await navigator.clipboard.writeText(block);
            const original = copyCitationBtn.textContent;
            copyCitationBtn.textContent = "Copied";
            setTimeout(() => {
              copyCitationBtn.textContent = original ?? "Copy citation";
            }, 1500);
          } catch {
            // Clipboard API can fail (older Safari, permissions).
            // Surface the failure clearly rather than silently dropping.
            alert("Copy failed. Citation block:\n\n" + block);
          }
          track("chart_citation_copied", {
            chartId: payload.chartId ?? "unknown",
            surface: payload.surface ?? "unknown",
          });
        });
      }

      const copyImgBtn = dialog.querySelector<HTMLButtonElement>(
        "[data-role='copy-image']",
      );
      if (copyImgBtn) {
        copyImgBtn.addEventListener("click", async (e) => {
          e.stopPropagation();
          if (copyImgBtn.disabled) return;
          // Defensive: the dialog must have rendered its plot before capture
          // works. Forcing render here is cheap and idempotent.
          if (!ctx.dialogInitialized) {
            const useFixed = ctx.selectedView === "fixed";
            updateDialog(
              dialog,
              effectivePayload(payload, useFixed),
              ctx.currentWindow,
            );
            setActivePill(dialog, ctx.selectedView);
            ctx.dialogInitialized = true;
          }
          const originalLabel = copyImgBtn.textContent ?? "Copy chart as image";
          copyImgBtn.disabled = true;
          copyImgBtn.textContent = "Copying…";
          try {
            const captured = await captureDialogPng(
              dialog,
              payload,
              ctx.currentWindow,
            );
            if (!captured) throw new Error("capture failed");
            // Clipboard image-write is what we want — paste directly into
            // Substack / a Google Doc / a slide. Browsers without
            // ClipboardItem (old Firefox, ancient Safari) gracefully fall
            // back to a file download so the action still produces *something*.
            const clipboardOk = await copyImageToClipboard(captured.blob);
            let outcome: "clipboard" | "download";
            if (clipboardOk) {
              copyImgBtn.textContent = "Copied!";
              outcome = "clipboard";
            } else {
              downloadBlob(captured.blob, captured.filename);
              copyImgBtn.textContent = "Downloaded";
              outcome = "download";
            }
            setTimeout(() => {
              copyImgBtn.disabled = false;
              copyImgBtn.textContent = originalLabel;
            }, 1500);
            // Telemetry: image export is a strong intent signal. `outcome`
            // distinguishes clipboard from the older-browser download path
            // so we can see how often the fallback is hit.
            track("chart_image_copied", {
              chartId: payload.chartId ?? "",
              window: ctx.currentWindow,
              outcome,
              sources: payload.sources
                .map((s) => s.id)
                .slice(0, 8)
                .join(","),
            });
          } catch (err) {
            console.error("[copy image] failed:", err);
            copyImgBtn.textContent = "Failed";
            setTimeout(() => {
              copyImgBtn.disabled = false;
              copyImgBtn.textContent = originalLabel;
            }, 1500);
          }
        });
      }
    });

    const dashPills = document.querySelectorAll<HTMLButtonElement>(
      "[data-dashboard-window-control] button[data-dashboard-window]",
    );
    dashPills.forEach((pill) => {
      pill.addEventListener("click", () => {
        const want = pill.dataset.dashboardWindow as DeltaWindow | undefined;
        if (!want) return;
        dashPills.forEach((p) => {
          const active = p === pill;
          p.classList.toggle("pill-active", active);
          p.setAttribute("aria-pressed", active ? "true" : "false");
        });
        tileContexts.forEach((ctx) => {
          // Skip tiles that belong to a section with its own pinned
          // window override — those are explicitly locked to a
          // different window than the dashboard-wide one. Without
          // this skip, clicking the dashboard pill would silently
          // overwrite the section-pinned commentary's reading.
          if (ctx.tile.dataset.sectionLocked === "1") return;
          const w = closestSupported(want, ctx.payload.supportedDeltas);
          ctx.currentWindow = w;
          // Track the user's intent at the dashboard level so reopening
          // the dialog reflects the active selection, not the trailing
          // pre-click state.
          ctx.selectedView = w;
          // Update the per-tile + dialog "what the dashboard asked
          // for" memo so the window-mismatch bold-recompute inside
          // updateTile / updateDialog uses the fresh value. After
          // this, a tile whose data couldn't reach `want` will show
          // the duration in bold; one that could will render normally.
          ctx.tile.dataset.dashboardWindow = want;
          ctx.dialog.dataset.dashboardWindow = want;
          updateTile(ctx.tile, ctx.payload, w);
          if (ctx.dialogInitialized) {
            updateDialog(ctx.dialog, ctx.payload, w);
            // Mirror the dashboard-level pill state into the dialog's
            // per-chart pill row so the highlighted pill matches what's
            // actually plotted — otherwise the dialog shows stale
            // selection after a dashboard-level window change.
            setActivePill(ctx.dialog, w);
          }
        });
      });
    });

    // Phase 2 telemetry: emit a one-shot dashboard_perf_loaded event with
    // payload size, mode-mix (summary vs full), and timing. Lets us A/B
    // the bandwidth reduction in PostHog by comparing pre/post-deploy
    // medians, and spot regressions if a future change accidentally re-
    // bakes full data into the page payload.
    //
    // Deferred behind requestIdleCallback (with a setTimeout fallback)
    // so the synchronous hydrate path stays fast — the metrics we
    // capture are all already realized by the time hydrate returns.
    const emitDashboardPerf = () => {
      try {
        let summaryCount = 0;
        let fullCount = 0;
        let payloadBytes = 0;
        for (const ctx of tileContexts) {
          // Mode classification: a tile is "summary" iff every source
          // shipped only summary (no points); otherwise "full".
          const anyFull = ctx.payload.sources.some((s) => s.points);
          if (anyFull) fullCount += 1;
          else summaryCount += 1;
        }
        // Sum the JSON text lengths of every data-chart-payload script
        // on the page. This is the dominant cost the refactor targets,
        // so it's the headline metric.
        document
          .querySelectorAll<HTMLScriptElement>("script[data-chart-payload]")
          .forEach((el) => {
            payloadBytes += el.textContent?.length ?? 0;
          });
        // dom_content_loaded_ms: time from navigationStart to when the
        // browser fired DOMContentLoaded. Independent of our JS — gives
        // a fair "how heavy did this page actually feel" number.
        const nav = performance.getEntriesByType
          ? (performance.getEntriesByType("navigation")[0] as
              | PerformanceNavigationTiming
              | undefined)
          : undefined;
        const dclMs = nav
          ? Math.round(nav.domContentLoadedEventEnd)
          : null;
        // Surface = dashboard slug ("us-macro"), "custom", "u-<slug>",
        // or "chart". Taken off the dashboard-root or the first chart
        // payload as a fallback.
        const surface =
          dashRoot?.dataset.dashboardSlug ??
          tileContexts[0]?.payload.surface ??
          "unknown";
        track("dashboard_perf_loaded", {
          surface,
          chart_count: tileContexts.length,
          summary_mode_tiles: summaryCount,
          full_mode_tiles: fullCount,
          payload_bytes: payloadBytes,
          hydrate_ms: Math.round(performance.now() - hydrateStartMs),
          dom_content_loaded_ms: dclMs,
        });
      } catch {
        // Telemetry is fire-and-forget; never let it crash the page.
      }
    };
    if (typeof (window as any).requestIdleCallback === "function") {
      (window as any).requestIdleCallback(emitDashboardPerf, { timeout: 2000 });
    } else {
      setTimeout(emitDashboardPerf, 0);
    }

    let resizeTimer: number | undefined;
    window.addEventListener("resize", () => {
      if (resizeTimer) window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        tileContexts.forEach((ctx) => {
          const sparkEl = ctx.tile.querySelector<HTMLElement>(
            '[data-role="tile-spark"]',
          );
          if (!sparkEl) return;
          if (ctx.payload.isMulti) {
            renderSparkMulti(sparkEl, ctx.payload, ctx.currentWindow);
          } else {
            const s = ctx.payload.sources[0];
            if (s) {
              const eff = closestSupported(
                ctx.currentWindow,
                s.supportedDeltas,
              );
              renderSparkSingle(sparkEl, s, eff, undefined, ctx.payload.shading);
            }
          }
          // Mobile: when the user rotates their device with the
          // dialog open, the full plot stays sized to the previous
          // orientation. Re-render the dialog plot too so portrait
          // → landscape swaps the plot dimensions cleanly.
          if (ctx.dialogInitialized && ctx.dialog.open) {
            const plotEl = ctx.dialog.querySelector<HTMLElement>(
              "[data-role='plot']",
            );
            if (plotEl) {
              const useFixed = ctx.selectedView === "fixed";
              renderFullPlot(
                plotEl,
                effectivePayload(ctx.payload, useFixed),
                ctx.currentWindow,
              );
            }
          }
        });
      }, 150);
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", hydrate);
  } else {
    hydrate();
  }
</script>
