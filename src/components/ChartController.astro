---
// One-per-dashboard script. Hydrates every chart tile and dialog on the page:
//   - renders the (multi-)sparkline on each tile
//   - wires click -> dialog.showModal()
//   - renders the full chart on first dialog open
//   - handles the window-pill group (recompute reading/delta/descriptor/plot)
//   - handles the dashboard-level window selector with closest-supported fallback
//   - closes on backdrop click and the X button
---

<script>
  import * as Plot from "@observablehq/plot";
  import {
    DELTA_DAYS,
    DELTA_LABELS_PAST,
    closestSupported,
    type DeltaWindow,
  } from "../lib/deltas";
  import {
    formatValue,
    formatDelta,
    formatDeltaDisplay,
    type Formatting,
  } from "../lib/format";

  type Point = { t: string; v: number };
  type Direction = "up" | "down" | "flat";

  type SourcePayload = {
    id: string;
    name: string;
    shortName: string;
    color: string;
    points: Point[];
    formatting: Formatting;
    supportedDeltas: DeltaWindow[];
    emphasis: "level" | "change";
    lastUpdated: string;
  };

  type Payload = {
    isMulti: boolean;
    normalize: "rebase" | "raw" | "dual-axis";
    supportedDeltas: DeltaWindow[];
    defaultDelta: DeltaWindow;
    sources: SourcePayload[];
    // For dual-axis with 3+ sources or explicit assignment: source IDs that
    // plot on the right axis. Empty/missing → first source on left, rest right.
    rightAxisSources?: string[];
    // Fixed [start, end] date range. When set, overrides the trailing-window
    // mode entirely; tile delta and full plot both use these bounds.
    fixedRange?: { start: string; end: string };
  };

  function findPrior(points: Point[], targetMs: number): Point | null {
    if (points.length === 0) return null;
    if (new Date(points[0].t).getTime() > targetMs) return null;
    let best: Point = points[0];
    for (const p of points) {
      if (new Date(p.t).getTime() <= targetMs) best = p;
      else break;
    }
    return best;
  }

  function directionWord(d: Direction): string {
    return d === "up" ? "up" : d === "down" ? "down" : "roughly unchanged";
  }

  /**
   * Rebase a series to 100 at the window start. Baseline = latest point at or
   * before startMs; falls back to the earliest point if all points are after
   * startMs. This handles sparse (annual) series where no observation lies
   * exactly at the chosen window boundary.
   */
  function rebasePoints(points: Point[], startMs: number): Point[] {
    if (points.length === 0) return points;
    let baseline: number = points[0].v;
    for (const p of points) {
      if (new Date(p.t).getTime() <= startMs) baseline = p.v;
      else break;
    }
    if (baseline === 0) return points;
    return points.map((p) => ({ t: p.t, v: (p.v / baseline) * 100 }));
  }

  function visibleRange(
    points: Point[],
    window: DeltaWindow,
    leadIn = 0.15,
  ): { visible: Point[]; startMs: number } {
    const last = points[points.length - 1];
    const startMs = new Date(last.t).getTime() - DELTA_DAYS[window] * 86400000;
    const visibleStart = startMs - DELTA_DAYS[window] * 86400000 * leadIn;
    const visible = points.filter(
      (p) => new Date(p.t).getTime() >= visibleStart,
    );
    return { visible, startMs };
  }

  // Same shape as visibleRange but driven by a fixed [start, end] range.
  // No lead-in buffer at the trailing edge — we want the rendered window
  // to end exactly at `end`, even if the source has more recent points.
  function visibleRangeFixed(
    points: Point[],
    startMs: number,
    endMs: number,
  ): { visible: Point[]; startMs: number } {
    const visible = points.filter((p) => {
      const t = new Date(p.t).getTime();
      return t >= startMs && t <= endMs;
    });
    return { visible, startMs };
  }

  function renderSparkSingle(
    container: HTMLElement,
    source: SourcePayload,
    window: DeltaWindow,
    fixed?: { start: string; end: string },
  ): void {
    if (source.points.length < 2) return;
    const { visible } = fixed
      ? visibleRangeFixed(
          source.points,
          new Date(fixed.start).getTime(),
          new Date(fixed.end).getTime(),
        )
      : visibleRange(source.points, window, 0);
    if (visible.length < 2) return;

    const width = container.clientWidth || 220;
    const plot = Plot.plot({
      height: 36,
      width,
      axis: null,
      marginLeft: 0,
      marginRight: 0,
      marginTop: 2,
      marginBottom: 2,
      marks: [
        Plot.lineY(visible, {
          x: (p: Point) => new Date(p.t),
          y: "v",
          stroke: source.color,
          strokeWidth: 1.5,
        }),
      ],
    });
    container.replaceChildren(plot);
  }

  function renderSparkMulti(
    container: HTMLElement,
    payload: Payload,
    window: DeltaWindow,
  ): void {
    const fixed = payload.fixedRange;
    const fStart = fixed ? new Date(fixed.start).getTime() : 0;
    const fEnd = fixed ? new Date(fixed.end).getTime() : 0;
    const width = container.clientWidth || 220;
    const marks: any[] = [];
    for (const s of payload.sources) {
      const eff = closestSupported(window, s.supportedDeltas);
      const { visible, startMs } = fixed
        ? visibleRangeFixed(s.points, fStart, fEnd)
        : visibleRange(s.points, eff, 0);
      if (visible.length < 2) continue;
      const pts =
        payload.normalize === "rebase"
          ? rebasePoints(visible, startMs)
          : visible;
      marks.push(
        Plot.lineY(pts, {
          x: (p: Point) => new Date(p.t),
          y: "v",
          stroke: s.color,
          strokeWidth: 1.25,
        }),
      );
    }
    const plot = Plot.plot({
      height: 48,
      width,
      axis: null,
      marginLeft: 0,
      marginRight: 0,
      marginTop: 2,
      marginBottom: 2,
      marks,
    });
    container.replaceChildren(plot);
  }

  function renderFullPlot(
    container: HTMLElement,
    payload: Payload,
    window: DeltaWindow,
  ): void {
    const width = container.clientWidth || 700;

    // Dual-axis: at least 2 sources, partition into left and right groups
    // by rightAxisSources (or default = first source left, rest right).
    if (
      payload.normalize === "dual-axis" &&
      payload.sources.length >= 2
    ) {
      const explicit = payload.rightAxisSources ?? [];
      const rightSet = new Set(
        explicit.length > 0
          ? explicit
          : payload.sources.slice(1).map((s) => s.id),
      );
      const leftSrcs = payload.sources.filter((s) => !rightSet.has(s.id));
      const rightSrcs = payload.sources.filter((s) => rightSet.has(s.id));
      // Need at least one series on each side; otherwise fall through to the
      // generic non-dual-axis branch below.
      if (leftSrcs.length > 0 && rightSrcs.length > 0) {
        const fixed = payload.fixedRange;
        const fStart = fixed ? new Date(fixed.start).getTime() : 0;
        const fEnd = fixed ? new Date(fixed.end).getTime() : 0;
        // Materialize visible ranges per source — fixed range when set, else
        // window-based.
        const matLeft = leftSrcs.map((s) => {
          if (fixed) return { s, ...visibleRangeFixed(s.points, fStart, fEnd) };
          const eff = closestSupported(window, s.supportedDeltas);
          return { s, ...visibleRange(s.points, eff, 0.15) };
        });
        const matRight = rightSrcs.map((s) => {
          if (fixed) return { s, ...visibleRangeFixed(s.points, fStart, fEnd) };
          const eff = closestSupported(window, s.supportedDeltas);
          return { s, ...visibleRange(s.points, eff, 0.15) };
        });
        const haveLeft = matLeft.some((m) => m.visible.length >= 2);
        const haveRight = matRight.some((m) => m.visible.length >= 2);
        if (haveLeft && haveRight) {
          const flatL = matLeft.flatMap((m) => m.visible.map((p) => p.v));
          const flatR = matRight.flatMap((m) => m.visible.map((p) => p.v));
          const lMin = Math.min(...flatL);
          const lMax = Math.max(...flatL);
          const rMin = Math.min(...flatR);
          const rMax = Math.max(...flatR);
          const dL = lMax - lMin || 1;
          const dR = rMax - rMin || 1;
          const rescaleR = (v: number) => lMin + ((v - rMin) / dR) * dL;
          const unscaleR = (yPos: number) =>
            rMin + ((yPos - lMin) / dL) * dR;
          const marks: any[] = [];
          for (const m of matLeft) {
            if (m.visible.length < 2) continue;
            const pts = m.visible.map((p) => ({ t: new Date(p.t), v: p.v }));
            marks.push(
              Plot.lineY(pts, {
                x: "t",
                y: "v",
                stroke: m.s.color,
                strokeWidth: 1.75,
              }),
              Plot.dot(pts.slice(-1), {
                x: "t",
                y: "v",
                fill: m.s.color,
                r: 3.5,
              }),
            );
          }
          for (const m of matRight) {
            if (m.visible.length < 2) continue;
            const pts = m.visible.map((p) => ({
              t: new Date(p.t),
              v: rescaleR(p.v),
            }));
            marks.push(
              Plot.lineY(pts, {
                x: "t",
                y: "v",
                stroke: m.s.color,
                strokeWidth: 1.75,
              }),
              Plot.dot(pts.slice(-1), {
                x: "t",
                y: "v",
                fill: m.s.color,
                r: 3.5,
              }),
            );
          }
          // Axis colors: when only one series on a side, color the axis to
          // match. With multiple, keep neutral so it doesn't claim allegiance.
          const leftAxisColor =
            leftSrcs.length === 1 ? leftSrcs[0].color : "#55524C";
          const rightAxisColor =
            rightSrcs.length === 1 ? rightSrcs[0].color : "#55524C";
          // Tick formatting picks formatting from the single side-source if
          // unique, otherwise just compact numeric.
          const leftFmt = leftSrcs[0]?.formatting;
          const rightFmt = rightSrcs[0]?.formatting;
          marks.push(
            Plot.axisY({
              anchor: "left",
              color: leftAxisColor,
              ticks: 5,
              tickFormat: (v: number) =>
                formatValue(v, { ...leftFmt, decimals: 1 }),
            }),
            Plot.axisY({
              anchor: "right",
              color: rightAxisColor,
              ticks: 5,
              tickFormat: (v: number) =>
                formatValue(unscaleR(v), { ...rightFmt, decimals: 1 }),
            }),
          );
          const plot = Plot.plot({
            height: 280,
            width,
            marginLeft: 64,
            marginBottom: 28,
            marginTop: 10,
            marginRight: 64,
            style: {
              fontFamily:
                '"Inter Variable", Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif',
              fontSize: "12px",
              color: "#55524C",
              background: "transparent",
            },
            x: { label: null, ticks: 5 },
            y: { label: null, grid: true, ticks: 5 },
            marks,
          });
          container.replaceChildren(plot);
          return;
        }
      }
      // If we get here, the dual-axis split was degenerate; fall through.
    }

    const marks: any[] = [];
    let dashStartDrawn = false;
    const fixed = payload.fixedRange;
    const fStart = fixed ? new Date(fixed.start).getTime() : 0;
    const fEnd = fixed ? new Date(fixed.end).getTime() : 0;
    for (const s of payload.sources) {
      const eff = closestSupported(window, s.supportedDeltas);
      const { visible, startMs } = fixed
        ? visibleRangeFixed(s.points, fStart, fEnd)
        : visibleRange(s.points, eff, 0.15);
      if (visible.length < 2) continue;
      const rebase = payload.normalize === "rebase" && payload.isMulti;
      const pts = rebase ? rebasePoints(visible, startMs) : visible;
      if (!dashStartDrawn) {
        marks.push(
          Plot.ruleX([new Date(startMs)], {
            stroke: "#DCDCDA",
            strokeDasharray: "3,3",
          }),
        );
        dashStartDrawn = true;
      }
      marks.push(
        Plot.lineY(pts, {
          x: (p: Point) => new Date(p.t),
          y: "v",
          stroke: s.color,
          strokeWidth: 1.75,
        }),
        Plot.dot(pts.slice(-1), {
          x: (p: Point) => new Date(p.t),
          y: "v",
          fill: s.color,
          r: 3.5,
        }),
      );
    }
    // For single-source plots, use the source's own formatting for y-axis ticks
    // so big numbers compact down to "$3T" etc. For multi-source rebased, leave
    // default (values are always around 100).
    const singleSource =
      !payload.isMulti && payload.sources.length === 1
        ? payload.sources[0]
        : null;
    const tickFormat = singleSource
      ? (v: number) => formatValue(v, { ...singleSource.formatting, decimals: 1 })
      : undefined;

    const plot = Plot.plot({
      height: 280,
      width,
      marginLeft: 64,
      marginBottom: 28,
      marginTop: 10,
      marginRight: 16,
      style: {
        fontFamily:
          '"Inter Variable", Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif',
        fontSize: "12px",
        color: "#55524C",
        background: "transparent",
      },
      x: { label: null, ticks: 5 },
      y: { label: null, grid: true, ticks: 5, tickFormat },
      marks,
    });
    container.replaceChildren(plot);
  }

  function updateTile(
    tile: HTMLElement,
    payload: Payload,
    window: DeltaWindow,
  ): void {
    const fixed = payload.fixedRange;
    const captionEl = tile.querySelector<HTMLElement>(".tile-window");
    if (captionEl) {
      if (fixed) {
        captionEl.textContent = `${fixed.start} → ${fixed.end}`;
      } else {
        captionEl.textContent = `over the ${DELTA_LABELS_PAST[window]}`;
      }
    }

    const sparkEl = tile.querySelector<HTMLElement>(
      '[data-role="tile-spark"]',
    );

    // For fixed-range, current = last point ≤ end; prior = last point ≤ start.
    const fStart = fixed ? new Date(fixed.start).getTime() : 0;
    const fEnd = fixed ? new Date(fixed.end).getTime() : 0;
    function pickFixed(points: Point[]): { current: Point | null; prior: Point | null } {
      let current: Point | null = null;
      let prior: Point | null = null;
      for (const p of points) {
        const t = new Date(p.t).getTime();
        if (t <= fEnd) current = p;
        if (t <= fStart) prior = p;
        else if (t > fEnd) break;
      }
      return { current, prior };
    }

    if (payload.isMulti) {
      for (const s of payload.sources) {
        const eff = closestSupported(window, s.supportedDeltas);
        let current: Point | null;
        let prior: Point | null;
        if (fixed) {
          ({ current, prior } = pickFixed(s.points));
        } else {
          const last = s.points[s.points.length - 1];
          if (!last) continue;
          current = last;
          const priorMs =
            new Date(last.t).getTime() - DELTA_DAYS[eff] * 86400000;
          prior = findPrior(s.points, priorMs);
        }
        const row = tile.querySelector<HTMLElement>(
          `[data-role="series-delta"][data-source-id="${CSS.escape(s.id)}"]`,
        );
        if (row) {
          if (current && prior) {
            const dd = formatDeltaDisplay(current.v, prior.v, s.formatting);
            row.textContent = dd.text;
            row.dataset.direction = dd.direction;
          } else {
            row.textContent = "—";
            row.dataset.direction = "flat";
          }
        }
      }
      if (sparkEl) renderSparkMulti(sparkEl, payload, window);
    } else {
      const s = payload.sources[0];
      if (!s || s.points.length === 0) return;
      const eff = closestSupported(window, s.supportedDeltas);
      let current: Point | null;
      let prior: Point | null;
      if (fixed) {
        ({ current, prior } = pickFixed(s.points));
      } else {
        const last = s.points[s.points.length - 1];
        current = last;
        const priorMs =
          new Date(last.t).getTime() - DELTA_DAYS[eff] * 86400000;
        prior = findPrior(s.points, priorMs);
      }

      const valEl = tile.querySelector<HTMLElement>('[data-role="tile-value"]');
      if (valEl)
        valEl.textContent = current ? formatValue(current.v, s.formatting) : "—";

      const deltaEl = tile.querySelector<HTMLElement>(
        '[data-role="tile-delta"]',
      );
      if (deltaEl && current && prior) {
        const dd = formatDeltaDisplay(current.v, prior.v, s.formatting);
        deltaEl.textContent = dd.text;
        deltaEl.dataset.direction = dd.direction;
      } else if (deltaEl) {
        deltaEl.textContent = "";
      }

      if (sparkEl) renderSparkSingle(sparkEl, s, eff, fixed);
    }
  }

  function updateDialog(
    dialog: HTMLDialogElement,
    payload: Payload,
    window: DeltaWindow,
  ): void {
    const fixed = payload.fixedRange;
    const fStart = fixed ? new Date(fixed.start).getTime() : 0;
    const fEnd = fixed ? new Date(fixed.end).getTime() : 0;
    function pickFixed(points: Point[]): { current: Point | null; prior: Point | null } {
      let current: Point | null = null;
      let prior: Point | null = null;
      for (const p of points) {
        const t = new Date(p.t).getTime();
        if (t <= fEnd) current = p;
        if (t <= fStart) prior = p;
        else if (t > fEnd) break;
      }
      return { current, prior };
    }

    if (payload.isMulti) {
      for (const s of payload.sources) {
        const eff = closestSupported(window, s.supportedDeltas);
        let current: Point | null;
        let prior: Point | null;
        if (fixed) {
          ({ current, prior } = pickFixed(s.points));
        } else {
          const last = s.points[s.points.length - 1];
          if (!last) continue;
          current = last;
          const priorMs =
            new Date(last.t).getTime() - DELTA_DAYS[eff] * 86400000;
          prior = findPrior(s.points, priorMs);
        }
        const row = dialog.querySelector<HTMLElement>(
          `.multi-readout-row[data-source-id="${CSS.escape(s.id)}"]`,
        );
        if (!row) continue;
        const levelEl = row.querySelector<HTMLElement>(
          '[data-role="readout-level"]',
        );
        const deltaEl = row.querySelector<HTMLElement>(
          '[data-role="readout-delta"]',
        );
        if (levelEl)
          levelEl.textContent = current ? formatValue(current.v, s.formatting) : "—";
        if (deltaEl) {
          if (current && prior) {
            const dd = formatDeltaDisplay(current.v, prior.v, s.formatting);
            deltaEl.textContent = dd.text;
            deltaEl.dataset.direction = dd.direction;
          } else {
            deltaEl.textContent = "—";
            deltaEl.dataset.direction = "flat";
          }
        }
      }
      const captionEl = dialog.querySelector<HTMLElement>(
        '[data-role="descriptor"]',
      );
      if (captionEl) {
        captionEl.textContent = fixed
          ? `${fixed.start} → ${fixed.end}.`
          : `Over the ${DELTA_LABELS_PAST[window]}.`;
      }
    } else {
      const s = payload.sources[0];
      if (!s) return;
      const eff = closestSupported(window, s.supportedDeltas);
      let current: Point | null;
      let prior: Point | null;
      if (fixed) {
        ({ current, prior } = pickFixed(s.points));
      } else {
        const last = s.points[s.points.length - 1];
        current = last;
        const priorMs =
          new Date(last.t).getTime() - DELTA_DAYS[eff] * 86400000;
        prior = findPrior(s.points, priorMs);
      }

      const currentStr = current ? formatValue(current.v, s.formatting) : "—";
      const valEl = dialog.querySelector<HTMLElement>('[data-role="value"]');
      if (valEl) valEl.textContent = currentStr;

      const deltaEl = dialog.querySelector<HTMLElement>(
        '[data-role="delta-pct"]',
      );
      const descriptorEl = dialog.querySelector<HTMLElement>(
        '[data-role="descriptor"]',
      );

      if (current && prior) {
        const dd = formatDeltaDisplay(current.v, prior.v, s.formatting);
        if (deltaEl) {
          deltaEl.textContent = dd.text;
          deltaEl.dataset.direction = dd.direction;
        }
        const priorStr = formatValue(prior.v, s.formatting);
        const periodPhrase = fixed
          ? `from ${fixed.start} to ${fixed.end}`
          : `over the ${DELTA_LABELS_PAST[eff]}`;
        if (descriptorEl) {
          descriptorEl.textContent =
            dd.direction === "flat"
              ? `${s.name} is at ${currentStr}, roughly unchanged ${periodPhrase}.`
              : `${s.name} is at ${currentStr}, ${directionWord(dd.direction)} from ${priorStr} ${periodPhrase} (${dd.text}).`;
        }
      } else {
        if (deltaEl) {
          deltaEl.textContent = "";
          deltaEl.dataset.direction = "flat";
        }
        if (descriptorEl) {
          const periodPhrase = fixed
            ? `the range ${fixed.start} → ${fixed.end}`
            : `the ${DELTA_LABELS_PAST[eff]}`;
          descriptorEl.textContent = `${s.name} is at ${currentStr}. History doesn't cover ${periodPhrase}.`;
        }
      }
    }

    const plotEl = dialog.querySelector<HTMLElement>('[data-role="plot"]');
    if (plotEl) renderFullPlot(plotEl, payload, window);

    dialog
      .querySelectorAll<HTMLButtonElement>("button[data-window]")
      .forEach((p) => {
        const active = p.dataset.window === window;
        p.classList.toggle("pill-active", active);
        p.setAttribute("aria-pressed", active ? "true" : "false");
      });
  }

  interface TileCtx {
    tile: HTMLElement;
    dialog: HTMLDialogElement;
    payload: Payload;
    currentWindow: DeltaWindow;
    dialogInitialized: boolean;
  }

  function hydrate(): void {
    const dashRoot = document.querySelector<HTMLElement>(".dashboard-root");
    const dashDefault = (dashRoot?.dataset.dashboardDefaultWindow ??
      "1m") as DeltaWindow;

    const tileContexts: TileCtx[] = [];
    const tiles = document.querySelectorAll<HTMLElement>(
      ".chart-tile[data-chart-ref]",
    );
    tiles.forEach((tile) => {
      const ref = tile.dataset.chartRef;
      if (!ref) return;
      const dialog = document.getElementById(ref);
      if (!(dialog instanceof HTMLDialogElement)) return;

      const payloadEl = dialog.querySelector<HTMLScriptElement>(
        "script[data-chart-payload]",
      );
      if (!payloadEl?.textContent) return;
      let payload: Payload;
      try {
        payload = JSON.parse(payloadEl.textContent);
      } catch {
        return;
      }

      const ctx: TileCtx = {
        tile,
        dialog,
        payload,
        currentWindow: closestSupported(dashDefault, payload.supportedDeltas),
        dialogInitialized: false,
      };
      tileContexts.push(ctx);
      updateTile(tile, payload, ctx.currentWindow);

      tile.addEventListener("click", () => {
        dialog.showModal();
        if (!ctx.dialogInitialized) {
          updateDialog(dialog, payload, ctx.currentWindow);
          ctx.dialogInitialized = true;
        }
      });

      dialog
        .querySelectorAll<HTMLButtonElement>("button[data-window]")
        .forEach((pill) => {
          pill.addEventListener("click", (e) => {
            e.stopPropagation();
            const w = pill.dataset.window as DeltaWindow | undefined;
            if (w) {
              ctx.currentWindow = w;
              updateDialog(dialog, payload, w);
            }
          });
        });

      dialog.addEventListener("click", (e) => {
        if (e.target === dialog) dialog.close();
      });

      const closeBtn = dialog.querySelector<HTMLElement>(".dialog-close");
      if (closeBtn) {
        closeBtn.addEventListener("click", () => dialog.close());
      }
    });

    const dashPills = document.querySelectorAll<HTMLButtonElement>(
      "[data-dashboard-window-control] button[data-dashboard-window]",
    );
    dashPills.forEach((pill) => {
      pill.addEventListener("click", () => {
        const want = pill.dataset.dashboardWindow as DeltaWindow | undefined;
        if (!want) return;
        dashPills.forEach((p) => {
          const active = p === pill;
          p.classList.toggle("pill-active", active);
          p.setAttribute("aria-pressed", active ? "true" : "false");
        });
        tileContexts.forEach((ctx) => {
          const w = closestSupported(want, ctx.payload.supportedDeltas);
          ctx.currentWindow = w;
          updateTile(ctx.tile, ctx.payload, w);
          if (ctx.dialogInitialized) {
            updateDialog(ctx.dialog, ctx.payload, w);
          }
        });
      });
    });

    let resizeTimer: number | undefined;
    window.addEventListener("resize", () => {
      if (resizeTimer) window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        tileContexts.forEach((ctx) => {
          const sparkEl = ctx.tile.querySelector<HTMLElement>(
            '[data-role="tile-spark"]',
          );
          if (!sparkEl) return;
          if (ctx.payload.isMulti) {
            renderSparkMulti(sparkEl, ctx.payload, ctx.currentWindow);
          } else {
            const s = ctx.payload.sources[0];
            if (s) {
              const eff = closestSupported(
                ctx.currentWindow,
                s.supportedDeltas,
              );
              renderSparkSingle(sparkEl, s, eff);
            }
          }
        });
      }, 150);
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", hydrate);
  } else {
    hydrate();
  }
</script>
