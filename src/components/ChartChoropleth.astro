---
/**
 * Choropleth (heatmap) chart tile.
 *
 * Renders one US map colored by an ACS indicator at a given vintage,
 * at one of four geographic granularities (state / county / tract /
 * block-group). State + county data is nationwide; tract + block-group
 * is sharded by state and may be further clipped via `bbox`.
 *
 * Flow:
 *   1. At build time (this frontmatter) we resolve the data file path
 *      from the chart's (geo, indicator, vintage, state) fields and
 *      read it server-side so the tile ships with the min/max range
 *      already known. Saves a roundtrip on first paint.
 *   2. We DON'T embed the full values map into the tile HTML —
 *      hundreds of regions × multiple tiles on a dashboard would
 *      bloat the page. The map renders client-side after fetching
 *      the values + the boundary TopoJSON.
 *   3. Boundary TopoJSON for state + county comes from us-atlas (one
 *      shared file at /maps/us-counties-albers-10m.json, contains
 *      both states + counties). Tract + block-group will be
 *      state-sharded TopoJSONs when those pipelines run.
 *
 * The tile is fixed at the chart's author-specified vintage. The
 * expanded dialog includes a year slider that swaps in sibling
 * vintages of the same indicator (server-side discovery globs the
 * data dir; slider hides when only one vintage is available).
 */
import type { CollectionEntry } from "astro:content";
import { promises as fs } from "node:fs";
import { join } from "node:path";

type ChartData = CollectionEntry<"charts">["data"];

interface Props {
  chartId: string;
  chart: ChartData;
  dashboardSlug: string;
}

const { chartId, chart, dashboardSlug } = Astro.props;

// Resolve the data file path from the chart's choropleth fields. The
// pipeline writes:
//   public/data/acs_state/<indicator>_<vintage>.json
//   public/data/acs_county/<indicator>_<vintage>.json
//   public/data/acs_tract/<state>/<indicator>_<vintage>.json
//   public/data/acs_block_group/<state>/<indicator>_<vintage>.json
const geo = chart.geo!;        // refine() above guarantees non-empty
const indicator = chart.indicator!;
const vintage = chart.vintage!;
const stateCodes: string[] =
  (chart.states && chart.states.length > 0
    ? chart.states.map((s) => s.toLowerCase())
    : chart.state
      ? [chart.state.toLowerCase()]
      : []);
const dataDirSeg = geo === "block-group" ? "acs_block_group" : `acs_${geo}`;
// For state + county the data is one file shared across the country.
// For tract + block-group we have per-state shards; multi-state
// charts (e.g. DMV tracts = VA + MD + DC) load each shard
// client-side and merge in the renderer.
const dataFileRels: string[] =
  geo === "state" || geo === "county"
    ? [`data/${dataDirSeg}/${indicator}_${vintage}.json`]
    : stateCodes.map(
        (st) => `data/${dataDirSeg}/${st}/${indicator}_${vintage}.json`,
      );
// Client-facing data URLs. The server-side summary reads
// dataFileRels directly off disk; the client fetches the URLs
// version through choropleth-canvas's data-data-urls attr.
const dataFileUrls = dataFileRels.map((r) => `/${r}`);

// Year-slider discovery. Glob the data directory for sibling
// vintages of the same (geo, indicator). For tract / block-group
// where data is sharded across states, the slider should only offer
// vintages present in ALL shards (otherwise switching to that year
// would render an incomplete-coverage map without warning the user
// the slider position is meaningful).
async function discoverVintages(): Promise<string[]> {
  const indicatorRe = new RegExp(
    `^${indicator.replace(/[.*+?^${}()|[\\]\\\\]/g, "\\$&")}_(\\d{4})\\.json$`,
  );
  function pickVintages(files: string[]): string[] {
    const out: string[] = [];
    for (const f of files) {
      const m = f.match(indicatorRe);
      if (m) out.push(m[1]);
    }
    return out.sort();
  }
  if (geo === "state" || geo === "county") {
    try {
      const files = await fs.readdir(
        join(process.cwd(), "public", "data", dataDirSeg),
      );
      return pickVintages(files);
    } catch { return []; }
  }
  // tract / block-group: intersection across state shards.
  const perState: string[][] = [];
  for (const st of stateCodes) {
    try {
      const files = await fs.readdir(
        join(process.cwd(), "public", "data", dataDirSeg, st),
      );
      perState.push(pickVintages(files));
    } catch { perState.push([]); }
  }
  if (perState.length === 0) return [];
  // If any shard has no data at all, intersection would be empty —
  // fall back to the union so the slider at least lets the user step
  // through whatever any state has (the renderer's missing-shard
  // path handles per-state gaps gracefully).
  const anyEmpty = perState.some((arr) => arr.length === 0);
  if (anyEmpty) {
    const union = new Set<string>();
    perState.forEach((arr) => arr.forEach((v) => union.add(v)));
    return [...union].sort();
  }
  let acc = perState[0];
  for (let i = 1; i < perState.length; i++) {
    const s = new Set(perState[i]);
    acc = acc.filter((v) => s.has(v));
  }
  return acc;
}
const availableVintages = await discoverVintages();

// Read the data file server-side so we can compute headline numbers
// (min, max, median) for the tile eyebrow + render an accurate legend
// scale without a client roundtrip on first paint.
//
// Note: we only ship the SUMMARY values into the tile HTML — full
// values map gets fetched client-side. Saves dashboard payload size.
interface SnapshotShape {
  geo: string;
  indicator: string;
  vintage: string;
  unit: string;
  decimals: number;
  valueLabel: string;
  lastUpdated: string;
  stateCode?: string;
  values: Record<string, number>;
}

let summary: {
  min: number;
  max: number;
  median: number;
  count: number;
  unit: string;
  decimals: number;
  valueLabel: string;
  lastUpdated: string;
} | null = null;
let loadError: string | null = null;
try {
  // Server-side summary read: load every shard the client would
  // load too, merge the values, and compute aggregate stats. Means
  // the tile eyebrow's range/median is accurate for multi-state
  // tract maps (e.g. DMV = VA + MD + DC merged) without waiting on
  // the client-side fetches to land.
  const mergedValues: Record<string, number> = {};
  let unit = "";
  let decimals = 0;
  let valueLabel = "";
  let lastUpdated = "";
  // Track how many shards were attempted vs. how many readable, so
  // the eyebrow can say "data not yet fetched" (zero shards read)
  // vs "no values in this region" (shards read but bbox empty).
  let shardsAttempted = 0;
  let shardsReadable = 0;
  for (const rel of dataFileRels) {
    shardsAttempted++;
    try {
      const raw = await fs.readFile(join(process.cwd(), "public", rel), "utf-8");
      const parsed = JSON.parse(raw) as SnapshotShape;
      shardsReadable++;
      Object.assign(mergedValues, parsed.values);
      // Use the first shard's metadata fields; they should be
      // identical across shards since they come from the same
      // pipeline run with the same indicator config.
      if (!unit) {
        unit = parsed.unit;
        decimals = parsed.decimals;
        valueLabel = parsed.valueLabel;
        lastUpdated = parsed.lastUpdated;
      }
    } catch {
      // Skip missing shards — they fill on the next workflow run.
      // The renderer paints whatever's available; the user sees a
      // partial map with the missing regions blank.
    }
  }
  // For tract / block-group charts with a bbox, the boundary file
  // is pre-filtered to features whose bounding box intersects the
  // chart's bbox — only those features actually get rendered on the
  // client. To keep the eyebrow's count/range/median honest about
  // what the user sees, restrict the stats to those features rather
  // than reporting the full multi-state dataset.
  let effectiveValues: Record<string, number> = mergedValues;
  if (
    (geo === "tract" || geo === "block-group") &&
    chart.boundaryFile &&
    chart.bbox
  ) {
    try {
      const boundaryPath = join(
        process.cwd(),
        "public",
        chart.boundaryFile.replace(/^\//, ""),
      );
      const boundaryRaw = await fs.readFile(boundaryPath, "utf-8");
      const boundaryJson = JSON.parse(boundaryRaw) as {
        objects: Record<
          string,
          { geometries?: Array<{ id?: string; properties?: { id?: string } }> }
        >;
      };
      // Boundary IDs may live at top-level or under properties.id —
      // mirror the renderer's normalization.
      const boundaryIds = new Set<string>();
      for (const layer of Object.values(boundaryJson.objects ?? {})) {
        for (const g of layer.geometries ?? []) {
          const id = g.id ?? g.properties?.id;
          if (id) boundaryIds.add(id);
        }
      }
      const filtered: Record<string, number> = {};
      for (const [id, v] of Object.entries(mergedValues)) {
        if (boundaryIds.has(id)) filtered[id] = v;
      }
      // Only swap in the filtered set if we actually got a non-empty
      // intersection — otherwise fall through to the unfiltered set
      // so a misconfigured boundaryFile doesn't accidentally blank
      // the eyebrow.
      if (Object.keys(filtered).length > 0) {
        effectiveValues = filtered;
      }
    } catch {
      // Boundary file unreadable — keep the unfiltered stats.
    }
  }
  const vals = Object.values(effectiveValues).filter(
    (v): v is number => typeof v === "number" && Number.isFinite(v),
  );
  if (vals.length === 0) {
    // Distinguish "data not yet fetched" (no shards readable on
    // disk — most likely cause: the workflow hasn't run since the
    // chart was added) from "data here but nothing in the bbox"
    // (rare; suggests the bbox is mis-specified). Specific phrasing
    // helps the reader know whether to wait for a workflow run or
    // fix the chart YAML.
    if (shardsAttempted > 0 && shardsReadable === 0) {
      loadError = "data not yet fetched (will populate on next workflow run)";
    } else {
      loadError = "no values in snapshot";
    }
  } else {
    vals.sort((a, b) => a - b);
    summary = {
      min: vals[0],
      max: vals[vals.length - 1],
      median: vals[Math.floor(vals.length / 2)],
      count: vals.length,
      unit,
      decimals,
      valueLabel,
      lastUpdated,
    };
  }
} catch (e) {
  loadError = `data file unreadable: ${(e as Error).message}`;
}

function fmt(v: number, unit: string, decimals: number): string {
  if (unit === "USD") {
    return v.toLocaleString("en-US", {
      style: "currency",
      currency: "USD",
      maximumFractionDigits: 0,
    });
  }
  const rounded = v.toFixed(decimals);
  return unit === "%" ? `${rounded}%` : rounded;
}

const tileTitle = chart.title;
// Boundary file: state + county reuse the bundled US-wide file from
// us-atlas. Tract + block-group come from chart-specified TopoJSON
// (generated by mapshaper from Census Cartographic Boundary
// shapefiles). The TopoJSON's `objects` map must contain a layer
// named "states", "counties", "tracts", or "block_groups" to match
// the geo dispatch in the client paint().
// us-counties-2024-10m.json: cb_2024 Census Cartographic Boundary
// file, mapshaper-simplified, contains state + county layers. Newer
// than us-atlas's vintage so CT's 2022 Planning Region county FIPS
// (09110..09190) are present — the us-atlas file still has CT's old
// county FIPS (09001..09015) which no longer match ACS API output.
const defaultBoundary =
  geo === "state" || geo === "county"
    ? "/maps/us-counties-2024-10m.json"
    : "";
const boundaryUrl = chart.boundaryFile ?? defaultBoundary;
const bbox = chart.bbox ?? null;
const colorScheme = chart.colorScheme ?? "blues";
const colorScale = chart.colorScale ?? "linear";
const bboxJson = bbox ? JSON.stringify(bbox) : "null";
const dataUrlsJson = JSON.stringify(dataFileUrls);
const vintagesJson = JSON.stringify(availableVintages);
const statesJoined = stateCodes.join(",");
---

<article
  class="chart-tile choro-tile"
  data-chart-id={chartId}
  data-dashboard-slug={dashboardSlug}
  data-role="chart-tile"
  data-choro="1"
>
  <header class="chart-tile-header">
    <h3 class="chart-tile-title">{tileTitle}</h3>
    {summary && (
      <p class="choro-eyebrow muted small">
        {summary.count} {geo === "state" ? "states" : geo === "county" ? "counties" : geo === "tract" ? "tracts" : "block groups"}
        {" · range "}
        {fmt(summary.min, summary.unit, summary.decimals)}
        {" – "}
        {fmt(summary.max, summary.unit, summary.decimals)}
        {" · median "}
        {fmt(summary.median, summary.unit, summary.decimals)}
      </p>
    )}
    {!summary && loadError && (
      <p class="choro-eyebrow muted small text-error">
        Data unavailable: {loadError}
      </p>
    )}
  </header>
  <div
    class="choro-canvas"
    data-role="choro-canvas"
    data-chart-id={chartId}
    data-data-urls={dataUrlsJson}
    data-boundary-url={boundaryUrl}
    data-geo={geo}
    data-state={stateCodes[0] ?? ""}
    data-states={statesJoined}
    data-bbox={bboxJson}
    data-color-scheme={colorScheme}
    data-color-scale={colorScale}
    data-value-label={summary?.valueLabel ?? ""}
    data-unit={summary?.unit ?? ""}
    data-decimals={summary?.decimals ?? 1}
    data-mode="tile"
    data-indicator={indicator}
    data-data-dir-seg={dataDirSeg}
    data-vintages={vintagesJson}
    data-vintage={vintage}
    data-skip-hydrate={summary ? undefined : "1"}
  >
    {!summary && loadError && (
      <p class="muted small">{loadError}</p>
    )}
  </div>
  {/*
    No "Updated X" footer on the tile — too much visual clutter for
    something users almost never act on. Expanded view shows it.
    Hover-on-tile shows region name + value via a fixed tooltip
    (wired by the script below).
  */}
</article>

<script>
  // Client-side renderer. Fetches the snapshot values + the boundary
  // TopoJSON in parallel, then paints a colored map via Observable
  // Plot's geo mark. Idempotent — safe to run twice if the user
  // navigates back to a cached page.
  import * as Plot from "@observablehq/plot";
  import * as topojson from "topojson-client";
  // d3-zoom + d3-selection are pulled from the umbrella d3 package
  // (transitive deps but published as part of d3 itself). Importing
  // from "d3" rather than the submodules keeps package.json tidy and
  // sidesteps the phantom-dep lint.
  import { select as d3select, zoom as d3zoom, zoomIdentity } from "d3";
  import type { ZoomBehavior, ZoomTransform } from "d3-zoom";

  type ChoroBindings = {
    chartId: string;
    dataUrls: string[];   // 1+ shard files merged client-side
    boundaryUrl: string;
    geo: "state" | "county" | "tract" | "block-group";
    state: string;
    bbox: [number, number, number, number] | null;
    colorScheme: string;
    colorScale: "linear" | "log";
    valueLabel: string;
    unit: string;
    decimals: number;
  };

  // ---- Color scheme catalog ----
  // The list users see in the dropdown. Sequential mono-hue ramps +
  // two perceptually-uniform multi-hue options. Deliberately no
  // rainbow / sinebow / turbo / spectral / rdylgn — those fail
  // perceptual uniformity and/or colorblind accessibility (see the
  // "Why no rainbow?" disclosure below).
  //
  // Order matches user preference: highest-priority on top.
  type SchemeKey =
    | "reds" | "greys" | "viridis" | "batlow"
    | "blues" | "greens" | "oranges" | "purples";
  interface SchemeEntry {
    key: SchemeKey;
    label: string;
    // Either a Plot named scheme (string) or an explicit color stop
    // array Plot will interpolate across via `range`. Plot ships
    // most of these as named schemes; Batlow is vendored explicitly
    // from Crameri's v8 scientific colour-map table.
    plot: { scheme: string } | { range: string[] };
  }
  // Batlow 10-step sequential ramp from Crameri's published v8
  // table. Perceptually-uniform multi-hue (dark navy → blue → green
  // → yellow → orange → light beige). Crameri, F. (2018, v8.0.1):
  //   https://www.fabiocrameri.ch/colourmaps/
  // CC-BY-4.0; cite when published with these visuals.
  const BATLOW_STOPS: string[] = [
    "#011959", "#102d6a", "#1d4470", "#2b5b6c", "#3e7062",
    "#5f8053", "#909046", "#c39c4a", "#e9aa66", "#f9c69a",
  ];
  const SCHEMES: SchemeEntry[] = [
    { key: "reds",    label: "Red",     plot: { scheme: "reds" } },
    { key: "greys",   label: "Grey",    plot: { scheme: "greys" } },
    { key: "viridis", label: "Viridis", plot: { scheme: "viridis" } },
    { key: "batlow",  label: "Batlow",  plot: { range: BATLOW_STOPS } },
    { key: "blues",   label: "Blue",    plot: { scheme: "blues" } },
    { key: "greens",  label: "Green",   plot: { scheme: "greens" } },
    { key: "oranges", label: "Orange",  plot: { scheme: "oranges" } },
    { key: "purples", label: "Purple",  plot: { scheme: "purples" } },
  ];
  function schemeByKey(key: string): SchemeEntry {
    return SCHEMES.find((s) => s.key === key) ?? SCHEMES[0];
  }

  // ---- Per-chart scheme override (localStorage) ----
  // Keyed by chart-id, so different charts on the same page keep
  // their own picks. The author's chart YAML colorScheme is the
  // default when no override exists. Multiple maps with different
  // colors on the same page is the design goal — each user pick
  // affects only the chart whose dialog produced it.
  function lsKey(chartId: string): string {
    return `tape.choro.${chartId}.scheme`;
  }
  function loadOverride(chartId: string): string | null {
    try {
      return localStorage.getItem(lsKey(chartId));
    } catch {
      return null;
    }
  }
  function saveOverride(chartId: string, key: string): void {
    try {
      localStorage.setItem(lsKey(chartId), key);
    } catch {
      // localStorage blocked — the override is session-only.
    }
  }

  // Returns the effective scheme key for a chart: user override if
  // set, else the chart's author-specified default.
  function effectiveScheme(chartId: string, authorScheme: string): SchemeKey {
    const stored = loadOverride(chartId);
    const known = SCHEMES.map((s) => s.key);
    if (stored && (known as string[]).includes(stored)) {
      return stored as SchemeKey;
    }
    // Author's colorScheme might be any Plot scheme name. If it
    // happens to match one of our offered keys, use it; otherwise
    // fall back to blues. We DO render the author's choice exactly
    // on first paint via the data-color-scheme attr, but for the
    // dropdown's "selected" state we round it to one of our 8.
    if ((known as string[]).includes(authorScheme)) {
      return authorScheme as SchemeKey;
    }
    return "blues";
  }

  // Cache fetched boundary + values JSON across tiles on the same page
  // so a dashboard with N choropleths only does ONE boundary fetch.
  const boundaryCache = new Map<string, Promise<unknown>>();
  const valuesCache = new Map<string, Promise<Record<string, number>>>();

  function getBoundary(url: string): Promise<any> {
    let p = boundaryCache.get(url);
    if (!p) {
      p = fetch(url).then((r) => {
        if (!r.ok) throw new Error(`boundary ${url}: ${r.status}`);
        return r.json();
      });
      boundaryCache.set(url, p);
    }
    return p;
  }

  function getValues(url: string): Promise<Record<string, number>> {
    let p = valuesCache.get(url);
    if (!p) {
      p = fetch(url)
        .then((r) => {
          if (!r.ok) throw new Error(`values ${url}: ${r.status}`);
          return r.json();
        })
        .then((j) => j.values as Record<string, number>);
      valuesCache.set(url, p);
    }
    return p;
  }

  // Multi-shard fetch + merge. Used by tract / block-group charts
  // that span multiple states (DMV = VA + MD + DC). Each shard is
  // independently cached so charts with overlapping state coverage
  // share the underlying fetch.
  async function getMergedValues(urls: string[]): Promise<Record<string, number>> {
    if (urls.length === 1) return getValues(urls[0]);
    const shards = await Promise.all(urls.map(async (u) => {
      try { return await getValues(u); }
      catch { return {} as Record<string, number>; }
    }));
    const merged: Record<string, number> = {};
    for (const s of shards) Object.assign(merged, s);
    return merged;
  }

  function fmtValue(v: number | null, unit: string, decimals: number): string {
    if (v == null || !Number.isFinite(v)) return "—";
    if (unit === "USD") {
      return v.toLocaleString("en-US", {
        style: "currency",
        currency: "USD",
        maximumFractionDigits: 0,
      });
    }
    const r = v.toFixed(decimals);
    return unit === "%" ? `${r}%` : r;
  }

  async function paint(canvas: HTMLElement, b: ChoroBindings, mode: "tile" | "expanded" | "fullscreen") {
    const [boundary, values] = await Promise.all([
      getBoundary(b.boundaryUrl),
      getMergedValues(b.dataUrls),
    ]);
    // Pick the right TopoJSON object layer + GEOID key based on geo.
    // State features have id = 2-digit FIPS; county features have id
    // = 5-digit FIPS. Tract/block-group come from state-sharded
    // TopoJSONs we generate separately (not present in v1).
    let layerName: string;
    if (b.geo === "state") layerName = "states";
    else if (b.geo === "county") layerName = "counties";
    else if (b.geo === "tract") layerName = "tracts";
    else layerName = "block_groups";
    const fc = topojson.feature(boundary, boundary.objects[layerName]) as any;
    const features = fc.features as Array<{
      id: string;
      properties?: { name?: string; id?: string };
    }>;
    // Normalize id at the feature level. Some boundary files (the
    // DMV-tract and VA-block-group TopoJSONs we generated with
    // mapshaper) carry the GEOID under properties.id instead of as
    // a top-level id — topojson.feature() doesn't promote it for us,
    // so values[f.id] would miss and the map would render with no
    // colored regions. Promote here so the rest of paint() (and
    // Plot's path data binding) can rely on f.id being the GEOID.
    //
    // Same trick for the display name: us-counties-2024-10m.json
    // has the human name under properties.NAME (uppercase, from
    // the cb_2024 Census file), our mapshaper-generated tract and
    // block-group files have it under properties.name (lowercase).
    // Normalize to properties.name so tooltips and titles can read
    // one key regardless of boundary-file vintage.
    for (const f of features) {
      const props = (f as { properties?: { id?: string; name?: string; NAME?: string } }).properties;
      if (!f.id && props?.id) {
        (f as { id: string }).id = props.id;
      }
      if (props && !props.name && props.NAME) {
        props.name = props.NAME;
      }
    }
    // Apply bbox clip if provided. We test whether ANY vertex of
    // each feature's polygon falls inside the bbox — that keeps the
    // tracts that straddle the edge of the bbox (which read more
    // naturally to the eye than a hard-clipped boundary) while
    // dropping everything fully outside. For DMV-level tract maps
    // this cuts ~3,500 polygons in VA+MD+DC down to ~700 in the
    // DC-area tracts.
    let clipped = features;
    if (b.bbox) {
      const [w, s, e, n] = b.bbox;
      const inBbox = (lng: number, lat: number) =>
        lng >= w && lng <= e && lat >= s && lat <= n;
      const anyVertexInBbox = (geom: any): boolean => {
        if (!geom) return false;
        if (geom.type === "Polygon") {
          for (const ring of geom.coordinates) {
            for (const pt of ring) {
              if (inBbox(pt[0], pt[1])) return true;
            }
          }
          return false;
        }
        if (geom.type === "MultiPolygon") {
          for (const poly of geom.coordinates) {
            for (const ring of poly) {
              for (const pt of ring) {
                if (inBbox(pt[0], pt[1])) return true;
              }
            }
          }
          return false;
        }
        return false;
      };
      clipped = features.filter((f) => anyVertexInBbox((f as any).geometry));
    }
    // Build a domain from observed values so the legend is tight.
    const obs: number[] = [];
    for (const f of clipped) {
      const v = values[f.id];
      if (typeof v === "number" && Number.isFinite(v)) obs.push(v);
    }
    if (obs.length === 0) {
      canvas.innerHTML = '<p class="muted small">No regions with values.</p>';
      return;
    }
    obs.sort((a, b2) => a - b2);
    // Trim 1% tails to keep one outlier from washing out the rest.
    const lo = obs[Math.max(0, Math.floor(obs.length * 0.01))];
    const hi = obs[Math.min(obs.length - 1, Math.ceil(obs.length * 0.99))];
    const colorDomain: [number, number] = [lo, hi];
    canvas.innerHTML = "";
    // Always project at render time. us-counties-10m.json (the
    // geographic-coords variant) lets Plot's albers-usa projection
    // auto-fit to whatever (width, height) we pass — including the
    // Alaska + Hawaii insets at canonical positions, which the
    // pre-projected file couldn't do without us also pinning the
    // viewport to its native 975×610.
    // Plot sizes per render mode. Tile is the dashboard thumbnail;
    // expanded is the dialog default; fullscreen fills the viewport
    // when the user clicks Full screen.
    const vw = window.innerWidth || 1200;
    const vh = window.innerHeight || 800;
    // Fullscreen caps generous enough to actually use a 2K/4K
    // display — 1600 × 1000 was leaving 30%+ of the screen blank on
    // common dev monitors. Expanded stays modest so the dialog still
    // fits within the page on typical laptop widths.
    const width =
      mode === "fullscreen" ? Math.min(vw - 40, 2400)
      : mode === "expanded" ? 1000
      : 620;
    const height =
      mode === "fullscreen" ? Math.min(vh - 160, 1500)
      : mode === "expanded" ? 620
      : 360;
    // Resolve the scheme: user override (if any) > chart author's
    // colorScheme > Blues fallback. Plot's color spec accepts EITHER
    // a named scheme string OR an explicit range[] of stops (which
    // we need for Batlow, since Plot doesn't ship Batlow as a named
    // scheme).
    const sk = effectiveScheme(b.chartId, b.colorScheme);
    const entry = schemeByKey(sk);
    const colorSpec: Record<string, unknown> = {
      type: b.colorScale,
      domain: colorDomain,
      legend: true,
      label: b.valueLabel,
      // colorDomain is trimmed to [1st, 99th] percentile to keep
      // the legend tight; without clamp:true, Plot extrapolates
      // the rgb-interpolated range BEYOND the endpoint stops for
      // out-of-domain values, which produces invalid colors and
      // renders extreme counties as transparent (read: white) on
      // the map. Clamping pegs values below domain[0] to range[0]
      // and values above domain[1] to range[last], so the extremes
      // get the legend's endpoint color instead of disappearing.
      clamp: true,
    };
    if ("scheme" in entry.plot) {
      colorSpec.scheme = entry.plot.scheme;
    } else {
      colorSpec.range = entry.plot.range;
      colorSpec.interpolate = "rgb";
    }
    // Projection per geo level.
    //   • state / county: albers-usa puts Alaska + Hawaii in
    //     canonical insets at the bottom-left.
    //   • tract / block-group: regular albers with an EXPLICIT
    //     domain pointing at the clipped FeatureCollection.
    //     Without the explicit domain, Plot's auto-fit for the
    //     bare "albers" projection sometimes produced a viewport
    //     with the DMV crammed into a sliver — visually that read
    //     as a white tile because the actual polygons sat off the
    //     visible canvas. Forcing the domain tells Plot to fit the
    //     projection so the clipped features fill the canvas.
    const projection: unknown =
      b.geo === "state" || b.geo === "county"
        ? "albers-usa"
        : {
            type: "albers",
            domain: { type: "FeatureCollection", features: clipped },
          };
    const plotSpec = {
      projection,
      width,
      height,
      margin: 6,
      color: colorSpec,
      marks: [
        Plot.geo(clipped, {
          fill: (d: any) => values[d.id] ?? null,
          stroke: "white",
          strokeWidth: 0.3,
          title: (d: any) => {
            const v = values[d.id];
            const name = d.properties?.name ?? d.id;
            return `${name}\n${fmtValue(v ?? null, b.unit, b.decimals)}`;
          },
        }),
      ],
    };
    let fig: HTMLElement | null = null;
    try {
      fig = (Plot as any).plot(plotSpec);
    } catch (e) {
      // Plot can throw on malformed colorSpec (e.g. clamp option
      // misalignment), invalid projection, or NaN in coordinates.
      // Without this catch the failure bubbles up to hydrateAll's
      // catch which renders a generic "Map failed to load" — but
      // the user still wants the error visible in the console.
      console.error("[choropleth] Plot.plot threw:", e, plotSpec);
      canvas.innerHTML = `<p class="muted small">Map render failed: ${String((e as Error)?.message ?? e)}</p>`;
      return;
    }
    if (!fig) {
      // Plot returned undefined / null — defensive case, shouldn't
      // normally happen but better a visible message than silent
      // white space.
      console.error("[choropleth] Plot.plot returned nothing", plotSpec);
      canvas.innerHTML = `<p class="muted small">Map render produced no output (${clipped.length} regions, ${obs.length} values).</p>`;
      return;
    }
    canvas.appendChild(fig);
    // After-append diagnostic so the user (and us, if a bug-report
    // screenshot doesn't include console output) can confirm the
    // figure landed in the canvas with non-trivial dimensions. If
    // this logs "0 × 0" the issue is layout/sizing, not Plot.
    const svgChild = fig.querySelector?.("svg") as SVGSVGElement | null;
    const svgW = svgChild?.clientWidth ?? 0;
    const svgH = svgChild?.clientHeight ?? 0;
    if (svgW === 0 || svgH === 0) {
      console.warn(
        `[choropleth] ${b.chartId}: rendered svg has zero size ` +
        `(${svgW}×${svgH}) — features=${clipped.length}, values=${obs.length}`,
      );
    }
    // Tooltip on hover. Performance-tuned because the chart can carry
    // thousands of <path> elements (3,143 counties, ~74k tracts) and
    // a naive mousemove handler that runs `closest("path")` plus DOM
    // writes on every pointer event chews 5-10ms per move — the user
    // sees noticeable lag tracking the cursor.
    //
    // Three optimizations:
    //   1. rAF-throttle: at most one tooltip update per animation
    //      frame, even if the browser fires 60+ mousemove events.
    //   2. Direct target check: e.target IS the path the cursor is
    //      over (SVG pointer-events default), so we skip closest().
    //      Falls through to closest() only when the target wasn't a
    //      path (e.g. SVG background).
    //   3. DOM writes batched in the rAF: position + textContent +
    //      visibility flip happen together, one layout cycle.
    // fig might be a <figure> wrapping the SVG (when legend:true) or
    // the SVG directly. Either way we want event listeners on the
    // map element. Cast through HTMLElement so addEventListener
    // accepts MouseEvent listeners — without the cast TS narrows
    // svg to Element which only types listeners as Event.
    const svg = ((fig as HTMLElement).querySelector("svg") ?? fig) as HTMLElement;
    const tooltip = document.createElement("div");
    tooltip.className = "choro-tooltip";
    tooltip.style.display = "none";
    canvas.appendChild(tooltip);
    const rectCache = { rect: canvas.getBoundingClientRect() };
    const onResize = () => { rectCache.rect = canvas.getBoundingClientRect(); };
    window.addEventListener("resize", onResize, { passive: true });
    let pendingEv: MouseEvent | null = null;
    let rafQueued = false;
    function flushTooltip() {
      rafQueued = false;
      const ev = pendingEv;
      pendingEv = null;
      if (!ev) return;
      const target = ev.target as Element | null;
      // Hot path: most mousemove targets land directly on a <path>.
      let path: Element | null =
        target && target.tagName === "path" ? target : null;
      if (!path && target) path = target.closest("path");
      if (!path) {
        if (tooltip.style.display !== "none") tooltip.style.display = "none";
        return;
      }
      const d = (path as any).__data__ as
        | { id?: string; properties?: { name?: string } } | undefined;
      if (!d?.id) {
        if (tooltip.style.display !== "none") tooltip.style.display = "none";
        return;
      }
      const v = values[d.id];
      if (v == null || !Number.isFinite(v)) {
        if (tooltip.style.display !== "none") tooltip.style.display = "none";
        return;
      }
      const name = d.properties?.name ?? d.id;
      tooltip.textContent = `${name}: ${fmtValue(v, b.unit, b.decimals)}`;
      tooltip.style.display = "block";
      tooltip.style.left = (ev.clientX - rectCache.rect.left + 12) + "px";
      tooltip.style.top = (ev.clientY - rectCache.rect.top + 12) + "px";
    }
    svg.addEventListener("mousemove", (ev: MouseEvent) => {
      pendingEv = ev;
      if (rafQueued) return;
      rafQueued = true;
      requestAnimationFrame(flushTooltip);
    }, { passive: true });
    svg.addEventListener("mouseleave", () => {
      pendingEv = null;
      tooltip.style.display = "none";
    });

    // Zoom: enabled for county-and-finer maps in the expanded /
    // fullscreen dialog. State-level maps are already a single-
    // screen view so zoom would be confusing; tiles stay non-zoom
    // so a click-and-drag still passes through to the expand-tile
    // click handler without ambiguity.
    //
    // Strategy: d3-zoom on the SVG element with a transform applied
    // to Plot's geo <g> group only (NOT the color legend group).
    // Mouse wheel zooms; click-and-drag pans; ctrl+= / ctrl+- / ctrl+0
    // give keyboard control while the dialog is open.
    //
    // translateExtent is set to the SVG viewBox so pans hit the
    // edges of the rendered area instead of wandering into empty
    // space. scaleExtent caps zoom at 16× — beyond that, polygon
    // rendering gets pixelated.
    //
    // vector-effect: non-scaling-stroke on the paths keeps the 0.3px
    // boundary lines crisp at every zoom level (otherwise 16× zoom
    // turns them into thick smudges).
    if (b.geo !== "state" && mode !== "tile") {
      // svg was cast to HTMLElement above so addEventListener works
      // with MouseEvent listeners. Re-cast through unknown here
      // since the runtime element IS an SVG; TypeScript just lost
      // that info through the earlier HTMLElement cast.
      const svgEl = svg as unknown as SVGSVGElement;
      const geoGroup = svgEl.querySelector<SVGGElement>(
        'g[aria-label="geo"]',
      );
      if (geoGroup) {
        // Apply non-scaling-stroke to every geo path. Plot doesn't
        // expose a hook for this; the cheapest path is a one-shot
        // attribute set after render.
        geoGroup.querySelectorAll<SVGPathElement>("path").forEach(
          (p: SVGPathElement) =>
            p.setAttribute("vector-effect", "non-scaling-stroke"),
        );
        // ViewBox-aware translateExtent: pulled from the rendered
        // SVG's viewBox so panning is bounded to actual content
        // rather than an arbitrary [0, width]×[0, height] box.
        let extentMinX = 0, extentMinY = 0;
        let extentMaxX = (svgEl.viewBox?.baseVal?.width ?? 0) || svgEl.clientWidth;
        let extentMaxY = (svgEl.viewBox?.baseVal?.height ?? 0) || svgEl.clientHeight;
        if (svgEl.viewBox?.baseVal) {
          extentMinX = svgEl.viewBox.baseVal.x;
          extentMinY = svgEl.viewBox.baseVal.y;
          extentMaxX = extentMinX + svgEl.viewBox.baseVal.width;
          extentMaxY = extentMinY + svgEl.viewBox.baseVal.height;
        }
        // Attach the zoom LISTENER to the canvas wrapper (the user's
        // .choro-canvas-expanded div), not the SVG. Reason: Plot
        // wraps the SVG in a <figure> with a sibling color-legend
        // group; wheel events on the legend or the figure margin
        // don't bubble through the SVG and were getting swallowed
        // by the dialog's scroll instead. The canvas div sits OVER
        // the entire choropleth area + a small buffer, so any wheel
        // inside it triggers zoom. The transform is still applied
        // to the geo <g> inside the SVG so only the map scales,
        // not the legend.
        const listenerEl = canvas as unknown as Element;
        const listenerSel = d3select<Element, unknown>(listenerEl);
        const geoSel = d3select(geoGroup);
        const zoom = d3zoom<Element, unknown>()
          .scaleExtent([1, 16])
          .translateExtent([[extentMinX, extentMinY], [extentMaxX, extentMaxY]])
          .filter((event: Event) => {
            // Allow mouse wheel for zoom, drag for pan. Block right
            // click + dblclick. Don't gate on ctrlKey for wheel
            // (so plain scroll zooms, matching the dialog's hint).
            if (event.type === "wheel") return true;
            if (event.type === "mousedown") {
              return (event as MouseEvent).button === 0;
            }
            return event.type !== "dblclick";
          })
          .on("zoom", (event: { transform: ZoomTransform }) => {
            geoSel.attr("transform", event.transform.toString());
          });
        listenerSel.call(zoom);
        // Stash the zoom binding on the canvas DOM node so the
        // dialog-level keyboard shortcut + reset button can reach
        // it. Using a hidden property avoids polluting the global
        // namespace and survives multiple maps on the page.
        (canvas as unknown as { __choroZoom?: unknown }).__choroZoom = {
          zoom, sel: listenerSel,
        };
        // Visual affordance: cursor changes to grab so the user
        // knows the canvas is interactive.
        (canvas.style as CSSStyleDeclaration).cursor = "grab";
        // Belt-and-suspenders wheel zoom. d3-zoom registers its own
        // wheel listener via call(zoom), but several user reports
        // suggest that's getting swallowed by something (browser
        // quirk, focus state, swallowed-by-dialog-scroll). Add a
        // separate non-passive wheel listener that calls into the
        // same zoomScaleBy helper so plain mouse-scroll always
        // triggers some zoom action even if d3-zoom's built-in
        // doesn't. preventDefault() blocks any browser default
        // (e.g. dialog scroll). The factor matches the +/- button
        // step so muscle memory translates.
        const wheelHandler = (e: WheelEvent) => {
          if (!e.deltaY) return;
          e.preventDefault();
          const factor = e.deltaY < 0 ? 1.15 : 1 / 1.15;
          zoomScaleBy(canvas, factor);
        };
        canvas.addEventListener("wheel", wheelHandler, { passive: false });
      }
    }
  }

  // Programmatic-zoom helpers exposed for the dialog's keyboard
  // shortcuts + reset button. They look up the zoom binding cached
  // on the dialog canvas at paint time.
  function getZoomCtx(canvas: HTMLElement | null) {
    if (!canvas) return null;
    return (canvas as unknown as {
      __choroZoom?: {
        zoom: ZoomBehavior<Element, unknown>;
        sel: ReturnType<typeof d3select<Element, unknown>>;
      };
    }).__choroZoom ?? null;
  }
  function zoomScaleBy(canvas: HTMLElement, factor: number) {
    const ctx = getZoomCtx(canvas);
    if (!ctx) return;
    ctx.sel.transition().duration(180).call(ctx.zoom.scaleBy, factor);
  }
  function zoomReset(canvas: HTMLElement) {
    const ctx = getZoomCtx(canvas);
    if (!ctx) return;
    ctx.sel.transition().duration(200).call(ctx.zoom.transform, zoomIdentity);
  }

  function hydrateAll() {
    const canvases = document.querySelectorAll<HTMLElement>(
      "[data-role='choro-canvas']",
    );
    canvases.forEach((canvas) => {
      if (canvas.dataset.hydrated === "1") return;
      canvas.dataset.hydrated = "1";
      // When the server side already determined that no data file
      // was readable for this chart (typically: chart was added
      // after the last workflow run, the underlying data hasn't
      // been fetched yet), bail out without trying to client-fetch.
      // Otherwise the client request would 404 and overwrite the
      // helpful "data not yet fetched" eyebrow message with a
      // cryptic "values …json: 404" error.
      if (canvas.dataset.skipHydrate === "1") return;
      // Three render sizes: tile (dashboard thumbnail), expanded
      // (dialog default), fullscreen (CSS-wide dialog). Previously
      // narrowed to two and "fullscreen" silently fell through to
      // "tile" — that's why the Full-screen toggle visibly flipped
      // the dialog width but the SVG inside stayed thumbnail-sized.
      const raw = canvas.dataset.mode;
      const mode: "tile" | "expanded" | "fullscreen" =
        raw === "fullscreen" ? "fullscreen"
        : raw === "expanded" ? "expanded"
        : "tile";
      let parsedDataUrls: string[] = [];
      try {
        parsedDataUrls = JSON.parse(canvas.dataset.dataUrls ?? "[]");
      } catch { /* leave empty; canvas will render "no data" */ }
      const b: ChoroBindings = {
        chartId: canvas.dataset.chartId ?? "",
        dataUrls: parsedDataUrls,
        boundaryUrl: canvas.dataset.boundaryUrl ?? "",
        geo: (canvas.dataset.geo ?? "county") as ChoroBindings["geo"],
        state: canvas.dataset.state ?? "",
        bbox: canvas.dataset.bbox && canvas.dataset.bbox !== "null"
          ? (JSON.parse(canvas.dataset.bbox) as [number, number, number, number])
          : null,
        colorScheme: canvas.dataset.colorScheme ?? "blues",
        colorScale: (canvas.dataset.colorScale ?? "linear") as
          ChoroBindings["colorScale"],
        valueLabel: canvas.dataset.valueLabel ?? "",
        unit: canvas.dataset.unit ?? "",
        decimals: Number(canvas.dataset.decimals ?? "1"),
      };
      paint(canvas, b, mode).catch((e) => {
        canvas.innerHTML = `<p class="muted small">Map failed to load: ${String(e?.message ?? e)}</p>`;
      });
    });
  }

  // ---- Click-to-expand ----
  //
  // Behaves like the other dashboard chart tiles' click-to-expand —
  // opens a native <dialog> with showModal(), so ESC dismisses for
  // free and the focus trap is automatic. Inside the dialog: bigger
  // version of the same map, a "Full screen" toggle, the metadata
  // footer that used to clutter the tile.
  //
  // Click wiring uses document-level event delegation, which is the
  // boring-and-correct shape: no per-tile setup ordering issues, no
  // missed tiles that hydrated late, no double-bind risk on re-render.
  function ensureDialog(): HTMLDialogElement {
    let dialog = document.querySelector<HTMLDialogElement>("#choro-expand-dialog");
    if (dialog) return dialog;
    dialog = document.createElement("dialog");
    dialog.id = "choro-expand-dialog";
    dialog.className = "choro-dialog";
    // Build the scheme-picker options HTML once.
    const optsHtml = SCHEMES.map(
      (s) => `<option value="${s.key}">${s.label}</option>`,
    ).join("");
    dialog.innerHTML = `
      <header class="choro-dialog-header">
        <div class="choro-dialog-titles">
          <h3 class="choro-dialog-title"></h3>
          <p class="choro-dialog-eyebrow muted small"></p>
        </div>
        <div class="choro-dialog-actions">
          <label class="choro-dialog-scheme">
            <span class="muted small">Color</span>
            <select class="choro-dialog-scheme-select" aria-label="Color scheme">${optsHtml}</select>
          </label>
          <button type="button" class="choro-dialog-zoom-out" aria-label="Zoom out" title="Zoom out (Ctrl+−)">−</button>
          <button type="button" class="choro-dialog-zoom-in" aria-label="Zoom in" title="Zoom in (Ctrl+=)">+</button>
          <button type="button" class="choro-dialog-zoom-reset" aria-label="Reset zoom" title="Reset zoom (Ctrl+0)">⟲ Reset zoom</button>
          <button type="button" class="choro-dialog-fullscreen" aria-label="Toggle full screen">⤢ Full screen</button>
          <button type="button" class="choro-dialog-close" aria-label="Close">&times;</button>
        </div>
      </header>
      <div class="choro-dialog-year" hidden>
        <label class="muted small" for="choro-year-slider">Year</label>
        <input class="choro-dialog-year-slider" id="choro-year-slider" type="range" min="0" max="0" value="0" step="1" aria-label="ACS 5-year vintage" />
        <output class="choro-dialog-year-readout"></output>
      </div>
      <details class="choro-dialog-why">
        <summary>Why no rainbow?</summary>
        <p>
          Rainbow color maps look bright but mislead the reader. The
          eye can't perceive equal steps of a value as equal steps in
          color across a rainbow ramp — yellow regions visually pop
          out, dim blues blur together — so a 60th-percentile region
          can read as more extreme than an 85th-percentile one. The
          effect is worse for the ~8% of men with red-green color
          vision differences, who can't reliably order the yellow /
          green / red bands at all. Mono-hue ramps preserve the
          value's ordinal information; perceptually uniform multi-hue
          (Viridis, Batlow) do so while still covering a wider color
          gamut.
        </p>
        <p class="muted small">
          Reference: Crameri, Shephard &amp; Heron,
          <a href="https://doi.org/10.1038/s41467-020-19160-7"
             target="_blank" rel="noopener">The misuse of colour in
          science communication</a> (Nature Communications, 2020).
        </p>
      </details>
      <div class="choro-dialog-canvas-wrap"></div>
      <footer class="choro-dialog-footer">
        <p class="muted small choro-dialog-meta"></p>
        <p class="muted small choro-dialog-zoom-hint" hidden>Scroll to zoom · drag to pan · Ctrl+0 to reset</p>
      </footer>
    `;
    document.body.appendChild(dialog);
    // Backdrop click → close. <dialog> exposes the ::backdrop pseudo-
    // element but its click target is the dialog itself; we detect
    // by checking that the click landed on the dialog and not on a
    // descendant.
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog!.close();
    });
    dialog.querySelector(".choro-dialog-close")?.addEventListener("click", () => {
      dialog!.close();
    });
    // Fullscreen toggle — CSS-only expansion of the dialog to fill
    // the viewport. NOT the OS Fullscreen API (which removes the
    // browser chrome and was disorienting). The .choro-dialog-wide
    // class flips the dialog to 100vw × 100vh; we then re-paint the
    // canvas in "fullscreen" mode so the SVG actually grows to fill
    // the new space.
    const fullscreenBtn = dialog.querySelector<HTMLButtonElement>(".choro-dialog-fullscreen");
    function syncFullscreenUI(isFs: boolean) {
      if (fullscreenBtn) {
        fullscreenBtn.textContent = isFs ? "⤡ Exit full screen" : "⤢ Full screen";
      }
      dialog!.classList.toggle("choro-dialog-wide", isFs);
      const dialogCanvas = dialog!.querySelector<HTMLElement>(
        "[data-role='choro-canvas']",
      );
      if (dialogCanvas) {
        dialogCanvas.dataset.mode = isFs ? "fullscreen" : "expanded";
        dialogCanvas.removeAttribute("data-hydrated");
        dialogCanvas.innerHTML = "";
        // Defer to next frame so the new .choro-dialog-wide layout
        // applies before paint() reads window dimensions. Without
        // this, the SVG is sometimes sized using the pre-toggle
        // viewport.
        requestAnimationFrame(() => hydrateAll());
      }
    }
    fullscreenBtn?.addEventListener("click", () => {
      const isFs = dialog!.classList.contains("choro-dialog-wide");
      syncFullscreenUI(!isFs);
    });
    dialog.addEventListener("close", () => {
      // Clear the canvas so re-opening doesn't show a stale map for
      // a moment while the new one paints.
      const wrap = dialog!.querySelector(".choro-dialog-canvas-wrap") as HTMLElement;
      if (wrap) wrap.innerHTML = "";
      dialog!.classList.remove("choro-dialog-wide");
    });
    // Reset-zoom button: returns the map to its initial scale +
    // translate via the d3-zoom programmatic API. Visible only when
    // there's a zoom binding active (county-and-finer); on state
    // maps it would be a no-op so we hide it via classList.
    const resetBtn = dialog.querySelector<HTMLButtonElement>(
      ".choro-dialog-zoom-reset",
    );
    resetBtn?.addEventListener("click", () => {
      const dialogCanvas = dialog!.querySelector<HTMLElement>(
        "[data-role='choro-canvas']",
      );
      if (dialogCanvas) zoomReset(dialogCanvas);
    });
    // Manual zoom-in / zoom-out buttons. Same factor (1.5x) as the
    // keyboard shortcuts. Useful when wheel zoom isn't behaving
    // (touchpad-without-momentum, browser quirks, etc.) — the user
    // can always reach the same zoom states via these.
    const zoomInBtn = dialog.querySelector<HTMLButtonElement>(
      ".choro-dialog-zoom-in",
    );
    const zoomOutBtn = dialog.querySelector<HTMLButtonElement>(
      ".choro-dialog-zoom-out",
    );
    zoomInBtn?.addEventListener("click", () => {
      const dialogCanvas = dialog!.querySelector<HTMLElement>(
        "[data-role='choro-canvas']",
      );
      if (dialogCanvas) zoomScaleBy(dialogCanvas, 1.5);
    });
    zoomOutBtn?.addEventListener("click", () => {
      const dialogCanvas = dialog!.querySelector<HTMLElement>(
        "[data-role='choro-canvas']",
      );
      if (dialogCanvas) zoomScaleBy(dialogCanvas, 1 / 1.5);
    });
    // Keyboard shortcuts while the dialog has focus:
    //   Ctrl/Cmd + = / + → zoom in
    //   Ctrl/Cmd + -     → zoom out
    //   Ctrl/Cmd + 0     → reset
    // We preventDefault so the browser's page-zoom shortcuts don't
    // trigger (the user explicitly asked for those to be hijacked).
    // Scoped to dialog.open so we don't capture the keys at other
    // times in the page.
    dialog.addEventListener("keydown", (e: KeyboardEvent) => {
      if (!(e.ctrlKey || e.metaKey)) return;
      const dialogCanvas = dialog!.querySelector<HTMLElement>(
        "[data-role='choro-canvas']",
      );
      if (!dialogCanvas) return;
      if (e.key === "=" || e.key === "+") {
        e.preventDefault();
        zoomScaleBy(dialogCanvas, 1.5);
      } else if (e.key === "-" || e.key === "_") {
        e.preventDefault();
        zoomScaleBy(dialogCanvas, 1 / 1.5);
      } else if (e.key === "0") {
        e.preventDefault();
        zoomReset(dialogCanvas);
      }
    });
    // Scheme picker: on change, persist the override for the chart
    // currently displayed in the dialog, then re-paint the dialog
    // canvas + the source tile so the user sees the new color
    // immediately in both places.
    const sel = dialog.querySelector<HTMLSelectElement>(
      ".choro-dialog-scheme-select",
    );
    sel?.addEventListener("change", () => {
      const chartId = dialog!.dataset.activeChartId;
      if (!chartId || !sel.value) return;
      saveOverride(chartId, sel.value);
      // Re-paint dialog canvas in place.
      const dialogCanvas = dialog!.querySelector<HTMLElement>(
        "[data-role='choro-canvas']",
      );
      if (dialogCanvas) {
        dialogCanvas.removeAttribute("data-hydrated");
        dialogCanvas.innerHTML = "";
      }
      // Re-paint the source tile canvas too — different charts on
      // the page keep their own schemes, but the chart whose dialog
      // we changed should update its tile in lockstep.
      const tileCanvas = document.querySelector<HTMLElement>(
        `[data-choro='1'][data-chart-id='${chartId}'] [data-role='choro-canvas']`,
      );
      if (tileCanvas) {
        tileCanvas.removeAttribute("data-hydrated");
        tileCanvas.innerHTML = "";
      }
      hydrateAll();
    });
    // Year slider: split between `input` (cheap — readout follows the
    // thumb as the user drags) and `change` (expensive — actual
    // fetch + re-paint, fires once when the user releases). This
    // avoids triggering a paint on every pixel of drag while still
    // feeling responsive.
    const slider = dialog.querySelector<HTMLInputElement>(
      ".choro-dialog-year-slider",
    );
    slider?.addEventListener("input", () => {
      const vintages = (
        (slider.dataset.vintages ? JSON.parse(slider.dataset.vintages) : []) as string[]
      );
      const idx = Math.max(0, Math.min(vintages.length - 1, parseInt(slider.value, 10) || 0));
      const newVintage = vintages[idx];
      if (!newVintage) return;
      const readout = dialog!.querySelector<HTMLElement>(
        ".choro-dialog-year-readout",
      );
      if (readout) readout.textContent = newVintage;
    });
    slider?.addEventListener("change", () => {
      const vintages = (
        (slider.dataset.vintages ? JSON.parse(slider.dataset.vintages) : []) as string[]
      );
      const idx = Math.max(0, Math.min(vintages.length - 1, parseInt(slider.value, 10) || 0));
      const newVintage = vintages[idx];
      if (!newVintage) return;
      const readout = dialog!.querySelector<HTMLElement>(
        ".choro-dialog-year-readout",
      );
      if (readout) readout.textContent = newVintage;
      const dialogCanvas = dialog!.querySelector<HTMLElement>(
        "[data-role='choro-canvas']",
      );
      if (!dialogCanvas) return;
      // Rebuild dataUrls by swapping the vintage. URL shape:
      //   /data/<dataDirSeg>/[<state>/]<indicator>_<vintage>.json
      const indicatorId = dialogCanvas.dataset.indicator ?? "";
      const dirSeg = dialogCanvas.dataset.dataDirSeg ?? "";
      const states = (dialogCanvas.dataset.states ?? "")
        .split(",").map((s) => s.trim()).filter(Boolean);
      const isShardedByState =
        dirSeg === "acs_tract" || dirSeg === "acs_block_group";
      let urls: string[];
      if (isShardedByState) {
        urls = states.map((st) =>
          `/data/${dirSeg}/${st}/${indicatorId}_${newVintage}.json`);
      } else {
        urls = [`/data/${dirSeg}/${indicatorId}_${newVintage}.json`];
      }
      dialogCanvas.dataset.dataUrls = JSON.stringify(urls);
      dialogCanvas.dataset.vintage = newVintage;
      dialogCanvas.removeAttribute("data-hydrated");
      dialogCanvas.innerHTML = "";
      // Refresh the meta footer to reflect the new vintage's
      // lastUpdated stamp (different vintages may have been
      // re-fetched on different workflow runs).
      const firstUrl = urls[0];
      if (firstUrl) {
        fetch(firstUrl)
          .then((r) => r.json())
          .then((j) => {
            const meta = dialog!.querySelector<HTMLElement>(
              ".choro-dialog-meta",
            );
            if (!meta) return;
            const updated = j.lastUpdated
              ? new Date(j.lastUpdated).toLocaleDateString("en-US", {
                  year: "numeric", month: "short", day: "numeric",
                })
              : "";
            meta.textContent = `ACS 5-year · vintage ${j.vintage} · ${j.geo} level · updated ${updated}`;
          })
          .catch(() => {});
      }
      hydrateAll();
    });
    return dialog;
  }

  function openExpanded(tile: HTMLElement) {
    const canvasSrc = tile.querySelector<HTMLElement>("[data-role='choro-canvas']");
    if (!canvasSrc) return;
    const title = tile.querySelector<HTMLElement>(".chart-tile-title")?.textContent ?? "";
    const eyebrow = tile.querySelector<HTMLElement>(".choro-eyebrow")?.textContent ?? "";
    const dialog = ensureDialog();
    const chartId = tile.dataset.chartId ?? "";
    dialog.dataset.activeChartId = chartId;
    (dialog.querySelector(".choro-dialog-title") as HTMLElement).textContent = title;
    (dialog.querySelector(".choro-dialog-eyebrow") as HTMLElement).textContent = eyebrow;
    // Pre-select the dropdown to the currently-effective scheme so
    // the user sees their current choice (default OR override).
    const sel = dialog.querySelector<HTMLSelectElement>(
      ".choro-dialog-scheme-select",
    );
    if (sel) {
      const authorScheme = canvasSrc.dataset.colorScheme ?? "blues";
      sel.value = effectiveScheme(chartId, authorScheme);
    }
    // Zoom controls are only useful for county-and-finer maps —
    // state maps don't get a zoom binding. Hide accordingly so the
    // dialog header doesn't show dead buttons. Same hide-rule for
    // the "scroll to zoom" hint in the footer.
    const zoomBtns = dialog.querySelectorAll<HTMLButtonElement>(
      ".choro-dialog-zoom-reset, .choro-dialog-zoom-in, .choro-dialog-zoom-out",
    );
    const zoomHint = dialog.querySelector<HTMLElement>(
      ".choro-dialog-zoom-hint",
    );
    const isStateLevel = canvasSrc.dataset.geo === "state";
    zoomBtns.forEach((b) => { b.hidden = isStateLevel; });
    if (zoomHint) zoomHint.hidden = isStateLevel;
    // Year slider: configure range from the tile's data-vintages.
    // Show only when there's more than one vintage to choose from —
    // a single-vintage indicator (or one with discovery failure)
    // gets a hidden slider so the dialog stays uncluttered.
    const yearWrap = dialog.querySelector<HTMLElement>(".choro-dialog-year");
    const slider = dialog.querySelector<HTMLInputElement>(
      ".choro-dialog-year-slider",
    );
    const yearReadout = dialog.querySelector<HTMLElement>(
      ".choro-dialog-year-readout",
    );
    let vintages: string[] = [];
    try {
      vintages = JSON.parse(canvasSrc.dataset.vintages ?? "[]") as string[];
    } catch { /* default empty */ }
    const defaultVintage = canvasSrc.dataset.vintage ?? "";
    if (yearWrap && slider) {
      if (vintages.length > 1) {
        slider.min = "0";
        slider.max = String(vintages.length - 1);
        slider.dataset.vintages = JSON.stringify(vintages);
        const defaultIdx = Math.max(0, vintages.indexOf(defaultVintage));
        slider.value = String(defaultIdx);
        if (yearReadout) yearReadout.textContent = vintages[defaultIdx];
        yearWrap.hidden = false;
      } else {
        yearWrap.hidden = true;
      }
    }
    // Fresh canvas — copy the source tile's data-* attrs so the
    // expanded paint runs with identical bindings + mode=expanded.
    const wrap = dialog.querySelector(".choro-dialog-canvas-wrap") as HTMLElement;
    wrap.innerHTML = "";
    const expandedCanvas = document.createElement("div");
    expandedCanvas.className = "choro-canvas choro-canvas-expanded";
    expandedCanvas.setAttribute("data-role", "choro-canvas");
    for (const attr of Array.from(canvasSrc.attributes)) {
      if (attr.name === "class") continue;
      expandedCanvas.setAttribute(attr.name, attr.value);
    }
    expandedCanvas.setAttribute("data-mode", "expanded");
    expandedCanvas.removeAttribute("data-hydrated");
    wrap.appendChild(expandedCanvas);
    // Metadata footer: read the first snapshot shard's vintage +
    // lastUpdated. For multi-shard charts (DMV tracts merge VA + MD
    // + DC), all shards come from the same pipeline run with the
    // same vintage, so reading the first one is fine.
    let firstUrl = "";
    try {
      const urls = JSON.parse(canvasSrc.dataset.dataUrls ?? "[]");
      firstUrl = urls[0] ?? "";
    } catch { /* no urls — meta stays empty */ }
    if (firstUrl) {
      fetch(firstUrl)
        .then((r) => r.json())
        .then((j) => {
          const meta = dialog.querySelector(".choro-dialog-meta") as HTMLElement;
          const updated = j.lastUpdated
            ? new Date(j.lastUpdated).toLocaleDateString("en-US", {
                year: "numeric", month: "short", day: "numeric",
              })
            : "";
          meta.textContent = `ACS 5-year · vintage ${j.vintage} · ${j.geo} level · updated ${updated}`;
        })
        .catch(() => {});
    }
    // Open BEFORE hydrating so the dialog's contentBoxes are
    // measurable and Plot can size correctly.
    if (typeof (dialog as HTMLDialogElement).showModal === "function") {
      dialog.showModal();
    } else {
      // Very old browsers without <dialog>. The polyfill case is
      // mostly safari-iOS-pre-15. Fall back to a plain open.
      (dialog as unknown as { open: boolean }).open = true;
    }
    hydrateAll();
  }

  function init() {
    hydrateAll();
    // Delegate clicks on choro tiles to the document, so we don't
    // race the per-tile DOM-ready handler and don't miss tiles
    // hydrated late (e.g. by routing or re-mounts).
    document.addEventListener("click", (e) => {
      const tile = (e.target as HTMLElement | null)?.closest<HTMLElement>(
        "[data-choro='1']",
      );
      if (!tile) return;
      // Ignore clicks that originated inside an already-open dialog
      // (re-clicks on the expanded canvas shouldn't re-trigger
      // the open).
      if ((e.target as HTMLElement | null)?.closest(".choro-dialog")) return;
      openExpanded(tile);
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
</script>

<style>
  .choro-tile {
    display: flex;
    flex-direction: column;
