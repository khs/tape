    min-height: 240px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .choro-canvas { position: relative; }
  .choro-canvas svg { max-width: 100%; height: auto; }
  /* Custom mousemove tooltip — bypasses the slow native SVG <title>
     hover delay. Positioned absolutely inside the canvas wrapper so
     scrolling doesn't desync it from the cursor. */
  .choro-tooltip {
    position: absolute;
    padding: 4px 8px;
    background: var(--color-neutral-900);
    color: var(--color-white);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    line-height: 1.4;
    pointer-events: none;
    white-space: nowrap;
    z-index: 10;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.18);
  }

  /* ---- Click-to-expand dialog (native <dialog>) ---- */
  /* Browsers center <dialog> automatically when opened via
     showModal(); they also paint a default ::backdrop.
     overflow-y: auto + overscroll-behavior: contain together
     give us scrollability for tall dialogs without letting the
     dialog steal wheel events when the cursor is over the map —
     d3-zoom relies on the wheel reaching the SVG to trigger
     scroll-to-zoom. overscroll-behavior: contain stops the
     scroll chain at the dialog boundary in either direction. */
  .choro-dialog {
    border: none;
    padding: 0;
    background: var(--color-white);
    border-radius: var(--radius-md);
    max-width: min(1100px, 96vw);
    max-height: 92vh;
    width: min(1100px, 96vw);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.2);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .choro-dialog::backdrop {
    background: rgba(0, 0, 0, 0.45);
  }
  .choro-dialog:fullscreen,
  .choro-dialog.choro-dialog-wide {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    border-radius: 0;
    margin: 0;
    /* Force the dialog to fill the viewport when CSS-toggled wide,
       overriding the centered positioning the browser uses for
       showModal() by default. */
    top: 0;
    left: 0;
    /* Flex column so the canvas-wrap can grow to fill whatever
       height the header / year slider / footer don't claim. The
       canvas inside reads window.innerHeight at paint time so the
       SVG actually sizes to the available space instead of staying
       at expanded-mode dimensions. */
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .choro-dialog.choro-dialog-wide .choro-dialog-canvas-wrap {
    flex: 1 1 auto;
    min-height: 0;
    overflow: hidden;
  }
  .choro-dialog-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 20px 8px;
  }
  .choro-dialog-titles { flex: 1; min-width: 0; }
  .choro-dialog-title {
    margin: 0;
    font-size: var(--text-base);
    font-weight: 600;
  }
  .choro-dialog-eyebrow {
    margin: 4px 0 0;
  }
  .choro-dialog-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }
  .choro-dialog-fullscreen {
    font-size: var(--text-xs);
    background: transparent;
    border: 1px solid rgba(55, 53, 47, 0.12);
    border-radius: var(--radius-sm);
    padding: 4px 10px;
    cursor: pointer;
    color: var(--color-neutral-700);
  }
  .choro-dialog-fullscreen:hover { background: var(--color-neutral-100); }
  /* Reset-zoom button: same visual weight as fullscreen so the
     dialog action row reads as a row of utility controls. Hidden
     via [hidden] attr on state-level maps where there's no zoom
     to reset. */
  .choro-dialog-zoom-reset {
    font-size: var(--text-xs);
    background: transparent;
    border: 1px solid rgba(55, 53, 47, 0.12);
    border-radius: var(--radius-sm);
    padding: 4px 10px;
    cursor: pointer;
    color: var(--color-neutral-700);
  }
  .choro-dialog-zoom-reset:hover { background: var(--color-neutral-100); }
  .choro-dialog-zoom-reset[hidden] { display: none; }
  /* Manual +/- buttons — same visual treatment as the reset, narrower
     to keep the action row compact. Tabular-numeric padding so the
     glyphs sit centered in their boxes. */
  .choro-dialog-zoom-in,
  .choro-dialog-zoom-out {
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1;
    background: transparent;
    border: 1px solid rgba(55, 53, 47, 0.12);
    border-radius: var(--radius-sm);
    padding: 4px 10px;
    cursor: pointer;
    color: var(--color-neutral-700);
    min-width: 28px;
  }
  .choro-dialog-zoom-in:hover,
  .choro-dialog-zoom-out:hover { background: var(--color-neutral-100); }
  .choro-dialog-zoom-in[hidden],
  .choro-dialog-zoom-out[hidden] { display: none; }
  /* Color-scheme picker in the dialog actions row. Tightly styled so
     it doesn't dominate the dialog header — it's a refinement, not a
     primary action. */
  .choro-dialog-scheme {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-xs);
  }
  .choro-dialog-scheme-select {
    font-size: var(--text-xs);
    background: var(--color-white);
    border: 1px solid rgba(55, 53, 47, 0.12);
    border-radius: var(--radius-sm);
    padding: 3px 8px;
    color: var(--color-neutral-800);
    cursor: pointer;
  }
  /* Year-slider row. Spans below the header so the slider has room
     to breathe. Hidden when only one vintage is available — single-
     year charts shouldn't show a slider that can't move. */
  .choro-dialog-year {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 20px 4px;
    font-size: var(--text-xs);
    color: var(--color-neutral-700);
  }
  .choro-dialog-year[hidden] { display: none; }
  .choro-dialog-year-slider {
    flex: 1;
    min-width: 200px;
    max-width: 460px;
    accent-color: var(--color-accent);
  }
  .choro-dialog-year-readout {
    font-variant-numeric: tabular-nums;
    min-width: 4ch;
    color: var(--color-neutral-900);
    font-weight: 600;
  }
  /* "Why no rainbow?" disclosure. Collapsed by default; expands
     inline above the map. Reads as a sidebar note, not a primary
     element of the dialog. */
  .choro-dialog-why {
    margin: 0 20px 8px;
    color: var(--color-neutral-700);
  }
  .choro-dialog-why summary {
    cursor: pointer;
    font-size: var(--text-xs);
    color: var(--color-neutral-500);
    user-select: none;
  }
  .choro-dialog-why summary:hover { color: var(--color-neutral-800); }
  .choro-dialog-why p {
    margin: 8px 0 0;
    font-size: var(--text-sm);
    line-height: 1.55;
    max-width: 64ch;
  }
  .choro-dialog-why a { color: var(--color-accent); }
  .choro-dialog-close {
    font-size: 22px;
    line-height: 1;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 4px 8px;
    color: var(--color-neutral-500);
  }
  .choro-dialog-close:hover { color: var(--color-neutral-900); }
  .choro-dialog-canvas-wrap {
    padding: 0 12px 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    /* Block wheel-as-scroll at the wrapper boundary so the SVG inside
       owns all wheel events — d3-zoom captures them via preventDefault
       on the SVG. Without this, wheel events near the edge of the
       wrap bubble up to the scrollable dialog and the user scrolls
       the dialog instead of zooming the map. */
    overscroll-behavior: contain;
  }
  .choro-canvas-expanded {
    width: 100%;
    /* touch-action: none routes trackpad pinch + two-finger pans to
       d3-zoom instead of the browser's native page-zoom / scroll. */
    touch-action: none;
    overscroll-behavior: contain;
  }
  .choro-canvas-expanded svg { max-width: 100%; height: auto; }
  .choro-dialog-footer {
    padding: 8px 20px 16px;
    border-top: 1px solid rgba(55, 53, 47, 0.06);
  }
  .choro-dialog-footer p { margin: 0; }
  .choro-dialog-zoom-hint { margin-top: 4px !important; opacity: 0.7; }
  .choro-dialog-zoom-hint[hidden] { display: none; }
</style>
