# Public (safe to expose to the browser; used by @supabase/supabase-js client).
# These are populated into import.meta.env via Astro/Vite's PUBLIC_ prefix.
PUBLIC_SUPABASE_URL=https://abelpkfwighqtueglbnf.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_NHrJ0VI1hHYn-j3Yjt_ojA_m5_CzO8l

# Server-only (for API routes that need admin writes or bypass RLS). Rarely
# needed when RLS policies are set up correctly; leave blank for now.
# SUPABASE_SERVICE_ROLE_KEY=

# PostHog (custom-event analytics — Vercel Hobby drops custom events, so
# we route them here instead). Project API Key only; do NOT use a personal
# API key (the key gets shipped in client bundles). Host is US or EU cloud.
# When unset, all track() calls no-op cleanly — fine for local dev.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---- Data-pipeline API keys (server-side / Python only — never sent to client) ----
#
# Loaded by pipelines/_env.py at the top of each pipeline that needs them.
# CI surfaces these as env vars via GitHub Actions secrets; locally, drop a
# `.env` file at the repo root with the values filled in. NEVER commit `.env`
# itself — only this `.env.example` template.

# CENSUS_API_KEY: required for tract + block-group ACS fetches. State +
# county work without it but get rate-limited.
# Sign up: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# BEA_API_KEY: required for every Bureau of Economic Analysis endpoint
# (state GDP, personal income, NIPA tables). 36 characters.
# Sign up: https://apps.bea.gov/API/signup/index.cfm
BEA_API_KEY=

# FRED_API_KEY: optional for fredgraph CSV ingest (the bulk of our FRED
# pipeline works without it), but required for audit_fred_copyright.py's
# authoritative copyright-tag lookups. Without it the audit falls back to
# a hand-curated heuristic table (still useful, less comprehensive).
# Sign up: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# NASS_API_KEY: required by pipelines/usda_nass.py for USDA NASS
# QuickStats endpoints (corn / soybean / wheat production, yield, price).
# Sign up: https://quickstats.nass.usda.gov/api
# (NASS ToS requires the verbatim citation "This product uses the NASS
# API but is not endorsed or certified by NASS" — already wired into
# every nass YAML's provenance.)
NASS_API_KEY=

# EIA_API_KEY: required by pipelines/eia_state_energy.py for state
# electricity net-generation by fuel. Free registration.
# Sign up: https://www.eia.gov/opendata/register.php
EIA_API_KEY=
